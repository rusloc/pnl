    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "• Each bar in between is one reason for the difference: green adds revenue, orange takes it away.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The steps always add up exactly: first bar + all steps = last bar.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Consumer Products: Volume = more or fewer units sold; Price / mix = earning more or less per unit (prices, discounts, selling more of the dearer products). Commerce Cloud: one step per service line. ACME Group: one step per company, then the change in intercompany eliminations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• FX = the effect of exchange rates when local currencies are translated into the reporting currency. All other steps are measured at constant rates, so they show real business change.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
