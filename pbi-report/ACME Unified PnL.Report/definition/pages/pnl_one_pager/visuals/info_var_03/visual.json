        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read it",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Each row is one detailed P&L line, with the block it belongs to (for example \"Advertising: working media - Sales & marketing\").",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The bar points right (green) when the difference helps profit and left (orange) when it hurts profit.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• For costs this means: spending less than planned is green, spending more is orange.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              }
            ]
          }
        }
