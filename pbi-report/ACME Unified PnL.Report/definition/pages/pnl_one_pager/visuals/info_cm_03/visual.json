    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read it",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• A longer bar means more of each sale is left to pay for running costs and profit.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The dashed line is the company average. Bars beyond the line do better than average; bars short of it do worse.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Rows are the same as in the table next to it, so a large row with a short bar weighs on the whole company.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101b2b"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
