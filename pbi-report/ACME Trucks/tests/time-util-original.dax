// ACME Trucks - page "Time util (original)" (time_util_original, re-added 2026-10-23 by bip): its key numbers vs the
// LIVE baseline (tests/baseline-live.csv, scopes waterfall_saved and kpi_saved, captured from the live model on
// 2026-10-21). Run in Power BI Desktop > DAX query view against the local Import model after a refresh; every row of
// every result tab must show _pass = TRUE. Tolerance: relative 1e-9.
// Context = the page as saved in its PBIR: report filter dim_loader[is_included] = "да"; page filter
// dim_loader[contractor] = blank (was the drillthrough filter of the original page); slicers week "9 (25.2-3.3)",
// plan type Month, calculation Weighted, work type Trucks + On spot, office and loader unfiltered; the bar and label
// visuals' own filters (category code not blank, is_shown = "1", dim_time_category[is_included] = "да").
// Measures = what the page's visuals bind to, by their current names (old name -> new name in
// docs/model/trucks-measure-dictionary.md). The page re-uses existing measures only: nothing was re-added.
// Tabs: 1 bars and labels per category row | 2 KPI cards (RANDBETWEEN rule, same as baseline-live-en.dax)

DEFINE
    // Deterministic units of the noisy KPI measures (same DAX with _KPI Noise = 1)
    MEASURE _measures[_test Rock Mass by Truck Plan unit] =
        SWITCH (
            TRUE ()
            ,FIRSTNONBLANK ( param_plan_type[plan_type_code], 1 ) = "Неделя"
                ,SUM ( fact_rock_mass[rock_mass_truck_plan] )
            ,SUM ( fact_rock_mass[rock_mass_truck_plan_month] )
        )
    MEASURE _measures[_test Rock Mass by Truck Fact unit] =
        SUM ( fact_rock_mass[rock_mass_truck_fact] )
    MEASURE _measures[_test Performance per Truck Plan unit] =
        DIVIDE ( [_test Rock Mass by Truck Plan unit], [_Plan Truck Loading Hours] ) * 1000
    MEASURE _measures[_test Performance per Truck Fact unit] =
        DIVIDE ( [_test Rock Mass by Truck Fact unit], [_Fact Truck Loading Hours] ) * 1000

    VAR _tol             = 1e-9

    VAR _r_included      = TREATAS ( { "да" }, dim_loader[is_included] )
    VAR _p_contractor    = TREATAS ( { BLANK () }, dim_loader[contractor] )
    VAR _s_week          = TREATAS ( { "9 (25.2-3.3)" }, dim_date[week_label] )
    VAR _s_plan_type     = TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
    VAR _s_calculation   = TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
    VAR _s_work_type     = TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
    VAR _v_category      = FILTER ( ALL ( dim_time_category[category_code] ), NOT ISBLANK ( dim_time_category[category_code] ) )
    VAR _v_shown         = TREATAS ( { "1" }, dim_time_category[is_shown] )
    VAR _v_included      = TREATAS ( { "да" }, dim_time_category[is_included] )

EVALUATE
// ---------------------------------------------------------------- 1 bars and labels per category row
VAR _actual_wide =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,dim_time_category[category_code]
        ,_r_included, _p_contractor, _s_week, _s_plan_type, _s_calculation, _s_work_type, _v_category, _v_shown, _v_included
        ,"m0", [_WF Plan Subtotal]
        ,"m1", [_WF Plan Base]
        ,"m2", [_WF Plan Loss]
        ,"m3", [_WF Fact Subtotal]
        ,"m4", [_WF Fact Base]
        ,"m5", [_WF Fact Loss]
        ,"m6", [Time Share Plan %]
        ,"m7", [Time Share Fact %]
        ,"m8", [Time Share Δ]
        ,"m9", [_Zero]
    )
VAR _actual =
        UNION (
             SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Plan Subtotal", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Plan Base", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Plan Loss", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Fact Subtotal", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Fact Base", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_WF Fact Loss", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "Time Share Plan %", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "Time Share Fact %", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "Time Share Δ", "_actual", [m8] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_actual_code", dim_time_category[category_code], "_measure", "_Zero", "_actual", [m9] )
        )
VAR _expected =
        DATATABLE (
            "_category_sort", INTEGER,
            "_expected_code", STRING,
            "_measure", STRING,
            "_expected", DOUBLE,
            {
                { 1, "КФВ", "_WF Plan Subtotal", 1.0 },
                { 1, "КФВ", "_WF Plan Base", 0.0 },
                { 1, "КФВ", "_WF Plan Loss", 0.0 },
                { 1, "КФВ", "_WF Fact Subtotal", 1.0 },
                { 1, "КФВ", "_WF Fact Base", 0.0 },
                { 1, "КФВ", "_WF Fact Loss", 1.0 },
                { 1, "КФВ", "Time Share Plan %", 1.0 },
                { 1, "КФВ", "Time Share Fact %", 1.0 },
                { 1, "КФВ", "Time Share Δ", 0.0 },
                { 1, "КФВ", "_Zero", 0.0 },
                { 2, "ТО, ППР", "_WF Plan Subtotal", BLANK () },
