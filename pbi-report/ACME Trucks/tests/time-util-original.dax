                { 27, "Погрузка самосвалов", "_WF Fact Subtotal", 0.4616026724760741 },
                { 27, "Погрузка самосвалов", "_WF Fact Base", 0.0 },
                { 27, "Погрузка самосвалов", "_WF Fact Loss", 0.0 },
                { 27, "Погрузка самосвалов", "Time Share Plan %", 0.41880311441128704 },
                { 27, "Погрузка самосвалов", "Time Share Fact %", 0.4616026724760741 },
