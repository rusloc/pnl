                    ISBLANK ( _e )
                    ,ISBLANK ( _a )
                    ,NOT ISBLANK ( _a ) && ABS ( _a - _e ) <= _tol * MAX ( 1, ABS ( _e ) )
                )
    )
ORDER BY [_pass], [_category_sort], [_measure]

