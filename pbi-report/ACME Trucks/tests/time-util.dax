                { 21, "_WF Plan Subtotal", BLANK () },
                { 21, "_WF Fact Base", 0.541681431205485 },
                { 21, "_WF Fact Loss", 0.055929648912814 },
                { 21, "_WF Fact Subtotal", BLANK () },
                { 22, "WF Plan %", 0.0 },
                { 22, "WF Fact %", 0.0183967231692055 },
                { 22, "Time Share Δ", 0.0183967231692055 },
                { 22, "_WF Plan Base", 0.529032318907671 },
                { 22, "_WF Plan Loss", BLANK () },
                { 22, "_WF Plan Subtotal", BLANK () },
                { 22, "_WF Fact Base", 0.52328470803628 },
                { 22, "_WF Fact Loss", 0.0183967231692055 },
                { 22, "_WF Fact Subtotal", BLANK () },
                { 24, "WF Plan %", 0.529032318907671 },
                { 24, "WF Fact %", 0.52328470803628 },
                { 24, "Time Share Δ", -0.00574761087139131 },
                { 24, "_WF Plan Base", 0.0 },
                { 24, "_WF Plan Loss", 0.0 },
                { 24, "_WF Plan Subtotal", 0.529032318907671 },
                { 24, "_WF Fact Base", 0.0 },
                { 24, "_WF Fact Loss", 0.0 },
                { 24, "_WF Fact Subtotal", 0.52328470803628 },
                { 25, "WF Plan %", 0.110229204496384 },
                { 25, "WF Fact %", 0.0616820355602055 },
                { 25, "Time Share Δ", -0.0485471689361783 },
                { 25, "_WF Plan Base", 0.418803114411287 },
                { 25, "_WF Plan Loss", 0.110229204496384 },
                { 25, "_WF Plan Subtotal", BLANK () },
                { 25, "_WF Fact Base", 0.461602672476074 },
                { 25, "_WF Fact Loss", 0.0616820355602055 },
                { 25, "_WF Fact Subtotal", BLANK () },
                { 27, "WF Plan %", 0.418803114411287 },
                { 27, "WF Fact %", 0.461602672476074 },
                { 27, "Time Share Δ", 0.0427995580647871 },
                { 27, "_WF Plan Base", 0.0 },
                { 27, "_WF Plan Loss", 0.0 },
                { 27, "_WF Plan Subtotal", 0.418803114411287 },
                { 27, "_WF Fact Base", 0.0 },
                { 27, "_WF Fact Loss", 0.0 },
                { 27, "_WF Fact Subtotal", 0.461602672476074 }
            }
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_pass",
            VAR _e      = [_expected]
            VAR _a      = [_actual]
            RETURN
                IF (
                    ISBLANK ( _e )
                    ,ISBLANK ( _a )
                    ,NOT ISBLANK ( _a ) && ABS ( _a - _e ) <= _tol * MAX ( 1, ABS ( _e ) )
                )
    )
ORDER BY [_pass], [_category_sort], [_measure]

EVALUATE
// ---------------------------------------------------------------- 3 waterfall chain: every loss bar ends where the previous bar
// starts (base + loss = previous level) and every subtotal equals the level left after the losses above it
VAR _rows =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type, _v_shown, _v_included
        ,"_sub", [_WF Is Subtotal]
        ,"_pb", [_WF Plan Base], "_pl", [_WF Plan Loss], "_ps", [_WF Plan Subtotal]
        ,"_fb", [_WF Fact Base], "_fl", [_WF Fact Loss], "_fs", [_WF Fact Subtotal]
    )
VAR _levels =
    ADDCOLUMNS (
        _rows
        ,"_plan_level", IF ( [_sub] = 1, [_ps], [_pb] )
        ,"_fact_level", IF ( [_sub] = 1, [_fs], [_fb] )
    )
VAR _checked =
    ADDCOLUMNS (
        FILTER ( _levels, dim_time_category[sort_order] > 1 )
        ,"_prev_plan",
            VAR _s      = dim_time_category[sort_order]
            VAR _p      = MAXX ( FILTER ( _levels, dim_time_category[sort_order] < _s ), dim_time_category[sort_order] )
            RETURN
                MAXX ( FILTER ( _levels, dim_time_category[sort_order] = _p ), [_plan_level] )
        ,"_prev_fact",
            VAR _s      = dim_time_category[sort_order]
            VAR _p      = MAXX ( FILTER ( _levels, dim_time_category[sort_order] < _s ), dim_time_category[sort_order] )
            RETURN
                MAXX ( FILTER ( _levels, dim_time_category[sort_order] = _p ), [_fact_level] )
    )
RETURN
    SELECTCOLUMNS (
        _checked
        ,"_category_sort", dim_time_category[sort_order]
        ,"_subtotal", [_sub]
        ,"_pass",
            IF (
                [_sub] = 1
                ,ABS ( [_ps] - [_prev_plan] ) <= 1e-9 && ABS ( [_fs] - [_prev_fact] ) <= 1e-9
                ,ABS ( [_pb] + COALESCE ( [_pl], 0 ) - [_prev_plan] ) <= 1e-9
                    && ABS ( [_fb] + COALESCE ( [_fl], 0 ) - [_prev_fact] ) <= 1e-9
            )
    )
ORDER BY [_pass], [_category_sort]

EVALUATE
// ---------------------------------------------------------------- 4 KPI tiles 1-2 equal the table rows 27 / 24; Δ pp = (fact - plan) x 100
VAR _k =
    SUMMARIZECOLUMNS (
        _f_included, _f_plan_type, _f_calculation, _f_work_type
        ,"_tl_p", [KPI Truck Loading Plan %], "_tl_f", [KPI Truck Loading Fact %], "_tl_d", [KPI Truck Loading Δ pp]
        ,"_ew_p", [KPI Effective Work Plan %], "_ew_f", [KPI Effective Work Fact %], "_ew_d", [KPI Effective Work Δ pp]
    )
VAR _t =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type, _v_shown, _v_included
        ,"_p", [WF Plan %], "_f", [WF Fact %]
    )
RETURN
    UNION (
        ROW ( "_check", "truck loading plan = row 27", "_pass", ABS ( MAXX ( _k, [_tl_p] ) - MAXX ( FILTER ( _t, dim_time_category[sort_order] = 27 ), [_p] ) ) <= 1e-12 )
        ,ROW ( "_check", "truck loading fact = row 27", "_pass", ABS ( MAXX ( _k, [_tl_f] ) - MAXX ( FILTER ( _t, dim_time_category[sort_order] = 27 ), [_f] ) ) <= 1e-12 )
        ,ROW ( "_check", "truck loading delta pp", "_pass", ABS ( MAXX ( _k, [_tl_d] ) - ( MAXX ( _k, [_tl_f] ) - MAXX ( _k, [_tl_p] ) ) * 100 ) <= 1e-9 )
        ,ROW ( "_check", "effective work plan = row 24", "_pass", ABS ( MAXX ( _k, [_ew_p] ) - MAXX ( FILTER ( _t, dim_time_category[sort_order] = 24 ), [_p] ) ) <= 1e-12 )
        ,ROW ( "_check", "effective work fact = row 24", "_pass", ABS ( MAXX ( _k, [_ew_f] ) - MAXX ( FILTER ( _t, dim_time_category[sort_order] = 24 ), [_f] ) ) <= 1e-12 )
        ,ROW ( "_check", "effective work delta pp", "_pass", ABS ( MAXX ( _k, [_ew_d] ) - ( MAXX ( _k, [_ew_f] ) - MAXX ( _k, [_ew_p] ) ) * 100 ) <= 1e-9 )
    )
ORDER BY [_pass], [_check]

EVALUATE
// ---------------------------------------------------------------- 5 Δ colour rule: subtotal up or time loss down = favourable (blue),
// otherwise unfavourable (orange), |Δ| < 0.005 pp = neutral; checked on the pill SVG's fill
VAR _r =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type, _v_shown, _v_included
        ,"_sub", [_WF Is Subtotal]
        ,"_pp", [Time Share Δ] * 100
        ,"_pill", [WF Δ Pill]
    )
RETURN
    SELECTCOLUMNS (
        _r
        ,"_category_sort", dim_time_category[sort_order]
        ,"_pp", [_pp]
        ,"_pass",
            VAR _pp     = COALESCE ( [_pp], 0 )
            VAR _bg     =
                SWITCH (
                    TRUE ()
                    ,ABS ( _pp ) < 0.005
                        ,"%23EEF1F5"
                    ,IF ( [_sub] = 1, _pp > 0, _pp < 0 )
                        ,"%23E3EEF7"
                    ,"%23FBEADF"
                )
            RETURN
                CONTAINSSTRING ( [_pill], "fill='" & _bg & "'" )
    )
ORDER BY [_pass], [_category_sort]

EVALUATE
// ---------------------------------------------------------------- 6 KPI noise rule: while _KPI Noise is RANDBETWEEN ( 10, 100 ), the rock mass
// tiles are unit x a whole number in [10, 100]. When the noise is removed (body = 1) this tab must be updated.
VAR _w =
    SUMMARIZECOLUMNS (
        _f_included, _f_plan_type, _f_calculation, _f_work_type
        ,"k0", [Rock Mass by Truck Plan], "u0", [_test Rock Mass by Truck Plan unit]
        ,"k1", [Rock Mass by Truck Fact], "u1", [_test Rock Mass by Truck Fact unit]
        ,"n", [_KPI Noise]
    )
RETURN
    UNION (
        ROW ( "_check", "rock mass plan = unit x noise", "_pass", VAR _m = DIVIDE ( MAXX ( _w, [k0] ), MAXX ( _w, [u0] ) ) RETURN _m >= 10 && _m <= 100 && ABS ( _m - ROUND ( _m, 0 ) ) <= 1e-6 )
        ,ROW ( "_check", "rock mass fact = unit x noise", "_pass", VAR _m = DIVIDE ( MAXX ( _w, [k1] ), MAXX ( _w, [u1] ) ) RETURN _m >= 10 && _m <= 100 && ABS ( _m - ROUND ( _m, 0 ) ) <= 1e-6 )
        ,ROW ( "_check", "_KPI Noise in [10, 100]", "_pass", VAR _n = MAXX ( _w, [n] ) RETURN _n >= 10 && _n <= 100 )
    )
ORDER BY [_pass], [_check]

EVALUATE
// ---------------------------------------------------------------- 7 header context; the page no longer filters contractor (both groups count)
VAR _h =
    CALCULATE (
        [_Header Context]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type
    )
VAR _contractors =
    CALCULATE (
        DISTINCTCOUNT ( dim_loader[contractor] )
        ,_f_included
        ,fact_time_actual
    )
RETURN
    UNION (
        ROW ( "_check", "header text", "_pass", _h = "Weeks 44 (2022) – 14 (2023)  ·  Weighted calculation  ·  Month plan" )
        ,ROW ( "_check", "loaders with and without contractor both in the fact data", "_pass", _contractors = 2 )
    )
ORDER BY [_pass], [_check]

EVALUATE
// ---------------------------------------------------------------- 8 tooltip page (tt_time_structure): title = row category, Δ pp = fact % - plan %
// of the row in percentage points, rounded to 0.01 like the Δ pill, and the pill prints the same number.
VAR _r =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,dim_time_category[category_name]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type, _v_shown, _v_included
        ,"_title", [_TT Category]
        ,"_plan", [WF Plan %]
        ,"_fact", [WF Fact %]
        ,"_pp", [WF Δ pp]
        ,"_pill", [WF Δ Pill]
    )
RETURN
    SELECTCOLUMNS (
        _r
        ,"_category_sort", dim_time_category[sort_order]
        ,"_pp", [_pp]
        ,"_pass",
            VAR _expected = ROUND ( ( [_fact] - [_plan] ) * 100, 2 )
            VAR _number   = FORMAT ( ABS ( [_pp] ), "0.00", "en-US" )
            RETURN
                [_title] = dim_time_category[category_name]
                    && ABS ( [_pp] - _expected ) <= 1e-9
                    && CONTAINSSTRING ( [_pill], _number & "</text>" )
    )
ORDER BY [_pass], [_category_sort]
