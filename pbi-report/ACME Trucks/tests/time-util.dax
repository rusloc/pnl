// ACME Trucks - page "Time utilization": expected values AFTER the contractor = blank drillthrough filter was dropped
// (USER decision 5, 2026-10-21). Captured by bip from the local Import model (Trucks.SemanticModel, refreshed from
// data/*.parquet) once tests/baseline-live-en.dax had passed in full against the same model, so these numbers are the
// live model's logic with all contractors included. Run in Power BI Desktop > DAX query view after a refresh; every
// row of every result tab must show _pass = TRUE. Tolerance: relative 1e-9.
// Contexts (the page defaults, i.e. what Reset filters restores; report filter dim_loader[is_included] = "да"):
//   default  = all weeks, all offices, all loaders, plan type Month, calculation Weighted, work type Trucks + On spot,
//              plus the table's visual filters (is_shown = "1", is_included = "да").
//   week 9   = the same with week "9 (25.2-3.3)" (the week the old page had saved), for comparison with the baseline.
// Tabs: 1 waterfall default | 2 waterfall week 9 | 3 waterfall chain (bars meet) | 4 KPI tiles vs table rows |
//       5 Δ colour rule | 6 KPI noise rule (_KPI Noise) | 7 header context and the dropped contractor filter |
//       8 tooltip page tt_time_structure (2026-10-23): _TT Category and WF Δ pp per table row.

DEFINE
    // Deterministic units of the four noisy KPI measures (same DAX with _KPI Noise = 1)
    MEASURE _measures[_test Rock Mass by Truck Plan unit] =
        SWITCH (
            TRUE ()
            ,FIRSTNONBLANK ( param_plan_type[plan_type_code], 1 ) = "Неделя"
                ,SUM ( fact_rock_mass[rock_mass_truck_plan] )
            ,SUM ( fact_rock_mass[rock_mass_truck_plan_month] )
        )
    MEASURE _measures[_test Rock Mass by Truck Fact unit] =
        SUM ( fact_rock_mass[rock_mass_truck_fact] )

    VAR _tol             = 1e-9

    VAR _f_included      = TREATAS ( { "да" }, dim_loader[is_included] )
    VAR _f_plan_type     = TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
    VAR _f_calculation   = TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
    VAR _f_work_type     = TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
    VAR _f_week9         = TREATAS ( { "9 (25.2-3.3)" }, dim_date[week_label] )
    VAR _v_shown         = TREATAS ( { "1" }, dim_time_category[is_shown] )
    VAR _v_included      = TREATAS ( { "да" }, dim_time_category[is_included] )

EVALUATE
// ---------------------------------------------------------------- 1 waterfall, default context
VAR _actual_wide =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,_f_included, _f_plan_type, _f_calculation, _f_work_type, _v_shown, _v_included
        ,"m0", [WF Plan %]
        ,"m1", [WF Fact %]
        ,"m2", [Time Share Δ]
        ,"m3", [_WF Plan Base]
        ,"m4", [_WF Plan Loss]
        ,"m5", [_WF Plan Subtotal]
        ,"m6", [_WF Fact Base]
        ,"m7", [_WF Fact Loss]
        ,"m8", [_WF Fact Subtotal]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "WF Plan %", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "WF Fact %", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "Time Share Δ", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Base", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Loss", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Subtotal", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Base", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Loss", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Subtotal", "_actual", [m8] )
        )
VAR _expected =
