// baseline-live-en.dax: generated from baseline-live.dax by bip (2026-10-21) after the English rename (step 5).
// Same expected values and contexts; object names and the measure labels in strings follow the rename map;
// plan type caption MONTH -> Month; the _factHours_%% rows are dropped (tooltip-only measure, removed with its page);
// row counts only for the tables kept after the orphan cleanup (step 4). Header below is the original's.
// ACME Trucks - baseline of the LIVE model "Time unitilaztion" (workspace Showcase), captured 2026-10-21 by ginee
// through executeQueries (read-only). Run in Power BI Desktop > DAX query view against the local Import model
// (Trucks.SemanticModel) after a full refresh. Each EVALUATE returns its own result tab; a test passes when every
// row shows _pass = TRUE. Tolerance: relative 1e-9 (same data, so only floating-point summation order may differ).
// Expected values also in baseline-live.csv (same folder). This file was self-tested against the live model: all TRUE.
// Scopes:
//   row counts         = COUNTROWS per table vs the live model.
//   waterfall_saved    = "Time util" saved state: report filter Справочник ЭКС[Учитывать] = "да"; page drillthrough
//                        filter Справочник ЭКС[Подрядчик] = blank (Q-06); week "9 (25.2-3.3)"; plan type "MONTH";
//                        calculation "Weighted"; work type "Trucks" + "On spot"; office and loader unfiltered;
//                        plus the waterfall visuals' own filters (idle_model_category not blank, show = "1",
//                        Справочник простоев[Учитывать] = "да"). Rows = waterfall categories (Sorting).
//   waterfall_switches = plan type "MONTH" + calculation "Weighted" only (all data), same visual filters.
//   model_total        = the waterfall / label / tooltip measures with no filter at all.
//   kpi_*              = the 4 KPI cards (saved page context / switches only / no filter). In the source model these
//                        measures multiply by RANDBETWEEN(10,100), so every evaluation differs. The test pins the
//                        deterministic unit (same DAX without RANDBETWEEN, defined below as _test measures) exactly,
//                        and checks KPI / unit is a whole number in [10, 100] (ГМ на авто *: one RANDBETWEEN) or
//                        [100, 10000] (_производительность_авто_*: two nested RANDBETWEEN).
// Measures: waterfall bars (_plan_/_fact_ *_SWITCH), % / delta labels (*_LABEL*), tooltip hours (_planHours,
// _factHours, _factHours_LIN, _factHours_%%), helper _zero, KPI cards (_производительность_авто_*, ГМ на авто *).

DEFINE
    // Deterministic units of the KPI measures: the source DAX without RANDBETWEEN (see header)
    MEASURE _measures[_test Rock Mass by Truck Plan unit] =
        SWITCH (
            TRUE ()
            ,FIRSTNONBLANK ( param_plan_type[plan_type_code], 1 ) = "Неделя"
                ,SUM ( fact_rock_mass[rock_mass_truck_plan] )
            ,SUM ( fact_rock_mass[rock_mass_truck_plan_month] )
        )
    MEASURE _measures[_test Rock Mass by Truck Fact unit] =
        SUM ( fact_rock_mass[rock_mass_truck_fact] )
    MEASURE _measures[_test Performance per Truck Plan unit] =
        DIVIDE ( [_test Rock Mass by Truck Plan unit], [_Plan Truck Loading Hours] ) * 1000
    MEASURE _measures[_test Performance per Truck Fact unit] =
        DIVIDE ( [_test Rock Mass by Truck Fact unit], [_Fact Truck Loading Hours] ) * 1000

    VAR _tol             = 1e-9

    VAR _f_included      = TREATAS ( { "да" }, dim_loader[is_included] )
    VAR _f_contractor    = TREATAS ( { BLANK () }, dim_loader[contractor] )
    VAR _f_week          = TREATAS ( { "9 (25.2-3.3)" }, dim_date[week_label] )
    VAR _f_plan_type     = TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
    VAR _f_calculation   = TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
    VAR _f_work_type     = TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
    VAR _v_category      = FILTER ( ALL ( dim_time_category[category_code] ), NOT ISBLANK ( dim_time_category[category_code] ) )
    VAR _v_show          = TREATAS ( { "1" }, dim_time_category[is_shown] )
    VAR _v_included      = TREATAS ( { "да" }, dim_time_category[is_included] )
    VAR _s_plan_type     = TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
    VAR _s_calculation   = TREATAS ( { "Weighted" }, param_calculation[calculation_name] )

EVALUATE
// ---------------------------------------------------------------- row counts per table vs live
VAR _expected =
        DATATABLE (
            "_table", STRING,
            "_expected", INTEGER,
            {
                { "dim_date", 156 },
                { "DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8", 1 },
                { "fact_interval", 891 },
                { "LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324", 730 },
                { "LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487", 730 },
                { "param_calculation", 2 },
                { "param_plan_type", 2 },
                { "fact_time_plan_week", 394056 },
                { "fact_time_plan_month", 249080 },
                { "bridge_plan_time_category", 25 },
                { "fact_time_actual", 203867 },
                { "fact_rock_mass", 18684 },
                { "dim_loader_work_type", 168 },
                { "dim_time_category", 31 },
                { "dim_mine", 7 },
                { "dim_loader", 168 },
                { "bridge_fact_time_category", 22 }
            }
        )
VAR _actual =
        UNION (
            ROW ( "_table", "dim_date", "_actual", COUNTROWS ( dim_date ) )
            ,ROW ( "_table", "DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8", "_actual", COUNTROWS ( 'DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8' ) )
            ,ROW ( "_table", "fact_interval", "_actual", COUNTROWS ( fact_interval ) )
            ,ROW ( "_table", "LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324", "_actual", COUNTROWS ( 'LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324' ) )
            ,ROW ( "_table", "LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487", "_actual", COUNTROWS ( 'LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487' ) )
            ,ROW ( "_table", "param_calculation", "_actual", COUNTROWS ( param_calculation ) )
            ,ROW ( "_table", "param_plan_type", "_actual", COUNTROWS ( param_plan_type ) )
            ,ROW ( "_table", "fact_time_plan_week", "_actual", COUNTROWS ( fact_time_plan_week ) )
            ,ROW ( "_table", "fact_time_plan_month", "_actual", COUNTROWS ( fact_time_plan_month ) )
            ,ROW ( "_table", "bridge_plan_time_category", "_actual", COUNTROWS ( bridge_plan_time_category ) )
            ,ROW ( "_table", "fact_time_actual", "_actual", COUNTROWS ( fact_time_actual ) )
            ,ROW ( "_table", "fact_rock_mass", "_actual", COUNTROWS ( fact_rock_mass ) )
            ,ROW ( "_table", "dim_loader_work_type", "_actual", COUNTROWS ( dim_loader_work_type ) )
            ,ROW ( "_table", "dim_time_category", "_actual", COUNTROWS ( dim_time_category ) )
            ,ROW ( "_table", "dim_mine", "_actual", COUNTROWS ( dim_mine ) )
            ,ROW ( "_table", "dim_loader", "_actual", COUNTROWS ( dim_loader ) )
            ,ROW ( "_table", "bridge_fact_time_category", "_actual", COUNTROWS ( bridge_fact_time_category ) )
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_pass", [_actual] = [_expected]
    )
ORDER BY [_pass], [_table]

EVALUATE
// ---------------------------------------------------------------- waterfall_saved
VAR _actual_wide =
    SUMMARIZECOLUMNS (
        dim_time_category[sort_order]
        ,_f_included, _f_contractor, _f_week, _f_plan_type, _f_calculation, _f_work_type, _v_category, _v_show, _v_included
        ,"m0", [_WF Plan Subtotal]
        ,"m1", [_WF Plan Base]
        ,"m2", [_WF Plan Loss]
        ,"m3", [_WF Fact Subtotal]
        ,"m4", [_WF Fact Base]
        ,"m5", [_WF Fact Loss]
        ,"m6", [Time Share Plan %]
        ,"m7", [Time Share Fact %]
        ,"m8", [Time Share Δ]
        ,"m9", [_Plan Hours]
        ,"m10", [_Fact Hours]
        ,"m11", [_Fact Hours Linear]
        ,"m13", [_Zero]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Subtotal", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Base", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Plan Loss", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Subtotal", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Base", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_WF Fact Loss", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "Time Share Plan %", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "Time Share Fact %", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "Time Share Δ", "_actual", [m8] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_Plan Hours", "_actual", [m9] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_Fact Hours", "_actual", [m10] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_Fact Hours Linear", "_actual", [m11] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", dim_time_category[sort_order] + 0, "_measure", "_Zero", "_actual", [m13] )
        )
