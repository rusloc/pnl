            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Performance per Truck Fact", "_actual", [k1], "_actual_unit", [u1], "_lo", 100, "_hi", 10000 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Rock Mass by Truck Plan", "_actual", [k2], "_actual_unit", [u2], "_lo", 10, "_hi", 100 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Rock Mass by Truck Fact", "_actual", [k3], "_actual_unit", [u3], "_lo", 10, "_hi", 100 )
        )
VAR _expected =
        DATATABLE (
            "_measure", STRING,
            "_expected_unit", DOUBLE,
            {
                { "Performance per Truck Plan", 880.9515302221978 },
                { "Performance per Truck Fact", 759.4891363723495 },
                { "Rock Mass by Truck Plan", 87793.82 },
                { "Rock Mass by Truck Fact", 144795.46582 }
            }
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_multiplier", DIVIDE ( [_actual], [_actual_unit] )
        ,"_pass",
            VAR _e      = [_expected_unit]
            VAR _u      = [_actual_unit]
            VAR _m      = DIVIDE ( [_actual], [_actual_unit] )
            VAR _unit_ok =
                IF (
                    ISBLANK ( _e )
                    ,ISBLANK ( _u )
                    ,NOT ISBLANK ( _u ) && ABS ( _u - _e ) <= _tol * MAX ( 1, ABS ( _e ) )
                )
            VAR _mult_ok =
                IF (
                    ISBLANK ( _u ) || _u = 0
                    ,ISBLANK ( [_actual] ) || [_actual] = 0
                    ,_m >= [_lo] && _m <= [_hi] && ABS ( _m - ROUND ( _m, 0 ) ) <= 1e-6
                )
            RETURN
                _unit_ok && _mult_ok
    )
ORDER BY [_pass], [_measure]

EVALUATE
// ---------------------------------------------------------------- kpi_total (RANDBETWEEN rule)
VAR _actual_wide =
    ROW (
        "k0", [Performance per Truck Plan]
        ,"u0", [_test Performance per Truck Plan unit]
        ,"k1", [Performance per Truck Fact]
        ,"u1", [_test Performance per Truck Fact unit]
        ,"k2", [Rock Mass by Truck Plan]
        ,"u2", [_test Rock Mass by Truck Plan unit]
        ,"k3", [Rock Mass by Truck Fact]
        ,"u3", [_test Rock Mass by Truck Fact unit]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_measure", "Performance per Truck Plan", "_actual", [k0], "_actual_unit", [u0], "_lo", 100, "_hi", 10000 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Performance per Truck Fact", "_actual", [k1], "_actual_unit", [u1], "_lo", 100, "_hi", 10000 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Rock Mass by Truck Plan", "_actual", [k2], "_actual_unit", [u2], "_lo", 10, "_hi", 100 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "Rock Mass by Truck Fact", "_actual", [k3], "_actual_unit", [u3], "_lo", 10, "_hi", 100 )
        )
VAR _expected =
        DATATABLE (
            "_measure", STRING,
            "_expected_unit", DOUBLE,
            {
                { "Performance per Truck Plan", BLANK () },
                { "Performance per Truck Fact", BLANK () },
                { "Rock Mass by Truck Plan", 87793.82 },
                { "Rock Mass by Truck Fact", 144795.46582 }
            }
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_multiplier", DIVIDE ( [_actual], [_actual_unit] )
        ,"_pass",
            VAR _e      = [_expected_unit]
            VAR _u      = [_actual_unit]
            VAR _m      = DIVIDE ( [_actual], [_actual_unit] )
            VAR _unit_ok =
                IF (
                    ISBLANK ( _e )
                    ,ISBLANK ( _u )
                    ,NOT ISBLANK ( _u ) && ABS ( _u - _e ) <= _tol * MAX ( 1, ABS ( _e ) )
                )
            VAR _mult_ok =
                IF (
                    ISBLANK ( _u ) || _u = 0
                    ,ISBLANK ( [_actual] ) || [_actual] = 0
                    ,_m >= [_lo] && _m <= [_hi] && ABS ( _m - ROUND ( _m, 0 ) ) <= 1e-6
                )
            RETURN
                _unit_ok && _mult_ok
    )
ORDER BY [_pass], [_measure]
