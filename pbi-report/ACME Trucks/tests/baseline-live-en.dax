        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_pass",
            IF (
                ISBLANK ( [_expected] )
                ,ISBLANK ( [_actual] )
                ,NOT ISBLANK ( [_actual] ) && ABS ( [_actual] - [_expected] ) <= _tol * MAX ( 1, ABS ( [_expected] ) )
            )
    )
ORDER BY [_pass], [_category_sort], [_measure]

