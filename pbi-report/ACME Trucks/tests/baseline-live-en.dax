EVALUATE
// ---------------------------------------------------------------- model_total
VAR _actual_wide =
    ROW (
        "m0", [_WF Plan Subtotal]
        ,"m1", [_WF Plan Base]
        ,"m2", [_WF Plan Loss]
        ,"m3", [_WF Fact Subtotal]
        ,"m4", [_WF Fact Base]
        ,"m5", [_WF Fact Loss]
        ,"m6", [Time Share Plan %]
        ,"m7", [Time Share Fact %]
        ,"m8", [Time Share Δ]
        ,"m9", [_Plan Hours]
        ,"m10", [_Fact Hours]
        ,"m11", [_Fact Hours Linear]
        ,"m13", [_Zero]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Plan Subtotal", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Plan Base", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Plan Loss", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Fact Subtotal", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Fact Base", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_WF Fact Loss", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "Time Share Plan %", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "Time Share Fact %", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "Time Share Δ", "_actual", [m8] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_Plan Hours", "_actual", [m9] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_Fact Hours", "_actual", [m10] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_Fact Hours Linear", "_actual", [m11] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_Zero", "_actual", [m13] )
        )
VAR _expected =
        DATATABLE (
            "_category_sort", INTEGER,
            "_measure", STRING,
            "_expected", DOUBLE,
            {
                { 0, "_WF Plan Subtotal", 0.0 },
                { 0, "_WF Plan Base", 0.0 },
                { 0, "_WF Plan Loss", 0.0 },
                { 0, "_WF Fact Subtotal", 0.0 },
                { 0, "_WF Fact Base", BLANK () },
                { 0, "_WF Fact Loss", BLANK () },
                { 0, "Time Share Plan %", 0.0 },
                { 0, "Time Share Fact %", 0.0 },
