	partition dim_date-df8f1a5d-2601-430b-8e0f-805ae9a31a5e = m
		mode: import
		source =
				let
				    // Snapshot of the live model "Time unitilaztion" (DAX executeQueries, 2026-10-21), stored as Parquet.
				    // The original on-prem source is not reachable. A file source does not fold: Parquet is read whole.
				    src = Parquet.Document(File.Contents(DataFolder & "\Calendar.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"_weekStartBiz", type date},
				            {"_weekEndBiz", type date},
				            {"_weekNumBiz", Int64.Type},
				            {"Date", type date},
				            {"Год", Int64.Type},
				            {"Месяц", Int64.Type},
				            {"Число", Int64.Type},
				            {"День недели", type text},
				            {"Номер дня недели", Int64.Type},
				            {"Номер недели", Int64.Type},
				            {"День_Месяц", type text},
				            {"Начало_недели", type date},
				            {"Конец_недели", type date},
				            {"Номер_диапазон", type text},
				            {"curPeriod", type text},
				            {"_weekDayNum", Int64.Type},
				            {"_dateSpanBiz", type text},
				            {"_sortSpan", Int64.Type},
				            {"_dateBiz", type text}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

