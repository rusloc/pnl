	partition fact_interval-f3e6f3d4-20f0-451b-9524-b627f2029640 = m
		mode: import
		source =
				let
				    // Snapshot of the live model "Time unitilaztion" (DAX executeQueries, 2026-10-21), stored as Parquet.
				    // The original on-prem source is not reachable. A file source does not fold: Parquet is read whole.
				    src = Parquet.Document(File.Contents(DataFolder & "\intervals.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"interval_id", Int64.Type},
				            {"vehicle_export_code", Int64.Type},
				            {"vehicle_group_code", Int64.Type},
				            {"reserve_l", type logical},
				            {"start_dat", type datetime},
				            {"end_dat", type datetime}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

