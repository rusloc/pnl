	measure '_Fact Loss % Weighted' = ```
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[sort_order])
			/*
			    формируем виртуальную таблицу с колонками:
			        1. собираем список всех ЭКС (SUMMARIZE)
			        2. добавляем обьем ковша (@vol)
			        3. добавляем признак АКТИВЕН (@active): смотрим была ли хоть одна запись с признаком Активен в таблице ПФ_КРВ
			        4. считаем часы по категории простоя (@HOURS), отдельно по ключевым шагам КТГ, КИО, ПОГРУЗКА
			        5. считаем общее время (@totalHours)
			        6. в переменной _percent рассчитываем проценты (@hours / @totalHours) и фильтруем таблицу только по активным экскаваторам
			        7. при выводе результата RETURN рассчитываем средневзвешенные (по ковшу) проценты по категориям простоя
			*/   
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_actual,fact_time_actual[_active]),
			                    ALL(dim_time_category)),
			            "@hours",
			                SWITCH(TRUE(),
			                    _breakPoint = 6,
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[sort_order] IN {2,3,4,5})) / 3600,
			                    _breakPoint = 24,
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[sort_order] IN {2,3,4,5,7,8,9,10,11,12,14,15,21,22})) / 3600,
			                    _breakPoint = 27,
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[sort_order] IN {2,3,4,5,7,8,9,10,11,12,14,15,21,22,25})) / 3600,
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_actual,
			                                fact_time_actual[_active] = 1),
			                            fact_time_actual[duration])) / 3600),
			            "@totalHours",
			                    CALCULATE(
			                        SUM(fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] = "КФВ")) / 3600)
			VAR _percent = ADDCOLUMNS(
								FILTER(_base,
			                        [@active] = 1),
			                    "@percent",
			                    SWITCH(TRUE(),
			                        _breakPoint in {6,24,27},
			                            1 - ([@hours] / [@totalHours]),
			                        [@hours] / [@totalHours]))
			                        
			RETURN
			
			SWITCH(TRUE(),
			    _breakPoint IN {6,24,27},
			        0,
			    DIVIDE(
			        SUMX(_percent, [@percent] * [@vol]),
			        SUMX(_percent, [@vol])))
			```
		isHidden
		displayFolder: 9 Engine
		lineageTag: 48d1dc18-7621-495c-9ecf-c5247cd91b02

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Fact Loss % Linear' =
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[category_code])
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_actual,fact_time_actual[_active]),
			                    REMOVEFILTERS(dim_time_category[category_code])),
			            "@hours",
			                SWITCH(TRUE(),
			                    _breakPoint = "КТГ",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Ожид з/ч","Авар. прост."})) / 3600,
			                    _breakPoint = "КИО",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                            "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации"})) / 3600,
			                    _breakPoint = "Погрузка самосвалов",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                            "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации",
			                                                                            "Основная работа","Вспомогательная работа"})) / 3600,
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_actual,
			                                fact_time_actual[_active] = 1),
			                            fact_time_actual[duration])) / 3600),
			            "@totalHours",
			                    CALCULATE(
			                        SUM(fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] = "КФВ")) / 3600)
			VAR _percent = ADDCOLUMNS(
								_base,
			                    "@percent",
			                    SWITCH(TRUE(),
			                        _breakPoint in {"КИО","КТГ","Погрузка самосвалов"},
			                            1 - ([@hours] / [@totalHours]),
			                        [@hours] / [@totalHours]))
			RETURN
			
			SWITCH(TRUE(),
			    _breakPoint = "КФВ",0,
			    _breakPoint = "КТГ",0,
			    _breakPoint = "КИО",0,
			    _breakPoint = "Погрузка самосвалов",0,
			    DIVIDE(
			                SUMX(_percent, [@hours]),
			                SUMX(_percent, [@totalHours])))
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: 9 Engine
		lineageTag: 40e2bde4-3a44-4578-a16c-bf23f3b533e5

	measure '_WF Fact Loss' =
			// blank line
			
			SWITCH(TRUE(),
			    SELECTEDVALUE(param_calculation[calculation_code]) = "Линейно",
			        [_Fact Loss % Linear],
