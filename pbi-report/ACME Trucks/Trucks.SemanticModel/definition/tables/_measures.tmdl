			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои"})),
			                _breakPoint = "Без классификации",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации"})),
			                _breakPoint = "Вспомогательная работа",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                    "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации","Вспомогательная работа"})),
			                    0),
			            "@totalHours",
			                    CALCULATE(
			                        SUM(fact_time_plan_month[indicator_amount]),
			                            FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] = "КФВ")))
			VAR _percent = ADDCOLUMNS(
								FILTER(_base,
