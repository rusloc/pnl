			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч"})),
			                _breakPoint = "Пересменок",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок"})),
			                _breakPoint = "Обед",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед"})),
			                _breakPoint = "Личные нужды",
			                    CALCULATE(
			                            SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды"})),
			                _breakPoint = "Заправка",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка"})),
			                _breakPoint = "Взрывные работы",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы"})),
			                _breakPoint = "Перегоны",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны"})),
			                _breakPoint = "Ожидание АС",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС"})),
			                _breakPoint = "Консервация/Резерв",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв"})),
