	measure '_Fact Base % Weighted' =
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[category_code])
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_actual,fact_time_actual[_active]),
			                    ALL(dim_time_category)),
			            "@hours",
			                SWITCH(TRUE(),
			                    _breakPoint = "ТО, ППР",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР"})) / 3600,
			                _breakPoint = "КР",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР"})) / 3600,
			                _breakPoint = "Авар. прост.",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост."})) / 3600,
			                _breakPoint = "Ожид з/ч",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч"})) / 3600,
			                _breakPoint = "Пересменок",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок"})) / 3600,
			                _breakPoint = "Обед",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед"})) / 3600,
			                _breakPoint = "Личные нужды",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды"})) / 3600,
			                _breakPoint = "Заправка",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка"})) / 3600,
			                _breakPoint = "Взрывные работы",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
