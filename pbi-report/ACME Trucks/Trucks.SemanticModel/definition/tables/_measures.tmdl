	measure 'Time Share Plan %' =
			// blank line
			VAR _param = SELECTEDVALUE(param_calculation[calculation_code])
			VAR _period = SELECTEDVALUE(param_plan_type[plan_type_code])
			VAR _res = SWITCH(TRUE(),
			                _param = "Линейно" && _period = "Неделя",
			                    [_Plan Share % Week Linear],
			                _param = "Линейно" && _period = "Месяц",
			                    [_Plan Share % Month Linear],
			                _param = "Взвешенно" && _period = "Неделя",
			                    [_Plan Share % Week Weighted],
			                _param = "Взвешенно" && _period = "Месяц",
			                    [_Plan Share % Month Weighted],
			                0)
			RETURN
			    _res
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2 Time Structure
		lineageTag: 8bb96c64-3228-41ea-a942-507bfe3e2a2d

