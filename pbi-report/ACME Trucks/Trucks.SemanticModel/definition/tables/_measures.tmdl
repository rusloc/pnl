	measure '_Fact Subtotal % Linear' =
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[category_code])
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_actual,fact_time_actual[_active]),
			                    REMOVEFILTERS(dim_time_category[category_code])),
			            "@hours",
			                SWITCH(TRUE(),
			                    _breakPoint = "КТГ",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Ожид з/ч","Авар. прост."})) / 3600,
			                    _breakPoint = "КИО",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                            "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации"})) / 3600,
			                    _breakPoint = "Погрузка самосвалов",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                            "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации",
			                                                                            "Основная работа","Вспомогательная работа"})) / 3600,
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_actual,
			                                fact_time_actual[_active] = 1),
			                            fact_time_actual[duration])) / 3600),
			            "@totalHours",
			                    CALCULATE(
			                        SUM(fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] = "КФВ")) / 3600)
			
			RETURN
			SWITCH(TRUE(),
			    _breakPoint = "КФВ" && ISBLANK(SUMX(_base,[@totalHours])),
			        0,
			    _breakPoint = "КФВ" && NOT(ISBLANK(SUMX(_base,[@totalHours]))),
			        1,
			    _breakPoint IN {"КТГ","КИО","Погрузка самосвалов"},
			        IF(
			            ISBLANK(SUMX(_base,[@totalHours])),
			                0,
			        1 - DIVIDE(
			                SUMX(_base, [@hours]),
			                SUMX(_base, [@totalHours]))),
			    BLANK())
		formatString: 0.00%;-0.00%;0.00%
		isHidden
