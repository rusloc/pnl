			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои"})) / 3600,
			                _breakPoint = "Без классификации",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации"})) / 3600,
			                _breakPoint = "Вспомогательная работа",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_actual,
			                                    fact_time_actual[_active] = 1),
			                                fact_time_actual[duration]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы",
			                                                                            "Перегоны","Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации","Вспомогательная работа"})) / 3600,
			                    0),
			            "@totalHours",
