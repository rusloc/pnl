	/// Placeholder noise in the four KPI tile measures, kept on USER request (2026-10-21). To remove it, change the body to 1.
	measure '_KPI Noise' = RANDBETWEEN ( 10, 100 )
		formatString: 0
		isHidden
		displayFolder: 1 KPI
