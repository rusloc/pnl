	measure '_Plan Hours Linear' =
			// blank line
			
			SWITCH(TRUE(),
			    FIRSTNONBLANK(param_plan_type[plan_type_code],1) = "Месяц",
			        [_Plan Hours Month],
			    FIRSTNONBLANK(param_plan_type[plan_type_code],1) = "Неделя",
			        [_Plan Hours Week],
			    [_Plan Hours Week])
		formatString: #,0.000
		isHidden
		displayFolder: 9 Engine
		lineageTag: edc5d25d-0fb5-4392-8923-f8b9cf5a42f9

		changedProperty = FormatString

	measure '_Plan Hours Weighted' = ```
			// blank line
			
			VAR _tab = ADDCOLUMNS(
			                VALUES(dim_loader[loader_name_dispatch]),
			                "_vol",
			                    CALCULATE(
			                        MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			                "_hours",
			                    CALCULATE(
			                        SUMX(dim_loader,SWITCH(TRUE(),
			                                                FIRSTNONBLANK(param_plan_type[plan_type_code],1) = "Месяц",
			                                                    [_Plan Hours Month],
			                                                FIRSTNONBLANK(param_plan_type[plan_type_code],1) = "Неделя",
			                                                    [_Plan Hours Week],
			                                                [_Plan Hours Week]))))
			                    
			VAR _addTop = ADDCOLUMNS(
			                    _tab,
			                    "_topSum",
			                        [_vol] * [_hours])
			             	
			RETURN
			    DIVIDE(
			        SUMX(_addTop,[_topSum]),
			        SUMX(_addTop,[_vol]))
			```
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 52dca106-426d-4e48-9a79-c6c4676d45cc

		changedProperty = FormatString

	measure '_Fact Hours Weighted' = ```
			// blank line
			
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			                "@active",
			                    CALCULATE(
			                        MAXX(fact_time_actual,fact_time_actual[_active]),
			                        REMOVEFILTERS(dim_time_category[category_code])),
			                "@vol",
			                    CALCULATE(
			                        MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			                "@hours",
			                CALCULATE(
			                    SUMX(
			                        FILTER(fact_time_actual,
			                            fact_time_actual[_active] = 1),
			                        fact_time_actual[duration])) / 3600)
			                    
			VAR _percent = ADDCOLUMNS(
			                    _base,
			                    "@topSum",
			                        [@vol] * [@hours])
			             	
			RETURN
			    DIVIDE(
			        SUMX(_percent,[@topSum]),
			        SUMX(_percent,[@vol]))
			```
		isHidden
		displayFolder: 9 Engine
		lineageTag: 638a3132-563d-47f3-b9c6-e454a423fe23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

