	measure '_Plan Base % Month Weighted' =
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[category_code])
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_plan_month,fact_time_plan_month[_active]),
			                    ALL(dim_time_category)),
			            "@hours",
			                SWITCH(TRUE(),
			                _breakPoint = "ТО, ППР",
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_month,
			                                fact_time_plan_month[_active] = 1),
			                            fact_time_plan_month[indicator_amount]),
			                        FILTER(ALL(dim_time_category),
