	/// Truck loading share of total time, plan (waterfall row "Truck loading", sort_order 27).
	measure 'KPI Truck Loading Plan %' =
			CALCULATE (
			    [Time Share Plan %]
			    ,dim_time_category[sort_order] = 27
			)
		formatString: 0.0%
		displayFolder: 1 KPI
		lineageTag: 582056bd-257e-4e8a-a009-cbb9a86a4164

	/// Truck loading share of total time, fact (waterfall row "Truck loading", sort_order 27).
	measure 'KPI Truck Loading Fact %' =
			CALCULATE (
			    [Time Share Fact %]
			    ,dim_time_category[sort_order] = 27
			)
		formatString: 0.0%
		displayFolder: 1 KPI
		lineageTag: 00313d95-9280-4a85-bdea-369b0955485c

	/// Fact minus plan of the truck loading share, in percentage points.
	measure 'KPI Truck Loading Δ pp' =
			VAR _plan         = [KPI Truck Loading Plan %]
			VAR _fact         = [KPI Truck Loading Fact %]
			RETURN
			    IF ( NOT ISBLANK ( _plan ) && NOT ISBLANK ( _fact ), ( _fact - _plan ) * 100 )
		formatString: +0.00 "pp";"−"0.00 "pp";0.00 "pp"
		displayFolder: 1 KPI
		lineageTag: e23ce5db-7d75-4834-8667-9a1500c6a26c

	/// Effective work time share of total time, plan (waterfall row "Effective work time", sort_order 24).
	measure 'KPI Effective Work Plan %' =
			CALCULATE (
			    [Time Share Plan %]
			    ,dim_time_category[sort_order] = 24
			)
		formatString: 0.0%
		displayFolder: 1 KPI
		lineageTag: 23c2df7b-e3c9-4a26-b0d9-bdda08618610

	/// Effective work time share of total time, fact (waterfall row "Effective work time", sort_order 24).
	measure 'KPI Effective Work Fact %' =
			CALCULATE (
			    [Time Share Fact %]
			    ,dim_time_category[sort_order] = 24
			)
		formatString: 0.0%
		displayFolder: 1 KPI
		lineageTag: d2cd55b1-d467-4851-8052-2a9414a28736

	/// Fact minus plan of the effective work time share, in percentage points.
	measure 'KPI Effective Work Δ pp' =
			VAR _plan         = [KPI Effective Work Plan %]
			VAR _fact         = [KPI Effective Work Fact %]
			RETURN
			    IF ( NOT ISBLANK ( _plan ) && NOT ISBLANK ( _fact ), ( _fact - _plan ) * 100 )
		formatString: +0.00 "pp";"−"0.00 "pp";0.00 "pp"
		displayFolder: 1 KPI
		lineageTag: 4148107a-c79e-4166-aea1-e0b33c06241d

	/// Fact minus plan, performance per truck. While _KPI Noise is on, each card draws its own noise, so this is not the difference of the two cards shown.
	measure 'KPI Performance per Truck Δ' =
			VAR _plan         = [Performance per Truck Plan]
			VAR _fact         = [Performance per Truck Fact]
			RETURN
			    IF ( NOT ISBLANK ( _plan ) && NOT ISBLANK ( _fact ), _fact - _plan )
		formatString: +#,0;"−"#,0;0
		displayFolder: 1 KPI
		lineageTag: 308fc7b4-eb58-4d59-b88c-2f0e86fcd734

	/// Fact minus plan, rock mass by truck. While _KPI Noise is on, each card draws its own noise, so this is not the difference of the two cards shown.
	measure 'KPI Rock Mass by Truck Δ' =
			VAR _plan         = [Rock Mass by Truck Plan]
			VAR _fact         = [Rock Mass by Truck Fact]
			RETURN
			    IF ( NOT ISBLANK ( _plan ) && NOT ISBLANK ( _fact ), _fact - _plan )
		formatString: +#,0;"−"#,0;0
		displayFolder: 1 KPI
		lineageTag: 333b072c-50ff-45bf-8ff0-5621175ea04f

	/// 1 on the four waterfall subtotal rows (Total time, Ready for work, Effective work time, Truck loading), 0 on time-loss rows, blank without one category.
	measure '_WF Is Subtotal' =
			VAR _sort         = SELECTEDVALUE ( dim_time_category[sort_order] )
			RETURN
			    IF ( NOT ISBLANK ( _sort ), IF ( _sort IN { 1, 6, 24, 27 }, 1, 0 ) )
		formatString: 0
		isHidden
		displayFolder: 3 Design
		lineageTag: baf85832-e53b-424f-b7d2-a3914f87236f

	/// Plan share shown in the waterfall table; a missing plan shows as "–".
	measure 'WF Plan %' = COALESCE ( [Time Share Plan %], 0 )
		formatString: 0.00%;-0.00%;"–"
		displayFolder: 3 Design
		lineageTag: 3450e48f-cec0-43db-9300-6b1c01de0e99

	/// Fact share shown in the waterfall table; a missing fact shows as "–".
	measure 'WF Fact %' = COALESCE ( [Time Share Fact %], 0 )
		formatString: 0.00%;-0.00%;"–"
		displayFolder: 3 Design
		lineageTag: b170e6b3-b206-43a8-b147-55733bc154fa

	/// SVG bar for the waterfall PLAN column (594 px wide = the table image box, so the table does not centre it): subtotals start at 0 (ink, whole-percent label), time losses float from _WF Plan Base (steel). 50 % grid line and 100 % edge.
	measure 'WF Plan Bar' =
			VAR _w            = 594
			VAR _pad          = 8
			VAR _track        = 533
			VAR _h            = 24
			VAR _is_subtotal  = [_WF Is Subtotal]
			VAR _value        = COALESCE ( IF ( _is_subtotal = 1, [_WF Plan Subtotal], [_WF Plan Loss] ), 0 )
			VAR _left         = IF ( _is_subtotal = 1, 0, COALESCE ( [_WF Plan Base], 0 ) )
			VAR _x            = _pad + _left * _track
			VAR _bar_w        = MAX ( _value * _track, 2 )
			VAR _fill         = IF ( _is_subtotal = 1, "%231C2B3A", "%23A3AFC4" )
			VAR _label        =
			    IF (
			        _is_subtotal = 1 && _bar_w > 48
			        ,"<text x='" & FORMAT ( _x + 8, "0.0", "en-US" )
			            & "' y='17' font-family='Segoe UI' font-size='15' font-weight='600' fill='%23FFFFFF'>"
			            & FORMAT ( _value * 100, "0", "en-US" ) & "%25</text>"
			    )
			VAR _svg          =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='" & _h
			        & "' viewBox='0 0 " & _w & " " & _h & "'>"
			        & "<rect x='" & FORMAT ( _pad + _track / 2 - 1, "0.0", "en-US" ) & "' y='0' width='1' height='" & _h & "' fill='%23E6EAF0'/>"
			        & "<rect x='" & FORMAT ( _pad + _track - 1, "0.0", "en-US" ) & "' y='0' width='1' height='" & _h & "' fill='%23E6EAF0'/>"
			        & "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='0' width='" & FORMAT ( _bar_w, "0.0", "en-US" )
			        & "' height='" & _h & "' rx='4' fill='" & _fill & "'/>"
			        & _label
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _is_subtotal ), _svg )
		displayFolder: 3 Design
		lineageTag: 75590198-3ca3-4d73-b75e-c6dbbb6d4046
		dataCategory: ImageUrl

	/// SVG bar for the waterfall FACT column, same rules as WF Plan Bar; 53 px of left padding stand for the column gap and spacer.
	measure 'WF Fact Bar' =
			VAR _w            = 594
			VAR _pad          = 53
			VAR _track        = 533
			VAR _h            = 24
			VAR _is_subtotal  = [_WF Is Subtotal]
			VAR _value        = COALESCE ( IF ( _is_subtotal = 1, [_WF Fact Subtotal], [_WF Fact Loss] ), 0 )
			VAR _left         = IF ( _is_subtotal = 1, 0, COALESCE ( [_WF Fact Base], 0 ) )
			VAR _x            = _pad + _left * _track
			VAR _bar_w        = MAX ( _value * _track, 2 )
			VAR _fill         = IF ( _is_subtotal = 1, "%231C2B3A", "%23A3AFC4" )
			VAR _label        =
			    IF (
			        _is_subtotal = 1 && _bar_w > 48
			        ,"<text x='" & FORMAT ( _x + 8, "0.0", "en-US" )
			            & "' y='17' font-family='Segoe UI' font-size='15' font-weight='600' fill='%23FFFFFF'>"
			            & FORMAT ( _value * 100, "0", "en-US" ) & "%25</text>"
			    )
			VAR _svg          =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='" & _h
			        & "' viewBox='0 0 " & _w & " " & _h & "'>"
			        & "<rect x='" & FORMAT ( _pad + _track / 2 - 1, "0.0", "en-US" ) & "' y='0' width='1' height='" & _h & "' fill='%23E6EAF0'/>"
			        & "<rect x='" & FORMAT ( _pad + _track - 1, "0.0", "en-US" ) & "' y='0' width='1' height='" & _h & "' fill='%23E6EAF0'/>"
			        & "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='0' width='" & FORMAT ( _bar_w, "0.0", "en-US" )
			        & "' height='" & _h & "' rx='4' fill='" & _fill & "'/>"
			        & _label
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _is_subtotal ), _svg )
		displayFolder: 3 Design
		lineageTag: 2d7ba45e-5ff8-4fcb-9487-4aeda28f05a2
		dataCategory: ImageUrl

	/// Δ fact − plan in percentage points as a pill, drawn in the first 128 px of a 594 px image (the table image box). Favourable (blue) when a subtotal grows or a time loss shrinks, unfavourable (orange) otherwise, neutral below 0.005 pp.
	measure 'WF Δ Pill' =
			VAR _w            = 594
			VAR _h            = 24
			VAR _end          = 128
			VAR _is_subtotal  = [_WF Is Subtotal]
			VAR _pp           = COALESCE ( [Time Share Δ], 0 ) * 100
			VAR _neutral      = ABS ( _pp ) < 0.005
			VAR _favourable   = IF ( _is_subtotal = 1, _pp > 0, _pp < 0 )
			VAR _bg           =
			    SWITCH (
			        TRUE ()
			        ,_neutral
			            ,"%23EEF1F5"
			        ,_favourable
			            ,"%23E3EEF7"
			        ,"%23FBEADF"
			    )
			VAR _fg           =
			    SWITCH (
			        TRUE ()
			        ,_neutral
			            ,"%235B6B7D"
			        ,_favourable
			            ,"%23155A88"
			        ,"%239A4511"
			    )
			VAR _number       = FORMAT ( ABS ( _pp ), "0.00", "en-US" )
			VAR _text         =
			    SWITCH (
			        TRUE ()
			        ,_neutral
			            ,"0.00"
			        ,_pp > 0
			            ,"+" & _number
			        ,"&%238722;" & _number
			    )
			VAR _pill_w       = MAX ( 75, ( LEN ( _number ) + 1 ) * 9 + 22 )
			VAR _svg          =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='" & _h
			        & "' viewBox='0 0 " & _w & " " & _h & "'>"
			        & "<rect x='" & _end - _pill_w & "' y='1' width='" & _pill_w & "' height='22' rx='11' fill='" & _bg & "'/>"
			        & "<text x='" & _end - 11 & "' y='17' text-anchor='end' font-family='Segoe UI' font-size='16' font-weight='600' fill='"
			        & _fg & "'>" & _text & "</text>"
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _is_subtotal ), _svg )
		displayFolder: 3 Design
		lineageTag: 8c664eee-2d8f-43f1-9dca-7b86da9f82fb
		dataCategory: ImageUrl

	/// Header context line, e.g. "Weeks 44 (2022) – 14 (2023)  ·  Weighted calculation  ·  Month plan". The year is the year of the business week's last day, so week 1 (31.12–6.1) counts to the new year.
	measure '_Header Context' =
			VAR _first_date   = MIN ( dim_date[date] )
			VAR _last_date    = MAX ( dim_date[date] )
			VAR _first_week   =
			    CALCULATE (
			        MIN ( dim_date[_weekNumBiz] )
			        ,dim_date[date] = _first_date
			    )
			VAR _last_week    =
			    CALCULATE (
			        MAX ( dim_date[_weekNumBiz] )
			        ,dim_date[date] = _last_date
			    )
			VAR _first_year   =
			    CALCULATE (
			        YEAR ( MIN ( dim_date[_weekEndBiz] ) )
			        ,dim_date[date] = _first_date
			    )
			VAR _last_year    =
			    CALCULATE (
			        YEAR ( MAX ( dim_date[_weekEndBiz] ) )
			        ,dim_date[date] = _last_date
			    )
			VAR _weeks        =
			    SWITCH (
			        TRUE ()
			        ,_first_week = _last_week && _first_year = _last_year
			            ,"Week " & _first_week & " (" & _first_year & ")"
			        ,_first_year = _last_year
			            ,"Weeks " & _first_week & "–" & _last_week & " (" & _first_year & ")"
			        ,"Weeks " & _first_week & " (" & _first_year & ") – " & _last_week & " (" & _last_year & ")"
			    )
			VAR _calc         = SELECTEDVALUE ( param_calculation[calculation_name], "Mixed" )
			VAR _plan         = SELECTEDVALUE ( param_plan_type[plan_type_name], "Mixed" )
			RETURN
			    _weeks & "  ·  " & _calc & " calculation  ·  " & _plan & " plan"
		isHidden
		displayFolder: 3 Design
		lineageTag: f99ee63d-cd0a-40e3-80c5-843386f3135d

	/// Category name of the hovered waterfall row (title of the tooltip page tt_time_structure); blank unless one category is in context.
	measure '_TT Category' = SELECTEDVALUE ( dim_time_category[category_name] )
		isHidden
		displayFolder: 3 Design
		lineageTag: 990e3447-9321-4252-8748-3aed39cc0b23

	/// Fact minus plan share of the waterfall row in percentage points, rounded to 0.01 pp like the Δ pill (shown in the tooltip page).
	measure 'WF Δ pp' = ROUND ( COALESCE ( [Time Share Δ], 0 ) * 100, 2 )
		formatString: +0.00 "pp";"−"0.00 "pp";0.00 "pp"
		displayFolder: 3 Design
		lineageTag: 78afd46d-6425-4329-beee-a78b2714080a

