	measure '_Plan Subtotal % Week Weighted' =
			// blank line
			
			VAR _breakPoint = SELECTEDVALUE(dim_time_category[category_code])
			VAR _base = ADDCOLUMNS(
			                SUMMARIZE(dim_loader,
			                    dim_loader[loader_name_dispatch]),
			            "@vol",
			                CALCULATE(
			                    MAXX(dim_loader,dim_loader[bucket_volume_m3])),
			            "@active",
			                CALCULATE(
			                    MAXX(fact_time_plan_week,fact_time_plan_week[_active]),
			                    ALL(dim_time_category)),
			            "@hours",
			                SWITCH(TRUE(),
			                    _breakPoint = "КТГ",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_plan_week,
			                                    fact_time_plan_week[_active] = 1),
			                                fact_time_plan_week[indicator_amount]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Ожид з/ч","Авар. прост."})),
			                    _breakPoint = "КИО",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_plan_week,
			                                    fact_time_plan_week[_active] = 1),
			                                fact_time_plan_week[indicator_amount]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                        "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации"})),
			                    _breakPoint = "Погрузка самосвалов",
			                        CALCULATE(
			                            SUMX(
			                                FILTER(fact_time_plan_week,
			                                    fact_time_plan_week[_active] = 1),
			                                fact_time_plan_week[indicator_amount]),
			                            FILTER(ALL(dim_time_category),
			                            dim_time_category[category_code] IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч", "Пересменок", "Обед","Личные нужды","Заправка",
			                                                                            "Взрывные работы","Перегоны","Ожидание АС","Консервация/Резерв", "Прочие простои","Без классификации",
			                                                                            "Основная работа","Вспомогательная работа"})),
			                    CALCULATE(
			                        SUMX(
			                            FILTER(fact_time_plan_week,
			                                fact_time_plan_week[_active] = 1),
			                            fact_time_plan_week[indicator_amount]))),
			            "@totalHours",
			                    CALCULATE(
			                        SUM(fact_time_plan_week[indicator_amount]),
			                            FILTER(ALL(dim_time_category),
			                        dim_time_category[category_code] = "КФВ")))
			VAR _percent = ADDCOLUMNS(
								FILTER(_base,
			                        [@active] = 1),
			                    "@percent",
			                    SWITCH(TRUE(),
			                        _breakPoint IN {"КИО","КТГ","Погрузка самосвалов"},
			                            1 - ([@hours] / [@totalHours]),
			                        [@hours] / [@totalHours]))
			RETURN
			
			    SWITCH(TRUE(),
			        _breakPoint = "КФВ",
			            DIVIDE(
			                SUMX(_percent, [@hours]),
			                SUMX(_percent, [@totalHours])),
			        _breakPoint IN {"КТГ","КИО","Погрузка самосвалов"},
			            IF(
			                ISBLANK(SUMX(_percent,[@hours])),
			                    0,
			                DIVIDE(
			                    SUMX(_percent, [@percent] * [@vol]),
			                    SUMX(_percent, [@vol]))),
			        BLANK())
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: 9 Engine
		lineageTag: 7e19347d-9f47-44b0-8e35-43d15740b978

