			                                        "Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации","Вспомогательная работа"},
			                            1 - ([@hours] / [@totalHours]),
			                        0))
			RETURN
			
			SWITCH(TRUE(),
			    _breakPoint = "КФВ",
			        DIVIDE(
			            SUMX(_percent, [@hours]),
			            SUMX(_percent, [@totalHours])),
			    _breakPoint IN {"ТО, ППР","КР","Авар. прост.","Ожид з/ч","Пересменок","Обед","Личные нужды","Заправка","Взрывные работы","Перегоны",
			                                        "Ожидание АС","Консервация/Резерв","Прочие простои","Без классификации","Вспомогательная работа"},
