	/// KPI card C6 (Days between loans) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. No Budget exists: always Prior year (MS-01). Read by the SVG and the parity tests.
	measure '_Card C6 Parts' =
			VAR _value        = [Days Between Loans]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0" ) & " d" )
			VAR _cmp_code     = "PY"
			VAR _cmp_name     = "vs PY"
			VAR _cmp          = [Days Between Loans PY]
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( _value - _cmp, 0 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,"neutral"
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0" ) & " d" )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 9e36e418-c69e-5d91-ad91-986f80133021

