	/// KPI card P5 (Roll rate 30→60) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. No Budget exists: always Prior year (MS-01). Read by the SVG and the parity tests.
	measure '_Card P5 Parts' =
			VAR _value        = [Roll 30-60]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_code     = "PY"
			VAR _cmp_name     = "vs PY"
			VAR _cmp          = [Roll 30-60 PY]
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( ( _value - _cmp ) * 100, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d <= 0
			                ,"good"
			            ,_d <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 0b9d4cd3-7e19-51d4-bfc8-1b2060a51671

