	/// Tier-1. Loans issued: count of fact_loan rows with disbursed_date in the window.
	measure Loans =
			VAR _end          = [_Win End]
			VAR _start        = [_Win Start]
			VAR _market       = [_Sel Market]
			RETURN
			    CALCULATE (
			        [_Loans]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] >= _start
			            && dim_month[month_index] <= _end
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 1 Loans
		lineageTag: f00106fd-8287-592a-987d-a79ffce19b7a

