/// Measure table. All report measures live here (CLAUDE.md Track B). Folders: 0 Base and 9 Engine (hidden), 1-6 business areas, 7 Trend, 8 Cards (SVG), Design.
table _measures
	lineageTag: cacdf360-ed14-5e4d-a9e2-70b489d41d34

	/// month_index of the last closed month (dim_month.is_closed).
	measure '_Last Closed Index' =
			CALCULATE (
			    MAX ( dim_month[month_index] )
			    ,REMOVEFILTERS ( dim_month )
			    ,dim_month[is_closed] = TRUE ()
			)
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 7972d23c-9ad5-5372-87dc-e94cd6c38c09

	/// Anchor month of the window (month picker); defaults to the last closed month.
	measure '_Sel Anchor Index' =
			VAR _default      = [_Last Closed Index]
			RETURN
			    SELECTEDVALUE ( param_anchor_month[month_index], _default )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 213ab648-4309-5a67-9d2b-c222f4b9f566

	/// Selected period code: MONTH, QTD, YTD or R12M (default MONTH).
	measure '_Sel Period' = SELECTEDVALUE ( param_period[period_code], "MONTH" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a9387834-a6e4-5d93-8031-bad6d324acdd

	/// Selected comparator code: BUD or PY (default BUD).
	measure '_Sel Comparator' = SELECTEDVALUE ( param_comparator[comparator_code], "BUD" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a3310652-f3bf-50eb-95f7-a974c95ca789

	/// Selected market code: ALL, PL, RO or PT (default ALL = no market filter).
	measure '_Sel Market' = SELECTEDVALUE ( param_market[market_code], "ALL" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: b06f34ef-416b-5c1d-a913-fa6a5872a7d7

	/// Last month_index of the window = the anchor month.
	measure '_Win End' = [_Sel Anchor Index]
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4ac2f585-305f-56f6-b4ca-5a0ca8ed1c73

	/// First month_index of the window: anchor (Month), first month of its quarter (QTD), January (YTD), anchor - 11 (R12M). month_index 1 = Jan 2024.
	measure '_Win Start' =
			VAR _anchor       = [_Sel Anchor Index]
			VAR _period       = [_Sel Period]
			VAR _month_num    = MOD ( _anchor - 1, 12 ) + 1
			RETURN
			    SWITCH (
			        _period
			        ,"QTD"
			            ,_anchor - MOD ( _month_num - 1, 3 )
			        ,"YTD"
			            ,_anchor - _month_num + 1
			        ,"R12M"
			            ,_anchor - 11
			        ,_anchor
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3dde9fb7-9df0-5f01-9281-b95d6fdd9a85

	/// Last day of the anchor month (cut-off for cohort observation).
	measure '_Anchor End Date' =
			VAR _anchor       = [_Sel Anchor Index]
			RETURN
			    DATE ( 2024, _anchor + 1, 1 ) - 1
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: ed150173-e836-54be-885d-322758ceaa80

	/// Constant 1 (100 % reference line).
	measure _One = 1
		formatString: 0%
		isHidden
		displayFolder: 9 Engine
		lineageTag: 73aad6e4-d847-5fec-a24c-bff78b2721fe

	/// Loans disbursed in the filter context.
	measure _Loans = COUNTROWS ( fact_loan )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: c8903df9-737d-5092-80ec-3bbca62ed068

	/// Disbursed principal in EUR (principal_local / ACTUAL_AVG rate of month x currency).
	measure '_Principal EUR' = SUM ( fact_loan[principal_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: f9656eb5-3133-59e0-8b31-3730034cdd2b

	/// Disbursed principal at the BUDGET rate (constant currency).
	measure '_Principal EUR at Budget FX' = SUM ( fact_loan[principal_eur_bud] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: a3cabfc8-6074-556c-9ae0-5f4161812404

	/// Budget loans (fact_target LOANS).
	measure '_Loans Budget' =
			CALCULATE (
			    SUM ( fact_target[target_value] )
			    ,fact_target[metric_code] = "LOANS"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: a0d2f56d-bb27-55d5-92a4-c5d2bcca2a3c

	/// Budget principal, PRINCIPAL_LOCAL / BUDGET rate of month x currency.
	measure '_Principal Budget EUR' =
			CALCULATE (
			    SUM ( fact_target[target_eur] )
			    ,fact_target[metric_code] = "PRINCIPAL_LOCAL"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: f441dec5-ab54-5988-b72a-f27dd766a9a2

	/// Clients whose first loan was disbursed in the context (sum of is_first_loan).
	measure '_New Clients' =
			CALCULATE (
			    COUNTROWS ( fact_loan )
			    ,fact_loan[is_first_loan] = TRUE ()
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: f5576e92-9287-563d-9965-a06ae90b944b

	/// Budget new clients (fact_target NEW_CLIENTS, by first product).
	measure '_New Clients Budget' =
			CALCULATE (
			    SUM ( fact_target[target_value] )
			    ,fact_target[metric_code] = "NEW_CLIENTS"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: c75cd441-9ca1-5dbd-b796-2c569e8d44c6

	/// Distinct clients with a loan in the context.
	measure _Borrowers = DISTINCTCOUNT ( fact_loan[client_id] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 4b5536cd-96d1-561d-9129-55d0609f580c

	/// Distinct clients with at least one repeat loan in the context.
	measure '_Returning Clients' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_loan[client_id] )
			    ,fact_loan[is_repeat] = TRUE ()
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 627b802b-3133-57bf-93da-3f425fa60bc7

	/// Client-weighted returning share.
	measure '_Returning %' = DIVIDE ( [_Returning Clients], [_Borrowers] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: ab91b3e8-bb42-5a38-9434-7212a7ffbfaa

	/// Repeat loans (is_repeat).
	measure '_Repeat Loans' =
			CALCULATE (
			    COUNTROWS ( fact_loan )
			    ,fact_loan[is_repeat] = TRUE ()
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 6bc0cf22-b706-5a3d-b613-373aaf2d9482

	/// Loan-weighted repeat share.
	measure '_Repeat Share' = DIVIDE ( [_Repeat Loans], [_Loans] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: d945e325-9023-502f-b0e1-2d8bddb569bd

	/// Average principal per loan, EUR.
	measure '_Avg Ticket EUR' = DIVIDE ( [_Principal EUR], [_Loans] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 35289962-37b5-5128-ad89-db661c65a6f2

	/// Budget principal / budget loans.
	measure '_Avg Ticket Budget EUR' = DIVIDE ( [_Principal Budget EUR], [_Loans Budget] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: db01557a-637a-5d49-9d61-981c9803ecec

	/// Median hours submitted -> disbursed.
	measure '_Time to Cash h' = MEDIAN ( fact_loan[hours_to_cash] )
		formatString: 0.0
		isHidden
		displayFolder: 0 Base
		lineageTag: 1aea7ddc-bf54-5287-961e-e4366dd5ad2a

	/// Median hours submitted -> approved.
	measure '_Time to Approve h' = MEDIAN ( fact_loan[hours_to_approve] )
		formatString: 0.0
		isHidden
		displayFolder: 0 Base
		lineageTag: 3626b94f-3bc1-5b33-8317-4cbbe8b9a185

	/// Median hours approved -> disbursed.
	measure '_Approve to Cash h' =
			MEDIANX (
			    fact_loan
			    ,fact_loan[hours_to_cash] - fact_loan[hours_to_approve]
			)
		formatString: 0.0
		isHidden
		displayFolder: 0 Base
		lineageTag: 8de1644a-a10a-59ef-97ee-6020125383d7

	/// Share of loans that are Step 12.
	measure '_Step 12 Share' =
			DIVIDE (
			    CALCULATE (
			        [_Loans]
			        ,dim_product[product_code] = "STEP12"
			    )
			    ,[_Loans]
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: cd9d668c-48d9-50af-88c6-77afcf3b7a3a

	/// fact_application.leads (cumulative stage count by submission day).
	measure _Leads = SUM ( fact_application[leads] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 95f9e544-0e3b-5721-8213-ffa97153f0de

	/// fact_application.apps_started (cumulative stage count by submission day).
	measure '_Apps Started' = SUM ( fact_application[apps_started] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: e3edf9aa-fa3c-5328-b985-f2700086f274

	/// fact_application.apps_submitted (cumulative stage count by submission day).
	measure '_Apps Submitted' = SUM ( fact_application[apps_submitted] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 2ab096a4-9b2d-567e-a356-69c7e8bf8c7e

	/// fact_application.kyc_passed (cumulative stage count by submission day).
	measure '_KYC Passed' = SUM ( fact_application[kyc_passed] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: de50385e-9280-54e5-806e-2390ac3583a8

	/// fact_application.approved (cumulative stage count by submission day).
	measure _Approved = SUM ( fact_application[approved] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: d1093fbf-c925-5aeb-9b4a-c8eebf58c295

	/// fact_application.disbursed (cumulative stage count by submission day).
	measure '_Disbursed Apps' = SUM ( fact_application[disbursed] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: ee13b989-c67c-5d19-871a-68ea5de67016

	/// approved / apps_submitted.
	measure '_Approval Rate' = DIVIDE ( [_Approved], [_Apps Submitted] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 75ce5ac7-bd8f-5680-a975-4ce4eb5f4061

	/// disbursed / approved.
	measure '_Take-up Rate' = DIVIDE ( [_Disbursed Apps], [_Approved] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 8b62d059-667e-5665-a14c-e332f085422d

	/// kyc_passed / apps_submitted.
	measure '_KYC Pass Rate' = DIVIDE ( [_KYC Passed], [_Apps Submitted] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: f36cc2fa-3887-59b0-be49-4902e007bf01

	/// Approval rate of new applicants (is_repeat = FALSE).
	measure '_New-client Approval Rate' =
			CALCULATE (
			    [_Approval Rate]
			    ,fact_application[is_repeat] = FALSE ()
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: e200d150-2da7-5fe6-9b87-a9a318067f0c

	/// KYC pass rate of new applicants.
	measure '_New-client KYC Pass Rate' =
			CALCULATE (
			    [_KYC Pass Rate]
			    ,fact_application[is_repeat] = FALSE ()
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: f2664080-5577-5e9b-8e0e-566433a72d99

	/// Outstanding principal, EUR (month-end; sum over months only inside Cost of Risk).
	measure '_Outstanding EUR' = SUM ( fact_loan_month[outstanding_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: df17c349-446d-5de8-8bfc-610e542eaf61

	/// Balance 1-29 DPD, EUR.
	measure '_Bal 1-29 EUR' = SUM ( fact_loan_month[bal_dpd_1_29_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: f4ece2eb-6446-5e6e-ba3d-67bfabc3fa95

	/// Balance 30-59 DPD, EUR.
	measure '_Bal 30-59 EUR' = SUM ( fact_loan_month[bal_dpd_30_59_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 2fd519bd-640c-5aa4-b71d-310b2d5d09b5

	/// Balance 60-89 DPD, EUR.
	measure '_Bal 60-89 EUR' = SUM ( fact_loan_month[bal_dpd_60_89_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 2d8246d8-05b0-5bda-aa6b-da30783249e0

	/// Balance 90+ DPD, EUR.
	measure '_Bal 90+ EUR' = SUM ( fact_loan_month[bal_dpd_90p_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: bb6422b9-66c2-568a-8fe3-5001670a497c

	/// Balance 30+ DPD, EUR.
	measure '_DPD30 Balance EUR' = [_Bal 30-59 EUR] + [_Bal 60-89 EUR] + [_Bal 90+ EUR]
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: a38f5afa-fbc8-5fd7-a992-cca7b02eb034

	/// 30+ DPD balance / outstanding.
	measure '_DPD30 %' = DIVIDE ( [_DPD30 Balance EUR], [_Outstanding EUR] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 357bc8e4-5114-5ef5-9f08-0d5135cc10c2

	/// 90+ DPD balance / outstanding.
	measure '_DPD90 %' = DIVIDE ( [_Bal 90+ EUR], [_Outstanding EUR] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 84ae065b-7bfb-5dd1-96cd-4e0cb8748f7c

	/// Loans 30+ DPD / active loans.
	measure '_DPD30 Count %' =
			DIVIDE (
			    SUM ( fact_loan_month[loans_dpd_30p] )
			    ,SUM ( fact_loan_month[loans_active] )
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: ce5737cc-f248-5e80-ad47-e2627a9cea18

	/// Budget DPD30_RATIO (risk appetite per market x month); All markets = weighted by the actual EUR outstanding of each market (draft rule, open question).
	measure '_DPD30 Budget %' =
			VAR _weighted     =
			    SUMX (
			        VALUES ( dim_market[market_code] )
			        ,CALCULATE (
			            SUM ( fact_target[target_value] )
			            ,fact_target[metric_code] = "DPD30_RATIO"
			        )
			            * [_Outstanding EUR]
			    )
			RETURN
			    DIVIDE ( _weighted, [_Outstanding EUR] )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 1f036ab7-76d8-5723-977a-6c561de6ed57

	/// Provision charge, EUR.
	measure '_Provision EUR' = SUM ( fact_loan_month[provision_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: b6c24bfc-fb37-5449-9b31-5e81022d7eaa

	/// Annualised: sum of provisions / months x 12 / average month-end outstanding (= provisions x 12 / sum of month-end outstanding).
	measure '_Cost of Risk' =
			DIVIDE (
			    [_Provision EUR] * 12
			    ,[_Outstanding EUR]
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 94cf0a8f-1f3b-5d12-ab9e-ccd9f9f068e0

	/// Balance 60-89 this month / balance 30-59 last month (approximation, cells amortise).
	measure '_Roll 30-60' =
			VAR _month        = MAX ( dim_month[month_index] )
			VAR _prior        =
			    CALCULATE (
			        [_Bal 30-59 EUR]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _month - 1
			    )
			RETURN
			    DIVIDE ( [_Bal 60-89 EUR], _prior )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 5713dbf3-c125-5e6f-9984-5d5a8af4f0a4

	/// Vintage of (month - 6): loans first 90+ within 6 months on book / loans disbursed in the vintage.
	measure '_Vintage 6m Bad Rate' =
			VAR _vintage      = MAX ( dim_month[month_index] ) - 6
			VAR _bad          =
			    CALCULATE (
			        SUM ( fact_loan_month[loans_first_90p] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan_month[vintage_index] = _vintage
			        ,fact_loan_month[months_on_book] <= 6
			    )
			VAR _volume       =
			    CALCULATE (
			        SUM ( fact_loan_month[loans_disbursed] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan_month[vintage_index] = _vintage
			    )
			RETURN
			    DIVIDE ( _bad, _volume )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 94f46c55-8acd-5f23-b50b-8684cee44096

	/// Revenue, EUR (amount_eur).
	measure '_Revenue EUR' = SUM ( fact_revenue_month[amount_eur] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 77defb4c-9e08-574d-b65f-310b9268f734

	/// Budget revenue (REVENUE_LOCAL / BUDGET rate). The budget is set per product, so interest and fees only carry a budget together (lending products); a single interest or fee stream has none.
	measure '_Revenue Budget EUR' =
			VAR _types        = VALUES ( dim_revenue_type[revenue_type_code] )
			VAR _lending      = "INTEREST" IN _types && "FEE" IN _types
			VAR _partial      = ( "INTEREST" IN _types || "FEE" IN _types ) && NOT _lending
			VAR _products     =
			    FILTER (
			        ALL ( dim_product[product_code], dim_product[product_line] )
			        ,( _lending && dim_product[product_line] = "Microloan" )
			            || ( "INTERCHANGE" IN _types && dim_product[product_code] = "CARD" )
			            || ( "SUBSCRIPTION" IN _types && dim_product[product_code] IN { "PLUS", "PRO" } )
			    )
			VAR _budget       =
			    CALCULATE (
			        SUM ( fact_target[target_eur] )
			        ,fact_target[metric_code] = "REVENUE_LOCAL"
			        ,KEEPFILTERS ( TREATAS ( SELECTCOLUMNS ( _products, "@p", dim_product[product_code] ), dim_product[product_code] ) )
			    )
			RETURN
			    IF (
			        NOT ( _partial && COUNTROWS ( _types ) = 1 )
			        ,_budget
			    )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 2b2b3516-5c05-532d-a791-70c8686de0ae

	/// Interest income, EUR.
	measure '_Interest EUR' =
			CALCULATE (
			    [_Revenue EUR]
			    ,dim_revenue_type[revenue_type_code] = "INTEREST"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: d5f51934-d653-59fb-a034-a6d81498a038

	/// Fee income (origination + late fees), EUR.
	measure '_Fees EUR' =
			CALCULATE (
			    [_Revenue EUR]
			    ,dim_revenue_type[revenue_type_code] = "FEE"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 87141152-5bc5-5701-900a-d110c75f53d3

	/// Monthly recurring revenue at month end (Plus + Pro), EUR.
	measure '_MRR EUR' =
			CALCULATE (
			    SUM ( fact_subscription_month[mrr_eur] )
			    ,dim_product[product_code] IN { "PLUS", "PRO" }
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 87abf612-8b80-5ca8-8d26-a6257dc232cb

	/// Paying subscribers at month end (Plus + Pro).
	measure '_Paying Subscribers' =
			CALCULATE (
			    SUM ( fact_subscription_month[subscribers_end] )
			    ,dim_product[product_code] IN { "PLUS", "PRO" }
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 8f98035d-44b7-5133-bfc9-e0d4d736e798

	/// Subscribers at month end (per tier on the chart).
	measure '_Subscribers End' = SUM ( fact_subscription_month[subscribers_end] )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 36b2809a-b77a-5cf5-96cb-2436ff101b1b

	/// Plus subscribers at month end.
	measure '_Plus Subscribers' =
			CALCULATE (
			    SUM ( fact_subscription_month[subscribers_end] )
			    ,dim_product[product_code] = "PLUS"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 74e49f7f-f1a5-5369-b242-549f943e9b87

	/// Pro subscribers at month end.
	measure '_Pro Subscribers' =
			CALCULATE (
			    SUM ( fact_subscription_month[subscribers_end] )
			    ,dim_product[product_code] = "PRO"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: ceddc914-a25e-5ae4-9ba2-c4214907cae1

	/// Paying-subscriber churn: churned / subscribers at the start of the month (summed over the months of the context).
	measure '_Churn %' =
			DIVIDE (
			    CALCULATE (
			        SUM ( fact_subscription_month[subscribers_churned] )
			        ,dim_product[product_code] IN { "PLUS", "PRO" }
			    )
			    ,CALCULATE (
			        SUM ( fact_subscription_month[subscribers_start] )
			        ,dim_product[product_code] IN { "PLUS", "PRO" }
			    )
			)
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
		lineageTag: 909661f0-7288-5cdb-9899-f8bfdfdce345

	/// Loans sold by an agent or partner.
	measure '_Agent Loans' =
			CALCULATE (
			    [_Loans]
			    ,NOT ISBLANK ( fact_loan[agent_code] )
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: efecbf7b-fe3e-5522-86d9-225ba24cab1c

	/// Principal sold by an agent or partner, EUR.
	measure '_Agent Principal EUR' =
			CALCULATE (
			    [_Principal EUR]
			    ,NOT ISBLANK ( fact_loan[agent_code] )
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 3fa680ba-74c5-54bd-802e-edf5452a0884

	/// Agent / partner loan quota (fact_target AGENT_LOANS).
	measure '_Agent Target' =
			CALCULATE (
			    SUM ( fact_target[target_value] )
			    ,fact_target[metric_code] = "AGENT_LOANS"
			)
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 1d5f95d0-7d61-5cfe-8003-cc47f863e83e

	/// Originations bridge step (context): Budget; Volume = (loans - budget loans) x budget ticket; Mix = sum over month x market x product of loans x budget ticket of the cell - loans x budget ticket; Ticket = actual at budget FX - that sum; FX = actual - actual at budget FX. Steps add up to Actual.
	measure '_Bridge Step' =
			VAR _step         = SELECTEDVALUE ( dim_bridge_step[step_code] )
			VAR _actual       = [_Principal EUR]
			VAR _actual_cc    = [_Principal EUR at Budget FX]
			VAR _budget       = [_Principal Budget EUR]
			VAR _loans        = [_Loans]
			VAR _loans_bud    = [_Loans Budget]
			VAR _ticket_bud   = DIVIDE ( _budget, _loans_bud )
			VAR _mix_sum      =
			    SUMX (
			        CROSSJOIN (
			            VALUES ( dim_month[month_key] )
			            ,VALUES ( dim_market[market_code] )
			            ,VALUES ( dim_product[product_code] )
			        )
			        ,VAR _cell_loans  = [_Loans]
			         VAR _cell_lbud   = [_Loans Budget]
			         VAR _cell_bud    = [_Principal Budget EUR]
			         RETURN
			             IF (
			                 _cell_lbud > 0
			                 ,_cell_loans * DIVIDE ( _cell_bud, _cell_lbud )
			                 ,[_Principal EUR at Budget FX]
			             )
			    )
			RETURN
			    SWITCH (
			        _step
			        ,"BUDGET"
			            ,_budget
			        ,"VOLUME"
			            ,( _loans - _loans_bud ) * _ticket_bud
			        ,"MIX"
			            ,_mix_sum - _loans * _ticket_bud
			        ,"TICKET"
			            ,_actual_cc - _mix_sum
			        ,"FX"
			            ,_actual - _actual_cc
			    )
		formatString: #,0
		isHidden
		displayFolder: 0 Base
		lineageTag: 241f785d-9bc7-5f75-973b-54008957ef85

	/// Median days between a repeat loan in the context and the same client's previous loan (the loan with prior_loans - 1; any date). Repeat loans whose previous loan is before Jan 2024 (not in fact_loan) drop out, as in Track C.
	measure '_Days Between Loans' =
			VAR _repeat       =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            fact_loan
			            ,"c", fact_loan[client_id] & ""
			            ,"k", fact_loan[prior_loans] - 1
			            ,"d", fact_loan[disbursed_date]
			        )
			        ,fact_loan[is_repeat] = TRUE ()
			    )
			VAR _clients      =
			    CALCULATETABLE (
			        VALUES ( fact_loan[client_id] )
			        ,fact_loan[is_repeat] = TRUE ()
			    )
			VAR _previous     =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            fact_loan
			            ,"c", fact_loan[client_id] & ""
			            ,"k", fact_loan[prior_loans] + 0
			            ,"p", fact_loan[disbursed_date]
			        )
			        ,REMOVEFILTERS ()
			        ,_clients
			    )
			RETURN
			    MEDIANX (
			        NATURALINNERJOIN ( _repeat, _previous )
			        ,INT ( [d] - [p] )
			    )
		formatString: 0
		isHidden
		displayFolder: 0 Base
		lineageTag: defe794f-2bf1-5b53-af01-bb79f5b74af1

