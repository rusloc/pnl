	/// Share of the cohort (first loan in anchor - 6 months) with a repeat loan within 180 days.
	measure '180-day Repeat %' =
			VAR _cohort       = [_Sel Anchor Index] - 6
			VAR _market       = [_Sel Market]
			VAR _filter       =
			    FILTER (
			        ALL ( dim_client[market_code] )
			        ,_market = "ALL"
			            || dim_client[market_code] = _market
			    )
			VAR _clients      =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,KEEPFILTERS ( _filter )
			    )
			VAR _repeat       =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,NOT ISBLANK ( dim_client[days_to_second_loan] )
			            && dim_client[days_to_second_loan] <= 180
			        ,KEEPFILTERS ( _filter )
			    )
			RETURN
			    DIVIDE ( _repeat, _clients )
		formatString: 0.0%
		displayFolder: 2 Clients
		lineageTag: 13825ea8-bbfc-58dd-8de0-ab7a3f79a1fc

	/// 180-day repeat of the previous cohort (anchor - 7).
	measure '180-day Repeat % Prev Cohort' =
			VAR _cohort       = [_Sel Anchor Index] - 7
			VAR _market       = [_Sel Market]
			VAR _filter       =
			    FILTER (
			        ALL ( dim_client[market_code] )
			        ,_market = "ALL"
			            || dim_client[market_code] = _market
			    )
			VAR _clients      =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,KEEPFILTERS ( _filter )
			    )
			VAR _repeat       =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,NOT ISBLANK ( dim_client[days_to_second_loan] )
			            && dim_client[days_to_second_loan] <= 180
			        ,KEEPFILTERS ( _filter )
			    )
			RETURN
			    DIVIDE ( _repeat, _clients )
		formatString: 0.0%
		displayFolder: 2 Clients
		lineageTag: 323d0097-43a1-5b29-b0a9-b32bf39e62a7

	/// 180-day repeat of the same cohort a year earlier (anchor - 18), the C5 comparator (MS-05); n/a before the data.
	measure '180-day Repeat % PY Cohort' =
			VAR _cohort       = [_Sel Anchor Index] - 18
			VAR _market       = [_Sel Market]
			VAR _filter       =
			    FILTER (
			        ALL ( dim_client[market_code] )
			        ,_market = "ALL"
			            || dim_client[market_code] = _market
			    )
			VAR _clients      =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,KEEPFILTERS ( _filter )
			    )
			VAR _repeat       =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_month_index] = _cohort
			        ,NOT ISBLANK ( dim_client[days_to_second_loan] )
			            && dim_client[days_to_second_loan] <= 180
			        ,KEEPFILTERS ( _filter )
			    )
			RETURN
			    IF ( _cohort >= 1, DIVIDE ( _repeat, _clients ) )
		formatString: 0.0%
		displayFolder: 2 Clients
		lineageTag: 50080b3b-06fa-51c7-a44b-20857adc9ad2

	/// Share of the cohort (anchor - 6) with a repeat loan within 90 days (C5 / O3 info).
	measure '90-day Repeat %' =
			VAR _cohort       = [_Sel Anchor Index] - 6
			VAR _market       = [_Sel Market]
			VAR _filter       =
			    FILTER (
			        ALL ( dim_client[market_code] )
