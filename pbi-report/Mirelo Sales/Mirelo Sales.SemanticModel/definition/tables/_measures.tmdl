			        & " - " & "Outstanding " & IF ( ISBLANK ( _v3 ), "n/a", IF ( ABS ( _v3 ) >= 1000000, "€" & FORMAT ( _v3 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v3 / 1000, "#,0" ) & "k" ) )
			        & " - " & "Planned (Budget) " & IF ( ISBLANK ( _v4 ), "n/a", FORMAT ( _v4, "0.0%" ) )
		displayFolder: 8 Cards
		lineageTag: 171de618-062c-5c28-8bfe-4eebf835f632

