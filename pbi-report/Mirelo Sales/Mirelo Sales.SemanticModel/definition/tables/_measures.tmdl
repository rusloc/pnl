	/// Funnel count of the stage on the axis (dim_funnel_stage), window.
	measure 'Funnel Count' =
			VAR _stage        = SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			RETURN
			    SWITCH (
			        _stage
			        ,"LEAD"
			            ,[Leads]
			        ,"STARTED"
			            ,[Apps Started]
			        ,"SUBMITTED"
			            ,[Apps Submitted]
			        ,"KYC_PASSED"
			            ,[KYC Passed]
			        ,"APPROVED"
			            ,[Approved]
			        ,"DISBURSED"
			            ,[Disbursed Apps]
			    )
		formatString: #,0
		displayFolder: 3 Funnel
		lineageTag: cc8b1e2c-231a-54da-980f-bf229b6abe65

	/// Funnel count, new applicants only.
	measure 'Funnel Count New' =
			CALCULATE (
			    [Funnel Count]
			    ,fact_application[is_repeat] = FALSE ()
			)
		formatString: #,0
		displayFolder: 3 Funnel
		lineageTag: b2b2c059-3497-5cff-9d6e-654fa29e42fd

	/// Stage count / count of the previous shown stage.
	measure 'Funnel % of Previous' =
			VAR _order        = SELECTEDVALUE ( dim_funnel_stage[sort_order] )
			VAR _prev_order   =
			    CALCULATE (
			        MAX ( dim_funnel_stage[sort_order] )
			        ,ALLSELECTED ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] < _order
			    )
			VAR _prev         =
			    CALCULATE (
			        [Funnel Count]
			        ,REMOVEFILTERS ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] = _prev_order
			    )
			RETURN
			    IF ( NOT ISBLANK ( _prev_order ), DIVIDE ( [Funnel Count], _prev ) )
		formatString: 0.0%
		displayFolder: 3 Funnel
		lineageTag: af80fb61-2009-53b7-901d-2d06cc341c4b

	/// New-applicant stage count / previous shown stage.
	measure 'Funnel New % of Previous' =
			VAR _order        = SELECTEDVALUE ( dim_funnel_stage[sort_order] )
			VAR _prev_order   =
			    CALCULATE (
			        MAX ( dim_funnel_stage[sort_order] )
			        ,ALLSELECTED ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] < _order
			    )
			VAR _prev         =
			    CALCULATE (
			        [Funnel Count New]
			        ,REMOVEFILTERS ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] = _prev_order
			    )
			RETURN
			    IF ( NOT ISBLANK ( _prev_order ), DIVIDE ( [Funnel Count New], _prev ) )
		formatString: 0.0%
		displayFolder: 3 Funnel
		lineageTag: 19bb96c8-9fd3-5bab-8f2a-baee53d1fffc

	/// Median hours of the step ending at the stage on the axis: submitted -> approved, approved -> disbursed (the only timestamps in the data).
	measure 'Stage Median Hours' =
			VAR _stage        = SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			RETURN
			    SWITCH (
			        _stage
			        ,"APPROVED"
			            ,[Time to Approve h]
			        ,"DISBURSED"
			            ,[Approve to Cash h]
			    )
		formatString: 0.0
		displayFolder: 3 Funnel
		lineageTag: b1cb9c35-87d9-5fe6-b636-0344d8e0acc9

	/// SLA hours of the stage (dim_funnel_stage.sla_hours).
	measure 'Stage SLA Hours' = MAX ( dim_funnel_stage[sla_hours] )
		formatString: 0
		displayFolder: 3 Funnel
		lineageTag: d23303c7-7a31-54f5-8892-f5ac146944bc

	/// Outstanding of loans 1+ DPD at the snapshot (2026-09-30, the loan-level state on fact_loan), EUR at the Sep 2026 ACTUAL_AVG rate.
	measure 'Overdue Outstanding EUR' =
			VAR _market       = [_Sel Market]
			VAR _last_closed  = [_Last Closed Index]
			VAR _close_key    =
			    CALCULATE (
			        MAX ( dim_month[month_key] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			RETURN
			    CALCULATE (
			        SUMX (
			            VALUES ( fact_loan[currency_code] )
			            ,VAR _currency    = fact_loan[currency_code]
			             VAR _rate        =
			                 CALCULATE (
			                     MAX ( param_fx[local_per_eur] )
			                     ,param_fx[rate_type] = "ACTUAL_AVG"
			                     ,param_fx[currency_code] = _currency
			                     ,param_fx[month_key] = _close_key
			                 )
			             RETURN
			                 DIVIDE ( CALCULATE ( SUM ( fact_loan[outstanding_local_close] ) ), _rate )
			        )
			        ,KEEPFILTERS ( dim_loan_status[dpd_min] >= 1 )
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
		formatString: €#,0
		displayFolder: 4 Portfolio
		lineageTag: 598de967-f21c-5e4b-a070-868c0102b672

	/// Loans of the client(s) up to the end of the anchor month.
	measure 'Client Loans to Date' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_loan )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: #,0
		displayFolder: 2 Clients
		lineageTag: 212ef8a3-de77-51e9-8c14-db1a47206487

	/// Principal of the client(s) up to the end of the anchor month, EUR.
	measure 'Client Principal to Date EUR' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_loan[principal_eur] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: €#,0
		displayFolder: 2 Clients
		lineageTag: 4682ddbd-523a-5984-9bf8-fd9a9f2796fc

	/// Latest disbursement date up to the end of the anchor month.
	measure 'Client Last Loan Date' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        MAX ( fact_loan[disbursed_date] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: yyyy-mm-dd
		displayFolder: 2 Clients
		lineageTag: 39aafc6a-74b1-5cc8-a33c-1133dab3611b

	/// Days from the last loan to the end of the anchor month.
	measure 'Client Days Since Last Loan' =
			VAR _last         = [Client Last Loan Date]
			RETURN
			    IF ( NOT ISBLANK ( _last ), INT ( [_Anchor End Date] - _last ) )
		formatString: #,0
		displayFolder: 2 Clients
		lineageTag: 55e23da5-9a78-51d9-b72a-a777f3ba3e51

	/// Principal of the loan(s) in the window and market (drill-through tables).
	measure 'Loan In Window EUR' =
			VAR _end          = [_Win End]
			VAR _start        = [_Win Start]
			VAR _market       = [_Sel Market]
			RETURN
			    CALCULATE (
			        [_Principal EUR]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] >= _start
			            && dim_month[month_index] <= _end
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
		formatString: €#,0
		displayFolder: 1 Loans
		lineageTag: b1c32fa3-ea6c-5c4d-b6e8-fcc197e5c1e2

	/// Window as text: Sep 2026, QTD Sep 2026, YTD Sep 2026, R12M to Sep 2026.
	measure '_Window Label' =
			VAR _anchor       = [_Sel Anchor Index]
			VAR _label        =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			RETURN
			    SWITCH (
			        [_Sel Period]
			        ,"QTD"
			            ,"QTD " & _label
			        ,"YTD"
			            ,"YTD " & _label
			        ,"R12M"
			            ,"R12M to " & _label
			        ,_label
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a8d3ab30-a10c-5e22-ad1d-443e52e1fbc5

	/// Selected market name (All markets, Poland, Romania, Portugal).
	measure '_Market Name' =
			VAR _code         = [_Sel Market]
			RETURN
			    CALCULATE (
			        MAX ( param_market[market_name] )
			        ,REMOVEFILTERS ( param_market )
			        ,param_market[market_code] = _code
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 93be0f18-5176-5d99-a962-db19d0fab84a

	/// Label of the last closed month.
	measure '_Closed Label' =
			VAR _last         = [_Last Closed Index]
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9c1aecc7-779f-52b9-ae47-1ace477b792f

	/// Label of the month 6 months before the anchor (cohort / vintage of the 6-month metrics).
	measure '_Month Label Back' =
			VAR _back         = 6
			VAR _index        = [_Sel Anchor Index] - _back
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _index
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: f9c33faf-9195-552b-88b4-ffb443f574c3

	/// Title of the Overview markets table.
	measure 'Title Markets' = "Markets - " & [_Window Label]
		displayFolder: Design
		lineageTag: 3fde67dc-ccc9-5320-8863-3d12522d321d

	/// Title of the leaderboard table.
	measure 'Title Leaderboard' = "Agent & partner leaderboard - " & [_Window Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 2a474757-2f7d-5657-a42d-8302c36f5b59

	/// Title of the clients table.
	measure 'Title Clients Table' = "New clients - " & [_Window Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 38806ed5-b136-54f1-aa6b-aa3dc1799137

	/// Title of the overdue loans table (loan-level state is the last closed month).
	measure 'Title Overdue' = "Overdue loans - status at " & [_Closed Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 8ed5c4db-0e57-5f83-99ac-5d191714da35

	/// Title of the stream x market matrix.
	measure 'Title Stream Market' = "Stream x market - " & [_Window Label]
		displayFolder: Design
		lineageTag: d100a0f3-aff0-5920-88f4-be9a4d6f8b9f

	/// Loan detail title sentence from the carried filters, e.g. 1,296 loans - Romania - Step 12 - Sep 2026.
	measure 'Title Loan Detail' =
			VAR _parts        =
			    IF ( ISFILTERED ( dim_market[market_name] ), " - " & SELECTEDVALUE ( dim_market[market_name], "several markets" ) )
			        & IF ( ISFILTERED ( dim_product[product_name] ), " - " & SELECTEDVALUE ( dim_product[product_name], "several products" ) )
			        & IF ( ISFILTERED ( dim_channel[channel_name] ), " - " & SELECTEDVALUE ( dim_channel[channel_name], "several channels" ) )
			        & IF ( ISFILTERED ( dim_agent[agent_name] ), " - " & SELECTEDVALUE ( dim_agent[agent_name], "several agents" ) )
			RETURN
			    FORMAT ( [Loans], "#,0" ) & " loans" & _parts & " - " & [_Window Label]
		displayFolder: Design
		lineageTag: db1e8ec5-0777-582f-8edb-dd907983bd34

	/// Client detail title sentence.
	measure 'Title Client Detail' =
			VAR _id           = SELECTEDVALUE ( dim_client[client_id] )
			VAR _market       = SELECTEDVALUE ( dim_client[market_code] )
			VAR _first        = SELECTEDVALUE ( dim_client[first_loan_date] )
			RETURN
			    IF (
			        NOT ISBLANK ( _id )
			        ,"Client " & _id & " - " & _market & " - first loan " & FORMAT ( _first, "d mmm yyyy" ) & " - " & FORMAT ( [Client Loans to Date], "#,0" ) & " loans to date"
			        ,"Select one client"
			    )
		displayFolder: Design
		lineageTag: cf6f00f6-24e1-5c1d-825e-3e899be6e610

	/// Hero card O1 (Loans issued) face text, PATHITEM-separated: 1 value · 2 second value · 3 vs Budget row · 4 vs Prior year row · 5 chip status · 6 chip row · 7 / 8 row statuses · 9 / 10 signed bar length (px). Chip follows the header comparator and falls back to the other row when that one has no value (MS-02). Read by the SVG and the parity tests.
	measure '_Card O1 Parts' =
			VAR _value        = [Loans]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _second       = [Principal EUR]
			VAR _second_text  = IF ( ISBLANK ( _second ), "", IF ( ABS ( _second ) >= 1000000, "€" & FORMAT ( _second / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _second / 1000, "#,0" ) & "k" ) )
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [Loans Budget]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( DIVIDE ( _value - _cmp_bud, ABS ( _cmp_bud ) ), 3 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [Loans PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( DIVIDE ( _value - _cmp_py, ABS ( _cmp_py ) ), 3 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row_bud      = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_bud ), "0.0%" ) )
			VAR _row_py       = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_py ), "0.0%" ) )
			VAR _use_py       = IF ( _cmp_code = "PY", _s_py <> "neutral" || _s_bud = "neutral", _s_bud = "neutral" && _s_py <> "neutral" )
			VAR _s_chip       = IF ( _use_py, _s_py, _s_bud )
			VAR _row_chip     = IF ( _use_py, _row_py, _row_bud )
			RETURN
			    _value_text & "|" & _second_text & "|" & _row_bud & "|" & _row_py & "|" & _s_chip & "|" & _row_chip
			        & "|" & _s_bud & "|" & _s_py
			        & "|" & IF ( ISBLANK ( _d_bud ), "", FORMAT ( MIN ( ABS ( _d_bud ) / 0.2, 1 ) * 80 * SIGN ( _d_bud ), "0.0" ) )
			        & "|" & IF ( ISBLANK ( _d_py ), "", FORMAT ( MIN ( ABS ( _d_py ) / 0.2, 1 ) * 80 * SIGN ( _d_py ), "0.0" ) )
		isHidden
		displayFolder: 8 Cards
		lineageTag: 39036f8c-5af1-5be9-8211-3a4756d86dc1

	/// Sub-values of card O1 (Loans issued), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card O1 Note' =
			VAR _v1          = [Loans Budget]
			VAR _v2          = IF ( ABS ( [Principal Budget EUR] ) >= 1000000, "€" & FORMAT ( [Principal Budget EUR] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Principal Budget EUR] / 1000, "#,0" ) & "k" ) & " (" & FORMAT ( DIVIDE ( [Principal EUR], [Principal Budget EUR] ) - 1, "+0.0%;−0.0%;0.0%" ) & ")"
			VAR _v3          = "€" & FORMAT ( [Avg Ticket EUR], "#,0" ) & " (Budget " & "€" & FORMAT ( [Avg Ticket Budget EUR], "#,0" ) & ")"
			VAR _v4          = IF ( ABS ( [Loans PY] ) >= 10000, FORMAT ( [Loans PY] / 1000, "#,0.0" ) & "k", FORMAT ( [Loans PY], "#,0" ) ) & " - " & IF ( ABS ( [Principal EUR PY] ) >= 1000000, "€" & FORMAT ( [Principal EUR PY] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Principal EUR PY] / 1000, "#,0" ) & "k" )
			VAR _v5          = IF ( ABS ( [Loans YTD] ) >= 10000, FORMAT ( [Loans YTD] / 1000, "#,0.0" ) & "k", FORMAT ( [Loans YTD], "#,0" ) ) & " - " & IF ( ABS ( [Principal EUR YTD] ) >= 1000000, "€" & FORMAT ( [Principal EUR YTD] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Principal EUR YTD] / 1000, "#,0" ) & "k" )
			RETURN
			    "Budget loans " & IF ( ISBLANK ( _v1 ), "n/a", IF ( ABS ( _v1 ) >= 10000, FORMAT ( _v1 / 1000, "#,0.0" ) & "k", FORMAT ( _v1, "#,0" ) ) )
			        & " - " & "Principal vs Budget " & _v2
			        & " - " & "Avg ticket " & _v3
			        & " - " & "Prior year " & _v4
			        & " - " & FORMAT ( [_Anchor End Date], "yyyy" ) & " YTD" & " " & _v5
		displayFolder: 8 Cards
		lineageTag: e228fec0-8189-50cd-b7a7-0cbba3dec82b

	/// Hero card O1 (Loans issued), 332 x 192 SVG (layout-spec v4 §1): value, vs Budget and vs Prior year rows with 160 x 6 bars (4 px per 1 % / 16 px per pp), status chip glyph + word. Text from _Card O1 Parts. 
	measure 'Card O1 SVG' =
			VAR _p            = [_Card O1 Parts]
			VAR _second       = PATHITEM ( _p, 2 )
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _chip_row     = PATHITEM ( _p, 6 )
			VAR _glyph        = IF ( LEFT ( _chip_row, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _chip_row, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 316 - _chip_w & "' y='16' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - _chip_w / 2 & "' y='28' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _row3         =
			    VAR _txt          = PATHITEM ( _p, 3 )
			    VAR _st           = PATHITEM ( _p, 7 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 9 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='108' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='108' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='103' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='103' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='101' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row4         =
			    VAR _txt          = PATHITEM ( _p, 4 )
			    VAR _st           = PATHITEM ( _p, 8 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 10 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='132' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='132' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='127' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='127' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='125' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='28' font-size='12' font-weight='500' fill='#5C5C58'>Loans issued</text>"
			        & _chip
			        & "<text x='16' y='80' font-size='44' font-weight='800' fill='#111111' letter-spacing='-0.9'>" & PATHITEM ( _p, 1 ) & IF ( _second <> "", "<tspan dx='12' font-size='18' letter-spacing='0'>" & _second & "</tspan>" ) & "</text>"
			        & _row3
			        & _row4
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b451cc3d-4b05-56c2-877f-8160f3536894
		dataCategory: ImageUrl

	/// Hero card O2 (New clients locked in) face text, PATHITEM-separated: 1 value · 2 second value · 3 vs Budget row · 4 vs Prior year row · 5 chip status · 6 chip row · 7 / 8 row statuses · 9 / 10 signed bar length (px). Chip follows the header comparator and falls back to the other row when that one has no value (MS-02). Read by the SVG and the parity tests.
	measure '_Card O2 Parts' =
			VAR _value        = [New Clients]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _second_text  = ""
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [New Clients Budget]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( DIVIDE ( _value - _cmp_bud, ABS ( _cmp_bud ) ), 3 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [New Clients PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( DIVIDE ( _value - _cmp_py, ABS ( _cmp_py ) ), 3 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row_bud      = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_bud ), "0.0%" ) )
			VAR _row_py       = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_py ), "0.0%" ) )
			VAR _use_py       = IF ( _cmp_code = "PY", _s_py <> "neutral" || _s_bud = "neutral", _s_bud = "neutral" && _s_py <> "neutral" )
			VAR _s_chip       = IF ( _use_py, _s_py, _s_bud )
			VAR _row_chip     = IF ( _use_py, _row_py, _row_bud )
			RETURN
			    _value_text & "|" & _second_text & "|" & _row_bud & "|" & _row_py & "|" & _s_chip & "|" & _row_chip
			        & "|" & _s_bud & "|" & _s_py
			        & "|" & IF ( ISBLANK ( _d_bud ), "", FORMAT ( MIN ( ABS ( _d_bud ) / 0.2, 1 ) * 80 * SIGN ( _d_bud ), "0.0" ) )
			        & "|" & IF ( ISBLANK ( _d_py ), "", FORMAT ( MIN ( ABS ( _d_py ) / 0.2, 1 ) * 80 * SIGN ( _d_py ), "0.0" ) )
		isHidden
		displayFolder: 8 Cards
		lineageTag: f4f2ef73-0c2a-5f50-ada1-b76f79257c88

	/// Sub-values of card O2 (New clients locked in), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card O2 Note' =
			VAR _v1          = [New Clients Share of Loans]
			VAR _v2          = [New Clients Channels]
			VAR _v3          = [New Clients Budget]
			VAR _v4          = [New Clients PY]
			RETURN
			    "Share of loans " & IF ( ISBLANK ( _v1 ), "n/a", FORMAT ( _v1, "0.0%" ) )
			        & " - " & "By channel " & _v2
			        & " - " & "Budget " & IF ( ISBLANK ( _v3 ), "n/a", IF ( ABS ( _v3 ) >= 10000, FORMAT ( _v3 / 1000, "#,0.0" ) & "k", FORMAT ( _v3, "#,0" ) ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v4 ), "n/a", IF ( ABS ( _v4 ) >= 10000, FORMAT ( _v4 / 1000, "#,0.0" ) & "k", FORMAT ( _v4, "#,0" ) ) )
		displayFolder: 8 Cards
		lineageTag: fd00ae8c-6b35-591b-8cc1-255349a30d5c

	/// Hero card O2 (New clients locked in), 332 x 192 SVG (layout-spec v4 §1): value, vs Budget and vs Prior year rows with 160 x 6 bars (4 px per 1 % / 16 px per pp), status chip glyph + word. Text from _Card O2 Parts. 
	measure 'Card O2 SVG' =
			VAR _p            = [_Card O2 Parts]
			VAR _second       = PATHITEM ( _p, 2 )
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _chip_row     = PATHITEM ( _p, 6 )
			VAR _glyph        = IF ( LEFT ( _chip_row, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _chip_row, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 316 - _chip_w & "' y='16' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - _chip_w / 2 & "' y='28' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _row3         =
			    VAR _txt          = PATHITEM ( _p, 3 )
			    VAR _st           = PATHITEM ( _p, 7 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 9 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='108' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='108' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='103' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='103' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='101' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row4         =
			    VAR _txt          = PATHITEM ( _p, 4 )
			    VAR _st           = PATHITEM ( _p, 8 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 10 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='132' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='132' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='127' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='127' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='125' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='28' font-size='12' font-weight='500' fill='#5C5C58'>New clients locked in</text>"
			        & _chip
			        & "<text x='16' y='80' font-size='44' font-weight='800' fill='#111111' letter-spacing='-0.9'>" & PATHITEM ( _p, 1 ) & IF ( _second <> "", "<tspan dx='12' font-size='18' letter-spacing='0'>" & _second & "</tspan>" ) & "</text>"
			        & _row3
			        & _row4
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 8092534b-3394-54fb-b095-8fd9379846a9
		dataCategory: ImageUrl

	/// Hero card O3 (Returning clients) face text, PATHITEM-separated: 1 value · 2 second value · 3 vs Budget row · 4 vs Prior year row · 5 chip status · 6 chip row · 7 / 8 row statuses · 9 / 10 signed bar length (px). Chip follows the header comparator and falls back to the other row when that one has no value (MS-02). Read by the SVG and the parity tests.
	measure '_Card O3 Parts' =
			VAR _value        = [Returning %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _second_text  = ""
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = BLANK ()
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( ( _value - _cmp_bud ) * 100, 1 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [Returning % PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( ( _value - _cmp_py ) * 100, 1 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row_bud      = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_bud ), "0.0" ) & "pp" )
			VAR _row_py       = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_py ), "0.0" ) & "pp" )
			VAR _use_py       = IF ( _cmp_code = "PY", _s_py <> "neutral" || _s_bud = "neutral", _s_bud = "neutral" && _s_py <> "neutral" )
			VAR _s_chip       = IF ( _use_py, _s_py, _s_bud )
			VAR _row_chip     = IF ( _use_py, _row_py, _row_bud )
			RETURN
			    _value_text & "|" & _second_text & "|" & _row_bud & "|" & _row_py & "|" & _s_chip & "|" & _row_chip
			        & "|" & _s_bud & "|" & _s_py
			        & "|" & IF ( ISBLANK ( _d_bud ), "", FORMAT ( MIN ( ABS ( _d_bud ) / 5, 1 ) * 80 * SIGN ( _d_bud ), "0.0" ) )
			        & "|" & IF ( ISBLANK ( _d_py ), "", FORMAT ( MIN ( ABS ( _d_py ) / 5, 1 ) * 80 * SIGN ( _d_py ), "0.0" ) )
		isHidden
		displayFolder: 8 Cards
		lineageTag: 9d6298ab-8cbc-5099-9329-e313e3702b18

	/// Sub-values of card O3 (Returning clients), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card O3 Note' =
			VAR _v1          = FORMAT ( [Returning Clients], "#,0" ) & " of " & FORMAT ( [Borrowers], "#,0" )
			VAR _v2          = [Repeat Share]
			VAR _v3          = [_Month Label Back] & ") " & FORMAT ( [180-day Repeat %], "0.0%" )
			VAR _v4          = [90-day Repeat %]
			VAR _v5          = [Returning % PY]
			VAR _v6          = "none for this ratio"
			RETURN
			    "Returning borrowers " & _v1
			        & " - " & "Loan-weighted " & IF ( ISBLANK ( _v2 ), "n/a", FORMAT ( _v2, "0.0%" ) )
			        & " - " & "180-day repeat (cohort " & _v3
			        & " - " & "90-day repeat " & IF ( ISBLANK ( _v4 ), "n/a", FORMAT ( _v4, "0.0%" ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v5 ), "n/a", FORMAT ( _v5, "0.0%" ) )
			        & " - " & "Budget " & _v6
		displayFolder: 8 Cards
		lineageTag: a42a597b-eff6-5b37-b953-4bfc1ddc87a2

	/// Hero card O3 (Returning clients), 332 x 192 SVG (layout-spec v4 §1): value, vs Budget and vs Prior year rows with 160 x 6 bars (4 px per 1 % / 16 px per pp), status chip glyph + word. Text from _Card O3 Parts. 
	measure 'Card O3 SVG' =
			VAR _p            = [_Card O3 Parts]
			VAR _second       = PATHITEM ( _p, 2 )
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _chip_row     = PATHITEM ( _p, 6 )
			VAR _glyph        = IF ( LEFT ( _chip_row, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _chip_row, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 316 - _chip_w & "' y='16' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - _chip_w / 2 & "' y='28' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _row3         =
			    VAR _txt          = PATHITEM ( _p, 3 )
			    VAR _st           = PATHITEM ( _p, 7 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 9 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='108' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='108' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='103' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='103' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='101' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row4         =
			    VAR _txt          = PATHITEM ( _p, 4 )
			    VAR _st           = PATHITEM ( _p, 8 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 10 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='132' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='132' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='127' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='127' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='125' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='28' font-size='12' font-weight='500' fill='#5C5C58'>Returning clients</text>"
			        & _chip
			        & "<text x='16' y='80' font-size='44' font-weight='800' fill='#111111' letter-spacing='-0.9'>" & PATHITEM ( _p, 1 ) & IF ( _second <> "", "<tspan dx='12' font-size='18' letter-spacing='0'>" & _second & "</tspan>" ) & "</text>"
			        & _row3
			        & _row4
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b08f4a6a-59d2-5aba-b908-cfeb6eb24a3f
		dataCategory: ImageUrl

	/// Hero card O4 (Bad / overdue loans) face text, PATHITEM-separated: 1 value · 2 second value · 3 vs Budget row · 4 vs Prior year row · 5 chip status · 6 chip row · 7 / 8 row statuses · 9 / 10 signed bar length (px). Chip follows the header comparator and falls back to the other row when that one has no value (MS-02). Read by the SVG and the parity tests.
	measure '_Card O4 Parts' =
			VAR _value        = [DPD30 %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _second_text  = ""
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [DPD30 Budget %]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( ( _value - _cmp_bud ) * 100, 1 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud <= 0
			                ,"good"
			            ,_d_bud <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [DPD30 % PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( ( _value - _cmp_py ) * 100, 1 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py <= 0
			                ,"good"
			            ,_d_py <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row_bud      = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_bud ), "0.0" ) & "pp" )
			VAR _row_py       = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d_py ), "0.0" ) & "pp" )
			VAR _use_py       = IF ( _cmp_code = "PY", _s_py <> "neutral" || _s_bud = "neutral", _s_bud = "neutral" && _s_py <> "neutral" )
			VAR _s_chip       = IF ( _use_py, _s_py, _s_bud )
			VAR _row_chip     = IF ( _use_py, _row_py, _row_bud )
			RETURN
			    _value_text & "|" & _second_text & "|" & _row_bud & "|" & _row_py & "|" & _s_chip & "|" & _row_chip
			        & "|" & _s_bud & "|" & _s_py
			        & "|" & IF ( ISBLANK ( _d_bud ), "", FORMAT ( MIN ( ABS ( _d_bud ) / 5, 1 ) * 80 * SIGN ( _d_bud ), "0.0" ) )
			        & "|" & IF ( ISBLANK ( _d_py ), "", FORMAT ( MIN ( ABS ( _d_py ) / 5, 1 ) * 80 * SIGN ( _d_py ), "0.0" ) )
		isHidden
		displayFolder: 8 Cards
		lineageTag: 68869c08-ea4b-54c8-a20e-d601ef9bc83a

	/// Sub-values of card O4 (Bad / overdue loans), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card O4 Note' =
			VAR _v1          = IF ( ABS ( [DPD30 Balance EUR] ) >= 1000000, "€" & FORMAT ( [DPD30 Balance EUR] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [DPD30 Balance EUR] / 1000, "#,0" ) & "k" ) & " of " & IF ( ABS ( [Outstanding EUR] ) >= 1000000, "€" & FORMAT ( [Outstanding EUR] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Outstanding EUR] / 1000, "#,0" ) & "k" )
			VAR _v2          = [DPD90 %]
			VAR _v3          = [DPD30 Count %]
			VAR _v4          = [_Month Label Back] & ") " & FORMAT ( [Vintage 6m Bad Rate], "0.0%" )
			VAR _v5          = [DPD30 Budget %]
			VAR _v6          = [DPD30 % PY]
			RETURN
			    "30+ DPD balance " & _v1
			        & " - " & "90+ DPD by balance " & IF ( ISBLANK ( _v2 ), "n/a", FORMAT ( _v2, "0.0%" ) )
			        & " - " & "30+ by count " & IF ( ISBLANK ( _v3 ), "n/a", FORMAT ( _v3, "0.0%" ) )
			        & " - " & "Vintage 6m bad rate ( " & _v4
			        & " - " & "Budget appetite (outstanding-weighted) " & IF ( ISBLANK ( _v5 ), "n/a", FORMAT ( _v5, "0.0%" ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v6 ), "n/a", FORMAT ( _v6, "0.0%" ) )
		displayFolder: 8 Cards
		lineageTag: 0e978562-7220-5eef-8780-7a5d0c1122cc

	/// Hero card O4 (Bad / overdue loans), 332 x 192 SVG (layout-spec v4 §1): value, vs Budget and vs Prior year rows with 160 x 6 bars (4 px per 1 % / 16 px per pp), status chip glyph + word. Text from _Card O4 Parts. 
	measure 'Card O4 SVG' =
			VAR _p            = [_Card O4 Parts]
			VAR _second       = PATHITEM ( _p, 2 )
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _chip_row     = PATHITEM ( _p, 6 )
			VAR _glyph        = IF ( LEFT ( _chip_row, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _chip_row, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 316 - _chip_w & "' y='16' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - _chip_w / 2 & "' y='28' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _row3         =
			    VAR _txt          = PATHITEM ( _p, 3 )
			    VAR _st           = PATHITEM ( _p, 7 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 9 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='108' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='108' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='103' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='103' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='101' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row4         =
			    VAR _txt          = PATHITEM ( _p, 4 )
			    VAR _st           = PATHITEM ( _p, 8 )
			    VAR _ink          = SWITCH ( _st, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _bar          = PATHITEM ( _p, 10 )
			    VAR _len          = IF ( _bar = "", 0, ABS ( VALUE ( _bar ) ) )
			    VAR _bar_x        = IF ( _bar = "", 252, IF ( VALUE ( _bar ) < 0, 252 - _len, 252 ) )
			    RETURN
			        "<text x='16' y='132' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='132' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _txt & "</text>"
			            & IF (
			                _bar <> ""
			                ,"<rect x='172' y='127' width='160' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='127' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='251.5' y='125' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='28' font-size='12' font-weight='500' fill='#5C5C58'>Bad / overdue loans</text>"
			        & _chip
			        & "<text x='16' y='80' font-size='44' font-weight='800' fill='#111111' letter-spacing='-0.9'>" & PATHITEM ( _p, 1 ) & IF ( _second <> "", "<tspan dx='12' font-size='18' letter-spacing='0'>" & _second & "</tspan>" ) & "</text>"
			        & _row3
			        & _row4
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b01cff63-9cd2-5a43-8b9f-e8aa42b3915e
		dataCategory: ImageUrl

	/// Label of the anchor month, e.g. Sep 2026.
	measure '_Anchor Label' =
			VAR _anchor       = [_Sel Anchor Index]
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 80b5b499-e0aa-58e3-b733-24aac0b0b72d

	/// New clients of the window per acquisition channel with their share, largest first, e.g. App 3,620 (37%) - Partner 2,846 (29%) (O2 info, as Track C).
	measure 'New Clients Channels' =
			VAR _total        = [New Clients]
			VAR _channels     =
			    ADDCOLUMNS (
			        VALUES ( dim_channel[channel_code] )
			        ,"@n", [New Clients]
			    )
			RETURN
			    CONCATENATEX (
			        FILTER ( _channels, NOT ISBLANK ( [@n] ) )
			        ,SWITCH ( dim_channel[channel_code], "APP", "App", "PAID", "Paid", "PARTNER", "Partner", "Agent" )
			            & " " & IF ( [@n] >= 9999.5, FORMAT ( [@n] / 1000, "#,0.0" ) & "k", FORMAT ( [@n], "#,0" ) )
			            & " (" & FORMAT ( DIVIDE ( [@n], _total ), "0%" ) & ")"
			        ," - "
			        ,[@n], DESC
			    )
		displayFolder: 2 Clients
		lineageTag: 11f36cde-45cb-548a-9b42-48166dc057a5

	/// KPI card L1 (Loans) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Header comparator (Budget or PY). Read by the SVG and the parity tests.
	measure '_Card L1 Parts' =
			VAR _value        = [Loans]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_code     = IF ( [_Sel Comparator] = "PY", "PY", "BUD" )
			VAR _cmp_name     = IF ( _cmp_code = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( _cmp_code = "PY", [Loans PY], [Loans Budget] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 408bfc27-5949-51f6-95f7-a3f86e8414fe

	/// Sub-values of card L1 (Loans), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card L1 Note' =
			VAR _v1          = [Loans Budget]
			VAR _v2          = [Loans PY]
			RETURN
			    "Budget " & IF ( ISBLANK ( _v1 ), "n/a", IF ( ABS ( _v1 ) >= 10000, FORMAT ( _v1 / 1000, "#,0.0" ) & "k", FORMAT ( _v1, "#,0" ) ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v2 ), "n/a", IF ( ABS ( _v2 ) >= 10000, FORMAT ( _v2 / 1000, "#,0.0" ) & "k", FORMAT ( _v2, "#,0" ) ) )
		displayFolder: 8 Cards
		lineageTag: c35f1e92-d683-5db8-a2e3-6026545e80ee

	/// KPI card L1 (Loans), 216 x 120 SVG: value, one comparator row, status chip glyph + word. Text from _Card L1 Parts.
	measure 'Card L1 SVG' =
			VAR _p            = [_Card L1 Parts]
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _delta_text   = PATHITEM ( _p, 4 )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _glyph        = IF ( LEFT ( _delta_text, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _delta_text, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 200 - _chip_w & "' y='24' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - _chip_w / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Loans</text>"
			        & _chip
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & PATHITEM ( _p, 1 ) & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & PATHITEM ( _p, 3 ) & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 9995d40e-d739-59e0-b236-48d4ad4c7ba7
		dataCategory: ImageUrl

	/// KPI card L2 (Principal) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Header comparator (Budget or PY). Read by the SVG and the parity tests.
	measure '_Card L2 Parts' =
			VAR _value        = [Principal EUR]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 1000000, "€" & FORMAT ( _value / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _value / 1000, "#,0" ) & "k" ) )
			VAR _cmp_code     = IF ( [_Sel Comparator] = "PY", "PY", "BUD" )
			VAR _cmp_name     = IF ( _cmp_code = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( _cmp_code = "PY", [Principal EUR PY], [Principal Budget EUR] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 7c80cd51-d2bb-540c-81c6-aee406c39ee0

	/// Sub-values of card L2 (Principal), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card L2 Note' =
			VAR _v1          = [Principal Budget EUR]
			VAR _v2          = [Principal EUR at Budget FX]
			VAR _v3          = DIVIDE ( [Principal EUR at Budget FX], [Principal Budget EUR] ) - 1
			VAR _v4          = [Principal EUR PY]
			RETURN
			    "Budget " & IF ( ISBLANK ( _v1 ), "n/a", IF ( ABS ( _v1 ) >= 1000000, "€" & FORMAT ( _v1 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v1 / 1000, "#,0" ) & "k" ) )
			        & " - " & "At Budget FX " & IF ( ISBLANK ( _v2 ), "n/a", IF ( ABS ( _v2 ) >= 1000000, "€" & FORMAT ( _v2 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v2 / 1000, "#,0" ) & "k" ) )
			        & " - " & "Δ vs Budget at Budget FX " & IF ( ISBLANK ( _v3 ), "n/a", FORMAT ( _v3, "+0.0%;−0.0%;0.0%" ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v4 ), "n/a", IF ( ABS ( _v4 ) >= 1000000, "€" & FORMAT ( _v4 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v4 / 1000, "#,0" ) & "k" ) )
		displayFolder: 8 Cards
		lineageTag: f0d8e1fa-ea3d-528f-aa7e-1ddbfdd1422d

