	/// KPI card R1 (Revenue) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Header comparator (Budget or PY). Read by the SVG and the parity tests.
	measure '_Card R1 Parts' =
			VAR _value        = [Revenue EUR]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 1000000, "€" & FORMAT ( _value / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _value / 1000, "#,0" ) & "k" ) )
			VAR _cmp_code     = IF ( [_Sel Comparator] = "PY", "PY", "BUD" )
			VAR _cmp_name     = IF ( _cmp_code = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( _cmp_code = "PY", [Revenue EUR PY], [Revenue Budget EUR] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 59b4114c-d358-54d3-9ecf-e1abd3b1daf4

	/// Sub-values of card R1 (Revenue), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card R1 Note' =
			VAR _v1          = IF ( ABS ( [Interest EUR] ) >= 1000000, "€" & FORMAT ( [Interest EUR] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Interest EUR] / 1000, "#,0" ) & "k" ) & " - " & FORMAT ( DIVIDE ( [Interest EUR], [Revenue EUR] ), "0%" )
			VAR _v2          = IF ( ABS ( [Fees EUR] ) >= 1000000, "€" & FORMAT ( [Fees EUR] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Fees EUR] / 1000, "#,0" ) & "k" ) & " - " & FORMAT ( DIVIDE ( [Fees EUR], [Revenue EUR] ), "0%" )
			VAR _v3          = [Interchange EUR]
			VAR _v4          = [Subscription EUR]
			VAR _v5          = [Revenue Budget EUR]
			RETURN
			    "Interest " & _v1
			        & " - " & "Fees " & _v2
			        & " - " & "Interchange " & IF ( ISBLANK ( _v3 ), "n/a", IF ( ABS ( _v3 ) >= 1000000, "€" & FORMAT ( _v3 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v3 / 1000, "#,0" ) & "k" ) )
			        & " - " & "Subscriptions " & IF ( ISBLANK ( _v4 ), "n/a", IF ( ABS ( _v4 ) >= 1000000, "€" & FORMAT ( _v4 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v4 / 1000, "#,0" ) & "k" ) )
			        & " - " & "Budget " & IF ( ISBLANK ( _v5 ), "n/a", IF ( ABS ( _v5 ) >= 1000000, "€" & FORMAT ( _v5 / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _v5 / 1000, "#,0" ) & "k" ) )
		displayFolder: 8 Cards
		lineageTag: 93d36f33-8d4d-53cf-98a6-54bacabeeb82

