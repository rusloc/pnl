	/// How to read: the selection in words, as Track C's periodLine (layout-spec §0.1: the sentence lives only in How to read), e.g. Showing Sep 2026 - Month - All markets - Actual vs Budget and Prior year - Closed through Sep 2026.
	measure 'How To Read Showing' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _from         = MAX ( _start, 1 )
			VAR _label_end    =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			VAR _label_from   =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _from
			    )
			VAR _range        =
			    SWITCH (
			        TRUE ()
			        ,_from = _end
			            ,_label_end
			        ,INT ( ( _from - 1 ) / 12 ) = INT ( ( _end - 1 ) / 12 )
			            ,LEFT ( _label_from, 3 ) & "–" & _label_end
			        ,_label_from & "–" & _label_end
			    )
			VAR _first_label  =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = 1
			    )
			VAR _shown        = IF ( _start >= 1, _range, _range & " (data from " & _first_label & ")" )
			VAR _period       = SWITCH ( [_Sel Period], "QTD", "QTD", "YTD", "YTD", "R12M", "R12M", "Month" )
			VAR _versions     = IF ( [_Sel Comparator] = "PY", "Actual vs Prior year and Budget", "Actual vs Budget and Prior year" )
			RETURN
			    "Showing " & _shown & " - " & _period & " - " & [_Market Name] & " - " & _versions & " - Closed through " & [_Closed Label]
		displayFolder: Design
		lineageTag: 4a599123-8b00-5dc1-9c0f-189662b9842e

	column measure_table
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7ad08ccc-fd37-5023-b9f3-0c2d3944f749
		summarizeBy: none
		isNameInferred
		sourceColumn: [measure_table]

		annotation SummarizationSetBy = User

	partition _measures = calculated
		mode: import
		source = ROW ( "measure_table", 0 )

	annotation PBI_ResultType = Table
