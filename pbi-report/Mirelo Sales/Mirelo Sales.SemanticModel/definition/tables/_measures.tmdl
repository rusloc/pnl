	/// Loans, year to date of the anchor month (O1 info).
	measure 'Loans YTD' =
			CALCULATE (
			    [Loans]
			    ,REMOVEFILTERS ( param_period )
			    ,TREATAS ( { "YTD" }, param_period[period_code] )
			)
		formatString: #,0
		displayFolder: 1 Loans
		lineageTag: 58c6d346-2cbd-5900-ac2f-963674340058

	/// Principal EUR, year to date of the anchor month (O1 info).
	measure 'Principal EUR YTD' =
			CALCULATE (
			    [Principal EUR]
			    ,REMOVEFILTERS ( param_period )
			    ,TREATAS ( { "YTD" }, param_period[period_code] )
			)
		formatString: #,0
		displayFolder: 1 Loans
		lineageTag: 9299e9a0-3a97-54fc-96e3-16c32f357d41

	/// Cohort repeat curve: share of a quarter cohort (slot relative to the anchor quarter) with a repeat loan within N days of the first loan, among clients observable for N days by the end of the anchor month (censoring-aware); blank under 100 observable clients.
	measure 'Cohort Repeat %' =
			VAR _slot         = SELECTEDVALUE ( param_cohort_slot[slot_code] )
			VAR _days         = SELECTEDVALUE ( param_days[days_since_first] )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _quarter      = INT ( ( _anchor - 1 ) / 3 ) - _slot
			VAR _cutoff       = [_Anchor End Date]
			VAR _market       = [_Sel Market]
			VAR _filter       =
			    FILTER (
			        ALL ( dim_client[market_code] )
			        ,_market = "ALL"
			            || dim_client[market_code] = _market
			    )
			VAR _observed     =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_quarter_index] = _quarter
			        ,dim_client[first_loan_date] <= _cutoff - _days
			        ,KEEPFILTERS ( _filter )
			    )
			VAR _repeat       =
			    CALCULATE (
			        COUNTROWS ( dim_client )
			        ,dim_client[cohort_quarter_index] = _quarter
			        ,dim_client[first_loan_date] <= _cutoff - _days
			        ,NOT ISBLANK ( dim_client[days_to_second_loan] )
			            && dim_client[days_to_second_loan] <= _days
			        ,KEEPFILTERS ( _filter )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _slot )
			            && NOT ISBLANK ( _days )
			            && _observed >= 100
			        ,DIVIDE ( _repeat + 0, _observed )
			    )
		formatString: 0.0%
		displayFolder: 2 Clients
		lineageTag: bd0aad92-0c12-562a-aeb2-05f943b50f90

	/// Vintage curve: cumulative share of a vintage quarter's loans that reached 30+ DPD by N months on book (vintage months observable for N months by the anchor).
	measure 'Vintage Curve 30+ %' =
			VAR _slot         = SELECTEDVALUE ( param_cohort_slot[slot_code] )
			VAR _mob          = SELECTEDVALUE ( param_mob[months_on_book] )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _quarter      = INT ( ( _anchor - 1 ) / 3 ) - _slot
			VAR _last_vintage = _anchor - _mob
			VAR _market       = [_Sel Market]
			VAR _bad          =
			    CALCULATE (
			        SUM ( fact_loan_month[loans_first_30p] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan_month[vintage_quarter_index] = _quarter
			        ,fact_loan_month[months_on_book] <= _mob
			        ,fact_loan_month[vintage_index] <= _last_vintage
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
			VAR _volume       =
			    CALCULATE (
			        SUM ( fact_loan_month[loans_disbursed] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan_month[vintage_quarter_index] = _quarter
			        ,fact_loan_month[vintage_index] <= _last_vintage
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _slot )
			            && NOT ISBLANK ( _mob )
			            && _volume > 0
			        ,DIVIDE ( _bad, _volume )
			    )
		formatString: 0.0%
		displayFolder: 4 Portfolio
		lineageTag: fe8b9847-3ccf-5f47-a708-10310ebf6c47

	/// Loans vs the selected comparator, %.
	measure 'Loans Δ Cmp %' =
			VAR _value        = [Loans]
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Loans PY], [Loans Budget] )
			RETURN
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,DIVIDE ( _value - _cmp, _cmp )
			    )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 1 Loans
		lineageTag: 8738eee8-5589-53ff-93b0-76f46b7f72f9

	/// Revenue minus budget, EUR.
	measure 'Revenue Δ Budget EUR' =
			IF (
			    NOT ISBLANK ( [Revenue Budget EUR] )
			    ,[Revenue EUR] - [Revenue Budget EUR]
			)
		formatString: +#,0;−#,0;0
		displayFolder: 5 Revenue
		lineageTag: d77ecc14-e77c-5273-aeb6-5b804b3ce91c

	/// Revenue vs budget, %.
	measure 'Revenue Δ Budget %' = DIVIDE ( [Revenue EUR] - [Revenue Budget EUR], [Revenue Budget EUR] )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 5 Revenue
		lineageTag: 4fc0bf1f-1675-538b-a944-8f76028231c1

	/// Revenue vs prior year, %.
	measure 'Revenue Δ PY %' = DIVIDE ( [Revenue EUR] - [Revenue EUR PY], [Revenue EUR PY] )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 5 Revenue
		lineageTag: 55e9b690-63e5-58c2-8424-6a6df6b056fb

	/// Status code of loans vs the selected comparator (design-tokens §6 counts rule).
	measure '_Loans Status' =
			VAR _delta        = ROUND ( [Loans Δ Cmp %], 3 )
			RETURN
			    IF (
			        NOT ISBLANK ( _delta )
			        ,SWITCH (
			            TRUE ()
			            ,_delta >= 0
			                ,"good"
			            ,_delta >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9ab85d50-c965-5e68-8a12-cfa9e6e65297

	/// Status word for loans vs the selected comparator: Good, Watch, Off or n/a.
	measure 'Loans Status' = SWITCH ( [_Loans Status], "good", "Good", "watch", "Watch", "off", "Off", "n/a" )
		displayFolder: Design
		lineageTag: 1cb1d46c-538e-518f-bb2c-b0feac84862a

	/// Status text colour (fx).
	measure 'Loans Status Ink' = SWITCH ( [_Loans Status], "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
		displayFolder: Design
		lineageTag: 5add19c5-adb5-5894-bbcc-e4c4e744dd1d

	/// Status chip fill (fx).
	measure 'Loans Status Fill' = SWITCH ( [_Loans Status], "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" )
		displayFolder: Design
		lineageTag: 6e423486-2349-5c12-b31f-fca7d69e14f5

	/// Status code of revenue vs the selected comparator.
	measure '_Revenue Status' =
			VAR _value        = [Revenue EUR]
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Revenue EUR PY], [Revenue Budget EUR] )
			VAR _delta        = IF ( NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp ), ROUND ( DIVIDE ( _value - _cmp, _cmp ), 3 ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _delta )
			        ,SWITCH (
			            TRUE ()
			            ,_delta >= 0
			                ,"good"
			            ,_delta >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: d6e7f8a7-93c6-5724-b176-9aff4be7c655

	/// Status word for revenue vs the selected comparator.
	measure 'Revenue Status' = SWITCH ( [_Revenue Status], "good", "Good", "watch", "Watch", "off", "Off", "n/a" )
		displayFolder: Design
		lineageTag: bed4ff99-e04e-5b89-b649-987d809de0dd

	/// Status text colour (fx).
	measure 'Revenue Status Ink' = SWITCH ( [_Revenue Status], "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
		displayFolder: Design
		lineageTag: 078b442e-80b5-57c3-822d-0b3946114942

	/// Status chip fill (fx).
	measure 'Revenue Status Fill' = SWITCH ( [_Revenue Status], "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" )
		displayFolder: Design
		lineageTag: 7db7dccf-afad-5a20-8f0c-44a89b7d8b69

	/// Status code of agent attainment (param_thresholds attainment_pct: >= 100 % good, 95-100 % watch, < 95 % off).
	measure '_Agent Status' =
			VAR _att          = ROUND ( [Agent Attainment], 3 )
			VAR _amber        =
			    CALCULATE (
			        MIN ( param_thresholds[min_value] )
			        ,param_thresholds[metric_code] = "attainment_pct"
			        ,param_thresholds[band_code] = "AMBER"
			    )
			VAR _green        =
			    CALCULATE (
			        MIN ( param_thresholds[min_value] )
			        ,param_thresholds[metric_code] = "attainment_pct"
			        ,param_thresholds[band_code] = "GREEN"
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _att )
			            ,"neutral"
			        ,_att >= _green
			            ,"good"
			        ,_att >= _amber
			            ,"watch"
			        ,"off"
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: c75aea7a-1308-5c95-99e3-85893c397272

	/// Status word for agent attainment.
	measure 'Agent Status' = SWITCH ( [_Agent Status], "good", "Good", "watch", "Watch", "off", "Off", "n/a" )
		displayFolder: Design
		lineageTag: c861d279-bcc8-5242-98e0-9c23d06937e6

	/// Status text colour (fx).
	measure 'Agent Status Ink' = SWITCH ( [_Agent Status], "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
		displayFolder: Design
		lineageTag: 99f250c6-d40c-5129-8140-7b11ec1b288d

	/// Status chip fill (fx).
	measure 'Agent Status Fill' = SWITCH ( [_Agent Status], "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" )
		displayFolder: Design
		lineageTag: 6994b7d2-f1fc-59cd-9816-f8f63dc394be

	/// Tag for the 2026 ramp cohort (blank otherwise).
	measure 'Agent Tag' =
			IF (
			    SELECTEDVALUE ( dim_agent[is_ramp_cohort] ) = TRUE ()
			    ,"Ramp cohort"
			    ,""
			)
		displayFolder: 6 Agents
		lineageTag: fec3acee-31a1-5d4e-8932-0bf02ac80526

	/// Status code of revenue attainment (param_thresholds attainment_pct).
	measure '_Revenue Attainment Status' =
			VAR _att          = ROUND ( [Revenue Attainment], 3 )
			VAR _amber        =
			    CALCULATE (
			        MIN ( param_thresholds[min_value] )
			        ,param_thresholds[metric_code] = "attainment_pct"
			        ,param_thresholds[band_code] = "AMBER"
			    )
			VAR _green        =
			    CALCULATE (
			        MIN ( param_thresholds[min_value] )
			        ,param_thresholds[metric_code] = "attainment_pct"
			        ,param_thresholds[band_code] = "GREEN"
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _att )
			            ,"neutral"
			        ,_att >= _green
			            ,"good"
			        ,_att >= _amber
			            ,"watch"
			        ,"off"
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 7703012e-4064-5cd0-84e2-398fb88c27bb

	/// Loans per month, 13 months to the anchor.
	measure 'Loans Trend' =
			VAR _anchor       = [_Sel Anchor Index]
			VAR _month        = SELECTEDVALUE ( dim_month[month_index] )
			VAR _market       = [_Sel Market]
			RETURN
			    IF (
			        _month > _anchor - 13
			            && _month <= _anchor
			        ,CALCULATE (
			            [_Loans]
			            ,REMOVEFILTERS ( dim_month )
			            ,dim_month[month_index] = _month
			            ,KEEPFILTERS (
			                FILTER (
			                    ALL ( dim_market[market_code] )
			                    ,_market = "ALL"
			                        || dim_market[market_code] = _market
			                )
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 7 Trend
		lineageTag: 1b3d34b6-aa46-5438-b290-b1ca0e000580

