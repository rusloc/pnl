			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( _value - _cmp, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d <= 0
			                ,"good"
			            ,_d <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0" ) & " h" )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 27454982-ef65-5e01-a7cb-8c598d7d80f2

	/// Sub-values of card L6 (Time to cash), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card L6 Note' =
			VAR _v1          = [Time to Cash h PY]
			RETURN
			    "Prior year " & IF ( ISBLANK ( _v1 ), "n/a", FORMAT ( _v1, "0.0" ) & " h" )
		displayFolder: 8 Cards
		lineageTag: 714aa184-a6ea-55ec-b730-1bb81732faae

	/// KPI card L6 (Time to cash), 216 x 120 SVG: value, one comparator row, status chip glyph + word. Text from _Card L6 Parts.
	measure 'Card L6 SVG' =
			VAR _p            = [_Card L6 Parts]
			VAR _s            = PATHITEM ( _p, 5 )
			VAR _delta_text   = PATHITEM ( _p, 4 )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _glyph        = IF ( LEFT ( _delta_text, 1 ) IN { "▲", "▼", "◦" }, LEFT ( _delta_text, 1 ) & " " )
			VAR _chip_w       = SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) + IF ( _glyph <> "", 14, 0 )
			VAR _chip         =
			    "<rect x='" & 200 - _chip_w & "' y='24' width='" & _chip_w & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - _chip_w / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>"
			        & _glyph & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Time to cash</text>"
			        & _chip
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & PATHITEM ( _p, 1 ) & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & PATHITEM ( _p, 3 ) & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 1c048eac-f911-519a-bdae-d688a7adc6b2
		dataCategory: ImageUrl

	/// KPI card C1 (New clients) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Header comparator (Budget or PY). Read by the SVG and the parity tests.
	measure '_Card C1 Parts' =
			VAR _value        = [New Clients]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_code     = IF ( [_Sel Comparator] = "PY", "PY", "BUD" )
			VAR _cmp_name     = IF ( _cmp_code = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( _cmp_code = "PY", [New Clients PY], [New Clients Budget] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: c472f24d-1279-5ca0-92ef-dc0bc3324eed

