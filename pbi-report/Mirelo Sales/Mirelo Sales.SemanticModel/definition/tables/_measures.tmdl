	/// KPI card R5 (MRR), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card R5 SVG' =
			VAR _value        = [MRR EUR]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 1000000, "€" & FORMAT ( _value / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _value / 1000, "#,0" ) & "k" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [MRR EUR PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = VAR _yoy          = DIVIDE ( [MRR EUR] - [MRR EUR PY], [MRR EUR PY] )
			    RETURN
			        IF ( ISBLANK ( _yoy ), "month end", IF ( _yoy >= 0, "+", "−" ) & FORMAT ( ABS ( _yoy ), "0.0%" ) & " YoY - month end" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>MRR</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 24312119-c634-5fcc-92cc-18cbabd1e5f9
		dataCategory: ImageUrl

	/// KPI card R6 (Paying subscribers), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card R6 SVG' =
			VAR _value        = [Paying Subscribers]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Paying Subscribers PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = "Plus " & IF ( ABS ( [Plus Subscribers] ) >= 10000, FORMAT ( [Plus Subscribers] / 1000, "#,0.0" ) & "k", FORMAT ( [Plus Subscribers], "#,0" ) ) & " - Pro " & IF ( ABS ( [Pro Subscribers] ) >= 10000, FORMAT ( [Pro Subscribers] / 1000, "#,0.0" ) & "k", FORMAT ( [Pro Subscribers], "#,0" ) )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Paying subscribers</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: ce19b88c-3637-54a0-b5c7-6bdfc4ea87fb
		dataCategory: ImageUrl

	/// Returning % heat bins: < 45 % panel-2, 45-55 % grey-300, 55-65 % grey-400, >= 65 % ink.
	measure 'Heat Fill Returning' =
			VAR _v            = [Returning %]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,"#E9E8E4"
			        ,_v < 0.45
			            ,"#DEDDD8"
			        ,_v < 0.55
			            ,"#BDBBB5"
			        ,_v < 0.65
			            ,"#7F7E79"
			        ,"#111111"
			    )
		displayFolder: Design
		lineageTag: bbed81b4-f088-5387-8896-67dabcb87cfe

	/// Cell text colour for the heat matrix (white on the two dark bins).
	measure 'Heat Ink Returning' =
			VAR _v            = [Returning %]
			RETURN
			    IF ( _v >= 0.55, "#FFFFFF", "#111111" )
		displayFolder: Design
		lineageTag: fd9c3f16-22c7-5b1a-8947-2f81c013421d

	/// 30+ DPD heat bins: < 3 % panel-2, 3-4.5 % grey-300, 4.5-6 % grey-400, >= 6 % ink.
	measure 'Heat Fill DPD30' =
			VAR _v            = [DPD30 %]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,"#E9E8E4"
			        ,_v < 0.03
			            ,"#DEDDD8"
			        ,_v < 0.045
			            ,"#BDBBB5"
			        ,_v < 0.06
			            ,"#7F7E79"
			        ,"#111111"
			    )
		displayFolder: Design
		lineageTag: 11073a6a-d876-5ded-8a8f-ac98feae40ca

	/// Cell text colour for the heat matrix (white on the two dark bins).
	measure 'Heat Ink DPD30' =
			VAR _v            = [DPD30 %]
			RETURN
			    IF ( _v >= 0.045, "#FFFFFF", "#111111" )
		displayFolder: Design
		lineageTag: 3db57f73-82b1-536d-b2da-23bf00d2d6ea

	column measure_table
		dataType: int64
