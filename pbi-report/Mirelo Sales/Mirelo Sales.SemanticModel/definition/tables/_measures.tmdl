	/// KPI card R2 (Attainment) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Fixed comparator. Read by the SVG and the parity tests.
	measure '_Card R2 Parts' =
			VAR _value        = [Revenue Attainment]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_code     = "vs 100%"
			VAR _cmp_name     = "vs 100%"
			VAR _d            = IF ( NOT ISBLANK ( _value ), ROUND ( ( _value - 1 ) * 100, 1 ) )
			VAR _s            = [_Revenue Attainment Status]
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			RETURN
