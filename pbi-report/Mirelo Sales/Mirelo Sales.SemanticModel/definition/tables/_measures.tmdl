	/// KPI card P1 (30+ DPD %) face text, PATHITEM-separated: 1 value · 2 comparator code · 3 comparator label · 4 delta text · 5 status. Header comparator (Budget or PY). Read by the SVG and the parity tests.
	measure '_Card P1 Parts' =
			VAR _value        = [DPD30 %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_code     = IF ( [_Sel Comparator] = "PY", "PY", "BUD" )
			VAR _cmp_name     = IF ( _cmp_code = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( _cmp_code = "PY", [DPD30 % PY], [DPD30 Budget %] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( ( _value - _cmp ) * 100, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d <= 0
			                ,"good"
			            ,_d <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _row          = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "◦ " ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			RETURN
			    _value_text & "|" & _cmp_code & "|" & _cmp_name & "|" & _row & "|" & _s
		isHidden
		displayFolder: 8 Cards
		lineageTag: 5909fd5d-4012-5817-9164-f924980ce6dc

