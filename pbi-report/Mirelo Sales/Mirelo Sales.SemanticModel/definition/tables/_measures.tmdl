	/// Roll rate 1-29 to 30+: 30-59 balance this month / 1-29 balance last month.
	measure '_Roll 1-29 30' =
			VAR _month        = MAX ( dim_month[month_index] )
			VAR _prior        =
			    CALCULATE (
			        [_Bal 1-29 EUR]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _month - 1
			    )
			RETURN
			    DIVIDE ( [_Bal 30-59 EUR], _prior )
		formatString: 0.0%
		isHidden
		displayFolder: 0 Base
