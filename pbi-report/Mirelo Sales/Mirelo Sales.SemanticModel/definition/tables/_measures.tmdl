			    "Share of loans " & IF ( ISBLANK ( _v1 ), "n/a", FORMAT ( _v1, "0.0%" ) )
			        & " - " & "Budget " & IF ( ISBLANK ( _v2 ), "n/a", IF ( ABS ( _v2 ) >= 10000, FORMAT ( _v2 / 1000, "#,0.0" ) & "k", FORMAT ( _v2, "#,0" ) ) )
			        & " - " & "Prior year " & IF ( ISBLANK ( _v3 ), "n/a", IF ( ABS ( _v3 ) >= 10000, FORMAT ( _v3 / 1000, "#,0.0" ) & "k", FORMAT ( _v3, "#,0" ) ) )
		displayFolder: 8 Cards
		lineageTag: 47c226c3-bf5b-5de1-abea-bd7b074d4e51

