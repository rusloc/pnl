	/// Sub-values of card C5 (180-day repeat), shown in its info tooltip (ADR-0012: not on the card face).
	measure 'Card C5 Note' =
			VAR _v1          = [_Month Label Back]
			VAR _v2          = [90-day Repeat %]
			VAR _v3          = [180-day Repeat % PY Cohort]
