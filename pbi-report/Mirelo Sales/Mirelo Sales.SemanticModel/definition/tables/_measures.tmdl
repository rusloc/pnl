		lineageTag: 12df1131-bb08-5882-8cd4-e0e8c6a872a7

	/// Interchange EUR, same window 12 months earlier (Actual).
	measure 'Interchange EUR PY' =
			VAR _end          = [_Win End] - 12
			VAR _start        = [_Win Start] - 12
			VAR _market       = [_Sel Market]
			RETURN
			    IF (
			        _start >= 1
			        ,CALCULATE (
			            [_Interchange EUR]
			            ,REMOVEFILTERS ( dim_month )
			            ,dim_month[month_index] >= _start
			                && dim_month[month_index] <= _end
			            ,KEEPFILTERS (
			                FILTER (
			                    ALL ( dim_market[market_code] )
			                    ,_market = "ALL"
			                        || dim_market[market_code] = _market
			                )
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 5 Revenue
		lineageTag: 7c446a45-1766-5adb-af5a-996fdd1c8f96

