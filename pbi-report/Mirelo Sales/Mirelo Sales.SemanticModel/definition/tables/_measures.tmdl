	/// Funnel count of the stage on the axis (dim_funnel_stage), window.
	measure 'Funnel Count' =
			VAR _stage        = SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			RETURN
			    SWITCH (
			        _stage
			        ,"LEAD"
			            ,[Leads]
			        ,"STARTED"
			            ,[Apps Started]
			        ,"SUBMITTED"
			            ,[Apps Submitted]
			        ,"KYC_PASSED"
			            ,[KYC Passed]
			        ,"APPROVED"
			            ,[Approved]
			        ,"DISBURSED"
			            ,[Disbursed Apps]
			    )
		formatString: #,0
		displayFolder: 3 Funnel
		lineageTag: cc8b1e2c-231a-54da-980f-bf229b6abe65

	/// Funnel count, new applicants only.
	measure 'Funnel Count New' =
			CALCULATE (
			    [Funnel Count]
			    ,fact_application[is_repeat] = FALSE ()
			)
		formatString: #,0
		displayFolder: 3 Funnel
		lineageTag: b2b2c059-3497-5cff-9d6e-654fa29e42fd

	/// Stage count / count of the previous shown stage.
	measure 'Funnel % of Previous' =
			VAR _order        = SELECTEDVALUE ( dim_funnel_stage[sort_order] )
			VAR _prev_order   =
			    CALCULATE (
			        MAX ( dim_funnel_stage[sort_order] )
			        ,ALLSELECTED ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] < _order
			    )
			VAR _prev         =
			    CALCULATE (
			        [Funnel Count]
			        ,REMOVEFILTERS ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] = _prev_order
			    )
			RETURN
			    IF ( NOT ISBLANK ( _prev_order ), DIVIDE ( [Funnel Count], _prev ) )
		formatString: 0.0%
		displayFolder: 3 Funnel
		lineageTag: af80fb61-2009-53b7-901d-2d06cc341c4b

	/// New-applicant stage count / previous shown stage.
	measure 'Funnel New % of Previous' =
			VAR _order        = SELECTEDVALUE ( dim_funnel_stage[sort_order] )
			VAR _prev_order   =
			    CALCULATE (
			        MAX ( dim_funnel_stage[sort_order] )
			        ,ALLSELECTED ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] < _order
			    )
			VAR _prev         =
			    CALCULATE (
			        [Funnel Count New]
			        ,REMOVEFILTERS ( dim_funnel_stage )
			        ,dim_funnel_stage[sort_order] = _prev_order
			    )
			RETURN
			    IF ( NOT ISBLANK ( _prev_order ), DIVIDE ( [Funnel Count New], _prev ) )
		formatString: 0.0%
		displayFolder: 3 Funnel
		lineageTag: 19bb96c8-9fd3-5bab-8f2a-baee53d1fffc

	/// Median hours of the step ending at the stage on the axis: submitted -> approved, approved -> disbursed (the only timestamps in the data).
	measure 'Stage Median Hours' =
			VAR _stage        = SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			RETURN
			    SWITCH (
			        _stage
			        ,"APPROVED"
			            ,[Time to Approve h]
			        ,"DISBURSED"
			            ,[Approve to Cash h]
			    )
		formatString: 0.0
		displayFolder: 3 Funnel
		lineageTag: b1cb9c35-87d9-5fe6-b636-0344d8e0acc9

	/// SLA hours of the stage (dim_funnel_stage.sla_hours).
	measure 'Stage SLA Hours' = MAX ( dim_funnel_stage[sla_hours] )
		formatString: 0
		displayFolder: 3 Funnel
		lineageTag: d23303c7-7a31-54f5-8892-f5ac146944bc

	/// Outstanding of loans 1+ DPD at the snapshot (2026-09-30, the loan-level state on fact_loan), EUR at the Sep 2026 ACTUAL_AVG rate.
	measure 'Overdue Outstanding EUR' =
			VAR _market       = [_Sel Market]
			VAR _last_closed  = [_Last Closed Index]
			VAR _close_key    =
			    CALCULATE (
			        MAX ( dim_month[month_key] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			RETURN
			    CALCULATE (
			        SUMX (
			            VALUES ( fact_loan[currency_code] )
			            ,VAR _currency    = fact_loan[currency_code]
			             VAR _rate        =
			                 CALCULATE (
			                     MAX ( param_fx[local_per_eur] )
			                     ,param_fx[rate_type] = "ACTUAL_AVG"
			                     ,param_fx[currency_code] = _currency
			                     ,param_fx[month_key] = _close_key
			                 )
			             RETURN
			                 DIVIDE ( CALCULATE ( SUM ( fact_loan[outstanding_local_close] ) ), _rate )
			        )
			        ,KEEPFILTERS ( dim_loan_status[dpd_min] >= 1 )
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
		formatString: €#,0
		displayFolder: 4 Portfolio
		lineageTag: 598de967-f21c-5e4b-a070-868c0102b672

	/// Loans of the client(s) up to the end of the anchor month.
	measure 'Client Loans to Date' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_loan )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: #,0
		displayFolder: 2 Clients
		lineageTag: 212ef8a3-de77-51e9-8c14-db1a47206487

	/// Principal of the client(s) up to the end of the anchor month, EUR.
	measure 'Client Principal to Date EUR' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_loan[principal_eur] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: €#,0
		displayFolder: 2 Clients
		lineageTag: 4682ddbd-523a-5984-9bf8-fd9a9f2796fc

	/// Latest disbursement date up to the end of the anchor month.
	measure 'Client Last Loan Date' =
			VAR _end          = [_Anchor End Date]
			RETURN
			    CALCULATE (
			        MAX ( fact_loan[disbursed_date] )
			        ,REMOVEFILTERS ( dim_month )
			        ,fact_loan[disbursed_date] <= _end
			    )
		formatString: yyyy-mm-dd
		displayFolder: 2 Clients
		lineageTag: 39aafc6a-74b1-5cc8-a33c-1133dab3611b

	/// Days from the last loan to the end of the anchor month.
	measure 'Client Days Since Last Loan' =
			VAR _last         = [Client Last Loan Date]
			RETURN
			    IF ( NOT ISBLANK ( _last ), INT ( [_Anchor End Date] - _last ) )
		formatString: #,0
		displayFolder: 2 Clients
		lineageTag: 55e23da5-9a78-51d9-b72a-a777f3ba3e51

	/// Principal of the loan(s) in the window and market (drill-through tables).
	measure 'Loan In Window EUR' =
			VAR _end          = [_Win End]
			VAR _start        = [_Win Start]
			VAR _market       = [_Sel Market]
			RETURN
			    CALCULATE (
			        [_Principal EUR]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] >= _start
			            && dim_month[month_index] <= _end
			        ,KEEPFILTERS (
			            FILTER (
			                ALL ( dim_market[market_code] )
			                ,_market = "ALL"
			                    || dim_market[market_code] = _market
			            )
			        )
			    )
		formatString: €#,0
		displayFolder: 1 Loans
		lineageTag: b1c32fa3-ea6c-5c4d-b6e8-fcc197e5c1e2

	/// Window as text: Sep 2026, QTD Sep 2026, YTD Sep 2026, R12M to Sep 2026.
	measure '_Window Label' =
			VAR _anchor       = [_Sel Anchor Index]
			VAR _label        =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			RETURN
			    SWITCH (
			        [_Sel Period]
			        ,"QTD"
			            ,"QTD " & _label
			        ,"YTD"
			            ,"YTD " & _label
			        ,"R12M"
			            ,"R12M to " & _label
			        ,_label
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a8d3ab30-a10c-5e22-ad1d-443e52e1fbc5

	/// Selected market name (All markets, Poland, Romania, Portugal).
	measure '_Market Name' =
			VAR _code         = [_Sel Market]
			RETURN
			    CALCULATE (
			        MAX ( param_market[market_name] )
			        ,REMOVEFILTERS ( param_market )
			        ,param_market[market_code] = _code
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 93be0f18-5176-5d99-a962-db19d0fab84a

	/// Label of the last closed month.
	measure '_Closed Label' =
			VAR _last         = [_Last Closed Index]
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9c1aecc7-779f-52b9-ae47-1ace477b792f

	/// Label of the month 6 months before the anchor (cohort / vintage of the 6-month metrics).
	measure '_Month Label Back' =
			VAR _back         = 6
			VAR _index        = [_Sel Anchor Index] - _back
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _index
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: f9c33faf-9195-552b-88b4-ffb443f574c3

	/// Header period sentence (parity rules 6, 7, 13): Showing <month> - <period> - <market> - Actual vs <comparator> - Closed through <last closed month>.
	measure 'Header Period Line' =
			VAR _anchor       = [_Sel Anchor Index]
			VAR _anchor_label =
			    CALCULATE (
			        MAX ( dim_month[month_label] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			VAR _period       = SWITCH ( [_Sel Period], "QTD", "QTD", "YTD", "YTD", "R12M", "R12M", "Month" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", "Prior year", "Budget" )
			RETURN
			    "Showing " & _anchor_label & " - " & _period & " - " & [_Market Name] & " - Actual vs " & _cmp & " - Closed through " & [_Closed Label]
		displayFolder: Design
		lineageTag: e7dabac3-b8a9-550c-a4bf-7774b2de8bb8

	/// Title of the Overview markets table.
	measure 'Title Markets' = "Markets - " & [_Window Label]
		displayFolder: Design
		lineageTag: 3fde67dc-ccc9-5320-8863-3d12522d321d

	/// Title of the leaderboard table.
	measure 'Title Leaderboard' = "Agent & partner leaderboard - " & [_Window Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 2a474757-2f7d-5657-a42d-8302c36f5b59

	/// Title of the clients table.
	measure 'Title Clients Table' = "New clients - " & [_Window Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 38806ed5-b136-54f1-aa6b-aa3dc1799137

	/// Title of the overdue loans table (loan-level state is the last closed month).
	measure 'Title Overdue' = "Overdue loans - status at " & [_Closed Label] & " - " & [_Market Name]
		displayFolder: Design
		lineageTag: 8ed5c4db-0e57-5f83-99ac-5d191714da35

	/// Title of the stream x market matrix.
	measure 'Title Stream Market' = "Stream x market - " & [_Window Label]
		displayFolder: Design
		lineageTag: d100a0f3-aff0-5920-88f4-be9a4d6f8b9f

	/// Loan detail title sentence from the carried filters, e.g. 1,296 loans - Romania - Step 12 - Sep 2026.
	measure 'Title Loan Detail' =
			VAR _parts        =
			    IF ( ISFILTERED ( dim_market[market_name] ), " - " & SELECTEDVALUE ( dim_market[market_name], "several markets" ) )
			        & IF ( ISFILTERED ( dim_product[product_name] ), " - " & SELECTEDVALUE ( dim_product[product_name], "several products" ) )
			        & IF ( ISFILTERED ( dim_channel[channel_name] ), " - " & SELECTEDVALUE ( dim_channel[channel_name], "several channels" ) )
			        & IF ( ISFILTERED ( dim_agent[agent_name] ), " - " & SELECTEDVALUE ( dim_agent[agent_name], "several agents" ) )
			RETURN
			    FORMAT ( [Loans], "#,0" ) & " loans" & _parts & " - " & [_Window Label]
		displayFolder: Design
		lineageTag: db1e8ec5-0777-582f-8edb-dd907983bd34

	/// Client detail title sentence.
	measure 'Title Client Detail' =
			VAR _id           = SELECTEDVALUE ( dim_client[client_id] )
			VAR _market       = SELECTEDVALUE ( dim_client[market_code] )
			VAR _first        = SELECTEDVALUE ( dim_client[first_loan_date] )
			RETURN
			    IF (
			        NOT ISBLANK ( _id )
			        ,"Client " & _id & " - " & _market & " - first loan " & FORMAT ( _first, "d mmm yyyy" ) & " - " & FORMAT ( [Client Loans to Date], "#,0" ) & " loans to date"
			        ,"Select one client"
			    )
		displayFolder: Design
		lineageTag: cf6f00f6-24e1-5c1d-825e-3e899be6e610

	/// Hero card O1 (Loans issued), 332 x 192 SVG: value, sub-line, vs Budget and vs Prior year rows with diverging bars (scale ±20 % / ±5 pp), status chip of the selected comparator, 13-month sparkline (Actual ink, PY grey dashed). 
	measure 'Card O1 SVG' =
			VAR _value        = [Loans]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _second       = [Principal EUR]
			VAR _second_text  = IF ( ISBLANK ( _second ), "", IF ( ABS ( _second ) >= 1000000, "€" & FORMAT ( _second / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _second / 1000, "#,0" ) & "k" ) )
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [Loans Budget]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( DIVIDE ( _value - _cmp_bud, ABS ( _cmp_bud ) ), 3 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [Loans PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( DIVIDE ( _value - _cmp_py, ABS ( _cmp_py ) ), 3 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _s_sel        = IF ( _cmp_code = "PY", _s_py, _s_bud )
			VAR _row_bud      =
			    VAR _ink          = SWITCH ( _s_bud, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_bud ), 0, MIN ( ABS ( _d_bud ) / 0.2, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_bud < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_bud ), "0.0%" ) )
			    RETURN
			        "<text x='16' y='136' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='136' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_bud )
			                ,"<rect x='172' y='131' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='131' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='129' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row_py       =
			    VAR _ink          = SWITCH ( _s_py, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_py ), 0, MIN ( ABS ( _d_py ) / 0.2, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_py < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_py ), "0.0%" ) )
			    RETURN
			        "<text x='16' y='160' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='160' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_py )
			                ,"<rect x='172' y='155' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='155' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='153' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _market       = [_Sel Market]
			VAR _points       =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 12, 1 )
			        ,"@act",
			            VAR _i            = _anchor - 12 + [Value]
			            RETURN
			                CALCULATE (
			                    [_Loans]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			        ,"@py",
			            VAR _i            = _anchor - 24 + [Value]
			            RETURN
			                CALCULATE (
			                    [_Loans]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			    )
			VAR _act_pts      = FILTER ( _points, NOT ISBLANK ( [@act] ) )
			VAR _py_pts       = FILTER ( _points, NOT ISBLANK ( [@py] ) )
			VAR _lo_act       = MINX ( _act_pts, [@act] )
			VAR _hi_act       = MAXX ( _act_pts, [@act] )
			VAR _lo           = MIN ( _lo_act, COALESCE ( MINX ( _py_pts, [@py] ), _lo_act ) )
			VAR _hi           = MAX ( _hi_act, COALESCE ( MAXX ( _py_pts, [@py] ), _hi_act ) )
			VAR _span         = IF ( _hi > _lo, _hi - _lo, 1 )
			VAR _act_line     =
			    CONCATENATEX (
			        _act_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@act] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _py_line      =
			    CONCATENATEX (
			        _py_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@py] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _last         = MAXX ( _act_pts, [Value] )
			VAR _last_y       = 86 - ( MAXX ( FILTER ( _act_pts, [Value] = _last ), [@act] ) - _lo ) / _span * 40
			VAR _spark        =
			    IF (
			        COUNTROWS ( _act_pts ) > 1
			        ,IF ( COUNTROWS ( _py_pts ) > 1, "<polyline points='" & _py_line & "' fill='none' stroke='#7F7E79' stroke-width='1' stroke-dasharray='4 3'/>" )
			            & "<polyline points='" & _act_line & "' fill='none' stroke='#111111' stroke-width='1.5'/>"
			            & "<circle cx='" & FORMAT ( 196 + _last * 10, "0" ) & "' cy='" & FORMAT ( _last_y, "0.0" ) & "' r='3' fill='#111111'/>"
			    )
			VAR _sub          = "avg ticket " & "€" & FORMAT ( [Avg Ticket EUR], "#,0" ) & IF ( NOT ISBLANK ( [Loans Budget] ), " - " & FORMAT ( DIVIDE ( [Loans], [Loans Budget] ), "0.0%" ) & " of target loans" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & _spark
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Loans issued</text>"
			        & "<rect x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='22' width='" & SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s_sel, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='34' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s_sel, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s_sel, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='84' font-size='44' font-weight='700' fill='#111111' letter-spacing='-0.9'>" & _value_text & "<tspan dx='12' font-size='18' letter-spacing='0'>" & _second_text & "</tspan>" & "</text>"
			        & "<text x='16' y='112' font-size='12' fill='#5C5C58'>" & _sub & "</text>"
			        & _row_bud
			        & _row_py
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b451cc3d-4b05-56c2-877f-8160f3536894
		dataCategory: ImageUrl

	/// Hero card O2 (New clients locked in), 332 x 192 SVG: value, sub-line, vs Budget and vs Prior year rows with diverging bars (scale ±20 % / ±5 pp), status chip of the selected comparator, 13-month sparkline (Actual ink, PY grey dashed). 
	measure 'Card O2 SVG' =
			VAR _value        = [New Clients]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [New Clients Budget]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( DIVIDE ( _value - _cmp_bud, ABS ( _cmp_bud ) ), 3 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [New Clients PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( DIVIDE ( _value - _cmp_py, ABS ( _cmp_py ) ), 3 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _s_sel        = IF ( _cmp_code = "PY", _s_py, _s_bud )
			VAR _row_bud      =
			    VAR _ink          = SWITCH ( _s_bud, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_bud ), 0, MIN ( ABS ( _d_bud ) / 0.2, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_bud < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_bud ), "0.0%" ) )
			    RETURN
			        "<text x='16' y='136' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='136' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_bud )
			                ,"<rect x='172' y='131' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='131' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='129' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row_py       =
			    VAR _ink          = SWITCH ( _s_py, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_py ), 0, MIN ( ABS ( _d_py ) / 0.2, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_py < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_py ), "0.0%" ) )
			    RETURN
			        "<text x='16' y='160' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='160' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_py )
			                ,"<rect x='172' y='155' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='155' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='153' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _market       = [_Sel Market]
			VAR _points       =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 12, 1 )
			        ,"@act",
			            VAR _i            = _anchor - 12 + [Value]
			            RETURN
			                CALCULATE (
			                    [_New Clients]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			        ,"@py",
			            VAR _i            = _anchor - 24 + [Value]
			            RETURN
			                CALCULATE (
			                    [_New Clients]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			    )
			VAR _act_pts      = FILTER ( _points, NOT ISBLANK ( [@act] ) )
			VAR _py_pts       = FILTER ( _points, NOT ISBLANK ( [@py] ) )
			VAR _lo_act       = MINX ( _act_pts, [@act] )
			VAR _hi_act       = MAXX ( _act_pts, [@act] )
			VAR _lo           = MIN ( _lo_act, COALESCE ( MINX ( _py_pts, [@py] ), _lo_act ) )
			VAR _hi           = MAX ( _hi_act, COALESCE ( MAXX ( _py_pts, [@py] ), _hi_act ) )
			VAR _span         = IF ( _hi > _lo, _hi - _lo, 1 )
			VAR _act_line     =
			    CONCATENATEX (
			        _act_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@act] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _py_line      =
			    CONCATENATEX (
			        _py_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@py] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _last         = MAXX ( _act_pts, [Value] )
			VAR _last_y       = 86 - ( MAXX ( FILTER ( _act_pts, [Value] = _last ), [@act] ) - _lo ) / _span * 40
			VAR _spark        =
			    IF (
			        COUNTROWS ( _act_pts ) > 1
			        ,IF ( COUNTROWS ( _py_pts ) > 1, "<polyline points='" & _py_line & "' fill='none' stroke='#7F7E79' stroke-width='1' stroke-dasharray='4 3'/>" )
			            & "<polyline points='" & _act_line & "' fill='none' stroke='#111111' stroke-width='1.5'/>"
			            & "<circle cx='" & FORMAT ( 196 + _last * 10, "0" ) & "' cy='" & FORMAT ( _last_y, "0.0" ) & "' r='3' fill='#111111'/>"
			    )
			VAR _sub          = FORMAT ( [New Clients Share of Loans], "0.0%" ) & " of loans - " & [New Clients Top Channels]
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & _spark
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>New clients locked in</text>"
			        & "<rect x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='22' width='" & SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s_sel, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='34' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s_sel, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s_sel, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='84' font-size='44' font-weight='700' fill='#111111' letter-spacing='-0.9'>" & _value_text & "</text>"
			        & "<text x='16' y='112' font-size='12' fill='#5C5C58'>" & _sub & "</text>"
			        & _row_bud
			        & _row_py
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 8092534b-3394-54fb-b095-8fd9379846a9
		dataCategory: ImageUrl

	/// Hero card O3 (Returning clients), 332 x 192 SVG: value, sub-line, vs Budget and vs Prior year rows with diverging bars (scale ±20 % / ±5 pp), status chip of the selected comparator, 13-month sparkline (Actual ink, PY grey dashed). 
	measure 'Card O3 SVG' =
			VAR _value        = [Returning %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = BLANK ()
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( ( _value - _cmp_bud ) * 100, 1 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud >= 0
			                ,"good"
			            ,_d_bud >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [Returning % PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( ( _value - _cmp_py ) * 100, 1 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py >= 0
			                ,"good"
			            ,_d_py >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _s_sel        = IF ( _cmp_code = "PY", _s_py, _s_bud )
			VAR _row_bud      =
			    VAR _ink          = SWITCH ( _s_bud, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_bud ), 0, MIN ( ABS ( _d_bud ) / 5, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_bud < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_bud ), "0.0" ) & "pp" )
			    RETURN
			        "<text x='16' y='136' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='136' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_bud )
			                ,"<rect x='172' y='131' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='131' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='129' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row_py       =
			    VAR _ink          = SWITCH ( _s_py, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_py ), 0, MIN ( ABS ( _d_py ) / 5, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_py < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_py ), "0.0" ) & "pp" )
			    RETURN
			        "<text x='16' y='160' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='160' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_py )
			                ,"<rect x='172' y='155' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='155' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='153' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _market       = [_Sel Market]
			VAR _points       =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 12, 1 )
			        ,"@act",
			            VAR _i            = _anchor - 12 + [Value]
			            RETURN
			                CALCULATE (
			                    [_Returning %]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			        ,"@py",
			            VAR _i            = _anchor - 24 + [Value]
			            RETURN
			                CALCULATE (
			                    [_Returning %]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			    )
			VAR _act_pts      = FILTER ( _points, NOT ISBLANK ( [@act] ) )
			VAR _py_pts       = FILTER ( _points, NOT ISBLANK ( [@py] ) )
			VAR _lo_act       = MINX ( _act_pts, [@act] )
			VAR _hi_act       = MAXX ( _act_pts, [@act] )
			VAR _lo           = MIN ( _lo_act, COALESCE ( MINX ( _py_pts, [@py] ), _lo_act ) )
			VAR _hi           = MAX ( _hi_act, COALESCE ( MAXX ( _py_pts, [@py] ), _hi_act ) )
			VAR _span         = IF ( _hi > _lo, _hi - _lo, 1 )
			VAR _act_line     =
			    CONCATENATEX (
			        _act_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@act] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _py_line      =
			    CONCATENATEX (
			        _py_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@py] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _last         = MAXX ( _act_pts, [Value] )
			VAR _last_y       = 86 - ( MAXX ( FILTER ( _act_pts, [Value] = _last ), [@act] ) - _lo ) / _span * 40
			VAR _spark        =
			    IF (
			        COUNTROWS ( _act_pts ) > 1
			        ,IF ( COUNTROWS ( _py_pts ) > 1, "<polyline points='" & _py_line & "' fill='none' stroke='#7F7E79' stroke-width='1' stroke-dasharray='4 3'/>" )
			            & "<polyline points='" & _act_line & "' fill='none' stroke='#111111' stroke-width='1.5'/>"
			            & "<circle cx='" & FORMAT ( 196 + _last * 10, "0" ) & "' cy='" & FORMAT ( _last_y, "0.0" ) & "' r='3' fill='#111111'/>"
			    )
			VAR _sub          = "of borrowers - " & FORMAT ( [Repeat Share], "0.0%" ) & " of loans - 180-day repeat " & FORMAT ( [180-day Repeat %], "0%" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & _spark
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Returning clients</text>"
			        & "<rect x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='22' width='" & SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s_sel, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='34' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s_sel, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s_sel, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='84' font-size='44' font-weight='700' fill='#111111' letter-spacing='-0.9'>" & _value_text & "</text>"
			        & "<text x='16' y='112' font-size='12' fill='#5C5C58'>" & _sub & "</text>"
			        & _row_bud
			        & _row_py
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b08f4a6a-59d2-5aba-b908-cfeb6eb24a3f
		dataCategory: ImageUrl

	/// Hero card O4 (Bad / overdue loans), 332 x 192 SVG: value, sub-line, vs Budget and vs Prior year rows with diverging bars (scale ±20 % / ±5 pp), status chip of the selected comparator, 13-month sparkline (Actual ink, PY grey dashed). 
	measure 'Card O4 SVG' =
			VAR _value        = [DPD30 %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_code     = [_Sel Comparator]
			VAR _cmp_bud      = [DPD30 Budget %]
			VAR _d_bud        =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_bud )
			        ,ROUND ( ( _value - _cmp_bud ) * 100, 1 )
			    )
			VAR _s_bud        =
			    IF (
			        NOT ISBLANK ( _d_bud )
			        ,SWITCH (
			            TRUE ()
			            ,_d_bud <= 0
			                ,"good"
			            ,_d_bud <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _cmp_py       = [DPD30 % PY]
			VAR _d_py         =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_py )
			        ,ROUND ( ( _value - _cmp_py ) * 100, 1 )
			    )
			VAR _s_py         =
			    IF (
			        NOT ISBLANK ( _d_py )
			        ,SWITCH (
			            TRUE ()
			            ,_d_py <= 0
			                ,"good"
			            ,_d_py <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _s_sel        = IF ( _cmp_code = "PY", _s_py, _s_bud )
			VAR _row_bud      =
			    VAR _ink          = SWITCH ( _s_bud, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_bud ), 0, MIN ( ABS ( _d_bud ) / 5, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_bud < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_bud ), "n/a", IF ( _d_bud > 0, "▲ +", IF ( _d_bud < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_bud ), "0.0" ) & "pp" )
			    RETURN
			        "<text x='16' y='136' font-size='12' font-weight='600' fill='#5C5C58'>vs Budget</text>"
			            & "<text x='164' y='136' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_bud )
			                ,"<rect x='172' y='131' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='131' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='129' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _row_py       =
			    VAR _ink          = SWITCH ( _s_py, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			    VAR _len          = IF ( ISBLANK ( _d_py ), 0, MIN ( ABS ( _d_py ) / 5, 1 ) * 40 )
			    VAR _bar_x        = IF ( _d_py < 0, 212 - _len, 212 )
			    VAR _text         = IF ( ISBLANK ( _d_py ), "n/a", IF ( _d_py > 0, "▲ +", IF ( _d_py < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d_py ), "0.0" ) & "pp" )
			    RETURN
			        "<text x='16' y='160' font-size='12' font-weight='600' fill='#5C5C58'>vs Prior year</text>"
			            & "<text x='164' y='160' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _text & "</text>"
			            & IF (
			                NOT ISBLANK ( _d_py )
			                ,"<rect x='172' y='155' width='80' height='6' fill='#DEDDD8'/>"
			                    & "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='155' width='" & FORMAT ( _len, "0.0" ) & "' height='6' fill='" & _ink & "'/>"
			                    & "<rect x='211.5' y='153' width='1' height='10' fill='#2F2F2D'/>"
			            )
			VAR _anchor       = [_Sel Anchor Index]
			VAR _market       = [_Sel Market]
			VAR _points       =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 12, 1 )
			        ,"@act",
			            VAR _i            = _anchor - 12 + [Value]
			            RETURN
			                CALCULATE (
			                    [_DPD30 %]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			        ,"@py",
			            VAR _i            = _anchor - 24 + [Value]
			            RETURN
			                CALCULATE (
			                    [_DPD30 %]
			                    ,REMOVEFILTERS ( dim_month )
			                    ,dim_month[month_index] = _i
			                    ,KEEPFILTERS (
			                        FILTER (
			                            ALL ( dim_market[market_code] )
			                            ,_market = "ALL"
			                                || dim_market[market_code] = _market
			                        )
			                    )
			                )
			    )
			VAR _act_pts      = FILTER ( _points, NOT ISBLANK ( [@act] ) )
			VAR _py_pts       = FILTER ( _points, NOT ISBLANK ( [@py] ) )
			VAR _lo_act       = MINX ( _act_pts, [@act] )
			VAR _hi_act       = MAXX ( _act_pts, [@act] )
			VAR _lo           = MIN ( _lo_act, COALESCE ( MINX ( _py_pts, [@py] ), _lo_act ) )
			VAR _hi           = MAX ( _hi_act, COALESCE ( MAXX ( _py_pts, [@py] ), _hi_act ) )
			VAR _span         = IF ( _hi > _lo, _hi - _lo, 1 )
			VAR _act_line     =
			    CONCATENATEX (
			        _act_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@act] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _py_line      =
			    CONCATENATEX (
			        _py_pts
			        ,FORMAT ( 196 + [Value] * 10, "0" ) & "," & FORMAT ( 86 - ( [@py] - _lo ) / _span * 40, "0.0" )
			        ," "
			        ,[Value], ASC
			    )
			VAR _last         = MAXX ( _act_pts, [Value] )
			VAR _last_y       = 86 - ( MAXX ( FILTER ( _act_pts, [Value] = _last ), [@act] ) - _lo ) / _span * 40
			VAR _spark        =
			    IF (
			        COUNTROWS ( _act_pts ) > 1
			        ,IF ( COUNTROWS ( _py_pts ) > 1, "<polyline points='" & _py_line & "' fill='none' stroke='#7F7E79' stroke-width='1' stroke-dasharray='4 3'/>" )
			            & "<polyline points='" & _act_line & "' fill='none' stroke='#111111' stroke-width='1.5'/>"
			            & "<circle cx='" & FORMAT ( 196 + _last * 10, "0" ) & "' cy='" & FORMAT ( _last_y, "0.0" ) & "' r='3' fill='#111111'/>"
			    )
			VAR _sub          = "30+ DPD by balance - 90+ " & FORMAT ( [DPD90 %], "0.0%" ) & " - vintage 6m " & FORMAT ( [Vintage 6m Bad Rate], "0.0%" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='332' height='192' viewBox='0 0 332 192' font-family='Segoe UI, sans-serif'>"
			        & _spark
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Bad / overdue loans</text>"
			        & "<rect x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='22' width='" & SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s_sel, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 316 - SWITCH ( _s_sel, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='34' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s_sel, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s_sel, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='84' font-size='44' font-weight='700' fill='#111111' letter-spacing='-0.9'>" & _value_text & "</text>"
			        & "<text x='16' y='112' font-size='12' fill='#5C5C58'>" & _sub & "</text>"
			        & _row_bud
			        & _row_py
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: b01cff63-9cd2-5a43-8b9f-e8aa42b3915e
		dataCategory: ImageUrl

	/// Top two acquisition channels of the window's new clients with their share, e.g. App 41% - Partner 22%.
	measure 'New Clients Top Channels' =
			VAR _total        = [New Clients]
			VAR _channels     =
			    ADDCOLUMNS (
			        VALUES ( dim_channel[channel_code] )
			        ,"@n", [New Clients]
			    )
			VAR _top          = TOPN ( 2, _channels, [@n], DESC )
			RETURN
			    CONCATENATEX (
			        _top
			        ,SWITCH ( dim_channel[channel_code], "APP", "App", "PAID", "Paid", "PARTNER", "Partner", "Agent" )
			            & " " & FORMAT ( DIVIDE ( [@n], _total ), "0%" )
			        ," - "
			        ,[@n], DESC
			    )
		displayFolder: 2 Clients
		lineageTag: 0f74049d-25fe-5255-8e75-b3bbd2983d52

	/// KPI card L1 (Loans), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L1 SVG' =
			VAR _value        = [Loans]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Loans PY], [Loans Budget] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = "PY " & IF ( ABS ( [Loans PY] ) >= 10000, FORMAT ( [Loans PY] / 1000, "#,0.0" ) & "k", FORMAT ( [Loans PY], "#,0" ) ) & " - Budget " & IF ( ABS ( [Loans Budget] ) >= 10000, FORMAT ( [Loans Budget] / 1000, "#,0.0" ) & "k", FORMAT ( [Loans Budget], "#,0" ) )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Loans</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 9995d40e-d739-59e0-b236-48d4ad4c7ba7
		dataCategory: ImageUrl

	/// KPI card L2 (Principal), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L2 SVG' =
			VAR _value        = [Principal EUR]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 1000000, "€" & FORMAT ( _value / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( _value / 1000, "#,0" ) & "k" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Principal EUR PY], [Principal Budget EUR] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = "at budget FX " & IF ( ABS ( [Principal EUR at Budget FX] ) >= 1000000, "€" & FORMAT ( [Principal EUR at Budget FX] / 1000000, "#,0.0" ) & "m", "€" & FORMAT ( [Principal EUR at Budget FX] / 1000, "#,0" ) & "k" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Principal</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 9de7b3bb-ef07-5fd1-86bd-6cd254d03898
		dataCategory: ImageUrl

	/// KPI card L3 (Avg ticket), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L3 SVG' =
			VAR _value        = [Avg Ticket EUR]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", "€" & FORMAT ( _value, "#,0" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Avg Ticket EUR PY], [Avg Ticket Budget EUR] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,"neutral"
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = "Step 12 share " & FORMAT ( [Step 12 Share], "0%" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Avg ticket</text>"
			        & ""
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: a4ada6bd-5645-5446-8c85-81910b7dd470
		dataCategory: ImageUrl

	/// KPI card L4 (Approval rate), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L4 SVG' =
			VAR _value        = [Approval Rate]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Approval Rate PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( ( _value - _cmp ) * 100, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			VAR _sub          = "new clients " & FORMAT ( [New-client Approval Rate], "0.0%" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Approval rate</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: ba9054af-d416-5658-b81e-14763a778701
		dataCategory: ImageUrl

	/// KPI card L5 (Take-up rate), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L5 SVG' =
			VAR _value        = [Take-up Rate]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Take-up Rate PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( ( _value - _cmp ) * 100, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			VAR _sub          = "KYC pass " & FORMAT ( [KYC Pass Rate], "0.0%" )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Take-up rate</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 7e235a5c-a276-5659-98e6-5d35bf289ada
		dataCategory: ImageUrl

	/// KPI card L6 (Time to cash), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card L6 SVG' =
			VAR _value        = [Time to Cash h]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0" ) & " h" )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Time to Cash h PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( _value - _cmp, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d <= 0
			                ,"good"
			            ,_d <= 0.5
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0" ) & " h" )
			VAR _sub          = "approval leg " & FORMAT ( [Time to Approve h], "0.0" ) & " h (median)"
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>Time to cash</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 1c048eac-f911-519a-bdae-d688a7adc6b2
		dataCategory: ImageUrl

	/// KPI card C1 (New clients), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card C1 SVG' =
			VAR _value        = [New Clients]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", IF ( ABS ( _value ) >= 10000, FORMAT ( _value / 1000, "#,0.0" ) & "k", FORMAT ( _value, "#,0" ) ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [New Clients PY], [New Clients Budget] )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( DIVIDE ( _value - _cmp, ABS ( _cmp ) ), 3 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -0.05
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0%" ) )
			VAR _sub          = FORMAT ( [New Clients Share of Loans], "0.0%" ) & " of loans"
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='216' height='120' viewBox='0 0 216 120' font-family='Segoe UI, sans-serif'>"
			        & "<text x='16' y='36' font-size='12' font-weight='600' fill='#5C5C58'>New clients</text>"
			        & "<rect x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' y='24' width='" & SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) & "' height='16' rx='2' fill='" & SWITCH ( _s, "good", "#D6EBDC", "watch", "#FFEBA8", "off", "#F4D4D1", "#DEDDD8" ) & "'/>"
			        & "<text x='" & 200 - SWITCH ( _s, "good", 38, "watch", 44, "off", 28, 30 ) / 2 & "' y='36' font-size='11' font-weight='600' text-anchor='middle' fill='" & SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" ) & "'>" & SWITCH ( _s, "good", "Good", "watch", "Watch", "off", "Off", "n/a" ) & "</text>"
			        & "<text x='16' y='72' font-size='28' font-weight='700' fill='#111111'>" & _value_text & "</text>"
			        & "<text x='16' y='96' font-size='12' font-weight='600' fill='#5C5C58'>" & _cmp_name & "</text>"
			        & "<text x='200' y='96' font-size='13' font-weight='700' text-anchor='end' fill='" & _ink & "'>" & _delta_text & "</text>"
			        & "<text x='16' y='112' font-size='11' fill='#5C5C58'>" & _sub & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards
		lineageTag: 3e7a1e47-620d-503f-bb33-85ad1e32a23b
		dataCategory: ImageUrl

	/// KPI card C2 (Returning clients %), 216 x 120 SVG: value, one comparator row (the header comparator), status chip, sub-line.
	measure 'Card C2 SVG' =
			VAR _value        = [Returning %]
			VAR _value_text   = IF ( ISBLANK ( _value ), "n/a", FORMAT ( _value, "0.0%" ) )
			VAR _cmp_name     = IF ( [_Sel Comparator] = "PY", "vs PY", "vs Budget" )
			VAR _cmp          = IF ( [_Sel Comparator] = "PY", [Returning % PY], BLANK () )
			VAR _d            =
			    IF (
			        NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp )
			        ,ROUND ( ( _value - _cmp ) * 100, 1 )
			    )
			VAR _s            =
			    IF (
			        NOT ISBLANK ( _d )
			        ,SWITCH (
			            TRUE ()
			            ,_d >= 0
			                ,"good"
			            ,_d >= -2
			                ,"watch"
			            ,"off"
			        )
			        ,"neutral"
			    )
			VAR _ink          = SWITCH ( _s, "good", "#176B3D", "watch", "#8A5A00", "off", "#B3261E", "#5C5C58" )
			VAR _delta_text   = IF ( ISBLANK ( _d ), "n/a", IF ( _d > 0, "▲ +", IF ( _d < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _d ), "0.0" ) & "pp" )
			VAR _sub          = "of " & IF ( ABS ( [Borrowers] ) >= 10000, FORMAT ( [Borrowers] / 1000, "#,0.0" ) & "k", FORMAT ( [Borrowers], "#,0" ) ) & " borrowers"
			VAR _svg          =
