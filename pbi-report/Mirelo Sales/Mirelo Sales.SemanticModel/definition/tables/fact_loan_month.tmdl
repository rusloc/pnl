	partition fact_loan_month = m
		mode: import
		source =
				let
				    // Draft source (ADR-0011 (a)): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole. Derived columns are added below, after the typed step.
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_loan_month.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"month_key", type text},
				            {"vintage_month", type text},
				            {"market_code", type text},
				            {"product_code", type text},
				            {"channel_code", type text},
				            {"is_repeat", type logical},
				            {"currency_code", type text},
				            {"loans_disbursed", Int64.Type},
				            {"loans_active", Int64.Type},
				            {"loans_dpd_30p", Int64.Type},
				            {"loans_first_30p", Int64.Type},
				            {"loans_first_90p", Int64.Type},
				            {"principal_disbursed_local", type number},
				            {"outstanding_local", type number},
				            {"bal_current_local", type number},
				            {"bal_dpd_1_29_local", type number},
				            {"bal_dpd_30_59_local", type number},
				            {"bal_dpd_60_89_local", type number},
				            {"bal_dpd_90p_local", type number},
				            {"principal_repaid_local", type number},
				            {"written_off_local", type number},
				            {"provision_local", type number},
				            {"interest_local", type number},
				            {"fee_local", type number}
				        }
				    ),
				    fx = Table.NestedJoin(typed, {"currency_code", "month_key"}, fx_actual, {"currency_code", "month_key"}, "fx", JoinKind.LeftOuter),
				    rate = Table.ExpandTableColumn(fx, "fx", {"local_per_eur"}, {"_rate"}),
				    outstanding_eur = Table.AddColumn(rate, "outstanding_eur", each [outstanding_local] / [_rate], type number),
				    bal_current_eur = Table.AddColumn(outstanding_eur, "bal_current_eur", each [bal_current_local] / [_rate], type number),
				    bal_dpd_1_29_eur = Table.AddColumn(bal_current_eur, "bal_dpd_1_29_eur", each [bal_dpd_1_29_local] / [_rate], type number),
				    bal_dpd_30_59_eur = Table.AddColumn(bal_dpd_1_29_eur, "bal_dpd_30_59_eur", each [bal_dpd_30_59_local] / [_rate], type number),
				    bal_dpd_60_89_eur = Table.AddColumn(bal_dpd_30_59_eur, "bal_dpd_60_89_eur", each [bal_dpd_60_89_local] / [_rate], type number),
				    bal_dpd_90p_eur = Table.AddColumn(bal_dpd_60_89_eur, "bal_dpd_90p_eur", each [bal_dpd_90p_local] / [_rate], type number),
				    principal_repaid_eur = Table.AddColumn(bal_dpd_90p_eur, "principal_repaid_eur", each [principal_repaid_local] / [_rate], type number),
				    written_off_eur = Table.AddColumn(principal_repaid_eur, "written_off_eur", each [written_off_local] / [_rate], type number),
				    provision_eur = Table.AddColumn(written_off_eur, "provision_eur", each [provision_local] / [_rate], type number),
				    interest_eur = Table.AddColumn(provision_eur, "interest_eur", each [interest_local] / [_rate], type number),
				    fee_eur = Table.AddColumn(interest_eur, "fee_eur", each [fee_local] / [_rate], type number),
				    no_rate = Table.RemoveColumns(fee_eur, {"_rate"}),
				    v_index = Table.AddColumn(no_rate, "vintage_index", each (Number.FromText(Text.Start([vintage_month], 4)) - 2024) * 12 + Number.FromText(Text.End([vintage_month], 2)), Int64.Type),
				    mob = Table.AddColumn(v_index, "months_on_book", each (Number.FromText(Text.Start([month_key], 4)) - 2024) * 12 + Number.FromText(Text.End([month_key], 2)) - [vintage_index], Int64.Type),
				    vq_index = Table.AddColumn(mob, "vintage_quarter_index", each (Number.FromText(Text.Start([vintage_month], 4)) - 2024) * 4 + Number.RoundUp(Number.FromText(Text.End([vintage_month], 2)) / 3) - 1, Int64.Type)
				in
				    vq_index

	annotation PBI_ResultType = Table
