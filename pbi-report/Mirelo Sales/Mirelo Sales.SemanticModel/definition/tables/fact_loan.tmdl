	/// principal_local / BUDGET rate of the disbursement month x currency (constant currency).
	column principal_eur_bud
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 33d1a1c3-230e-5c59-92fc-632b0d6363d5
		summarizeBy: none
		sourceColumn: principal_eur_bud

		annotation SummarizationSetBy = User

	partition fact_loan = m
		mode: import
		source =
				let
				    // Draft source (ADR-0011 (a)): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole. Derived columns are added below, after the typed step.
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_loan.parquet")),
				    kept = Table.RemoveColumns(src, {"application_id", "submitted_ts"}),
				    typed = Table.TransformColumnTypes(
				        kept,
				        {
				            {"loan_id", Int64.Type},
				            {"client_id", Int64.Type},
				            {"market_code", type text},
				            {"product_code", type text},
				            {"channel_code", type text},
				            {"agent_code", type text},
				            {"currency_code", type text},
				            {"hours_to_approve", type number},
				            {"hours_to_cash", type number},
				            {"disbursed_date", type date},
				            {"principal_local", type number},
				            {"principal_eur", type number},
				            {"term_months", Int64.Type},
				            {"apr", type number},
				            {"origination_fee_local", type number},
				            {"is_first_loan", type logical},
				            {"is_repeat", type logical},
				            {"prior_loans", Int64.Type},
				            {"status_code", type text},
				            {"dpd_days_close", Int64.Type},
				            {"outstanding_local_close", type number},
				            {"max_dpd_close", Int64.Type},
				            {"repaid_date", type date}
				        }
				    ),
				    mk = Table.AddColumn(typed, "month_key", each Date.ToText([disbursed_date], [Format = "yyyy-MM", Culture = "en-US"]), type text),
				    fx = Table.NestedJoin(mk, {"currency_code", "month_key"}, fx_budget, {"currency_code", "month_key"}, "fx", JoinKind.LeftOuter),
				    rate = Table.ExpandTableColumn(fx, "fx", {"local_per_eur"}, {"_rate_bud"}),
				    bud = Table.AddColumn(rate, "principal_eur_bud", each [principal_local] / [_rate_bud], type number),
				    out = Table.RemoveColumns(bud, {"_rate_bud"})
				in
				    out

	annotation PBI_ResultType = Table
