	partition fact_subscription_month = m
		mode: import
		source =
				let
				    // Draft source (ADR-0011 (a)): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole. Derived columns are added below, after the typed step.
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_subscription_month.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"month_key", type text},
				            {"market_code", type text},
				            {"product_code", type text},
				            {"currency_code", type text},
				            {"subscribers_start", Int64.Type},
				            {"subscribers_new", Int64.Type},
				            {"subscribers_churned", Int64.Type},
				            {"subscribers_end", Int64.Type},
				            {"price_local", type number},
				            {"revenue_local", type number},
				            {"mrr_local", type number},
				            {"revenue_eur", type number},
				            {"mrr_eur", type number}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table
