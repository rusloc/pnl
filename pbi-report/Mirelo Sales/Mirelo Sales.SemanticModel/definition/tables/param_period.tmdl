/// Period picker: Month, Quarter to date, Year to date, Last 12 months (disconnected; codes MONTH / QTD / YTD / R12M). The Filters panel offers the first three (R12M left the UI 2026-11-01, as Track C).
table param_period
	lineageTag: 2fee0b99-bf40-593a-b953-28fdfa21fc5a

	column period_code
		dataType: string
		isHidden
		lineageTag: 125dec77-a0a8-5b3d-ade9-e4b07b7fcb07
		summarizeBy: none
		isNameInferred
		sourceColumn: [period_code]

		annotation SummarizationSetBy = User

	column period_name
		dataType: string
		lineageTag: de50c8d6-32ab-5e80-a266-a9fa4070d998
		summarizeBy: none
		isNameInferred
		sourceColumn: [period_name]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 06b0056d-a9dc-5936-b90e-465234a41420
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition param_period = calculated
		mode: import
		source =
				DATATABLE (
				    "period_code", STRING
				    ,"period_name", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "MONTH", "Month", 1 }
				        ,{ "QTD", "Quarter to date", 2 }
				        ,{ "YTD", "Year to date", 3 }
				        ,{ "R12M", "Last 12 months", 4 }
				    }
				)

	annotation PBI_ResultType = Table
