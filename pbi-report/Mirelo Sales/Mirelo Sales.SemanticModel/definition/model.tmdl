model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Helpers

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "fx_actual", "fx_budget", "dim_date", "dim_month", "dim_market", "dim_product", "dim_channel", "dim_agent", "dim_client", "dim_loan_status", "dim_funnel_stage", "dim_revenue_type", "fact_loan", "fact_application", "fact_loan_month", "fact_subscription_month", "fact_revenue_month", "fact_target", "param_fx", "param_thresholds"]

annotation PBI_ProTooling = ["DevMode"]

