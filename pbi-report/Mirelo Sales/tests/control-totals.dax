        ,"_pass", [actual] = [expected]
    )

// T-M9f list window titles as Track C detail.ts: count of the list - channel / product (All channels / All products) - market - window
//       (the overdue list holds the last close, Sep 2026) (5 rows)
EVALUATE
VAR _rows        =
    {
        ( "list.clients.M-2026-09-ALL.Partner", CALCULATE ( CALCULATE ( [Title Clients List], dim_channel[channel_name] = "Partner" ), FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" ), TREATAS ( { "ALL" }, param_market[market_code] ), TREATAS ( { "BUD" }, param_comparator[comparator_code] ) ), "2,846 new clients - Partner - All markets - Sep 2026" )
        ,( "list.clients.M-2026-09-ALL.all", CALCULATE ( [Title Clients List], FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" ), TREATAS ( { "ALL" }, param_market[market_code] ), TREATAS ( { "BUD" }, param_comparator[comparator_code] ) ), "9,796 new clients - All channels - All markets - Sep 2026" )
        ,( "list.overdue.M-2026-09-ALL.all", CALCULATE ( [Title Overdue List], FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" ), TREATAS ( { "ALL" }, param_market[market_code] ), TREATAS ( { "BUD" }, param_comparator[comparator_code] ) ), "4,782 loans 30+ DPD - All products - All markets - Sep 2026" )
        ,( "list.overdue.M-2026-09-RO.Step 6", CALCULATE ( CALCULATE ( [Title Overdue List], dim_product[product_name] = "Step 6" ), FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" ), TREATAS ( { "RO" }, param_market[market_code] ), TREATAS ( { "BUD" }, param_comparator[comparator_code] ) ), "282 loans 30+ DPD - Step 6 - Romania - Sep 2026" )
        ,( "list.clients.Y-2025-ALL.Partner", CALCULATE ( CALCULATE ( [Title Clients List], dim_channel[channel_name] = "Partner" ), FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2025-01" && param_anchor_month[month_key] <= "2025-12" ), TREATAS ( { "ALL" }, param_market[market_code] ), TREATAS ( { "BUD" }, param_comparator[comparator_code] ) ), "20,502 new clients - Partner - All markets - Jan–Dec 2025" )
    }
RETURN
    SELECTCOLUMNS ( _rows, "check", [Value1], "actual", [Value2], "expected", [Value3], "_pass", [Value2] = [Value3] )

// T-M9g ⓘ pop-ups (Card Info Title / Card Info Note) at Sep 2026 / Month / All / Budget = docs/ADD/features/sales-info-popovers.md
//       (regenerated from Track C copy.ts): title as the card shows it, sub-values "Label: value" joined by "; "
//       (the tooltip note is one button text: no line breaks) (58 rows)
EVALUATE
VAR _expected    =
    DATATABLE (
        "code", STRING
        ,"title", STRING
        ,"note", STRING
        ,{
            { "O1", "Loans issued", "Budget loans: 24.3k; Budget principal: €9.8m (actual −2.3%); Avg ticket: €393 (Budget €404); Prior year: 21.2k - €8.0m; 2026 YTD: 209.9k - €82.1m" }
            ,{ "O2", "New clients locked in", "Share of loans: 40.1%; App: 3,620 (37%); Partner: 2,846 (29%); Paid: 2,509 (26%); Agent: 821 (8%); Budget: 9,905; Prior year: 9,281" }
            ,{ "O3", "Returning clients", "Returning borrowers: 14,614 of 24,410; Loan-weighted: 59.9%; 180-day repeat (cohort Mar 2026): 43.5%; 90-day repeat: 27.6%; Prior year: 56.2%; Budget: none for this ratio" }
            ,{ "O4", "Bad / overdue loans", "30+ DPD balance: €1.5m of €32.5m; 90+ DPD by balance: 2.6%; 30+ by count: 4.6%; Vintage 6m bad rate (Mar 2026): 2.9%; Budget 30+ appetite: 4.2%; Prior year: 5.6%" }
