            ,{ "c9|Q3 2025|165 d", "43%|#C8462B|#FFFFFF" }
            ,{ "c9|Q3 2025|180 d", "44%|#C5412B|#FFFFFF" }
            ,{ "c9|Q4 2025|45 d", "15%|#E2DCC6|#111111" }
            ,{ "c9|Q4 2025|60 d", "23%|#FAD65D|#111111" }
            ,{ "c9|Q4 2025|75 d", "27%|#FCC543|#111111" }
            ,{ "c9|Q4 2025|90 d", "28%|#FAB83C|#111111" }
            ,{ "c9|Q4 2025|105 d", "34%|#F28E29|#111111" }
            ,{ "c9|Q4 2025|120 d", "38%|#E06E29|#111111" }
            ,{ "c9|Q4 2025|135 d", "41%|#D3582A|#FFFFFF" }
            ,{ "c9|Q4 2025|150 d", "43%|#CA4A2A|#FFFFFF" }
            ,{ "c9|Q4 2025|165 d", "44%|#C4402B|#FFFFFF" }
            ,{ "c9|Q4 2025|180 d", "45%|#C0392B|#FFFFFF" }
        }
    )
VAR _cells       =
    CALCULATETABLE (
        UNION (
            SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    dim_product[product_name]
                    ,dim_market[market_name]
                    ,TREATAS ( { "Microloan" }, dim_product[product_line] )
                    ,"v", [Loans Heat Cell]
                    ,"lv", [Heat Level L10]
                    ,"f", [Heat Fill L10]
                    ,"i", [Heat Ink L10]
                )
                ,"chart", "l10", "row", dim_product[product_name], "col", dim_market[market_name], "v", IF ( [v] >= 9999.5, FORMAT ( [v] / 1000, "#,0.0" ) & "k", FORMAT ( [v], "#,0" ) ), "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
            ,SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    dim_product[product_name]
                    ,dim_market[market_name]
                    ,TREATAS ( { "Microloan" }, dim_product[product_line] )
                    ,"v", IF ( ISBLANK ( [DPD30 %] ), IF ( NOT ISBLANK ( [P9 Cell] ), "n/a" ), FORMAT ( [DPD30 %], "0.0%" ) )
                    ,"lv", [Heat Level P9]
                    ,"f", [Heat Fill P9]
                    ,"i", [Heat Ink P9]
                )
                ,"chart", "p9", "row", dim_product[product_name], "col", dim_market[market_name], "v", [v], "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
            ,SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    param_cohort_quarter[quarter_label]
                    ,param_cohort_day[day_label]
                    ,"v", [Cohort Heat %]
                    ,"lv", [Heat Level C9]
                    ,"f", [Heat Fill C9]
                    ,"i", [Heat Ink C9]
                )
                ,"chart", "c9", "row", param_cohort_quarter[quarter_label], "col", param_cohort_day[day_label], "v", FORMAT ( [v], "0%" ), "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
        )
        ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2025-01" && param_anchor_month[month_key] <= "2025-12" )
        ,TREATAS ( { "ALL" }, param_market[market_code] )
        ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
    )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN (
            _expected
            ,SELECTCOLUMNS ( _cells, "check", [chart] & "|" & [row] & "|" & [col], "actual", [v] & "|" & [f] & "|" & [i] )
        )
        ,"_pass", [actual] = [expected]
    )

