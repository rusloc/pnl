            ,{ "p9|Biz Boost|Poland", "2.2%|#E3DCC2|#111111" }
            ,{ "p9|Biz Boost|Romania", "3.9%|#EFD991|#111111" }
            ,{ "p9|Biz Boost|Portugal", "1.4%|#DEDDD8|#111111" }
            ,{ "c9|Q1 2025|45 d", "14%|#DFDDD3|#111111" }
            ,{ "c9|Q1 2025|60 d", "22%|#F7D76C|#111111" }
