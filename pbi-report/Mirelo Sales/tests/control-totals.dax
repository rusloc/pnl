            ,{ "budget.principal_eur", "amount", "33979039.3465", 0.011 }
            ,{ "budget.new_clients", "amount", "53053.0000", 0.011 }
            ,{ "budget.dpd30_pct", "ratio", "0.038000000", 0.000001 }
            ,{ "budget.revenue_eur", "amount", "4880774.9372", 0.011 }
            ,{ "o1.value_text", "text", "125.9k €35.5m", 0 }
            ,{ "o1.row_budget", "text", "vs Budget: ▲ +1.4%", 0 }
            ,{ "o1.row_py", "text", "vs Prior year: ▲ +33.9%", 0 }
