            ,{ "PT", "R12M 2026-09", "2026-09", "R12M", "new_clients", 32164.0 }
            ,{ "PT", "R12M 2026-09", "2026-09", "R12M", "revenue_eur", 5148621.85 }
        }
    )
VAR _actual       =
    ADDCOLUMNS (
        _expected
        ,"actual",
            VAR _metric       = [metric]
            RETURN
                CALCULATE (
                    SWITCH (
                        _metric
                        ,"loans_count"
                            ,[Loans]
                        ,"principal_eur"
                            ,[Principal EUR]
                        ,"new_clients"
                            ,[New Clients]
                        ,"borrowers"
                            ,[Borrowers]
                        ,"returning_clients"
                            ,[Returning Clients]
                        ,"returning_pct_clients"
                            ,[Returning %]
                        ,"returning_pct_loans"
                            ,[Repeat Share]
                        ,"outstanding_eur"
                            ,[Outstanding EUR]
                        ,"dpd30_balance_eur"
                            ,[DPD30 Balance EUR]
                        ,"dpd30_pct"
                            ,[DPD30 %]
                        ,"dpd90_pct"
                            ,[DPD90 %]
                        ,"revenue_eur"
                            ,[Revenue EUR]
                        ,"revenue_interest_eur"
                            ,[Interest EUR]
                        ,"revenue_fee_eur"
                            ,[Fees EUR]
                        ,"revenue_interchange_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "INTERCHANGE" )
                        ,"revenue_subscription_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "SUBSCRIPTION" )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = [period]
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { [market] }, param_market[market_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"diff", [actual] - [expected]
        ,"_pass",
            VAR _tolerance    =
                SWITCH (
                    TRUE ()
                    ,RIGHT ( [metric], 4 ) = "_eur"
                        ,0.005 * SWITCH ( [period], "QTD", 3, "YTD", 12, 12 ) + 0.001
                    ,RIGHT ( [metric], 4 ) = "_pct"
                        || [metric] IN { "returning_pct_clients", "returning_pct_loans" }
                        ,0.000001
                    ,0.5
                )
            RETURN
                ABS ( [actual] - [expected] ) <= _tolerance
    )
ORDER BY
    [_pass]
    ,[window]
    ,[market]
    ,[metric]

// T-M4 bridge identity (steps add up to actual principal) and README rule 2 (new clients = dim_client first loans in the window)
EVALUATE
VAR _cases        =
    DATATABLE (
        "anchor", STRING
        ,"period", STRING
        ,"market", STRING
        ,{
            { "2026-09", "MONTH", "ALL" }
            ,{ "2026-09", "YTD", "ALL" }
            ,{ "2026-09", "YTD", "PL" }
            ,{ "2026-09", "YTD", "RO" }
            ,{ "2026-09", "YTD", "PT" }
            ,{ "2025-12", "YTD", "ALL" }
            ,{ "2026-06", "QTD", "RO" }
            ,{ "2026-09", "R12M", "ALL" }
        }
    )
VAR _rows         =
    ADDCOLUMNS (
        _cases
        ,"bridge_sum",
            CALCULATE (
                SUMX ( VALUES ( dim_bridge_step[step_code] ), [Bridge Value] )
                ,FILTER (
                    ALL ( param_anchor_month )
                    ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                     VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                     VAR _w_period    = [period]
                     VAR _w_start     =
                        SWITCH (
                            _w_period
                            ,"QTD"
                                ,_w_anchor - MOD ( _w_moy - 1, 3 )
                            ,"YTD"
                                ,_w_anchor - _w_moy + 1
                            ,"R12M"
                                ,_w_anchor - 11
                            ,_w_anchor
                        )
                     RETURN
                        param_anchor_month[month_index] >= _w_start
                            && param_anchor_month[month_index] <= _w_anchor
                )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"principal",
            CALCULATE (
                [Principal EUR]
                ,FILTER (
                    ALL ( param_anchor_month )
                    ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                     VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                     VAR _w_period    = [period]
                     VAR _w_start     =
                        SWITCH (
                            _w_period
                            ,"QTD"
                                ,_w_anchor - MOD ( _w_moy - 1, 3 )
                            ,"YTD"
                                ,_w_anchor - _w_moy + 1
                            ,"R12M"
                                ,_w_anchor - 11
                            ,_w_anchor
                        )
                     RETURN
                        param_anchor_month[month_index] >= _w_start
                            && param_anchor_month[month_index] <= _w_anchor
                )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"new_clients",
            CALCULATE (
                [New Clients]
                ,FILTER (
                    ALL ( param_anchor_month )
                    ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                     VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                     VAR _w_period    = [period]
                     VAR _w_start     =
                        SWITCH (
                            _w_period
                            ,"QTD"
                                ,_w_anchor - MOD ( _w_moy - 1, 3 )
                            ,"YTD"
                                ,_w_anchor - _w_moy + 1
                            ,"R12M"
                                ,_w_anchor - 11
                            ,_w_anchor
                        )
                     RETURN
                        param_anchor_month[month_index] >= _w_start
                            && param_anchor_month[month_index] <= _w_anchor
                )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"clients_rule2",
            VAR _market       = [market]
            VAR _anchor       = LOOKUPVALUE ( dim_month[month_index], dim_month[month_key], [anchor] )
            VAR _month_num    = MOD ( _anchor - 1, 12 ) + 1
            VAR _start        =
                SWITCH (
                    [period]
                    ,"QTD"
                        ,_anchor - MOD ( _month_num - 1, 3 )
                    ,"YTD"
                        ,_anchor - _month_num + 1
                    ,"R12M"
                        ,_anchor - 11
                    ,_anchor
                )
            RETURN
                CALCULATE (
                    COUNTROWS ( dim_client )
                    ,dim_client[cohort_month_index] >= _start
                        && dim_client[cohort_month_index] <= _anchor
                    ,FILTER (
                        ALL ( dim_client[market_code] )
                        ,_market = "ALL"
                            || dim_client[market_code] = _market
                    )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            ABS ( [bridge_sum] - [principal] ) <= 0.01
                && [new_clients] = [clients_rule2]
    )

// T-M5 smoke: every card SVG is an svg data URI, the 13-month trend has 13 points (default and RO / YTD / PY)
EVALUATE
VAR _cases        =
    DATATABLE (
        "card", STRING
        ,"state", STRING
        ,{
            { "O1", "default" }
            ,{ "O2", "default" }
            ,{ "O3", "default" }
            ,{ "O4", "default" }
            ,{ "L1", "default" }
            ,{ "L2", "default" }
            ,{ "L3", "default" }
            ,{ "L4", "default" }
            ,{ "L5", "default" }
            ,{ "L6", "default" }
            ,{ "C1", "default" }
            ,{ "C2", "default" }
            ,{ "C3", "default" }
            ,{ "C4", "default" }
            ,{ "C5", "default" }
            ,{ "C6", "default" }
            ,{ "P1", "default" }
            ,{ "P2", "default" }
            ,{ "P3", "default" }
            ,{ "P4", "default" }
            ,{ "P5", "default" }
            ,{ "P6", "default" }
            ,{ "R1", "default" }
            ,{ "R2", "default" }
            ,{ "R3", "default" }
            ,{ "R4", "default" }
            ,{ "R5", "default" }
            ,{ "R6", "default" }
            ,{ "O1", "RO_YTD_PY" }
            ,{ "O2", "RO_YTD_PY" }
            ,{ "O3", "RO_YTD_PY" }
            ,{ "O4", "RO_YTD_PY" }
            ,{ "L1", "RO_YTD_PY" }
            ,{ "L2", "RO_YTD_PY" }
            ,{ "L3", "RO_YTD_PY" }
            ,{ "L4", "RO_YTD_PY" }
            ,{ "L5", "RO_YTD_PY" }
            ,{ "L6", "RO_YTD_PY" }
            ,{ "C1", "RO_YTD_PY" }
            ,{ "C2", "RO_YTD_PY" }
            ,{ "C3", "RO_YTD_PY" }
            ,{ "C4", "RO_YTD_PY" }
            ,{ "C5", "RO_YTD_PY" }
            ,{ "C6", "RO_YTD_PY" }
            ,{ "P1", "RO_YTD_PY" }
            ,{ "P2", "RO_YTD_PY" }
            ,{ "P3", "RO_YTD_PY" }
            ,{ "P4", "RO_YTD_PY" }
            ,{ "P5", "RO_YTD_PY" }
            ,{ "P6", "RO_YTD_PY" }
            ,{ "R1", "RO_YTD_PY" }
            ,{ "R2", "RO_YTD_PY" }
            ,{ "R3", "RO_YTD_PY" }
            ,{ "R4", "RO_YTD_PY" }
            ,{ "R5", "RO_YTD_PY" }
            ,{ "R6", "RO_YTD_PY" }
        }
    )
VAR _rows         =
    ADDCOLUMNS (
        _cases
        ,"uri_start",
            VAR _card         = [card]
            VAR _ro           = [state] = "RO_YTD_PY"
            RETURN
                CALCULATE (
                    LEFT (
                        SWITCH (
                            _card
                            ,"O1"
                                ,[Card O1 SVG]
                            ,"O2"
                                ,[Card O2 SVG]
                            ,"O3"
                                ,[Card O3 SVG]
                            ,"O4"
                                ,[Card O4 SVG]
                            ,"L1"
                                ,[Card L1 SVG]
                            ,"L2"
                                ,[Card L2 SVG]
                            ,"L3"
                                ,[Card L3 SVG]
                            ,"L4"
                                ,[Card L4 SVG]
                            ,"L5"
                                ,[Card L5 SVG]
                            ,"L6"
                                ,[Card L6 SVG]
                            ,"C1"
                                ,[Card C1 SVG]
                            ,"C2"
                                ,[Card C2 SVG]
                            ,"C3"
                                ,[Card C3 SVG]
                            ,"C4"
                                ,[Card C4 SVG]
                            ,"C5"
                                ,[Card C5 SVG]
                            ,"C6"
                                ,[Card C6 SVG]
                            ,"P1"
                                ,[Card P1 SVG]
                            ,"P2"
                                ,[Card P2 SVG]
                            ,"P3"
                                ,[Card P3 SVG]
                            ,"P4"
                                ,[Card P4 SVG]
                            ,"P5"
                                ,[Card P5 SVG]
                            ,"P6"
                                ,[Card P6 SVG]
                            ,"R1"
                                ,[Card R1 SVG]
                            ,"R2"
                                ,[Card R2 SVG]
                            ,"R3"
                                ,[Card R3 SVG]
                            ,"R4"
                                ,[Card R4 SVG]
                            ,"R5"
                                ,[Card R5 SVG]
                            ,"R6"
                                ,[Card R6 SVG]
                        )
                        ,26
                    )
                    ,TREATAS ( { IF ( _ro, "RO", "ALL" ) }, param_market[market_code] )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( "2026-09", 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( "2026-09", 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = IF ( _ro, "YTD", "MONTH" )
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { IF ( _ro, "PY", "BUD" ) }, param_comparator[comparator_code] )
                )
        ,"trend_points",
            VAR _ro           = [state] = "RO_YTD_PY"
            RETURN
                CALCULATE (
                    COUNTROWS ( FILTER ( VALUES ( dim_month[month_index] ), NOT ISBLANK ( [Loans Trend] ) ) )
                    ,TREATAS ( { IF ( _ro, "RO", "ALL" ) }, param_market[market_code] )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( "2026-09", 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( "2026-09", 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = IF ( _ro, "YTD", "MONTH" )
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { IF ( _ro, "PY", "BUD" ) }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            [uri_start] = "data:image/svg+xml;utf8,<s"
                && [trend_points] = 13
    )

// T-M6 ADR-0012 info buttons: every dim_card row has a title and a definition; every card has a note (default selection)
EVALUATE
VAR _rows         =
    ADDCOLUMNS (
        VALUES ( dim_card[card_code] )
        ,"title", CALCULATE ( [Card Info Title] )
        ,"definition", CALCULATE ( [Card Info Definition] )
        ,"note", CALCULATE ( [Card Info Note] )
        ,"is_card", dim_card[card_code] IN { "O1", "O2", "O3", "O4", "L1", "L2", "L3", "L4", "L5", "L6", "C1", "C2", "C3", "C4", "C5", "C6", "P1", "P2", "P3", "P4", "P5", "P6", "R1", "R2", "R3", "R4", "R5", "R6" }
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            LEN ( [title] ) > 0
                && LEN ( [definition] ) > 0
                && ( NOT [is_card] || LEN ( [note] ) > 0 )
    )

// T-M7a 2026-11-01 owner changes (.sync/2026-11-01-mirelo-sales-changes.md, change 9 = Track C kpiRows): the eight KPI cards
//       with a Budget carry vs Budget and vs PY rows (items 6-10 of _Card X Parts), items 3-5 still follow the comparator,
//       the chip (11 / 12) follows the comparator and falls back to the other row when that one is n/a (2024 has no prior
//       year); the other 16 KPI cards stay one row; every KPI SVG puts the title at x 30 and only the eight draw y 110 (64 rows)
EVALUATE
VAR _states       =
    DATATABLE (
        "state", STRING
        ,"anchor"
            ,STRING
        ,"mkt"
            ,STRING
        ,"period"
            ,STRING
        ,"cmp"
            ,STRING
        ,{
            { "default", "2026-09", "ALL", "MONTH", "BUD" }
            ,{ "py", "2026-09", "ALL", "MONTH", "PY" }
            ,{ "ro_ytd_py", "2026-09", "RO", "YTD", "PY" }
            ,{ "fallback", "2024-12", "ALL", "MONTH", "PY" }
        }
    )
VAR _cards        =
    DATATABLE (
        "card", STRING
        ,"rows"
            ,INTEGER
        ,{
            { "L1", 2 }
            ,{ "L2", 2 }
            ,{ "L3", 2 }
            ,{ "L4", 1 }
            ,{ "L5", 1 }
            ,{ "L6", 1 }
            ,{ "C1", 2 }
            ,{ "C2", 1 }
            ,{ "C3", 1 }
            ,{ "C4", 1 }
            ,{ "C5", 1 }
            ,{ "C6", 1 }
            ,{ "P1", 2 }
            ,{ "P2", 1 }
            ,{ "P3", 1 }
            ,{ "P4", 1 }
            ,{ "P5", 1 }
            ,{ "P6", 1 }
            ,{ "R1", 2 }
            ,{ "R2", 1 }
            ,{ "R3", 2 }
            ,{ "R4", 2 }
            ,{ "R5", 1 }
            ,{ "R6", 1 }
        }
    )
VAR _expected     =
    DATATABLE (
        "card", STRING
        ,"state"
            ,STRING
        ,"expected"
            ,STRING
        ,{
            { "L1", "default", "▲ +0.4%|▲ +15.2%|good" }
            ,{ "P1", "default", "▲ +0.4pp|▼ −0.9pp|watch" }
            ,{ "P1", "py", "▲ +0.4pp|▼ −0.9pp|good" }
            ,{ "L1", "fallback", "▲ +0.8%|n/a|good" }
        }
    )
VAR _grid         =
    FILTER (
        CROSSJOIN ( _states, _cards )
        ,[rows] = 2
            || [state] IN { "default", "ro_ytd_py" }
    )
VAR _rows         =
    ADDCOLUMNS (
        _grid
        ,"parts",
            VAR _card         = [card]
            RETURN
                CALCULATE (
                    SWITCH (
                        _card
                        ,"L1"
                            ,[_Card L1 Parts]
                        ,"L2"
                            ,[_Card L2 Parts]
                        ,"L3"
                            ,[_Card L3 Parts]
                        ,"L4"
                            ,[_Card L4 Parts]
                        ,"L5"
                            ,[_Card L5 Parts]
                        ,"L6"
                            ,[_Card L6 Parts]
                        ,"C1"
                            ,[_Card C1 Parts]
                        ,"C2"
                            ,[_Card C2 Parts]
                        ,"C3"
                            ,[_Card C3 Parts]
                        ,"C4"
                            ,[_Card C4 Parts]
                        ,"C5"
                            ,[_Card C5 Parts]
                        ,"C6"
                            ,[_Card C6 Parts]
                        ,"P1"
                            ,[_Card P1 Parts]
                        ,"P2"
                            ,[_Card P2 Parts]
                        ,"P3"
                            ,[_Card P3 Parts]
                        ,"P4"
                            ,[_Card P4 Parts]
                        ,"P5"
                            ,[_Card P5 Parts]
                        ,"P6"
                            ,[_Card P6 Parts]
                        ,"R1"
                            ,[_Card R1 Parts]
                        ,"R2"
                            ,[_Card R2 Parts]
                        ,"R3"
                            ,[_Card R3 Parts]
                        ,"R4"
                            ,[_Card R4 Parts]
                        ,"R5"
                            ,[_Card R5 Parts]
                        ,"R6"
                            ,[_Card R6 Parts]
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = [period]
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { [mkt] }, param_market[market_code] )
                    ,TREATAS ( { [cmp] }, param_comparator[comparator_code] )
                )
        ,"svg",
            VAR _card         = [card]
            RETURN
                CALCULATE (
                    SWITCH (
                        _card
                        ,"L1"
                            ,[Card L1 SVG]
                        ,"L2"
                            ,[Card L2 SVG]
                        ,"L3"
                            ,[Card L3 SVG]
                        ,"L4"
                            ,[Card L4 SVG]
                        ,"L5"
                            ,[Card L5 SVG]
                        ,"L6"
                            ,[Card L6 SVG]
                        ,"C1"
                            ,[Card C1 SVG]
                        ,"C2"
                            ,[Card C2 SVG]
                        ,"C3"
                            ,[Card C3 SVG]
                        ,"C4"
                            ,[Card C4 SVG]
                        ,"C5"
                            ,[Card C5 SVG]
                        ,"C6"
                            ,[Card C6 SVG]
                        ,"P1"
                            ,[Card P1 SVG]
                        ,"P2"
                            ,[Card P2 SVG]
                        ,"P3"
                            ,[Card P3 SVG]
                        ,"P4"
                            ,[Card P4 SVG]
                        ,"P5"
                            ,[Card P5 SVG]
                        ,"P6"
                            ,[Card P6 SVG]
                        ,"R1"
                            ,[Card R1 SVG]
                        ,"R2"
                            ,[Card R2 SVG]
                        ,"R3"
                            ,[Card R3 SVG]
                        ,"R4"
                            ,[Card R4 SVG]
                        ,"R5"
                            ,[Card R5 SVG]
                        ,"R6"
                            ,[Card R6 SVG]
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = [period]
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { [mkt] }, param_market[market_code] )
                    ,TREATAS ( { [cmp] }, param_comparator[comparator_code] )
                )
        ,"expected",
            VAR _card         = [card]
            VAR _state        = [state]
            RETURN
                MAXX ( FILTER ( _expected, [card] = _card && [state] = _state ), [expected] )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            VAR _p            = [parts]
            VAR _py           = [cmp] = "PY"
            VAR _chosen_row   = IF ( _py, PATHITEM ( _p, 9 ), PATHITEM ( _p, 7 ) )
            VAR _chosen_s     = IF ( _py, PATHITEM ( _p, 10 ), PATHITEM ( _p, 8 ) )
            VAR _other_s      = IF ( _py, PATHITEM ( _p, 8 ), PATHITEM ( _p, 10 ) )
            VAR _two_rows     =
                PATHITEM ( _p, 6 ) = "2"
                    && PATHITEM ( _p, 4 ) = _chosen_row
                    && PATHITEM ( _p, 5 ) = _chosen_s
                    && PATHITEM ( _p, 11 ) = IF ( _chosen_row = "n/a", _other_s, _chosen_s )
                    && PATHITEM ( _p, 12 ) = IF ( _chosen_row = "n/a", IF ( _py, PATHITEM ( _p, 7 ), PATHITEM ( _p, 9 ) ), _chosen_row )
                    && CONTAINSSTRING ( [svg], "y='110'" )
            VAR _one_row      =
                PATHITEM ( _p, 6 ) = ""
                    && NOT CONTAINSSTRING ( [svg], "y='110'" )
            VAR _literal      =
                VAR _e            = [expected]
                RETURN
                    ISBLANK ( _e )
                        || PATHITEM ( _p, 7 ) & "|" & PATHITEM ( _p, 9 ) & "|" & PATHITEM ( _p, 11 ) = _e
            RETURN
                LEFT ( [svg], 26 ) = "data:image/svg+xml;utf8,<s"
                    && ( CONTAINSSTRING ( [svg], "<text x='30' y='36'" ) || CONTAINSSTRING ( [svg], "<text x='30' y='30'" ) )
                    && IF ( [rows] = 2, _two_rows, _one_row )
                    && _literal
    )

// T-M8a 2026-11-02 owner changes rounds 2-4 (.sync/2026-11-01-mirelo-sales-changes.md, change 11): the period is a range
//       of closed months on param_anchor_month. Filter line (Track C filterLine / periodLabel), Showing sentence (periodLine,
//       PERIOD_KIND_NAMES), Reset disabled look at the defaults (change 12) and the four hero values, unchanged at
//       Sep 2026 / Month / All (cases from Track C periods.test.ts) (33 rows)
EVALUATE
VAR _cases       =
    DATATABLE (
        "what", STRING
        ,"from", STRING
        ,"to", STRING
        ,"mkt", STRING
        ,"cmp", STRING
        ,"expected", STRING
        ,{
            { "filter", "2026-09", "2026-09", "ALL", "BUD", "Sep 2026 - vs Budget - All markets" }
            ,{ "filter", "2026-07", "2026-09", "RO", "PY", "Q3 2026 - vs Prior year - Romania" }
            ,{ "filter", "2026-01", "2026-09", "PL", "BUD", "Year 2026 (Jan–Sep) - vs Budget - Poland" }
            ,{ "filter", "2025-01", "2025-12", "ALL", "PY", "Year 2025 - vs Prior year - All markets" }
            ,{ "filter", "2025-10", "2025-12", "ALL", "BUD", "Q4 2025 - vs Budget - All markets" }
            ,{ "filter", "2024-01", "2024-12", "PT", "BUD", "Year 2024 - vs Budget - Portugal" }
            ,{ "filter", "2025-06", "2025-09", "ALL", "BUD", "Jun–Sep 2025 - vs Budget - All markets" }
            ,{ "filter", "2026-07", "2026-08", "ALL", "BUD", "Jul–Aug 2026 - vs Budget - All markets" }
            ,{ "filter", "2025-11", "2026-02", "ALL", "BUD", "Nov 2025–Feb 2026 - vs Budget - All markets" }
            ,{ "filter", "2025-10", "2026-09", "ALL", "BUD", "Oct 2025–Sep 2026 - vs Budget - All markets" }
            ,{ "filter", "2026-03", "2026-03", "RO", "PY", "Mar 2026 - vs Prior year - Romania" }
            ,{ "filter", "2026-01", "2026-03", "ALL", "BUD", "Q1 2026 - vs Budget - All markets" }
            ,{ "filter", "2024-01", "2026-09", "ALL", "BUD", "Jan 2024–Sep 2026 - vs Budget - All markets" }
            ,{ "showing", "2025-01", "2025-12", "ALL", "PY", "Showing Jan–Dec 2025 - Year - All markets - Actual vs Prior year and Budget - Closed through Sep 2026" }
            ,{ "showing", "2026-09", "2026-09", "ALL", "BUD", "Showing Sep 2026 - Month - All markets - Actual vs Budget and Prior year - Closed through Sep 2026" }
            ,{ "showing", "2026-07", "2026-09", "RO", "PY", "Showing Jul–Sep 2026 - Quarter - Romania - Actual vs Prior year and Budget - Closed through Sep 2026" }
            ,{ "showing", "2026-01", "2026-09", "PL", "BUD", "Showing Jan–Sep 2026 - Year - Poland - Actual vs Budget and Prior year - Closed through Sep 2026" }
            ,{ "showing", "2025-06", "2025-09", "ALL", "BUD", "Showing Jun–Sep 2025 - Custom range - All markets - Actual vs Budget and Prior year - Closed through Sep 2026" }
            ,{ "showing", "2025-11", "2026-02", "PT", "PY", "Showing Nov 2025–Feb 2026 - Custom range - Portugal - Actual vs Prior year and Budget - Closed through Sep 2026" }
            ,{ "kind", "2026-09", "2026-09", "ALL", "BUD", "month" }
            ,{ "kind", "2026-07", "2026-09", "ALL", "BUD", "quarter" }
            ,{ "kind", "2026-07", "2026-08", "ALL", "BUD", "range" }
            ,{ "kind", "2024-01", "2024-12", "ALL", "BUD", "year" }
            ,{ "kind", "2026-01", "2026-09", "ALL", "BUD", "year" }
            ,{ "kind", "2024-10", "2025-09", "ALL", "BUD", "range" }
            ,{ "default", "2026-09", "2026-09", "ALL", "BUD", "1" }
            ,{ "default", "2026-08", "2026-08", "ALL", "BUD", "0" }
            ,{ "default", "2026-09", "2026-09", "RO", "BUD", "0" }
            ,{ "default", "2026-09", "2026-09", "ALL", "PY", "0" }
            ,{ "o1", "2026-09", "2026-09", "ALL", "BUD", "24.4k|€9.6m" }
            ,{ "o2", "2026-09", "2026-09", "ALL", "BUD", "9,796" }
            ,{ "o3", "2026-09", "2026-09", "ALL", "BUD", "59.9%" }
            ,{ "o4", "2026-09", "2026-09", "ALL", "BUD", "4.6%" }
        }
    )
VAR _rows        =
    ADDCOLUMNS (
        _cases
        ,"actual",
            VAR _what        = [what]
            VAR _from        = [from]
            VAR _to          = [to]
            RETURN
                CALCULATE (
                    SWITCH (
                        _what
                        ,"filter"
                            ,[Header Filter Line]
                        ,"showing"
                            ,[How To Read Showing]
                        ,"kind"
                            ,[_Period Kind]
                        ,"default"
                            ,FORMAT ( [Filters At Default], "0" )
                        ,"o1"
                            ,PATHITEM ( [_Card O1 Parts], 1 ) & "|" & PATHITEM ( [_Card O1 Parts], 2 )
                        ,"o2"
                            ,PATHITEM ( [_Card O2 Parts], 1 )
                        ,"o3"
                            ,PATHITEM ( [_Card O3 Parts], 1 )
                        ,"o4"
                            ,PATHITEM ( [_Card O4 Parts], 1 )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,param_anchor_month[month_key] >= _from
                            && param_anchor_month[month_key] <= _to
                    )
                    ,TREATAS ( { [mkt] }, param_market[market_code] )
                    ,TREATAS ( { [cmp] }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass"
            ,[actual] = [expected]
    )

// T-M8b free ranges compute real values (change 11, n/a decision): additive and distinct-count figures of a range equal
//       a direct count over fact_loan for those months; PY = the same months a year earlier; no pick = the last closed
//       month (24 rows)
EVALUATE
VAR _cases       =
    DATATABLE (
        "from", STRING
        ,"to", STRING
        ,"mkt", STRING
        ,{
            { "2025-06", "2025-09", "ALL" }
            ,{ "2025-11", "2026-02", "ALL" }
            ,{ "2025-10", "2026-09", "PL" }
            ,{ "2026-07", "2026-08", "RO" }
            ,{ "2025-03", "2025-05", "PT" }
            ,{ "2026-09", "2026-09", "ALL" }
        }
    )
VAR _rows        =
    ADDCOLUMNS (
        _cases
        ,"loans",
            CALCULATE (
                [Loans]
                ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= [from] && param_anchor_month[month_key] <= [to] )
                ,TREATAS ( { [mkt] }, param_market[market_code] )
            )
        ,"loans_direct",
            VAR _from        = [from]
            VAR _to          = [to]
            VAR _mkt         = [mkt]
            RETURN
                COUNTROWS (
                    FILTER (
                        ALL ( fact_loan[month_key], fact_loan[market_code], fact_loan[loan_id] )
                        ,fact_loan[month_key] >= _from
                            && fact_loan[month_key] <= _to
                            && ( _mkt = "ALL" || fact_loan[market_code] = _mkt )
                    )
                )
        ,"loans_py",
            CALCULATE (
                [Loans PY]
                ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= [from] && param_anchor_month[month_key] <= [to] )
                ,TREATAS ( { [mkt] }, param_market[market_code] )
            )
        ,"loans_py_direct",
            VAR _from        = FORMAT ( VALUE ( LEFT ( [from], 4 ) ) - 1, "0" ) & RIGHT ( [from], 3 )
            VAR _to          = FORMAT ( VALUE ( LEFT ( [to], 4 ) ) - 1, "0" ) & RIGHT ( [to], 3 )
            VAR _mkt         = [mkt]
            RETURN
                COUNTROWS (
                    FILTER (
                        ALL ( fact_loan[month_key], fact_loan[market_code], fact_loan[loan_id] )
                        ,fact_loan[month_key] >= _from
                            && fact_loan[month_key] <= _to
                            && ( _mkt = "ALL" || fact_loan[market_code] = _mkt )
                    )
                )
        ,"returning",
            CALCULATE (
                [Returning %]
                ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= [from] && param_anchor_month[month_key] <= [to] )
                ,TREATAS ( { [mkt] }, param_market[market_code] )
            )
        ,"returning_direct",
            VAR _from        = [from]
            VAR _to          = [to]
            VAR _mkt         = [mkt]
            VAR _loans       =
                CALCULATETABLE (
                    fact_loan
                    ,REMOVEFILTERS ( fact_loan )
                    ,fact_loan[month_key] >= _from
                    ,fact_loan[month_key] <= _to
                    ,FILTER ( ALL ( fact_loan[market_code] ), _mkt = "ALL" || fact_loan[market_code] = _mkt )
                )
            RETURN
                DIVIDE (
                    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _loans, fact_loan[is_repeat] = TRUE () ), "c", fact_loan[client_id] ) ) )
                    ,COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _loans, "c", fact_loan[client_id] ) ) )
                )
    )
VAR _checks      =
    UNION (
        SELECTCOLUMNS ( _rows, "case", [from] & ".." & [to] & " " & [mkt], "metric", "loans", "actual", [loans], "expected", [loans_direct] )
        ,SELECTCOLUMNS ( _rows, "case", [from] & ".." & [to] & " " & [mkt], "metric", "loans_py", "actual", [loans_py], "expected", [loans_py_direct] )
        ,SELECTCOLUMNS ( _rows, "case", [from] & ".." & [to] & " " & [mkt], "metric", "returning_pct", "actual", [returning], "expected", [returning_direct] )
        ,SELECTCOLUMNS ( _rows, "case", [from] & ".." & [to] & " " & [mkt], "metric", "returning_not_blank", "actual", IF ( ISBLANK ( [returning] ), 0, 1 ), "expected", 1 )
    )
RETURN
    ADDCOLUMNS (
        _checks
        ,"_pass", NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= 0.0000001
    )

// T-M8c C5 Returning-client approval rate (change 25): owner's check (Sep 2026 / All: 81.4 %, +0.1 pp vs PY, card face)
//       and the measure against a direct sum over fact_application for 4 markets x 4 windows, Actual and PY (37 rows)
EVALUATE
VAR _face        =
    {
        ( "c5.label", LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "C5" ), "Returning-client approval rate" )
        ,( "c5.value_text", PATHITEM ( [_Card C5 Parts], 1 ), "81.4%" )
        ,( "c5.row_cmp", PATHITEM ( [_Card C5 Parts], 3 ), "vs PY" )
        ,( "c5.row", PATHITEM ( [_Card C5 Parts], 4 ), "▲ +0.1pp" )
        ,( "c5.chip", PATHITEM ( [_Card C5 Parts], 5 ), "good" )
    }
VAR _windows     =
    DATATABLE (
        "from", STRING
        ,"to", STRING
        ,{
            { "2026-09", "2026-09" }
            ,{ "2026-07", "2026-09" }
            ,{ "2025-01", "2025-12" }
            ,{ "2025-06", "2025-09" }
        }
    )
VAR _grid        =
    ADDCOLUMNS (
        CROSSJOIN ( _windows, DATATABLE ( "mkt", STRING, { { "ALL" }, { "PL" }, { "RO" }, { "PT" } } ) )
        ,"actual",
            CALCULATE (
                [Returning-client Approval Rate]
                ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= [from] && param_anchor_month[month_key] <= [to] )
                ,TREATAS ( { [mkt] }, param_market[market_code] )
            )
        ,"expected",
            VAR _from        = [from]
            VAR _to          = [to]
            VAR _mkt         = [mkt]
            VAR _apps        =
                FILTER (
                    ALL ( fact_application )
                    ,fact_application[is_repeat] = TRUE ()
                        && fact_application[month_key] >= _from
                        && fact_application[month_key] <= _to
                        && ( _mkt = "ALL" || fact_application[market_code] = _mkt )
                )
            RETURN
                DIVIDE ( SUMX ( _apps, fact_application[approved] ), SUMX ( _apps, fact_application[apps_submitted] ) )
        ,"actual_py",
            CALCULATE (
                [Returning-client Approval Rate PY]
                ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= [from] && param_anchor_month[month_key] <= [to] )
                ,TREATAS ( { [mkt] }, param_market[market_code] )
            )
        ,"expected_py",
            VAR _from        = FORMAT ( VALUE ( LEFT ( [from], 4 ) ) - 1, "0" ) & RIGHT ( [from], 3 )
            VAR _to          = FORMAT ( VALUE ( LEFT ( [to], 4 ) ) - 1, "0" ) & RIGHT ( [to], 3 )
            VAR _mkt         = [mkt]
            VAR _apps        =
                FILTER (
                    ALL ( fact_application )
                    ,fact_application[is_repeat] = TRUE ()
                        && fact_application[month_key] >= _from
                        && fact_application[month_key] <= _to
                        && ( _mkt = "ALL" || fact_application[market_code] = _mkt )
                )
            RETURN
                DIVIDE ( SUMX ( _apps, fact_application[approved] ), SUMX ( _apps, fact_application[apps_submitted] ) )
    )
RETURN
    UNION (
        SELECTCOLUMNS ( _face, "check", [Value1], "actual", [Value2], "expected", [Value3], "_pass", [Value2] = [Value3] )
        ,SELECTCOLUMNS ( _grid, "check", "rate " & [from] & ".." & [to] & " " & [mkt], "actual", FORMAT ( [actual], "0.000000000" ), "expected", FORMAT ( [expected], "0.000000000" ), "_pass", ABS ( [actual] - [expected] ) <= 0.0000001 )
        ,SELECTCOLUMNS ( _grid, "check", "py " & [from] & ".." & [to] & " " & [mkt], "actual", FORMAT ( [actual_py], "0.000000000" ), "expected", FORMAT ( [expected_py], "0.000000000" ), "_pass", ABS ( [actual_py] - [expected_py] ) <= 0.0000001 )
    )

// T-M8d L8 application funnel on the scale of Started (change 23) and C8 % of leads (change 15), Sep 2026 / All: the
//       owner's figures (Started 61.7k with 10.7k lost ... Disbursed 24.4k), reached + not reached = the stage, lost =
//       stage - next stage, Started label "x% of leads", C8 label = new-applicant stage / new-applicant leads (17 rows)
EVALUATE
VAR _expected    =
    DATATABLE (
        "stage", STRING
        ,"count_k", STRING
        ,"lost_k", STRING
        ,"next", STRING
        ,{
            { "STARTED", "61.7k", "10.7k", "SUBMITTED" }
            ,{ "SUBMITTED", "51.0k", "3.6k", "KYC_PASSED" }
            ,{ "KYC_PASSED", "47.4k", "19.9k", "APPROVED" }
            ,{ "APPROVED", "27.4k", "3.0k", "DISBURSED" }
            ,{ "DISBURSED", "24.4k", "", "" }
        }
    )
VAR _l8          =
    ADDCOLUMNS (
        _expected
        ,"count", CALCULATE ( [Funnel Count], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
        ,"reached", CALCULATE ( [Funnel Reached Next], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
        ,"lost", CALCULATE ( [Funnel Not Reached], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
        ,"next_count", IF ( [next] <> "", CALCULATE ( [Funnel Count], TREATAS ( { [next] }, dim_funnel_stage[stage_code] ) ) )
        ,"label", CALCULATE ( [Funnel Label], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
    )
VAR _c8          =
    ADDCOLUMNS (
        DATATABLE ( "stage", STRING, { { "SUBMITTED" }, { "APPROVED" }, { "DISBURSED" } } )
        ,"label", CALCULATE ( [Funnel New Label], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
        ,"expected",
            VAR _s           = CALCULATE ( [Funnel Count New], TREATAS ( { [stage] }, dim_funnel_stage[stage_code] ) )
            VAR _leads       = CALCULATE ( [Funnel Count New], TREATAS ( { "LEAD" }, dim_funnel_stage[stage_code] ) )
            RETURN
                FORMAT ( DIVIDE ( _s, _leads ), "0.0%" ) & " of leads"
    )
RETURN
    UNION (
        SELECTCOLUMNS ( _l8, "check", "l8.count " & [stage], "actual", FORMAT ( [count] / 1000, "0.0" ) & "k", "expected", [count_k], "_pass", FORMAT ( [count] / 1000, "0.0" ) & "k" = [count_k] )
        ,SELECTCOLUMNS ( _l8, "check", "l8.lost " & [stage], "actual", IF ( ISBLANK ( [lost] ), "", FORMAT ( [lost] / 1000, "0.0" ) & "k" ), "expected", [lost_k], "_pass", IF ( ISBLANK ( [lost] ), "", FORMAT ( [lost] / 1000, "0.0" ) & "k" ) = [lost_k] && ( [stage] = "DISBURSED" || [lost] = [count] - [next_count] ) )
        ,SELECTCOLUMNS ( _l8, "check", "l8.stack " & [stage], "actual", FORMAT ( [reached] + [lost], "0" ), "expected", FORMAT ( [count], "0" ), "_pass", [reached] + [lost] = [count] )
        ,{ ( "l8.label STARTED", MAXX ( FILTER ( _l8, [stage] = "STARTED" ), [label] ), "52% of leads - +1.1pp vs PY", MAXX ( FILTER ( _l8, [stage] = "STARTED" ), [label] ) = "52% of leads - +1.1pp vs PY" ) }
        ,SELECTCOLUMNS ( _c8, "check", "c8.label " & [stage], "actual", [label], "expected", [expected], "_pass", [label] = [expected] )
    )

// T-M8e C11 acquisition by channel (change 28), Sep 2026 / All: App 3,620 · Paid 2,509 · Partner 2,846 · Agent 821 = 9,796
//       (owner's check), each equal to a direct count of first loans, shares add to 1, vs PY delta and status rule (14 rows)
EVALUATE
VAR _expected    =
    DATATABLE (
        "channel", STRING
        ,"code", STRING
        ,"expected", INTEGER
        ,{
            { "App organic", "APP", 3620 }
            ,{ "Paid", "PAID", 2509 }
            ,{ "Partner", "PARTNER", 2846 }
            ,{ "Agent", "AGENT", 821 }
        }
    )
VAR _rows        =
    ADDCOLUMNS (
        _expected
        ,"new", CALCULATE ( [New Clients], TREATAS ( { [channel] }, dim_channel[channel_name] ) )
        ,"direct",
            VAR _code        = [code]
            RETURN
                COUNTROWS (
                    FILTER (
                        ALL ( fact_loan[loan_id], fact_loan[month_key], fact_loan[channel_code], fact_loan[is_first_loan] )
                        ,fact_loan[month_key] = "2026-09"
                            && fact_loan[channel_code] = _code
                            && fact_loan[is_first_loan] = TRUE ()
                    )
                )
        ,"share", CALCULATE ( [New Clients Share], TREATAS ( { [channel] }, dim_channel[channel_name] ) )
        ,"delta", CALCULATE ( [New Clients Δ PY %], TREATAS ( { [channel] }, dim_channel[channel_name] ) )
        ,"py", CALCULATE ( [New Clients PY], TREATAS ( { [channel] }, dim_channel[channel_name] ) )
        ,"status", CALCULATE ( [New Clients PY Status], TREATAS ( { [channel] }, dim_channel[channel_name] ) )
    )
RETURN
    UNION (
        SELECTCOLUMNS ( _rows, "check", "c11.new " & [channel], "actual", [new] & "", "expected", [expected] & "", "_pass", [new] = [expected] && [direct] = [expected] )
        ,SELECTCOLUMNS (
            _rows
            ,"check", "c11.status " & [channel]
            ,"actual", [status]
            ,"expected",
                VAR _d           = ROUND ( DIVIDE ( [new] - [py], [py] ), 3 )
                RETURN
                    IF ( _d > 0, "▲ ", IF ( _d < 0, "▼ ", "◦ " ) ) & IF ( _d >= 0, "Good", IF ( _d >= -0.05, "Watch", "Off" ) )
            ,"_pass",
                VAR _d           = ROUND ( DIVIDE ( [new] - [py], [py] ), 3 )
                RETURN
                    [status] = IF ( _d > 0, "▲ ", IF ( _d < 0, "▼ ", "◦ " ) ) & IF ( _d >= 0, "Good", IF ( _d >= -0.05, "Watch", "Off" ) )
                        && ABS ( [delta] - DIVIDE ( [new] - [py], [py] ) ) <= 0.0000001
        )
        ,SELECTCOLUMNS ( _rows, "check", "c11.share " & [channel], "actual", FORMAT ( [share], "0.000000" ), "expected", FORMAT ( DIVIDE ( [new], 9796 ), "0.000000" ), "_pass", ABS ( [share] - DIVIDE ( [new], 9796 ) ) <= 0.0000001 )
        ,{ ( "c11.total", SUMX ( _rows, [new] ) & "", "9796", SUMX ( _rows, [new] ) = 9796 && [New Clients] = 9796 ) }
        ,{ ( "c11.share_sum", FORMAT ( SUMX ( _rows, [share] ), "0.000000" ), "1.000000", ABS ( SUMX ( _rows, [share] ) - 1 ) <= 0.0000001 ) }
    )

// T-M8f R11 new vs churned paying subscribers (change 27): the lines cross in Feb 2026 (665 new vs 754 churned, owner's
//       check); 13 points per line at the default selection; R11 info note (churn rate and net adds of the month) (5 rows)
EVALUATE
VAR _feb         =
    CALCULATETABLE (
        ROW ( "new", [Subscribers New Trend], "churned", [Subscribers Churned Trend] )
        ,dim_month[month_key] = "2026-02"
    )
VAR _points      = COUNTROWS ( FILTER ( VALUES ( dim_month[month_index] ), NOT ISBLANK ( [Subscribers New Trend] ) ) )
VAR _points_c    = COUNTROWS ( FILTER ( VALUES ( dim_month[month_index] ), NOT ISBLANK ( [Subscribers Churned Trend] ) ) )
RETURN
    SELECTCOLUMNS (
        {
            ( "r11.new Feb 2026", MAXX ( _feb, [new] ) & "", "665", MAXX ( _feb, [new] ) = 665 )
            ,( "r11.churned Feb 2026", MAXX ( _feb, [churned] ) & "", "754", MAXX ( _feb, [churned] ) = 754 )
            ,( "r11.points new", _points & "", "13", _points = 13 )
            ,( "r11.points churned", _points_c & "", "13", _points_c = 13 )
            ,( "r11.note", CALCULATE ( [Card Info Note], dim_card[card_code] = "R11" ), "Churn rate Sep 2026 ...", LEFT ( CALCULATE ( [Card Info Note], dim_card[card_code] = "R11" ), 19 ) = "Churn rate Sep 2026" )
        }
        ,"check", [Value1]
        ,"actual", [Value2]
        ,"expected", [Value3]
        ,"_pass", [Value4]
    )

// T-M8g P13 overdue by product (change 29), Sep 2026 / All: buckets of the five microloan products add up to the book,
//       30+ DPD % = (30-59 + 60-89 + 90+) / outstanding, vs PY in pp as shown, riskDown status rule (16 rows)
EVALUATE
VAR _rows        =
    ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( dim_product[product_name] ), dim_product[product_line] = "Microloan" )
        ,"out", [Outstanding EUR]
        ,"b30", [Bal 30-59 EUR]
        ,"b60", [Bal 60-89 EUR]
        ,"b90", [Bal 90+ EUR]
        ,"dpd", [DPD30 %]
        ,"dpd_py", [DPD30 % PY]
        ,"pp", [DPD30 Δ PY pp]
        ,"status", [DPD30 PY Status]
    )
RETURN
    UNION (
        SELECTCOLUMNS ( _rows, "check", "p13.dpd " & [product_name], "actual", FORMAT ( [dpd], "0.000000" ), "expected", FORMAT ( DIVIDE ( [b30] + [b60] + [b90], [out] ), "0.000000" ), "_pass", ABS ( [dpd] - DIVIDE ( [b30] + [b60] + [b90], [out] ) ) <= 0.0000001 )
        ,SELECTCOLUMNS (
            _rows
            ,"check", "p13.status " & [product_name]
            ,"actual", [status]
            ,"expected",
                VAR _d           = ROUND ( ( [dpd] - [dpd_py] ) * 100, 1 )
                RETURN
                    IF ( _d > 0, "▲ ", IF ( _d < 0, "▼ ", "◦ " ) ) & IF ( _d <= 0, "Good", IF ( _d <= 0.5, "Watch", "Off" ) )
            ,"_pass",
                VAR _d           = ROUND ( ( [dpd] - [dpd_py] ) * 100, 1 )
                RETURN
                    [pp] = _d
                        && [status] = IF ( _d > 0, "▲ ", IF ( _d < 0, "▼ ", "◦ " ) ) & IF ( _d <= 0, "Good", IF ( _d <= 0.5, "Watch", "Off" ) )
        )
        ,SELECTCOLUMNS ( _rows, "check", "p13.balance " & [product_name], "actual", FORMAT ( [b30] + [b60] + [b90], "0" ), "expected", FORMAT ( [out], "0" ), "_pass", [b30] + [b60] + [b90] <= [out] )
        ,{
            (
                "p13.book"
                ,FORMAT ( SUMX ( _rows, [out] ), "0" )
                ,FORMAT ( CALCULATE ( [Outstanding EUR], dim_product[product_line] = "Microloan" ), "0" )
                ,ABS ( SUMX ( _rows, [out] ) - CALCULATE ( [Outstanding EUR], dim_product[product_line] = "Microloan" ) ) <= 0.01
            )
        }
    )

// T-M8h heat matrices L10 / P9 / C9 (changes 24 / 26 / 32), Sep 2026 / All, as the visuals query them: level = (value -
//       min) / (max - min) over every shown cell, min 0 and max 1, fill at the ends grey #DEDDD8 / red #C0392B, ink white
//       from 0.8; C9 = the four quarter cohorts Q4 2025 ... Q3 2026, first column 45 d, Q3 2026 blank (right-censored)
//       from 75 d (50 rows)
EVALUATE
VAR _l10         =
    SUMMARIZECOLUMNS (
        dim_product[product_name]
        ,dim_market[market_name]
        ,TREATAS ( { "Microloan" }, dim_product[product_line] )
        ,"v", [Loans Heat Cell]
        ,"lvl", [Heat Level L10]
        ,"fill", [Heat Fill L10]
        ,"ink", [Heat Ink L10]
    )
VAR _p9          =
    SUMMARIZECOLUMNS (
        dim_product[product_name]
        ,dim_market[market_name]
        ,TREATAS ( { "Microloan" }, dim_product[product_line] )
        ,"v", [DPD30 %]
        ,"lvl", [Heat Level P9]
        ,"fill", [Heat Fill P9]
        ,"ink", [Heat Ink P9]
    )
VAR _c9          =
    SUMMARIZECOLUMNS (
        param_cohort_quarter[quarter_index]
        ,param_cohort_quarter[quarter_label]
        ,param_cohort_day[days]
        ,"v", [Cohort Heat %]
        ,"lvl", [Heat Level C9]
        ,"fill", [Heat Fill C9]
        ,"ink", [Heat Ink C9]
    )
VAR _l10_lo      = MINX ( _l10, [v] )
VAR _l10_hi      = MAXX ( _l10, [v] )
VAR _p9_cells    = FILTER ( _p9, NOT ISBLANK ( [v] ) )
VAR _p9_lo       = MINX ( _p9_cells, [v] )
VAR _p9_hi       = MAXX ( _p9_cells, [v] )
VAR _c9_cells    = FILTER ( _c9, NOT ISBLANK ( [v] ) )
VAR _c9_lo       = MINX ( _c9_cells, [v] )
VAR _c9_hi       = MAXX ( _c9_cells, [v] )
RETURN
    UNION (
        SELECTCOLUMNS (
            _l10
            ,"check", "l10 " & dim_product[product_name] & " " & dim_market[market_name]
            ,"actual", FORMAT ( [lvl], "0.000000" ) & " " & [fill] & " " & [ink]
            ,"expected", FORMAT ( DIVIDE ( [v] - _l10_lo, _l10_hi - _l10_lo ), "0.000000" )
            ,"_pass",
                ABS ( [lvl] - DIVIDE ( [v] - _l10_lo, _l10_hi - _l10_lo ) ) <= 0.000001
                    && [ink] = IF ( [lvl] >= 0.8, "#FFFFFF", "#111111" )
                    && ( [lvl] <> 0 || [fill] = "#DEDDD8" )
                    && ( [lvl] <> 1 || [fill] = "#C0392B" )
        )
        ,SELECTCOLUMNS (
            _p9_cells
            ,"check", "p9 " & dim_product[product_name] & " " & dim_market[market_name]
            ,"actual", FORMAT ( [lvl], "0.000000" ) & " " & [fill] & " " & [ink]
            ,"expected", FORMAT ( DIVIDE ( [v] - _p9_lo, _p9_hi - _p9_lo ), "0.000000" )
            ,"_pass",
                ABS ( [lvl] - DIVIDE ( [v] - _p9_lo, _p9_hi - _p9_lo ) ) <= 0.000001
                    && [ink] = IF ( [lvl] >= 0.8, "#FFFFFF", "#111111" )
                    && ( [lvl] <> 0 || [fill] = "#DEDDD8" )
                    && ( [lvl] <> 1 || [fill] = "#C0392B" )
        )
        ,SELECTCOLUMNS (
            _c9_cells
            ,"check", "c9 " & param_cohort_quarter[quarter_label] & " " & param_cohort_day[days] & " d"
            ,"actual", FORMAT ( [lvl], "0.000000" ) & " " & [fill] & " " & [ink]
            ,"expected", FORMAT ( DIVIDE ( [v] - _c9_lo, _c9_hi - _c9_lo ), "0.000000" )
            ,"_pass",
                ABS ( [lvl] - DIVIDE ( [v] - _c9_lo, _c9_hi - _c9_lo ) ) <= 0.000001
                    && [ink] = IF ( [lvl] >= 0.8, "#FFFFFF", "#111111" )
        )
        ,{
            ( "l10.ends", MINX ( _l10, [lvl] ) & " / " & MAXX ( _l10, [lvl] ), "0 / 1", MINX ( _l10, [lvl] ) = 0 && MAXX ( _l10, [lvl] ) = 1 )
            ,( "p9.ends", MINX ( _p9_cells, [lvl] ) & " / " & MAXX ( _p9_cells, [lvl] ), "0 / 1", MINX ( _p9_cells, [lvl] ) = 0 && MAXX ( _p9_cells, [lvl] ) = 1 )
            ,( "c9.rows", CONCATENATEX ( DISTINCT ( SELECTCOLUMNS ( _c9_cells, "q", param_cohort_quarter[quarter_label], "i", param_cohort_quarter[quarter_index] ) ), [q], ", ", [i], ASC ), "Q4 2025, Q1 2026, Q2 2026, Q3 2026", CONCATENATEX ( DISTINCT ( SELECTCOLUMNS ( _c9_cells, "q", param_cohort_quarter[quarter_label], "i", param_cohort_quarter[quarter_index] ) ), [q], ", ", [i], ASC ) = "Q4 2025, Q1 2026, Q2 2026, Q3 2026" )
            ,( "c9.first_day", MINX ( _c9_cells, param_cohort_day[days] ) & "", "45", MINX ( _c9_cells, param_cohort_day[days] ) = 45 )
            ,( "c9.q3_censored", MAXX ( FILTER ( _c9_cells, param_cohort_quarter[quarter_label] = "Q3 2026" ), param_cohort_day[days] ) & "", "60", MAXX ( FILTER ( _c9_cells, param_cohort_quarter[quarter_label] = "Q3 2026" ), param_cohort_day[days] ) = 60 )
            ,( "c9.ends", MINX ( _c9_cells, [lvl] ) & " / " & MAXX ( _c9_cells, [lvl] ), "0 / 1", MINX ( _c9_cells, [lvl] ) = 0 && MAXX ( _c9_cells, [lvl] ) = 1 )
        }
    )

// T-M8i every drill list holds the full facts (change 30): the row count of each list equals its source figure.
//       Partner new clients Sep 2026 / All = 2,846 (C11 list window); loans 30+ DPD with a balance at the last close = 4,782
//       (P13 list window, all products); Sep 2026 YTD loans = 209,898 (loan_detail table rows, Jan-Sep 2026); list titles (6 rows)
EVALUATE
VAR _partner     =
    CALCULATE (
        COUNTROWS ( FILTER ( VALUES ( dim_client[client_id] ), [New Clients] > 0 ) )
        ,dim_channel[channel_name] = "Partner"
    )
VAR _overdue     =
    CALCULATE (
        COUNTROWS ( FILTER ( VALUES ( fact_loan[loan_id] ), [Overdue Outstanding EUR] > 0 ) )
        ,dim_loan_status[status_code] IN { "DPD_30_59", "DPD_60_89", "DPD_90P" }
    )
VAR _ytd         =
    CALCULATE (
        COUNTROWS ( FILTER ( VALUES ( fact_loan[loan_id] ), NOT ISBLANK ( [Loan In Window EUR] ) ) )
        ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-01" && param_anchor_month[month_key] <= "2026-09" )
    )
VAR _title_c     = CALCULATE ( [Title Clients List], dim_channel[channel_name] = "Partner" )
VAR _title_o     = [Title Overdue List]
RETURN
    SELECTCOLUMNS (
        {
            ( "list.partner_clients", _partner & "", "2846", _partner = 2846 )
            ,( "list.overdue_30p", _overdue & "", "4782", _overdue = 4782 && [Overdue Loans 30+] = 4782 )
            ,( "list.ytd_loans", _ytd & "", "209898", _ytd = 209898 )
            ,( "title.clients", _title_c, "2,846 new clients - Partner - All markets - Sep 2026", _title_c = "2,846 new clients - Partner - All markets - Sep 2026" )
            ,( "title.overdue", _title_o, "4,782 loans 30+ DPD - All products - All markets - Sep 2026", _title_o = "4,782 loans 30+ DPD - All products - All markets - Sep 2026" )
            ,( "title.c11", [Title Clients Table], "Acquisition by channel - Sep 2026 - All markets", [Title Clients Table] = "Acquisition by channel - Sep 2026 - All markets" )
        }
        ,"check", [Value1]
        ,"actual", [Value2]
        ,"expected", [Value3]
        ,"_pass", [Value4]
    )

// T-M8j leaderboard Status sorts by a number (change 33; words and ranks as Track C 2026-11-02): Agent Status Rank rounds to
//       3 / 2 / 1 / 0 for On target / Close / Behind / n/a (Track C STATUS_RANK; the format string shows the word); P12 bubbles (change 17): one yellow bubble (the worst 30+ DPD product),
//       the card's own market pick overrides the page region; no measure in an error state (5 rows + one per agent)
EVALUATE
VAR _agents      =
    ADDCOLUMNS (
        FILTER ( VALUES ( dim_agent[agent_code] ), [_Agent Row] )
        ,"rank", [Agent Status Rank]
        ,"word", [Agent Status]
    )
VAR _p12         =
    SUMMARIZECOLUMNS (
        dim_product[product_name]
        ,TREATAS ( { "Microloan" }, dim_product[product_line] )
        ,"y", [P12 DPD30 %]
        ,"fill", [P12 Bubble Fill]
    )
VAR _p12_ro      =
    CALCULATETABLE (
        ADDCOLUMNS (
            CALCULATETABLE ( VALUES ( dim_product[product_name] ), dim_product[product_line] = "Microloan" )
            ,"y", [P12 DPD30 %]
            ,"y_page", CALCULATE ( [DPD30 %], TREATAS ( { "RO" }, param_market[market_code] ) )
        )
        ,TREATAS ( { "RO" }, param_p12_market[market_code] )
    )
VAR _errors      = COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) )
RETURN
    UNION (
        SELECTCOLUMNS ( _agents, "check", "l13.status " & dim_agent[agent_code], "actual", FORMAT ( ROUND ( [rank], 0 ), "0" ), "expected", [word], "_pass", ROUND ( [rank], 0 ) = SWITCH ( [word], "On target", 3, "Close", 2, "Behind", 1, "n/a", 0, -9 ) )
        ,{
            ( "p12.yellow", COUNTROWS ( FILTER ( _p12, [fill] = "#FFD54A" ) ) & "", "1", COUNTROWS ( FILTER ( _p12, [fill] = "#FFD54A" ) ) = 1 )
            ,( "p12.worst", MAXX ( FILTER ( _p12, [fill] = "#FFD54A" ), [y] ) & "", MAXX ( _p12, [y] ) & "", MAXX ( FILTER ( _p12, [fill] = "#FFD54A" ), [y] ) = MAXX ( _p12, [y] ) )
            ,( "p12.ro_pick", COUNTROWS ( FILTER ( _p12_ro, ABS ( [y] - [y_page] ) > 0.0000001 ) ) & "", "0", COUNTROWS ( FILTER ( _p12_ro, ABS ( [y] - [y_page] ) > 0.0000001 ) ) = 0 )
            ,( "c10.avg", FORMAT ( [Repeat Share Avg], "0.000000" ), FORMAT ( [Repeat Share], "0.000000" ), [Repeat Share Avg] = [Repeat Share] )
            ,( "model.errors", _errors & "", "0", _errors = 0 )
        }
    )

// T-M9a Power BI = JS (fix-up 2026-11-02), M-2026-09-ALL: every cell of the five tables (O9, L13, C11, P13, R13) as text, the table titles, the L13 default order
//       and the filter / Showing lines, expected strings from the Track C engine (js-report/lib/sales, view-model dumped 2026-11-02);
