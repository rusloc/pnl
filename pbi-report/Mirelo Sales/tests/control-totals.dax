            ,{ "R12", "Channel mix, share of loans", "" }
            ,{ "R13", "Stream × market - Sep 2026", "" }
        }
    )
RETURN
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"actual_title", VAR _c = [code] RETURN CALCULATE ( [Card Info Title], dim_card[card_code] = _c )
            ,"actual_note", VAR _c = [code] RETURN CALCULATE ( [Card Info Note] & "", dim_card[card_code] = _c )
            ,"_pass", VAR _c = [code] RETURN CALCULATE ( [Card Info Title], dim_card[card_code] = _c ) = [title] && CALCULATE ( [Card Info Note] & "", dim_card[card_code] = _c ) = [note]
        )
        ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" )
        ,TREATAS ( { "ALL" }, param_market[market_code] )
        ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
    )

