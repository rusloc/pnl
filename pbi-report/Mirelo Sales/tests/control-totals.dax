        }
    )
VAR _actual       =
    ADDCOLUMNS (
        _expected
        ,"actual",
            VAR _metric       = [metric]
            RETURN
                CALCULATE (
                    SWITCH (
                        _metric
                        ,"loans_count"
                            ,[Loans]
                        ,"principal_eur"
                            ,[Principal EUR]
                        ,"new_clients"
                            ,[New Clients]
                        ,"borrowers"
                            ,[Borrowers]
                        ,"returning_clients"
                            ,[Returning Clients]
                        ,"returning_pct_clients"
                            ,[Returning %]
                        ,"returning_pct_loans"
                            ,[Repeat Share]
                        ,"outstanding_eur"
                            ,[Outstanding EUR]
                        ,"dpd30_balance_eur"
                            ,[DPD30 Balance EUR]
                        ,"dpd30_pct"
                            ,[DPD30 %]
                        ,"dpd90_pct"
                            ,[DPD90 %]
                        ,"revenue_eur"
                            ,[Revenue EUR]
                        ,"revenue_interest_eur"
                            ,[Interest EUR]
                        ,"revenue_fee_eur"
                            ,[Fees EUR]
                        ,"revenue_interchange_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "INTERCHANGE" )
                        ,"revenue_subscription_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "SUBSCRIPTION" )
                    )
                    ,TREATAS ( { [anchor] }, param_anchor_month[month_key] )
                    ,TREATAS ( { [period] }, param_period[period_code] )
                    ,TREATAS ( { [market] }, param_market[market_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"diff", [actual] - [expected]
        ,"_pass",
            VAR _tolerance    =
                SWITCH (
                    TRUE ()
                    ,RIGHT ( [metric], 4 ) = "_eur"
                        ,0.011
                    ,RIGHT ( [metric], 4 ) = "_pct"
                        || [metric] IN { "returning_pct_clients", "returning_pct_loans" }
                        ,0.000001
                    ,0.5
                )
            RETURN
                ABS ( [actual] - [expected] ) <= _tolerance
    )
ORDER BY
    [_pass]
    ,[window]
    ,[market]
    ,[metric]

// T-M3 period windows = sum of the monthly control values (192 rows); the expected value adds cent-rounded months, so the EUR tolerance is 0.005 per month in the window
EVALUATE
