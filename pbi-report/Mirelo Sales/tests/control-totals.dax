            ,{ "PT", "R12M 2026-09", "2026-09", "R12M", "new_clients", 32164.0 }
            ,{ "PT", "R12M 2026-09", "2026-09", "R12M", "revenue_eur", 5148621.85 }
        }
    )
VAR _actual       =
    ADDCOLUMNS (
        _expected
        ,"actual",
            VAR _metric       = [metric]
            RETURN
                CALCULATE (
                    SWITCH (
                        _metric
                        ,"loans_count"
                            ,[Loans]
                        ,"principal_eur"
                            ,[Principal EUR]
                        ,"new_clients"
                            ,[New Clients]
                        ,"borrowers"
                            ,[Borrowers]
                        ,"returning_clients"
                            ,[Returning Clients]
                        ,"returning_pct_clients"
                            ,[Returning %]
                        ,"returning_pct_loans"
                            ,[Repeat Share]
                        ,"outstanding_eur"
                            ,[Outstanding EUR]
                        ,"dpd30_balance_eur"
                            ,[DPD30 Balance EUR]
                        ,"dpd30_pct"
                            ,[DPD30 %]
                        ,"dpd90_pct"
                            ,[DPD90 %]
                        ,"revenue_eur"
                            ,[Revenue EUR]
                        ,"revenue_interest_eur"
                            ,[Interest EUR]
                        ,"revenue_fee_eur"
                            ,[Fees EUR]
                        ,"revenue_interchange_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "INTERCHANGE" )
                        ,"revenue_subscription_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "SUBSCRIPTION" )
                    )
                    ,TREATAS ( { [anchor] }, param_anchor_month[month_key] )
                    ,TREATAS ( { [period] }, param_period[period_code] )
                    ,TREATAS ( { [market] }, param_market[market_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"diff", [actual] - [expected]
        ,"_pass",
            VAR _tolerance    =
                SWITCH (
                    TRUE ()
                    ,RIGHT ( [metric], 4 ) = "_eur"
                        ,0.005 * SWITCH ( [period], "QTD", 3, "YTD", 12, 12 ) + 0.001
                    ,RIGHT ( [metric], 4 ) = "_pct"
                        || [metric] IN { "returning_pct_clients", "returning_pct_loans" }
                        ,0.000001
                    ,0.5
                )
            RETURN
                ABS ( [actual] - [expected] ) <= _tolerance
    )
ORDER BY
    [_pass]
    ,[window]
    ,[market]
    ,[metric]

// T-M4 bridge identity (steps add up to actual principal) and README rule 2 (new clients = dim_client first loans in the window)
EVALUATE
VAR _cases        =
    DATATABLE (
        "anchor", STRING
        ,"period", STRING
        ,"market", STRING
        ,{
            { "2026-09", "MONTH", "ALL" }
            ,{ "2026-09", "YTD", "ALL" }
            ,{ "2026-09", "YTD", "PL" }
            ,{ "2026-09", "YTD", "RO" }
            ,{ "2026-09", "YTD", "PT" }
            ,{ "2025-12", "YTD", "ALL" }
            ,{ "2026-06", "QTD", "RO" }
            ,{ "2026-09", "R12M", "ALL" }
        }
    )
VAR _rows         =
    ADDCOLUMNS (
        _cases
        ,"bridge_sum",
            CALCULATE (
                SUMX ( VALUES ( dim_bridge_step[step_code] ), [Bridge Value] )
                ,TREATAS ( { [anchor] }, param_anchor_month[month_key] )
                ,TREATAS ( { [period] }, param_period[period_code] )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"principal",
            CALCULATE (
                [Principal EUR]
                ,TREATAS ( { [anchor] }, param_anchor_month[month_key] )
                ,TREATAS ( { [period] }, param_period[period_code] )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"new_clients",
            CALCULATE (
                [New Clients]
                ,TREATAS ( { [anchor] }, param_anchor_month[month_key] )
                ,TREATAS ( { [period] }, param_period[period_code] )
                ,TREATAS ( { [market] }, param_market[market_code] )
            )
        ,"clients_rule2",
            VAR _market       = [market]
            VAR _anchor       = LOOKUPVALUE ( dim_month[month_index], dim_month[month_key], [anchor] )
            VAR _month_num    = MOD ( _anchor - 1, 12 ) + 1
            VAR _start        =
                SWITCH (
                    [period]
                    ,"QTD"
                        ,_anchor - MOD ( _month_num - 1, 3 )
                    ,"YTD"
                        ,_anchor - _month_num + 1
                    ,"R12M"
                        ,_anchor - 11
                    ,_anchor
                )
            RETURN
                CALCULATE (
                    COUNTROWS ( dim_client )
                    ,dim_client[cohort_month_index] >= _start
                        && dim_client[cohort_month_index] <= _anchor
                    ,FILTER (
                        ALL ( dim_client[market_code] )
                        ,_market = "ALL"
                            || dim_client[market_code] = _market
                    )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            ABS ( [bridge_sum] - [principal] ) <= 0.01
                && [new_clients] = [clients_rule2]
    )

// T-M5 smoke: every card SVG is an svg data URI, the 13-month trend has 13 points (default and RO / YTD / PY)
EVALUATE
VAR _cases        =
    DATATABLE (
        "card", STRING
        ,"state", STRING
        ,{
            { "O1", "default" }
            ,{ "O2", "default" }
            ,{ "O3", "default" }
            ,{ "O4", "default" }
            ,{ "L1", "default" }
            ,{ "L2", "default" }
            ,{ "L3", "default" }
            ,{ "L4", "default" }
            ,{ "L5", "default" }
            ,{ "L6", "default" }
            ,{ "C1", "default" }
            ,{ "C2", "default" }
            ,{ "C3", "default" }
            ,{ "C4", "default" }
            ,{ "C5", "default" }
            ,{ "C6", "default" }
            ,{ "P1", "default" }
            ,{ "P2", "default" }
            ,{ "P3", "default" }
            ,{ "P4", "default" }
            ,{ "P5", "default" }
            ,{ "P6", "default" }
            ,{ "R1", "default" }
            ,{ "R2", "default" }
            ,{ "R3", "default" }
            ,{ "R4", "default" }
            ,{ "R5", "default" }
            ,{ "R6", "default" }
            ,{ "O1", "RO_YTD_PY" }
            ,{ "O2", "RO_YTD_PY" }
            ,{ "O3", "RO_YTD_PY" }
            ,{ "O4", "RO_YTD_PY" }
            ,{ "L1", "RO_YTD_PY" }
            ,{ "L2", "RO_YTD_PY" }
            ,{ "L3", "RO_YTD_PY" }
            ,{ "L4", "RO_YTD_PY" }
            ,{ "L5", "RO_YTD_PY" }
            ,{ "L6", "RO_YTD_PY" }
            ,{ "C1", "RO_YTD_PY" }
            ,{ "C2", "RO_YTD_PY" }
            ,{ "C3", "RO_YTD_PY" }
            ,{ "C4", "RO_YTD_PY" }
            ,{ "C5", "RO_YTD_PY" }
            ,{ "C6", "RO_YTD_PY" }
            ,{ "P1", "RO_YTD_PY" }
            ,{ "P2", "RO_YTD_PY" }
            ,{ "P3", "RO_YTD_PY" }
            ,{ "P4", "RO_YTD_PY" }
            ,{ "P5", "RO_YTD_PY" }
            ,{ "P6", "RO_YTD_PY" }
            ,{ "R1", "RO_YTD_PY" }
            ,{ "R2", "RO_YTD_PY" }
            ,{ "R3", "RO_YTD_PY" }
            ,{ "R4", "RO_YTD_PY" }
            ,{ "R5", "RO_YTD_PY" }
            ,{ "R6", "RO_YTD_PY" }
        }
    )
VAR _rows         =
    ADDCOLUMNS (
        _cases
        ,"uri_start",
            VAR _card         = [card]
            VAR _ro           = [state] = "RO_YTD_PY"
            RETURN
                CALCULATE (
                    LEFT (
                        SWITCH (
                            _card
                            ,"O1"
                                ,[Card O1 SVG]
                            ,"O2"
                                ,[Card O2 SVG]
                            ,"O3"
                                ,[Card O3 SVG]
                            ,"O4"
                                ,[Card O4 SVG]
                            ,"L1"
                                ,[Card L1 SVG]
                            ,"L2"
                                ,[Card L2 SVG]
                            ,"L3"
                                ,[Card L3 SVG]
                            ,"L4"
                                ,[Card L4 SVG]
                            ,"L5"
                                ,[Card L5 SVG]
                            ,"L6"
                                ,[Card L6 SVG]
                            ,"C1"
                                ,[Card C1 SVG]
                            ,"C2"
                                ,[Card C2 SVG]
                            ,"C3"
                                ,[Card C3 SVG]
                            ,"C4"
                                ,[Card C4 SVG]
                            ,"C5"
                                ,[Card C5 SVG]
                            ,"C6"
                                ,[Card C6 SVG]
                            ,"P1"
                                ,[Card P1 SVG]
                            ,"P2"
                                ,[Card P2 SVG]
                            ,"P3"
                                ,[Card P3 SVG]
                            ,"P4"
                                ,[Card P4 SVG]
                            ,"P5"
                                ,[Card P5 SVG]
                            ,"P6"
                                ,[Card P6 SVG]
                            ,"R1"
                                ,[Card R1 SVG]
                            ,"R2"
                                ,[Card R2 SVG]
                            ,"R3"
                                ,[Card R3 SVG]
                            ,"R4"
                                ,[Card R4 SVG]
                            ,"R5"
                                ,[Card R5 SVG]
                            ,"R6"
                                ,[Card R6 SVG]
                        )
                        ,26
                    )
                    ,TREATAS ( { IF ( _ro, "RO", "ALL" ) }, param_market[market_code] )
                    ,TREATAS ( { IF ( _ro, "YTD", "MONTH" ) }, param_period[period_code] )
                    ,TREATAS ( { IF ( _ro, "PY", "BUD" ) }, param_comparator[comparator_code] )
                )
        ,"trend_points",
            VAR _ro           = [state] = "RO_YTD_PY"
            RETURN
                CALCULATE (
                    COUNTROWS ( FILTER ( VALUES ( dim_month[month_index] ), NOT ISBLANK ( [Loans Trend] ) ) )
                    ,TREATAS ( { IF ( _ro, "RO", "ALL" ) }, param_market[market_code] )
                    ,TREATAS ( { IF ( _ro, "YTD", "MONTH" ) }, param_period[period_code] )
                    ,TREATAS ( { IF ( _ro, "PY", "BUD" ) }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_pass",
            [uri_start] = "data:image/svg+xml;utf8,<s"
                && [trend_points] = 13
    )
