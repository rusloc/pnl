                            ,"r5.chip"
                                ,PATHITEM ( [_Card R5 Parts], 5 )
                            ,"r5.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R5" )
                            ,"r5.row"
                                ,PATHITEM ( [_Card R5 Parts], 4 )
                            ,"r5.row_cmp"
                                ,PATHITEM ( [_Card R5 Parts], 2 )
                            ,"r5.value_text"
                                ,PATHITEM ( [_Card R5 Parts], 1 )
                            ,"r6.chip"
                                ,PATHITEM ( [_Card R6 Parts], 5 )
                            ,"r6.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R6" )
                            ,"r6.row"
                                ,PATHITEM ( [_Card R6 Parts], 4 )
                            ,"r6.row_cmp"
                                ,PATHITEM ( [_Card R6 Parts], 2 )
                            ,"r6.value_text"
                                ,PATHITEM ( [_Card R6 Parts], 1 )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( "2025-12", 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( "2025-12", 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = "YTD"
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { "PL" }, param_market[market_code] )
                    ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"_test", "T-P M-FY2025-PL"
        ,"_pass",
            IF (
                [kind] IN { "amount", "ratio", "count" }
                ,ABS ( VALUE ( [actual] ) - VALUE ( [expected] ) ) <= [tol]
                ,[actual] = [expected]
            )
    )

