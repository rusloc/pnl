            ,{ "c9|Q2 2026|120 d", "38%|#E06F29|#111111" }
            ,{ "c9|Q2 2026|135 d", "41%|#D55B2A|#FFFFFF" }
            ,{ "c9|Q2 2026|150 d", "42%|#CC4D2A|#FFFFFF" }
