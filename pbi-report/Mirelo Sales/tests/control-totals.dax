            ,{ "P1", "30+ DPD %", "Month-end: Sep 2026; 30+ DPD balance: €1.5m; Outstanding: €32.5m; Planned (Budget): 4.2%" }
            ,{ "P2", "90+ DPD %", "90+ DPD balance: €853k" }
            ,{ "P3", "30+ by count", "Loans 30+ DPD: 4,782; Active loans: 104.9k" }
            ,{ "P4", "Vintage 6m bad rate", "Vintage: Mar 2026; Same vintage a year earlier: 3.4%" }
            ,{ "P5", "Roll rate 30→60", "1–29 → 30+: 65.5%" }
