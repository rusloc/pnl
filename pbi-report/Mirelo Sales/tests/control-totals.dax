                            ,"r6.row"
                                ,PATHITEM ( [_Card R6 Parts], 4 )
                            ,"r6.row_cmp"
                                ,PATHITEM ( [_Card R6 Parts], 2 )
                            ,"r6.value_text"
                                ,PATHITEM ( [_Card R6 Parts], 1 )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( "2026-09", 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( "2026-09", 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = "MONTH"
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { "ALL" }, param_market[market_code] )
                    ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"_test", "T-P M-2026-09-ALL"
        ,"_pass",
            IF (
                [kind] IN { "amount", "ratio", "count" }
                ,ABS ( VALUE ( [actual] ) - VALUE ( [expected] ) ) <= [tol]
                ,[actual] = [expected]
            )
    )

