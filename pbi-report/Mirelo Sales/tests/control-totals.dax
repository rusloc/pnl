                        ,"new_clients"
                            ,[New Clients]
                        ,"borrowers"
                            ,[Borrowers]
                        ,"returning_clients"
                            ,[Returning Clients]
                        ,"returning_pct_clients"
                            ,[Returning %]
                        ,"returning_pct_loans"
                            ,[Repeat Share]
                        ,"outstanding_eur"
                            ,[Outstanding EUR]
                        ,"dpd30_balance_eur"
                            ,[DPD30 Balance EUR]
                        ,"dpd30_pct"
                            ,[DPD30 %]
                        ,"dpd90_pct"
                            ,[DPD90 %]
                        ,"revenue_eur"
                            ,[Revenue EUR]
                        ,"revenue_interest_eur"
                            ,[Interest EUR]
                        ,"revenue_fee_eur"
                            ,[Fees EUR]
                        ,"revenue_interchange_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "INTERCHANGE" )
                        ,"revenue_subscription_eur"
                            ,CALCULATE ( [Revenue EUR], dim_revenue_type[revenue_type_code] = "SUBSCRIPTION" )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( [anchor], 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( [anchor], 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = [period]
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { [market] }, param_market[market_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"diff", [actual] - [expected]
        ,"_pass",
            VAR _tolerance    =
                SWITCH (
                    TRUE ()
                    ,RIGHT ( [metric], 4 ) = "_eur"
                        ,0.011
                    ,RIGHT ( [metric], 4 ) = "_pct"
                        || [metric] IN { "returning_pct_clients", "returning_pct_loans" }
                        ,0.000001
                    ,0.5
                )
            RETURN
                ABS ( [actual] - [expected] ) <= _tolerance
    )
ORDER BY
    [_pass]
    ,[window]
    ,[market]
    ,[metric]

// T-M2 every closed month (2112 rows)
EVALUATE
