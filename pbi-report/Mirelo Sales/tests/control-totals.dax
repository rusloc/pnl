        NATURALLEFTOUTERJOIN (
            _expected
            ,SELECTCOLUMNS ( _cells, "check", [chart] & "|" & [row] & "|" & [col], "actual", [v] & "|" & [f] & "|" & [i] )
        )
        ,"_pass", [actual] = [expected]
    )

