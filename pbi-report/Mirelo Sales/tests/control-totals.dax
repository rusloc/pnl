            ,{ "c9|Q3 2026|60 d", "23%|#F7D76D|#111111" }
        }
    )
VAR _cells       =
    CALCULATETABLE (
        UNION (
            SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    dim_product[product_name]
                    ,dim_market[market_name]
                    ,TREATAS ( { "Microloan" }, dim_product[product_line] )
                    ,"v", [Loans Heat Cell]
                    ,"lv", [Heat Level L10]
                    ,"f", [Heat Fill L10]
                    ,"i", [Heat Ink L10]
                )
                ,"chart", "l10", "row", dim_product[product_name], "col", dim_market[market_name], "v", IF ( [v] >= 9999.5, FORMAT ( [v] / 1000, "#,0.0" ) & "k", FORMAT ( [v], "#,0" ) ), "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
            ,SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    dim_product[product_name]
                    ,dim_market[market_name]
                    ,TREATAS ( { "Microloan" }, dim_product[product_line] )
                    ,"v", IF ( ISBLANK ( [DPD30 %] ), IF ( NOT ISBLANK ( [P9 Cell] ), "n/a" ), FORMAT ( [DPD30 %], "0.0%" ) )
                    ,"lv", [Heat Level P9]
                    ,"f", [Heat Fill P9]
                    ,"i", [Heat Ink P9]
                )
                ,"chart", "p9", "row", dim_product[product_name], "col", dim_market[market_name], "v", [v], "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
            ,SELECTCOLUMNS (
                SUMMARIZECOLUMNS (
                    param_cohort_quarter[quarter_label]
                    ,param_cohort_day[day_label]
                    ,"v", [Cohort Heat %]
                    ,"lv", [Heat Level C9]
                    ,"f", [Heat Fill C9]
                    ,"i", [Heat Ink C9]
                )
                ,"chart", "c9", "row", param_cohort_quarter[quarter_label], "col", param_cohort_day[day_label], "v", FORMAT ( [v], "0%" ), "lv", FORMAT ( [lv], "0.000000000" ), "f", [f], "i", [i]
            )
        )
        ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" )
        ,TREATAS ( { "ALL" }, param_market[market_code] )
        ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
    )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN (
            _expected
            ,SELECTCOLUMNS ( _cells, "check", [chart] & "|" & [row] & "|" & [col], "actual", [v] & "|" & [f] & "|" & [i] )
        )
        ,"_pass", [actual] = [expected]
    )

