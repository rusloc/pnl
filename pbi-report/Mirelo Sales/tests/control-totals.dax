            ,{ "P10", "30+ DPD by market", "" }
            ,{ "P11", "Roll rates by month", "" }
            ,{ "P12", "Segments: size × DPD", "" }
            ,{ "P13", "Overdue by product - Sep 2026 - All markets", "" }
            ,{ "R1", "Revenue", "Interest: €787k - 59%; Fees: €286k - 21%; Interchange: €122k; Subscriptions: €146k; Budget: €1.4m" }
            ,{ "R2", "Attainment", "Revenue: €1.3m; Budget: €1.4m" }
            ,{ "R3", "Interest + fees", "Interest: €787k; Fees: €286k; Budget: €1.1m; Prior year: €848k" }
            ,{ "R4", "Interchange", "Budget: €117k; Prior year: €75k" }
