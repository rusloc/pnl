                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "L5" )
                            ,"l5.row"
                                ,PATHITEM ( [_Card L5 Parts], 4 )
                            ,"l5.row_cmp"
                                ,PATHITEM ( [_Card L5 Parts], 2 )
                            ,"l5.value_text"
                                ,PATHITEM ( [_Card L5 Parts], 1 )
                            ,"l6.chip"
                                ,PATHITEM ( [_Card L6 Parts], 5 )
                            ,"l6.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "L6" )
                            ,"l6.row"
                                ,PATHITEM ( [_Card L6 Parts], 4 )
                            ,"l6.row_cmp"
                                ,PATHITEM ( [_Card L6 Parts], 2 )
                            ,"l6.value_text"
                                ,PATHITEM ( [_Card L6 Parts], 1 )
                            ,"o1.chip"
                                ,PATHITEM ( [_Card O1 Parts], 5 )
                            ,"o1.row_budget"
                                ,"vs Budget: " & PATHITEM ( [_Card O1 Parts], 3 )
                            ,"o1.row_py"
                                ,"vs Prior year: " & PATHITEM ( [_Card O1 Parts], 4 )
                            ,"o1.value_text"
                                ,PATHITEM ( [_Card O1 Parts], 1 ) & IF ( PATHITEM ( [_Card O1 Parts], 2 ) <> "", " " & PATHITEM ( [_Card O1 Parts], 2 ) )
                            ,"o2.chip"
                                ,PATHITEM ( [_Card O2 Parts], 5 )
                            ,"o2.row_budget"
                                ,"vs Budget: " & PATHITEM ( [_Card O2 Parts], 3 )
                            ,"o2.row_py"
                                ,"vs Prior year: " & PATHITEM ( [_Card O2 Parts], 4 )
                            ,"o2.value_text"
                                ,PATHITEM ( [_Card O2 Parts], 1 ) & IF ( PATHITEM ( [_Card O2 Parts], 2 ) <> "", " " & PATHITEM ( [_Card O2 Parts], 2 ) )
                            ,"o3.chip"
                                ,PATHITEM ( [_Card O3 Parts], 5 )
                            ,"o3.row_budget"
                                ,"vs Budget: " & PATHITEM ( [_Card O3 Parts], 3 )
                            ,"o3.row_py"
                                ,"vs Prior year: " & PATHITEM ( [_Card O3 Parts], 4 )
                            ,"o3.value_text"
                                ,PATHITEM ( [_Card O3 Parts], 1 ) & IF ( PATHITEM ( [_Card O3 Parts], 2 ) <> "", " " & PATHITEM ( [_Card O3 Parts], 2 ) )
                            ,"o4.chip"
                                ,PATHITEM ( [_Card O4 Parts], 5 )
                            ,"o4.row_budget"
                                ,"vs Budget: " & PATHITEM ( [_Card O4 Parts], 3 )
                            ,"o4.row_py"
                                ,"vs Prior year: " & PATHITEM ( [_Card O4 Parts], 4 )
                            ,"o4.value_text"
                                ,PATHITEM ( [_Card O4 Parts], 1 ) & IF ( PATHITEM ( [_Card O4 Parts], 2 ) <> "", " " & PATHITEM ( [_Card O4 Parts], 2 ) )
                            ,"p1.chip"
                                ,PATHITEM ( [_Card P1 Parts], 5 )
                            ,"p1.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P1" )
                            ,"p1.row"
                                ,PATHITEM ( [_Card P1 Parts], 4 )
                            ,"p1.row_cmp"
                                ,PATHITEM ( [_Card P1 Parts], 2 )
                            ,"p1.value_text"
                                ,PATHITEM ( [_Card P1 Parts], 1 )
                            ,"p2.chip"
                                ,PATHITEM ( [_Card P2 Parts], 5 )
                            ,"p2.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P2" )
                            ,"p2.row"
                                ,PATHITEM ( [_Card P2 Parts], 4 )
                            ,"p2.row_cmp"
                                ,PATHITEM ( [_Card P2 Parts], 2 )
                            ,"p2.value_text"
                                ,PATHITEM ( [_Card P2 Parts], 1 )
                            ,"p3.chip"
                                ,PATHITEM ( [_Card P3 Parts], 5 )
                            ,"p3.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P3" )
                            ,"p3.row"
                                ,PATHITEM ( [_Card P3 Parts], 4 )
                            ,"p3.row_cmp"
                                ,PATHITEM ( [_Card P3 Parts], 2 )
                            ,"p3.value_text"
                                ,PATHITEM ( [_Card P3 Parts], 1 )
                            ,"p4.chip"
                                ,PATHITEM ( [_Card P4 Parts], 5 )
                            ,"p4.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P4" )
                            ,"p4.row"
                                ,PATHITEM ( [_Card P4 Parts], 4 )
                            ,"p4.row_cmp"
                                ,PATHITEM ( [_Card P4 Parts], 2 )
                            ,"p4.value_text"
                                ,PATHITEM ( [_Card P4 Parts], 1 )
                            ,"p5.chip"
                                ,PATHITEM ( [_Card P5 Parts], 5 )
                            ,"p5.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P5" )
                            ,"p5.row"
                                ,PATHITEM ( [_Card P5 Parts], 4 )
                            ,"p5.row_cmp"
                                ,PATHITEM ( [_Card P5 Parts], 2 )
                            ,"p5.value_text"
                                ,PATHITEM ( [_Card P5 Parts], 1 )
                            ,"p6.chip"
                                ,PATHITEM ( [_Card P6 Parts], 5 )
                            ,"p6.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "P6" )
                            ,"p6.row"
                                ,PATHITEM ( [_Card P6 Parts], 4 )
                            ,"p6.row_cmp"
                                ,PATHITEM ( [_Card P6 Parts], 2 )
                            ,"p6.value_text"
                                ,PATHITEM ( [_Card P6 Parts], 1 )
                            ,"r1.chip"
                                ,PATHITEM ( [_Card R1 Parts], 5 )
                            ,"r1.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R1" )
                            ,"r1.row"
                                ,PATHITEM ( [_Card R1 Parts], 4 )
                            ,"r1.row_cmp"
                                ,PATHITEM ( [_Card R1 Parts], 2 )
                            ,"r1.value_text"
                                ,PATHITEM ( [_Card R1 Parts], 1 )
                            ,"r2.chip"
                                ,PATHITEM ( [_Card R2 Parts], 5 )
                            ,"r2.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R2" )
                            ,"r2.row"
                                ,PATHITEM ( [_Card R2 Parts], 4 )
                            ,"r2.row_cmp"
                                ,PATHITEM ( [_Card R2 Parts], 2 )
                            ,"r2.value_text"
                                ,PATHITEM ( [_Card R2 Parts], 1 )
                            ,"r3.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R3" )
                            ,"r4.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R4" )
                            ,"r5.chip"
                                ,PATHITEM ( [_Card R5 Parts], 5 )
                            ,"r5.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R5" )
                            ,"r5.row"
                                ,PATHITEM ( [_Card R5 Parts], 4 )
                            ,"r5.row_cmp"
                                ,PATHITEM ( [_Card R5 Parts], 2 )
                            ,"r5.value_text"
                                ,PATHITEM ( [_Card R5 Parts], 1 )
                            ,"r6.chip"
                                ,PATHITEM ( [_Card R6 Parts], 5 )
                            ,"r6.label"
                                ,LOOKUPVALUE ( dim_card[card_label], dim_card[card_code], "R6" )
                            ,"r6.row"
                                ,PATHITEM ( [_Card R6 Parts], 4 )
                            ,"r6.row_cmp"
                                ,PATHITEM ( [_Card R6 Parts], 2 )
                            ,"r6.value_text"
                                ,PATHITEM ( [_Card R6 Parts], 1 )
                    )
                    ,FILTER (
                        ALL ( param_anchor_month )
                        ,VAR _w_anchor    = ( VALUE ( LEFT ( "2026-09", 4 ) ) - 2024 ) * 12 + VALUE ( RIGHT ( "2026-09", 2 ) )
                         VAR _w_moy       = MOD ( _w_anchor - 1, 12 ) + 1
                         VAR _w_period    = "MONTH"
                         VAR _w_start     =
                            SWITCH (
                                _w_period
                                ,"QTD"
                                    ,_w_anchor - MOD ( _w_moy - 1, 3 )
                                ,"YTD"
                                    ,_w_anchor - _w_moy + 1
                                ,"R12M"
                                    ,_w_anchor - 11
                                ,_w_anchor
                            )
                         RETURN
                            param_anchor_month[month_index] >= _w_start
                                && param_anchor_month[month_index] <= _w_anchor
                    )
                    ,TREATAS ( { "ALL" }, param_market[market_code] )
                    ,TREATAS ( { "PY" }, param_comparator[comparator_code] )
                )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"_test", "T-P M-2026-09-ALL-PY"
        ,"_pass",
            IF (
                [kind] IN { "amount", "ratio", "count" }
                ,ABS ( VALUE ( [actual] ) - VALUE ( [expected] ) ) <= [tol]
                ,[actual] = [expected]
            )
    )
