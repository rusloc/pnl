            ,{ "o3.row_py", "text", "vs Prior year: ▲ +9.1pp", 0 }
            ,{ "o3.chip", "status", "good", 0 }
            ,{ "o4.value_text", "text", "4.0%", 0 }
            ,{ "o4.row_budget", "text", "vs Budget: ▲ +0.2pp", 0 }
            ,{ "o4.row_py", "text", "vs Prior year: ▼ −0.6pp", 0 }
            ,{ "o4.chip", "status", "watch", 0 }
        }
    )
