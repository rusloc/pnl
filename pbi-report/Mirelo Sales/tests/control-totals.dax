    ADDCOLUMNS (
        _rows
        ,"actual",
            VAR _metric       = [metric]
            RETURN
                CALCULATE (
                    SWITCH (
                        _metric
                            ,"budget.dpd30_pct"
                                ,FORMAT ( [DPD30 Budget %], "0.000000000" )
                            ,"budget.loans"
                                ,FORMAT ( [Loans Budget], "0.000000000" )
                            ,"budget.new_clients"
                                ,FORMAT ( [New Clients Budget], "0.000000000" )
                            ,"budget.principal_eur"
                                ,FORMAT ( [Principal Budget EUR], "0.000000000" )
                            ,"budget.revenue_eur"
                                ,FORMAT ( [Revenue Budget EUR], "0.000000000" )
                            ,"c1.chip"
