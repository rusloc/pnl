VAR _actual      =
    CALCULATETABLE (
        UNION (
            SELECTCOLUMNS ( VALUES ( dim_market[market_code] ), "check", "o9." & dim_market[market_code], "actual", CALCULATE ( MIN ( dim_market[market_name] ) ) & "|" & [_T O9 Loans] & "|" & [_T O9 Δ] & "|" & [_T O9 Principal] & "|" & [_T O9 New Clients] & "|" & [_T O9 Returning %] & "|" & [_T O9 DPD30 %] & "|" & [Loans Status] )
            ,SELECTCOLUMNS ( FILTER ( VALUES ( dim_agent[agent_code] ), [_Agent Row] ), "check", "l13." & dim_agent[agent_code], "actual", CALCULATE ( MIN ( dim_agent[agent_name] ) ) & "|" & [Agent Type] & "|" & CALCULATE ( MIN ( dim_agent[market_code] ) ) & "|" & [_T Agent Loans Shown] & "|" & [_T Agent Quota Shown] & "|" & IF ( ISBLANK ( [Agent Attainment] ), "n/a", FORMAT ( [Agent Attainment] * 100, "#,0.0" ) & "%" ) & "|" & [_T Agent Principal Shown] & "|" & [_T Agent Δ Cmp %] & "|" & [Agent Status] & "|" & [Agent Tag] )
            ,SELECTCOLUMNS ( VALUES ( dim_channel[channel_code] ), "check", "c11." & dim_channel[channel_code], "actual", CALCULATE ( MIN ( dim_channel[channel_name] ) ) & "|" & [_T C11 New Clients] & "|" & [_T C11 Δ] & "|" & FORMAT ( [New Clients Share], "0.0%" ) & "|" & FORMAT ( [Lead to First Loan %], "0.0%" ) & "|" & FORMAT ( [New-client Approval Rate], "0.0%" ) & "|" & FORMAT ( [Returning-client Approval Rate], "0.0%" ) & "|" & FORMAT ( [Repeat Share], "0.0%" ) & "|" & FORMAT ( [First Ticket EUR], "€#,0" ) & "|" & [New Clients PY Status] )
            ,SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( dim_product[product_code] ), dim_product[product_line] = "Microloan" ), "check", "p13." & dim_product[product_code], "actual", CALCULATE ( MIN ( dim_product[product_name] ) ) & "|" & [_T P13 Active] & "|" & [_T P13 Outstanding] & "|" & [_T P13 Bal 1-29] & "|" & [_T P13 Bal 30-59] & "|" & [_T P13 Bal 60-89] & "|" & [_T P13 Bal 90+] & "|" & [_T P13 DPD30 %] & "|" & [_T P13 Δ] & "|" & [_T P13 Provision] & "|" & [DPD30 PY Status] )
            ,SELECTCOLUMNS ( FILTER ( CROSSJOIN ( VALUES ( dim_revenue_type[revenue_type_code] ), VALUES ( dim_market[market_code] ) ), NOT ISBLANK ( [R13 Actual] ) ), "check", "r13." & dim_revenue_type[revenue_type_code] & "|" & dim_market[market_code], "actual", [_T R13 Actual] & "|" & [_T R13 Budget] & "|" & [_T R13 Δ EUR] & "|" & [_T R13 Δ %] & "|" & [_T R13 PY] & "|" & [_T R13 Δ PY %] & "|" & [Revenue Status] )
            ,ROW ( "check", "r13.TOTAL", "actual", [_T R13 Actual] & "|" & [_T R13 Budget] & "|" & [_T R13 Δ EUR] & "|" & [_T R13 Δ %] & "|" & [_T R13 PY] & "|" & [_T R13 Δ PY %] & "|" & [Revenue Status] )
            ,{ ( "title.o9", [Title Markets] ), ( "title.l13", [Title Leaderboard] ), ( "title.c11", [Title Clients Table] ), ( "title.p13", [Title Overdue] ), ( "title.r13", [Title Stream Market] ), ( "filter", [Header Filter Line] ), ( "showing", [How To Read Showing] ) }
            ,ROW ( "check", "l13.order", "actual", CONCATENATEX ( FILTER ( VALUES ( dim_agent[agent_code] ), [_Agent Row] ), dim_agent[agent_code], ",", [Agent Attainment Shown], DESC ) )
        )
        ,FILTER ( ALL ( param_anchor_month ), param_anchor_month[month_key] >= "2026-09" && param_anchor_month[month_key] <= "2026-09" )
        ,TREATAS ( { "ALL" }, param_market[market_code] )
        ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
    )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, SELECTCOLUMNS ( _actual, "check", [check], "actual", [actual] ) )
        ,"_pass", [actual] = [expected]
    )

