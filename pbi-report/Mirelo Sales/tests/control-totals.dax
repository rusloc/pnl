            ,{ "O6", "New clients by acquisition channel", "" }
            ,{ "O7", "Returning clients - cohort repeat curve", "" }
            ,{ "O8", "30+ DPD by market, 13 months", "" }
            ,{ "O9", "Markets - Sep 2026", "" }
            ,{ "L1", "Loans", "Budget: 24.3k; Prior year: 21.2k" }
            ,{ "L2", "Principal", "Budget: €9.8m; At Budget FX: €10.0m; Δ vs Budget at Budget FX: +2.0%; Prior year: €8.0m" }
            ,{ "L3", "Avg ticket", "Step 12 share of loans: 9.0%; Budget ticket: €404; Prior year: €379" }
