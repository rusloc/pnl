    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pick a market, a period (Month, QTD, YTD, R12M) and the closed month it ends on. The comparator (Budget or PY) drives the status chips, the KPI comparison row and the table deltas.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5C58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cards show the value, then the change vs Budget and vs Prior year. Arrow = direction, colour = meaning: green favourable, amber watch, red off; n/a when no comparison exists.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5C58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Flows (loans, clients, revenue) add up the months of the window. Balances and ratios at month end (30+ DPD, MRR, subscribers) use the last month of the window.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5C58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Select a table row and press Show loans (or right-click, Drill through) to open the loans or the client behind it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5C58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Draft on dummy data: Mirelo is a fictional company.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5C58"
                    }
                  }
                ]
              }
            ]
          }
        }
