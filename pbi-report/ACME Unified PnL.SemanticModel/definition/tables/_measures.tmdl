	/// Time window as text, e.g. YTD Jan–Sep 2026 (months the base covers).
	measure '_Window Label' =
			VAR _time_code    = [_Sel Time View]
			VAR _time_label   = SWITCH ( _time_code, "MTD", "Month", "FY", "Full year", _time_code )
			VAR _start        = MAX ( [_Win Start], 0 )
			VAR _end          = [_Win End]
			VAR _start_month  =
			    CALCULATE (
			        MAX ( dim_month[month_name] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _start
			    )
			VAR _start_year   =
			    CALCULATE (
			        MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _start
			    )
			VAR _end_month    =
			    CALCULATE (
			        MAX ( dim_month[month_name] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			VAR _end_year     =
			    CALCULATE (
			        MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_end < _start
			            ,_time_label & ": no closed months"
			        ,_start = _end
			            ,_time_label & " " & _end_month & " " & _end_year
			        ,_start_year = _end_year
			            ,_time_label & " " & _start_month & "–" & _end_month & " " & _end_year
			        ,_time_label & " " & _start_month & " " & _start_year & "–" & _end_month & " " & _end_year
			    )
		isHidden
		displayFolder: Design
		lineageTag: d03f79c3-ca36-54e4-b923-c8f481ef9b8b

	/// Rail summary of the Period group, e.g. YTD - Sep 2026.
	measure 'Rail Sum Period' =
			VAR _time_code    = [_Sel Time View]
			VAR _time_label   = SWITCH ( _time_code, "MTD", "Month", "FY", "Full year", _time_code )
			VAR _anchor       = [_Anchor Index]
			VAR _anchor_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			RETURN
			    _time_label & " - " & _anchor_label
		displayFolder: Design
		lineageTag: 97cfc644-03a7-5ff6-b5ea-773819cced13

	/// Rail summary of the Versions group, e.g. Actual vs Budget, Prior year.
	measure 'Rail Sum Versions' =
			VAR _compare_a    = [_Cmp A Name]
			VAR _compare_b    = [_Cmp B Name]
			VAR _compares     =
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _compare_a ) && ISBLANK ( _compare_b )
			            ,BLANK ()
			        ,ISBLANK ( _compare_b )
			            ,_compare_a
			        ,ISBLANK ( _compare_a )
			            ,_compare_b
			        ,_compare_a & ", " & _compare_b
			    )
			RETURN
			    [_Base Name] & IF ( ISBLANK ( _compares ), " only", " vs " & _compares )
		displayFolder: Design
		lineageTag: 792959a8-16c8-5482-9cd0-8a8fbdf3902f

	/// Rail summary of the Slice group: All slices, filtered regions / slices, or consolidated in the Group view.
	measure 'Rail Sum Slice' =
			VAR _view         = [_Sel Entity]
			VAR _region_n     = COUNTROWS ( ALL ( dim_region[region_name] ) )
			VAR _region_sel   = COUNTROWS ( VALUES ( dim_region[region_name] ) )
			VAR _regions      =
			    IF (
			        ISFILTERED ( dim_region[region_name] ) && _region_sel < _region_n
			        ,_region_sel & " of " & _region_n & " regions"
			        ,"All regions"
			    )
			VAR _channel_on   =
			    ISFILTERED ( dim_channel[channel_name] )
			        && NOT ISEMPTY ( CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), KEEPFILTERS ( dim_channel[entity_code] = _view ) ) )
			VAR _line_on      =
			    ISFILTERED ( dim_line[line_name] )
			        && NOT ISEMPTY ( CALCULATETABLE ( VALUES ( dim_line[line_name] ), KEEPFILTERS ( dim_line[entity_code] = _view ) ) )
			VAR _segment_on   =
			    ISFILTERED ( dim_segment[segment_name] )
			        && NOT ISEMPTY ( CALCULATETABLE ( VALUES ( dim_segment[segment_name] ), KEEPFILTERS ( dim_segment[entity_code] = _view ) ) )
			VAR _slices       = INT ( _channel_on ) + INT ( _line_on ) + INT ( _segment_on )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_view = "GROUP"
			            ,_regions & ", consolidated"
			        ,_regions = "All regions" && _slices = 0
			            ,"All slices"
			        ,_slices = 0
			            ,_regions
			        ,_regions & " - " & _slices & IF ( _slices = 1, " slice filtered", " slices filtered" )
			    )
		displayFolder: Design
		lineageTag: 3e1d7ac2-433e-5b99-83c3-9fdcc2db1879

	/// Rail summary of the Display group, e.g. USD m - actual rates.
	measure 'Rail Sum Display' = [_Units Short] & " - " & IF ( [_Sel FX Basis] = "CC", "constant currency", "actual rates" )
		displayFolder: Design
		lineageTag: e4afc7da-9239-59da-ac75-757bdf197c82

	/// Short label of a segmented-control item (Label role of the button slicers): versions, FX basis, units, time view, breakdown.
	measure 'Seg Label' =
			VAR _currency     = [_Sel Currency]
			VAR _symbol       =
			    CALCULATE (
			        MAX ( param_reporting_currency[symbol] )
			        ,REMOVEFILTERS ( param_reporting_currency )
			        ,param_reporting_currency[currency_code] = _currency
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISINSCOPE ( param_compare_a[choice_name] )
			            ,SWITCH ( SELECTEDVALUE ( param_compare_a[choice_code] ), "B", "Budget", "LE", "Latest est.", "PY", "Prior year", "None" )
			        ,ISINSCOPE ( param_compare_b[choice_name] )
			            ,SWITCH ( SELECTEDVALUE ( param_compare_b[choice_code] ), "B", "Budget", "LE", "Latest est.", "PY", "Prior year", "None" )
			        ,ISINSCOPE ( param_fx_basis[fx_basis_name] )
			            ,IF ( SELECTEDVALUE ( param_fx_basis[fx_basis_code] ) = "CC", "Constant currency", "Actual rates" )
			        ,ISINSCOPE ( param_units[units_name] )
			            ,_symbol & IF ( SELECTEDVALUE ( param_units[units_code] ) = "K", "k", "m" )
			        ,ISINSCOPE ( param_time_view[time_view_name] )
			            ,SWITCH ( SELECTEDVALUE ( param_time_view[time_view_code] ), "MTD", "Month", "FY", "FY", SELECTEDVALUE ( param_time_view[time_view_name] ) )
			        ,ISINSCOPE ( param_breakdown_field[Breakdown] )
			            ,[_Breakdown Short]
			    )
		displayFolder: Design
		lineageTag: 0debc71c-f5a9-5235-9e1f-1ae4e6ead376

	/// One-line description of each base-version card in the Versions flyout (Label role).
	measure 'Version Desc' =
			VAR _code         = SELECTEDVALUE ( param_base_version[choice_code] )
			VAR _fy           = [_Sel FY]
			VAR _last_closed  = [_Last Closed Index]
			VAR _fy_last      =
			    CALCULATE (
			        MAX ( dim_month[month_index] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[fiscal_year] = _fy
			    )
			VAR _closed_to    = MIN ( _last_closed, _fy_last )
			VAR _closed_month =
			    CALCULATE (
			        MAX ( dim_month[month_name] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _closed_to
			    )
			VAR _open_month   =
			    CALCULATE (
			        MAX ( dim_month[month_name] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _closed_to + 1
			    )
			VAR _none_closed  = _last_closed < _fy_last - 11
			RETURN
			    SWITCH (
			        _code
			        ,"A"
			            ,IF ( _none_closed, "Closed months only: none yet in FY" & _fy, "Closed months only, Jan–" & _closed_month & " " & _fy )
			        ,"LE"
			            ,SWITCH (
			                TRUE ()
			                ,_last_closed >= _fy_last
			                    ,"Equals actuals: FY" & _fy & " is closed"
			                ,_none_closed
			                    ,"Latest forecast for every month of FY" & _fy
			                ,"Actual Jan–" & _closed_month & " plus the latest forecast for " & _open_month & "–Dec"
			            )
			        ,"Approved FY" & _fy & " budget, phased by month"
			    )
		displayFolder: Design
		lineageTag: 952caf51-4172-5e04-b871-efbeec17555e

	/// Month button fill in the Period flyout: open months (after the last close) in Subtle, closed months white.
	measure 'Month Item Fill' =
			VAR _fy           = [_Sel FY]
			VAR _month        = SELECTEDVALUE ( param_period[month_number] )
			VAR _last_closed  = [_Last Closed Index]
			VAR _index        =
			    CALCULATE (
			        MAX ( dim_month[month_index] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[fiscal_year] = _fy
			        ,dim_month[month_number] = _month
			    )
			RETURN
			    IF ( _index > _last_closed, "#F6F8FA", "#FFFFFF" )
		displayFolder: Design
		lineageTag: 99164564-f7d0-5ea2-becc-d713d2139b7b

	/// Month button text colour in the Period flyout: open months Slate 600, closed months Ink 900.
	measure 'Month Item Font' =
			VAR _fy           = [_Sel FY]
			VAR _month        = SELECTEDVALUE ( param_period[month_number] )
			VAR _last_closed  = [_Last Closed Index]
			VAR _index        =
			    CALCULATE (
			        MAX ( dim_month[month_index] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[fiscal_year] = _fy
			        ,dim_month[month_number] = _month
			    )
			RETURN
			    IF ( _index > _last_closed, "#4F5C6C", "#101B2B" )
		displayFolder: Design
		lineageTag: 9370cc0d-d3ec-5d6e-bb15-da59d4a8bf9d

	/// Slice flyout subtitle: which slices apply to the selected company.
	measure '_Slice Sub' =
			SWITCH (
			    [_Sel Entity]
			    ,"S"
			        ,"Region, sales motion, service line and segment"
			    ,"GROUP"
			        ,"Only region applies in the consolidated view"
			    ,"Region, channel, category and price tier"
			)
		isHidden
		displayFolder: Design
		lineageTag: e15f58ee-2c67-5912-8dc9-1705ab0c9c84

	/// Region group label with its count in the Slice flyout, e.g. Region - All 4.
	measure 'Slice Hdr Region' =
			VAR _total        = COUNTROWS ( ALL ( dim_region[region_name] ) )
			VAR _selected     = COUNTROWS ( VALUES ( dim_region[region_name] ) )
			RETURN
			    "Region - " & IF ( ISFILTERED ( dim_region[region_name] ) && _selected < _total, _selected & " of " & _total, "All " & _total )
		displayFolder: Design
		lineageTag: 396b148c-864c-5040-9f1f-7f32dace5ee0

	/// Channel / sales motion group label with its count; blank in the Group view.
	measure 'Slice Hdr Channel' =
			VAR _view         = [_Sel Entity]
			VAR _total        =
			    CALCULATE (
			        COUNTROWS ( dim_channel )
			        ,REMOVEFILTERS ( dim_channel )
			        ,dim_channel[entity_code] = _view
			        ,dim_channel[is_unassigned] = FALSE ()
			    )
			VAR _selected     =
			    CALCULATE (
			        COUNTROWS ( dim_channel )
			        ,KEEPFILTERS ( dim_channel[entity_code] = _view )
			        ,KEEPFILTERS ( dim_channel[is_unassigned] = FALSE () )
			    )
			VAR _count        = IF ( ISFILTERED ( dim_channel[channel_name] ) && _selected > 0 && _selected < _total, _selected & " of " & _total, "All " & _total )
			RETURN
			    IF ( _view <> "GROUP", IF ( _view = "S", "Sales motion", "Channel" ) & " - " & _count )
		displayFolder: Design
		lineageTag: 0aef3cec-4261-5d52-a28b-c31eb96bcc33

	/// Category / service line group label with its count; blank in the Group view.
	measure 'Slice Hdr Line' =
			VAR _view         = [_Sel Entity]
			VAR _total        =
			    CALCULATE (
			        COUNTROWS ( dim_line )
			        ,REMOVEFILTERS ( dim_line )
			        ,dim_line[entity_code] = _view
			        ,dim_line[is_unassigned] = FALSE ()
			    )
			VAR _selected     =
			    CALCULATE (
			        COUNTROWS ( dim_line )
			        ,KEEPFILTERS ( dim_line[entity_code] = _view )
			        ,KEEPFILTERS ( dim_line[is_unassigned] = FALSE () )
			    )
			VAR _count        = IF ( ISFILTERED ( dim_line[line_name] ) && _selected > 0 && _selected < _total, _selected & " of " & _total, "All " & _total )
			RETURN
			    IF ( _view <> "GROUP", IF ( _view = "S", "Service line", "Category" ) & " - " & _count )
		displayFolder: Design
		lineageTag: c3d5280e-c77b-50df-a06f-b9776b325a1b

	/// Price tier / customer segment group label with its count; blank in the Group view.
	measure 'Slice Hdr Segment' =
			VAR _view         = [_Sel Entity]
			VAR _total        =
			    CALCULATE (
			        COUNTROWS ( dim_segment )
			        ,REMOVEFILTERS ( dim_segment )
			        ,dim_segment[entity_code] = _view
			        ,dim_segment[is_unassigned] = FALSE ()
			    )
			VAR _selected     =
			    CALCULATE (
			        COUNTROWS ( dim_segment )
			        ,KEEPFILTERS ( dim_segment[entity_code] = _view )
			        ,KEEPFILTERS ( dim_segment[is_unassigned] = FALSE () )
			    )
			VAR _count        = IF ( ISFILTERED ( dim_segment[segment_name] ) && _selected > 0 && _selected < _total, _selected & " of " & _total, "All " & _total )
			RETURN
			    IF ( _view <> "GROUP", IF ( _view = "S", "Customer segment", "Price tier" ) & " - " & _count )
		displayFolder: Design
		lineageTag: 7ec42f5a-346e-5c56-8f13-071edc315427

	/// Group-view notice in the Slice flyout (F-32, T-15); blank for a single company.
	measure 'Slice Group Notice' =
			IF (
			    [_Sel Entity] = "GROUP"
			    ,"Channel, category and segment values differ by company, so these filters are off in the consolidated view and read All. Pick Consumer Products or Commerce Cloud to slice by them."
			)
		displayFolder: Design
		lineageTag: 84c80b6f-d1c0-5161-abc1-e41b4cc4092e

	/// Fill of the Group-view notice box: notice tint in the Group view, white otherwise.
	measure 'Slice Notice Fill' = IF ( [_Sel Entity] = "GROUP", "#FBF4E4", "#FFFFFF" )
		displayFolder: Design
		lineageTag: b85c9aef-b328-549d-81e2-311278e7c620

	/// Border of the Group-view notice box: notice border in the Group view, white otherwise.
	measure 'Slice Notice Rule' = IF ( [_Sel Entity] = "GROUP", "#EBD9AE", "#FFFFFF" )
		displayFolder: Design
		lineageTag: fafcb1bd-c7f2-5934-97fe-e41a25b56cba

	/// Short, company-specific name of the profitability breakdown in context (default Channel).
	measure '_Breakdown Short' =
			VAR _order        = SELECTEDVALUE ( param_breakdown_field[Breakdown Order], 1 )
			VAR _is_services  = [_Sel Entity] = "S"
			RETURN
			    SWITCH (
			        _order
			        ,0
			            ,"Region"
			        ,1
			            ,IF ( _is_services, "Sales motion", "Channel" )
			        ,2
			            ,IF ( _is_services, "Service line", "Category" )
			        ,3
			            ,IF ( _is_services, "Segment", "Price tier" )
			        ,"Company"
			    )
		isHidden
		displayFolder: Design
		lineageTag: 7fc4b5bc-fa5a-5c2d-a06e-7b7202a15fd7

	/// 1 when the breakdown option applies to the selected company: Region or Entity in the Group view, the four slices otherwise. Visual filter of the breakdown slicer.
	measure 'Breakdown Allowed' =
			VAR _order        = SELECTEDVALUE ( param_breakdown_field[Breakdown Order] )
			VAR _is_group     = [_Sel Entity] = "GROUP"
			RETURN
			    IF ( IF ( _is_group, _order IN { 0, 4 }, _order IN { 0, 1, 2, 3 } ), 1 )
		displayFolder: Design
		lineageTag: e5f2a0f0-deb0-586d-b703-c220c2069eab

	/// Statement notes column: company-specific secondary label (L-11) and classification tags (L-14) on line rows; blank on leaves.
	measure 'PL Notes' =
			VAR _is_leaf      = ISINSCOPE ( dim_pl_row[account_label] )
			VAR _line         = SELECTEDVALUE ( dim_pl_row[line_code] )
			VAR _label        = SELECTEDVALUE ( dim_pl_row[line_label] )
			VAR _type         = SELECTEDVALUE ( dim_pl_row[row_type] )
			VAR _view         = [_Sel Entity]
			VAR _alias        =
			    SWITCH (
			        _view
			        ,"P"
			            ,LOOKUPVALUE ( dim_report_line[alias_products], dim_report_line[line_code], _line )
			        ,"S"
			            ,LOOKUPVALUE ( dim_report_line[alias_services], dim_report_line[line_code], _line )
			    )
			VAR _parent       = LOOKUPVALUE ( dim_report_line[parent_line_code], dim_report_line[line_code], _line )
			VAR _category     =
			    IF (
			        _type IN { "input_block", "group_total" } && _parent = ""
			        ,LOOKUPVALUE ( dim_report_line[ifrs18_category], dim_report_line[line_code], _line )
			    )
			VAR _list         =
			    {
			        IF ( _alias <> _label, _alias )
			        ,SELECTEDVALUE ( dim_pl_row[tag] )
			        ,_category
			    }
			RETURN
			    IF ( NOT _is_leaf, CONCATENATEX ( FILTER ( _list, LEN ( [Value] ) > 0 ), [Value], " - " ) )
		displayFolder: Design
		lineageTag: b3a80a97-ab17-50a8-a8d7-5347e7bf3b1a

	/// Statement column-group title over Base and % NR, e.g. YTD Sep 2026 - Actual.
	measure 'PL Hdr Base' =
			VAR _time_code    = [_Sel Time View]
			VAR _anchor       = [_Anchor Index]
			VAR _anchor_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			VAR _window       =
			    SWITCH (
			        _time_code
			        ,"FY"
			            ,"Full year " & [_Sel FY]
			        ,"MTD"
			            ,_anchor_label
			        ,_time_code & " " & _anchor_label
			    )
			RETURN
			    _window & " - " & [_Base Name]
		displayFolder: Design
		lineageTag: edf0ba53-22b5-539a-ad42-caca548b760b

	/// Statement column-group title over Compare A (also the KPI tile label), e.g. vs Budget.
	measure 'PL Hdr Cmp A' = IF ( ISBLANK ( [_Cmp A Name] ), "Compare A: none", "vs " & [_Cmp A Name] )
		displayFolder: Design
		lineageTag: e7992337-9c05-52cf-9a88-3509d0eb2515

	/// Statement column-group title over Compare B (also the KPI tile label), e.g. vs Prior year.
	measure 'PL Hdr Cmp B' = IF ( ISBLANK ( [_Cmp B Name] ), "Compare B: none", "vs " & [_Cmp B Name] )
		displayFolder: Design
		lineageTag: 0957d1eb-e912-50e0-839e-4f51d2acbbe1

	/// Statement column-group title over the full-year columns, e.g. Full year 2026.
	measure 'PL Hdr FY' = "Full year " & [_Sel FY]
		displayFolder: Design
		lineageTag: 5a8e7fbf-ca84-5ce7-bda6-c72b5363469e

	/// Key figures toolbar caption, e.g. Changes vs Budget and Prior year, same months.
	measure 'Kpi Toolbar Caption' =
			VAR _compare_a    = [_Cmp A Name]
			VAR _compare_b    = [_Cmp B Name]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _compare_a ) && ISBLANK ( _compare_b )
			            ,"No comparison selected"
			        ,ISBLANK ( _compare_b )
			            ,"Changes vs " & _compare_a & ", same months"
			        ,ISBLANK ( _compare_a )
			            ,"Changes vs " & _compare_b & ", same months"
			        ,"Changes vs " & _compare_a & " and " & _compare_b & ", same months"
			    )
		displayFolder: Design
		lineageTag: 19884ca2-749a-5f7a-be5c-b380e621b0c3

	/// Net revenue bridge subtitle: comparison to base, units and the company-specific method note.
	measure 'Bridge Subtitle' =
			VAR _view         = [_Sel Entity]
			VAR _method       =
			    SWITCH (
			        _view
			        ,"S"
			            ,"Change by service line at constant currency; FX is the translation effect."
			        ,"GROUP"
			            ,"Change by company at constant currency; FX is the translation effect."
			        ,"Volume and price / mix at constant currency; FX is the translation effect."
			    )
			RETURN
			    [_Bridge Cmp Name] & " to " & [_Base Name] & ", " & [_Units Long] & ". " & _method
		displayFolder: Design
		lineageTag: 1548cb6e-8c20-5c70-b898-f4bb9cabcb1e

	/// Largest variances card title, e.g. Largest variances vs Budget.
	measure 'Var Title' = "Largest variances vs " & [_Bridge Cmp Name]
		displayFolder: Design
		lineageTag: f0605f90-b6c4-5b53-9eb0-10c4de6c5a39

	/// Largest variances card subtitle, e.g. Top 8 lines by size of Δ, USD millions.
	measure 'Var Subtitle' = "Top 8 lines by size of Δ, " & [_Units Long]
		displayFolder: Design
		lineageTag: e25767b4-9242-52eb-b3f9-9e64b8c7a01d

	/// Profitability table title, e.g. Profitability by channel.
	measure 'Prof Title' = "Profitability by " & LOWER ( [_Breakdown Short] )
		displayFolder: Design
		lineageTag: 46439856-996b-595c-a665-5fcbb3119c8e

	/// Profitability table subtitle, e.g. YTD Jan–Sep 2026, USD millions; the breakdown hint instead when the selected breakdown does not apply to the company.
	measure 'Prof Subtitle' = IF ( ISBLANK ( [_Breakdown Hint] ), [_Window Label] & ", " & [_Units Long], [_Breakdown Hint] )
		displayFolder: Design
		lineageTag: 5948ae79-8c3c-5366-b511-1ac3c3b98907

	/// Contribution margin chart title, e.g. Contribution margin by channel.
	measure 'CM Title' = "Contribution margin by " & LOWER ( [_Breakdown Short] )
		displayFolder: Design
		lineageTag: f429bf5d-af14-55fd-b9ae-e1b4754be291

	/// Contribution margin chart subtitle with the company average CM % (the dashed line).
	measure 'CM Subtitle' =
			VAR _entity       =
			    SWITCH ( [_Sel Entity], "S", "Commerce Cloud", "GROUP", "ACME Group", "Consumer Products" )
			VAR _hint         = [_Breakdown Hint]
			RETURN
			    IF (
			        ISBLANK ( _hint )
			        ,"Dashed line: " & _entity & " average " & FORMAT ( [KPI CM %], "0.0%" ) & ". Scale 0–60%."
			        ,_hint
			    )
		displayFolder: Design
		lineageTag: bacc4250-1b3b-56e5-833e-0d4e4ee8418d

	/// Key figures tile body (kpi-card-v2, K-20, K-21; replaces the K-24 / K-25 overlay): image of the card visual, evaluated in the tile query itself, no extra query. Sub-line (KPI Secondary) and one diverging comparison row per active comparison: name, a bar from a centre line that grows right when favourable and left when unfavourable (neutral KPIs grey, right, by size), Δ text with ▲ / ▼ and sign. Scale ±20 % for amount KPIs, ±5 pp for percent KPIs, capped with a chevron; n/a without data; no rows for growth KPIs. SVG 300 x 64.
	measure 'KPI Tile SVG' =
			VAR _code         = SELECTEDVALUE ( dim_kpi[kpi_code] )
			VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
			VAR _better       = SELECTEDVALUE ( dim_kpi[better_when] )
			VAR _is_growth    = _code IN { "ORG_GROWTH", "VOL_GROWTH", "PRICE_MIX" }
			VAR _is_pp        = _type IN { "PCT", "PCT2" }
			VAR _scale        = IF ( _is_pp, 5, 0.2 )
			VAR _sel_a        = [_Sel Compare A]
			VAR _sel_b        = [_Sel Compare B]
			VAR _value        = IF ( NOT _is_growth, [_KPI Value] )
			VAR _cmp_a        =
			    IF (
			        NOT _is_growth && _sel_a <> "NONE"
			        ,CALCULATE (
			            [_KPI Value]
			            ,REMOVEFILTERS ( param_eval )
			            ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
			        )
			    )
			VAR _cmp_b        =
			    IF (
			        NOT _is_growth && _sel_b <> "NONE"
			        ,CALCULATE (
			            [_KPI Value]
			            ,REMOVEFILTERS ( param_eval )
			            ,TREATAS ( { "CMP_B" }, param_eval[eval_code] )
			        )
			    )
			VAR _sec          = [KPI Secondary]
			VAR _rows         =
			    FILTER (
			        {
			            ( 1, _sel_a, IF ( _is_pp, ( _value - _cmp_a ) * 100, DIVIDE ( _value - _cmp_a, ABS ( _cmp_a ) ) ), NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_a ) )
			            ,( 2, _sel_b, IF ( _is_pp, ( _value - _cmp_b ) * 100, DIVIDE ( _value - _cmp_b, ABS ( _cmp_b ) ) ), NOT ISBLANK ( _value ) && NOT ISBLANK ( _cmp_b ) )
			        }
			        ,NOT _is_growth && [Value2] <> "NONE"
			    )
			VAR _body         =
			    CONCATENATEX (
			        _rows
			        ,VAR _y           = 14 + 22 * [Value1]
			         VAR _name        = "vs " & SWITCH ( [Value2], "B", "Budget", "LE", "Latest est.", "PY", "Prior year" )
			         VAR _has         = [Value4]
			         VAR _delta       = ROUND ( [Value3], IF ( _is_pp, 1, 3 ) )
			         VAR _fav         =
			             SWITCH (
			                 TRUE ()
			                 ,_better = "Neutral" || _delta = 0
			                     ,0
			                 ,( _delta > 0 && _better = "Higher" ) || ( _delta < 0 && _better = "Lower" )
			                     ,1
			                 ,-1
			             )
			         VAR _len         = MIN ( ABS ( _delta ) / _scale, 1 ) * 50
			         VAR _bar_x       = IF ( _fav = -1, 146 - _len, 146 )
			         VAR _fill        = SWITCH ( _fav, 1, "#3BA37B", -1, "#E2804A", "#8592A3" )
			         VAR _ink         = SWITCH ( _fav, 1, "#06603F", -1, "#C2410C", "#101B2B" )
			         VAR _arrow       = IF ( _delta > 0, "▲ +", IF ( _delta < 0, "▼ −", "" ) )
			         VAR _number      =
			             FORMAT ( ABS ( _delta ), IF ( _is_pp, "0.0", "0.0%" ) ) & IF ( _is_pp, " pp", "" )
			         VAR _chevron     =
			             IF (
			                 ABS ( _delta ) > _scale
			                 ,IF (
			                     _fav = -1
			                     ,"<path d='M99 " & _y - 9 & " l-3 3 l3 3' fill='none' stroke='" & _fill & "' stroke-width='1.4'/>"
			                     ,"<path d='M193 " & _y - 9 & " l3 3 l-3 3' fill='none' stroke='" & _fill & "' stroke-width='1.4'/>"
			                 )
			             )
			         RETURN
			             "<text x='0' y='" & _y & "' font-size='13' fill='#4F5C6C'>" & _name & "</text>"
			                 & IF (
			                     _has
			                     ,"<rect x='96' y='" & _y - 10 & "' width='100' height='8' rx='2' fill='#EDF0F3'/>"
			                         & IF ( _len > 0, "<rect x='" & FORMAT ( _bar_x, "0.0" ) & "' y='" & _y - 10 & "' width='" & FORMAT ( _len, "0.0" ) & "' height='8' rx='2' fill='" & _fill & "'/>" )
			                         & "<rect x='145.5' y='" & _y - 13 & "' width='1' height='14' fill='#101B2B' fill-opacity='0.4'/>"
			                         & _chevron
			                         & "<text x='300' y='" & _y & "' font-size='13' font-weight='600' text-anchor='end' fill='" & _ink & "'>" & _arrow & _number & "</text>"
			                     ,"<text x='300' y='" & _y & "' font-size='13' text-anchor='end' fill='#4F5C6C'>n/a</text>"
			                 )
			        ,""
			        ,[Value1], ASC
			    )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='64' viewBox='0 0 300 64' font-family='Segoe UI, sans-serif' style='font-variant-numeric:tabular-nums'>"
			        & IF ( LEN ( _sec ) > 0, "<text x='0' y='12' font-size='12' fill='#4F5C6C'>" & _sec & "</text>" )
			        & _body
			        & "</svg>"
			RETURN
			    IF (
			        NOT ISBLANK ( _code )
			        ,"data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
			    )
		displayFolder: Design
		lineageTag: 3d63820e-90f4-47c2-b006-c449f74f90c2
		dataCategory: ImageUrl

	/// Tooltip of a Key figures tile: the KPI definition from dim_kpi (kpi-card-v2: the one-line definition moves to the tooltip).
	measure 'KPI Definition' =
			SELECTEDVALUE ( dim_kpi[definition] )
		displayFolder: Design
		lineageTag: 18780fd6-4b12-4040-9415-5c84bd4f461b

	/// Header status on the title row (N-02, N-03): company - Management reporting - last closed month - last refresh, e.g. ACME Group - Management reporting - Closed through Sep 2026 - Refreshed 22 Oct 2026 13:53.
	measure 'Hdr Status' =
			VAR _company      = SWITCH ( [_Sel Entity], "S", "Commerce Cloud", "GROUP", "ACME Group", "Consumer Products" )
			VAR _last_closed  = [_Last Closed Index]
			VAR _closed_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			VAR _refreshed    = MAX ( _meta_refresh[refreshed_at] )
			RETURN
			    _company & " - Management reporting - Closed through " & _closed_label & " - Refreshed " & FORMAT ( _refreshed, "d mmm yyyy hh:nn" )
		displayFolder: Design
		lineageTag: 5e10b662-c0bb-4eae-9062-ac3a9e1e7c24

	/// Value of a row of the applied-filters pop-up (dim_filter_row): company, fiscal year, period, time view with its window, versions, currency, FX basis, units, regions, slices. Covers everything the former header context line showed (L-04).
	measure 'Filter Value' =
			VAR _row          = SELECTEDVALUE ( dim_filter_row[filter_code] )
			VAR _view         = [_Sel Entity]
			VAR _compare_a    = [_Cmp A Name]
			VAR _compare_b    = [_Cmp B Name]
			VAR _anchor       = [_Anchor Index]
			VAR _anchor_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _anchor
			    )
			VAR _versions     =
			    [_Base Name]
			        & SWITCH (
			            TRUE ()
			            ,ISBLANK ( _compare_a ) && ISBLANK ( _compare_b )
			                ," only"
			            ,ISBLANK ( _compare_b )
			                ," vs " & _compare_a & " (A)"
			            ,ISBLANK ( _compare_a )
			                ," vs " & _compare_b & " (B)"
			            ," vs " & _compare_a & " (A) and " & _compare_b & " (B)"
			        )
			VAR _regions      =
			    IF (
			        ISFILTERED ( dim_region[region_name] ) && COUNTROWS ( VALUES ( dim_region[region_name] ) ) < COUNTROWS ( ALL ( dim_region[region_name] ) )
			        ,CONCATENATEX ( VALUES ( dim_region[region_name] ), dim_region[region_name], ", ", dim_region[region_name], ASC )
			        ,"All regions"
			    )
			VAR _channels     =
			    IF (
			        ISFILTERED ( dim_channel[channel_name] )
			        ,CONCATENATEX (
			            CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), KEEPFILTERS ( dim_channel[entity_code] = _view ) )
			            ,dim_channel[channel_name]
			            ,", "
			            ,dim_channel[channel_name], ASC
			        )
			    )
			VAR _lines        =
			    IF (
			        ISFILTERED ( dim_line[line_name] )
			        ,CONCATENATEX (
			            CALCULATETABLE ( VALUES ( dim_line[line_name] ), KEEPFILTERS ( dim_line[entity_code] = _view ) )
			            ,dim_line[line_name]
			            ,", "
			            ,dim_line[line_name], ASC
			        )
			    )
			VAR _segments     =
			    IF (
			        ISFILTERED ( dim_segment[segment_name] )
			        ,CONCATENATEX (
			            CALCULATETABLE ( VALUES ( dim_segment[segment_name] ), KEEPFILTERS ( dim_segment[entity_code] = _view ) )
			            ,dim_segment[segment_name]
			            ,", "
			            ,dim_segment[segment_name], ASC
			        )
			    )
			VAR _is_services  = _view = "S"
			VAR _slices       =
			    IF (
			        ISBLANK ( _channels ) && ISBLANK ( _lines ) && ISBLANK ( _segments )
			        ,"All slices"
			        ,IF ( _is_services, "Sales motion: ", "Channel: " ) & IF ( ISBLANK ( _channels ), "All", _channels )
			            & " - " & IF ( _is_services, "Service line: ", "Category: " ) & IF ( ISBLANK ( _lines ), "All", _lines )
			            & " - " & IF ( _is_services, "Segment: ", "Price tier: " ) & IF ( ISBLANK ( _segments ), "All", _segments )
			    )
			RETURN
			    SWITCH (
			        _row
			        ,"COMPANY"
			            ,SWITCH ( _view, "S", "Commerce Cloud", "GROUP", "ACME Group (consolidated)", "Consumer Products" )
			        ,"FY"
			            ,"FY" & [_Sel FY]
			        ,"PERIOD"
			            ,_anchor_label
			        ,"TIME"
			            ,[_Window Label]
			        ,"VERSIONS"
			            ,_versions
			        ,"CURRENCY"
			            ,[_Sel Currency]
			        ,"FX"
			            ,IF ( [_Sel FX Basis] = "CC", "Constant currency (FY" & [_Sel FY] & " budget rates)", "Actual rates" )
			        ,"UNITS"
			            ,IF ( [_Sel Units] = "K", "Thousands", "Millions" )
			        ,"REGIONS"
			            ,_regions
			        ,"SLICES"
			            ,IF ( _view = "GROUP", "Consolidated: channel, category and segment do not apply", _slices )
			    )
		displayFolder: Design
		lineageTag: 7ca50019-fd24-4ef7-893f-c70dbb3e3786

	/// Why the Profitability view is empty: blank when the selected breakdown applies to the company, else e.g. Channel does not apply to ACME Group - pick Region or Company. The breakdown slicer keeps its selection when the company changes, and Breakdown Allowed hides the kept item.
	measure '_Breakdown Hint' =
			VAR _order        = SELECTEDVALUE ( param_breakdown_field[Breakdown Order] )
			VAR _view         = [_Sel Entity]
			RETURN
			    IF (
			        NOT ISBLANK ( _order ) && ISBLANK ( [Breakdown Allowed] )
			        ,IF (
			            _view = "GROUP"
			            ,[_Breakdown Short] & " does not apply to ACME Group - pick Region or Company"
			            ,"Company applies only to ACME Group - pick another breakdown"
			        )
			    )
		isHidden
		displayFolder: Design
		lineageTag: 713cec0f-09c9-4c67-9f61-8de460e31736

	/// Info pop-up text of the net revenue bridge (L-15): shared copy docs/ADD/features/info-popovers.md, comparison filled in. Track B trims the axis sentence of Watch out because its waterfall axis starts at zero. Paragraph 1 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Bridge 1' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			RETURN
			    "How net revenue got from " & _cmp & " to the current figure, split into the reasons for the change."
		displayFolder: Design
		lineageTag: c13e7028-23d6-4025-9681-899de5479f6e

	/// Info pop-up text of the net revenue bridge (L-15): shared copy docs/ADD/features/info-popovers.md, comparison filled in. Track B trims the axis sentence of Watch out because its waterfall axis starts at zero. Paragraph 2 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Bridge 2' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			RETURN
			    "• The first bar is net revenue in " & _cmp & "; the last bar is net revenue now."
		displayFolder: Design
		lineageTag: 00c1ca1c-12cf-4fa5-b60e-b4f3a088b368

	/// Info pop-up text of the largest variances table (L-15): shared copy docs/ADD/features/info-popovers.md, comparison filled in. Track B trims "underneath" because the block is a column of its own. Paragraph 1 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Variances 1' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			RETURN
			    "The 8 lines of the P&L that differ most from " & _cmp & ", in amount, whether up or down."
		displayFolder: Design
		lineageTag: f94487a6-0131-4fb9-9496-ba515dac8b47

	/// Info pop-up text of the largest variances table (L-15): shared copy docs/ADD/features/info-popovers.md, comparison filled in. Track B trims "underneath" because the block is a column of its own. Paragraph 2 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Variances 2' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			RETURN
			    "• Δ is the difference in money; Δ % is that difference as a share of " & _cmp & "."
		displayFolder: Design
		lineageTag: 6308bcd8-3d67-46de-b854-bffcd20d4886

	/// Info pop-up text of the profitability table (L-15): shared copy docs/ADD/features/info-popovers.md, breakdown and comparison filled in. Paragraph 1 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Profitability 1' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			VAR _bd          = LOWER ( [_Breakdown Short] )
			RETURN
			    "How much revenue each " & _bd & " brings in, how it grew against " & _cmp & ", and how much of that revenue is left as profit at each stage of the P&L."
		displayFolder: Design
		lineageTag: 1c751a23-ccdc-40c2-9771-cb8281f357b3

	/// Info pop-up text of the profitability table (L-15): shared copy docs/ADD/features/info-popovers.md, breakdown and comparison filled in. Paragraph 2 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Profitability 2' =
			VAR _cmp         = LOWER ( [_Bridge Cmp Name] )
			RETURN
			    "• vs " & _cmp & ": revenue growth of the row; green is better than " & _cmp & ", orange is worse."
		displayFolder: Design
		lineageTag: 7b0ca121-f54f-49a7-b870-101b730d0b54

	/// Info pop-up text of the profitability table (L-15): shared copy docs/ADD/features/info-popovers.md, breakdown and comparison filled in. Paragraph 3 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info Profitability 3' =
			VAR _bd          = LOWER ( [_Breakdown Short] )
			RETURN
			    "Costs that are not booked to a " & _bd & " (for example marketing or admin) are shared out by each row's share of revenue, so margins below contribution margin are partly an allocation, not a direct measurement."
		displayFolder: Design
		lineageTag: 44fe99bc-b632-4785-a541-fa10c8e89212

	/// Info pop-up text of the contribution margin chart (L-15): shared copy docs/ADD/features/info-popovers.md, breakdown filled in. Paragraph 1 (the one with a placeholder; the static paragraphs are text boxes, because a card clamps long text and a button ignores line breaks).
	measure 'Info CM 1' =
			VAR _bd          = LOWER ( [_Breakdown Short] )
			RETURN
			    "For each " & _bd & ", the share of its revenue that is left after the direct costs of making, selling and delivering: the contribution margin %."
		displayFolder: Design
		lineageTag: 3a3bb9ab-4cbe-4573-a8ad-013d6586b677

	/// 1 on the effective tax rate ratio row, whose deltas are never coloured; blank elsewhere. No engine call; input of the rules that colour the statement deltas.
	measure 'PL Fav Off' = IF ( NOT ISINSCOPE ( dim_pl_row[account_label] ) && SELECTEDVALUE ( dim_pl_row[line_code] ) = "ETR_PCT", 1 )
		displayFolder: Design
		lineageTag: bd98c423-fcdb-59ab-b741-8c0887e63a18

	column measure_table
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5f1a7066-2cd4-5581-a442-741962985bee
		summarizeBy: none
		isNameInferred
		sourceColumn: [measure_table]

		annotation SummarizationSetBy = User

	partition _measures = calculated
		mode: import
		source = ROW ( "measure_table", 0 )

	annotation PBI_ResultType = Table

