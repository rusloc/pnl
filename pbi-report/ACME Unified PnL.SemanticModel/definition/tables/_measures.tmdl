/// Measure table. All report measures live here (CLAUDE.md Track B).
table _measures
	lineageTag: 850a3317-6515-5e7a-8141-20a9421b32dc

	/// Month index of the last closed month (dim_month.is_closed, set by finance).
	measure '_Last Closed Index' =
			CALCULATE (
			    MAX ( dim_month[month_index] )
			    ,REMOVEFILTERS ( dim_month )
			    ,dim_month[is_closed] = TRUE ()
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3b67fe89-be01-5bc4-a00f-bd36f49d12f4

	/// Selected entity view code: P, S or GROUP (default Consumer Products).
	measure '_Sel Entity' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_entity_view[entity_view_code] )
			        ,REMOVEFILTERS ( param_entity_view )
			        ,param_entity_view[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_entity_view[entity_view_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: f19b8b80-d12a-5d95-9f46-b695eafdd940

	/// Selected fiscal year; defaults to the fiscal year of the last closed month.
	measure '_Sel FY' =
			VAR _last_closed  = [_Last Closed Index]
			VAR _default      =
			    CALCULATE (
			        MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			RETURN
			    SELECTEDVALUE ( param_fiscal_year[fiscal_year], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: ba169afd-5101-5f5e-ba2f-79ef3af0041a

	/// Selected period (month number 1-12); defaults to the last closed month.
	measure '_Sel Month' =
			VAR _last_closed  = [_Last Closed Index]
			VAR _default      =
			    CALCULATE (
			        MAX ( dim_month[month_number] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			RETURN
			    SELECTEDVALUE ( param_period[month_number], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: ea57bd31-5fbd-532d-a185-479d48e647cc

	/// Selected time view code: MTD, QTD, YTD, LTM or FY (default YTD).
	measure '_Sel Time View' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_time_view[time_view_code] )
			        ,REMOVEFILTERS ( param_time_view )
			        ,param_time_view[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_time_view[time_view_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 61521d11-2129-5d6a-9b61-657cf750a799

	/// Selected base version: A (Actual), LE or B (default Actual).
	measure '_Sel Base Version' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_base_version[choice_code] )
			        ,REMOVEFILTERS ( param_base_version )
			        ,param_base_version[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_base_version[choice_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 226b5fc3-0303-5c2d-96b7-a632563fae16

	/// Selected Compare A version: B, LE, PY or NONE (default Budget).
	measure '_Sel Compare A' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_compare_a[choice_code] )
			        ,REMOVEFILTERS ( param_compare_a )
			        ,param_compare_a[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_compare_a[choice_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4b9601fc-ef44-5805-a4ab-d075aa7e0d42

	/// Selected Compare B version: B, LE, PY or NONE (default Prior year).
	measure '_Sel Compare B' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_compare_b[choice_code] )
			        ,REMOVEFILTERS ( param_compare_b )
			        ,param_compare_b[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_compare_b[choice_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: f2367614-6c2f-5e6d-a0cc-6a7c4df12a1f

	/// Selected reporting currency (default USD).
	measure '_Sel Currency' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_reporting_currency[currency_code] )
			        ,REMOVEFILTERS ( param_reporting_currency )
			        ,param_reporting_currency[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_reporting_currency[currency_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 360dccd9-f04a-573d-ad9b-3a080ef0d775

	/// Selected FX basis: ACT (actual rates) or CC (constant currency, default ACT).
	measure '_Sel FX Basis' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_fx_basis[fx_basis_code] )
			        ,REMOVEFILTERS ( param_fx_basis )
			        ,param_fx_basis[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_fx_basis[fx_basis_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: fad4cf98-9449-5ea1-a8b6-1686c3ed28a0

	/// Selected display units: M or K (default M). Display only: values stay unscaled.
	measure '_Sel Units' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_units[units_code] )
			        ,REMOVEFILTERS ( param_units )
			        ,param_units[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_units[units_code], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 8f91329c-9dc7-5e0a-b070-4b18d6b1df46

	/// Hidden switch that lets one engine sum P&L amounts, units, GMV or month-end merchants. Measures override it with TREATAS; never shown on a slicer.
	measure '_Sel Metric' = SELECTEDVALUE ( param_metric[metric_code], "AMOUNT" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 1934650a-de99-514d-8004-2d12e3c96a61

	/// Hidden switch that re-evaluates any KPI as Compare A or Compare B (Base Amount reads it). Never on a slicer.
	measure '_Sel Eval' = SELECTEDVALUE ( param_eval[eval_code], "BASE" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: f160c7e1-4511-55be-84be-f06d6fc2f049

	/// Month index of the selected fiscal year and period (anchor m of year y).
	measure '_Anchor Index' =
			VAR _fiscal_year  = [_Sel FY]
			VAR _month        = [_Sel Month]
			RETURN
			    CALCULATE (
			        MAX ( dim_month[month_index] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[fiscal_year] = _fiscal_year
			        ,dim_month[month_number] = _month
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 64ef2ae7-10fe-5333-9c1c-3c6a0cfc8412

	/// First month index of the window: Month m, QTD, YTD, LTM (m-11, may cross years) or Full year.
	measure '_Win Start' =
			VAR _anchor       = [_Anchor Index]
			VAR _month        = [_Sel Month]
			VAR _time_view    = [_Sel Time View]
			RETURN
			    SWITCH (
			        _time_view
			        ,"MTD"
			            ,_anchor
			        ,"QTD"
			            ,_anchor - MOD ( _month - 1, 3 )
			        ,"LTM"
			            ,_anchor - 11
			        ,_anchor - ( _month - 1 )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4a775f9f-cfd0-5ce9-97da-4b58acfd119a

	/// Last month index of the window before the close cut-off (Dec for Full year).
	measure '_Win End Raw' =
			VAR _anchor       = [_Anchor Index]
			VAR _month        = [_Sel Month]
			RETURN
			    IF ( [_Sel Time View] = "FY", _anchor - _month + 12, _anchor )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a56679d3-d1e0-50cd-951d-1867ba4d0b5b

	/// Last month index the base covers: Actual never runs past the last close; comparisons reuse these months.
	measure '_Win End' =
			VAR _end_raw      = [_Win End Raw]
			VAR _last_closed  = [_Last Closed Index]
			RETURN
			    IF ( [_Sel Base Version] = "A", MIN ( _end_raw, _last_closed ), _end_raw )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 18e7e393-23d6-5c6e-a611-33385c8b1a6e

	/// Local-currency sum for the current filter context. P&L: direct accounts from fact_pl plus below-CM accounts from fact_pl_allocated (never fact_pl's _UNASSIGNED rows). Other metrics read fact_operational.
	measure '_Local Sum' =
			VAR _metric       = [_Sel Metric]
			RETURN
			    SWITCH (
			        _metric
			        ,"AMOUNT"
			            ,CALCULATE (
			                SUM ( fact_pl[amount_local] )
			                ,KEEPFILTERS ( dim_account[is_direct] = TRUE () )
			            )
			                + SUM ( fact_pl_allocated[amount_local] )
			        ,"UNITS"
			            ,SUM ( fact_operational[units_sold] )
			        ,"GMV"
			            ,SUM ( fact_operational[gmv_local] )
			        ,"MERCHANTS"
			            ,SUM ( fact_operational[active_merchants_end] )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 665f7a9a-a992-5b16-a440-f143e0ab3f55

	/// Translates month by month and currency by currency before summing: local / local_per_usd x rate of the reporting currency, same month and rate type. Actual and forecast use ACTUAL_AVG, budget uses BUDGET; constant currency uses the BUDGET rate of the selected fiscal year for every version. Units and merchants are not translated.
	measure '_Amt Raw' =
			VAR _metric       = [_Sel Metric]
			VAR _rep_currency = [_Sel Currency]
			VAR _is_cc        = [_Sel FX Basis] = "CC"
			VAR _cc_month     = FORMAT ( [_Sel FY], "0" ) & "-01"
			VAR _groups       =
			    CROSSJOIN (
			        VALUES ( dim_month[month_key] )
			        ,VALUES ( dim_region[functional_currency] )
			        ,VALUES ( dim_version[version_key] )
			    )
			VAR _translated   =
			    SUMX (
			        _groups
			        ,VAR _currency    = dim_region[functional_currency]
			         VAR _version     = dim_version[version_key]
			         VAR _rate_type   = IF ( _is_cc || _version = "BUD", "BUDGET", "ACTUAL_AVG" )
			         VAR _rate_month  = IF ( _is_cc, _cc_month, dim_month[month_key] )
			         VAR _local_rate  =
			             LOOKUPVALUE (
			                 fact_fx_rate[local_per_usd]
			                 ,fact_fx_rate[currency_code], _currency
			                 ,fact_fx_rate[month_key], _rate_month
			                 ,fact_fx_rate[rate_type], _rate_type
			             )
			         VAR _rep_rate    =
			             LOOKUPVALUE (
			                 fact_fx_rate[local_per_usd]
			                 ,fact_fx_rate[currency_code], _rep_currency
			                 ,fact_fx_rate[month_key], _rate_month
			                 ,fact_fx_rate[rate_type], _rate_type
			             )
			         RETURN
			             [_Local Sum] * DIVIDE ( _rep_rate, _local_rate )
			    )
			RETURN
			    IF ( _metric IN { "UNITS", "MERCHANTS" }, [_Local Sum], _translated )
		isHidden
		displayFolder: 9 Engine
		lineageTag: c140a1fd-3372-5d99-92f3-3c28c16b3a7d

	/// Group eliminations: minus the counterparty-tagged amounts of every block whose elimination account (ELIM_GR, ELIM_VSC) is in the current account filter. A leaf like GR_S1 gets no elimination; block GR, net revenue and every subtotal below do. Contribution margin and below are unchanged (T-02). Translated like _Amt Raw (P&L amounts of fact_pl only: no metric switch, no allocated table), so the Group branch of _Amt Entity adds a small expression to every query plan.
	measure '_Elim Amount' =
			VAR _rep_currency = [_Sel Currency]
			VAR _is_cc        = [_Sel FX Basis] = "CC"
			VAR _cc_month     = FORMAT ( [_Sel FY], "0" ) & "-01"
			VAR _elim_blocks  =
			    CALCULATETABLE (
			        VALUES ( dim_account[block_code] )
			        ,KEEPFILTERS ( dim_account[is_intercompany] = TRUE () )
			        ,KEEPFILTERS ( dim_account[has_fact_rows] = FALSE () )
			        ,KEEPFILTERS ( dim_account[is_direct] = TRUE () )
			    )
			VAR _ic_amount    =
			    CALCULATE (
			        SUMX (
			            CROSSJOIN (
			                VALUES ( dim_month[month_key] )
			                ,VALUES ( dim_region[functional_currency] )
			                ,VALUES ( dim_version[version_key] )
			            )
			            ,VAR _currency    = dim_region[functional_currency]
			             VAR _version     = dim_version[version_key]
			             VAR _rate_type   = IF ( _is_cc || _version = "BUD", "BUDGET", "ACTUAL_AVG" )
			             VAR _rate_month  = IF ( _is_cc, _cc_month, dim_month[month_key] )
			             VAR _local_rate  =
			                 LOOKUPVALUE (
			                     fact_fx_rate[local_per_usd]
			                     ,fact_fx_rate[currency_code], _currency
			                     ,fact_fx_rate[month_key], _rate_month
			                     ,fact_fx_rate[rate_type], _rate_type
			                 )
			             VAR _rep_rate    =
			                 LOOKUPVALUE (
			                     fact_fx_rate[local_per_usd]
			                     ,fact_fx_rate[currency_code], _rep_currency
			                     ,fact_fx_rate[month_key], _rate_month
			                     ,fact_fx_rate[rate_type], _rate_type
			                 )
			             RETURN
			                 CALCULATE ( SUM ( fact_pl[amount_local] ) ) * DIVIDE ( _rep_rate, _local_rate )
			        )
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _elim_blocks, dim_account[block_code] )
			        ,dim_account[is_direct] = TRUE ()
			        ,NOT ISBLANK ( fact_pl[counterparty_entity_code] )
			    )
			RETURN
			    - _ic_amount
		isHidden
		displayFolder: 9 Engine
		lineageTag: a30e542c-c32f-52b1-a96f-5fa42f8692b0

	/// Applies the entity view in one evaluation. Consumer Products / Commerce Cloud: that entity only; a slice selection that holds only the other entity's values is ignored (it comes back when you switch back). ACME Group: both entities plus eliminations, channel / category / segment filters off. Entity and slices are passed as filter tables, so no branch evaluates the engine twice.
	measure '_Amt Entity' =
			VAR _view         = [_Sel Entity]
			VAR _is_group     = _view = "GROUP"
			VAR _entities     =
			    FILTER (
			        ALL ( dim_entity[entity_code] )
			        ,_is_group || dim_entity[entity_code] = _view
			    )
			VAR _ch_sel       = VALUES ( dim_channel[channel_code] )
			VAR _ch_stale     =
			    NOT ISEMPTY ( _ch_sel )
			        && ISEMPTY (
			            CALCULATETABLE (
			                VALUES ( dim_channel[channel_code] )
			                ,KEEPFILTERS ( dim_channel[entity_code] = _view )
			            )
			        )
			VAR _channels     =
			    FILTER (
			        ALL ( dim_channel[channel_code] )
			        ,_is_group || _ch_stale || dim_channel[channel_code] IN _ch_sel
			    )
			VAR _ln_sel       = VALUES ( dim_line[line_code] )
			VAR _ln_stale     =
			    NOT ISEMPTY ( _ln_sel )
			        && ISEMPTY (
			            CALCULATETABLE (
			                VALUES ( dim_line[line_code] )
			                ,KEEPFILTERS ( dim_line[entity_code] = _view )
			            )
			        )
			VAR _lines        =
			    FILTER (
			        ALL ( dim_line[line_code] )
			        ,_is_group || _ln_stale || dim_line[line_code] IN _ln_sel
			    )
			VAR _sg_sel       = VALUES ( dim_segment[segment_code] )
			VAR _sg_stale     =
			    NOT ISEMPTY ( _sg_sel )
			        && ISEMPTY (
			            CALCULATETABLE (
			                VALUES ( dim_segment[segment_code] )
			                ,KEEPFILTERS ( dim_segment[entity_code] = _view )
			            )
			        )
			VAR _segments     =
			    FILTER (
			        ALL ( dim_segment[segment_code] )
			        ,_is_group || _sg_stale || dim_segment[segment_code] IN _sg_sel
			    )
			VAR _value        =
			    CALCULATE (
			        [_Amt Raw]
			        ,KEEPFILTERS ( TREATAS ( _entities, dim_entity[entity_code] ) )
			        ,REMOVEFILTERS ( dim_channel )
			        ,TREATAS ( _channels, dim_channel[channel_code] )
			        ,REMOVEFILTERS ( dim_line )
			        ,TREATAS ( _lines, dim_line[line_code] )
			        ,REMOVEFILTERS ( dim_segment )
			        ,TREATAS ( _segments, dim_segment[segment_code] )
			    )
			VAR _elim         =
			    IF (
			        _is_group && [_Sel Metric] = "AMOUNT"
			        ,CALCULATE (
			            [_Elim Amount]
			            ,REMOVEFILTERS ( dim_channel )
			            ,REMOVEFILTERS ( dim_line )
			            ,REMOVEFILTERS ( dim_segment )
			        )
			    )
			RETURN
			    _value + _elim
		isHidden
		displayFolder: 9 Engine
		lineageTag: 51941bde-1077-57d7-8337-63c4e89b3356

	/// Statement row logic as one account filter. Without a dim_pl_row filter it passes through. Input block: its accounts. Group total (OPEX): its child blocks. Subtotal / memo: every input block above it (signed sums, M-01), which equals the dim_report_line formula. Leaf: the account. Ratio rows get no accounts (handled one level up in the PL measures).
	measure '_Amt Row' =
			VAR _has_row      = ISCROSSFILTERED ( dim_pl_row[line_code] )
			VAR _line         = SELECTEDVALUE ( dim_pl_row[line_code] )
			VAR _type         = SELECTEDVALUE ( dim_pl_row[row_type] )
			VAR _sort         = SELECTEDVALUE ( dim_pl_row[line_sort] )
			VAR _is_leaf      = ISINSCOPE ( dim_pl_row[account_label] )
			VAR _account      = SELECTEDVALUE ( dim_pl_row[account_code] )
			VAR _visible      = VALUES ( dim_account[account_code] )
			VAR _blocks       =
			    SELECTCOLUMNS (
			        FILTER (
			            ALL (
			                dim_report_line[line_code]
			                ,dim_report_line[row_type]
			                ,dim_report_line[parent_line_code]
			                ,dim_report_line[sort_order]
			                ,dim_report_line[block_code]
			            )
			            ,dim_report_line[row_type] = "input_block"
			                && SWITCH (
			                    _type
			                    ,"input_block"
			                        ,dim_report_line[line_code] = _line
			                    ,"group_total"
			                        ,dim_report_line[parent_line_code] = _line
			                    ,"ratio"
			                        ,FALSE ()
			                    ,dim_report_line[sort_order] < _sort
			                )
			        )
			        ,"@block_code", dim_report_line[block_code]
			    )
			VAR _accounts     =
			    FILTER (
			        ALL ( dim_account[account_code], dim_account[block_code] )
			        ,IF (
			            NOT _has_row
			            ,dim_account[account_code] IN _visible
			            ,NOT ISBLANK ( _line )
			                && IF (
			                    _is_leaf
			                    ,LEN ( _account ) > 0 && dim_account[account_code] = _account
			                    ,dim_account[block_code] IN _blocks
			                )
			        )
			    )
			RETURN
			    CALCULATE (
			        [_Amt Entity]
			        ,TREATAS ( SELECTCOLUMNS ( _accounts, "@account_code", dim_account[account_code] ), dim_account[account_code] )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4bb36ee4-e89c-5621-af91-33442052435c

	/// Version Actual (ACT) for the current months.
	measure '_Amt Actual' =
			CALCULATE (
			    [_Amt Row]
			    ,REMOVEFILTERS ( dim_version )
			    ,dim_version[version_key] = "ACT"
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: b883d7e1-7c03-5aea-964f-f74b6ff31078

	/// Version Budget (BUD) for the current months.
	measure '_Amt Budget' =
			CALCULATE (
			    [_Amt Row]
			    ,REMOVEFILTERS ( dim_version )
			    ,dim_version[version_key] = "BUD"
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6255e108-fe97-51bf-a34a-0252b0c0ce16

	/// Base version amount over the window, in the reporting currency, unscaled. Row-aware on the statement. Re-evaluates as Compare A / B when param_eval is overridden (used for KPI deltas).
	measure 'Base Amount' = [_Amt Window]
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: 8879de05-b8f9-509f-8f85-b35baf47e764

	/// Compare A version over exactly the months the base covers; Prior year shifts them 12 months back (Actual). Blank when Compare A = None or no data (n/a). Unscaled.
	measure 'Compare A Amount' =
			CALCULATE (
			    [_Amt Window]
			    ,REMOVEFILTERS ( param_eval )
			    ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: 99b72f1e-3fcb-5318-9658-fb6211cb0e45

	/// Compare B version over exactly the months the base covers; Prior year shifts them 12 months back (Actual). Unscaled.
	measure 'Compare B Amount' =
			CALCULATE (
			    [_Amt Window]
			    ,REMOVEFILTERS ( param_eval )
			    ,TREATAS ( { "CMP_B" }, param_eval[eval_code] )
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: 6a244443-89e3-50f5-934d-4fd89212ca0a

	/// Prior year: Actual over the base months shifted back 12. Blank for the first data year.
	measure 'PY Amount' =
			VAR _start        = [_Win Start] - 12
			VAR _end          = [_Win End] - 12
			RETURN
			    CALCULATE (
			        [_Amt Actual]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] >= _start && dim_month[month_index] <= _end
			    )
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: cbad4652-4478-5eb0-b1e3-b980266f9ecd

	/// Budget for the whole selected fiscal year, whatever the time view.
	measure 'FY Budget Amount' =
			VAR _fiscal_year  = [_Sel FY]
			RETURN
			    CALCULATE (
			        [_Amt Budget]
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[fiscal_year] = _fiscal_year
			    )
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: 277d212d-094b-532d-a379-16d2e4ae1667

	/// Latest estimate for the whole selected fiscal year: _Amt Window with base Latest estimate over the full year, so Actual on closed months plus the latest forecast on open months in one evaluation.
	measure 'FY LE Amount' =
			CALCULATE (
			    [_Amt Window]
			    ,REMOVEFILTERS ( param_eval )
			    ,TREATAS ( { "BASE" }, param_eval[eval_code] )
			    ,REMOVEFILTERS ( param_base_version )
			    ,TREATAS ( { "LE" }, param_base_version[choice_code] )
			    ,REMOVEFILTERS ( param_time_view )
			    ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: 0f33f4ea-bf4f-59a8-9247-16047aceaa2d

	/// Comparison used by the bridge and largest variances: Compare A, else Compare B, else prior year. One evaluation. Unscaled.
	measure 'Bridge Comparison Amount' =
			VAR _compare_a    = [_Sel Compare A]
			VAR _compare_b    = [_Sel Compare B]
			VAR _use_b        = _compare_a = "NONE" && _compare_b <> "NONE"
			VAR _choice_a     = IF ( _compare_a = "NONE" && _compare_b = "NONE", "PY", _compare_a )
			RETURN
			    CALCULATE (
			        [_Amt Window]
			        ,REMOVEFILTERS ( param_eval )
			        ,TREATAS ( { IF ( _use_b, "CMP_B", "CMP_A" ) }, param_eval[eval_code] )
			        ,REMOVEFILTERS ( param_compare_a )
			        ,TREATAS ( { _choice_a }, param_compare_a[choice_code] )
			    )
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions
		lineageTag: c67dfec0-3fa4-57c2-8a6e-bfa6bf315601

	/// Gross revenue (step 1), base version and window.
	measure 'Gross Revenue' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "GR"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 0730023b-852f-5f93-907d-96645adf5d6b

	/// Gross-to-net deductions (step 2, negative).
	measure 'Gross-to-Net Deductions' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "GTN"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 6c303c7e-80c0-50ac-86c4-62ab1b3f43ae

	/// Net revenue = gross revenue + gross-to-net deductions (step 3).
	measure 'Net Revenue' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NR"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 099e66dc-0294-5070-9ee0-f9b59a26051a

	/// Gross profit = net revenue + cost of revenue (step 5).
	measure 'Gross Profit' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "GP"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: ef7bbbfa-b494-5011-aa1b-ca0e6ec6ba6b

	/// Contribution margin = gross profit + variable selling & cost-to-serve (step 7).
	measure 'Contribution Margin' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "CM"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: cc3e1b55-bfeb-5985-853e-acc8307badde

	/// Adjusted EBITDA = contribution margin + operating expenses (step 9, MPM).
	measure 'Adjusted EBITDA' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "EBITDA"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 48fecdfe-e020-52a6-a4b1-76de0b9faf8d

	/// Operating profit (step 13, IFRS 18 required subtotal).
	measure 'Operating Profit' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "OP"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: cc2c670f-5562-5d7c-8b45-bca53e4304a1

	/// Profit before tax (step 17).
	measure 'Profit Before Tax' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "PBT"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: a16b1fcc-cfbb-5730-9d0f-7fd8bb6aeae7

	/// Income tax expense (step 18, negative).
	measure 'Income Tax' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "TAX"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 5fbe7d99-2577-5223-8a35-fc936a474ad1

	/// Net profit for the period (step 19).
	measure 'Net Profit' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NP"
			)
		formatString: #,0;-#,0;0
		displayFolder: 2 Versions\Subtotals
		lineageTag: 796c8c01-4f90-5e60-a4f7-ad22f19e307f

	/// Statement column Base in the selected units (display only; ratios unscaled).
	measure 'PL Base' =
			VAR _value        = [_PL Base]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
		lineageTag: 78669446-9c7e-5935-9a54-e5df579b1a55

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    SWITCH (
				        TRUE ()
				        ,[_PL Is Ratio]
				            ,"0.0%"
				        ,_units = "K"
				            ,"#,0;−#,0;0"
				        ,"#,0.0;−#,0.0;0.0"
				    )

	/// Row value / net revenue of the same column (unscaled inputs). Blank on ratio rows.
	measure 'PL % NR' =
			IF (
			    [_PL Is Ratio]
			    ,BLANK ()
			    ,DIVIDE (
			        [_PL Base]
			        ,CALCULATE (
			            [Base Amount]
			            ,REMOVEFILTERS ( dim_pl_row )
			            ,dim_pl_row[line_code] = "NR"
			        )
			    )
			)
		formatString: 0.0%;−0.0%;0.0%
		displayFolder: 1 Statement
		lineageTag: d7cb4fa7-1427-5b75-bf91-46eb44f119d7

	/// Statement column Compare A in the selected units (display only).
	measure 'PL Compare A' =
			VAR _value        = [_PL Compare A]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
		lineageTag: 61a3c093-9751-597a-9501-58b6b3ee3fb2

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    SWITCH (
				        TRUE ()
				        ,[_PL Is Ratio]
				            ,"0.0%"
				        ,_units = "K"
				            ,"#,0;−#,0;0"
				        ,"#,0.0;−#,0.0;0.0"
				    )

	/// Base - Compare A in the selected units: positive is favourable on every line. Ratio rows in percentage points (M-11).
	measure 'PL Δ A' =
			VAR _value        = [_PL Δ A]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
		lineageTag: 5622a410-4581-552b-8b9d-b62c345f0dae

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    SWITCH (
				        TRUE ()
				        ,[_PL Is Ratio]
				            ,"+0.0"" pp"";−0.0"" pp"";0.0"" pp"""
				        ,_units = "K"
				            ,"+#,0;−#,0;0"
				        ,"+#,0.0;−#,0.0;0.0"
				    )

	/// (Base - Compare A) / |Compare A| on unscaled values. Blank on ratio rows.
	measure 'PL Δ A %' =
			VAR _compare      = [_PL Compare A]
			RETURN
			    IF (
			        [_PL Is Ratio] || ISBLANK ( _compare )
			        ,BLANK ()
			        ,DIVIDE ( [_PL Base] - _compare, ABS ( _compare ) )
			    )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 1 Statement
		lineageTag: 670b2a79-3d8e-5495-a378-fae96b34f162

	/// Statement column Compare B in the selected units (display only).
	measure 'PL Compare B' =
			VAR _value        = [_PL Compare B]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
		lineageTag: 113823fb-5728-5484-8273-c73642c54cd9

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    SWITCH (
				        TRUE ()
				        ,[_PL Is Ratio]
				            ,"0.0%"
				        ,_units = "K"
				            ,"#,0;−#,0;0"
				        ,"#,0.0;−#,0.0;0.0"
				    )

	/// Base - Compare B in the selected units; ratio rows in pp.
	measure 'PL Δ B' =
			VAR _value        = [_PL Δ B]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
		lineageTag: 7e604155-bdc3-5961-be74-a0e0989fe6c1

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    SWITCH (
				        TRUE ()
				        ,[_PL Is Ratio]
				            ,"+0.0"" pp"";−0.0"" pp"";0.0"" pp"""
				        ,_units = "K"
				            ,"+#,0;−#,0;0"
				        ,"+#,0.0;−#,0.0;0.0"
				    )

	/// (Base - Compare B) / |Compare B| on unscaled values. Blank on ratio rows.
	measure 'PL Δ B %' =
			VAR _compare      = [_PL Compare B]
			RETURN
			    IF (
			        [_PL Is Ratio] || ISBLANK ( _compare )
			        ,BLANK ()
			        ,DIVIDE ( [_PL Base] - _compare, ABS ( _compare ) )
			    )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 1 Statement
