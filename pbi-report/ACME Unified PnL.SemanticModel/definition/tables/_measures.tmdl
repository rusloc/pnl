	/// Net revenue of the bridge comparison (actual rates).
	measure 'Bridge Comparison NR' =
			CALCULATE (
			    [Bridge Comparison Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NR"
			)
		formatString: #,0;-#,0;0
		displayFolder: 4 Analysis
		lineageTag: 8d386238-e773-5053-94d8-bf6241534080

	/// Net revenue of the bridge comparison at constant currency.
	measure '_NR CC Bridge Cmp' =
			CALCULATE (
			    [Bridge Comparison Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NR"
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9f09998e-cb61-5df7-b94e-bf605896b889

	/// Units of the bridge comparison.
	measure '_Units Bridge Cmp' =
			CALCULATE (
			    [Bridge Comparison Amount]
			    ,REMOVEFILTERS ( param_metric )
			    ,TREATAS ( { "UNITS" }, param_metric[metric_code] )
			)
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 707fe91b-864f-5e9c-a9e0-dbaff1ee5e5e

	/// Change in net revenue at constant currency (base - comparison).
	measure '_Bridge NR CC Change' = [_NR CC Base] - [_NR CC Bridge Cmp]
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 604292cc-91d5-59bb-a94a-c7336ff537ea

	/// Eliminations step of the Group bridge (C-40): change at constant currency of the eliminated intercompany revenue (account ELIM_GR, base - comparison). Consumer Products + Commerce Cloud + this step = the Group NR change at constant currency, so comparison + steps = base NR (T-05).
	measure '_Bridge Elim Change' =
			VAR _elim_base    =
			    CALCULATE (
			        [Base Amount]
			        ,REMOVEFILTERS ( dim_pl_row )
			        ,KEEPFILTERS ( TREATAS ( { "ELIM_GR" }, dim_account[account_code] ) )
			        ,REMOVEFILTERS ( param_fx_basis )
			        ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			    )
			VAR _elim_cmp     =
			    CALCULATE (
			        [Bridge Comparison Amount]
			        ,REMOVEFILTERS ( dim_pl_row )
			        ,KEEPFILTERS ( TREATAS ( { "ELIM_GR" }, dim_account[account_code] ) )
			        ,REMOVEFILTERS ( param_fx_basis )
			        ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			    )
			RETURN
			    _elim_base - _elim_cmp
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 9 Engine
		lineageTag: a76db673-6fb0-5236-8777-50a6f87e4566

	/// Consumer Products volume step, per lowest slice k (region x channel x category x tier): (U base - U comparison) x NRcc comparison / U comparison. A slice without comparison units counts entirely as volume. Set-based: one grouped pass over the slices with the base window (_Amt Window rules, read from param_eval) and the bridge comparison window (Bridge Comparison Amount rules), NR at constant currency (budget rate of the selected year, per region currency). Same result as evaluating the engine per slice.
	measure 'Bridge Volume' =
			VAR _view         = [_Sel Entity]
			VAR _eval         = [_Sel Eval]
			VAR _compare_a    = [_Sel Compare A]
			VAR _compare_b    = [_Sel Compare B]
			VAR _base_choice  =
			    SWITCH (
			        _eval
			        ,"CMP_A"
			            ,_compare_a
			        ,"CMP_B"
			            ,_compare_b
			        ,[_Sel Base Version]
			    )
			VAR _cmp_choice   =
			    SWITCH (
			        TRUE ()
			        ,_compare_a = "NONE" && _compare_b <> "NONE"
			            ,_compare_b
			        ,_compare_a = "NONE"
			            ,"PY"
			        ,_compare_a
			    )
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _base_shift   = IF ( _base_choice = "PY", 12, 0 )
			VAR _cmp_shift    = IF ( _cmp_choice = "PY", 12, 0 )
			VAR _versions     = ALL ( dim_version[version_key], dim_version[is_latest_forecast] )
			VAR _months       = ALL ( dim_month[month_key], dim_month[month_index], dim_month[is_closed] )
			VAR _base_pairs   =
			    SELECTCOLUMNS (
			        FILTER (
			            CROSSJOIN ( _versions, _months )
			            ,_base_choice <> "NONE"
			                && dim_month[month_index] >= _start - _base_shift
			                && dim_month[month_index] <= _end - _base_shift
			                && SWITCH (
			                    _base_choice
			                    ,"B"
			                        ,dim_version[version_key] = "BUD"
			                    ,"LE"
			                        ,( dim_version[version_key] = "ACT" && dim_month[is_closed] )
			                            || ( dim_version[is_latest_forecast] && NOT dim_month[is_closed] )
			                    ,dim_version[version_key] = "ACT"
			                )
			        )
			        ,"@version_key", dim_version[version_key]
			        ,"@month_key", dim_month[month_key]
			    )
			VAR _cmp_pairs    =
			    SELECTCOLUMNS (
			        FILTER (
			            CROSSJOIN ( _versions, _months )
			            ,dim_month[month_index] >= _start - _cmp_shift
			                && dim_month[month_index] <= _end - _cmp_shift
			                && SWITCH (
			                    _cmp_choice
			                    ,"B"
			                        ,dim_version[version_key] = "BUD"
			                    ,"LE"
			                        ,( dim_version[version_key] = "ACT" && dim_month[is_closed] )
			                            || ( dim_version[is_latest_forecast] && NOT dim_month[is_closed] )
			                    ,dim_version[version_key] = "ACT"
			                )
			        )
			        ,"@version_key", dim_version[version_key]
			        ,"@month_key", dim_month[month_key]
			    )
			VAR _nr_sort      =
			    CALCULATE (
			        MAX ( dim_pl_row[line_sort] )
			        ,REMOVEFILTERS ( dim_pl_row )
			        ,dim_pl_row[line_code] = "NR"
			    )
			VAR _nr_blocks    =
			    CALCULATETABLE (
			        VALUES ( dim_report_line[block_code] )
			        ,REMOVEFILTERS ( dim_report_line )
			        ,dim_report_line[row_type] = "input_block"
			        ,dim_report_line[sort_order] < _nr_sort
			    )
			VAR _nr_accounts  =
			    CALCULATETABLE (
			        VALUES ( dim_account[account_code] )
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _nr_blocks, dim_account[block_code] )
			    )
			VAR _rep_currency = [_Sel Currency]
			VAR _cc_month     = FORMAT ( [_Sel FY], "0" ) & "-01"
			VAR _rep_rate     =
			    LOOKUPVALUE (
			        fact_fx_rate[local_per_usd]
			        ,fact_fx_rate[currency_code], _rep_currency
			        ,fact_fx_rate[month_key], _cc_month
			        ,fact_fx_rate[rate_type], "BUDGET"
			    )
			VAR _factors      =
			    ADDCOLUMNS (
			        ALL ( dim_region[region_code], dim_region[functional_currency] )
			        ,"@factor",
			            VAR _local_rate  =
			                LOOKUPVALUE (
			                    fact_fx_rate[local_per_usd]
			                    ,fact_fx_rate[currency_code], dim_region[functional_currency]
			                    ,fact_fx_rate[month_key], _cc_month
			                    ,fact_fx_rate[rate_type], "BUDGET"
			                )
			            RETURN
			                DIVIDE ( _rep_rate, _local_rate )
			    )
			VAR _slices       =
			    CALCULATETABLE (
			        SUMMARIZE (
			            fact_pl
			            ,dim_region[region_code]
			            ,dim_channel[channel_code]
			            ,dim_line[line_code]
			            ,dim_segment[segment_code]
			        )
			        ,KEEPFILTERS ( TREATAS ( { "P" }, dim_entity[entity_code] ) )
			        ,dim_account[is_direct] = TRUE ()
			        ,REMOVEFILTERS ( dim_month )
			        ,REMOVEFILTERS ( dim_version )
			    )
			VAR _rows         =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            _slices
			            ,"@units_base",
			                CALCULATE (
			                    SUM ( fact_operational[units_sold] )
			                    ,TREATAS ( _base_pairs, dim_version[version_key], dim_month[month_key] )
			                )
			            ,"@units_cmp",
			                CALCULATE (
			                    SUM ( fact_operational[units_sold] )
			                    ,TREATAS ( _cmp_pairs, dim_version[version_key], dim_month[month_key] )
			                )
			            ,"@nr_base",
			                CALCULATE (
			                    CALCULATE (
			                        SUM ( fact_pl[amount_local] )
			                        ,KEEPFILTERS ( dim_account[is_direct] = TRUE () )
			                    )
			                        + SUM ( fact_pl_allocated[amount_local] )
			                    ,TREATAS ( _base_pairs, dim_version[version_key], dim_month[month_key] )
			                    ,TREATAS ( _nr_accounts, dim_account[account_code] )
			                )
			            ,"@nr_cmp",
			                CALCULATE (
			                    CALCULATE (
			                        SUM ( fact_pl[amount_local] )
			                        ,KEEPFILTERS ( dim_account[is_direct] = TRUE () )
			                    )
			                        + SUM ( fact_pl_allocated[amount_local] )
			                    ,TREATAS ( _cmp_pairs, dim_version[version_key], dim_month[month_key] )
			                    ,TREATAS ( _nr_accounts, dim_account[account_code] )
			                )
			        )
			        ,KEEPFILTERS ( TREATAS ( { "P" }, dim_entity[entity_code] ) )
			        ,REMOVEFILTERS ( dim_month )
			        ,REMOVEFILTERS ( dim_version )
			    )
			VAR _volume       =
			    SUMX (
			        _rows
			        ,VAR _region      = dim_region[region_code]
			         VAR _factor      = MAXX ( FILTER ( _factors, dim_region[region_code] = _region ), [@factor] )
			         VAR _units_base  = [@units_base]
			         VAR _units_cmp   = [@units_cmp]
			         VAR _nr_cc_base  = CONVERT ( [@nr_base], DOUBLE ) * _factor
			         VAR _nr_cc_cmp   = CONVERT ( [@nr_cmp], DOUBLE ) * _factor
			         RETURN
			             IF (
			                 _units_cmp = 0
			                 ,_nr_cc_base - _nr_cc_cmp
			                 ,( _units_base - _units_cmp ) * DIVIDE ( _nr_cc_cmp, _units_cmp )
			             )
			    )
			RETURN
			    IF ( _view = "P", _volume )
		formatString: #,0;-#,0;0
		displayFolder: 4 Analysis
		lineageTag: 09b158ce-61a2-53bc-93e2-3a892555c3c5

	/// Consumer Products price / mix step = NR change at constant currency - volume (so steps add up exactly).
	measure 'Bridge Price Mix' = IF ( [_Sel Entity] = "P", [_Bridge NR CC Change] - [Bridge Volume] )
		formatString: #,0;-#,0;0
		displayFolder: 4 Analysis
		lineageTag: 7b69906a-0183-5c76-8e64-02f9ab79fa20

	/// FX = (NR base - NRcc base) - (NR comparison - NRcc comparison). Zero at constant currency.
	measure 'Bridge FX' =
			VAR _fx_base      = [Net Revenue] - [_NR CC Base]
			VAR _fx_cmp       = [Bridge Comparison NR] - [_NR CC Bridge Cmp]
			RETURN
			    _fx_base - _fx_cmp
		formatString: #,0;-#,0;0
		displayFolder: 4 Analysis
		lineageTag: da40f515-d085-541c-9dae-264d36c6dc46

	/// Waterfall value per dim_bridge_step in the selected units (display only).
	measure 'Bridge Value' = DIVIDE ( [_Bridge Value], [_Units Divisor] )
		displayFolder: 4 Analysis
		lineageTag: 98632300-e722-50aa-b6ec-39be5d775aab

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    IF ( _units = "K", "#,0;−#,0;0", "#,0.0;−#,0.0;0.0" )

	/// Bridge volume vs prior year / prior-year NR at constant currency.
	measure 'KPI Volume Growth' =
			VAR _volume       =
			    CALCULATE (
			        [Bridge Volume]
			        ,REMOVEFILTERS ( param_compare_a )
			        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
			    )
			RETURN
			    DIVIDE ( _volume, [_PY NR CC] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: c2edb1e3-8e9b-5e37-b803-a05f665f55aa

	/// Bridge price / mix vs prior year / prior-year NR at constant currency.
	measure 'KPI Price Mix' =
			VAR _price_mix    =
			    CALCULATE (
			        [Bridge Price Mix]
			        ,REMOVEFILTERS ( param_compare_a )
			        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
			    )
			RETURN
			    DIVIDE ( _price_mix, [_PY NR CC] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: 863ee4cc-9162-5596-96b7-b06ceba8d085

	/// Value of the KPI tile in the current dim_kpi row, amounts and counts in the selected units (display only).
	measure 'KPI Value' =
			VAR _value        = [_KPI Value]
			RETURN
			    IF (
			        SELECTEDVALUE ( dim_kpi[value_type] ) IN { "AMT", "CNT" }
			        ,DIVIDE ( _value, [_Units Divisor] )
			        ,_value
			    )
		displayFolder: 3 KPIs
		lineageTag: b0d5079e-fb72-5bae-aa9b-e7fad8be6639

		formatStringDefinition =
				VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
				VAR _symbol       = SELECTEDVALUE ( param_reporting_currency[symbol], "$" )
				VAR _units        = [_Sel Units]
				VAR _q            = """"
				VAR _number       = IF ( _units = "K", "#,0", "#,0.0" )
				VAR _suffix       = _q & IF ( _units = "K", " k", " m" ) & _q
				RETURN
				    SWITCH (
				        _type
				        ,"AMT"
				            ,_q & _symbol & _q & _number & _suffix
				        ,"PCT"
				            ,"0.0%"
				        ,"PCT2"
				            ,"0.00%"
				        ,"CNT"
				            ,_number & _suffix
				        ,"INT"
				            ,"#,0"
				        ,"PRICE"
				            ,_q & _symbol & _q & "#,0.00"
				        ,"#,0.0"
				    )

	/// K-24 monthly trend of the KPI tile in the current dim_kpi row, for the month of dim_month in context (13 months ending at the selected month, base version, same filters); amounts and counts in the selected units like KPI Value (display only). Track A sparklines and the Track B tile sparklines read it.
	measure 'KPI Trend' =
			VAR _value        = [_KPI Trend Value]
			RETURN
			    IF (
			        SELECTEDVALUE ( dim_kpi[value_type] ) IN { "AMT", "CNT" }
			        ,DIVIDE ( _value, [_Units Divisor] )
			        ,_value
			    )
		displayFolder: 3 KPIs
		lineageTag: 8e41b7a2-3c6d-4e09-a5f8-71d2c9b04e6a

		formatStringDefinition =
				VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
				VAR _symbol       = SELECTEDVALUE ( param_reporting_currency[symbol], "$" )
				VAR _units        = [_Sel Units]
				VAR _q            = """"
				VAR _number       = IF ( _units = "K", "#,0", "#,0.0" )
				VAR _suffix       = _q & IF ( _units = "K", " k", " m" ) & _q
				RETURN
				    SWITCH (
				        _type
				        ,"AMT"
				            ,_q & _symbol & _q & _number & _suffix
				        ,"PCT"
				            ,"0.0%"
				        ,"PCT2"
				            ,"0.00%"
				        ,"CNT"
				            ,_number & _suffix
				        ,"INT"
				            ,"#,0"
				        ,"PRICE"
				            ,_q & _symbol & _q & "#,0.00"
				        ,"#,0.0"
				    )

	/// Tile sub-line: reported growth incl. FX for organic growth, margin for the amount tiles.
	measure 'KPI Secondary' =
			VAR _kpi          = SELECTEDVALUE ( dim_kpi[kpi_code] )
			RETURN
			    SWITCH (
			        _kpi
			        ,"ORG_GROWTH"
			            ,"Reported " & FORMAT ( [KPI Reported Growth], "+0.0%;-0.0%" )
			        ,"EBITDA"
			            ,"Margin " & FORMAT ( [KPI Adj EBITDA Margin], "0.0%" )
			        ,"OP"
			            ,"Margin " & FORMAT ( [KPI Operating Margin], "0.0%" )
			        ,"NP"
			            ,"Margin " & FORMAT ( [KPI Net Margin], "0.0%" )
			    )
		displayFolder: 3 KPIs
		lineageTag: 66b4916a-b84d-54e9-aa55-29f8c2be03f8

	/// KPI vs Compare A: percent KPIs in percentage points, amount KPIs in %.
	measure 'KPI Δ A' =
			VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
			VAR _value        = [_KPI Value]
			VAR _compare      =
			    CALCULATE (
			        [_KPI Value]
			        ,REMOVEFILTERS ( param_eval )
			        ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,[_Sel Compare A] = "NONE" || ISBLANK ( _compare ) || ISBLANK ( _value )
			            ,BLANK ()
			        ,_type IN { "PCT", "PCT2" }
			            ,( _value - _compare ) * 100
			        ,DIVIDE ( _value - _compare, ABS ( _compare ) )
			    )
		displayFolder: 3 KPIs
		lineageTag: cc9dcdb7-16a1-5ecd-bc04-232278222e2d

		formatStringDefinition =
				VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
				RETURN
				    IF ( _type IN { "PCT", "PCT2" }, "▲ +0.0"" pp"";▼ −0.0"" pp"";0.0"" pp""", "▲ +0.0%;▼ −0.0%;0.0%" )

	/// KPI vs Compare B: percent KPIs in percentage points, amount KPIs in %.
	measure 'KPI Δ B' =
			VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
			VAR _value        = [_KPI Value]
			VAR _compare      =
			    CALCULATE (
			        [_KPI Value]
			        ,REMOVEFILTERS ( param_eval )
			        ,TREATAS ( { "CMP_B" }, param_eval[eval_code] )
			    )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,[_Sel Compare B] = "NONE" || ISBLANK ( _compare ) || ISBLANK ( _value )
			            ,BLANK ()
			        ,_type IN { "PCT", "PCT2" }
			            ,( _value - _compare ) * 100
			        ,DIVIDE ( _value - _compare, ABS ( _compare ) )
			    )
		displayFolder: 3 KPIs
		lineageTag: 1a394fcc-c352-53af-9095-9ea7257576cc

		formatStringDefinition =
				VAR _type         = SELECTEDVALUE ( dim_kpi[value_type] )
				RETURN
				    IF ( _type IN { "PCT", "PCT2" }, "▲ +0.0"" pp"";▼ −0.0"" pp"";0.0"" pp""", "▲ +0.0%;▼ −0.0%;0.0%" )

	/// Colour of KPI Δ A following dim_kpi.better_when; Neutral KPIs are never coloured.
	measure 'KPI Δ A Color' =
			VAR _better       = SELECTEDVALUE ( dim_kpi[better_when] )
			VAR _delta        = [KPI Δ A]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _delta ) || _better = "Neutral" || _delta = 0
			            ,BLANK ()
			        ,( _delta > 0 && _better = "Higher" ) || ( _delta < 0 && _better = "Lower" )
			            ,"#06603F"
			        ,"#C2410C"
			    )
		displayFolder: 3 KPIs
		lineageTag: 35056b58-0c34-5310-9859-bf7be2deaf34

	/// Colour of KPI Δ B following dim_kpi.better_when; Neutral KPIs are never coloured.
	measure 'KPI Δ B Color' =
			VAR _better       = SELECTEDVALUE ( dim_kpi[better_when] )
			VAR _delta        = [KPI Δ B]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _delta ) || _better = "Neutral" || _delta = 0
			            ,BLANK ()
			        ,( _delta > 0 && _better = "Higher" ) || ( _delta < 0 && _better = "Lower" )
			            ,"#06603F"
			        ,"#C2410C"
			    )
		displayFolder: 3 KPIs
		lineageTag: 0bed7a7e-86ab-53d8-88e1-83fa5b336cff

	/// Base amount of the leaf line (account) in the current row, in the selected units (display only).
	measure 'LV Base' = DIVIDE ( [Base Amount], [_Units Divisor] )
		displayFolder: 4 Analysis
		lineageTag: fbc9940c-8d0c-5a04-9d1a-53a33064e4b7

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    IF ( _units = "K", "#,0;−#,0;0", "#,0.0;−#,0.0;0.0" )

	/// Bridge-comparison amount of the leaf line, in the selected units (display only).
	measure 'LV Comparison' = DIVIDE ( [Bridge Comparison Amount], [_Units Divisor] )
		displayFolder: 4 Analysis
		lineageTag: f0b51fca-a716-5493-b43e-cc3f3794c740

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    IF ( _units = "K", "#,0;−#,0;0", "#,0.0;−#,0.0;0.0" )

	/// Base - comparison on signed values (positive = favourable), in the selected units (display only).
	measure 'LV Δ' =
			VAR _base         = [Base Amount]
			VAR _compare      = [Bridge Comparison Amount]
			RETURN
			    IF ( ISBLANK ( _base ) && ISBLANK ( _compare ), BLANK (), DIVIDE ( _base - _compare, [_Units Divisor] ) )
		displayFolder: 4 Analysis
		lineageTag: 68aafeba-dbc0-53d1-b204-1b71e0877021

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    IF ( _units = "K", "+#,0;−#,0;0", "+#,0.0;−#,0.0;0.0" )

	/// (Base - comparison) / |comparison| on unscaled values.
	measure 'LV Δ %' =
			VAR _base         = [Base Amount]
			VAR _compare      = [Bridge Comparison Amount]
			RETURN
			    IF ( ISBLANK ( _base ) && ISBLANK ( _compare ), BLANK (), DIVIDE ( _base - _compare, ABS ( _compare ) ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 4 Analysis
		lineageTag: bbf0d090-9054-58b7-aeef-261a33e8f983

	/// |base - comparison|, unscaled — ranks the top 8 leaf lines (TopN filter of the variances table).
	measure 'LV Abs Δ' = ABS ( [Base Amount] - [Bridge Comparison Amount] )
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 4 Analysis
		lineageTag: 33a81bec-2b6f-5ee7-900b-e51958c5664f

	/// Green favourable / red unfavourable for the variances table (sign of base - comparison).
	measure 'LV Δ Color' =
			VAR _base         = [Base Amount]
			VAR _compare      = [Bridge Comparison Amount]
			VAR _delta        = IF ( ISBLANK ( _base ) && ISBLANK ( _compare ), BLANK (), _base - _compare )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_delta > 0
			            ,"#06603F"
			        ,_delta < 0
			            ,"#C2410C"
			        ,BLANK ()
			    )
		displayFolder: 4 Analysis
		lineageTag: f8c9bbb9-8beb-5eae-b263-f911bc35bdf1

	/// Share of total net revenue across the visible slice values.
	measure 'Prof NR Share' =
			VAR _total        =
			    CALCULATE (
			        [Net Revenue]
			        ,ALLSELECTED ( dim_region )
			        ,ALLSELECTED ( dim_channel )
			        ,ALLSELECTED ( dim_line )
			        ,ALLSELECTED ( dim_segment )
			        ,ALLSELECTED ( dim_entity )
			    )
			RETURN
			    DIVIDE ( [Net Revenue], _total )
		formatString: 0.0%
		displayFolder: 5 Profitability
		lineageTag: 64b13236-c45c-5797-824f-dde0990de683

	/// Net revenue growth vs the bridge comparison.
	measure 'Prof NR Δ %' =
			VAR _compare      = [Bridge Comparison NR]
			RETURN
			    DIVIDE ( [Net Revenue] - _compare, ABS ( _compare ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 5 Profitability
		lineageTag: 23b606f6-e219-5115-9958-0e4bac67717a

	/// Green / red for net revenue growth.
	measure 'Prof NR Δ Color' =
			VAR _delta        = [Prof NR Δ %]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_delta > 0
			            ,"#06603F"
			        ,_delta < 0
			            ,"#C2410C"
			        ,BLANK ()
			    )
		displayFolder: 5 Profitability
		lineageTag: 8a962a24-464b-5ebf-9b5b-f2bce7c04c67

	/// 1 when the slice value in context belongs to the selected entity (unassigned and blank members excluded). Region always; entity rows only in the Group view; channel / category / segment never in the Group view. Used as visual-level filter on slicers and the profitability table.
	measure 'Slice Member In View' =
			VAR _view         = [_Sel Entity]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISINSCOPE ( dim_region[region_name] )
			            ,IF ( NOT ISBLANK ( SELECTEDVALUE ( dim_region[region_name] ) ), 1 )
			        ,ISINSCOPE ( dim_entity[short_name] )
			            ,IF ( _view = "GROUP" && NOT ISBLANK ( SELECTEDVALUE ( dim_entity[short_name] ) ), 1 )
			        ,ISINSCOPE ( dim_channel[channel_name] )
			            ,IF (
			                _view <> "GROUP"
			                    && SELECTEDVALUE ( dim_channel[entity_code] ) = _view
			                    && SELECTEDVALUE ( dim_channel[is_unassigned] ) = FALSE ()
			                ,1
			            )
			        ,ISINSCOPE ( dim_line[line_name] )
			            ,IF (
			                _view <> "GROUP"
			                    && SELECTEDVALUE ( dim_line[entity_code] ) = _view
			                    && SELECTEDVALUE ( dim_line[is_unassigned] ) = FALSE ()
			                ,1
			            )
			        ,ISINSCOPE ( dim_segment[segment_name] )
			            ,IF (
			                _view <> "GROUP"
			                    && SELECTEDVALUE ( dim_segment[entity_code] ) = _view
			                    && SELECTEDVALUE ( dim_segment[is_unassigned] ) = FALSE ()
			                ,1
			            )
			    )
		formatString: 0
		displayFolder: 5 Profitability
		lineageTag: d2f653d7-c985-59f0-876f-ee0ace68dfaf

	/// Header data status: last closed month and last refresh time.
	measure 'Data Status' =
			VAR _last_closed  = [_Last Closed Index]
			VAR _closed_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			VAR _refreshed    = MAX ( _meta_refresh[refreshed_at] )
			RETURN
			    "Closed through " & _closed_label & "  ·  Refreshed " & FORMAT ( _refreshed, "dd mmm yyyy hh:nn" )
		displayFolder: 6 Context
		lineageTag: 481348e5-bfdc-5c5d-a1cb-663d5027e98f

	/// Plain-text context: entity, window with actual months, base vs comparisons, currency / units / FX basis, active slices.
	measure 'Context Line' =
			VAR _view         = [_Sel Entity]
			VAR _entity       =
			    CALCULATE (
			        MAX ( param_entity_view[entity_view_name] )
			        ,REMOVEFILTERS ( param_entity_view )
			        ,param_entity_view[entity_view_code] = _view
			    )
			VAR _time_code    = [_Sel Time View]
			VAR _time_view    =
			    CALCULATE (
			        MAX ( param_time_view[time_view_name] )
			        ,REMOVEFILTERS ( param_time_view )
			        ,param_time_view[time_view_code] = _time_code
			    )
			VAR _start        = MAX ( [_Win Start], 0 )
			VAR _end          = [_Win End]
			VAR _start_label  =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _start
			    )
			VAR _end_label    =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			VAR _actual_n     =
			    CALCULATE (
			        COUNTROWS ( dim_month )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] >= _start && dim_month[month_index] <= _end
			        ,dim_month[is_closed] = TRUE ()
			    )
			VAR _window       =
			    IF (
			        _end < _start
			        ,_time_view & ": no closed months in window"
			        ,_time_view & " " & _start_label & " – " & _end_label & " (" & FORMAT ( _actual_n + 0, "0" ) & " actual)"
			    )
			VAR _base         = SWITCH ( [_Sel Base Version], "LE", "Latest estimate", "B", "Budget", "Actual" )
			VAR _compare_a    = SWITCH ( [_Sel Compare A], "B", "Budget", "LE", "Latest estimate", "PY", "Prior year", "none" )
			VAR _compare_b    = SWITCH ( [_Sel Compare B], "B", "Budget", "LE", "Latest estimate", "PY", "Prior year", "none" )
			VAR _fx           =
			    IF ( [_Sel FX Basis] = "CC", "constant currency (FY" & [_Sel FY] & " budget rates)", "actual rates" )
			VAR _units        = IF ( [_Sel Units] = "K", "k", "m" )
			VAR _regions      =
			    IF (
			        ISFILTERED ( dim_region[region_name] )
			        ,CONCATENATEX ( VALUES ( dim_region[region_name] ), dim_region[region_name], ", ", dim_region[region_name], ASC )
			        ,"All regions"
			    )
			VAR _slices       =
			    IF (
			        _view <> "GROUP"
			        ,IF (
			            ISFILTERED ( dim_channel[channel_name] )
			            ,"  ·  " & CONCATENATEX (
			                CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), KEEPFILTERS ( dim_channel[entity_code] = _view ) )
			                ,dim_channel[channel_name]
			                ,", "
			            )
			        )
			            & IF (
			                ISFILTERED ( dim_line[line_name] )
			                ,"  ·  " & CONCATENATEX (
			                    CALCULATETABLE ( VALUES ( dim_line[line_name] ), KEEPFILTERS ( dim_line[entity_code] = _view ) )
			                    ,dim_line[line_name]
			                    ,", "
			                )
			            )
			            & IF (
			                ISFILTERED ( dim_segment[segment_name] )
			                ,"  ·  " & CONCATENATEX (
			                    CALCULATETABLE ( VALUES ( dim_segment[segment_name] ), KEEPFILTERS ( dim_segment[entity_code] = _view ) )
			                    ,dim_segment[segment_name]
			                    ,", "
			                )
			            )
			    )
			RETURN
			    _entity & "  ·  " & _window
			        & "  -  " & UNICHAR(10) & _base & " vs " & _compare_a & " (A) / " & _compare_b & " (B)"
			        & "  -  " & UNICHAR(10) & [_Sel Currency] & " " & _units & ", " & _fx
			        & "  -  " & UNICHAR(10) &_regions & _slices
		displayFolder: 6 Context
		lineageTag: 4d47d998-e424-5c0c-8cc9-11caac392a24

	/// Notices shown only when they apply: past the close, forecast months included, prior year missing, LTM before history, slice allocation on, group eliminations.
	measure Notices =
			VAR _last_closed  = [_Last Closed Index]
			VAR _base         = [_Sel Base Version]
			VAR _start        = [_Win Start]
			VAR _end_raw      = [_Win End Raw]
			VAR _first_label  =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = 0
			    )
			VAR _closed_label =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _last_closed
			    )
			VAR _open_from    =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = MAX ( _last_closed + 1, _start )
			    )
			VAR _open_to      =
			    CALCULATE (
			        MAX ( dim_month[month_name] ) & " " & MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end_raw
			    )
			VAR _forecast     =
			    CALCULATE (
			        MAX ( dim_version[version_name] )
			        ,REMOVEFILTERS ( dim_version )
			        ,dim_version[is_latest_forecast] = TRUE ()
			    )
			VAR _uses_py      = [_Sel Compare A] = "PY" || [_Sel Compare B] = "PY"
			VAR _slice_on     =
			    ISFILTERED ( dim_channel[channel_name] )
			        || ISFILTERED ( dim_line[line_name] )
			        || ISFILTERED ( dim_segment[segment_name] )
			VAR _is_group     = [_Sel Entity] = "GROUP"
			VAR _n_close      =
			    IF ( _base = "A" && _end_raw > _last_closed, "Actuals closed through " & _closed_label & ": later months excluded; use Latest estimate for the full window" )
			VAR _n_forecast   =
			    IF ( _base = "LE" && _end_raw > _last_closed, "Forecast months included: " & _open_from & " – " & _open_to & " (" & _forecast & ")" )
			VAR _n_py         = IF ( _uses_py && _start - 12 < 0, "Prior year n/a before " & _first_label )
			VAR _n_ltm        = IF ( [_Sel Time View] = "LTM" && _start < 0, "LTM starts before the data history (" & _first_label & ")" )
			VAR _n_alloc      = IF ( _slice_on && NOT _is_group, "Slice filter on: lines from operating expenses down are allocated by net-revenue share" )
			VAR _n_group      = IF ( _is_group, "ACME Group: Commerce Cloud fees billed to Consumer Products are eliminated" )
			VAR _list         = { _n_close, _n_forecast, _n_py, _n_ltm, _n_alloc, _n_group }
			RETURN
			    CONCATENATEX ( FILTER ( _list, LEN ( [Value] ) > 0 ), [Value], "   |   " )
		displayFolder: 6 Context
		lineageTag: c2b490f0-8e10-549e-8823-48ecaea81c7c

	/// Note in the Slice pop-up: why slices are off in the Group view, or the allocation rule.
	measure 'Slice Panel Note' =
			IF (
			    [_Sel Entity] = "GROUP"
			    ,"Group view: channel, category and segment read All (consolidated) because their values differ by entity. Region still applies."
			    ,"Slices apply to every view. Lines from operating expenses down are allocated to slices by net-revenue share."
			)
		displayFolder: 6 Context
		lineageTag: ffa64f74-31fe-5b5b-8a67-d1356b9fc6ad

	/// Hint above the profitability table.
	measure 'Profitability Note' =
			IF (
			    [_Sel Entity] = "GROUP"
			    ,"Group view: break down by Region or Entity. Regions and entities include their own eliminations."
			    ,"EBITDA and operating margins by slice are indicative: lines below contribution margin are allocated by NR share."
			)
		displayFolder: 6 Context
		lineageTag: aa4431bb-43fb-5d3b-b68a-f18aaa48d3c4

	/// Divisor of the selected display units (1,000,000 for Millions, 1,000 for Thousands). Used only by display measures bound to visuals; engine measures, ratios and Δ % stay unscaled.
	measure '_Units Divisor' =
			VAR _default      =
			    CALCULATE (
			        MAX ( param_units[divisor] )
			        ,REMOVEFILTERS ( param_units )
			        ,param_units[is_default] = TRUE ()
			    )
			RETURN
			    SELECTEDVALUE ( param_units[divisor], _default )
		isHidden
		displayFolder: 9 Engine
		lineageTag: b3f22c98-da67-5910-8693-8e6438ddd556

	/// TRUE on a statement ratio row (not on leaves).
	measure '_PL Is Ratio' =
			NOT ISINSCOPE ( dim_pl_row[account_label] )
			    && SELECTEDVALUE ( dim_pl_row[row_type] ) = "ratio"
		isHidden
		displayFolder: 9 Engine
		lineageTag: 14066913-343b-5e91-9648-9c41a0ec5dbe

	/// Version over the window in one evaluation, read from param_eval: BASE = base version over the base window; CMP_A / CMP_B = that comparison over the months the base covers (Prior year: shifted 12 back, Actual). The version is a (version, month) filter: Actual / Prior year = ACT, Budget = BUD, Latest estimate = ACT on closed months + latest forecast on open months. Blank when the comparison is None.
	measure '_Amt Window' =
			VAR _eval         = [_Sel Eval]
			VAR _choice       =
			    SWITCH (
			        _eval
			        ,"CMP_A"
			            ,[_Sel Compare A]
			        ,"CMP_B"
			            ,[_Sel Compare B]
			        ,[_Sel Base Version]
			    )
			VAR _shift        = IF ( _choice = "PY", 12, 0 )
			VAR _start        = [_Win Start] - _shift
			VAR _end          = [_Win End] - _shift
			VAR _months       =
			    FILTER (
			        ALL ( dim_month[month_key], dim_month[month_index], dim_month[is_closed] )
			        ,dim_month[month_index] >= _start
			            && dim_month[month_index] <= _end
			    )
			VAR _pairs        =
			    FILTER (
			        CROSSJOIN (
			            ALL ( dim_version[version_key], dim_version[is_latest_forecast] )
			            ,_months
			        )
			        ,SWITCH (
			            _choice
			            ,"B"
			                ,dim_version[version_key] = "BUD"
			            ,"LE"
			                ,( dim_version[version_key] = "ACT" && dim_month[is_closed] )
			                    || ( dim_version[is_latest_forecast] && NOT dim_month[is_closed] )
			            ,dim_version[version_key] = "ACT"
			        )
			    )
			VAR _filter       =
			    SELECTCOLUMNS (
			        _pairs
			        ,"@version_key", dim_version[version_key]
			        ,"@month_key", dim_month[month_key]
			    )
			RETURN
			    IF (
			        _choice <> "NONE"
			        ,CALCULATE (
			            [_Amt Row]
			            ,REMOVEFILTERS ( dim_version )
			            ,REMOVEFILTERS ( dim_month )
			            ,TREATAS ( _filter, dim_version[version_key], dim_month[month_key] )
			        )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 7fee96ff-0947-5d81-b112-2acdb858cc38

	/// Statement Base, unscaled. Ratio rows divide their numerator line by net revenue (ETR: -tax / PBT). Blocks and subtotals show 0 instead of blank so they never hide (M-22, T-16).
	measure '_PL Base' =
			VAR _is_ratio     = [_PL Is Ratio]
			VAR _value        =
			    IF (
			        [_PL Is Ratio]
			        ,DIVIDE (
			            SELECTEDVALUE ( dim_pl_row[ratio_sign], 1 )
			                * CALCULATE (
			                    [Base Amount]
			                    ,REMOVEFILTERS ( dim_pl_row )
			                    ,TREATAS ( VALUES ( dim_pl_row[ratio_num_line] ), dim_pl_row[line_code] )
			                )
			            ,CALCULATE (
			                [Base Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( VALUES ( dim_pl_row[ratio_den_line] ), dim_pl_row[line_code] )
			            )
			        )
			        ,[Base Amount]
			    )
			VAR _is_line      = NOT ISINSCOPE ( dim_pl_row[account_label] ) && NOT _is_ratio && HASONEVALUE ( dim_pl_row[line_code] )
			RETURN
			    IF ( _is_line && ISBLANK ( _value ), 0, _value )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9fcce8d8-17ed-5dde-8662-a492b1cac546

	/// Statement Compare A (same months as the base), unscaled.
	measure '_PL Compare A' =
			IF (
			    [_PL Is Ratio]
			    ,DIVIDE (
			        SELECTEDVALUE ( dim_pl_row[ratio_sign], 1 )
			            * CALCULATE (
			                [Compare A Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( VALUES ( dim_pl_row[ratio_num_line] ), dim_pl_row[line_code] )
			            )
			        ,CALCULATE (
			            [Compare A Amount]
			            ,REMOVEFILTERS ( dim_pl_row )
			            ,TREATAS ( VALUES ( dim_pl_row[ratio_den_line] ), dim_pl_row[line_code] )
			        )
			    )
			    ,[Compare A Amount]
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 60a0877d-d45e-57ee-8b9f-33258f80749c

	/// Statement Compare B (same months as the base), unscaled.
	measure '_PL Compare B' =
			IF (
			    [_PL Is Ratio]
			    ,DIVIDE (
			        SELECTEDVALUE ( dim_pl_row[ratio_sign], 1 )
			            * CALCULATE (
			                [Compare B Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( VALUES ( dim_pl_row[ratio_num_line] ), dim_pl_row[line_code] )
			            )
			        ,CALCULATE (
			            [Compare B Amount]
			            ,REMOVEFILTERS ( dim_pl_row )
			            ,TREATAS ( VALUES ( dim_pl_row[ratio_den_line] ), dim_pl_row[line_code] )
			        )
			    )
			    ,[Compare B Amount]
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 0db9be23-2760-50eb-8310-4feea3bf3e58

	/// Full-year budget of the selected fiscal year, unscaled.
	measure '_PL FY Budget' =
			IF (
			    [_PL Is Ratio]
			    ,DIVIDE (
			        SELECTEDVALUE ( dim_pl_row[ratio_sign], 1 )
			            * CALCULATE (
			                [FY Budget Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( VALUES ( dim_pl_row[ratio_num_line] ), dim_pl_row[line_code] )
			            )
			        ,CALCULATE (
			            [FY Budget Amount]
			            ,REMOVEFILTERS ( dim_pl_row )
			            ,TREATAS ( VALUES ( dim_pl_row[ratio_den_line] ), dim_pl_row[line_code] )
			        )
			    )
			    ,[FY Budget Amount]
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: d4367949-b057-5bd7-9efe-22257a9f7dc8

	/// Full-year latest estimate of the selected fiscal year, unscaled.
	measure '_PL FY LE' =
			IF (
			    [_PL Is Ratio]
			    ,DIVIDE (
			        SELECTEDVALUE ( dim_pl_row[ratio_sign], 1 )
			            * CALCULATE (
			                [FY LE Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( VALUES ( dim_pl_row[ratio_num_line] ), dim_pl_row[line_code] )
			            )
			        ,CALCULATE (
			            [FY LE Amount]
			            ,REMOVEFILTERS ( dim_pl_row )
			            ,TREATAS ( VALUES ( dim_pl_row[ratio_den_line] ), dim_pl_row[line_code] )
			        )
			    )
			    ,[FY LE Amount]
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 11562c3c-c789-5fa9-b269-f9fa07019ed6

	/// Base - Compare A on signed values, unscaled: positive is favourable on every line. Ratio rows in percentage points.
	measure '_PL Δ A' =
			VAR _compare      = [_PL Compare A]
			VAR _delta        = [_PL Base] - _compare
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _compare )
			            ,BLANK ()
			        ,[_PL Is Ratio]
			            ,_delta * 100
			        ,_delta
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 1a1bbd54-f347-573e-8d94-b509bdc03c5d

	/// Base - Compare B on signed values, unscaled; ratio rows in pp.
	measure '_PL Δ B' =
			VAR _compare      = [_PL Compare B]
			VAR _delta        = [_PL Base] - _compare
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _compare )
			            ,BLANK ()
			        ,[_PL Is Ratio]
			            ,_delta * 100
			        ,_delta
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 709e9716-c5ec-5c3e-88bf-c7774d02393f

	/// Full-year LE - full-year budget, unscaled; ratio rows in pp.
	measure '_PL Δ LE' =
			VAR _compare      = [_PL FY Budget]
			VAR _delta        = [_PL FY LE] - _compare
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _compare )
			            ,BLANK ()
			        ,[_PL Is Ratio]
			            ,_delta * 100
			        ,_delta
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4a8d1cb5-09a8-5e9e-99ac-b746820e2dcd

	/// Unscaled waterfall value per dim_bridge_step: comparison NR, then the entity's steps; blank for a step of another entity (its dim_bridge_step row is filtered out). Comparison + steps = base NR (T-05). Steps with the same formula share one branch (service lines, entities): every branch adds its measures to the query plan, used or not.
	measure '_Bridge Value' =
			VAR _step         = SELECTEDVALUE ( dim_bridge_step[step_code] )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_step = "START"
			            ,[Bridge Comparison NR]
			        ,_step = "FX"
			            ,[Bridge FX]
			        ,_step = "VOL"
			            ,[Bridge Volume]
			        ,_step = "PRICE"
			            ,[Bridge Price Mix]
			        ,_step IN { "SVC_SUB", "SVC_PAY", "SVC_APP", "SVC_PS" }
			            ,CALCULATE (
			                [_Bridge NR CC Change]
			                ,KEEPFILTERS ( TREATAS ( { MID ( _step, 5, 3 ) }, dim_line[line_code] ) )
			            )
			        ,_step IN { "ENT_P", "ENT_S" }
			            ,CALCULATE (
			                [_Bridge NR CC Change]
			                ,REMOVEFILTERS ( param_entity_view )
			                ,TREATAS ( { RIGHT ( _step, 1 ) }, param_entity_view[entity_view_code] )
			            )
			        ,_step = "ELIM"
			            ,[_Bridge Elim Change]
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: c7b84287-88c7-5e84-bb58-aaccb297cca8

	/// Unscaled value of the KPI tile in the current dim_kpi row (slots swap content by entity). Feeds KPI Δ A / Δ B. A code first maps to a family: line amounts (NR, EBITDA, OP, NP) and line ratios (GM %, CM %, GTN %, ETR, Products / Cloud operating margin) share one branch each, because every branch adds its measures to the query plan of a grid over dim_kpi; the simple SWITCH on the family keeps a single-code evaluation as cheap as a direct measure.
	measure '_KPI Value' =
			VAR _kpi          = SELECTEDVALUE ( dim_kpi[kpi_code] )
			VAR _family       =
			    SWITCH (
			        _kpi
			        ,"NR", "LINE"
			        ,"EBITDA", "LINE"
			        ,"OP", "LINE"
			        ,"NP", "LINE"
			        ,"GM_PCT", "RATIO"
			        ,"CM_PCT", "RATIO"
			        ,"GTN_PCT", "RATIO"
			        ,"ETR", "RATIO"
			        ,"CP_OP_MARGIN", "RATIO"
			        ,"CC_OP_MARGIN", "RATIO"
			        ,_kpi
			    )
			RETURN
			    SWITCH (
			        _family
			        ,"LINE"
			            ,CALCULATE (
			                [Base Amount]
			                ,REMOVEFILTERS ( dim_pl_row )
			                ,TREATAS ( { _kpi }, dim_pl_row[line_code] )
			            )
			        ,"RATIO"
			            ,VAR _num         = SWITCH ( _kpi, "GM_PCT", "GP", "CM_PCT", "CM", "GTN_PCT", "GTN", "ETR", "TAX", "OP" )
			             VAR _den         = SWITCH ( _kpi, "GTN_PCT", "GR", "ETR", "PBT", "NR" )
			             VAR _sign        = IF ( _kpi IN { "GTN_PCT", "ETR" }, -1, 1 )
			             VAR _entity      = SWITCH ( _kpi, "CP_OP_MARGIN", "P", "CC_OP_MARGIN", "S", [_Sel Entity] )
			             RETURN
			                 CALCULATE (
			                     DIVIDE (
			                         _sign
			                             * CALCULATE (
			                                 [Base Amount]
			                                 ,REMOVEFILTERS ( dim_pl_row )
			                                 ,TREATAS ( { _num }, dim_pl_row[line_code] )
			                             )
			                         ,CALCULATE (
			                             [Base Amount]
			                             ,REMOVEFILTERS ( dim_pl_row )
			                             ,TREATAS ( { _den }, dim_pl_row[line_code] )
			                         )
			                     )
			                     ,REMOVEFILTERS ( param_entity_view )
			                     ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
			                 )
			        ,"ORG_GROWTH", [KPI Organic Growth]
			        ,"ARR", [KPI ARR]
			        ,"SVC_SHARE", [KPI Services Share]
			        ,"AP_PCT", [KPI A&P % NR]
			        ,"TAKE_RATE", [KPI Payments Take Rate]
			        ,"IC_ELIM", [KPI IC Eliminated]
			        ,"UNITS", [KPI Units Sold]
			        ,"NR_PER_UNIT", [KPI NR per Unit]
			        ,"VOL_GROWTH", [KPI Volume Growth]
			        ,"PRICE_MIX", [KPI Price Mix]
			        ,"GMV", [KPI GMV]
			        ,"MERCHANTS", [KPI Active Merchants]
			        ,"SUB_GM_PCT", [KPI Subscription GM %]
			        ,"RULE40", [KPI Rule of 40]
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 2a34731c-5d78-53f1-967e-989c330128b4

	/// K-24 trend point (unscaled): the tile value of the dim_kpi row in context for the single month of dim_month in context, i.e. exactly what the tile shows with time view Month at that month (fiscal year and period follow the month, base version, every other filter kept). Blank outside the 13 months ending at the selected month and for open months of Actual (window ends before it starts). Period-end KPIs read that month-end, ratios the monthly ratio, growth KPIs the monthly growth vs prior year. Evaluate it over dim_kpi[kpi_code] x dim_month[month_index] with the entity's codes as a filter: one query, no 156 scalar calls.
	measure '_KPI Trend Value' =
			VAR _row_index    = SELECTEDVALUE ( dim_month[month_index] )
			VAR _anchor       = [_Anchor Index]
			VAR _fiscal_year  = SELECTEDVALUE ( dim_month[fiscal_year] )
			VAR _month        = SELECTEDVALUE ( dim_month[month_number] )
			RETURN
			    IF (
			        _row_index >= _anchor - 12 && _row_index <= _anchor
			        ,CALCULATE (
			            IF ( [_Win End] >= [_Win Start], [_KPI Value] )
			            ,REMOVEFILTERS ( dim_month )
			            ,REMOVEFILTERS ( param_eval )
			            ,REMOVEFILTERS ( param_time_view )
			            ,TREATAS ( { "MTD" }, param_time_view[time_view_code] )
			            ,REMOVEFILTERS ( param_fiscal_year )
			            ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
			            ,REMOVEFILTERS ( param_period )
			            ,TREATAS ( { _month }, param_period[month_number] )
			        )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 5d0c2f6e-7a3b-4f1e-9c84-2b6a1e0d7f31

	/// Net revenue of the slice in the selected units (display only; the profitability table column).
	measure 'Prof Net Revenue' = DIVIDE ( [Net Revenue], [_Units Divisor] )
		displayFolder: 5 Profitability
		lineageTag: ac43cd96-a94a-5abf-b7ad-d499c97da30c

		formatStringDefinition =
				VAR _units        = [_Sel Units]
				RETURN
				    IF ( _units = "K", "#,0;−#,0;0", "#,0.0;−#,0.0;0.0" )

	/// Identity colour of the selected company (acc): Products blue, Cloud violet, Group graphite. Drives fx on brand mark, tabs, selected controls, Done buttons.
	measure '_Acc' =
			SWITCH (
