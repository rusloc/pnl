	/// Full-year LE - full-year budget in the selected units; ratio rows in pp.
	measure 'PL Δ LE vs Budget' =
			VAR _value        = [_PL Δ LE]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
