	/// Full-year latest estimate column in the selected units (display only).
	measure 'PL FY LE' =
			VAR _value        = [_PL FY LE]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
