	/// Display name of the comparison used by the bridge and largest variances: Compare A, else Compare B, else prior year.
	measure '_Bridge Cmp Name' =
			VAR _compare_a    = [_Cmp A Name]
			VAR _compare_b    = [_Cmp B Name]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,NOT ISBLANK ( _compare_a )
			            ,_compare_a
			        ,NOT ISBLANK ( _compare_b )
			            ,_compare_b
			        ,"Prior year"
			    )
		isHidden
