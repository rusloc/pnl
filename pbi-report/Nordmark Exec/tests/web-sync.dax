EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N14 FY2026-W20 · Budget · All", "metric", "line.header", "actual", SUBSTITUTE ( [Header Period Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Comparator Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Region Text], "**", "" ) & "", "expected", "Week 20 · 11–17 May 2026   vs Budget   All regions & formats" )
                ,ROW ( "block", "T-N14 FY2026-W20 · Budget · All", "metric", "counts on / watch / off.status line", "actual", [Window Status Count On] & " / " & [Window Status Count Watch] & " / " & [Window Status Count Off] & "", "expected", "5 / 5 / 1" )
