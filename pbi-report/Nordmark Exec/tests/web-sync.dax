    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

// ==== BLOCK T-N13-01: Explain texts, view 'default (W43 · Budget · All · All categories)' (spec 08 section 4, ⓘ pop-up strings): 120 rows
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION ( CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 default", "metric", "eyebrow.NET_SALES", "actual", [Explain Eyebrow] & "", "expected", "Tier 1 · week 43, all channels" )
                ,ROW ( "block", "T-N13 default", "metric", "delta.NET_SALES", "actual", [Explain Delta] & "", "expected", "−€1.5m (−2.4%) vs budget" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.label.NET_SALES", "actual", [Explain Stat 1 Label] & "", "expected", "vs LY week" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.value.NET_SALES", "actual", [Explain Stat 1 Value] & "", "expected", "+3.8%" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.label.NET_SALES", "actual", [Explain Stat 2 Label] & "", "expected", "Month 10 to date" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.value.NET_SALES", "actual", [Explain Stat 2 Value] & "", "expected", "€241.7m" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.label.NET_SALES", "actual", [Explain Stat 3 Label] & "", "expected", "Year to date" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.value.NET_SALES", "actual", [Explain Stat 3 Value] & "", "expected", "€2,318m" )
                ,ROW ( "block", "T-N13 default", "metric", "example.NET_SALES", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "€68.4m at ticket − €6.7m markdowns and discounts − €0.3m returns = €61.4m. Budget was €62.9m, so −€1.5m (−2.4%)." )
                ,ROW ( "block", "T-N13 default", "metric", "note.NET_SALES", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "NET_SALES" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 default", "metric", "eyebrow.TOTAL_MARGIN", "actual", [Explain Eyebrow] & "", "expected", "Tier 1 · front + back · prov." )
                ,ROW ( "block", "T-N13 default", "metric", "delta.TOTAL_MARGIN", "actual", [Explain Delta] & "", "expected", "+0.1 pp vs budget 36.2%" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.label.TOTAL_MARGIN", "actual", [Explain Stat 1 Label] & "", "expected", "Front margin" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.value.TOTAL_MARGIN", "actual", [Explain Stat 1 Value] & "", "expected", "30.1%" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.label.TOTAL_MARGIN", "actual", [Explain Stat 2 Label] & "", "expected", "Back margin" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.value.TOTAL_MARGIN", "actual", [Explain Stat 2 Value] & "", "expected", "6.2%" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.label.TOTAL_MARGIN", "actual", [Explain Stat 3 Label] & "", "expected", "vs LY week" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.value.TOTAL_MARGIN", "actual", [Explain Stat 3 Value] & "", "expected", "−0.2 pp" )
                ,ROW ( "block", "T-N13 default", "metric", "example.TOTAL_MARGIN", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "Front €18.5m + back €3.8m = €22.3m; ÷ €61.4m = 36.3%. Budget 36.2%, so +0.1 pp." )
                ,ROW ( "block", "T-N13 default", "metric", "note.TOTAL_MARGIN", "actual", [Explain Updated] & "", "expected", "Provisional · true-up 10 Nov" )
            )
