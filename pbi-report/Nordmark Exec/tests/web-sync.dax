EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N14 FY2026 · Budget · All", "metric", "line.header", "actual", SUBSTITUTE ( [Header Period Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Comparator Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Region Text], "**", "" ) & "", "expected", "FY2026 to date · 29 Dec 2025–25 Oct 2026   vs Budget   All regions & formats" )
