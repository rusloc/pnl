            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "AVAILABILITY" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            ROW ( "block", "T-N13 svg", "metric", "panel.EBITDA", "actual", ( VAR _v = [Info SVG EBITDA] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( [Explain Eyebrow] ), "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ), "", " eyebrow" ) & IF ( [Explain Stat 1 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 1 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 1 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat1" ) & IF ( [Explain Stat 2 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 2 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 2 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat2" ) & IF ( [Explain Stat 3 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 3 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 3 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat3" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ) & "", "expected", "ok" )
