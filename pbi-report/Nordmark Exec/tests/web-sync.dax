                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.LFL_GROWTH", "actual", [Explain Stat 2 Value] & "", "expected", "−1.7 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.LFL_GROWTH", "actual", [Explain Stat 3 Label] & "", "expected", "Online LFL" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.LFL_GROWTH", "actual", [Explain Stat 3 Value] & "", "expected", "+6.7%" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.LFL_GROWTH", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "131 LFL stores: €5.5m ÷ €5.2m − 1 = +4.0%. Budget LFL 3.0%, so +1.0 pp." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.LFL_GROWTH", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "LFL_GROWTH" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "eyebrow.FRONT_GM", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · % of net sales" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "delta.FRONT_GM", "actual", [Explain Delta] & "", "expected", "−0.2 pp vs budget 23.3%" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.label.FRONT_GM", "actual", [Explain Stat 1 Label] & "", "expected", "Cost of goods" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.value.FRONT_GM", "actual", [Explain Stat 1 Value] & "", "expected", "€7.9m" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.label.FRONT_GM", "actual", [Explain Stat 2 Label] & "", "expected", "Front margin" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.FRONT_GM", "actual", [Explain Stat 2 Value] & "", "expected", "€2.4m" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.FRONT_GM", "actual", [Explain Stat 3 Label] & "", "expected", "vs LY week" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.FRONT_GM", "actual", [Explain Stat 3 Value] & "", "expected", "−1.1 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.FRONT_GM", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "€10.2m − €7.9m cost of goods = €2.4m; ÷ €10.2m = 23.1%. Budget 23.3%, so −0.2 pp." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.FRONT_GM", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "FRONT_GM" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "eyebrow.SELL_THROUGH", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · A/W season to date" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "delta.SELL_THROUGH", "actual", [Explain Delta] & "", "expected", "−1.0 pp vs target 62%" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.label.SELL_THROUGH", "actual", [Explain Stat 1 Label] & "", "expected", "Toys & leisure" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.value.SELL_THROUGH", "actual", [Explain Stat 1 Value] & "", "expected", "61%" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.label.SELL_THROUGH", "actual", [Explain Stat 2 Label] & "", "expected", "vs LY season" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.SELL_THROUGH", "actual", [Explain Stat 2 Value] & "", "expected", "+3.8 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.SELL_THROUGH", "actual", [Explain Stat 3 Label] & "", "expected", "" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.SELL_THROUGH", "actual", [Explain Stat 3 Value] & "", "expected", "" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.SELL_THROUGH", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "1.6m units sold ÷ (0.8m opening + 1.9m received = 2.7m) = 61.0%. Target 62% at week 12 of 20, so −1.0 pp. Seasonal categories only." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.SELL_THROUGH", "actual", [Explain Updated] & "", "expected", "Updated weekly" )
            )
            ,TREATAS ( { "SELL_THROUGH" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "eyebrow.GMROI", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · rolling 12 months" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "delta.GMROI", "actual", [Explain Delta] & "", "expected", "−0.3× vs target 2.2×" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.label.GMROI", "actual", [Explain Stat 1 Label] & "", "expected", "R52W front margin" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.value.GMROI", "actual", [Explain Stat 1 Value] & "", "expected", "€97m" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.label.GMROI", "actual", [Explain Stat 2 Label] & "", "expected", "Average stock at cost" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.GMROI", "actual", [Explain Stat 2 Value] & "", "expected", "€49m" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.GMROI", "actual", [Explain Stat 3 Label] & "", "expected", "Electronics · Toys & leisure" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.GMROI", "actual", [Explain Stat 3 Value] & "", "expected", "1.9× · 2.0×" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.GMROI", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "€97m front margin ÷ €49m average stock = 2.0×. Target 2.2×, so −0.3×." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.GMROI", "actual", [Explain Updated] & "", "expected", "Updated weekly" )
            )
            ,TREATAS ( { "GMROI" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "eyebrow.SUPPLIER_OTIF", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · inbound, PO lines" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "delta.SUPPLIER_OTIF", "actual", [Explain Delta] & "", "expected", "n/a by category" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.label.SUPPLIER_OTIF", "actual", [Explain Stat 1 Label] & "", "expected", "PO lines due" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.value.SUPPLIER_OTIF", "actual", [Explain Stat 1 Value] & "", "expected", "n/a" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.label.SUPPLIER_OTIF", "actual", [Explain Stat 2 Label] & "", "expected", "vs last week" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.SUPPLIER_OTIF", "actual", [Explain Stat 2 Value] & "", "expected", "n/a" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.SUPPLIER_OTIF", "actual", [Explain Stat 3 Label] & "", "expected", "Suppliers below 85%" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.SUPPLIER_OTIF", "actual", [Explain Stat 3 Value] & "", "expected", "n/a" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.SUPPLIER_OTIF", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "Not split by category — PO lines are per supplier." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.SUPPLIER_OTIF", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "SUPPLIER_OTIF" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "eyebrow.CHANNEL_MIX", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · % of net sales vs plan" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "delta.CHANNEL_MIX", "actual", [Explain Delta] & "", "expected", "online +1.5 pp vs plan" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.label.CHANNEL_MIX", "actual", [Explain Stat 1 Label] & "", "expected", "Store" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat1.value.CHANNEL_MIX", "actual", [Explain Stat 1 Value] & "", "expected", "57.4% · −1.5 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.label.CHANNEL_MIX", "actual", [Explain Stat 2 Label] & "", "expected", "Online" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat2.value.CHANNEL_MIX", "actual", [Explain Stat 2 Value] & "", "expected", "32.7% · +1.5 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.label.CHANNEL_MIX", "actual", [Explain Stat 3 Label] & "", "expected", "Wholesale" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "stat3.value.CHANNEL_MIX", "actual", [Explain Stat 3 Value] & "", "expected", "9.9% · −0.0 pp" )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "example.CHANNEL_MIX", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "Store €5.9m, online €3.4m, wholesale €1.0m of €10.2m → 57.4% / 32.7% / 9.9%. Plan 58.8 / 31.2 / 9.9, so online +1.5 pp." )
                ,ROW ( "block", "T-N13 W43 ELEC+TOYS", "metric", "note.CHANNEL_MIX", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "CHANNEL_MIX" }, dim_kpi[kpi_code] )
        ) )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "W" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2026" }, dim_item[fy_label] )
            ,TREATAS ( { "W43" }, dim_item[label] )
            ,TREATAS ( { "Electronics", "Toys & leisure" }, dim_category[category_name] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

