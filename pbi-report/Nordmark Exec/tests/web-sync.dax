// ==== BLOCK T-N12-01: card strings, view 'default (W43 · Budget · All · All categories)' (spec 08 section 4): 76 rows
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N12 default", "metric", "header", "actual", SUBSTITUTE ( [Header Period Text], "**", "" ) & " · " & SUBSTITUTE ( [Header Comparator Text], "**", "" ) & " · " & SUBSTITUTE ( [Header Region Text], "**", "" ) & "", "expected", "Week 43 · 19–25 Oct 2026 · vs Budget · All regions & formats" )
                ,ROW ( "block", "T-N12 default", "metric", "counts", "actual", [Window Status Count On] & "/" & [Window Status Count Watch] & "/" & [Window Status Count Off] & "", "expected", "7/3/2" )
                ,ROW ( "block", "T-N12 default", "metric", "dot", "actual", SWITCH ( [Window Status Dot], 1, "green", 2, "orange", 3, "red", "grey" ) & "", "expected", "orange" )
                ,ROW ( "block", "T-N12 default", "metric", "summary", "actual", [Status Summary Text] & "", "expected", "12 of 12 metrics · All" )
                ,ROW ( "block", "T-N12 default", "metric", "sub.NET_SALES", "actual", [Card Sub NET_SALES] & "", "expected", "week 43, all channels" )
                ,ROW ( "block", "T-N12 default", "metric", "value.NET_SALES", "actual", [Card Value Text NET_SALES] & [Card Unit Text NET_SALES] & "", "expected", "€61.4m" )
                ,ROW ( "block", "T-N12 default", "metric", "delta.NET_SALES", "actual", [Card Delta Text NET_SALES] & "", "expected", "−€1.5m (−2.4%) vs budget" )
                ,ROW ( "block", "T-N12 default", "metric", "status.NET_SALES", "actual", [Card Status Word NET_SALES] & "", "expected", "Watch" )
                ,ROW ( "block", "T-N12 default", "metric", "basis.NET_SALES", "actual", [Card Basis Label NET_SALES] & " " & [Card Basis Text NET_SALES] & [Card Basis Unit NET_SALES] & "", "expected", "Budget €62.9m" )
                ,ROW ( "block", "T-N12 default", "metric", "revealed.NET_SALES", "actual", IF ( [Card Revealed NET_SALES], "Y", "faded" ) & "", "expected", "Y" )
                ,ROW ( "block", "T-N12 default", "metric", "sub.TOTAL_MARGIN", "actual", [Card Sub TOTAL_MARGIN] & "", "expected", "front + back · prov." )
                ,ROW ( "block", "T-N12 default", "metric", "value.TOTAL_MARGIN", "actual", [Card Value Text TOTAL_MARGIN] & [Card Unit Text TOTAL_MARGIN] & "", "expected", "36.3%" )
                ,ROW ( "block", "T-N12 default", "metric", "delta.TOTAL_MARGIN", "actual", [Card Delta Text TOTAL_MARGIN] & "", "expected", "+0.1 pp vs budget 36.2%" )
                ,ROW ( "block", "T-N12 default", "metric", "status.TOTAL_MARGIN", "actual", [Card Status Word TOTAL_MARGIN] & "", "expected", "On track" )
                ,ROW ( "block", "T-N12 default", "metric", "basis.TOTAL_MARGIN", "actual", [Card Basis Label TOTAL_MARGIN] & " " & [Card Basis Text TOTAL_MARGIN] & [Card Basis Unit TOTAL_MARGIN] & "", "expected", "Budget 36.2%" )
                ,ROW ( "block", "T-N12 default", "metric", "revealed.TOTAL_MARGIN", "actual", IF ( [Card Revealed TOTAL_MARGIN], "Y", "faded" ) & "", "expected", "Y" )
                ,ROW ( "block", "T-N12 default", "metric", "sub.WEEKS_OF_COVER", "actual", [Card Sub WEEKS_OF_COVER] & "", "expected", "forward" )
                ,ROW ( "block", "T-N12 default", "metric", "value.WEEKS_OF_COVER", "actual", [Card Value Text WEEKS_OF_COVER] & [Card Unit Text WEEKS_OF_COVER] & "", "expected", "11.4wks" )
                ,ROW ( "block", "T-N12 default", "metric", "delta.WEEKS_OF_COVER", "actual", [Card Delta Text WEEKS_OF_COVER] & "", "expected", "+1.9 wks vs target 9.5" )
                ,ROW ( "block", "T-N12 default", "metric", "status.WEEKS_OF_COVER", "actual", [Card Status Word WEEKS_OF_COVER] & "", "expected", "Watch" )
                ,ROW ( "block", "T-N12 default", "metric", "basis.WEEKS_OF_COVER", "actual", [Card Basis Label WEEKS_OF_COVER] & " " & [Card Basis Text WEEKS_OF_COVER] & [Card Basis Unit WEEKS_OF_COVER] & "", "expected", "Target 9.5wks" )
                ,ROW ( "block", "T-N12 default", "metric", "revealed.WEEKS_OF_COVER", "actual", IF ( [Card Revealed WEEKS_OF_COVER], "Y", "faded" ) & "", "expected", "Y" )
                ,ROW ( "block", "T-N12 default", "metric", "sub.MARKDOWN", "actual", [Card Sub MARKDOWN] & "", "expected", "% of gross sales" )
                ,ROW ( "block", "T-N12 default", "metric", "value.MARKDOWN", "actual", [Card Value Text MARKDOWN] & [Card Unit Text MARKDOWN] & "", "expected", "9.8%" )
                ,ROW ( "block", "T-N12 default", "metric", "delta.MARKDOWN", "actual", [Card Delta Text MARKDOWN] & "", "expected", "+1.3 pp vs budget 8.5%" )
                ,ROW ( "block", "T-N12 default", "metric", "status.MARKDOWN", "actual", [Card Status Word MARKDOWN] & "", "expected", "Off track" )
                ,ROW ( "block", "T-N12 default", "metric", "basis.MARKDOWN", "actual", [Card Basis Label MARKDOWN] & " " & [Card Basis Text MARKDOWN] & [Card Basis Unit MARKDOWN] & "", "expected", "Budget 8.5%" )
                ,ROW ( "block", "T-N12 default", "metric", "revealed.MARKDOWN", "actual", IF ( [Card Revealed MARKDOWN], "Y", "faded" ) & "", "expected", "Y" )
