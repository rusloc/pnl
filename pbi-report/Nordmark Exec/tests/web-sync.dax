                ,ROW ( "block", "T-N13 default", "metric", "stat2.value.SUPPLIER_OTIF", "actual", [Explain Stat 2 Value] & "", "expected", "+0.4 pp" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.label.SUPPLIER_OTIF", "actual", [Explain Stat 3 Label] & "", "expected", "Suppliers below 85%" )
