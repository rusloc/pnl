            )
            ,TREATAS ( { "SUPPLIER_OTIF" }, dim_kpi[kpi_code] )
        ), CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N13 default", "metric", "eyebrow.CHANNEL_MIX", "actual", [Explain Eyebrow] & "", "expected", "Explains Tier 1 · % of net sales vs plan" )
                ,ROW ( "block", "T-N13 default", "metric", "delta.CHANNEL_MIX", "actual", [Explain Delta] & "", "expected", "online +1.9 pp vs plan" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.label.CHANNEL_MIX", "actual", [Explain Stat 1 Label] & "", "expected", "Store" )
                ,ROW ( "block", "T-N13 default", "metric", "stat1.value.CHANNEL_MIX", "actual", [Explain Stat 1 Value] & "", "expected", "68.4% · −1.6 pp" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.label.CHANNEL_MIX", "actual", [Explain Stat 2 Label] & "", "expected", "Online" )
                ,ROW ( "block", "T-N13 default", "metric", "stat2.value.CHANNEL_MIX", "actual", [Explain Stat 2 Value] & "", "expected", "19.9% · +1.9 pp" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.label.CHANNEL_MIX", "actual", [Explain Stat 3 Label] & "", "expected", "Wholesale" )
                ,ROW ( "block", "T-N13 default", "metric", "stat3.value.CHANNEL_MIX", "actual", [Explain Stat 3 Value] & "", "expected", "11.7% · −0.3 pp" )
                ,ROW ( "block", "T-N13 default", "metric", "example.CHANNEL_MIX", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "Store €42.0m, online €12.2m, wholesale €7.2m of €61.4m → 68.4% / 19.9% / 11.7%. Plan 70 / 18 / 12, so online +1.9 pp." )
                ,ROW ( "block", "T-N13 default", "metric", "note.CHANNEL_MIX", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "CHANNEL_MIX" }, dim_kpi[kpi_code] )
        ) )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

