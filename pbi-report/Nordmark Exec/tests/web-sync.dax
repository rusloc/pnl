                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat1.label.CHANNEL_MIX", "actual", [Explain Stat 1 Label] & "", "expected", "Store" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat1.value.CHANNEL_MIX", "actual", [Explain Stat 1 Value] & "", "expected", "68.6% · −1.6 pp" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat2.label.CHANNEL_MIX", "actual", [Explain Stat 2 Label] & "", "expected", "Online" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat2.value.CHANNEL_MIX", "actual", [Explain Stat 2 Value] & "", "expected", "19.6% · +1.3 pp" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat3.label.CHANNEL_MIX", "actual", [Explain Stat 3 Label] & "", "expected", "Wholesale" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "stat3.value.CHANNEL_MIX", "actual", [Explain Stat 3 Value] & "", "expected", "11.8% · +0.3 pp" )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "example.CHANNEL_MIX", "actual", [Example Pre] & [Example Bold] & [Example Post] & "", "expected", "Store €165.8m, online €47.4m, wholesale €28.5m of €241.7m → 68.6% / 19.6% / 11.8%. Plan 70.2 / 18.3 / 11.5, so store −1.6 pp." )
                ,ROW ( "block", "T-N13 P10 Bud", "metric", "note.CHANNEL_MIX", "actual", [Explain Updated] & "", "expected", "Updated Mon 05:12" )
            )
            ,TREATAS ( { "CHANNEL_MIX" }, dim_kpi[kpi_code] )
        ) )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "P" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2026" }, dim_item[fy_label] )
            ,TREATAS ( { "P10" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

