        ), CALCULATETABLE (
            ROW ( "block", "T-N13 svg", "metric", "panel.CHANNEL_MIX", "actual", ( VAR _v = [Info SVG CHANNEL_MIX] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( [Explain Eyebrow] ), "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ), "", " eyebrow" ) & IF ( [Explain Stat 1 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 1 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 1 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat1" ) & IF ( [Explain Stat 2 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 2 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 2 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat2" ) & IF ( [Explain Stat 3 Label] = "" || ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 3 Label], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) && CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Explain Stat 3 Value], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</text>" ) ), "", " stat3" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ) & "", "expected", "ok" )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "CHANNEL_MIX" }, dim_kpi[kpi_code] )
        ) )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

// ==== BLOCK T-N14-01: web faces (hunter's oracle 2026-11-16), state 'W43 · Budget · All' ((defaults)): 135 rows
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N14 W43 · Budget · All", "metric", "line.header", "actual", SUBSTITUTE ( [Header Period Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Comparator Text], "**", "" ) & "   " & SUBSTITUTE ( [Header Region Text], "**", "" ) & "", "expected", "Week 43 · 19–25 Oct 2026   vs Budget   All regions & formats" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "counts on / watch / off.status line", "actual", [Window Status Count On] & " / " & [Window Status Count Watch] & " / " & [Window Status Count Off] & "", "expected", "7 / 3 / 2" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "dot.status line", "actual", SWITCH ( [Window Status Dot], 1, "green", 2, "orange", 3, "red", "grey" ) & "", "expected", "orange" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "title.NET_SALES", "actual", IF ( CONTAINSSTRING ( [Card SVG NET_SALES], "fill='%23111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "Net sales", "&", "&amp;" ), "%", "%25" ), "#", "%23" ) ), "Net sales", "missing" ) & "", "expected", "Net sales" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "sub-title.NET_SALES", "actual", IF ( CONTAINSSTRING ( [Card SVG NET_SALES], " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Card Sub NET_SALES], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</tspan>" ), [Card Sub NET_SALES], "not on the face" ) & "", "expected", "week 43, all channels" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "value.NET_SALES", "actual", [Card Value Text NET_SALES] & "", "expected", "€61.4" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "unit.NET_SALES", "actual", [Card Unit Text NET_SALES] & "", "expected", "m" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "delta.NET_SALES", "actual", [Card Delta Text NET_SALES] & "", "expected", "−€1.5m (−2.4%) vs budget" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "status.NET_SALES", "actual", [Card Status Word NET_SALES] & "", "expected", "Watch" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i actual.NET_SALES", "actual", [Card Value Text NET_SALES] & [Card Unit Text NET_SALES] & "", "expected", "€61.4m" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis label.NET_SALES", "actual", [Card Basis Label NET_SALES] & "", "expected", "Budget" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis value.NET_SALES", "actual", IF ( ISBLANK ( [Card Basis NET_SALES] ), IF ( CONTAINSSTRING ( [Info SVG NET_SALES], "font-weight='700' fill='%235F6878'>–</text>" ), "–", "no dash" ), [Card Basis Text NET_SALES] & [Card Basis Unit NET_SALES] ) & "", "expected", "€62.9m" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i delta.NET_SALES", "actual", [Card Delta Text NET_SALES] & "", "expected", "−€1.5m (−2.4%) vs budget" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i note.NET_SALES", "actual", ( VAR _x = CALCULATE ( [Example Pre] & [Example Bold] & [Example Post], TREATAS ( { "NET_SALES" }, dim_kpi[kpi_code] ) ) RETURN IF ( _x IN { "No seasonal category in the selection.", "Not split by category — OpEx is booked per site and centrally.", "Not split by category — PO lines are per supplier." }, _x, "" ) ) & "", "expected", "" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "title.TOTAL_MARGIN", "actual", IF ( CONTAINSSTRING ( [Card SVG TOTAL_MARGIN], "fill='%23111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "Total margin", "&", "&amp;" ), "%", "%25" ), "#", "%23" ) ), "Total margin", "missing" ) & "", "expected", "Total margin" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "sub-title.TOTAL_MARGIN", "actual", IF ( CONTAINSSTRING ( [Card SVG TOTAL_MARGIN], " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Card Sub TOTAL_MARGIN], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</tspan>" ), [Card Sub TOTAL_MARGIN], "not on the face" ) & "", "expected", "front + back · prov." )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "value.TOTAL_MARGIN", "actual", [Card Value Text TOTAL_MARGIN] & "", "expected", "36.3" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "unit.TOTAL_MARGIN", "actual", [Card Unit Text TOTAL_MARGIN] & "", "expected", "%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "delta.TOTAL_MARGIN", "actual", [Card Delta Text TOTAL_MARGIN] & "", "expected", "+0.1 pp vs budget 36.2%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "status.TOTAL_MARGIN", "actual", [Card Status Word TOTAL_MARGIN] & "", "expected", "On track" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i actual.TOTAL_MARGIN", "actual", [Card Value Text TOTAL_MARGIN] & [Card Unit Text TOTAL_MARGIN] & "", "expected", "36.3%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis label.TOTAL_MARGIN", "actual", [Card Basis Label TOTAL_MARGIN] & "", "expected", "Budget" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis value.TOTAL_MARGIN", "actual", IF ( ISBLANK ( [Card Basis TOTAL_MARGIN] ), IF ( CONTAINSSTRING ( [Info SVG TOTAL_MARGIN], "font-weight='700' fill='%235F6878'>–</text>" ), "–", "no dash" ), [Card Basis Text TOTAL_MARGIN] & [Card Basis Unit TOTAL_MARGIN] ) & "", "expected", "36.2%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i delta.TOTAL_MARGIN", "actual", [Card Delta Text TOTAL_MARGIN] & "", "expected", "+0.1 pp vs budget 36.2%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i note.TOTAL_MARGIN", "actual", ( VAR _x = CALCULATE ( [Example Pre] & [Example Bold] & [Example Post], TREATAS ( { "TOTAL_MARGIN" }, dim_kpi[kpi_code] ) ) RETURN IF ( _x IN { "No seasonal category in the selection.", "Not split by category — OpEx is booked per site and centrally.", "Not split by category — PO lines are per supplier." }, _x, "" ) ) & "", "expected", "" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "title.WEEKS_OF_COVER", "actual", IF ( CONTAINSSTRING ( [Card SVG WEEKS_OF_COVER], "fill='%23111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "Weeks of cover", "&", "&amp;" ), "%", "%25" ), "#", "%23" ) ), "Weeks of cover", "missing" ) & "", "expected", "Weeks of cover" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "sub-title.WEEKS_OF_COVER", "actual", IF ( CONTAINSSTRING ( [Card SVG WEEKS_OF_COVER], " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Card Sub WEEKS_OF_COVER], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</tspan>" ), [Card Sub WEEKS_OF_COVER], "not on the face" ) & "", "expected", "forward" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "value.WEEKS_OF_COVER", "actual", [Card Value Text WEEKS_OF_COVER] & "", "expected", "11.4" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "unit.WEEKS_OF_COVER", "actual", [Card Unit Text WEEKS_OF_COVER] & "", "expected", "wks" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "delta.WEEKS_OF_COVER", "actual", [Card Delta Text WEEKS_OF_COVER] & "", "expected", "+1.9 wks vs target 9.5" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "status.WEEKS_OF_COVER", "actual", [Card Status Word WEEKS_OF_COVER] & "", "expected", "Watch" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i actual.WEEKS_OF_COVER", "actual", [Card Value Text WEEKS_OF_COVER] & [Card Unit Text WEEKS_OF_COVER] & "", "expected", "11.4wks" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis label.WEEKS_OF_COVER", "actual", [Card Basis Label WEEKS_OF_COVER] & "", "expected", "Target" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis value.WEEKS_OF_COVER", "actual", IF ( ISBLANK ( [Card Basis WEEKS_OF_COVER] ), IF ( CONTAINSSTRING ( [Info SVG WEEKS_OF_COVER], "font-weight='700' fill='%235F6878'>–</text>" ), "–", "no dash" ), [Card Basis Text WEEKS_OF_COVER] & [Card Basis Unit WEEKS_OF_COVER] ) & "", "expected", "9.5wks" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i delta.WEEKS_OF_COVER", "actual", [Card Delta Text WEEKS_OF_COVER] & "", "expected", "+1.9 wks vs target 9.5" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i note.WEEKS_OF_COVER", "actual", ( VAR _x = CALCULATE ( [Example Pre] & [Example Bold] & [Example Post], TREATAS ( { "WEEKS_OF_COVER" }, dim_kpi[kpi_code] ) ) RETURN IF ( _x IN { "No seasonal category in the selection.", "Not split by category — OpEx is booked per site and centrally.", "Not split by category — PO lines are per supplier." }, _x, "" ) ) & "", "expected", "" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "title.MARKDOWN", "actual", IF ( CONTAINSSTRING ( [Card SVG MARKDOWN], "fill='%23111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "Markdown", "&", "&amp;" ), "%", "%25" ), "#", "%23" ) ), "Markdown", "missing" ) & "", "expected", "Markdown" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "sub-title.MARKDOWN", "actual", IF ( CONTAINSSTRING ( [Card SVG MARKDOWN], " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Card Sub MARKDOWN], "&", "&amp;" ), "%", "%25" ), "#", "%23" ) & "</tspan>" ), [Card Sub MARKDOWN], "not on the face" ) & "", "expected", "% of gross sales" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "value.MARKDOWN", "actual", [Card Value Text MARKDOWN] & "", "expected", "9.8" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "unit.MARKDOWN", "actual", [Card Unit Text MARKDOWN] & "", "expected", "%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "delta.MARKDOWN", "actual", [Card Delta Text MARKDOWN] & "", "expected", "+1.3 pp vs budget 8.5%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "status.MARKDOWN", "actual", [Card Status Word MARKDOWN] & "", "expected", "Off track" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i actual.MARKDOWN", "actual", [Card Value Text MARKDOWN] & [Card Unit Text MARKDOWN] & "", "expected", "9.8%" )
                ,ROW ( "block", "T-N14 W43 · Budget · All", "metric", "i basis label.MARKDOWN", "actual", [Card Basis Label MARKDOWN] & "", "expected", "Budget" )
