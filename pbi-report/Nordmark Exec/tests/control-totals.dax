                ,dim_week[sort_index] = 94
            )
        ,CALCULATETABLE (
                ROW ( "block", "T-N5", "key", "W-FY2026-42", "metric", "ET-12 NL + BE + ONLINE + WHOLESALE - ALL", "actual",
                      CALCULATE ( [Net Sales], TREATAS ( { "NL" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "BE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "ONLINE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], dim_store[channel_code] = "WHOLESALE" )
                      - [Net Sales] + 0, "expected", 0.0, "tol", 0.01 )
                ,dim_week[sort_index] = 94
                ,TREATAS ( { "ALL" }, param_region[scope_code] )
            )
        ,CALCULATETABLE (
                ROW ( "block", "T-N5", "key", "W-FY2026-43", "metric", "ET-07 back margin - supplier income", "actual",
                      [Back Margin] - [Supplier Income], "expected", 0.0, "tol", 0.01 )
                ,dim_week[sort_index] = 95
            )
        ,CALCULATETABLE (
                ROW ( "block", "T-N5", "key", "W-FY2026-43", "metric", "ET-12 NL + BE + ONLINE + WHOLESALE - ALL", "actual",
                      CALCULATE ( [Net Sales], TREATAS ( { "NL" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "BE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "ONLINE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], dim_store[channel_code] = "WHOLESALE" )
                      - [Net Sales] + 0, "expected", 0.0, "tol", 0.01 )
                ,dim_week[sort_index] = 95
                ,TREATAS ( { "ALL" }, param_region[scope_code] )
            )
        ,ROW ( "block", "T-N5", "key", "model", "metric", "measures in an error state", "actual", COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) ) + 0, "expected", 0.0, "tol", 0 )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

// ==== BLOCK T-N6: conceal in place: B3 shows 4 of 12, counts and dot unchanged; OR within, AND across; three attribute groups (ET-13, E-53)
EVALUATE
VAR _t =
    UNION (
        CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N6 B3", "metric", "revealed", "actual", FORMAT ( [Revealed Count], "0" ), "expected", "4" )
                ,ROW ( "block", "T-N6 B3", "metric", "summary", "actual", [Filter Picks Text], "expected", "B3 stock & supply" )
                ,ROW ( "block", "T-N6 B3", "metric", "badge", "actual", FORMAT ( [Filter Pick Count], "0" ), "expected", "1" )
                ,ROW ( "block", "T-N6 B3", "metric", "counts", "actual", [Window Status Count On] & "/" & [Window Status Count Watch] & "/" & [Window Status Count Off] & "/" & [Window Status Dot], "expected", "7/3/2/2" )
                ,ROW ( "block", "T-N6 B3", "metric", "net sales concealed", "actual", IF ( [Card Revealed NET_SALES], "shown", "concealed" ), "expected", "concealed" )
                ,ROW ( "block", "T-N6 B3", "metric", "availability shown", "actual", IF ( [Card Revealed AVAILABILITY], "shown", "concealed" ), "expected", "shown" )
            )
            ,TREATAS ( { "B3" }, param_attr_group[attr_code] )
        )
        ,CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N6 B1|B4 & sales", "metric", "revealed", "actual", FORMAT ( [Revealed Count], "0" ), "expected", "3" )
                ,ROW ( "block", "T-N6 B1|B4 & sales", "metric", "summary", "actual", [Filter Picks Text], "expected", "B1 base-crucial, B4 channel & customer, Sales" )
            )
            ,TREATAS ( { "B1", "B4" }, param_attr_group[attr_code] )
            ,TREATAS ( { "sales" }, param_attr_lever[attr_code] )
        )
        ,CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N6 finance", "metric", "summary", "actual", [Filter Picks Text], "expected", "Finance" )
                ,ROW ( "block", "T-N6 finance", "metric", "revealed", "actual", FORMAT ( [Revealed Count], "0" ), "expected", "4" )
            )
            ,TREATAS ( { "finance" }, param_attr_owner[attr_code] )
        )
        ,CALCULATETABLE (
            ROW ( "block", "T-N6 none", "metric", "summary", "actual", [Filter Picks Text], "expected", "All" )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
        )
    )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

