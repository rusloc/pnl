            ,dim_week[sort_index] >= 1
            ,dim_week[sort_index] <= 52
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "Apparel" }, dim_category[category_name] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

