                ,ROW ( "block", "T-N7 FY2025 P10", "metric", "no-basis.SUPPLIER_OTIF", "actual", IF ( CONTAINSSTRING ( [Info SVG SUPPLIER_OTIF], ">Target</text>" ) && NOT CONTAINSSTRING ( [Info SVG SUPPLIER_OTIF], "fill='%235F6878'>–</text>" ), "value", "dash" ), "expected", "value" )
                ,ROW ( "block", "T-N7 FY2025 P10", "metric", "no-basis.CHANNEL_MIX", "actual", IF ( CONTAINSSTRING ( [Info SVG CHANNEL_MIX], "<line x1='24' y1='142.5' x2='44' y2='142.5' stroke='%239CA3AF' stroke-width='2' stroke-dasharray='2 2'/><text x='52' y='148' font-size='16' font-weight='600' fill='%23374151'>Plan</text><text x='24' y='180' font-size='40' font-weight='700' fill='%235F6878'>–</text>" ), "dash", "no dash" ), "expected", "dash" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "P" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2025" }, dim_item[fy_label] )
            ,TREATAS ( { "P10" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

// ==== BLOCK T-N7-5: i pop-up under a category pick: the one-line N/A notes, '–' value and basis, n/a stats (E-101)
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N7 cat", "metric", "note.EBITDA", "actual", IF ( CONTAINSSTRING ( [Info SVG EBITDA], "Not split by category — OpEx is booked" ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N7 cat", "metric", "note.SUPPLIER_OTIF", "actual", IF ( CONTAINSSTRING ( [Info SVG SUPPLIER_OTIF], "Not split by category — PO lines are per supplier." ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N7 cat", "metric", "note.SELL_THROUGH", "actual", IF ( CONTAINSSTRING ( [Info SVG SELL_THROUGH], "No seasonal category in the selection." ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N7 cat", "metric", "basis dash.EBITDA", "actual", IF ( CONTAINSSTRING ( [Info SVG EBITDA], "font-weight='700' fill='%235F6878'>–</text>" ), "dash", "value" ), "expected", "dash" )
                ,ROW ( "block", "T-N7 cat", "metric", "actual dash.SUPPLIER_OTIF", "actual", IF ( CONTAINSSTRING ( [Info SVG SUPPLIER_OTIF], "letter-spacing='-1.4'>–<tspan" ), "dash", "value" ), "expected", "dash" )
                ,ROW ( "block", "T-N7 cat", "metric", "stats n/a.SUPPLIER_OTIF", "actual", IF ( CONTAINSSTRING ( [Info SVG SUPPLIER_OTIF], ">PO lines due</text><text x='24.0' y='262' font-size='15' font-weight='600' fill='%23111827'>n/a</text>" ), "ok", "missing" ), "expected", "ok" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "Electronics" }, dim_category[category_name] )
            ,TREATAS ( { "W" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2026" }, dim_item[fy_label] )
            ,TREATAS ( { "W43" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

// ==== BLOCK T-N8: item lists: 95 weeks, 22 months, 8 quarters, 2 years; partial Q4 FY2026 and FY2026 (ET-21)
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N8", "metric", "counts", "actual", CONCATENATEX ( VALUES ( dim_item[granularity_code] ), dim_item[granularity_code] & " " & CALCULATE ( COUNTROWS ( dim_item ) ), ", ", dim_item[granularity_code], ASC ), "expected", "FY 2, P 22, Q 8, W 95" )
                ,ROW ( "block", "T-N8", "metric", "partial", "actual", CONCATENATEX ( FILTER ( dim_item, dim_item[is_partial] ), dim_item[item_key], ", ", dim_item[item_key], ASC ), "expected", "FY2026, FY2026-Q4" )
                ,ROW ( "block", "T-N8", "metric", "first / last week", "actual", MINX ( FILTER ( dim_item, dim_item[granularity_code] = "W" ), dim_item[item_key] ) & " .. " & MAXX ( FILTER ( dim_item, dim_item[granularity_code] = "W" ), dim_item[item_key] ), "expected", "FY2025-W01 .. FY2026-W43" )
                ,ROW ( "block", "T-N8", "metric", "P10 complete", "actual", IF ( LOOKUPVALUE ( dim_item[is_partial], dim_item[item_key], "FY2026-P10" ), "partial", "complete" ), "expected", "complete" )
                ,ROW ( "block", "T-N8", "metric", "no P11 FY2026", "actual", IF ( ISBLANK ( LOOKUPVALUE ( dim_item[item_key], dim_item[item_key], "FY2026-P11" ) ), "absent", "listed" ), "expected", "absent" )
            )
            ,REMOVEFILTERS ( dim_item )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

// ==== BLOCK T-N9-1: frame parity, reset: card faces and i pop-ups show the card-layer texts
EVALUATE
VAR _t =
    CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N9 reset", "metric", "card.NET_SALES", "actual", ( VAR _v = [Card SVG NET_SALES] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text NET_SALES], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status NET_SALES], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "hero" = "small", "", " " & [Card Status Word NET_SALES] ) & "</text>" ), "", " chip" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text NET_SALES], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "info.NET_SALES", "actual", ( VAR _v = [Info SVG NET_SALES] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text NET_SALES], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis NET_SALES] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text NET_SALES], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text NET_SALES], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word NET_SALES] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
