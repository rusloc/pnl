                ,ROW ( "block", "T-N3 cat ELEC+TOYS", "metric", "rated", "actual", FORMAT ( [Window Status Count On] + [Window Status Count Watch] + [Window Status Count Off], "0" ), "expected", "10" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "Electronics", "Toys & leisure" }, dim_category[category_name] )
            ,TREATAS ( { "W" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2026" }, dim_item[fy_label] )
            ,TREATAS ( { "W43" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

