                ,ROW ( "block", "T-N9 ALL#ELEC W43 Bud", "metric", "status line", "actual", ( VAR _pk = [Window Status Pack] VAR _v = [Status Line SVG] VAR _w = [Dot SVG] VAR _on = INT ( _pk / 1000 ) VAR _wa = INT ( MOD ( _pk, 1000 ) / 100 ) VAR _of = INT ( MOD ( _pk, 100 ) / 10 ) VAR _dc = SWITCH ( MOD ( _pk, 10 ), 1, "%232E9E5B", 2, "%23E3A52A", 3, "%23B3261E", "%23D1D5DB" ) RETURN IF ( CONTAINSSTRING ( _v, ">▲ " & _on & " on track<" ) && CONTAINSSTRING ( _v, ">● " & _wa & " watch<" ) && CONTAINSSTRING ( _v, ">▼ " & _of & " off track<" ) && CONTAINSSTRING ( _v, "r='7' fill='" & _dc ) && CONTAINSSTRING ( _w, SWITCH ( MOD ( _pk, 10 ), 1, "green", 2, "orange", 3, "red", "grey" ) ), "ok", "missing" ) ), "expected", "ok" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "Electronics" }, dim_category[category_name] )
            ,TREATAS ( { "W" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2026" }, dim_item[fy_label] )
            ,TREATAS ( { "W43" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

