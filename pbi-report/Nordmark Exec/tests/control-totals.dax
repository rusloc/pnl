    )

// ==== BLOCK T-N5: identities: back margin = supplier income (ET-07), scopes add up to ALL (ET-12); no measure in an error state
EVALUATE
VAR _t =
    UNION (
        CALCULATETABLE (
                ROW ( "block", "T-N5", "key", "W-FY2026-31", "metric", "ET-07 back margin - supplier income", "actual",
                      [Back Margin] - [Supplier Income], "expected", 0.0, "tol", 0.01 )
                ,dim_week[sort_index] = 83
            )
        ,CALCULATETABLE (
                ROW ( "block", "T-N5", "key", "W-FY2026-31", "metric", "ET-12 NL + BE + ONLINE + WHOLESALE - ALL", "actual",
                      CALCULATE ( [Net Sales], TREATAS ( { "NL" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "BE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], TREATAS ( { "ONLINE" }, param_region[scope_code] ) )
                      + CALCULATE ( [Net Sales], dim_store[channel_code] = "WHOLESALE" )
                      - [Net Sales] + 0, "expected", 0.0, "tol", 0.01 )
