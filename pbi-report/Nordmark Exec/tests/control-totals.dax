                ,ROW ( "block", "T-N9 FY2025 P10 Bud ONLINE", "metric", "info.CHANNEL_MIX", "actual", ( VAR _v = [Info SVG CHANNEL_MIX] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text CHANNEL_MIX], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis CHANNEL_MIX] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text CHANNEL_MIX], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text CHANNEL_MIX], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word CHANNEL_MIX] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 FY2025 P10 Bud ONLINE", "metric", "status line", "actual", ( VAR _pk = [Window Status Pack] VAR _v = [Status Line SVG] VAR _w = [Dot SVG] VAR _on = INT ( _pk / 1000 ) VAR _wa = INT ( MOD ( _pk, 1000 ) / 100 ) VAR _of = INT ( MOD ( _pk, 100 ) / 10 ) VAR _dc = SWITCH ( MOD ( _pk, 10 ), 1, "%232E9E5B", 2, "%23E3A52A", 3, "%23B3261E", "%23D1D5DB" ) RETURN IF ( CONTAINSSTRING ( _v, ">▲ " & _on & " on track<" ) && CONTAINSSTRING ( _v, ">● " & _wa & " watch<" ) && CONTAINSSTRING ( _v, ">▼ " & _of & " off track<" ) && CONTAINSSTRING ( _v, "r='7' fill='" & _dc ) && CONTAINSSTRING ( _w, SWITCH ( MOD ( _pk, 10 ), 1, "green", 2, "orange", 3, "red", "grey" ) ), "ok", "missing" ) ), "expected", "ok" )
            )
            ,TREATAS ( { "ONLINE" }, param_region[scope_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
            ,TREATAS ( { "P" }, param_granularity[granularity_code] )
            ,TREATAS ( { "FY2025" }, dim_item[fy_label] )
            ,TREATAS ( { "P10" }, dim_item[label] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

