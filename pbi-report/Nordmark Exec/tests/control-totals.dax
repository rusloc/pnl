                ,ROW ( "block", "T-N9 reset", "metric", "status line", "actual", ( VAR _pk = [Window Status Pack] VAR _v = [Status Line SVG] VAR _w = [Dot SVG] VAR _on = INT ( _pk / 1000 ) VAR _wa = INT ( MOD ( _pk, 1000 ) / 100 ) VAR _of = INT ( MOD ( _pk, 100 ) / 10 ) VAR _dc = SWITCH ( MOD ( _pk, 10 ), 1, "%232E9E5B", 2, "%23E3A52A", 3, "%23B3261E", "%23D1D5DB" ) RETURN IF ( CONTAINSSTRING ( _v, ">▲ " & _on & " on track<" ) && CONTAINSSTRING ( _v, ">● " & _wa & " watch<" ) && CONTAINSSTRING ( _v, ">▼ " & _of & " off track<" ) && CONTAINSSTRING ( _v, "r='7' fill='" & _dc ) && CONTAINSSTRING ( _w, SWITCH ( MOD ( _pk, 10 ), 1, "green", 2, "orange", 3, "red", "grey" ) ), "ok", "missing" ) ), "expected", "ok" )
            )
            ,REMOVEFILTERS ( param_region )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

