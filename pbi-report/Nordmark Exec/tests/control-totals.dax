                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "card.delta.CHANNEL_MIX", "actual", [Card Delta CHANNEL_MIX], "expected", 0.0, "tol", 2e-06 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "card.status.CHANNEL_MIX", "actual", [Card Status CHANNEL_MIX], "expected", 1.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "card.mix_dev_channel", "actual", [Card Mix Dev Channel No], "expected", 1.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "card.mix_dev_pp", "actual", [Card Mix Dev pp], "expected", 0.0, "tol", 2e-06 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "status.count_on", "actual", [Window Status Count On], "expected", 7.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "status.count_watch", "actual", [Window Status Count Watch], "expected", 2.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "status.count_off", "actual", [Window Status Count Off], "expected", 1.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "status.count_na", "actual", [Window Status Count NA], "expected", 2.0, "tol", 0 )
                ,ROW ( "block", "T-N2 ONLINE YTD LW", "key", "YTD-FY2026-43", "metric", "status.dot", "actual", [Window Status Dot], "expected", 1.0, "tol", 0 )
            )
            ,TREATAS ( { "ONLINE" }, param_region[scope_code] )
            ,TREATAS ( { "YTD" }, param_period[period_code] )
            ,TREATAS ( { "LW" }, param_comparator[comparator_code] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

// ==== BLOCK T-N3: card face texts at Week 43 / All / Budget = prototype v5 (ET-02); N/A under Online; header labels
EVALUATE
VAR _t =
    UNION (
        CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N3", "metric", "value.NET_SALES", "actual", [Card Value Text NET_SALES], "expected", "€61.4" )
                ,ROW ( "block", "T-N3", "metric", "unit.NET_SALES", "actual", [Card Unit Text NET_SALES], "expected", "m" )
                ,ROW ( "block", "T-N3", "metric", "delta.NET_SALES", "actual", [Card Delta Text NET_SALES], "expected", "−€1.5m (−2.4%) vs budget" )
                ,ROW ( "block", "T-N3", "metric", "word.NET_SALES", "actual", [Card Status Word NET_SALES], "expected", "Watch" )
                ,ROW ( "block", "T-N3", "metric", "value.TOTAL_MARGIN", "actual", [Card Value Text TOTAL_MARGIN], "expected", "36.3" )
                ,ROW ( "block", "T-N3", "metric", "unit.TOTAL_MARGIN", "actual", [Card Unit Text TOTAL_MARGIN], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.TOTAL_MARGIN", "actual", [Card Delta Text TOTAL_MARGIN], "expected", "+0.1 pp vs budget 36.2%" )
                ,ROW ( "block", "T-N3", "metric", "word.TOTAL_MARGIN", "actual", [Card Status Word TOTAL_MARGIN], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.WEEKS_OF_COVER", "actual", [Card Value Text WEEKS_OF_COVER], "expected", "11.4" )
                ,ROW ( "block", "T-N3", "metric", "unit.WEEKS_OF_COVER", "actual", [Card Unit Text WEEKS_OF_COVER], "expected", "wks" )
                ,ROW ( "block", "T-N3", "metric", "delta.WEEKS_OF_COVER", "actual", [Card Delta Text WEEKS_OF_COVER], "expected", "+1.9 wks vs target 9.5" )
                ,ROW ( "block", "T-N3", "metric", "word.WEEKS_OF_COVER", "actual", [Card Status Word WEEKS_OF_COVER], "expected", "Watch" )
                ,ROW ( "block", "T-N3", "metric", "value.MARKDOWN", "actual", [Card Value Text MARKDOWN], "expected", "9.8" )
                ,ROW ( "block", "T-N3", "metric", "unit.MARKDOWN", "actual", [Card Unit Text MARKDOWN], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.MARKDOWN", "actual", [Card Delta Text MARKDOWN], "expected", "+1.3 pp vs budget 8.5%" )
                ,ROW ( "block", "T-N3", "metric", "word.MARKDOWN", "actual", [Card Status Word MARKDOWN], "expected", "Off track" )
                ,ROW ( "block", "T-N3", "metric", "value.AVAILABILITY", "actual", [Card Value Text AVAILABILITY], "expected", "94.1" )
                ,ROW ( "block", "T-N3", "metric", "unit.AVAILABILITY", "actual", [Card Unit Text AVAILABILITY], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.AVAILABILITY", "actual", [Card Delta Text AVAILABILITY], "expected", "−2.9 pp vs target 97%" )
                ,ROW ( "block", "T-N3", "metric", "word.AVAILABILITY", "actual", [Card Status Word AVAILABILITY], "expected", "Off track" )
                ,ROW ( "block", "T-N3", "metric", "value.EBITDA", "actual", [Card Value Text EBITDA], "expected", "€15.3" )
                ,ROW ( "block", "T-N3", "metric", "unit.EBITDA", "actual", [Card Unit Text EBITDA], "expected", "m" )
                ,ROW ( "block", "T-N3", "metric", "delta.EBITDA", "actual", [Card Delta Text EBITDA], "expected", "−€0.8m (−5.0%) vs budget" )
                ,ROW ( "block", "T-N3", "metric", "word.EBITDA", "actual", [Card Status Word EBITDA], "expected", "Watch" )
                ,ROW ( "block", "T-N3", "metric", "value.LFL_GROWTH", "actual", [Card Value Text LFL_GROWTH], "expected", "+3.4" )
                ,ROW ( "block", "T-N3", "metric", "unit.LFL_GROWTH", "actual", [Card Unit Text LFL_GROWTH], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.LFL_GROWTH", "actual", [Card Delta Text LFL_GROWTH], "expected", "+0.4 pp vs budget LFL 3.0%" )
                ,ROW ( "block", "T-N3", "metric", "word.LFL_GROWTH", "actual", [Card Status Word LFL_GROWTH], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.FRONT_GM", "actual", [Card Value Text FRONT_GM], "expected", "30.1" )
                ,ROW ( "block", "T-N3", "metric", "unit.FRONT_GM", "actual", [Card Unit Text FRONT_GM], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.FRONT_GM", "actual", [Card Delta Text FRONT_GM], "expected", "+0.1 pp vs budget 30.0%" )
                ,ROW ( "block", "T-N3", "metric", "word.FRONT_GM", "actual", [Card Status Word FRONT_GM], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.SELL_THROUGH", "actual", [Card Value Text SELL_THROUGH], "expected", "63.1" )
                ,ROW ( "block", "T-N3", "metric", "unit.SELL_THROUGH", "actual", [Card Unit Text SELL_THROUGH], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.SELL_THROUGH", "actual", [Card Delta Text SELL_THROUGH], "expected", "+1.1 pp vs target 62%" )
                ,ROW ( "block", "T-N3", "metric", "word.SELL_THROUGH", "actual", [Card Status Word SELL_THROUGH], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.GMROI", "actual", [Card Value Text GMROI], "expected", "2.7" )
                ,ROW ( "block", "T-N3", "metric", "unit.GMROI", "actual", [Card Unit Text GMROI], "expected", "×" )
                ,ROW ( "block", "T-N3", "metric", "delta.GMROI", "actual", [Card Delta Text GMROI], "expected", "+0.2× vs target 2.5×" )
                ,ROW ( "block", "T-N3", "metric", "word.GMROI", "actual", [Card Status Word GMROI], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.SUPPLIER_OTIF", "actual", [Card Value Text SUPPLIER_OTIF], "expected", "95.4" )
                ,ROW ( "block", "T-N3", "metric", "unit.SUPPLIER_OTIF", "actual", [Card Unit Text SUPPLIER_OTIF], "expected", "%" )
                ,ROW ( "block", "T-N3", "metric", "delta.SUPPLIER_OTIF", "actual", [Card Delta Text SUPPLIER_OTIF], "expected", "+0.4 pp vs target 95%" )
                ,ROW ( "block", "T-N3", "metric", "word.SUPPLIER_OTIF", "actual", [Card Status Word SUPPLIER_OTIF], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "value.CHANNEL_MIX", "actual", [Card Value Text CHANNEL_MIX], "expected", "68.4" )
                ,ROW ( "block", "T-N3", "metric", "unit.CHANNEL_MIX", "actual", [Card Unit Text CHANNEL_MIX], "expected", "% store" )
                ,ROW ( "block", "T-N3", "metric", "delta.CHANNEL_MIX", "actual", [Card Delta Text CHANNEL_MIX], "expected", "online +1.9 pp vs plan" )
                ,ROW ( "block", "T-N3", "metric", "word.CHANNEL_MIX", "actual", [Card Status Word CHANNEL_MIX], "expected", "On track" )
                ,ROW ( "block", "T-N3", "metric", "counts", "actual", [Window Status Count On] & "/" & [Window Status Count Watch] & "/" & [Window Status Count Off], "expected", "7/3/2" )
                ,ROW ( "block", "T-N3", "metric", "dot", "actual", SWITCH ( [Window Status Dot], 1, "green", 2, "orange", 3, "red" ), "expected", "orange" )
                ,ROW ( "block", "T-N3", "metric", "header.period", "actual", [Header Period Text], "expected", "**Week 43** · 19–25 Oct 2026" )
                ,ROW ( "block", "T-N3", "metric", "refreshed", "actual", [Refreshed Text], "expected", "Refreshed Mon 26 Oct 05:12" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "W" }, param_period[period_code] )
            ,TREATAS ( { "BUD" }, param_comparator[comparator_code] )
        )
        ,CALCULATETABLE (
            UNION (
                ROW ( "block", "T-N3 ONLINE", "metric", "word.AVAILABILITY", "actual", [Card Status Word AVAILABILITY], "expected", "N/A" )
                ,ROW ( "block", "T-N3 ONLINE", "metric", "value.AVAILABILITY", "actual", [Card Value Text AVAILABILITY], "expected", "n/a" )
                ,ROW ( "block", "T-N3 ONLINE", "metric", "delta.AVAILABILITY", "actual", [Card Delta Text AVAILABILITY], "expected", "n/a vs target" )
                ,ROW ( "block", "T-N3 ONLINE", "metric", "word.LFL_GROWTH", "actual", [Card Status Word LFL_GROWTH], "expected", "N/A" )
                ,ROW ( "block", "T-N3 ONLINE", "metric", "delta.LFL_GROWTH", "actual", [Card Delta Text LFL_GROWTH], "expected", "n/a vs budget LFL" )
            )
            ,TREATAS ( { "ONLINE" }, param_region[scope_code] )
        )
        ,CALCULATETABLE (
            ROW ( "block", "T-N3 YTD", "metric", "header.period", "actual", [Header Period Text], "expected", "**FY2026** to date · 29 Dec 2025–25 Oct 2026" )
            ,TREATAS ( { "YTD" }, param_period[period_code] )
        )
        ,CALCULATETABLE (
            ROW ( "block", "T-N3 PTD", "metric", "header.period", "actual", [Header Period Text], "expected", "**Period 10** to date · 28 Sep–25 Oct 2026" )
            ,TREATAS ( { "PTD" }, param_period[period_code] )
        )
    )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

