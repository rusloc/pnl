                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "status.sell_through", "actual", [Status SELL_THROUGH], "expected", BLANK (), "tol", -1 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "status.supplier_otif", "actual", [Status SUPPLIER_OTIF], "expected", BLANK (), "tol", -1 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "status.total_margin", "actual", [Status TOTAL_MARGIN], "expected", BLANK (), "tol", -1 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "status.weeks_of_cover", "actual", [Status WEEKS_OF_COVER], "expected", 3.0, "tol", 0 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "stock_incl_on_order", "actual", [Stock incl On Order], "expected", 59508466.74, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "total_margin", "actual", [Total Margin], "expected", 104704684.39, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "total_margin_pct", "actual", [Total Margin %], "expected", 0.42852, "tol", 1e-06 )
                ,ROW ( "block", "T-N10 ALL#HOME", "key", "FY-FY2025", "metric", "weeks_of_cover", "actual", [Weeks of Cover], "expected", 25.519888, "tol", 1e-06 )
            )
            ,dim_week[sort_index] >= 1
            ,dim_week[sort_index] <= 52
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "Home & kitchen" }, dim_category[category_name] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

