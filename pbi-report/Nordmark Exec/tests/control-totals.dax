                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "status.total_margin", "actual", [Status TOTAL_MARGIN], "expected", BLANK (), "tol", -1 )
                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "status.weeks_of_cover", "actual", [Status WEEKS_OF_COVER], "expected", 2.0, "tol", 0 )
                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "stock_incl_on_order", "actual", [Stock incl On Order], "expected", 29872273.89, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "total_margin", "actual", [Total Margin], "expected", 124813965.41, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "total_margin_pct", "actual", [Total Margin %], "expected", 0.443322, "tol", 1e-06 )
                ,ROW ( "block", "T-N10 ALL#HB", "key", "FY-FY2025", "metric", "weeks_of_cover", "actual", [Weeks of Cover], "expected", 9.963773, "tol", 1e-06 )
            )
            ,dim_week[sort_index] >= 1
            ,dim_week[sort_index] <= 52
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "Health & beauty" }, dim_category[category_name] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

