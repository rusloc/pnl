                ,ROW ( "block", "T-N10 ALL#TOYS", "key", "FY-FY2025", "metric", "stock_incl_on_order", "actual", [Stock incl On Order], "expected", 28470145.35, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#TOYS", "key", "FY-FY2025", "metric", "total_margin", "actual", [Total Margin], "expected", 55847312.74, "tol", 0.0051 )
                ,ROW ( "block", "T-N10 ALL#TOYS", "key", "FY-FY2025", "metric", "total_margin_pct", "actual", [Total Margin %], "expected", 0.392407, "tol", 1e-06 )
                ,ROW ( "block", "T-N10 ALL#TOYS", "key", "FY-FY2025", "metric", "weeks_of_cover", "actual", [Weeks of Cover], "expected", 17.092978, "tol", 1e-06 )
            )
            ,dim_week[sort_index] >= 1
            ,dim_week[sort_index] <= 52
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "Toys & leisure" }, dim_category[category_name] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

