                ,ROW ( "block", "T-N9 reset", "metric", "card.AVAILABILITY", "actual", ( VAR _v = [Card SVG AVAILABILITY] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text AVAILABILITY], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status AVAILABILITY], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "medium" = "small", "", " " & [Card Status Word AVAILABILITY] ) & "</text>" ), "", " chip" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text AVAILABILITY], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "info.AVAILABILITY", "actual", ( VAR _v = [Info SVG AVAILABILITY] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text AVAILABILITY], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis AVAILABILITY] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text AVAILABILITY], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text AVAILABILITY], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word AVAILABILITY] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "card.EBITDA", "actual", ( VAR _v = [Card SVG EBITDA] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text EBITDA], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status EBITDA], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "medium" = "small", "", " " & [Card Status Word EBITDA] ) & "</text>" ), "", " chip" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text EBITDA], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "info.EBITDA", "actual", ( VAR _v = [Info SVG EBITDA] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text EBITDA], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis EBITDA] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text EBITDA], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Long Text EBITDA], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word EBITDA] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "card.LFL_GROWTH", "actual", ( VAR _v = [Card SVG LFL_GROWTH] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text LFL_GROWTH], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status LFL_GROWTH], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "small" = "small", "", " " & [Card Status Word LFL_GROWTH] ) & "</text>" ), "", " chip" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
