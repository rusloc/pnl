                ,ROW ( "block", "T-N9 reset", "metric", "card.FRONT_GM", "actual", ( VAR _v = [Card SVG FRONT_GM] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text FRONT_GM], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status FRONT_GM], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "small" = "small", "", " " & [Card Status Word FRONT_GM] ) & "</text>" ), "", " chip" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "info.FRONT_GM", "actual", ( VAR _v = [Info SVG FRONT_GM] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text FRONT_GM], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis FRONT_GM] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text FRONT_GM], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text FRONT_GM], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word FRONT_GM] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "card.SELL_THROUGH", "actual", ( VAR _v = [Card SVG SELL_THROUGH] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text SELL_THROUGH], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status SELL_THROUGH], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "small" = "small", "", " " & [Card Status Word SELL_THROUGH] ) & "</text>" ), "", " chip" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "info.SELL_THROUGH", "actual", ( VAR _v = [Info SVG SELL_THROUGH] VAR _m = IF ( CONTAINSSTRING ( _v, "letter-spacing='-1.4'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text SELL_THROUGH], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, IF ( ISBLANK ( [Card Basis SELL_THROUGH] ), "font-weight='700' fill='%235F6878'>–</text>", "letter-spacing='-1'>" & SUBSTITUTE ( SUBSTITUTE ( [Card Basis Text SELL_THROUGH], "%", "%25" ), "#", "%23" ) & "<tspan dx='4'" ) ), "", " basis" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text SELL_THROUGH], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) & IF ( CONTAINSSTRING ( _v, ">" & [Card Status Word SELL_THROUGH] & "</text>" ), "", " word" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
                ,ROW ( "block", "T-N9 reset", "metric", "card.GMROI", "actual", ( VAR _v = [Card SVG GMROI] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text GMROI], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status GMROI], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "small" = "small", "", " " & [Card Status Word GMROI] ) & "</text>" ), "", " chip" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
