                ,ROW ( "block", "T-N10 ALL#AMBIENT", "key", "FY-FY2025", "metric", "total_margin_pct", "actual", [Total Margin %], "expected", 0.316565, "tol", 1e-06 )
                ,ROW ( "block", "T-N10 ALL#AMBIENT", "key", "FY-FY2025", "metric", "weeks_of_cover", "actual", [Weeks of Cover], "expected", 8.859701, "tol", 1e-06 )
            )
            ,dim_week[sort_index] >= 1
            ,dim_week[sort_index] <= 52
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
            ,TREATAS ( { "Ambient grocery" }, dim_category[category_name] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

