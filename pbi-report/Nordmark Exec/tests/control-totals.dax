                ,ROW ( "block", "T-N3 reset", "metric", "word.LFL_GROWTH", "actual", [Card Status Word LFL_GROWTH], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "value.FRONT_GM", "actual", [Card Value Text FRONT_GM], "expected", "30.1" )
                ,ROW ( "block", "T-N3 reset", "metric", "unit.FRONT_GM", "actual", [Card Unit Text FRONT_GM], "expected", "%" )
                ,ROW ( "block", "T-N3 reset", "metric", "delta.FRONT_GM", "actual", [Card Delta Text FRONT_GM], "expected", "+0.1 pp vs budget 30.0%" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.FRONT_GM", "actual", [Card Status Word FRONT_GM], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "value.SELL_THROUGH", "actual", [Card Value Text SELL_THROUGH], "expected", "63.1" )
                ,ROW ( "block", "T-N3 reset", "metric", "unit.SELL_THROUGH", "actual", [Card Unit Text SELL_THROUGH], "expected", "%" )
                ,ROW ( "block", "T-N3 reset", "metric", "delta.SELL_THROUGH", "actual", [Card Delta Text SELL_THROUGH], "expected", "+1.1 pp vs target 62%" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.SELL_THROUGH", "actual", [Card Status Word SELL_THROUGH], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "value.GMROI", "actual", [Card Value Text GMROI], "expected", "2.7" )
                ,ROW ( "block", "T-N3 reset", "metric", "unit.GMROI", "actual", [Card Unit Text GMROI], "expected", "×" )
                ,ROW ( "block", "T-N3 reset", "metric", "delta.GMROI", "actual", [Card Delta Text GMROI], "expected", "+0.2× vs target 2.5×" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.GMROI", "actual", [Card Status Word GMROI], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "value.SUPPLIER_OTIF", "actual", [Card Value Text SUPPLIER_OTIF], "expected", "95.4" )
                ,ROW ( "block", "T-N3 reset", "metric", "unit.SUPPLIER_OTIF", "actual", [Card Unit Text SUPPLIER_OTIF], "expected", "%" )
                ,ROW ( "block", "T-N3 reset", "metric", "delta.SUPPLIER_OTIF", "actual", [Card Delta Text SUPPLIER_OTIF], "expected", "+0.4 pp vs target 95%" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.SUPPLIER_OTIF", "actual", [Card Status Word SUPPLIER_OTIF], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "value.CHANNEL_MIX", "actual", [Card Value Text CHANNEL_MIX], "expected", "68.4" )
                ,ROW ( "block", "T-N3 reset", "metric", "unit.CHANNEL_MIX", "actual", [Card Unit Text CHANNEL_MIX], "expected", "% store" )
                ,ROW ( "block", "T-N3 reset", "metric", "delta.CHANNEL_MIX", "actual", [Card Delta Text CHANNEL_MIX], "expected", "online +1.9 pp vs plan" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.CHANNEL_MIX", "actual", [Card Status Word CHANNEL_MIX], "expected", "On track" )
                ,ROW ( "block", "T-N3 reset", "metric", "item", "actual", [_Item Key], "expected", "FY2026-W43" )
                ,ROW ( "block", "T-N3 reset", "metric", "counts", "actual", [Window Status Count On] & "/" & [Window Status Count Watch] & "/" & [Window Status Count Off], "expected", "7/3/2" )
                ,ROW ( "block", "T-N3 reset", "metric", "dot", "actual", SWITCH ( [Window Status Dot], 1, "green", 2, "orange", 3, "red" ), "expected", "orange" )
                ,ROW ( "block", "T-N3 reset", "metric", "header.period", "actual", [Header Period Text], "expected", "**Week 43** · 19–25 Oct 2026" )
                ,ROW ( "block", "T-N3 reset", "metric", "header.comparator", "actual", [Header Comparator Text], "expected", "vs **Budget**" )
                ,ROW ( "block", "T-N3 reset", "metric", "phrase", "actual", [Period Phrase], "expected", "week 43" )
                ,ROW ( "block", "T-N3 reset", "metric", "title", "actual", [Item Title], "expected", "Week 43" )
                ,ROW ( "block", "T-N3 reset", "metric", "ebitda.sub", "actual", IF ( CONTAINSSTRING ( [Card SVG EBITDA], "EBITDA flash<tspan font-weight='400' fill='%235F6878'> · month 10 to date · prov.</tspan>" ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N3 reset", "metric", "net_sales.sub", "actual", IF ( CONTAINSSTRING ( [Card SVG NET_SALES], "> · week 43, all channels</tspan>" ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N3 reset", "metric", "showing", "actual", IF ( CONTAINSSTRING ( [Menu Showing SVG], ">Showing <tspan font-weight='600' fill='%23111827'>Week 43</tspan> · 19–25 Oct 2026<" ), "ok", "missing" ), "expected", "ok" )
                ,ROW ( "block", "T-N3 reset", "metric", "refreshed", "actual", [Refreshed Text], "expected", "Refreshed Mon 26 Oct 05:12" )
            )
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
        )
RETURN
    SELECTCOLUMNS ( _t, "block", [block], "metric", [metric], "actual", [actual], "expected", [expected], "_pass", [actual] == [expected] )

