            ,dim_week[sort_index] >= 92
            ,dim_week[sort_index] <= 95
            ,TREATAS ( { "ALL" }, param_region[scope_code] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _t
        ,"block", [block]
        ,"key", [key]
        ,"metric", [metric]
        ,"actual", [actual]
        ,"expected", [expected]
        ,"_pass", IF ( ISBLANK ( [expected] ), ISBLANK ( [actual] ), NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] )
    )

