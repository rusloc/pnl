                ,ROW ( "block", "T-N3 reset", "metric", "delta.EBITDA", "actual", [Card Delta Text EBITDA], "expected", "−€0.8m (−5.0%) vs budget" )
                ,ROW ( "block", "T-N3 reset", "metric", "word.EBITDA", "actual", [Card Status Word EBITDA], "expected", "Watch" )
