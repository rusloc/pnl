                ,ROW ( "block", "T-N9 reset", "metric", "card.MARKDOWN", "actual", ( VAR _v = [Card SVG MARKDOWN] VAR _m = IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Value Text MARKDOWN], "%", "%25" ), "#", "%23" ) & "<tspan" ), "", " value" ) & IF ( CONTAINSSTRING ( _v, ">" & SWITCH ( [Card Status MARKDOWN], 1, "▲", 2, "●", 3, "▼", "–" ) & IF ( "medium" = "small", "", " " & [Card Status Word MARKDOWN] ) & "</text>" ), "", " chip" ) & IF ( CONTAINSSTRING ( _v, ">" & SUBSTITUTE ( SUBSTITUTE ( [Card Delta Text MARKDOWN], "%", "%25" ), "#", "%23" ) & "</text>" ), "", " delta" ) RETURN IF ( _m = "", "ok", "missing" & _m ) ), "expected", "ok" )
