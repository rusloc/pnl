/// Filters menu attribute Statement (E-53): multi-select, OR within, AND across. Disconnected; matched to dim_kpi[statement].
table param_attr_statement
	lineageTag: 2a36395b-95ad-5ff9-bbb8-2ef1827bbc72

	column attr_code
		dataType: string
		isHidden
		lineageTag: 8b206b50-37ca-59b3-bc29-8bdc9d794d34
		summarizeBy: none
		isNameInferred
		sourceColumn: [attr_code]

		annotation SummarizationSetBy = User

	column attr_label
		dataType: string
		lineageTag: 18cf74d7-1fe5-5036-bdc9-7924a1219d19
		summarizeBy: none
		isNameInferred
		sourceColumn: [attr_label]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e05cc5d2-9c82-544b-987f-f902940b787e
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition param_attr_statement = calculated
		mode: import
		source =
				DATATABLE (
				    "attr_code", STRING
				    ,"attr_label", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "pl", "P&L", 1 }
				        ,{ "bs", "Balance sheet", 2 }
				        ,{ "ops", "Operational", 3 }
				    }
				)

	annotation PBI_ResultType = Table
