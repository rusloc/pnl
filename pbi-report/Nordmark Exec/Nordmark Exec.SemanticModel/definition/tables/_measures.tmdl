	/// Stock on hand at cost. Point in time: the window's last week-end (E-13).
	measure 'On Hand Cost' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_Inv On Hand Cost]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: a2964340-e5fa-5e7b-92ff-d078922014d4

	/// Stock on order at cost. Point in time: the window's last week-end (E-13).
	measure 'On Order Cost' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_Inv On Order Cost]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: 8484bc98-0d10-535f-b666-357932dd005a

	/// On hand + on order at cost (E-35).
	measure 'Stock incl On Order' = [On Hand Cost] + [On Order Cost]
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: 28c97a91-e321-5d14-b9ba-891f81960ac4

	/// Forecast weekly COGS of the window's last week. Point in time: the window's last week-end (E-13).
	measure 'Forecast COGS' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_Forecast COGS]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: 88a43129-948a-54e6-b922-de25a297daa3

	/// (On hand + on order) / forecast weekly COGS at the last week-end; fallback R4W average COGS when the forecast is blank (E-35, ET-08).
	measure 'Weeks of Cover' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _forecast   = [Forecast COGS]
			VAR _stock      = [Stock incl On Order]
			VAR _r4w        =
			    DIVIDE (
			        CALCULATE (
			            [COGS]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] > _last - 4
			            ,dim_week[sort_index] <= _last
			        )
			        ,4
			    )
			RETURN
			    IF ( _forecast <> 0, DIVIDE ( _stock, _forecast ), DIVIDE ( _stock, _r4w ) )
		formatString: 0.0
		displayFolder: 4 Stock & supply
		lineageTag: cedcc4fb-f5de-5411-bf99-337935249b5b

	/// Forecast-COGS-weighted category cover target, same week and scope (9.5 at ALL, ET-08).
	measure 'Cover Target Wks' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    DIVIDE (
			        CALCULATE ( [_Forecast x Cover Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _last )
			        ,CALCULATE ( [_Forecast COGS], REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _last )
			    )
		formatString: 0.0
		displayFolder: 4 Stock & supply
		lineageTag: 06414198-a719-59d8-b2bf-462be4527142

	/// Ranged top-500 SKU-days (stores only). Point in time: the window's last week-end (E-13).
	measure 'Ranged SKU Days' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_Ranged SKU Days]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: 9b6c2be5-ce24-5eed-b0f7-84a32d1011e1

	/// In-stock SKU-days. Point in time: the window's last week-end (E-13).
	measure 'In Stock SKU Days' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_In Stock SKU Days]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
		formatString: #,0.0
		displayFolder: 4 Stock & supply
		lineageTag: 9c7902c3-1fca-5a73-be83-1b39b7147e27

	/// In-stock / ranged SKU-days, last week; N/A for ONLINE (E-36).
	measure 'Availability %' =
			VAR _ranged     = [Ranged SKU Days]
			RETURN
			    IF ( _ranged <> 0, DIVIDE ( [In Stock SKU Days], _ranged ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: 4aca34ee-5c16-503b-ab37-1924039f36d6

	/// Availability target, param_target ALL (97 %).
	measure 'Availability Target' = LOOKUPVALUE ( param_target[target_value], param_target[kpi_code], "AVAILABILITY", param_target[category_code], "ALL" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: e2c32067-2fe8-5182-8cbf-c7ea5dd6e38d

	/// Season week of the window's last week (AW26 = W32-W51; blank outside a season, E-16).
	measure 'Season Week' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE ( MAX ( dim_week[season_week] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _last )
		formatString: 0
		displayFolder: 4 Stock & supply
		lineageTag: 4425c9ed-b278-5f6a-a4cf-296980f14a44

	/// Seasonal on-hand units at the week-end before season week 1, selling locations (E-37).
	measure 'Season Opening Units' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _sw         = [Season Week]
			RETURN
			    IF (
			        NOT ISBLANK ( _sw )
			        ,CALCULATE (
			            [_Inv On Hand Units]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] = _last - _sw
			            ,dim_store[channel_code] IN { "STORE", "ONLINE" }
			            ,dim_category[is_seasonal] = TRUE ()
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: f4d2b39f-d6a5-57c5-a9c4-a0c121b1d3cf

	/// Seasonal receipts season to date (E-37).
	measure 'Season Receipt Units' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _sw         = [Season Week]
			RETURN
			    IF (
			        NOT ISBLANK ( _sw )
			        ,CALCULATE (
			            [_Receipt Units]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] > _last - _sw
			            ,dim_week[sort_index] <= _last
			            ,dim_category[is_seasonal] = TRUE ()
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: b8fc55dc-33f8-5d2b-bc20-e227683c3cba

	/// Seasonal units sold season to date, stores and ONLINE (wholesale excluded, E-37).
	measure 'Season Units Sold' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _sw         = [Season Week]
			RETURN
			    IF (
			        NOT ISBLANK ( _sw )
			        ,CALCULATE (
			            [_Units]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] > _last - _sw
			            ,dim_week[sort_index] <= _last
			            ,dim_store[channel_code] IN { "STORE", "ONLINE" }
			            ,dim_category[is_seasonal] = TRUE ()
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: e2255454-a1bd-5bce-a5cb-e5471902a7bd

	/// Sold / (opening + receipts), season to date; N/A outside a season (E-37; bars 12 -> 63 %, data README open point 13).
	measure 'Sell-through %' =
			VAR _sw         = [Season Week]
			RETURN
			    IF (
			        NOT ISBLANK ( _sw )
			        ,DIVIDE ( [Season Units Sold], [Season Opening Units] + [Season Receipt Units] )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: 6c68876d-b752-57ee-823b-3b5b9b096be2

	/// Season sell-through target (62 %).
	measure 'Sell-through Target' = IF ( NOT ISBLANK ( [Season Week] ), LOOKUPVALUE ( param_target[target_value], param_target[kpi_code], "SELL_THROUGH", param_target[category_code], "ALL" ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: 6f7af238-da9e-5dd9-8270-24f5669f484d

	/// Front margin over the 52 weeks ending with the window's last week (E-38, OQ 11).
	measure 'GMROI Front Margin R52W' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    IF (
			        _last >= 52
			        ,CALCULATE (
			            [Front Margin]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] > _last - 52
			            ,dim_week[sort_index] <= _last
			        )
			    )
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: 8061b927-96b8-57c0-940d-09a9ec6d34c7

	/// Average on-hand cost over the 52 week-ends (on-order and in-transit excluded, E-38).
	measure 'GMROI Avg On Hand Cost' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    IF (
			        _last >= 52
			        ,DIVIDE (
			            CALCULATE (
			                [_Inv On Hand Cost]
			                ,REMOVEFILTERS ( dim_week )
			                ,dim_week[sort_index] > _last - 52
			                ,dim_week[sort_index] <= _last
			            )
			            ,52
			        )
			    )
		formatString: #,0.00
		displayFolder: 4 Stock & supply
		lineageTag: 038d80c1-7539-5cf0-b24e-166e74194d1b

	/// GMROI = R52W front margin / average on-hand cost (E-38).
	measure GMROI = DIVIDE ( [GMROI Front Margin R52W], [GMROI Avg On Hand Cost] )
		formatString: 0.00
		displayFolder: 4 Stock & supply
		lineageTag: 9c02b818-a158-5dd0-9134-32911785f83a

	/// GMROI target 2.5x.
	measure 'GMROI Target' = IF ( MAX ( dim_week[sort_index] ) >= 52, LOOKUPVALUE ( param_target[target_value], param_target[kpi_code], "GMROI", param_target[category_code], "ALL" ) )
		formatString: 0.0
		displayFolder: 4 Stock & supply
		lineageTag: 479a9651-70db-5d12-ba5a-71292f4b9499

	/// PO lines due. No site key: the same in every scope.
	measure 'PO Lines Due' = SUM ( fact_po_week[po_lines_due] )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: 9ac52140-2503-5ca3-b4fb-0cae09039fdb

	/// PO lines on time in full.
	measure 'PO Lines OTIF' = SUM ( fact_po_week[po_lines_otif] )
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: fe54e618-09dd-5c95-b4c8-f746f47ddc46

	/// Supplier OTIF % over the window (E-39).
	measure 'OTIF %' = DIVIDE ( [PO Lines OTIF], [PO Lines Due] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: 0114c272-dd0c-5c5c-a09e-1d9e88be9ce4

	/// OTIF target 95 %.
	measure 'OTIF Target' = LOOKUPVALUE ( param_target[target_value], param_target[kpi_code], "SUPPLIER_OTIF", param_target[category_code], "ALL" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Stock & supply
		lineageTag: 9da30273-393e-5cd6-b468-85fdce9fcea5

	/// Suppliers below 85 % OTIF in the window's last week (OTIF card stat).
	measure 'OTIF Suppliers Below 85' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( fact_po_week, REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _last )
			            ,fact_po_week[po_lines_otif] < 0.85 * fact_po_week[po_lines_due]
			        )
			    ) + 0
		formatString: #,0
		displayFolder: 4 Stock & supply
		lineageTag: c268b15c-7a2f-513e-87e0-6af5e4ec3500

	/// Store channel net sales over the window (E-41).
	measure 'Mix Store Net Sales' = CALCULATE ( [Net Sales], dim_store[channel_code] = "STORE" ) + 0
		formatString: #,0.00
		displayFolder: 5 Channel mix
		lineageTag: c720f594-0781-5b93-9ebb-674277037a1f

	/// Store share of net sales over the whole window (E-41; at Week the week itself).
	measure 'Mix Store %' = DIVIDE ( [Mix Store Net Sales], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 2a6370e0-3709-575d-b1d6-7ddb5deca182

	/// Plan store share = budget net-sales share over the same window (E-41); blank without budget (FY2025).
	measure 'Mix Store % Bud' =
			VAR _total      = [Net Sales Bud]
			RETURN
			    IF (
			        NOT ISBLANK ( _total )
			        ,DIVIDE ( CALCULATE ( [Net Sales Bud], dim_store[channel_code] = "STORE" ) + 0, _total )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 9ef130ba-6aa8-5333-ae63-93973659e582

	/// Online channel net sales over the window (E-41).
	measure 'Mix Online Net Sales' = CALCULATE ( [Net Sales], dim_store[channel_code] = "ONLINE" ) + 0
		formatString: #,0.00
		displayFolder: 5 Channel mix
		lineageTag: 51ed191b-a2be-543d-a4b4-582db488a835

	/// Online share of net sales over the whole window (E-41; at Week the week itself).
	measure 'Mix Online %' = DIVIDE ( [Mix Online Net Sales], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 630c7560-6b17-5d43-bd6e-a18bf49985b3

	/// Plan online share = budget net-sales share over the same window (E-41); blank without budget (FY2025).
	measure 'Mix Online % Bud' =
			VAR _total      = [Net Sales Bud]
			RETURN
			    IF (
			        NOT ISBLANK ( _total )
			        ,DIVIDE ( CALCULATE ( [Net Sales Bud], dim_store[channel_code] = "ONLINE" ) + 0, _total )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 3c75b7b0-1b4c-5ee1-9847-cd2850a7c5fe

	/// Wholesale channel net sales over the window (E-41).
	measure 'Mix Wholesale Net Sales' = CALCULATE ( [Net Sales], dim_store[channel_code] = "WHOLESALE" ) + 0
		formatString: #,0.00
		displayFolder: 5 Channel mix
		lineageTag: 46b82a20-9cb0-5dc6-8ca4-03f987754068

	/// Wholesale share of net sales over the whole window (E-41; at Week the week itself).
	measure 'Mix Wholesale %' = DIVIDE ( [Mix Wholesale Net Sales], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 1ec0c371-295b-5a2a-99e1-ebd85666e57f

	/// Plan wholesale share = budget net-sales share over the same window (E-41); blank without budget (FY2025).
	measure 'Mix Wholesale % Bud' =
			VAR _total      = [Net Sales Bud]
			RETURN
			    IF (
			        NOT ISBLANK ( _total )
			        ,DIVIDE ( CALCULATE ( [Net Sales Bud], dim_store[channel_code] = "WHOLESALE" ) + 0, _total )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: 4ba5521b-4eea-5d5f-a996-f61dca3711c0

	/// Channel with the largest absolute deviation from the plan mix (1 store, 2 online, 3 wholesale; first on a tie). pp is signed.
	measure 'Mix Max Dev pp' =
			VAR _b1         = [Mix Store % Bud]
			VAR _d1         = [Mix Store %] - _b1
			VAR _d2         = [Mix Online %] - [Mix Online % Bud]
			VAR _d3         = [Mix Wholesale %] - [Mix Wholesale % Bud]
			VAR _j          =
			    SWITCH (
			        TRUE ()
			        ,ABS ( _d1 ) >= ABS ( _d2 ) && ABS ( _d1 ) >= ABS ( _d3 )
			            ,1
			        ,ABS ( _d2 ) >= ABS ( _d3 )
			            ,2
			        ,3
			    )
			RETURN
			    IF ( NOT ISBLANK ( _b1 ), SWITCH ( _j, 1, _d1, 2, _d2, _d3 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Channel mix
		lineageTag: e8d76039-3bad-53e4-8d95-134d4189c959

	/// Channel with the largest absolute deviation from the plan mix (1 store, 2 online, 3 wholesale; first on a tie). pp is signed.
	measure 'Mix Max Dev Channel' =
			VAR _b1         = [Mix Store % Bud]
			VAR _d1         = [Mix Store %] - _b1
			VAR _d2         = [Mix Online %] - [Mix Online % Bud]
			VAR _d3         = [Mix Wholesale %] - [Mix Wholesale % Bud]
			VAR _j          =
			    SWITCH (
			        TRUE ()
			        ,ABS ( _d1 ) >= ABS ( _d2 ) && ABS ( _d1 ) >= ABS ( _d3 )
			            ,1
			        ,ABS ( _d2 ) >= ABS ( _d3 )
			            ,2
			        ,3
			    )
			RETURN
			    IF ( NOT ISBLANK ( _b1 ), _j )
		formatString: 0
		displayFolder: 5 Channel mix
		lineageTag: 360e8988-517e-526c-9584-c0190bfcb5ef

	/// Status of NET_SALES: 1 On track, 2 Watch, 3 Off track, blank N/A. Always vs budget / target (E-22, E-24); N/A where the value or its basis is blank (FY2025 has no budget, E-95); badness rounded to 10 decimals, the Watch edge is Watch (data README Status, open point 9).
	measure 'Status NET_SALES' =
			VAR _bud        = [Net Sales Bud]
			VAR _bad        = IF ( _bud <> 0, 1 - DIVIDE ( [Net Sales], _bud ) )
			VAR _watch      = LOOKUPVALUE ( param_status_rule[watch_from], param_status_rule[rule_code], "NET_SALES" )
			VAR _off        = LOOKUPVALUE ( param_status_rule[off_from], param_status_rule[rule_code], "NET_SALES" )
			VAR _r          = ROUND ( _bad, 10 )
			RETURN
			    IF (
			        NOT ISBLANK ( _bad )
			        ,SWITCH (
			            TRUE ()
			            ,_r <= _watch
			                ,1
			            ,_r <= _off
			                ,2
			            ,3
			        )
			    )
		formatString: 0
		displayFolder: 7 Status
		lineageTag: 7ddd17a6-ce42-50a7-aa27-2eb61aec53b6

	/// Status of TOTAL_MARGIN: 1 On track, 2 Watch, 3 Off track, blank N/A. Always vs budget / target (E-22, E-24); N/A where the value or its basis is blank (FY2025 has no budget, E-95); badness rounded to 10 decimals, the Watch edge is Watch (data README Status, open point 9).
	measure 'Status TOTAL_MARGIN' =
			VAR _act        = [Total Margin %]
			VAR _bas        = [Total Margin % Bud]
			VAR _bad        = IF ( NOT ISBLANK ( _act ) && NOT ISBLANK ( _bas ), _bas - _act )
			VAR _watch      = LOOKUPVALUE ( param_status_rule[watch_from], param_status_rule[rule_code], "TOTAL_MARGIN" )
			VAR _off        = LOOKUPVALUE ( param_status_rule[off_from], param_status_rule[rule_code], "TOTAL_MARGIN" )
			VAR _r          = ROUND ( _bad, 10 )
