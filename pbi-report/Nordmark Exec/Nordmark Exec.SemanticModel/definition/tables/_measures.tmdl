			VAR _xa46        = IF ( _xw46 = "", _xa45, IF ( _xf46, _xa45 & " " & _xw46, _xa45 & "|" & _xw46 ) )
			VAR _xc46        = IF ( _xw46 = "", _xc45, IF ( _xf46, _xc45 & " " & _xw46, _xw46 ) )
			VAR _xf47        = LEN ( _xc46 ) + 1 + LEN ( _xw47 ) <= 52
			VAR _xa47        = IF ( _xw47 = "", _xa46, IF ( _xf47, _xa46 & " " & _xw47, _xa46 & "|" & _xw47 ) )
			VAR _xc47        = IF ( _xw47 = "", _xc46, IF ( _xf47, _xc46 & " " & _xw47, _xw47 ) )
			VAR _xf48        = LEN ( _xc47 ) + 1 + LEN ( _xw48 ) <= 52
			VAR _xa48        = IF ( _xw48 = "", _xa47, IF ( _xf48, _xa47 & " " & _xw48, _xa47 & "|" & _xw48 ) )
			VAR _xc48        = IF ( _xw48 = "", _xc47, IF ( _xf48, _xc47 & " " & _xw48, _xw48 ) )
			VAR _n          = MIN ( PATHLENGTH ( _xa48 ), 6 )
			VAR _dy         = _n * 19 + 7
			VAR _h          = 479 + _dy
			VAR _footr      = "Updated weekly"
			VAR _head       =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='683' viewBox='0 0 520 683' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='519' height='" & FORMAT ( _h - 1, "0" ) & "' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Explains Tier 1 · " & _sub ) & "</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Sell-through</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text SELL_THROUGH]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text SELL_THROUGH] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
			        & "<text x='52' y='160' font-size='16' font-weight='600' fill='#374151'>Target"
			        & "<tspan dx='8' font-size='32' font-weight='700' fill='#111827' letter-spacing='-0.6'>" & [Card Basis Text SELL_THROUGH]
			        & "<tspan dx='4' font-size='16' font-weight='600' fill='#374151' letter-spacing='0'>" & _tunit & "</tspan></tspan></text>"
			        & "<text x='24' y='187' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dlong & "</text>"
			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>The share of the season’s stock we have sold so far.</text><text x='24' y='302' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='303' font-size='13' font-weight='400' fill='#111827'>It says whether the season is clearing on time or heading</text><text x='156' y='322' font-size='13' font-weight='400' fill='#111827'>for clearance markdown.</text><text x='24' y='347' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='348' font-size='13' font-weight='400' fill='#111827'>Units sold season to date ÷ (opening stock units + units</text><text x='156' y='367' font-size='13' font-weight='400' fill='#111827'>received).</text>"
			        & "<text x='24' y='392' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='393' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='412' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='431' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='392' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='393' font-size='13' font-weight='400' fill='#111827'>Watch when −5 pp to 0 vs the season target; Off track</text><text x='156' y='412' font-size='13' font-weight='400' fill='#111827'>below −5 pp.</text><rect x='24.0' y='437' width='140.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='451' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B3 stock &amp; supply</tspan></text><rect x='170.5' y='437' width='74.2' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='179.5' y='451' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Stock</tspan></text><rect x='250.7' y='437' width='112.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='259.7' y='451' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Commercial</tspan></text>"
			        & "<text x='496' y='451' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & _footr & "</text>"
			        & "</g>"
			VAR _svg        = _head & _bars & _body & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: 52c69bd4-3b0a-59bb-8ba2-769deb5b3c25
		dataCategory: ImageUrl

	/// GMROI i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG GMROI' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status GMROI]
			VAR _sub        = "rolling 12 months" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "GMROI" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text GMROI]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis GMROI] ), "", "×" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [GMROI], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [GMROI Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
