			        & "<rect x='" & FORMAT ( 421 - _cw, "0.0" ) & "' y='11' width='" & FORMAT ( _cw, "0.0" ) & "' height='22' rx='11' fill='" & _tint & "'/>"
			        & "<text x='" & FORMAT ( 421 - _cw / 2, "0.0" ) & "' y='26' text-anchor='middle' font-size='11.5' font-weight='600' fill='" & _ink & "'>" & _chip & "</text>"
			        & "<text x='16' y='67' font-size='30' font-weight='600' fill='#111827' letter-spacing='-0.5'>" & _val
			        & "<tspan font-size='13' font-weight='500' fill='#5F6878' letter-spacing='0' dx='4'>" & _unit & "</tspan></text>"
			        & "<text x='16' y='90' font-size='12.5' font-weight='600' fill='" & _dink & "'>" & _dt & "</text>"
			        & "<circle cx='30' cy='151' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(22 143) scale(0.8)'><path d='M10 8.6v5.2' stroke='#5F6878' stroke-width='1.8' stroke-linecap='round' fill='none'/><circle cx='10' cy='5.6' r='1' fill='#5F6878'/></g><circle cx='62' cy='151' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(54 143) scale(0.8)'><g fill='none' stroke='#5F6878' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='5.8' cy='13' r='3'/><circle cx='14.2' cy='13' r='3'/><path d='M8.8 12.3h2.4M6.6 10.1 7.4 5.6h2.1l.4 2.6M13.4 10.1 12.6 5.6h-2.1l-.4 2.6'/></g></g>"
			        & _bars
