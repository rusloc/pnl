			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M109 " & FORMAT ( 99 + 58 - ( _tgt - _lo ) / ( _hi - _lo ) * 58, "0.0" )
			            & " H197' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _labels     = ""
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='213' height='168' viewBox='0 0 213 168' font-family='Segoe UI, sans-serif'><defs><linearGradient id='wW' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#FFD3A0' stop-opacity='0.5'/></linearGradient><linearGradient id='wO' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#F3C9C5' stop-opacity='0.5'/></linearGradient><filter id='gs'><feColorMatrix type='saturate' values='0'/></filter></defs>"
			        & "<g" & IF ( _rev, "", " opacity='0.08' filter='url(#gs)'" ) & ">" & _bg
			        & "<text x='16' y='27' font-size='13.5' font-weight='600' fill='#111827'>Front gross margin</text>"
			        & "<circle cx='186' cy='22' r='11' fill='" & _tint & "'/><text x='186' y='26' text-anchor='middle' font-size='11' font-weight='600' fill='" & _ink & "'>" & _glyph & "</text>"
			        & "<text x='16' y='64' font-size='26' font-weight='600' fill='#111827' letter-spacing='-0.5'>" & _val
			        & "<tspan font-size='13' font-weight='500' fill='#5F6878' letter-spacing='0' dx='4'>" & _unit & "</tspan></text>"
			        & "<text x='16' y='85' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl1 & "</text>"
			        & "<text x='16' y='101' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl2 & "</text>"
			        & "<text x='16' y='117' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl3 & "</text>"
			        & "<circle cx='30' cy='143' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(22 135) scale(0.8)'><path d='M10 8.6v5.2' stroke='#5F6878' stroke-width='1.8' stroke-linecap='round' fill='none'/><circle cx='10' cy='5.6' r='1' fill='#5F6878'/></g><circle cx='62' cy='143' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(54 135) scale(0.8)'><g fill='none' stroke='#5F6878' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='5.8' cy='13' r='3'/><circle cx='14.2' cy='13' r='3'/><path d='M8.8 12.3h2.4M6.6 10.1 7.4 5.6h2.1l.4 2.6M13.4 10.1 12.6 5.6h-2.1l-.4 2.6'/></g></g>"
			        & _bars
			        & "</g></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: 66b9b6da-26c4-5384-88ee-43caf55b4963
