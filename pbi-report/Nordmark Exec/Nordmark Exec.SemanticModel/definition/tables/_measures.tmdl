			VAR _dc4        = IF ( _dw4 = "", _dc3, IF ( _df4, _dc3 & " " & _dw4, _dw4 ) )
			VAR _df5        = LEN ( _dc4 ) + 1 + LEN ( _dw5 ) <= 14
