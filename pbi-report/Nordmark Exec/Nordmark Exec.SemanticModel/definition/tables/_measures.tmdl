	/// Forecast COGS weighted by the category cover target. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure '_Forecast x Cover Target' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUMX ( fact_forecast_week, fact_forecast_week[forecast_cogs] * RELATED ( dim_category[cover_target_wks] ) )
			        ,CALCULATE ( SUMX ( fact_forecast_week, fact_forecast_week[forecast_cogs] * RELATED ( dim_category[cover_target_wks] ) ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: cb90b7ea-b983-5372-966f-2e21a8ee4507

