			VAR _watch      = LOOKUPVALUE ( param_status_rule[watch_from], param_status_rule[rule_code], "CHANNEL_MIX" )
			VAR _off        = LOOKUPVALUE ( param_status_rule[off_from], param_status_rule[rule_code], "CHANNEL_MIX" )
			VAR _r          = ROUND ( _bad, 10 )
			RETURN
			    IF (
			        NOT ISBLANK ( _bad )
			        ,SWITCH (
			            TRUE ()
			            ,_r <= _watch
			                ,1
			            ,_r <= _off
			                ,2
			            ,3
			        )
			    )
		formatString: 0
		displayFolder: 7 Status
		lineageTag: a6a29923-a5fb-524e-b4ca-eebfb0d37a9e

	/// Cards On track (E-25), over the cards with a status (E-95).
	measure 'Status Count On' =
			VAR _t          =
			    {
			        [Status NET_SALES]
			        ,[Status TOTAL_MARGIN]
			        ,[Status WEEKS_OF_COVER]
			        ,[Status MARKDOWN]
			        ,[Status AVAILABILITY]
			        ,[Status EBITDA]
			        ,[Status LFL_GROWTH]
			        ,[Status FRONT_GM]
			        ,[Status SELL_THROUGH]
			        ,[Status GMROI]
			        ,[Status SUPPLIER_OTIF]
			        ,[Status CHANNEL_MIX]
			    }
			RETURN
			    COUNTROWS ( FILTER ( _t, [Value] = 1 ) ) + 0
		formatString: 0
		displayFolder: 7 Status
		lineageTag: 77d0faf4-3842-5711-b2cc-e4c65dda5b8a

