			VAR _xa47        = IF ( _xw47 = "", _xa46, IF ( _xf47, _xa46 & " " & _xw47, _xa46 & "|" & _xw47 ) )
			VAR _xc47        = IF ( _xw47 = "", _xc46, IF ( _xf47, _xc46 & " " & _xw47, _xw47 ) )
			VAR _xf48        = LEN ( _xc47 ) + 1 + LEN ( _xw48 ) <= 52
			VAR _xa48        = IF ( _xw48 = "", _xa47, IF ( _xf48, _xa47 & " " & _xw48, _xa47 & "|" & _xw48 ) )
			VAR _xc48        = IF ( _xw48 = "", _xc47, IF ( _xf48, _xc47 & " " & _xw48, _xw48 ) )
			VAR _n          = MIN ( PATHLENGTH ( _xa48 ), 6 )
			VAR _dy         = _n * 19 + 7
			VAR _h          = 543 + _dy
			VAR _footr      = [Updated Text]
			VAR _head       =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='683' viewBox='0 0 520 683' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='519' height='" & FORMAT ( _h - 1, "0" ) & "' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Explains Tier 1 · " & _sub ) & "</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Like-for-like growth</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text LFL_GROWTH]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text LFL_GROWTH] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
			        & "<text x='52' y='160' font-size='16' font-weight='600' fill='#374151'>Budget"
			        & "<tspan dx='8' font-size='32' font-weight='700' fill='#111827' letter-spacing='-0.6'>" & [Card Basis Text LFL_GROWTH]
			        & "<tspan dx='4' font-size='16' font-weight='600' fill='#374151' letter-spacing='0'>" & _tunit & "</tspan></tspan></text>"
			        & "<text x='24' y='187' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dlong & "</text>"
			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>Sales growth in the stores that were open a year ago too,</text><text x='156' y='296' font-size='13' font-weight='400' fill='#111827'>so new openings and closures do not distort it.</text><text x='24' y='321' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='322' font-size='13' font-weight='400' fill='#111827'>It tells you whether the existing business is growing, not</text><text x='156' y='341' font-size='13' font-weight='400' fill='#111827'>just the estate.</text><text x='24' y='366' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='367' font-size='13' font-weight='400' fill='#111827'>Sales of stores open ≥ 13 months in the picked period ÷</text><text x='156' y='386' font-size='13' font-weight='400' fill='#111827'>the same stores’ sales in the same retail weeks last year −</text><text x='156' y='405' font-size='13' font-weight='400' fill='#111827'>1.</text>"
			        & "<text x='24' y='430' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='431' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='507' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='526' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='430' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='431' font-size='13' font-weight='400' fill='#111827'>Watch when −2 pp to 0 vs budget LFL; Off track below −2</text><text x='156' y='450' font-size='13' font-weight='400' fill='#111827'>pp.</text><rect x='24.0' y='475' width='167.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='489' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B4 channel &amp; customer</tspan></text><rect x='197.0' y='475' width='72.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='206.0' y='489' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Sales</tspan></text><rect x='275.0' y='475' width='112.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='284.0' y='489' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Commercial</tspan></text>"
			        & "<text x='496' y='515' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & _footr & "</text>"
			        & "</g>"
			VAR _svg        = _head & _bars & _body & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: 7df6fa69-27df-5779-a0e2-7abcf58d698f
