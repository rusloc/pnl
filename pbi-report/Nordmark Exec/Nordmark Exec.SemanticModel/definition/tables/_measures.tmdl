			VAR _v          = [Card Value NET_SALES]
			VAR _c          = [Card Compare NET_SALES]
			VAR _d          = _v - _c
			VAR _lab        = SWITCH ( [_Comparator Code], "LY", "vs LY", "LW", [_Prev Short], "vs budget" )
			RETURN
			    IF (
			        ISBLANK ( _v ) || ISBLANK ( _c )
			        ,"n/a " & _lab
			        ,( VAR _f2 = _d RETURN IF ( _f2 >= 0, "+", "−" ) & "€" & IF ( ABS ( _f2 ) / 1000000 >= 1000, FORMAT ( ABS ( _f2 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f2 / 1000000 ), "#,0.0" ) ) & "m" ) & " (" & ( VAR _f3 = DIVIDE ( _v, _c ) - 1 RETURN IF ( _f3 >= 0, "+", "−" ) & FORMAT ( ABS ( _f3 * 100 ), "#,0.0" ) & "%" ) & ") " & _lab
			    )
