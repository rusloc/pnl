	/// AVAILABILITY i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG AVAILABILITY' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status AVAILABILITY]
			VAR _sub        = "top-500 SKUs, weighted" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "AVAILABILITY" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text AVAILABILITY]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis AVAILABILITY] ), "", "%" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Availability Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( IF ( _gr = "W", "vs last week", [_Prev Short] ), "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( IF ( ISBLANK ( CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "n/a", IF ( ISBLANK ( CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ) ), "n/a", ( VAR _f98 = CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ) RETURN IF ( _f98 >= 0, "+", "−" ) & FORMAT ( ABS ( _f98 * 100 ), "#,0.0" ) & " pp" ) ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( "Netherlands · Belgium", "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( ( VAR _f99 = CALCULATE ( CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ), TREATAS ( { "NL" }, param_region[scope_code] ) ) RETURN IF ( ISBLANK ( _f99 ), "n/a", IF ( _f99 < 0, "−", "" ) & FORMAT ( ABS ( _f99 * 100 ), "#,0.0" ) & "%" ) ) & " · " & ( VAR _f100 = CALCULATE ( CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ), TREATAS ( { "BE" }, param_region[scope_code] ) ) RETURN IF ( ISBLANK ( _f100 ), "n/a", IF ( _f100 < 0, "−", "" ) & FORMAT ( ABS ( _f100 * 100 ), "#,0.0" ) & "%" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( "Lowest category", "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( ( VAR _low = TOPN ( 1, FILTER ( ADDCOLUMNS ( ALL ( dim_category[category_name] ), "@av", CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ) ), NOT ISBLANK ( [@av] ) ), [@av], ASC ) RETURN IF ( ISEMPTY ( _low ), "n/a", MAXX ( _low, dim_category[category_name] ) & " " & ( VAR _f97 = MAXX ( _low, [@av] ) RETURN IF ( _f97 < 0, "−", "" ) & FORMAT ( ABS ( _f97 * 100 ), "#,0.0" ) & "%" ) ) ), "&", "&amp;" )
			VAR _ex         = IF ( ISBLANK ( CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "Availability counts stores only; this selection has none.", IF ( _gr = "W", "", "Last week of the " & [Window Noun] & ": " ) & "500 SKUs × " & ( VAR _f90 = ( CALCULATE ( [Trading Store Count], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f90 ), "n/a", IF ( _f90 < 0, "−", "" ) & FORMAT ( ABS ( _f90 ), "#,0" ) ) ) & " stores × 7 days = " & ( VAR _f91 = ( CALCULATE ( [Ranged SKU Days], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f91 ), "n/a", IF ( _f91 < 0, "−", "" ) & FORMAT ( ABS ( _f91 ), "#,0" ) ) ) & " ranged; " & ( VAR _f92 = ( CALCULATE ( [In Stock SKU Days], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f92 ), "n/a", IF ( _f92 < 0, "−", "" ) & FORMAT ( ABS ( _f92 ), "#,0" ) ) ) & " in stock → " & "**" & SUBSTITUTE ( ( VAR _f93 = CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f93 < 0, "−", "" ) & FORMAT ( ABS ( _f93 * 100 ), "#,0.0" ) & "%" ), " ", UNICHAR ( 160 ) ) & "**" & ". Target " & ( VAR _f94 = ( CALCULATE ( [Availability Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN ( VAR _f95 = FORMAT ( ABS ( _f94 * 100 ), "#,0.0" ) RETURN IF ( RIGHT ( _f95, 2 ) = ".0", LEFT ( _f95, LEN ( _f95 ) - 2 ), _f95 ) ) & "%" ) & ", so " & ( VAR _f96 = CALCULATE ( [Availability %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - ( CALCULATE ( [Availability Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f96 >= 0, "+", "−" ) & FORMAT ( ABS ( _f96 * 100 ), "#,0.0" ) & " pp" ) & " → " & [Card Status Word AVAILABILITY] & "." )
			VAR _xw         = SUBSTITUTE ( SUBSTITUTE ( _ex, "|", "/" ), " ", "|" )
			VAR _xw1        = PATHITEM ( _xw, 1 )
			VAR _xw2        = PATHITEM ( _xw, 2 )
