	/// Forecast weekly COGS. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure '_Forecast COGS' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_forecast_week[forecast_cogs] )
			        ,CALCULATE ( SUM ( fact_forecast_week[forecast_cogs] ), dim_store[scope_code] = _scope )
