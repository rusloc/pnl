/// Measure table. All report measures live here (CLAUDE.md Track B). Folders: 1-6 base metrics (window = dim_week rows in context),
/// 7 Status, 8 Cards (card window, comparators, texts), 8 Cards SVG (image measures), 9 Engine (hidden helpers).
table _measures
	lineageTag: ce10925a-ce8b-552e-bda0-2ca17c92dd12

	/// Region / format switcher (E-15): ALL, NL, BE or ONLINE; ALL when nothing is picked.
	measure '_Scope Code' = SELECTEDVALUE ( param_region[scope_code], "ALL" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: e5e570da-063a-561a-b459-50c611ce9db1

	/// Period type (E-90): W (Week), P (Month = 4-5-4 retail period), Q (Quarter) or FY (Year); W when nothing is picked.
	measure '_Granularity Code' = SELECTEDVALUE ( param_granularity[granularity_code], "W" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 1b2a22d2-486c-5a9a-89f0-30919d03f12a

	/// Comparator switcher (E-14, E-94): BUD, LY or LW (= Previous item); BUD when nothing is picked. Previous is not offered at Year and reads LY there. Drives the delta row only (E-24).
	measure '_Comparator Code' =
			VAR _c          = SELECTEDVALUE ( param_comparator[comparator_code], "BUD" )
			RETURN
			    IF ( _c = "LW" && [_Granularity Code] = "FY", "LY", _c )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 55b28a4b-8588-5bef-8eb8-63989485ecea

	/// 1 when a comparator row is offered; 0 for Previous at Year (E-94). Visual-level filter of menu_param_comparator.
	measure '_Comparator Row Visible' = IF ( SELECTEDVALUE ( param_comparator[comparator_code] ) = "LW" && [_Granularity Code] = "FY", 0, 1 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: ca5fb43d-1cdf-55fd-8778-9773dd833e25

	/// dim_week sort_index of the as-of week (manifest.json current_week_key, FY2026-W43 = 95, E-05).
	measure '_AsOf Index' =
			VAR _key        = MAX ( meta_dataset[current_week_key] )
			RETURN
			    CALCULATE (
			        MAX ( dim_week[sort_index] )
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[week_key] = _key
			    )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 5b99e071-b254-522c-9e76-595f39e4e7c2

	/// The picked item (E-91): the one dim_item row left by the type, FY and item slicers (Week / Month grid on label, Quarter / Year row on label_wide); otherwise the item of the picked type that holds the last week of the item last picked in the picked FY (or of that FY's last item, the as-of week in the as-of FY), so W43 -> P10 -> Q4 -> FY2026 and Reset lands on Week 43 FY2026 (js-exec menu(), E-90).
	measure '_Item Key' =
			VAR _g          = [_Granularity Code]
			VAR _one        = HASONEVALUE ( dim_item[item_key] )
			VAR _hitk       = IF ( _one, SELECTEDVALUE ( dim_item[item_key] ) )
			VAR _hitg       = IF ( _one, SELECTEDVALUE ( dim_item[granularity_code] ) )
			VAR _a          = [_AsOf Index]
			VAR _afy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _a )
			VAR _fyf        = IF ( ISFILTERED ( dim_item[fy_label] ), MAXX ( FILTERS ( dim_item[fy_label] ), dim_item[fy_label] ) )
			VAR _fy         = IF ( ISBLANK ( _fyf ), _afy, VALUE ( RIGHT ( _fyf, 4 ) ) )
			VAR _lab        =
			    IF (
			        _g IN { "Q", "FY" }
			        ,IF ( ISFILTERED ( dim_item[label_wide] ), MAXX ( FILTERS ( dim_item[label_wide] ), dim_item[label_wide] ) )
			        ,IF ( ISFILTERED ( dim_item[label] ), MAXX ( FILTERS ( dim_item[label] ), dim_item[label] ) )
			    )
			VAR _anchor0    =
			    CALCULATE (
			        MAX ( dim_item[end_index] )
			        ,REMOVEFILTERS ( dim_item )
			        ,dim_item[fy] = _fy
			        ,dim_item[label] = _lab
			    )
			VAR _fyend      = CALCULATE ( MAX ( dim_item[end_index] ), REMOVEFILTERS ( dim_item ), dim_item[fy] = _fy )
			VAR _anchor     = IF ( ISBLANK ( _anchor0 ), _fyend, _anchor0 )
			VAR _fallback   =
			    CALCULATE (
			        MAX ( dim_item[item_key] )
			        ,REMOVEFILTERS ( dim_item )
			        ,dim_item[granularity_code] = _g
			        ,dim_item[start_index] <= _anchor
			        ,dim_item[end_index] >= _anchor
			    )
			RETURN
			    IF ( _hitg = _g, _hitk, _fallback )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9949ea3f-e78a-5d0f-a649-cd643d479631

	/// First sort_index of the picked item's window (item weeks within actuals, E-92).
	measure '_Window Start' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[start_index] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6f126bde-f9da-5297-9a19-476cc3a46aa4

	/// Last sort_index of the picked item's window = L, the week point-in-time cards read (E-92, E-93).
	measure '_Window End' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[end_index] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: b1a0da8f-362e-57e3-8c3b-c0ce574a818b

	/// First sort_index of the LY window: the window's weeks one year back by ly_week_key (E-12, E-94); blank in FY2025.
	measure '_LY Window Start' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[ly_start] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: e7bd6517-3a3d-55f3-b08e-01eda5a55137

	/// Last sort_index of the LY window; blank in FY2025.
	measure '_LY Window End' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[ly_end] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: d2d5eb6b-753c-5432-92ec-d003768a4678

	/// First sort_index of the previous-item window (E-94): lw_week_key at Week; the item before at Month / Quarter / Year, cut to the picked item's week count when it is partial; blank for the first item.
	measure '_Prev Window Start' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[prev_start] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 019ce2bd-9072-5e3a-8516-9938f15c0b6b

	/// Last sort_index of the previous-item window.
	measure '_Prev Window End' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[prev_end] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: b1ee0f83-32f8-5d54-8565-656182395dbf

	/// EBITDA flash, comparator Previous (E-93, ET-31): at Week the previous month's first k weeks (k = the week's position in its month; P1 -> previous FY P12; blank for week 5 of a 5-week month); else = _Prev Window Start.
	measure '_EB Prev Start' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[eb_prev_start] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: dc1ebf50-2bdf-51f3-9989-62dec52f3d72

	/// Last sort_index of the EBITDA Previous window.
	measure '_EB Prev End' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[eb_prev_end] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 553b6a52-80fb-5711-b49c-a825ec71bb14

	/// Name of the EBITDA Previous window at Week for the i delta line, e.g. P9 weeks 1-4 (USER 2026-10-30).
	measure '_EB Prev Name' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[eb_prev_name] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 1b3c67ae-4d3b-5605-8d27-70a0e4f88ce4

	/// Position of the picked item among the items of its type (1 = FY2025 W1 / P1 / Q1 / FY2025).
	measure '_Item Sort' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[sort_order] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 05476e61-dbb5-5c51-8392-6920a0c7f8e6

	/// Delta suffix of the Previous comparator, always short (E-98): vs prev. wk / mth / qtr (vs LY at Year).
	measure '_Prev Short' = SWITCH ( [_Granularity Code], "P", "vs prev. mth", "Q", "vs prev. qtr", "FY", "vs LY", "vs prev. wk" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 24964582-5be4-51ff-945e-e88982526d54

	/// Noun of the picked type for stat labels and sub-titles: week, month, quarter or year (E-98).
	measure 'Window Noun' = SWITCH ( [_Granularity Code], "P", "month", "Q", "quarter", "FY", "year", "week" )
		displayFolder: 8 Cards
		lineageTag: 5d449bea-8e83-533a-89c6-cb0cfe09a5f6

	/// Gross sales at ticket, ex-VAT. Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure 'Gross Sales' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[gross_sales] )
			        ,CALCULATE ( SUM ( fact_sales_week[gross_sales] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 9b81dd3b-05c9-5173-8cfd-cafec725a0d8

	/// Markdown value, permanent + promo (E-34). Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure Markdown =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[markdown_value] )
			        ,CALCULATE ( SUM ( fact_sales_week[markdown_value] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: dac4c27c-eb0f-51b3-ab2c-7f42648b6280

	/// Returns. Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure Returns =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[returns] )
			        ,CALCULATE ( SUM ( fact_sales_week[returns] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 7534439d-7897-5f41-8b54-846c8cc8c525

	/// Net sales = gross - markdown - returns (E-30). Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure 'Net Sales' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[net_sales] )
			        ,CALCULATE ( SUM ( fact_sales_week[net_sales] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 28985d32-54e2-581d-af81-903a18665910

	/// Cost of goods at standard landed cost (E-32). Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure COGS =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[cogs_landed] )
			        ,CALCULATE ( SUM ( fact_sales_week[cogs_landed] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: c88e947d-6e99-54c8-9a5b-09c5fd5112f5

	/// Back margin: supplier income allocated to site x category by COGS share (E-33). Flow: sums over the weeks in context. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure 'Back Margin' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[back_margin_alloc] )
			        ,CALCULATE ( SUM ( fact_sales_week[back_margin_alloc] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: f1b9b8f8-3d76-5d07-b51f-43fff6cad1de

	/// Units sold. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure _Units =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_sales_week[units] )
			        ,CALCULATE ( SUM ( fact_sales_week[units] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3501d64f-7153-5909-8d40-940fc0843a93

	/// Front margin EUR = Net sales - COGS (E-32).
	measure 'Front Margin' = [Net Sales] - [COGS]
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 31f38117-edc8-5fb4-9952-20e848d8cbd2

	/// Total margin EUR = front + back (E-33, ET-07).
	measure 'Total Margin' = [Front Margin] + [Back Margin]
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 6b5e4be9-8581-54de-a392-113172325e4f

	/// Front gross margin % of net sales (E-32).
	measure 'Front GM %' = DIVIDE ( [Front Margin], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales & margin
		lineageTag: 3c8b8ea5-b3c8-5196-8a0e-4c058fa44c53

	/// Back margin % of net sales.
	measure 'Back Margin %' = DIVIDE ( [Back Margin], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales & margin
		lineageTag: 27515060-f4b4-555c-8fa7-ef85f06d0e04

	/// Total margin % = (front + back) / net sales (E-33).
	measure 'Total Margin %' = DIVIDE ( [Total Margin], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales & margin
		lineageTag: 0dbc7924-bbea-5566-9bbf-7b01650918e0

	/// Markdown % of gross sales (E-34).
	measure 'Markdown %' = DIVIDE ( [Markdown], [Gross Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales & margin
		lineageTag: 71ca1f2e-5711-5302-ac4c-0ec35f7751cb

	/// OpEx amount, every scenario and cost type (filter on top). Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure _Opex =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_opex_week[amount] )
			        ,CALCULATE ( SUM ( fact_opex_week[amount] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 36beb754-9447-5b25-b748-a27bd4541cbb

	/// OpEx SHRINK, scenario ACT. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Shrink' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "ACT"
			    ,fact_opex_week[cost_type_code] = "SHRINK"
			) + 0
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: 2a5ad4c3-66e8-5a2c-98f5-78eef716e6bf

	/// OpEx SHRINK, scenario BUD. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Shrink Bud' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "BUD"
			    ,fact_opex_week[cost_type_code] = "SHRINK"
			) + 0
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: 9707d112-df64-5ac7-9a3d-8c690041fc53

	/// OpEx STORE_OPEX, scenario ACT. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Store' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "ACT"
			    ,fact_opex_week[cost_type_code] = "STORE_OPEX"
			) + 0
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: 9b833275-2234-5a5e-8b2a-365633d64f21

	/// OpEx STORE_OPEX, scenario BUD. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Store Bud' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "BUD"
			    ,fact_opex_week[cost_type_code] = "STORE_OPEX"
			) + 0
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: c1bb754f-a9a9-514a-bd03-e3ed8fe9d827

	/// OpEx CENTRAL_OPEX, scenario ACT. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Central' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "ACT"
			    ,fact_opex_week[cost_type_code] = "CENTRAL_OPEX"
			) + 0
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: c36f218d-a3a9-5b96-93fb-94161af2408d

	/// OpEx CENTRAL_OPEX, scenario BUD. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Central Bud' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "BUD"
			    ,fact_opex_week[cost_type_code] = "CENTRAL_OPEX"
			) + 0
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: 5a20b7b5-99e8-5086-98ca-83e21ced2514

	/// OpEx FULFILMENT, scenario ACT. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Fulfilment' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "ACT"
			    ,fact_opex_week[cost_type_code] = "FULFILMENT"
			) + 0
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: a7af2eeb-a857-5c46-9836-14c0d89ca4dc

	/// OpEx FULFILMENT, scenario BUD. Central costs carry no site and appear in ALL only (data README open point 15).
	measure 'Opex Fulfilment Bud' =
			CALCULATE (
			    [_Opex]
			    ,fact_opex_week[scenario_code] = "BUD"
			    ,fact_opex_week[cost_type_code] = "FULFILMENT"
			) + 0
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: 16625ca4-b47c-5c0b-90dd-deb2917e56e0

	/// EBITDA = total margin - shrink - store OpEx - central OpEx - fulfilment (E-40). In NL / BE / ONLINE a contribution before central costs.
	measure EBITDA = [Total Margin] - [Opex Shrink] - [Opex Store] - [Opex Central] - [Opex Fulfilment]
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: 1643ab29-e936-51ce-aab6-b9b6ea91bdc3

	/// EBITDA % of net sales (E-40).
	measure 'EBITDA Margin %' = DIVIDE ( [EBITDA], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Profit
		lineageTag: 0457fa54-17ac-5f07-9a03-a3c563688dc8

	/// [EBITDA] for the period to date of the window's last week (the EBITDA card at Week, E-40, E-93).
	measure 'EBITDA PTD' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _period     =
			    CALCULATE (
			        SELECTEDVALUE ( dim_week[period_key] )
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
			RETURN
			    CALCULATE (
			        [EBITDA]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[period_key] = _period
			        ,dim_week[sort_index] <= _last
			    )
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: e91eef35-5eea-546e-829c-0fb6311bbb69

	/// [EBITDA Bud] for the period to date of the window's last week (the EBITDA card at Week, E-40, E-93).
	measure 'EBITDA Bud PTD' =
			VAR _last       = MAX ( dim_week[sort_index] )
			VAR _period     =
			    CALCULATE (
			        SELECTEDVALUE ( dim_week[period_key] )
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			    )
			RETURN
			    CALCULATE (
			        [EBITDA Bud]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[period_key] = _period
			        ,dim_week[sort_index] <= _last
			    )
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: 6b6de772-eba3-59e8-8230-df2b0cee895a

	/// EBITDA card reading (E-40, E-93): [EBITDA PTD] (month to date through the week) when the window is one week (Week items, their LY week, the first week of a month), else [EBITDA] of the window (Month / Quarter / Year items and their comparators).
	measure 'EBITDA Flash' =
			VAR _one        = COUNTROWS ( VALUES ( dim_week[sort_index] ) ) = 1
			RETURN
			    IF ( _one, [EBITDA PTD], [EBITDA] )
		formatString: #,0.00
		displayFolder: 2 Profit
		lineageTag: 8b6d705f-9a48-5d0f-8aaa-f8211eab1260

	/// EBITDA card reading (E-40, E-93): [EBITDA Bud PTD] (month to date through the week) when the window is one week (Week items, their LY week, the first week of a month), else [EBITDA Bud] of the window (Month / Quarter / Year items and their comparators).
	measure 'EBITDA Flash Bud' =
			VAR _one        = COUNTROWS ( VALUES ( dim_week[sort_index] ) ) = 1
			RETURN
			    IF ( _one, [EBITDA Bud PTD], [EBITDA Bud] )
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: 1786cb14-7e67-5584-ae22-c563ed99bf0f

	/// Budget net_sales_bud (FY2026 W1-W52). Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure 'Net Sales Bud' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_budget_week[net_sales_bud] )
			        ,CALCULATE ( SUM ( fact_budget_week[net_sales_bud] ), dim_store[scope_code] = _scope )
