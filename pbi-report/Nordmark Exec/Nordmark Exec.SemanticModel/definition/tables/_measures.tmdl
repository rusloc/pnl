			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>The part of the ticket price we gave away through price</text><text x='156' y='296' font-size='13' font-weight='400' fill='#111827'>cuts and promotions.</text><text x='24' y='321' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='322' font-size='13' font-weight='400' fill='#111827'>Every point of markdown is margin lost; rising markdown is</text><text x='156' y='341' font-size='13' font-weight='400' fill='#111827'>the first sign of too much or the wrong stock.</text><text x='24' y='366' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='367' font-size='13' font-weight='400' fill='#111827'>Markdown value (permanent + promotional) ÷ gross sales</text><text x='156' y='386' font-size='13' font-weight='400' fill='#111827'>at ticket price.</text>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='412' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='431' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='507' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='412' font-size='13' font-weight='400' fill='#111827'>Lower is better. Watch when 0 to +1.0 pp vs budget; Off</text><text x='156' y='431' font-size='13' font-weight='400' fill='#111827'>track above +1.0 pp.</text><rect x='24.0' y='456' width='137.2' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='470' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B2 margin &amp; cost</tspan></text><rect x='167.2' y='456' width='83.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='176.2' y='470' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Margin</tspan></text><rect x='256.2' y='456' width='112.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='265.2' y='470' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Commercial</tspan></text>"
