	/// Filters menu: live summary under the period picker = the header period line (E-90; js-exec menu showing).
	measure 'Menu Showing SVG' =
			VAR _p          = [Header Period Text]
			VAR _p1         = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _p, "&", "&amp;" ), "**", "<tspan font-weight='600' fill='#111827'>", 1 ), "**", "</tspan>", 1 )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='320' height='18' viewBox='0 0 320 18' font-family='Segoe UI, sans-serif'>"
			        & "<text x='0' y='13' font-size='12' fill='#5F6878'>Showing " & _p1 & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: 4859cdb1-a06b-5567-86b9-f6d254314e3b
		dataCategory: ImageUrl

	/// NET_SALES status basis as displayed on the i pop-up target line (E-57; same format as the card value), without the unit; n/a when blank.
	measure 'Card Basis Text NET_SALES' =
			VAR _v          = [Card Basis NET_SALES]
			RETURN
			    IF ( ISBLANK ( _v ), "n/a", ( VAR _f1 = _v RETURN IF ( _f1 < 0, "−", "" ) & "€" & IF ( ABS ( _f1 ) / 1000000 >= 1000, FORMAT ( ABS ( _f1 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f1 / 1000000 ), "#,0.0" ) ) ) )
		displayFolder: 8 Cards
		lineageTag: 0836deef-f7e2-4bd3-aa73-d0482caf4280

	/// TOTAL_MARGIN status basis as displayed on the i pop-up target line (E-57; same format as the card value), without the unit; n/a when blank.
	measure 'Card Basis Text TOTAL_MARGIN' =
			VAR _v          = [Card Basis TOTAL_MARGIN]
			RETURN
			    IF ( ISBLANK ( _v ), "n/a", ( VAR _f4 = _v RETURN IF ( _f4 < 0, "−", "" ) & FORMAT ( ABS ( _f4 * 100 ), "#,0.0" ) ) )
		displayFolder: 8 Cards
		lineageTag: 3436bfa1-9a8e-4ce8-ab7c-ceb6990371c9

	/// WEEKS_OF_COVER status basis as displayed on the i pop-up target line (E-57; same format as the card value), without the unit; n/a when blank.
	measure 'Card Basis Text WEEKS_OF_COVER' =
			VAR _v          = [Card Basis WEEKS_OF_COVER]
			RETURN
			    IF ( ISBLANK ( _v ), "n/a", ( VAR _f8 = _v RETURN IF ( _f8 < 0, "−", "" ) & FORMAT ( ABS ( _f8 ), "#,0.0" ) ) )
		displayFolder: 8 Cards
		lineageTag: 0983c503-6127-40e5-87b6-790dc7733538

	/// MARKDOWN status basis as displayed on the i pop-up target line (E-57; same format as the card value), without the unit; n/a when blank.
	measure 'Card Basis Text MARKDOWN' =
			VAR _v          = [Card Basis MARKDOWN]
			RETURN
			    IF ( ISBLANK ( _v ), "n/a", ( VAR _f11 = _v RETURN IF ( _f11 < 0, "−", "" ) & FORMAT ( ABS ( _f11 * 100 ), "#,0.0" ) ) )
