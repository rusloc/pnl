	/// i pop-up of the KPI in context (tt_info).
	measure 'KPI Info SVG' =
			SWITCH (
			    [KPI Code]
			    ,"NET_SALES"
			        ,[Info SVG NET_SALES]
			    ,"TOTAL_MARGIN"
			        ,[Info SVG TOTAL_MARGIN]
			    ,"WEEKS_OF_COVER"
			        ,[Info SVG WEEKS_OF_COVER]
			    ,"MARKDOWN"
			        ,[Info SVG MARKDOWN]
			    ,"AVAILABILITY"
			        ,[Info SVG AVAILABILITY]
			    ,"EBITDA"
			        ,[Info SVG EBITDA]
			    ,"LFL_GROWTH"
			        ,[Info SVG LFL_GROWTH]
			    ,"FRONT_GM"
			        ,[Info SVG FRONT_GM]
			    ,"SELL_THROUGH"
			        ,[Info SVG SELL_THROUGH]
			    ,"GMROI"
			        ,[Info SVG GMROI]
			    ,"SUPPLIER_OTIF"
			        ,[Info SVG SUPPLIER_OTIF]
			    ,"CHANNEL_MIX"
			        ,[Info SVG CHANNEL_MIX]
			)
		displayFolder: 8 Cards
		lineageTag: b0c13429-72b0-5190-8df4-7940c53ed8a2
		dataCategory: ImageUrl

	/// NET_SALES drill path pop-up (tooltip page tt_drill): drill page and 4 steps, text only (E-58).
	measure 'Drill SVG NET_SALES' =
			VAR _st         = [Card Status NET_SALES]
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='369' viewBox='0 0 440 369' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='439' height='368' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>DRILL PATH · SALES PAGE</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Net sales</text>"
			        & "<text x='416' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
