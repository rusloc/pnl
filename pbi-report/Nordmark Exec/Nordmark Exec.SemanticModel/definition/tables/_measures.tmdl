			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 180 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 62
			         RETURN
			            "<rect x='" & FORMAT ( 241 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 103 + 62 - _h, "0.0" )
