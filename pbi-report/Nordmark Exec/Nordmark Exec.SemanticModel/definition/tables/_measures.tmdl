			VAR _xa48        = IF ( _xw48 = "", _xa47, IF ( _xf48, _xa47 & " " & _xw48, _xa47 & "|" & _xw48 ) )
			VAR _xc48        = IF ( _xw48 = "", _xc47, IF ( _xf48, _xc47 & " " & _xw48, _xw48 ) )
			VAR _n          = MIN ( PATHLENGTH ( _xa48 ), 6 )
			VAR _dy         = _n * 19 + 7
			VAR _h          = 498 + _dy
			VAR _footr      = [Updated Text]
			VAR _head       =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='683' viewBox='0 0 520 683' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='519' height='" & FORMAT ( _h - 1, "0" ) & "' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Tier 1 · " & _sub ) & "</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Weeks of cover</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text WEEKS_OF_COVER]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text WEEKS_OF_COVER] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
			        & "<text x='52' y='160' font-size='16' font-weight='600' fill='#374151'>Target"
			        & "<tspan dx='8' font-size='32' font-weight='700' fill='#111827' letter-spacing='-0.6'>" & [Card Basis Text WEEKS_OF_COVER]
			        & "<tspan dx='4' font-size='16' font-weight='600' fill='#374151' letter-spacing='0'>" & _tunit & "</tspan></tspan></text>"
			        & "<text x='24' y='187' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dlong & "</text>"
			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>How many weeks our stock would last at the sales we</text><text x='156' y='296' font-size='13' font-weight='400' fill='#111827'>expect, if nothing more arrived.</text><text x='24' y='321' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='322' font-size='13' font-weight='400' fill='#111827'>Too little and shelves go empty; too much and the stock</text><text x='156' y='341' font-size='13' font-weight='400' fill='#111827'>ends in markdown. It decides the next buying actions.</text><text x='24' y='366' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='367' font-size='13' font-weight='400' fill='#111827'>(Stock on hand + stock on order, at cost) ÷ forecast cost of</text><text x='156' y='386' font-size='13' font-weight='400' fill='#111827'>goods sold per week.</text>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='412' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='431' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='507' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='412' font-size='13' font-weight='400' fill='#111827'>On track within ±1 wk of target 9.5; Watch 1–2 wks away;</text><text x='156' y='431' font-size='13' font-weight='400' fill='#111827'>Off track beyond ±2 wks.</text><rect x='24.0' y='456' width='126.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='470' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B1 base-crucial</tspan></text><rect x='156.0' y='456' width='74.2' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='165.0' y='470' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Stock</tspan></text><rect x='236.2' y='456' width='117.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='245.2' y='470' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Supply chain</tspan></text>"
			        & "<text x='496' y='470' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & _footr & "</text>"
			        & "</g>"
			VAR _svg        = _head & _bars & _body & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: 71884368-530c-5539-9029-6986ebd95e96
		dataCategory: ImageUrl

	/// MARKDOWN i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG MARKDOWN' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status MARKDOWN]
			VAR _sub        = "% of gross sales" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "MARKDOWN" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text MARKDOWN]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis MARKDOWN] ), "", "%" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Markdown % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( "Markdown value", "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( ( VAR _f87 = ( CALCULATE ( [Markdown], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f87 ), "n/a", IF ( _f87 < 0, "−", "" ) & "€" & IF ( ABS ( _f87 ) / 1000000 >= 1000, FORMAT ( ABS ( _f87 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f87 / 1000000 ), "#,0.0" ) ) & "m" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( "vs LY " & [Window Noun], "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( IF ( ISBLANK ( CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) ), "n/a", ( VAR _f88 = CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) RETURN IF ( _f88 >= 0, "+", "−" ) & FORMAT ( ABS ( _f88 * 100 ), "#,0.0" ) & " pp" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( "Budget", "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( ( VAR _f89 = CALCULATE ( [Markdown % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( ISBLANK ( _f89 ), "n/a", IF ( _f89 < 0, "−", "" ) & FORMAT ( ABS ( _f89 * 100 ), "#,0.0" ) & "%" ) ), "&", "&amp;" )
			VAR _ex         = ( VAR _f82 = ( CALCULATE ( [Markdown], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f82 ), "n/a", IF ( _f82 < 0, "−", "" ) & "€" & IF ( ABS ( _f82 ) / 1000000 >= 1000, FORMAT ( ABS ( _f82 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f82 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " markdown ÷ " & ( VAR _f83 = ( CALCULATE ( [Gross Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f83 ), "n/a", IF ( _f83 < 0, "−", "" ) & "€" & IF ( ABS ( _f83 ) / 1000000 >= 1000, FORMAT ( ABS ( _f83 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f83 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " gross sales = " & "**" & SUBSTITUTE ( ( VAR _f84 = CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( ISBLANK ( _f84 ), "n/a", IF ( _f84 < 0, "−", "" ) & FORMAT ( ABS ( _f84 * 100 ), "#,0.0" ) & "%" ) ), " ", UNICHAR ( 160 ) ) & "**" & IF ( ISBLANK ( CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( CALCULATE ( [Markdown % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), ".", ". Budget " & ( VAR _f85 = CALCULATE ( [Markdown % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f85 < 0, "−", "" ) & FORMAT ( ABS ( _f85 * 100 ), "#,0.0" ) & "%" ) & ", so " & ( VAR _f86 = CALCULATE ( [Markdown %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - CALCULATE ( [Markdown % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f86 >= 0, "+", "−" ) & FORMAT ( ABS ( _f86 * 100 ), "#,0.0" ) & " pp" ) & "; lower is better → " & [Card Status Word MARKDOWN] & "." )
			VAR _xw         = SUBSTITUTE ( SUBSTITUTE ( _ex, "|", "/" ), " ", "|" )
			VAR _xw1        = PATHITEM ( _xw, 1 )
			VAR _xw2        = PATHITEM ( _xw, 2 )
			VAR _xw3        = PATHITEM ( _xw, 3 )
			VAR _xw4        = PATHITEM ( _xw, 4 )
			VAR _xw5        = PATHITEM ( _xw, 5 )
			VAR _xw6        = PATHITEM ( _xw, 6 )
			VAR _xw7        = PATHITEM ( _xw, 7 )
			VAR _xw8        = PATHITEM ( _xw, 8 )
			VAR _xw9        = PATHITEM ( _xw, 9 )
			VAR _xw10        = PATHITEM ( _xw, 10 )
			VAR _xw11        = PATHITEM ( _xw, 11 )
			VAR _xw12        = PATHITEM ( _xw, 12 )
			VAR _xw13        = PATHITEM ( _xw, 13 )
			VAR _xw14        = PATHITEM ( _xw, 14 )
			VAR _xw15        = PATHITEM ( _xw, 15 )
			VAR _xw16        = PATHITEM ( _xw, 16 )
			VAR _xw17        = PATHITEM ( _xw, 17 )
			VAR _xw18        = PATHITEM ( _xw, 18 )
			VAR _xw19        = PATHITEM ( _xw, 19 )
			VAR _xw20        = PATHITEM ( _xw, 20 )
			VAR _xw21        = PATHITEM ( _xw, 21 )
			VAR _xw22        = PATHITEM ( _xw, 22 )
			VAR _xw23        = PATHITEM ( _xw, 23 )
			VAR _xw24        = PATHITEM ( _xw, 24 )
			VAR _xw25        = PATHITEM ( _xw, 25 )
			VAR _xw26        = PATHITEM ( _xw, 26 )
			VAR _xw27        = PATHITEM ( _xw, 27 )
			VAR _xw28        = PATHITEM ( _xw, 28 )
			VAR _xw29        = PATHITEM ( _xw, 29 )
			VAR _xw30        = PATHITEM ( _xw, 30 )
			VAR _xw31        = PATHITEM ( _xw, 31 )
			VAR _xw32        = PATHITEM ( _xw, 32 )
			VAR _xw33        = PATHITEM ( _xw, 33 )
			VAR _xw34        = PATHITEM ( _xw, 34 )
			VAR _xw35        = PATHITEM ( _xw, 35 )
			VAR _xw36        = PATHITEM ( _xw, 36 )
			VAR _xw37        = PATHITEM ( _xw, 37 )
			VAR _xw38        = PATHITEM ( _xw, 38 )
			VAR _xw39        = PATHITEM ( _xw, 39 )
			VAR _xw40        = PATHITEM ( _xw, 40 )
			VAR _xw41        = PATHITEM ( _xw, 41 )
			VAR _xw42        = PATHITEM ( _xw, 42 )
			VAR _xw43        = PATHITEM ( _xw, 43 )
			VAR _xw44        = PATHITEM ( _xw, 44 )
			VAR _xw45        = PATHITEM ( _xw, 45 )
			VAR _xw46        = PATHITEM ( _xw, 46 )
			VAR _xw47        = PATHITEM ( _xw, 47 )
			VAR _xw48        = PATHITEM ( _xw, 48 )
			VAR _xa1        = _xw1
			VAR _xc1        = _xw1
			VAR _xf2        = LEN ( _xc1 ) + 1 + LEN ( _xw2 ) <= 52
			VAR _xa2        = IF ( _xw2 = "", _xa1, IF ( _xf2, _xa1 & " " & _xw2, _xa1 & "|" & _xw2 ) )
			VAR _xc2        = IF ( _xw2 = "", _xc1, IF ( _xf2, _xc1 & " " & _xw2, _xw2 ) )
			VAR _xf3        = LEN ( _xc2 ) + 1 + LEN ( _xw3 ) <= 52
			VAR _xa3        = IF ( _xw3 = "", _xa2, IF ( _xf3, _xa2 & " " & _xw3, _xa2 & "|" & _xw3 ) )
			VAR _xc3        = IF ( _xw3 = "", _xc2, IF ( _xf3, _xc2 & " " & _xw3, _xw3 ) )
			VAR _xf4        = LEN ( _xc3 ) + 1 + LEN ( _xw4 ) <= 52
			VAR _xa4        = IF ( _xw4 = "", _xa3, IF ( _xf4, _xa3 & " " & _xw4, _xa3 & "|" & _xw4 ) )
			VAR _xc4        = IF ( _xw4 = "", _xc3, IF ( _xf4, _xc3 & " " & _xw4, _xw4 ) )
			VAR _xf5        = LEN ( _xc4 ) + 1 + LEN ( _xw5 ) <= 52
