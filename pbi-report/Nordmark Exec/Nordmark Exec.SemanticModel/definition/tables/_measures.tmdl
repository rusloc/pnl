			VAR _xa8        = IF ( _xw8 = "", _xa7, IF ( _xf8, _xa7 & " " & _xw8, _xa7 & "|" & _xw8 ) )
			VAR _xc8        = IF ( _xw8 = "", _xc7, IF ( _xf8, _xc7 & " " & _xw8, _xw8 ) )
			VAR _xf9        = LEN ( _xc8 ) + 1 + LEN ( _xw9 ) <= 52
			VAR _xa9        = IF ( _xw9 = "", _xa8, IF ( _xf9, _xa8 & " " & _xw9, _xa8 & "|" & _xw9 ) )
			VAR _xc9        = IF ( _xw9 = "", _xc8, IF ( _xf9, _xc8 & " " & _xw9, _xw9 ) )
			VAR _xf10        = LEN ( _xc9 ) + 1 + LEN ( _xw10 ) <= 52
			VAR _xa10        = IF ( _xw10 = "", _xa9, IF ( _xf10, _xa9 & " " & _xw10, _xa9 & "|" & _xw10 ) )
			VAR _xc10        = IF ( _xw10 = "", _xc9, IF ( _xf10, _xc9 & " " & _xw10, _xw10 ) )
			VAR _xf11        = LEN ( _xc10 ) + 1 + LEN ( _xw11 ) <= 52
			VAR _xa11        = IF ( _xw11 = "", _xa10, IF ( _xf11, _xa10 & " " & _xw11, _xa10 & "|" & _xw11 ) )
			VAR _xc11        = IF ( _xw11 = "", _xc10, IF ( _xf11, _xc10 & " " & _xw11, _xw11 ) )
			VAR _xf12        = LEN ( _xc11 ) + 1 + LEN ( _xw12 ) <= 52
