	/// Cards revealed by the attribute filters (status-line summary, E-56).
	measure 'Revealed Count' = INT ( [Card Revealed NET_SALES] ) + INT ( [Card Revealed TOTAL_MARGIN] ) + INT ( [Card Revealed WEEKS_OF_COVER] ) + INT ( [Card Revealed MARKDOWN] ) + INT ( [Card Revealed AVAILABILITY] ) + INT ( [Card Revealed EBITDA] ) + INT ( [Card Revealed LFL_GROWTH] ) + INT ( [Card Revealed FRONT_GM] ) + INT ( [Card Revealed SELL_THROUGH] ) + INT ( [Card Revealed GMROI] ) + INT ( [Card Revealed SUPPLIER_OTIF] ) + INT ( [Card Revealed CHANNEL_MIX] )
		formatString: 0
		displayFolder: 8 Cards
		lineageTag: 982af3d8-b893-5828-b29c-300d6964cec8

	/// Picked attribute labels in menu order, or All.
	measure 'Filter Picks Text' =
			VAR _group      = IF ( ISFILTERED ( param_attr_group ), CONCATENATEX ( VALUES ( param_attr_group ), param_attr_group[attr_label], ", ", param_attr_group[sort_order], ASC ) )
			VAR _lever      = IF ( ISFILTERED ( param_attr_lever ), CONCATENATEX ( VALUES ( param_attr_lever ), param_attr_lever[attr_label], ", ", param_attr_lever[sort_order], ASC ) )
			VAR _owner      = IF ( ISFILTERED ( param_attr_owner ), CONCATENATEX ( VALUES ( param_attr_owner ), param_attr_owner[attr_label], ", ", param_attr_owner[sort_order], ASC ) )
			VAR _all        =
			    CONCATENATEX (
			        FILTER ( { ( 1, _group ), ( 2, _lever ), ( 3, _owner ) }, [Value2] <> "" )
			        ,[Value2]
			        ,", "
			        ,[Value1], ASC
			    )
			RETURN
			    IF ( _all = "", "All", _all )
		displayFolder: 8 Cards
		lineageTag: 2d26fa1f-6f95-5d2c-a8cd-8271bd312582

	/// Active attribute picks (side-bar badge, E-52).
	measure 'Filter Pick Count' = IF ( ISFILTERED ( param_attr_group ), COUNTROWS ( VALUES ( param_attr_group[attr_code] ) ), 0 ) + IF ( ISFILTERED ( param_attr_lever ), COUNTROWS ( VALUES ( param_attr_lever[attr_code] ) ), 0 ) + IF ( ISFILTERED ( param_attr_owner ), COUNTROWS ( VALUES ( param_attr_owner[attr_code] ) ), 0 )
		formatString: 0
		displayFolder: 8 Cards
		lineageTag: e805757f-a526-5733-99ba-47b66abca765

	/// Header period line of the picked item (E-51, E-98): Week 43 · 19-25 Oct 2026, Quarter 4 to date · ..., FY2025 · ...; ** marks bold (up to ' to date').
	measure 'Header Period Text' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[header] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		displayFolder: 8 Cards
		lineageTag: 8bba2848-68fa-51ca-ab17-168df7d9ae55

	/// Header comparator phrase (E-14, E-94; js-exec view.ts header()).
	measure 'Header Comparator Text' =
			SWITCH (
			    [_Comparator Code]
			    ,"LY"
			        ,"vs **Last year** " & IF ( [_Granularity Code] = "W", "(same retail week)", "(same retail weeks)" )
			    ,"LW"
			        ,"vs **" & SWITCH ( [_Granularity Code], "P", "Previous month", "Q", "Previous quarter", "Previous week" ) & "**"
			    ,"vs **Budget**"
			)
		displayFolder: 8 Cards
		lineageTag: cbe820b8-2872-5a1b-bc2c-5cfdb7a3f752

	/// Header region phrase.
	measure 'Header Region Text' =
			SWITCH (
			    [_Scope Code]
			    ,"NL"
			        ,"**Netherlands** · all formats"
			    ,"BE"
			        ,"**Belgium** · all formats"
			    ,"ONLINE"
			        ,"**Online** only"
			    ,"All regions & formats"
			)
		displayFolder: 8 Cards
		lineageTag: fb8200bc-872a-56c5-8328-741130baf1f4

	/// Refresh stamp from manifest.json (E-05).
	measure 'Refreshed Text' =
			VAR _r          = MAX ( meta_dataset[refreshed] )
			RETURN
			    "Refreshed " & FORMAT ( _r, "ddd d mmm hh:nn" )
		displayFolder: 8 Cards
		lineageTag: 6a7d3ff6-c039-5f3b-90c3-2bcf6bd9bd52

	/// Pop-up footer stamp.
	measure 'Updated Text' =
			VAR _r          = MAX ( meta_dataset[refreshed] )
			RETURN
			    "Updated " & FORMAT ( _r, "ddd hh:nn" )
		displayFolder: 8 Cards
		lineageTag: b6cfb1df-a3f2-5ece-be8b-1fb37d401268

	/// Window phrase for card sub-titles (E-92): week 43, month 10, quarter 4 to date, FY2026 to date (+ FY2025 when not the as-of FY).
	measure 'Period Phrase' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[phrase] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		displayFolder: 8 Cards
		lineageTag: d5dfaa52-1646-5e5a-b195-337066996228

	/// Title of the picked item (E-51, E-98): Week 43, Month 10, Quarter 4, FY2026 (+ FY2025 when not the as-of FY); How-to-read eyebrow Nordmark · <title>.
	measure 'Item Title' =
			VAR _k          = [_Item Key]
			RETURN
			    CALCULATE ( MAX ( dim_item[title] ), REMOVEFILTERS ( dim_item ), dim_item[item_key] = _k )
		displayFolder: 8 Cards
		lineageTag: d003ae10-9d95-5432-b77c-e8efdbb766cb

	/// Retail month (dim_week.period) of the window's last week: the EBITDA sub-title at Week, month 10 to date (E-40).
	measure 'Period No' =
			VAR _e          = [_Window End]
			RETURN
			    CALCULATE ( MAX ( dim_week[period] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
		formatString: 0
		displayFolder: 8 Cards
		lineageTag: feb87ff6-b07a-52f9-851a-3bd04c30570b

	/// Lower-case region phrase for card sub-titles.
	measure 'Region Phrase' = SWITCH ( [_Scope Code], "NL", "Netherlands", "BE", "Belgium", "ONLINE", "online", "all channels" )
		displayFolder: 8 Cards
		lineageTag: 4e96eeba-23ee-5db8-a621-846b3e9e13ae

	/// Supplier income accrued (rebates + promo funding + listing fees). Equals Back Margin at ALL (ET-07). No site key.
	measure 'Supplier Income' =
			SUMX (
			    fact_supplier_income_week
			    ,fact_supplier_income_week[rebate_accrual] + fact_supplier_income_week[promo_funding] + fact_supplier_income_week[listing_fees]
			)
		formatString: #,0.00
		displayFolder: 1 Sales & margin
		lineageTag: 21a549c4-181d-5a25-a39a-728936e9c4c9

	/// On / watch / off counts and the dot in one pass over the 12 statuses (on x 1000 + watch x 100 + off x 10 + dot; dot 0 = no rated card, grey, E-95); the status line and the dot tooltip read it.
	measure 'Status Pack' =
			VAR _t          =
			    {
			        [Status NET_SALES]
			        ,[Status TOTAL_MARGIN]
			        ,[Status WEEKS_OF_COVER]
			        ,[Status MARKDOWN]
			        ,[Status AVAILABILITY]
			        ,[Status EBITDA]
			        ,[Status LFL_GROWTH]
			        ,[Status FRONT_GM]
			        ,[Status SELL_THROUGH]
			        ,[Status GMROI]
			        ,[Status SUPPLIER_OTIF]
			        ,[Status CHANNEL_MIX]
			    }
			VAR _on         = COUNTROWS ( FILTER ( _t, [Value] = 1 ) ) + 0
			VAR _watch      = COUNTROWS ( FILTER ( _t, [Value] = 2 ) ) + 0
			VAR _offc       = COUNTROWS ( FILTER ( _t, [Value] = 3 ) ) + 0
			VAR _n          = _on + _watch + _offc
			VAR _red        = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_RED_OFF" )
			VAR _orange     = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_ORANGE_WATCH_OFF" )
			VAR _green      = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_GREEN_GOOD" )
			VAR _dot        =
			    SWITCH (
			        TRUE ()
			        ,_n = 0
			            ,0
			        ,DIVIDE ( _offc, _n ) >= _red
			            ,3
			        ,DIVIDE ( _watch + _offc, _n ) > _orange
			            ,2
			        ,DIVIDE ( _on, _n ) >= _green
			            ,1
			        ,2
			    )
			RETURN
			    _on * 1000 + _watch * 100 + _offc * 10 + _dot
		formatString: 0
		isHidden
		displayFolder: 7 Status
		lineageTag: 571f4f77-3115-57ad-b0b3-a20a44927f88

	/// Status Pack in the card window.
	measure 'Window Status Pack' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			RETURN
			    CALCULATE ( [Status Pack], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
		formatString: 0
		isHidden
		displayFolder: 8 Cards
		lineageTag: 2d705003-29b7-58f7-960c-d1cc37b4516d

	/// NET_SALES card face (E-20): wash, title, chip, value, delta (muted when n/a), bars of the picked type (E-96), i and binoculars; faded in place when concealed (E-55).
	measure 'Card SVG NET_SALES' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _rev        = [Card Revealed NET_SALES]
			VAR _st         = [Card Status NET_SALES]
			VAR _val        = [Card Value Text NET_SALES]
			VAR _unit       = [Card Unit Text NET_SALES]
			VAR _dt         = [Card Delta Text NET_SALES]
			VAR _sub        = [Period Phrase] & ", " & [Region Phrase] & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "NET_SALES" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dink       = IF ( LEFT ( _dt, 3 ) = "n/a", "#5F6878", _ink )
			VAR _bg         = SWITCH ( _st, 2, "<rect x='0.5' y='0.5' width='436' height='235' rx='15.5' fill='url(#wW)' stroke='#E5E7EB'/>", 3, "<rect x='1' y='1' width='435' height='234' rx='15' fill='url(#wO)' stroke='#C0272D' stroke-width='2'/>", "<rect x='0.5' y='0.5' width='436' height='235' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 260 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 92
			         RETURN
			            "<rect x='" & FORMAT ( 161 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 133 + 92 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M161 " & FORMAT ( 133 + 92 - ( _tgt - _lo ) / ( _hi - _lo ) * 92, "0.0" )
			            & " H421' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _labels     = ""
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='437' height='236' viewBox='0 0 437 236' font-family='Segoe UI, sans-serif'><defs><linearGradient id='wW' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#FFD3A0' stop-opacity='0.5'/></linearGradient><linearGradient id='wO' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#F3C9C5' stop-opacity='0.5'/></linearGradient><filter id='gs'><feColorMatrix type='saturate' values='0'/></filter></defs>"
			        & "<g" & IF ( _rev, "", " opacity='0.08' filter='url(#gs)'" ) & ">" & _bg
			        & "<text x='16' y='27' font-size='14.5' font-weight='600' fill='#111827'>Net sales<tspan font-weight='400' fill='#5F6878'> · " & _sub & "</tspan></text>"
			        & "<rect x='" & FORMAT ( 421 - _cw, "0.0" ) & "' y='11' width='" & FORMAT ( _cw, "0.0" ) & "' height='22' rx='11' fill='" & _tint & "'/>"
			        & "<text x='" & FORMAT ( 421 - _cw / 2, "0.0" ) & "' y='26' text-anchor='middle' font-size='11.5' font-weight='600' fill='" & _ink & "'>" & _chip & "</text>"
			        & "<text x='16' y='76' font-size='44' font-weight='600' fill='#111827' letter-spacing='-0.5'>" & _val
			        & "<tspan font-size='13' font-weight='500' fill='#5F6878' letter-spacing='0' dx='4'>" & _unit & "</tspan></text>"
			        & "<text x='16' y='102' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dt & "</text>"
			        & "<circle cx='30' cy='211' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(22 203) scale(0.8)'><path d='M10 8.6v5.2' stroke='#5F6878' stroke-width='1.8' stroke-linecap='round' fill='none'/><circle cx='10' cy='5.6' r='1' fill='#5F6878'/></g><circle cx='62' cy='211' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(54 203) scale(0.8)'><g fill='none' stroke='#5F6878' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='5.8' cy='13' r='3'/><circle cx='14.2' cy='13' r='3'/><path d='M8.8 12.3h2.4M6.6 10.1 7.4 5.6h2.1l.4 2.6M13.4 10.1 12.6 5.6h-2.1l-.4 2.6'/></g></g>"
			        & _bars
			        & "</g></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: 645dcc52-55ef-5860-af0b-f6452c8ecfe3
		dataCategory: ImageUrl

	/// TOTAL_MARGIN card face (E-20): wash, title, chip, value, delta (muted when n/a), bars of the picked type (E-96), i and binoculars; faded in place when concealed (E-55).
