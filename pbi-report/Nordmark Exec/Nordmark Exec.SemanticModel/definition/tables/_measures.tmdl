	/// SELL_THROUGH i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG SELL_THROUGH' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status SELL_THROUGH]
			VAR _sub        = "A/W season to date" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "SELL_THROUGH" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text SELL_THROUGH]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis SELL_THROUGH] ), "", "%" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Sell-through Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( LOOKUPVALUE ( dim_category[category_name], dim_category[category_code], "APPAREL" ), "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( ( VAR _f141 = CALCULATE ( CALCULATE ( [Sell-through %], dim_category[category_code] = "APPAREL" ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( ISBLANK ( _f141 ), "n/a", IF ( _f141 < 0, "−", "" ) & FORMAT ( ABS ( _f141 * 100 ), "#,0" ) & "%" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( LOOKUPVALUE ( dim_category[category_name], dim_category[category_code], "HOME" ), "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( ( VAR _f142 = CALCULATE ( CALCULATE ( [Sell-through %], dim_category[category_code] = "HOME" ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( ISBLANK ( _f142 ), "n/a", IF ( _f142 < 0, "−", "" ) & FORMAT ( ABS ( _f142 * 100 ), "#,0" ) & "%" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( "vs LY season", "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( IF ( ISBLANK ( CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "n/a", IF ( ISBLANK ( CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) ), "n/a", ( VAR _f143 = CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) RETURN IF ( _f143 >= 0, "+", "−" ) & FORMAT ( ABS ( _f143 * 100 ), "#,0.0" ) & " pp" ) ) ), "&", "&amp;" )
			VAR _ex         = IF ( ISBLANK ( CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( CALCULATE ( [Sell-through Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), IF ( _gr = "W", "No season is open in the selected week.", "No season is open in the last week of the " & [Window Noun] & "." ), ( VAR _f133 = ( CALCULATE ( [Season Units Sold], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f133 ), "n/a", FORMAT ( _f133 / 1000000, "#,0.0" ) & "m" ) ) & " units sold ÷ (" & ( VAR _f134 = ( CALCULATE ( [Season Opening Units], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f134 ), "n/a", FORMAT ( _f134 / 1000000, "#,0.0" ) & "m" ) ) & " opening + " & ( VAR _f135 = ( CALCULATE ( [Season Receipt Units], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f135 ), "n/a", FORMAT ( _f135 / 1000000, "#,0.0" ) & "m" ) ) & " received = " & ( VAR _f136 = ( CALCULATE ( [Season Opening Units], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) + ( CALCULATE ( [Season Receipt Units], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f136 ), "n/a", FORMAT ( _f136 / 1000000, "#,0.0" ) & "m" ) ) & ") = " & "**" & SUBSTITUTE ( ( VAR _f137 = CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f137 < 0, "−", "" ) & FORMAT ( ABS ( _f137 * 100 ), "#,0.0" ) & "%" ), " ", UNICHAR ( 160 ) ) & "**" & ". Target " & ( VAR _f138 = CALCULATE ( [Sell-through Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN ( VAR _f139 = FORMAT ( ABS ( _f138 * 100 ), "#,0.0" ) RETURN IF ( RIGHT ( _f139, 2 ) = ".0", LEFT ( _f139, LEN ( _f139 ) - 2 ), _f139 ) ) & "%" ) & " at week " & IF ( ISBLANK ( CALCULATE ( MAX ( dim_week[season_week] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ) ), "n/a", FORMAT ( CALCULATE ( MAX ( dim_week[season_week] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ), "0" ) ) & " of " & FORMAT ( ( VAR _sc = CALCULATE ( MAX ( dim_week[season_code] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e ) RETURN CALCULATE ( COUNTROWS ( dim_week ), REMOVEFILTERS ( dim_week ), dim_week[season_code] = _sc ) ), "0" ) & ", so " & ( VAR _f140 = CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - CALCULATE ( [Sell-through Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f140 >= 0, "+", "−" ) & FORMAT ( ABS ( _f140 * 100 ), "#,0.0" ) & " pp" ) & "." )
			VAR _xw         = SUBSTITUTE ( SUBSTITUTE ( _ex, "|", "/" ), " ", "|" )
			VAR _xw1        = PATHITEM ( _xw, 1 )
			VAR _xw2        = PATHITEM ( _xw, 2 )
			VAR _xw3        = PATHITEM ( _xw, 3 )
			VAR _xw4        = PATHITEM ( _xw, 4 )
			VAR _xw5        = PATHITEM ( _xw, 5 )
			VAR _xw6        = PATHITEM ( _xw, 6 )
			VAR _xw7        = PATHITEM ( _xw, 7 )
			VAR _xw8        = PATHITEM ( _xw, 8 )
			VAR _xw9        = PATHITEM ( _xw, 9 )
			VAR _xw10        = PATHITEM ( _xw, 10 )
			VAR _xw11        = PATHITEM ( _xw, 11 )
			VAR _xw12        = PATHITEM ( _xw, 12 )
			VAR _xw13        = PATHITEM ( _xw, 13 )
			VAR _xw14        = PATHITEM ( _xw, 14 )
			VAR _xw15        = PATHITEM ( _xw, 15 )
			VAR _xw16        = PATHITEM ( _xw, 16 )
			VAR _xw17        = PATHITEM ( _xw, 17 )
			VAR _xw18        = PATHITEM ( _xw, 18 )
			VAR _xw19        = PATHITEM ( _xw, 19 )
			VAR _xw20        = PATHITEM ( _xw, 20 )
			VAR _xw21        = PATHITEM ( _xw, 21 )
			VAR _xw22        = PATHITEM ( _xw, 22 )
			VAR _xw23        = PATHITEM ( _xw, 23 )
			VAR _xw24        = PATHITEM ( _xw, 24 )
			VAR _xw25        = PATHITEM ( _xw, 25 )
			VAR _xw26        = PATHITEM ( _xw, 26 )
			VAR _xw27        = PATHITEM ( _xw, 27 )
			VAR _xw28        = PATHITEM ( _xw, 28 )
			VAR _xw29        = PATHITEM ( _xw, 29 )
			VAR _xw30        = PATHITEM ( _xw, 30 )
			VAR _xw31        = PATHITEM ( _xw, 31 )
			VAR _xw32        = PATHITEM ( _xw, 32 )
			VAR _xw33        = PATHITEM ( _xw, 33 )
			VAR _xw34        = PATHITEM ( _xw, 34 )
			VAR _xw35        = PATHITEM ( _xw, 35 )
			VAR _xw36        = PATHITEM ( _xw, 36 )
			VAR _xw37        = PATHITEM ( _xw, 37 )
			VAR _xw38        = PATHITEM ( _xw, 38 )
			VAR _xw39        = PATHITEM ( _xw, 39 )
			VAR _xw40        = PATHITEM ( _xw, 40 )
			VAR _xw41        = PATHITEM ( _xw, 41 )
			VAR _xw42        = PATHITEM ( _xw, 42 )
			VAR _xw43        = PATHITEM ( _xw, 43 )
			VAR _xw44        = PATHITEM ( _xw, 44 )
			VAR _xw45        = PATHITEM ( _xw, 45 )
			VAR _xw46        = PATHITEM ( _xw, 46 )
			VAR _xw47        = PATHITEM ( _xw, 47 )
			VAR _xw48        = PATHITEM ( _xw, 48 )
			VAR _xa1        = _xw1
			VAR _xc1        = _xw1
			VAR _xf2        = LEN ( _xc1 ) + 1 + LEN ( _xw2 ) <= 52
			VAR _xa2        = IF ( _xw2 = "", _xa1, IF ( _xf2, _xa1 & " " & _xw2, _xa1 & "|" & _xw2 ) )
			VAR _xc2        = IF ( _xw2 = "", _xc1, IF ( _xf2, _xc1 & " " & _xw2, _xw2 ) )
			VAR _xf3        = LEN ( _xc2 ) + 1 + LEN ( _xw3 ) <= 52
			VAR _xa3        = IF ( _xw3 = "", _xa2, IF ( _xf3, _xa2 & " " & _xw3, _xa2 & "|" & _xw3 ) )
			VAR _xc3        = IF ( _xw3 = "", _xc2, IF ( _xf3, _xc2 & " " & _xw3, _xw3 ) )
			VAR _xf4        = LEN ( _xc3 ) + 1 + LEN ( _xw4 ) <= 52
			VAR _xa4        = IF ( _xw4 = "", _xa3, IF ( _xf4, _xa3 & " " & _xw4, _xa3 & "|" & _xw4 ) )
			VAR _xc4        = IF ( _xw4 = "", _xc3, IF ( _xf4, _xc3 & " " & _xw4, _xw4 ) )
			VAR _xf5        = LEN ( _xc4 ) + 1 + LEN ( _xw5 ) <= 52
			VAR _xa5        = IF ( _xw5 = "", _xa4, IF ( _xf5, _xa4 & " " & _xw5, _xa4 & "|" & _xw5 ) )
			VAR _xc5        = IF ( _xw5 = "", _xc4, IF ( _xf5, _xc4 & " " & _xw5, _xw5 ) )
			VAR _xf6        = LEN ( _xc5 ) + 1 + LEN ( _xw6 ) <= 52
			VAR _xa6        = IF ( _xw6 = "", _xa5, IF ( _xf6, _xa5 & " " & _xw6, _xa5 & "|" & _xw6 ) )
			VAR _xc6        = IF ( _xw6 = "", _xc5, IF ( _xf6, _xc5 & " " & _xw6, _xw6 ) )
			VAR _xf7        = LEN ( _xc6 ) + 1 + LEN ( _xw7 ) <= 52
			VAR _xa7        = IF ( _xw7 = "", _xa6, IF ( _xf7, _xa6 & " " & _xw7, _xa6 & "|" & _xw7 ) )
			VAR _xc7        = IF ( _xw7 = "", _xc6, IF ( _xf7, _xc6 & " " & _xw7, _xw7 ) )
			VAR _xf8        = LEN ( _xc7 ) + 1 + LEN ( _xw8 ) <= 52
			VAR _xa8        = IF ( _xw8 = "", _xa7, IF ( _xf8, _xa7 & " " & _xw8, _xa7 & "|" & _xw8 ) )
			VAR _xc8        = IF ( _xw8 = "", _xc7, IF ( _xf8, _xc7 & " " & _xw8, _xw8 ) )
			VAR _xf9        = LEN ( _xc8 ) + 1 + LEN ( _xw9 ) <= 52
			VAR _xa9        = IF ( _xw9 = "", _xa8, IF ( _xf9, _xa8 & " " & _xw9, _xa8 & "|" & _xw9 ) )
