	/// CHANNEL_MIX i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG CHANNEL_MIX' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status CHANNEL_MIX]
			VAR _sub        = "% of net sales vs plan" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "CHANNEL_MIX" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text CHANNEL_MIX]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis CHANNEL_MIX] ), "", "% store" )
			VAR _m1         = CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0
			VAR _m2         = CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0
			VAR _m3         = CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0
			VAR _bars       =
			    "<rect x='256' y='174' width='" & FORMAT ( 236 * _m1, "0.0" ) & "' height='16' rx='3' fill='#2048C6'/>"
			        & "<rect x='" & FORMAT ( 258 + 236 * _m1, "0.0" ) & "' y='174' width='" & FORMAT ( 236 * _m2, "0.0" ) & "' height='16' rx='3' fill='#374151'/>"
			        & "<rect x='" & FORMAT ( 260 + 236 * ( _m1 + _m2 ), "0.0" ) & "' y='174' width='" & FORMAT ( 236 * _m3, "0.0" ) & "' height='16' rx='3' fill='#B6BCC6'/>"
			VAR _sl0        = SUBSTITUTE ( "Store", "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( ( VAR _f176 = ( CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f176 < 0, "−", "" ) & FORMAT ( ABS ( _f176 * 100 ), "#,0.0" ) & "%" ) & " · " & IF ( ISBLANK ( CALCULATE ( [Mix Store % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "n/a", ( VAR _f177 = ( CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) - CALCULATE ( [Mix Store % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f177 >= 0, "+", "−" ) & FORMAT ( ABS ( _f177 * 100 ), "#,0.0" ) & " pp" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( "Online", "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( ( VAR _f178 = ( CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f178 < 0, "−", "" ) & FORMAT ( ABS ( _f178 * 100 ), "#,0.0" ) & "%" ) & " · " & IF ( ISBLANK ( CALCULATE ( [Mix Online % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "n/a", ( VAR _f179 = ( CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) - CALCULATE ( [Mix Online % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f179 >= 0, "+", "−" ) & FORMAT ( ABS ( _f179 * 100 ), "#,0.0" ) & " pp" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( "Wholesale", "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( ( VAR _f180 = ( CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f180 < 0, "−", "" ) & FORMAT ( ABS ( _f180 * 100 ), "#,0.0" ) & "%" ) & " · " & IF ( ISBLANK ( CALCULATE ( [Mix Wholesale % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), "n/a", ( VAR _f181 = ( CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) - CALCULATE ( [Mix Wholesale % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f181 >= 0, "+", "−" ) & FORMAT ( ABS ( _f181 * 100 ), "#,0.0" ) & " pp" ) ), "&", "&amp;" )
			VAR _ex         = "Store " & ( VAR _f169 = ( CALCULATE ( [Mix Store Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f169 ), "n/a", IF ( _f169 < 0, "−", "" ) & "€" & IF ( ABS ( _f169 ) / 1000000 >= 1000, FORMAT ( ABS ( _f169 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f169 / 1000000 ), "#,0.0" ) ) & "m" ) ) & ", online " & ( VAR _f170 = ( CALCULATE ( [Mix Online Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f170 ), "n/a", IF ( _f170 < 0, "−", "" ) & "€" & IF ( ABS ( _f170 ) / 1000000 >= 1000, FORMAT ( ABS ( _f170 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f170 / 1000000 ), "#,0.0" ) ) & "m" ) ) & ", wholesale " & ( VAR _f171 = ( CALCULATE ( [Mix Wholesale Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f171 ), "n/a", IF ( _f171 < 0, "−", "" ) & "€" & IF ( ABS ( _f171 ) / 1000000 >= 1000, FORMAT ( ABS ( _f171 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f171 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " of " & ( VAR _f172 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f172 ), "n/a", IF ( _f172 < 0, "−", "" ) & "€" & IF ( ABS ( _f172 ) / 1000000 >= 1000, FORMAT ( ABS ( _f172 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f172 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " → " & "**" & SUBSTITUTE ( ( VAR _f173 = ( CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f173 < 0, "−", "" ) & FORMAT ( ABS ( _f173 * 100 ), "#,0.0" ) & "%" ) & " / " & ( VAR _f174 = ( CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f174 < 0, "−", "" ) & FORMAT ( ABS ( _f174 * 100 ), "#,0.0" ) & "%" ) & " / " & ( VAR _f175 = ( CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( _f175 < 0, "−", "" ) & FORMAT ( ABS ( _f175 * 100 ), "#,0.0" ) & "%" ), " ", UNICHAR ( 160 ) ) & "**" & IF ( ISBLANK ( CALCULATE ( [Mix Store % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), ".", ". Plan " & ( VAR _f162 = CALCULATE ( [Mix Store % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN ( VAR _f163 = FORMAT ( ABS ( _f162 * 100 ), "#,0.0" ) RETURN IF ( RIGHT ( _f163, 2 ) = ".0", LEFT ( _f163, LEN ( _f163 ) - 2 ), _f163 ) ) ) & " / " & ( VAR _f164 = CALCULATE ( [Mix Online % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN ( VAR _f165 = FORMAT ( ABS ( _f164 * 100 ), "#,0.0" ) RETURN IF ( RIGHT ( _f165, 2 ) = ".0", LEFT ( _f165, LEN ( _f165 ) - 2 ), _f165 ) ) ) & " / " & ( VAR _f166 = CALCULATE ( [Mix Wholesale % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN ( VAR _f167 = FORMAT ( ABS ( _f166 * 100 ), "#,0.0" ) RETURN IF ( RIGHT ( _f167, 2 ) = ".0", LEFT ( _f167, LEN ( _f167 ) - 2 ), _f167 ) ) ) & ", so " & SWITCH ( CALCULATE ( [Mix Max Dev Channel], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ), 1, "store", 2, "online", "wholesale" ) & " " & ( VAR _f168 = CALCULATE ( [Mix Max Dev pp], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f168 >= 0, "+", "−" ) & FORMAT ( ABS ( _f168 * 100 ), "#,0.0" ) & " pp" ) & "." )
