			VAR _e          = [_Window End]
			VAR _rev        = [Card Revealed WEEKS_OF_COVER]
			VAR _st         = [Card Status WEEKS_OF_COVER]
			VAR _val        = [Card Value Text WEEKS_OF_COVER]
			VAR _unit       = [Card Unit Text WEEKS_OF_COVER]
			VAR _dt         = [Card Delta Text WEEKS_OF_COVER]
