	/// Channel mix delta vs the comparator mix, packed: channel x 1000 + signed share deviation (1 store, 2 online, 3 wholesale; first on a tie).
	measure 'Card Mix Dev Channel' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _cmp        = [_Comparator Code]
			VAR _v1         = CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _v2         = CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _v3         = CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _c1         = SWITCH ( _cmp, "LY", IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ), "LW", IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Mix Store %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ), CALCULATE ( [Mix Store % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) )
			VAR _c2         = SWITCH ( _cmp, "LY", IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ), "LW", IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Mix Online %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ), CALCULATE ( [Mix Online % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) )
			VAR _c3         = SWITCH ( _cmp, "LY", IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ), "LW", IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Mix Wholesale %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ), CALCULATE ( [Mix Wholesale % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) )
			VAR _d1         = _v1 - _c1
			VAR _d2         = _v2 - _c2
			VAR _d3         = _v3 - _c3
			VAR _j          =
			    SWITCH (
			        TRUE ()
			        ,ABS ( _d1 ) >= ABS ( _d2 ) && ABS ( _d1 ) >= ABS ( _d3 )
			            ,1
			        ,ABS ( _d2 ) >= ABS ( _d3 )
			            ,2
			        ,3
			    )
			RETURN
			    IF ( NOT ISBLANK ( _c1 ) && NOT ISBLANK ( _v1 ), _j * 1000 + SWITCH ( _j, 1, _d1, 2, _d2, _d3 ) )
		isHidden
		displayFolder: 9 Engine
		lineageTag: c89c8905-b146-50da-bffc-ea8153820c79

	/// Signed deviation of the largest-deviating channel vs the comparator mix.
	measure 'Card Mix Dev pp' =
			VAR _x          = [Card Mix Dev Channel]
			RETURN
			    IF ( NOT ISBLANK ( _x ), _x - ROUND ( _x / 1000, 0 ) * 1000 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 8 Cards
		lineageTag: 5076b0b0-9bd5-5dee-bfd8-b51f2fd3893a

	/// Largest-deviating channel vs the comparator mix: 1 store, 2 online, 3 wholesale.
	measure 'Card Mix Dev Channel No' =
			VAR _x          = [Card Mix Dev Channel]
			RETURN
			    IF ( NOT ISBLANK ( _x ), ROUND ( _x / 1000, 0 ) )
		formatString: 0
		displayFolder: 8 Cards
		lineageTag: 83f539cc-e619-59ec-b5d8-f34eb8dedfe6

	/// Channel mix delta row: the channel with the largest absolute deviation (data README Card formulas).
	measure 'Card Delta Text CHANNEL_MIX' =
			VAR _j          = [Card Mix Dev Channel No]
			VAR _d          = [Card Mix Dev pp]
			VAR _lab        = SWITCH ( [_Comparator Code], "LY", "vs LY", "LW", [_Prev Short], "vs plan" )
			RETURN
			    IF (
			        ISBLANK ( _j )
			        ,"n/a " & _lab
			        ,SWITCH ( _j, 1, "store", 2, "online", "wholesale" ) & " " & ( VAR _f46 = _d RETURN IF ( _f46 >= 0, "+", "−" ) & FORMAT ( ABS ( _f46 * 100 ), "#,0.0" ) & " pp" ) & " " & _lab
			    )
		displayFolder: 8 Cards
		lineageTag: fdf72c06-8047-595a-9a95-8b491d913923

