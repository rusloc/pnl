			VAR _xc34        = IF ( _xw34 = "", _xc33, IF ( _xf34, _xc33 & " " & _xw34, _xw34 ) )
			VAR _xf35        = LEN ( _xc34 ) + 1 + LEN ( _xw35 ) <= 52
			VAR _xa35        = IF ( _xw35 = "", _xa34, IF ( _xf35, _xa34 & " " & _xw35, _xa34 & "|" & _xw35 ) )
			VAR _xc35        = IF ( _xw35 = "", _xc34, IF ( _xf35, _xc34 & " " & _xw35, _xw35 ) )
			VAR _xf36        = LEN ( _xc35 ) + 1 + LEN ( _xw36 ) <= 52
			VAR _xa36        = IF ( _xw36 = "", _xa35, IF ( _xf36, _xa35 & " " & _xw36, _xa35 & "|" & _xw36 ) )
			VAR _xc36        = IF ( _xw36 = "", _xc35, IF ( _xf36, _xc35 & " " & _xw36, _xw36 ) )
			VAR _xf37        = LEN ( _xc36 ) + 1 + LEN ( _xw37 ) <= 52
			VAR _xa37        = IF ( _xw37 = "", _xa36, IF ( _xf37, _xa36 & " " & _xw37, _xa36 & "|" & _xw37 ) )
			VAR _xc37        = IF ( _xw37 = "", _xc36, IF ( _xf37, _xc36 & " " & _xw37, _xw37 ) )
			VAR _xf38        = LEN ( _xc37 ) + 1 + LEN ( _xw38 ) <= 52
			VAR _xa38        = IF ( _xw38 = "", _xa37, IF ( _xf38, _xa37 & " " & _xw38, _xa37 & "|" & _xw38 ) )
			VAR _xc38        = IF ( _xw38 = "", _xc37, IF ( _xf38, _xc37 & " " & _xw38, _xw38 ) )
			VAR _xf39        = LEN ( _xc38 ) + 1 + LEN ( _xw39 ) <= 52
			VAR _xa39        = IF ( _xw39 = "", _xa38, IF ( _xf39, _xa38 & " " & _xw39, _xa38 & "|" & _xw39 ) )
			VAR _xc39        = IF ( _xw39 = "", _xc38, IF ( _xf39, _xc38 & " " & _xw39, _xw39 ) )
			VAR _xf40        = LEN ( _xc39 ) + 1 + LEN ( _xw40 ) <= 52
			VAR _xa40        = IF ( _xw40 = "", _xa39, IF ( _xf40, _xa39 & " " & _xw40, _xa39 & "|" & _xw40 ) )
			VAR _xc40        = IF ( _xw40 = "", _xc39, IF ( _xf40, _xc39 & " " & _xw40, _xw40 ) )
			VAR _xf41        = LEN ( _xc40 ) + 1 + LEN ( _xw41 ) <= 52
			VAR _xa41        = IF ( _xw41 = "", _xa40, IF ( _xf41, _xa40 & " " & _xw41, _xa40 & "|" & _xw41 ) )
			VAR _xc41        = IF ( _xw41 = "", _xc40, IF ( _xf41, _xc40 & " " & _xw41, _xw41 ) )
			VAR _xf42        = LEN ( _xc41 ) + 1 + LEN ( _xw42 ) <= 52
			VAR _xa42        = IF ( _xw42 = "", _xa41, IF ( _xf42, _xa41 & " " & _xw42, _xa41 & "|" & _xw42 ) )
			VAR _xc42        = IF ( _xw42 = "", _xc41, IF ( _xf42, _xc41 & " " & _xw42, _xw42 ) )
			VAR _xf43        = LEN ( _xc42 ) + 1 + LEN ( _xw43 ) <= 52
			VAR _xa43        = IF ( _xw43 = "", _xa42, IF ( _xf43, _xa42 & " " & _xw43, _xa42 & "|" & _xw43 ) )
			VAR _xc43        = IF ( _xw43 = "", _xc42, IF ( _xf43, _xc42 & " " & _xw43, _xw43 ) )
			VAR _xf44        = LEN ( _xc43 ) + 1 + LEN ( _xw44 ) <= 52
			VAR _xa44        = IF ( _xw44 = "", _xa43, IF ( _xf44, _xa43 & " " & _xw44, _xa43 & "|" & _xw44 ) )
			VAR _xc44        = IF ( _xw44 = "", _xc43, IF ( _xf44, _xc43 & " " & _xw44, _xw44 ) )
			VAR _xf45        = LEN ( _xc44 ) + 1 + LEN ( _xw45 ) <= 52
			VAR _xa45        = IF ( _xw45 = "", _xa44, IF ( _xf45, _xa44 & " " & _xw45, _xa44 & "|" & _xw45 ) )
			VAR _xc45        = IF ( _xw45 = "", _xc44, IF ( _xf45, _xc44 & " " & _xw45, _xw45 ) )
			VAR _xf46        = LEN ( _xc45 ) + 1 + LEN ( _xw46 ) <= 52
			VAR _xa46        = IF ( _xw46 = "", _xa45, IF ( _xf46, _xa45 & " " & _xw46, _xa45 & "|" & _xw46 ) )
			VAR _xc46        = IF ( _xw46 = "", _xc45, IF ( _xf46, _xc45 & " " & _xw46, _xw46 ) )
			VAR _xf47        = LEN ( _xc46 ) + 1 + LEN ( _xw47 ) <= 52
			VAR _xa47        = IF ( _xw47 = "", _xa46, IF ( _xf47, _xa46 & " " & _xw47, _xa46 & "|" & _xw47 ) )
			VAR _xc47        = IF ( _xw47 = "", _xc46, IF ( _xf47, _xc46 & " " & _xw47, _xw47 ) )
			VAR _xf48        = LEN ( _xc47 ) + 1 + LEN ( _xw48 ) <= 52
			VAR _xa48        = IF ( _xw48 = "", _xa47, IF ( _xf48, _xa47 & " " & _xw48, _xa47 & "|" & _xw48 ) )
			VAR _xc48        = IF ( _xw48 = "", _xc47, IF ( _xf48, _xc47 & " " & _xw48, _xw48 ) )
			VAR _n          = MIN ( PATHLENGTH ( _xa48 ), 6 )
			VAR _dy         = _n * 19 + 7
			VAR _h          = 562 + _dy
			VAR _footr      = IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "TOTAL_MARGIN" ), "Provisional · true-up 10 Nov", [Updated Text] )
			VAR _head       =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='683' viewBox='0 0 520 683' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='519' height='" & FORMAT ( _h - 1, "0" ) & "' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Tier 1 · " & _sub ) & "</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Total margin</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text TOTAL_MARGIN]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text TOTAL_MARGIN] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
			        & "<text x='52' y='160' font-size='16' font-weight='600' fill='#374151'>Budget"
			        & "<tspan dx='8' font-size='32' font-weight='700' fill='#111827' letter-spacing='-0.6'>" & [Card Basis Text TOTAL_MARGIN]
			        & "<tspan dx='4' font-size='16' font-weight='600' fill='#374151' letter-spacing='0'>" & _tunit & "</tspan></tspan></text>"
			        & "<text x='24' y='187' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dlong & "</text>"
			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>The share of each euro of sales we keep after paying</text><text x='156' y='296' font-size='13' font-weight='400' fill='#111827'>suppliers for the goods, counting the money suppliers pay</text><text x='156' y='315' font-size='13' font-weight='400' fill='#111827'>back to us.</text><text x='24' y='340' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='341' font-size='13' font-weight='400' fill='#111827'>Front margin alone hides half of a reseller’s profit; this is</text><text x='156' y='360' font-size='13' font-weight='400' fill='#111827'>the margin the business really keeps.</text><text x='24' y='385' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='386' font-size='13' font-weight='400' fill='#111827'>(Front margin + back margin) ÷ Net sales. Front = sales −</text><text x='156' y='405' font-size='13' font-weight='400' fill='#111827'>cost of goods; back = supplier rebates, promo funding and</text><text x='156' y='424' font-size='13' font-weight='400' fill='#111827'>listing fees.</text>"
			        & "<text x='24' y='449' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='507' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='526' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='545' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='449' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='450' font-size='13' font-weight='400' fill='#111827'>Watch when −1.0 pp to 0 vs budget; Off track below −1.0</text><text x='156' y='469' font-size='13' font-weight='400' fill='#111827'>pp. Provisional until the monthly true-up.</text><rect x='24.0' y='494' width='126.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='508' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B1 base-crucial</tspan></text><rect x='156.0' y='494' width='83.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='165.0' y='508' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Margin</tspan></text><rect x='245.0' y='494' width='91.2' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='254.0' y='508' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Finance</tspan></text>"
			        & "<text x='496' y='534' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & _footr & "</text>"
			        & "</g>"
			VAR _svg        = _head & _bars & _body & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: 2c9a5682-b13e-5500-8393-de8f39cf73ec
		dataCategory: ImageUrl

	/// WEEKS_OF_COVER i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG WEEKS_OF_COVER' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status WEEKS_OF_COVER]
			VAR _sub        = "forward" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "WEEKS_OF_COVER" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text WEEKS_OF_COVER]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis WEEKS_OF_COVER] ), "", "wks" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Weeks of Cover], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Cover Target Wks], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( "On hand at cost", "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( ( VAR _f79 = ( CALCULATE ( [On Hand Cost], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f79 ), "n/a", IF ( _f79 < 0, "−", "" ) & "€" & FORMAT ( ABS ( _f79 / 1000000 ), "#,0" ) & "m" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( "On order", "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( ( VAR _f80 = ( CALCULATE ( [On Order Cost], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f80 ), "n/a", IF ( _f80 < 0, "−", "" ) & "€" & FORMAT ( ABS ( _f80 / 1000000 ), "#,0" ) & "m" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( IF ( _gr = "W", "vs last week", [_Prev Short] ), "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( IF ( ISBLANK ( CALCULATE ( [Weeks of Cover], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Weeks of Cover], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ) ), "n/a", ( VAR _f81 = CALCULATE ( [Weeks of Cover], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Weeks of Cover], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ) RETURN IF ( _f81 >= 0, "+", "−" ) & FORMAT ( ABS ( _f81 ), "#,0.0" ) & " wks" ) ), "&", "&amp;" )
