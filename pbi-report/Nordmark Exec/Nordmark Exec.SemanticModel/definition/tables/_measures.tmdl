	/// Card value of the KPI in context.
	measure 'KPI Value' =
			SWITCH (
			    [KPI Code]
			    ,"NET_SALES"
			        ,[Card Value NET_SALES]
			    ,"TOTAL_MARGIN"
			        ,[Card Value TOTAL_MARGIN]
			    ,"WEEKS_OF_COVER"
			        ,[Card Value WEEKS_OF_COVER]
			    ,"MARKDOWN"
			        ,[Card Value MARKDOWN]
			    ,"AVAILABILITY"
