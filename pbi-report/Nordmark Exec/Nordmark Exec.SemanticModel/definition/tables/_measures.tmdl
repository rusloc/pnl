			VAR _xw27        = PATHITEM ( _xw, 27 )
			VAR _xw28        = PATHITEM ( _xw, 28 )
			VAR _xw29        = PATHITEM ( _xw, 29 )
			VAR _xw30        = PATHITEM ( _xw, 30 )
			VAR _xw31        = PATHITEM ( _xw, 31 )
			VAR _xw32        = PATHITEM ( _xw, 32 )
			VAR _xw33        = PATHITEM ( _xw, 33 )
			VAR _xw34        = PATHITEM ( _xw, 34 )
			VAR _xw35        = PATHITEM ( _xw, 35 )
			VAR _xw36        = PATHITEM ( _xw, 36 )
			VAR _xw37        = PATHITEM ( _xw, 37 )
			VAR _xw38        = PATHITEM ( _xw, 38 )
			VAR _xw39        = PATHITEM ( _xw, 39 )
			VAR _xw40        = PATHITEM ( _xw, 40 )
			VAR _xw41        = PATHITEM ( _xw, 41 )
			VAR _xw42        = PATHITEM ( _xw, 42 )
			VAR _xw43        = PATHITEM ( _xw, 43 )
			VAR _xw44        = PATHITEM ( _xw, 44 )
			VAR _xw45        = PATHITEM ( _xw, 45 )
			VAR _xw46        = PATHITEM ( _xw, 46 )
			VAR _xw47        = PATHITEM ( _xw, 47 )
			VAR _xw48        = PATHITEM ( _xw, 48 )
			VAR _xa1        = _xw1
			VAR _xc1        = _xw1
			VAR _xf2        = LEN ( _xc1 ) + 1 + LEN ( _xw2 ) <= 52
			VAR _xa2        = IF ( _xw2 = "", _xa1, IF ( _xf2, _xa1 & " " & _xw2, _xa1 & "|" & _xw2 ) )
			VAR _xc2        = IF ( _xw2 = "", _xc1, IF ( _xf2, _xc1 & " " & _xw2, _xw2 ) )
			VAR _xf3        = LEN ( _xc2 ) + 1 + LEN ( _xw3 ) <= 52
			VAR _xa3        = IF ( _xw3 = "", _xa2, IF ( _xf3, _xa2 & " " & _xw3, _xa2 & "|" & _xw3 ) )
			VAR _xc3        = IF ( _xw3 = "", _xc2, IF ( _xf3, _xc2 & " " & _xw3, _xw3 ) )
			VAR _xf4        = LEN ( _xc3 ) + 1 + LEN ( _xw4 ) <= 52
			VAR _xa4        = IF ( _xw4 = "", _xa3, IF ( _xf4, _xa3 & " " & _xw4, _xa3 & "|" & _xw4 ) )
			VAR _xc4        = IF ( _xw4 = "", _xc3, IF ( _xf4, _xc3 & " " & _xw4, _xw4 ) )
			VAR _xf5        = LEN ( _xc4 ) + 1 + LEN ( _xw5 ) <= 52
			VAR _xa5        = IF ( _xw5 = "", _xa4, IF ( _xf5, _xa4 & " " & _xw5, _xa4 & "|" & _xw5 ) )
			VAR _xc5        = IF ( _xw5 = "", _xc4, IF ( _xf5, _xc4 & " " & _xw5, _xw5 ) )
			VAR _xf6        = LEN ( _xc5 ) + 1 + LEN ( _xw6 ) <= 52
			VAR _xa6        = IF ( _xw6 = "", _xa5, IF ( _xf6, _xa5 & " " & _xw6, _xa5 & "|" & _xw6 ) )
			VAR _xc6        = IF ( _xw6 = "", _xc5, IF ( _xf6, _xc5 & " " & _xw6, _xw6 ) )
			VAR _xf7        = LEN ( _xc6 ) + 1 + LEN ( _xw7 ) <= 52
			VAR _xa7        = IF ( _xw7 = "", _xa6, IF ( _xf7, _xa6 & " " & _xw7, _xa6 & "|" & _xw7 ) )
