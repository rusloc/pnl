	/// SELL_THROUGH card face (E-20): wash, title, chip, value, delta (muted when n/a), bars of the picked type (E-96), i and binoculars; faded in place when concealed (E-55).
	measure 'Card SVG SELL_THROUGH' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _rev        = [Card Revealed SELL_THROUGH]
			VAR _st         = [Card Status SELL_THROUGH]
			VAR _val        = [Card Value Text SELL_THROUGH]
			VAR _unit       = [Card Unit Text SELL_THROUGH]
			VAR _dt         = [Card Delta Text SELL_THROUGH]
			VAR _sub        = "A/W season to date" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "SELL_THROUGH" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dink       = IF ( LEFT ( _dt, 3 ) = "n/a", "#5F6878", _ink )
			VAR _dw         = SUBSTITUTE ( SUBSTITUTE ( _dt, "|", "/" ), " ", "|" )
			VAR _dw1        = PATHITEM ( _dw, 1 )
			VAR _dw2        = PATHITEM ( _dw, 2 )
			VAR _dw3        = PATHITEM ( _dw, 3 )
			VAR _dw4        = PATHITEM ( _dw, 4 )
			VAR _dw5        = PATHITEM ( _dw, 5 )
			VAR _dw6        = PATHITEM ( _dw, 6 )
			VAR _dw7        = PATHITEM ( _dw, 7 )
			VAR _dw8        = PATHITEM ( _dw, 8 )
			VAR _da1        = _dw1
			VAR _dc1        = _dw1
			VAR _df2        = LEN ( _dc1 ) + 1 + LEN ( _dw2 ) <= 14
			VAR _da2        = IF ( _dw2 = "", _da1, IF ( _df2, _da1 & " " & _dw2, _da1 & "|" & _dw2 ) )
			VAR _dc2        = IF ( _dw2 = "", _dc1, IF ( _df2, _dc1 & " " & _dw2, _dw2 ) )
			VAR _df3        = LEN ( _dc2 ) + 1 + LEN ( _dw3 ) <= 14
			VAR _da3        = IF ( _dw3 = "", _da2, IF ( _df3, _da2 & " " & _dw3, _da2 & "|" & _dw3 ) )
			VAR _dc3        = IF ( _dw3 = "", _dc2, IF ( _df3, _dc2 & " " & _dw3, _dw3 ) )
			VAR _df4        = LEN ( _dc3 ) + 1 + LEN ( _dw4 ) <= 14
			VAR _da4        = IF ( _dw4 = "", _da3, IF ( _df4, _da3 & " " & _dw4, _da3 & "|" & _dw4 ) )
			VAR _dc4        = IF ( _dw4 = "", _dc3, IF ( _df4, _dc3 & " " & _dw4, _dw4 ) )
			VAR _df5        = LEN ( _dc4 ) + 1 + LEN ( _dw5 ) <= 14
			VAR _da5        = IF ( _dw5 = "", _da4, IF ( _df5, _da4 & " " & _dw5, _da4 & "|" & _dw5 ) )
			VAR _dc5        = IF ( _dw5 = "", _dc4, IF ( _df5, _dc4 & " " & _dw5, _dw5 ) )
			VAR _df6        = LEN ( _dc5 ) + 1 + LEN ( _dw6 ) <= 14
			VAR _da6        = IF ( _dw6 = "", _da5, IF ( _df6, _da5 & " " & _dw6, _da5 & "|" & _dw6 ) )
			VAR _dc6        = IF ( _dw6 = "", _dc5, IF ( _df6, _dc5 & " " & _dw6, _dw6 ) )
			VAR _df7        = LEN ( _dc6 ) + 1 + LEN ( _dw7 ) <= 14
			VAR _da7        = IF ( _dw7 = "", _da6, IF ( _df7, _da6 & " " & _dw7, _da6 & "|" & _dw7 ) )
			VAR _dc7        = IF ( _dw7 = "", _dc6, IF ( _df7, _dc6 & " " & _dw7, _dw7 ) )
			VAR _df8        = LEN ( _dc7 ) + 1 + LEN ( _dw8 ) <= 14
			VAR _da8        = IF ( _dw8 = "", _da7, IF ( _df8, _da7 & " " & _dw8, _da7 & "|" & _dw8 ) )
			VAR _dc8        = IF ( _dw8 = "", _dc7, IF ( _df8, _dc7 & " " & _dw8, _dw8 ) )
			VAR _dl1        = PATHITEM ( _da8, 1 )
			VAR _dl2        = PATHITEM ( _da8, 2 )
			VAR _dl3        = PATHITEM ( _da8, 3 )
			VAR _bg         = SWITCH ( _st, 2, "<rect x='0.5' y='0.5' width='212' height='167' rx='15.5' fill='url(#wW)' stroke='#E5E7EB'/>", 3, "<rect x='1' y='1' width='211' height='166' rx='15' fill='url(#wO)' stroke='#C0272D' stroke-width='2'/>", "<rect x='0.5' y='0.5' width='212' height='167' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Sell-through %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Sell-through Target], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 88 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 58
			         RETURN
			            "<rect x='" & FORMAT ( 109 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 99 + 58 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M109 " & FORMAT ( 99 + 58 - ( _tgt - _lo ) / ( _hi - _lo ) * 58, "0.0" )
			            & " H197' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _labels     = ""
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='213' height='168' viewBox='0 0 213 168' font-family='Segoe UI, sans-serif'><defs><linearGradient id='wW' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#FFD3A0' stop-opacity='0.5'/></linearGradient><linearGradient id='wO' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#F3C9C5' stop-opacity='0.5'/></linearGradient><filter id='gs'><feColorMatrix type='saturate' values='0'/></filter></defs>"
			        & "<g" & IF ( _rev, "", " opacity='0.08' filter='url(#gs)'" ) & ">" & _bg
			        & "<text x='16' y='27' font-size='13.5' font-weight='600' fill='#111827'>Sell-through</text>"
			        & "<circle cx='186' cy='22' r='11' fill='" & _tint & "'/><text x='186' y='26' text-anchor='middle' font-size='11' font-weight='600' fill='" & _ink & "'>" & _glyph & "</text>"
			        & "<text x='16' y='64' font-size='26' font-weight='600' fill='#111827' letter-spacing='-0.5'>" & _val
			        & "<tspan font-size='13' font-weight='500' fill='#5F6878' letter-spacing='0' dx='4'>" & _unit & "</tspan></text>"
			        & "<text x='16' y='85' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl1 & "</text>"
			        & "<text x='16' y='101' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl2 & "</text>"
			        & "<text x='16' y='117' font-size='12' font-weight='600' fill='" & _dink & "'>" & _dl3 & "</text>"
			        & "<circle cx='30' cy='143' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(22 135) scale(0.8)'><path d='M10 8.6v5.2' stroke='#5F6878' stroke-width='1.8' stroke-linecap='round' fill='none'/><circle cx='10' cy='5.6' r='1' fill='#5F6878'/></g><circle cx='62' cy='143' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(54 135) scale(0.8)'><g fill='none' stroke='#5F6878' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='5.8' cy='13' r='3'/><circle cx='14.2' cy='13' r='3'/><path d='M8.8 12.3h2.4M6.6 10.1 7.4 5.6h2.1l.4 2.6M13.4 10.1 12.6 5.6h-2.1l-.4 2.6'/></g></g>"
			        & _bars
			        & "</g></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: bdd6bcb1-4611-5a67-8025-df4756e7b767
		dataCategory: ImageUrl

