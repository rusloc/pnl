	/// Budget markdown % of gross.
	measure 'Markdown % Bud' = DIVIDE ( [Markdown Bud], [Gross Sales Bud] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6 Budget
		lineageTag: ba3aa48b-448e-5837-a881-489da726e5fc

	/// Budget front GM % = 1 - COGS bud / net sales bud.
	measure 'Front GM % Bud' =
			VAR _ns         = [Net Sales Bud]
			RETURN
			    IF ( NOT ISBLANK ( _ns ), 1 - DIVIDE ( [COGS Bud], _ns ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6 Budget
		lineageTag: bf78444f-f85c-5f8e-8f66-7b05f459e07d

	/// Budget total margin %.
	measure 'Total Margin % Bud' = DIVIDE ( [Net Sales Bud] - [COGS Bud] + [Back Margin Bud], [Net Sales Bud] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6 Budget
		lineageTag: ba1c1f46-99b5-5ac9-ae67-93ef44a08474

	/// Budget EBITDA = budget total margin - budget OpEx (scenario BUD).
	measure 'EBITDA Bud' =
			VAR _ns         = [Net Sales Bud]
			RETURN
			    IF (
			        NOT ISBLANK ( _ns )
			        ,_ns - [COGS Bud] + [Back Margin Bud] - [Opex Shrink Bud] - [Opex Store Bud] - [Opex Central Bud] - [Opex Fulfilment Bud]
			    )
		formatString: #,0.00
		displayFolder: 6 Budget
		lineageTag: 61d3bd6e-ed29-52de-a4ea-3c386f70a8ea

	/// Budget EBITDA % of budget net sales.
	measure 'EBITDA Margin % Bud' = DIVIDE ( [EBITDA Bud], [Net Sales Bud] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6 Budget
		lineageTag: 8a171172-93f9-565f-a765-a7238168e79e

	/// Net sales of rows whose store is LFL in that row's period (is_lfl, E-31).
	measure 'LFL Net Sales' = CALCULATE ( [Net Sales], fact_sales_week[is_lfl] = TRUE () )
		formatString: #,0.00
		displayFolder: 3 LFL
		lineageTag: b48b0f67-5077-5cfc-9084-7376d96645a5

	/// LY net sales of the stores that are LFL one year later, joined by ly_week_key, never by date (E-12, ET-05).
	measure 'LFL Net Sales LY' =
			VAR _ly         = VALUES ( dim_week[ly_week_key] )
			RETURN
			    CALCULATE (
			        [Net Sales]
			        ,REMOVEFILTERS ( dim_week )
			        ,TREATAS ( _ly, dim_week[week_key] )
			        ,fact_sales_week[is_lfl_as_ly] = TRUE ()
			    )
		formatString: #,0.00
		displayFolder: 3 LFL
		lineageTag: 3064cdba-c549-593d-9bf7-ef828c2991c4

	/// LFL growth = LFL net sales / LY LFL net sales - 1; N/A without LY history (E-31).
	measure 'LFL Growth %' =
			VAR _ly         = [LFL Net Sales LY]
			RETURN
			    IF ( _ly <> 0, DIVIDE ( [LFL Net Sales], _ly ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 LFL
		lineageTag: 89bd0dd8-723f-5ae7-9f9c-3d3fe73171d7

	/// Budget net sales of the LFL stores.
	measure 'LFL Net Sales Bud' =
			IF (
			    [LFL Net Sales LY] <> 0
			    ,CALCULATE ( [Net Sales Bud], fact_budget_week[is_lfl] = TRUE () )
			)
		formatString: #,0.00
		displayFolder: 3 LFL
		lineageTag: dfefc019-bcb6-5a2f-9cb3-4b60828e5ab4

	/// Budget LFL = LFL budget net sales / the same LY actual - 1 (data README LFL).
	measure 'LFL Growth % Bud' =
			VAR _ly         = [LFL Net Sales LY]
			VAR _bud        = [LFL Net Sales Bud]
			RETURN
			    IF ( _ly <> 0 && NOT ISBLANK ( _bud ), DIVIDE ( _bud, _ly ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 LFL
		lineageTag: be7da021-b91e-53d4-8d9e-08bb87034942

	/// Distinct sites with sales rows. Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure '_Store Count' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,DISTINCTCOUNT ( fact_sales_week[store_code] )
			        ,CALCULATE ( DISTINCTCOUNT ( fact_sales_week[store_code] ), dim_store[scope_code] = _scope )
			    )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 5bb371e7-a71c-5730-b008-a1bdef4c417c

	/// Stores with is_lfl rows in the window's last week (131 at Week 43, ET-06).
	measure 'LFL Store Count' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    IF (
			        NOT ISBLANK ( [LFL Growth %] )
			        ,CALCULATE (
			            [_Store Count]
			            ,REMOVEFILTERS ( dim_week )
			            ,dim_week[sort_index] = _last
			            ,fact_sales_week[is_lfl] = TRUE ()
			            ,dim_store[channel_code] = "STORE"
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 3 LFL
		lineageTag: 86836ef3-51ad-5f0d-83bd-abe22ed8d7c1

	/// Stores with sales rows in the window's last week (142 at Week 43).
	measure 'Trading Store Count' =
			VAR _last       = MAX ( dim_week[sort_index] )
			RETURN
			    CALCULATE (
			        [_Store Count]
			        ,REMOVEFILTERS ( dim_week )
			        ,dim_week[sort_index] = _last
			        ,dim_store[channel_code] = "STORE"
			    )
		formatString: #,0
		displayFolder: 3 LFL
		lineageTag: e98d9900-b5d1-56fd-a107-fc5c5df9563b

	/// Net sales of the store channel.
	measure 'Store Net Sales' = CALCULATE ( [Net Sales], dim_store[channel_code] = "STORE" ) + 0
		formatString: #,0.00
		displayFolder: 3 LFL
		lineageTag: 501c9499-6ac8-539b-8fc2-5cfaa70af5ee

	/// LY net sales of the store channel by ly_week_key.
	measure 'Store Net Sales LY' =
			VAR _ly         = VALUES ( dim_week[ly_week_key] )
			RETURN
			    CALCULATE (
			        [Net Sales]
			        ,REMOVEFILTERS ( dim_week )
			        ,TREATAS ( _ly, dim_week[week_key] )
			        ,dim_store[channel_code] = "STORE"
			    ) + 0
		formatString: #,0.00
		displayFolder: 3 LFL
		lineageTag: 91fee5b7-ce4e-512b-944e-e78c31761cac

	/// Store-channel growth vs LY - LFL growth (ET-06).
	measure 'Non-LFL Effect pp' =
			VAR _lfl        = [LFL Growth %]
			RETURN
			    IF ( NOT ISBLANK ( _lfl ), DIVIDE ( [Store Net Sales], [Store Net Sales LY] ) - 1 - _lfl )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 LFL
		lineageTag: 13a846a3-1a18-596f-a4dc-fb34855b200e

	/// Online net sales vs LY by week key (LFL card stat).
	measure 'Online Growth vs LY' =
			VAR _ly         = VALUES ( dim_week[ly_week_key] )
			VAR _cur        = CALCULATE ( [Net Sales], dim_store[channel_code] = "ONLINE" )
			VAR _prev       =
			    CALCULATE (
			        [Net Sales]
			        ,REMOVEFILTERS ( dim_week )
			        ,TREATAS ( _ly, dim_week[week_key] )
			        ,dim_store[channel_code] = "ONLINE"
			    )
			RETURN
			    IF ( _prev <> 0, DIVIDE ( _cur, _prev ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 LFL
		lineageTag: bd997ea7-81ce-516f-a9ab-7e57c2c3d39a

	/// On-hand cost, summed over the weeks in context (never use over a window). Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure '_Inv On Hand Cost' =
