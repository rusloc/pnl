	/// EBITDA card face (E-20): wash, title, chip, value, delta (muted when n/a), bars of the picked type (E-96), i and binoculars; faded in place when concealed (E-55).
	measure 'Card SVG EBITDA' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _rev        = [Card Revealed EBITDA]
			VAR _st         = [Card Status EBITDA]
			VAR _val        = [Card Value Text EBITDA]
			VAR _unit       = [Card Unit Text EBITDA]
			VAR _dt         = [Card Delta Text EBITDA]
			VAR _sub        = IF ( [_Granularity Code] = "W", "month " & [Period No] & " " & "to date", [Period Phrase] ) & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "EBITDA" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dink       = IF ( LEFT ( _dt, 3 ) = "n/a", "#5F6878", _ink )
			VAR _bg         = SWITCH ( _st, 2, "<rect x='0.5' y='0.5' width='436' height='175' rx='15.5' fill='url(#wW)' stroke='#E5E7EB'/>", 3, "<rect x='1' y='1' width='435' height='174' rx='15' fill='url(#wO)' stroke='#C0272D' stroke-width='2'/>", "<rect x='0.5' y='0.5' width='436' height='175' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [EBITDA], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [EBITDA Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 180 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 62
			         RETURN
			            "<rect x='" & FORMAT ( 241 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 103 + 62 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M241 " & FORMAT ( 103 + 62 - ( _tgt - _lo ) / ( _hi - _lo ) * 62, "0.0" )
			            & " H421' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _labels     = ""
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='437' height='176' viewBox='0 0 437 176' font-family='Segoe UI, sans-serif'><defs><linearGradient id='wW' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#FFD3A0' stop-opacity='0.5'/></linearGradient><linearGradient id='wO' x1='0' x2='1' y1='0' y2='0'><stop offset='0' stop-color='#FFFFFF'/><stop offset='1' stop-color='#F3C9C5' stop-opacity='0.5'/></linearGradient><filter id='gs'><feColorMatrix type='saturate' values='0'/></filter></defs>"
			        & "<g" & IF ( _rev, "", " opacity='0.08' filter='url(#gs)'" ) & ">" & _bg
			        & "<text x='16' y='27' font-size='13.5' font-weight='600' fill='#111827'>EBITDA flash<tspan font-weight='400' fill='#5F6878'> · " & _sub & "</tspan></text>"
			        & "<rect x='" & FORMAT ( 421 - _cw, "0.0" ) & "' y='11' width='" & FORMAT ( _cw, "0.0" ) & "' height='22' rx='11' fill='" & _tint & "'/>"
			        & "<text x='" & FORMAT ( 421 - _cw / 2, "0.0" ) & "' y='26' text-anchor='middle' font-size='11.5' font-weight='600' fill='" & _ink & "'>" & _chip & "</text>"
			        & "<text x='16' y='67' font-size='30' font-weight='600' fill='#111827' letter-spacing='-0.5'>" & _val
			        & "<tspan font-size='13' font-weight='500' fill='#5F6878' letter-spacing='0' dx='4'>" & _unit & "</tspan></text>"
			        & "<text x='16' y='90' font-size='12.5' font-weight='600' fill='" & _dink & "'>" & _dt & "</text>"
			        & "<circle cx='30' cy='151' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(22 143) scale(0.8)'><path d='M10 8.6v5.2' stroke='#5F6878' stroke-width='1.8' stroke-linecap='round' fill='none'/><circle cx='10' cy='5.6' r='1' fill='#5F6878'/></g><circle cx='62' cy='151' r='13.5' fill='#FFFFFF' fill-opacity='0.6' stroke='#E5E7EB'/><g transform='translate(54 143) scale(0.8)'><g fill='none' stroke='#5F6878' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='5.8' cy='13' r='3'/><circle cx='14.2' cy='13' r='3'/><path d='M8.8 12.3h2.4M6.6 10.1 7.4 5.6h2.1l.4 2.6M13.4 10.1 12.6 5.6h-2.1l-.4 2.6'/></g></g>"
			        & _bars
			        & "</g></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
