	/// EBITDA delta line of the i pop-up: at Week vs Previous it names the compared weeks (vs P9 weeks 1-4, vs P12 FY2025 week 1); else the card delta (E-93, ET-31).
	measure 'Card Delta Long Text EBITDA' =
			VAR _nm         = [_EB Prev Name]
			VAR _v          = [Card Value EBITDA]
			VAR _c          = [Card Compare EBITDA]
			VAR _d          = _v - _c
			VAR _lab        = "vs " & _nm
			RETURN
			    IF (
			        [_Comparator Code] = "LW" && [_Granularity Code] = "W" && _nm <> ""
			        ,IF (
			            ISBLANK ( _v ) || ISBLANK ( _c )
			            ,"n/a " & _lab
			            ,( VAR _f47 = _d RETURN IF ( _f47 >= 0, "+", "−" ) & "€" & IF ( ABS ( _f47 ) / 1000000 >= 1000, FORMAT ( ABS ( _f47 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f47 / 1000000 ), "#,0.0" ) ) & "m" ) & " (" & ( VAR _f48 = DIVIDE ( _v, _c ) - 1 RETURN IF ( _f48 >= 0, "+", "−" ) & FORMAT ( ABS ( _f48 * 100 ), "#,0.0" ) & "%" ) & ") " & _lab
			        )
			        ,[Card Delta Text EBITDA]
			    )
		displayFolder: 8 Cards
		lineageTag: d7dc41db-abeb-5ab5-8830-7c9363f283bc

	/// NET_SALES i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG NET_SALES' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status NET_SALES]
			VAR _sub        = [Period Phrase] & ", " & [Region Phrase] & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "NET_SALES" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text NET_SALES]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis NET_SALES] ), "", "m" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( "vs LY " & [Window Noun], "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( IF ( IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) = 0, "n/a", ( VAR _f63 = DIVIDE ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ), IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) ) - 1 RETURN IF ( _f63 >= 0, "+", "−" ) & FORMAT ( ABS ( _f63 * 100 ), "#,0.0" ) & "%" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( SWITCH ( _gr, "W", "Month " & [Period No] & " to date", "P", "Quarter " & _wq & " to date", "Q", "FY to date", "Budget full year" ), "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( SWITCH ( _gr, "W", ( VAR _f56 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _wps, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f56 ), "n/a", IF ( _f56 < 0, "−", "" ) & "€" & IF ( ABS ( _f56 ) / 1000000 >= 1000, FORMAT ( ABS ( _f56 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f56 / 1000000 ), "#,0.0" ) ) & "m" ) ), "P", ( VAR _f57 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _wqs, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f57 ), "n/a", IF ( _f57 < 0, "−", "" ) & "€" & IF ( ABS ( _f57 ) / 1000000 >= 1000, FORMAT ( ABS ( _f57 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f57 / 1000000 ), "#,0.0" ) ) & "m" ) ), "Q", ( VAR _f58 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _wys, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f58 ), "n/a", IF ( _f58 < 0, "−", "" ) & "€" & IF ( ABS ( _f58 ) / 1000000 >= 1000, FORMAT ( ABS ( _f58 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f58 / 1000000 ), "#,0.0" ) ) & "m" ) ), ( VAR _f59 = CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy ) RETURN IF ( ISBLANK ( _f59 ), "n/a", IF ( _f59 < 0, "−", "" ) & "€" & IF ( ABS ( _f59 ) / 1000000 >= 1000, FORMAT ( ABS ( _f59 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f59 / 1000000 ), "#,0.0" ) ) & "m" ) ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( SWITCH ( _gr, "Q", "Previous quarter", "FY", "Last year", "Year to date" ), "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( SWITCH ( _gr, "Q", ( VAR _f60 = IF ( NOT ISBLANK ( _s2 ), CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s2, dim_week[sort_index] <= _e2 ) ) RETURN IF ( ISBLANK ( _f60 ), "n/a", IF ( _f60 < 0, "−", "" ) & "€" & IF ( ABS ( _f60 ) / 1000000 >= 1000, FORMAT ( ABS ( _f60 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f60 / 1000000 ), "#,0.0" ) ) & "m" ) ), "FY", ( VAR _f61 = IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) RETURN IF ( ISBLANK ( _f61 ), "n/a", IF ( _f61 < 0, "−", "" ) & "€" & IF ( ABS ( _f61 ) / 1000000 >= 1000, FORMAT ( ABS ( _f61 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f61 / 1000000 ), "#,0.0" ) ) & "m" ) ), ( VAR _f62 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _wys, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f62 ), "n/a", IF ( _f62 < 0, "−", "" ) & "€" & IF ( ABS ( _f62 ) / 1000000 >= 1000, FORMAT ( ABS ( _f62 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f62 / 1000000 ), "#,0.0" ) ) & "m" ) ) ), "&", "&amp;" )
			VAR _ex         = ( VAR _f49 = ( CALCULATE ( [Gross Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f49 ), "n/a", IF ( _f49 < 0, "−", "" ) & "€" & IF ( ABS ( _f49 ) / 1000000 >= 1000, FORMAT ( ABS ( _f49 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f49 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " at ticket − " & ( VAR _f50 = ( CALCULATE ( [Markdown], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f50 ), "n/a", IF ( _f50 < 0, "−", "" ) & "€" & IF ( ABS ( _f50 ) / 1000000 >= 1000, FORMAT ( ABS ( _f50 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f50 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " markdowns and discounts − " & ( VAR _f51 = ( CALCULATE ( [Returns], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f51 ), "n/a", IF ( _f51 < 0, "−", "" ) & "€" & IF ( ABS ( _f51 ) / 1000000 >= 1000, FORMAT ( ABS ( _f51 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f51 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " returns = " & "**" & SUBSTITUTE ( ( VAR _f52 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f52 ), "n/a", IF ( _f52 < 0, "−", "" ) & "€" & IF ( ABS ( _f52 ) / 1000000 >= 1000, FORMAT ( ABS ( _f52 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f52 / 1000000 ), "#,0.0" ) ) & "m" ) ), " ", UNICHAR ( 160 ) ) & "**" & IF ( ISBLANK ( CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), ".", ". Budget was " & ( VAR _f53 = CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f53 < 0, "−", "" ) & "€" & IF ( ABS ( _f53 ) / 1000000 >= 1000, FORMAT ( ABS ( _f53 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f53 / 1000000 ), "#,0.0" ) ) & "m" ) & ", so " & ( VAR _f54 = CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f54 >= 0, "+", "−" ) & "€" & IF ( ABS ( _f54 ) / 1000000 >= 1000, FORMAT ( ABS ( _f54 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f54 / 1000000 ), "#,0.0" ) ) & "m" ) & " (" & ( VAR _f55 = DIVIDE ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ), CALCULATE ( [Net Sales Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) - 1 RETURN IF ( _f55 >= 0, "+", "−" ) & FORMAT ( ABS ( _f55 * 100 ), "#,0.0" ) & "%" ) & ")." )
			VAR _xw         = SUBSTITUTE ( SUBSTITUTE ( _ex, "|", "/" ), " ", "|" )
			VAR _xw1        = PATHITEM ( _xw, 1 )
			VAR _xw2        = PATHITEM ( _xw, 2 )
			VAR _xw3        = PATHITEM ( _xw, 3 )
			VAR _xw4        = PATHITEM ( _xw, 4 )
			VAR _xw5        = PATHITEM ( _xw, 5 )
			VAR _xw6        = PATHITEM ( _xw, 6 )
			VAR _xw7        = PATHITEM ( _xw, 7 )
			VAR _xw8        = PATHITEM ( _xw, 8 )
			VAR _xw9        = PATHITEM ( _xw, 9 )
			VAR _xw10        = PATHITEM ( _xw, 10 )
			VAR _xw11        = PATHITEM ( _xw, 11 )
			VAR _xw12        = PATHITEM ( _xw, 12 )
			VAR _xw13        = PATHITEM ( _xw, 13 )
			VAR _xw14        = PATHITEM ( _xw, 14 )
			VAR _xw15        = PATHITEM ( _xw, 15 )
			VAR _xw16        = PATHITEM ( _xw, 16 )
			VAR _xw17        = PATHITEM ( _xw, 17 )
