			        & "<text x='24' y='34' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Explains Tier 1 · " & _sub ) & "</text>"
			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Channel mix</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text CHANNEL_MIX]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text CHANNEL_MIX] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
			        & "<text x='52' y='160' font-size='16' font-weight='600' fill='#374151'>Plan"
			        & "<tspan dx='8' font-size='32' font-weight='700' fill='#111827' letter-spacing='-0.6'>" & [Card Basis Text CHANNEL_MIX]
			        & "<tspan dx='4' font-size='16' font-weight='600' fill='#374151' letter-spacing='0'>" & _tunit & "</tspan></tspan></text>"
			        & "<text x='24' y='187' font-size='13.5' font-weight='600' fill='" & _dink & "'>" & _dlong & "</text>"
			        & "<line x1='24' y1='208' x2='496' y2='208' stroke='#EDEEF0'/>"
			        & "<text x='24.0' y='228' font-size='12' fill='#5F6878'>" & _sl0 & "</text><text x='24.0' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv0 & "</text>"
			        & "<text x='177.3' y='228' font-size='12' fill='#5F6878'>" & _sl1 & "</text><text x='177.3' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv1 & "</text>"
			        & "<text x='330.7' y='228' font-size='12' fill='#5F6878'>" & _sl2 & "</text><text x='330.7' y='248' font-size='15' font-weight='600' fill='#111827'>" & _sv2 & "</text>"
			VAR _body       =
			    "<text x='24' y='276' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHAT IT IS</text><text x='156' y='277' font-size='13' font-weight='400' fill='#111827'>What share of sales came through stores, online and</text><text x='156' y='296' font-size='13' font-weight='400' fill='#111827'>wholesale.</text><text x='24' y='321' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WHY IT MATTERS</text><text x='156' y='322' font-size='13' font-weight='400' fill='#111827'>A shift between channels changes margin and cost to serve</text><text x='156' y='341' font-size='13' font-weight='400' fill='#111827'>even when total sales look fine.</text><text x='24' y='366' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>FORMULA</text><text x='156' y='367' font-size='13' font-weight='400' fill='#111827'>Each channel’s net sales ÷ total net sales, compared with</text><text x='156' y='386' font-size='13' font-weight='400' fill='#111827'>the planned mix.</text>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>WORKED EXAMPLE</text>"
			        & IF ( PATHLENGTH ( _xa48 ) >= 1, "<text x='156' y='412' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 1 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 2, "<text x='156' y='431' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 2 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 3, "<text x='156' y='450' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 3 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 4, "<text x='156' y='469' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 4 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 5, "<text x='156' y='488' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 5 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & IF ( PATHLENGTH ( _xa48 ) >= 6, "<text x='156' y='507' font-size='13' fill='#111827'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( PATHITEM ( _xa48, 6 ), "&", "&amp;" ), "**", "<tspan font-weight='600'>", 1 ), "**", "</tspan>", 1 ) & "</text>" )
			        & "<g transform='translate(0 " & _dy & ")'>"
			        & "<text x='24' y='411' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>STATUS RULE</text><text x='156' y='412' font-size='13' font-weight='400' fill='#111827'>On track within ±2 pp of the plan mix per channel; Watch</text><text x='156' y='431' font-size='13' font-weight='400' fill='#111827'>2–3 pp away; Off track beyond 3 pp.</text><rect x='24.0' y='456' width='167.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='33.0' y='470' font-size='11' fill='#5F6878'>Group <tspan font-weight='600' fill='#111827'>B4 channel &amp; customer</tspan></text><rect x='197.0' y='456' width='72.0' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='206.0' y='470' font-size='11' fill='#5F6878'>Lever <tspan font-weight='600' fill='#111827'>Sales</tspan></text><rect x='275.0' y='456' width='86.5' height='20' rx='10' fill='#FFFFFF' stroke='#DBDCDF'/><text x='284.0' y='470' font-size='11' fill='#5F6878'>Owner <tspan font-weight='600' fill='#111827'>Digital</tspan></text>"
			        & "<text x='496' y='470' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & _footr & "</text>"
