	/// Budget back_margin_bud (FY2026 W1-W52). Scoped by the region switcher (dim_store.scope_code; ALL = no filter).
	measure 'Back Margin Bud' =
			VAR _scope      = [_Scope Code]
			RETURN
			    IF (
			        _scope = "ALL"
			        ,SUM ( fact_budget_week[back_margin_bud] )
			        ,CALCULATE ( SUM ( fact_budget_week[back_margin_bud] ), dim_store[scope_code] = _scope )
