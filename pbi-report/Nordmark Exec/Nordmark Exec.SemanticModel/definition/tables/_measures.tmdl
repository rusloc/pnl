			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='94' viewBox='0 0 300 94' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='299' height='93' rx='11.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='12' y='28' font-size='12.5' font-weight='600' fill='#111827'>Supplier OTIF · <tspan fill='" & _ink & "'>" & _glyph & " " & _word & "</tspan></text>"
			        & "<text x='12' y='48' font-size='12.5' font-weight='400' fill='#111827'>On track at 95% or above; Watch 92–95%; Off</text><text x='12' y='66' font-size='12.5' font-weight='400' fill='#111827'>track below 92%.</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: d1f6facd-582a-5b57-b8fd-13a30519e348
		dataCategory: ImageUrl

	/// CHANNEL_MIX status-chip tooltip: status word and the rule (E-21, E-22).
	measure 'Rule SVG CHANNEL_MIX' =
			VAR _st         = [Card Status CHANNEL_MIX]
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='94' viewBox='0 0 300 94' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='299' height='93' rx='11.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='12' y='28' font-size='12.5' font-weight='600' fill='#111827'>Channel mix · <tspan fill='" & _ink & "'>" & _glyph & " " & _word & "</tspan></text>"
			        & "<text x='12' y='48' font-size='12.5' font-weight='400' fill='#111827'>On track within ±2 pp of the plan mix per</text><text x='12' y='66' font-size='12.5' font-weight='400' fill='#111827'>channel; Watch 2–3 pp away; Off track beyond 3</text><text x='12' y='84' font-size='12.5' font-weight='400' fill='#111827'>pp.</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		isHidden
		displayFolder: 8 Cards SVG
		lineageTag: 8533cce8-5516-5595-a131-c897d0f2f2ed
		dataCategory: ImageUrl

	/// Status-chip tooltip of the KPI in context (tt_rule).
	measure 'KPI Rule SVG' =
			SWITCH (
			    [KPI Code]
			    ,"NET_SALES"
			        ,[Rule SVG NET_SALES]
			    ,"TOTAL_MARGIN"
			        ,[Rule SVG TOTAL_MARGIN]
			    ,"WEEKS_OF_COVER"
			        ,[Rule SVG WEEKS_OF_COVER]
			    ,"MARKDOWN"
			        ,[Rule SVG MARKDOWN]
			    ,"AVAILABILITY"
			        ,[Rule SVG AVAILABILITY]
			    ,"EBITDA"
			        ,[Rule SVG EBITDA]
			    ,"LFL_GROWTH"
			        ,[Rule SVG LFL_GROWTH]
			    ,"FRONT_GM"
			        ,[Rule SVG FRONT_GM]
			    ,"SELL_THROUGH"
			        ,[Rule SVG SELL_THROUGH]
			    ,"GMROI"
			        ,[Rule SVG GMROI]
			    ,"SUPPLIER_OTIF"
			        ,[Rule SVG SUPPLIER_OTIF]
			    ,"CHANNEL_MIX"
			        ,[Rule SVG CHANNEL_MIX]
			)
		displayFolder: 8 Cards
		lineageTag: c717fac5-c661-57d3-9e85-d13057145ee2
		dataCategory: ImageUrl

	/// Header (E-51): brand, period · comparator · region line, refresh stamp, bottom rule.
	measure 'Header SVG' =
			VAR _p          = [Header Period Text]
			VAR _c          = [Header Comparator Text]
			VAR _r          = [Header Region Text]
			VAR _p1         = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _p, "&", "&amp;" ), "**", "<tspan font-weight='600' fill='#111827'>", 1 ), "**", "</tspan>", 1 )
			VAR _c1         = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c, "&", "&amp;" ), "**", "<tspan font-weight='600' fill='#111827'>", 1 ), "**", "</tspan>", 1 )
			VAR _r1         = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _r, "&", "&amp;" ), "**", "<tspan font-weight='600' fill='#111827'>", 1 ), "**", "</tspan>", 1 )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1336' height='52' viewBox='0 0 1336 52' font-family='Segoe UI, sans-serif'>"
			        & "<text x='0' y='21' font-size='18' font-weight='600' fill='#111827' letter-spacing='-0.2'>Nordmark Retail</text>"
			        & "<text x='0' y='38' font-size='12' fill='#5F6878'>Executive dashboard</text>"
			        & "<line x1='153.0' y1='14' x2='153.0' y2='34' stroke='#E5E7EB'/>"
			        & "<text x='171.0' y='29' font-size='13' fill='#5F6878'>" & _p1 & "<tspan dx='18'>" & _c1 & "</tspan><tspan dx='18'>" & _r1 & "</tspan></text>"
			        & "<text x='1336' y='29' text-anchor='end' font-size='12' fill='#5F6878'>" & [Refreshed Text] & "</text>"
			        & "<line x1='0' y1='51.5' x2='1336' y2='51.5' stroke='#E5E7EB'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: 102517df-e0f2-5b99-a892-2e68d0278d49
		dataCategory: ImageUrl

	/// Status line: overall dot (static, E-26), three count pills (E-25), n of 12 metrics · picks (E-56).
	measure 'Status Line SVG' =
			VAR _pk        = [Window Status Pack] + 0
			VAR _on         = INT ( _pk / 1000 )
			VAR _watch      = INT ( MOD ( _pk, 1000 ) / 100 )
			VAR _offc       = INT ( MOD ( _pk, 100 ) / 10 )
			VAR _dot        = MOD ( _pk, 10 )
			VAR _dc         = SWITCH ( _dot, 1, "#2E9E5B", 2, "#E3A52A", 3, "#B3261E", "#D1D5DB" )
			VAR _w1         = SWITCH ( _on, 0, 94.0, 1, 92.0, 2, 94.0, 3, 94.0, 4, 94.2, 5, 94.0, 6, 94.0, 7, 93.8, 8, 94.0, 9, 94.0, 10, 98.8, 11, 96.8, 12, 98.8, 110 )
			VAR _w2         = SWITCH ( _watch, 0, 78.8, 1, 76.8, 2, 78.8, 3, 78.8, 4, 79.0, 5, 78.8, 6, 78.8, 7, 78.5, 8, 78.8, 9, 78.8, 10, 83.5, 11, 81.5, 12, 83.5, 90 )
			VAR _w3         = SWITCH ( _offc, 0, 95.5, 1, 93.5, 2, 95.5, 3, 95.5, 4, 95.7, 5, 95.5, 6, 95.5, 7, 95.2, 8, 95.5, 9, 95.5, 10, 100.2, 11, 98.2, 12, 100.2, 110 )
			VAR _x2         = 24 + _w1 + 6
			VAR _x3         = _x2 + _w2 + 6
			VAR _rev        = [Revealed Count]
			VAR _picks      = SUBSTITUTE ( [Filter Picks Text], "&", "&amp;" )
			VAR _pill       = "' y='4' height='24' rx='12' fill='"
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1336' height='32' viewBox='0 0 1336 32' font-family='Segoe UI, sans-serif'>"
			        & "<circle cx='7' cy='16' r='7' fill='" & _dc & "'/>"
			        & "<rect x='24' width='" & FORMAT ( _w1, "0.0" ) & _pill & "#E1F0E5'/>"
			        & "<text x='" & FORMAT ( 24 + _w1 / 2, "0.0" ) & "' y='20.5' text-anchor='middle' font-size='12' font-weight='600' fill='#136C3A'>▲ " & _on & " on track</text>"
			        & "<rect x='" & FORMAT ( _x2, "0.0" ) & "' width='" & FORMAT ( _w2, "0.0" ) & _pill & "#FBEFD6'/>"
			        & "<text x='" & FORMAT ( _x2 + _w2 / 2, "0.0" ) & "' y='20.5' text-anchor='middle' font-size='12' font-weight='600' fill='#9A5B00'>● " & _watch & " watch</text>"
			        & "<rect x='" & FORMAT ( _x3, "0.0" ) & "' width='" & FORMAT ( _w3, "0.0" ) & _pill & "#FAE3E3'/>"
			        & "<text x='" & FORMAT ( _x3 + _w3 / 2, "0.0" ) & "' y='20.5' text-anchor='middle' font-size='12' font-weight='600' fill='#C0272D'>▼ " & _offc & " off track</text>"
			        & "<text x='1336' y='20.5' text-anchor='end' font-size='12' fill='#5F6878'><tspan font-weight='500' fill='#111827'>" & _rev & " of 12 metrics</tspan> · " & _picks & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: ded4aa6c-7111-5cca-b60f-716f130e24ac
		dataCategory: ImageUrl

	/// Side-bar badge: active attribute picks; empty when none (E-52).
	measure 'Filter Badge SVG' =
			VAR _n          = [Filter Pick Count]
			VAR _svg        =
			    IF (
			        _n > 0
			        ,"<svg xmlns='http://www.w3.org/2000/svg' width='18' height='16' viewBox='0 0 18 16' font-family='Segoe UI, sans-serif'><rect x='0' y='0' width='18' height='16' rx='8' fill='#2048C6'/>"
			            & "<text x='9' y='12' text-anchor='middle' font-size='10' font-weight='600' fill='#FFFFFF'>" & _n & "</text></svg>"
			        ,"<svg xmlns='http://www.w3.org/2000/svg' width='18' height='16' viewBox='0 0 18 16'></svg>"
			    )
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: 487e93f4-a719-5c2c-b4a7-1b10d9f36548
		dataCategory: ImageUrl

	/// Overall-dot tooltip (tt_dot): rule and current shares over the rated cards; grey, no rated card, when none has a status (E-26, E-95; js-exec view.ts dotView).
	measure 'Dot SVG' =
			VAR _pk        = [Window Status Pack] + 0
			VAR _on         = INT ( _pk / 1000 )
			VAR _watch      = INT ( MOD ( _pk, 1000 ) / 100 )
			VAR _offc       = INT ( MOD ( _pk, 100 ) / 10 )
			VAR _n          = _on + _watch + _offc
			VAR _dot        = MOD ( _pk, 10 )
			VAR _word       = SWITCH ( _dot, 1, "green", 2, "orange", 3, "red", "orange" )
			VAR _over       = IF ( _n = 12, "all 12 cards", "the " & _n & " cards with a status (N/A excluded)" )
			VAR _body       = "<text x='12' y='25' font-size='12.5' font-weight='400' fill='#111827'><tspan font-weight='600'>Overall: {word}</tspan> · computed over {over}, filters</text><text x='12' y='43' font-size='12.5' font-weight='400' fill='#111827'>ignored. Red if off track ≥ 1/3 · else orange if watch +</text><text x='12' y='61' font-size='12.5' font-weight='400' fill='#111827'>off track &gt; 50% · else green if on track ≥ 2/3 · else</text><text x='12' y='79' font-size='12.5' font-weight='400' fill='#111827'>orange. Now: off track {off} ({offp}), watch + off {wo} ({wop}),</text><text x='12' y='97' font-size='12.5' font-weight='400' fill='#111827'>on track {on} ({onp}).</text>"
			VAR _grey       = "<text x='12' y='25' font-size='12.5' font-weight='400' fill='#111827'><tspan font-weight='600'>Overall: grey</tspan> · no rated card.</text>"
			VAR _txt        =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _body
			        ,"{word}", _word ), "{over}", _over ), "{offp}", FORMAT ( DIVIDE ( 100 * _offc, _n ), "0" ) & "%" )
			        ,"{wop}", FORMAT ( DIVIDE ( 100 * ( _watch + _offc ), _n ), "0" ) & "%" ), "{onp}", FORMAT ( DIVIDE ( 100 * _on, _n ), "0" ) & "%" )
			        ,"{off}", _offc ), "{wo}", _watch + _offc ), "{on}", _on )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='320' height='132' viewBox='0 0 320 132' font-family='Segoe UI, sans-serif'>"
			        & IF (
			            _n = 0
			            ,"<rect x='0.5' y='0.5' width='319' height='41' rx='11.5' fill='#FFFFFF' stroke='#E5E7EB'/>" & _grey
			            ,"<rect x='0.5' y='0.5' width='319' height='113' rx='11.5' fill='#FFFFFF' stroke='#E5E7EB'/>" & _txt
			        )
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: f8160580-88ce-5a71-8dc4-332862c0844e
		dataCategory: ImageUrl

	/// How to read pop-up: the six bullets of js-exec view.ts how() (E-58).
	measure 'How To Read SVG' =
			VAR _cmp        = SWITCH ( [_Comparator Code], "LY", "Last year", "LW", "Previous", "Budget" )
			VAR _svg        =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='580' height='505' viewBox='0 0 580 505' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='579' height='504' rx='15.5' fill='#FFFFFF' stroke='#E5E7EB'/>"
			        & "<text x='24' y='36' font-size='10.5' font-weight='600' fill='#5F6878' letter-spacing='0.6'>" & UPPER ( "Nordmark · " & [Item Title] ) & "</text>"
			        & "<text x='24' y='60' font-size='18' font-weight='600' fill='#111827'>How to read this page</text>"
			        & "<circle cx='540' cy='36' r='15.5' fill='#FFFFFF' stroke='#DBDCDF'/>"
			        & SUBSTITUTE ( "<circle cx='30' cy='88' r='2.2' fill='#111827'/><text x='42' y='92.0' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>Three numbers</tspan> carry the page: Net sales (sell more), Total margin % (keep more), Weeks</text><text x='42' y='111.5' font-size='13' font-weight='400' fill='#111827'>of cover (turn stock faster). The nine tiles below explain them: card size follows</text><text x='42' y='131.0' font-size='13' font-weight='400' fill='#111827'>importance, worst first.</text><circle cx='30' cy='152.5' r='2.2' fill='#111827'/><text x='42' y='156.5' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>Status</tspan> is vs the metric’s target: ▲ On track · ● Watch · ▼ Off track; the card is washed in</text><text x='42' y='176.0' font-size='13' font-weight='400' fill='#111827'>the status colour; hover a chip for the rule. The <tspan font-weight='600'>Δ line</tspan> is vs the comparator in the header</text><text x='42' y='195.5' font-size='13' font-weight='400' fill='#111827'>({cmp}). The <tspan font-weight='600'>dot</tspan> before the counts is the overall status over the cards with a status;</text><text x='42' y='215.0' font-size='13' font-weight='400' fill='#111827'>hover it for the rule.</text><circle cx='30' cy='236.5' r='2.2' fill='#111827'/><text x='42' y='240.5' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>Bars</tspan> = the last 13 weeks, 12 months, 8 quarters or 2 years up to the picked period; the</text><text x='42' y='260.0' font-size='13' font-weight='400' fill='#111827'>picked one is in the status colour, the dotted line is the target.</text><circle cx='30' cy='281.5' r='2.2' fill='#111827'/><text x='42' y='285.5' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>ⓘ</tspan> opens the plain-English explanation and a worked example; the <tspan font-weight='600'>binoculars</tspan> open the</text><text x='42' y='305.0' font-size='13' font-weight='400' fill='#111827'>drill path to the drill page and its lowest grain.</text><circle cx='30' cy='326.5' r='2.2' fill='#111827'/><text x='42' y='330.5' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>Side bar</tspan>: Filters (period, comparator, region and the metric attributes; inside one attribute</text><text x='42' y='350.0' font-size='13' font-weight='400' fill='#111827'>a choice is OR, across attributes AND; filtered-out cards fade in place so nothing moves;</text><text x='42' y='369.5' font-size='13' font-weight='400' fill='#111827'>the badge counts active choices; Reset clears), How to read, More KPIs (the 20 bench</text><text x='42' y='389.0' font-size='13' font-weight='400' fill='#111827'>metrics, inactive).</text><circle cx='30' cy='410.5' r='2.2' fill='#111827'/><text x='42' y='414.5' font-size='13' font-weight='400' fill='#111827'><tspan font-weight='600'>prov.</tspan> in a title = provisional until close (true-up 10 Nov). Illustrative data · EUR · NL + BE ·</text><tex"
			        & "t x='42' y='434.0' font-size='13' font-weight='400' fill='#111827'>LY = same retail week.</text><line x1='24' y1='465.5' x2='556' y2='465.5' stroke='#EDEEF0'/><text x='24' y='489.5' font-size='12.5' fill='#5F6878'>Illustrative data</text>", "{cmp}", _cmp )
			        & "<text x='556' y='489.5' text-anchor='end' font-size='12.5' font-weight='500' fill='#111827'>" & [Refreshed Text] & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8 Cards SVG
		lineageTag: b0effbca-9eff-5e6b-9be1-ab9f1ba4857e
		dataCategory: ImageUrl

	/// Invisible value of the overall-dot hover target (tt_dot).
	measure 'Dot Hit' = UNICHAR ( 160 )
		displayFolder: 8 Cards
		lineageTag: 701ddc31-a51e-5d3e-be0d-e665087ee2d7

