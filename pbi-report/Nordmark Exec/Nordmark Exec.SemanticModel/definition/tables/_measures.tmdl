			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Front gross margin</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text FRONT_GM]
			        & "<tspan font-size='16' font-weight='500' fill='#5F6878' letter-spacing='0' dx='6'>" & [Card Unit Text FRONT_GM] & "</tspan></text>"
			        & "<line x1='24' y1='150' x2='44' y2='150' stroke='#9CA3AF' stroke-width='2' stroke-dasharray='2 2'/>"
