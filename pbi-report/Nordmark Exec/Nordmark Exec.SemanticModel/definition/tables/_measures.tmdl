	/// FRONT_GM i pop-up (tooltip page tt_info, E-57, ET-30, ET-32): value, the status basis big and bold under it, delta, labelled bars of the picked type, 3 stats, what / why / formula / worked example / rule, tags closed by the refresh or provisional note (js-exec view.ts, Layers.tsx).
	measure 'Info SVG FRONT_GM' =
			VAR _s          = [_Window Start]
			VAR _e          = [_Window End]
			VAR _ls         = [_LY Window Start]
			VAR _le         = [_LY Window End]
			VAR _s2         = [_Prev Window Start]
			VAR _e2         = [_Prev Window End]
			VAR _gr         = [_Granularity Code]
			VAR _wpk        = CALCULATE ( MAX ( dim_week[period_key] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wq         = CALCULATE ( MAX ( dim_week[quarter] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wfy        = CALCULATE ( MAX ( dim_week[fy] ), REMOVEFILTERS ( dim_week ), dim_week[sort_index] = _e )
			VAR _wps        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[period_key] = _wpk )
			VAR _wqs        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy, dim_week[quarter] = _wq )
			VAR _wys        = CALCULATE ( MIN ( dim_week[sort_index] ), REMOVEFILTERS ( dim_week ), dim_week[fy] = _wfy )
			VAR _ps         = IF ( _gr = "W", _wps, _s )
			VAR _st         = [Card Status FRONT_GM]
			VAR _sub        = "% of net sales" & IF ( LOOKUPVALUE ( dim_kpi[is_provisional], dim_kpi[kpi_code], "FRONT_GM" ), " · prov.", "" )
			VAR _ink        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#5F6878" )
			VAR _cur        = SWITCH ( _st, 1, "#136C3A", 2, "#9A5B00", 3, "#C0272D", "#111827" )
			VAR _tint       = SWITCH ( _st, 1, "#E1F0E5", 2, "#FBEFD6", 3, "#FAE3E3", "#F1F3F5" )
			VAR _chip       = SWITCH ( _st, 1, "▲ On track", 2, "● Watch", 3, "▼ Off track", "– N/A" )
			VAR _glyph      = SWITCH ( _st, 1, "▲", 2, "●", 3, "▼", "–" )
			VAR _word       = SWITCH ( _st, 1, "On track", 2, "Watch", 3, "Off track", "N/A" )
			VAR _cw         = SWITCH ( _st, 1, 74.8, 2, 63.5, 3, 76.0, 51.2 )
			VAR _dlong      = [Card Delta Text FRONT_GM]
			VAR _dink       = IF ( LEFT ( _dlong, 3 ) = "n/a", "#5F6878", _ink )
			VAR _tunit      = IF ( ISBLANK ( [Card Basis FRONT_GM] ), "", "%" )
			VAR _bgr        = [_Granularity Code]
			VAR _bo         = [_Item Sort]
			VAR _bn         = SWITCH ( _bgr, "P", 12, "Q", 8, "FY", 2, 13 )
			VAR _pts        =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( dim_item, "@o", dim_item[sort_order] + 0, "@bs", dim_item[start_index] + 0, "@be", dim_item[end_index] + 0 )
			            ,REMOVEFILTERS ( dim_item )
			            ,dim_item[granularity_code] = _bgr
			            ,dim_item[sort_order] > _bo - _bn
			            ,dim_item[sort_order] <= _bo
			        )
			        ,"@i", [@o] - _bo + _bn - 1
			        ,"@v", VAR _x1 = [@bs] VAR _x2 = [@be] RETURN CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _x1, dim_week[sort_index] <= _x2 )
			    )
			VAR _nb         = FILTER ( _pts, NOT ISBLANK ( [@v] ) )
			VAR _tgt        = CALCULATE ( [Front GM % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e )
			VAR _mn         = MINX ( _nb, [@v] )
			VAR _mx         = MAXX ( _nb, [@v] )
			VAR _lo0        = IF ( NOT ISBLANK ( _tgt ) && _tgt < _mn, _tgt, _mn )
			VAR _hi0        = IF ( NOT ISBLANK ( _tgt ) && _tgt > _mx, _tgt, _mx )
			VAR _rng        = IF ( _hi0 - _lo0 = 0, 1, _hi0 - _lo0 )
			VAR _lo         = _lo0 - _rng * 0.6
			VAR _hi         = _hi0 + _rng * 0.15
			VAR _bw         = ( 240 - 2 * ( _bn - 1 ) ) / _bn
			VAR _rects      =
			    CONCATENATEX (
			        _nb
			        ,VAR _h = ( [@v] - _lo ) / ( _hi - _lo ) * 60
			         RETURN
			            "<rect x='" & FORMAT ( 256 + [@i] * ( _bw + 2 ), "0.0" ) & "' y='" & FORMAT ( 119 + 60 - _h, "0.0" )
			                & "' width='" & FORMAT ( _bw, "0.0" ) & "' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='"
			                & IF ( [@i] = _bn - 1, _cur, "#D1D5DB" ) & "'/>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _tline      =
			    IF (
			        NOT ISBLANK ( _tgt ) && COUNTROWS ( _nb ) > 0
			        ,"<path d='M256 " & FORMAT ( 119 + 60 - ( _tgt - _lo ) / ( _hi - _lo ) * 60, "0.0" )
			            & " H496' stroke='#9CA3AF' stroke-width='1' stroke-dasharray='2 2' fill='none'/>"
			    )
			VAR _fy0        = CALCULATE ( MIN ( dim_item[fy] ), REMOVEFILTERS ( dim_item ) )
			VAR _per        = SWITCH ( _bgr, "P", 12, "Q", 4, 52 )
			VAR _stride     = IF ( _bn >= 12, 3, IF ( _bn >= 8, 2, 1 ) )
			VAR _labels     =
			    CONCATENATEX (
			        FILTER ( GENERATESERIES ( 0, _bn - 1, 1 ), MOD ( _bn - 1 - [Value], _stride ) = 0 )
			        ,VAR _i = [Value]
			         VAR _pos = _bo - _bn + _i
			         VAR _lfy = IF ( _bgr = "FY", _fy0 + _pos, _fy0 + INT ( _pos / _per ) )
			         VAR _ln = MOD ( _pos, _per ) + 1
			         VAR _lt = SWITCH ( _bgr, "FY", "FY" & RIGHT ( _lfy, 2 ), "Q", "Q" & _ln & " FY" & RIGHT ( _lfy, 2 ), "P", "P" & _ln, "W" & _ln )
			         RETURN
			            "<text x='" & FORMAT ( 256 + _i * ( _bw + 2 ) + _bw / 2, "0.0" ) & "' y='190' text-anchor='middle' font-size='9' fill='"
			                & IF ( _i = _bn - 1, "#111827' font-weight='600", "#5F6878" ) & "'>" & _lt & "</text>"
			        ,""
			        ,[Value], ASC
			    )
			VAR _bars       = IF ( COUNTROWS ( _nb ) > 0, _rects, "" ) & _tline & _labels
			VAR _sl0        = SUBSTITUTE ( "Cost of goods", "&", "&amp;" )
			VAR _sv0        = SUBSTITUTE ( ( VAR _f130 = ( CALCULATE ( [COGS], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f130 ), "n/a", IF ( _f130 < 0, "−", "" ) & "€" & IF ( ABS ( _f130 ) / 1000000 >= 1000, FORMAT ( ABS ( _f130 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f130 / 1000000 ), "#,0.0" ) ) & "m" ) ), "&", "&amp;" )
			VAR _sl1        = SUBSTITUTE ( "Front margin", "&", "&amp;" )
			VAR _sv1        = SUBSTITUTE ( ( VAR _f131 = ( CALCULATE ( [Front Margin], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f131 ), "n/a", IF ( _f131 < 0, "−", "" ) & "€" & IF ( ABS ( _f131 ) / 1000000 >= 1000, FORMAT ( ABS ( _f131 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f131 / 1000000 ), "#,0.0" ) ) & "m" ) ), "&", "&amp;" )
			VAR _sl2        = SUBSTITUTE ( "vs LY " & [Window Noun], "&", "&amp;" )
			VAR _sv2        = SUBSTITUTE ( IF ( ISBLANK ( CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) ), "n/a", ( VAR _f132 = CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - IF ( NOT ISBLANK ( _ls ), CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _ls, dim_week[sort_index] <= _le ) ) RETURN IF ( _f132 >= 0, "+", "−" ) & FORMAT ( ABS ( _f132 * 100 ), "#,0.0" ) & " pp" ) ), "&", "&amp;" )
			VAR _ex         = ( VAR _f124 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f124 ), "n/a", IF ( _f124 < 0, "−", "" ) & "€" & IF ( ABS ( _f124 ) / 1000000 >= 1000, FORMAT ( ABS ( _f124 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f124 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " − " & ( VAR _f125 = ( CALCULATE ( [COGS], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f125 ), "n/a", IF ( _f125 < 0, "−", "" ) & "€" & IF ( ABS ( _f125 ) / 1000000 >= 1000, FORMAT ( ABS ( _f125 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f125 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " cost of goods = " & ( VAR _f126 = ( CALCULATE ( [Front Margin], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f126 ), "n/a", IF ( _f126 < 0, "−", "" ) & "€" & IF ( ABS ( _f126 ) / 1000000 >= 1000, FORMAT ( ABS ( _f126 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f126 / 1000000 ), "#,0.0" ) ) & "m" ) ) & "; ÷ " & ( VAR _f124 = ( CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) + 0 ) RETURN IF ( ISBLANK ( _f124 ), "n/a", IF ( _f124 < 0, "−", "" ) & "€" & IF ( ABS ( _f124 ) / 1000000 >= 1000, FORMAT ( ABS ( _f124 / 1000000 ), "#,0" ), FORMAT ( ABS ( _f124 / 1000000 ), "#,0.0" ) ) & "m" ) ) & " = " & "**" & SUBSTITUTE ( ( VAR _f127 = CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( ISBLANK ( _f127 ), "n/a", IF ( _f127 < 0, "−", "" ) & FORMAT ( ABS ( _f127 * 100 ), "#,0.0" ) & "%" ) ), " ", UNICHAR ( 160 ) ) & "**" & IF ( ISBLANK ( CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ) || ISBLANK ( CALCULATE ( [Front GM % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) ), ".", ". Budget " & ( VAR _f128 = CALCULATE ( [Front GM % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f128 < 0, "−", "" ) & FORMAT ( ABS ( _f128 * 100 ), "#,0.0" ) & "%" ) & ", so " & ( VAR _f129 = CALCULATE ( [Front GM %], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) - CALCULATE ( [Front GM % Bud], REMOVEFILTERS ( dim_week ), dim_week[sort_index] >= _s, dim_week[sort_index] <= _e ) RETURN IF ( _f129 >= 0, "+", "−" ) & FORMAT ( ABS ( _f129 * 100 ), "#,0.0" ) & " pp" ) & "." )
			VAR _xw         = SUBSTITUTE ( SUBSTITUTE ( _ex, "|", "/" ), " ", "|" )
			VAR _xw1        = PATHITEM ( _xw, 1 )
			VAR _xw2        = PATHITEM ( _xw, 2 )
			VAR _xw3        = PATHITEM ( _xw, 3 )
			VAR _xw4        = PATHITEM ( _xw, 4 )
			VAR _xw5        = PATHITEM ( _xw, 5 )
			VAR _xw6        = PATHITEM ( _xw, 6 )
			VAR _xw7        = PATHITEM ( _xw, 7 )
			VAR _xw8        = PATHITEM ( _xw, 8 )
			VAR _xw9        = PATHITEM ( _xw, 9 )
			VAR _xw10        = PATHITEM ( _xw, 10 )
			VAR _xw11        = PATHITEM ( _xw, 11 )
			VAR _xw12        = PATHITEM ( _xw, 12 )
			VAR _xw13        = PATHITEM ( _xw, 13 )
			VAR _xw14        = PATHITEM ( _xw, 14 )
			VAR _xw15        = PATHITEM ( _xw, 15 )
			VAR _xw16        = PATHITEM ( _xw, 16 )
			VAR _xw17        = PATHITEM ( _xw, 17 )
			VAR _xw18        = PATHITEM ( _xw, 18 )
			VAR _xw19        = PATHITEM ( _xw, 19 )
			VAR _xw20        = PATHITEM ( _xw, 20 )
			VAR _xw21        = PATHITEM ( _xw, 21 )
			VAR _xw22        = PATHITEM ( _xw, 22 )
			VAR _xw23        = PATHITEM ( _xw, 23 )
			VAR _xw24        = PATHITEM ( _xw, 24 )
			VAR _xw25        = PATHITEM ( _xw, 25 )
			VAR _xw26        = PATHITEM ( _xw, 26 )
			VAR _xw27        = PATHITEM ( _xw, 27 )
			VAR _xw28        = PATHITEM ( _xw, 28 )
			VAR _xw29        = PATHITEM ( _xw, 29 )
			VAR _xw30        = PATHITEM ( _xw, 30 )
			VAR _xw31        = PATHITEM ( _xw, 31 )
			VAR _xw32        = PATHITEM ( _xw, 32 )
			VAR _xw33        = PATHITEM ( _xw, 33 )
			VAR _xw34        = PATHITEM ( _xw, 34 )
			VAR _xw35        = PATHITEM ( _xw, 35 )
			VAR _xw36        = PATHITEM ( _xw, 36 )
			VAR _xw37        = PATHITEM ( _xw, 37 )
			VAR _xw38        = PATHITEM ( _xw, 38 )
			VAR _xw39        = PATHITEM ( _xw, 39 )
			VAR _xw40        = PATHITEM ( _xw, 40 )
			VAR _xw41        = PATHITEM ( _xw, 41 )
			VAR _xw42        = PATHITEM ( _xw, 42 )
			VAR _xw43        = PATHITEM ( _xw, 43 )
			VAR _xw44        = PATHITEM ( _xw, 44 )
			VAR _xw45        = PATHITEM ( _xw, 45 )
			VAR _xw46        = PATHITEM ( _xw, 46 )
			VAR _xw47        = PATHITEM ( _xw, 47 )
			VAR _xw48        = PATHITEM ( _xw, 48 )
			VAR _xa1        = _xw1
