			        & "<text x='24' y='58' font-size='18' font-weight='600' fill='#111827'>Markdown</text>"
			        & "<text x='496' y='58' text-anchor='end' font-size='14' font-weight='600' fill='" & _ink & "'>" & _word & "</text>"
			        & "<text x='24' y='116' font-size='48' font-weight='600' fill='#111827' letter-spacing='-1.4'>" & [Card Value Text MARKDOWN]
