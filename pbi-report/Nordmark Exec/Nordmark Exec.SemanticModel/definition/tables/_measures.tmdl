			VAR _xc12        = IF ( _xw12 = "", _xc11, IF ( _xf12, _xc11 & " " & _xw12, _xw12 ) )
			VAR _xf13        = LEN ( _xc12 ) + 1 + LEN ( _xw13 ) <= 52
			VAR _xa13        = IF ( _xw13 = "", _xa12, IF ( _xf13, _xa12 & " " & _xw13, _xa12 & "|" & _xw13 ) )
			VAR _xc13        = IF ( _xw13 = "", _xc12, IF ( _xf13, _xc12 & " " & _xw13, _xw13 ) )
			VAR _xf14        = LEN ( _xc13 ) + 1 + LEN ( _xw14 ) <= 52
			VAR _xa14        = IF ( _xw14 = "", _xa13, IF ( _xf14, _xa13 & " " & _xw14, _xa13 & "|" & _xw14 ) )
			VAR _xc14        = IF ( _xw14 = "", _xc13, IF ( _xf14, _xc13 & " " & _xw14, _xw14 ) )
			VAR _xf15        = LEN ( _xc14 ) + 1 + LEN ( _xw15 ) <= 52
			VAR _xa15        = IF ( _xw15 = "", _xa14, IF ( _xf15, _xa14 & " " & _xw15, _xa14 & "|" & _xw15 ) )
			VAR _xc15        = IF ( _xw15 = "", _xc14, IF ( _xf15, _xc14 & " " & _xw15, _xw15 ) )
