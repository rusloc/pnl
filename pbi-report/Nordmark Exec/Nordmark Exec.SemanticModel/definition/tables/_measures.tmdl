	/// Overall dot: 1 green, 2 orange, 3 red. Literal v5 rule over the cards with a status (N/A excluded), constants from param_status_rule (E-26, ADR-0013 (i)); follows period and region, ignores attribute filters.
	measure 'Status Dot' =
			VAR _t          =
			    {
			        [Status NET_SALES]
			        ,[Status TOTAL_MARGIN]
			        ,[Status WEEKS_OF_COVER]
			        ,[Status MARKDOWN]
			        ,[Status AVAILABILITY]
			        ,[Status EBITDA]
			        ,[Status LFL_GROWTH]
			        ,[Status FRONT_GM]
			        ,[Status SELL_THROUGH]
			        ,[Status GMROI]
			        ,[Status SUPPLIER_OTIF]
			        ,[Status CHANNEL_MIX]
			    }
			VAR _on         = COUNTROWS ( FILTER ( _t, [Value] = 1 ) ) + 0
			VAR _watch      = COUNTROWS ( FILTER ( _t, [Value] = 2 ) ) + 0
			VAR _offc       = COUNTROWS ( FILTER ( _t, [Value] = 3 ) ) + 0
			VAR _n          = _on + _watch + _offc
			VAR _red        = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_RED_OFF" )
			VAR _orange     = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_ORANGE_WATCH_OFF" )
			VAR _green      = LOOKUPVALUE ( param_status_rule[threshold], param_status_rule[rule_code], "DOT_GREEN_GOOD" )
			RETURN
			    IF (
			        _n > 0
			        ,SWITCH (
			            TRUE ()
			            ,DIVIDE ( _offc, _n ) >= _red
			                ,3
			            ,DIVIDE ( _watch + _offc, _n ) > _orange
			                ,2
			            ,DIVIDE ( _on, _n ) >= _green
			                ,1
			            ,2
			        )
			    )
		formatString: 0
		displayFolder: 7 Status
		lineageTag: f572424a-030b-5409-a8b4-7b645ae49b40

