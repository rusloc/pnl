	partition fact_supplier_income_week = m
		mode: import
		source =
				let
				    // Portable source (ADR-0013 (b), E-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly (the data README Format section).
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_supplier_income_week.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"week_key", type text},
				            {"supplier_code", type text},
				            {"rebate_accrual", type number},
				            {"promo_funding", type number},
				            {"listing_fees", type number},
				            {"is_provisional", type logical}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table
