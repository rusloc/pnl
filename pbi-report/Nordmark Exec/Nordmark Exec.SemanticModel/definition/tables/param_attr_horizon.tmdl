/// Filters menu attribute Horizon (E-53): multi-select, OR within, AND across. Disconnected; matched to dim_kpi[horizon].
table param_attr_horizon
	lineageTag: 2bd6c745-9dbb-56aa-b459-c53ef62c7cca

	column attr_code
		dataType: string
		isHidden
		lineageTag: 3a8f554d-2770-51aa-a016-992be8f900fa
		summarizeBy: none
		isNameInferred
		sourceColumn: [attr_code]

		annotation SummarizationSetBy = User

	column attr_label
		dataType: string
		lineageTag: 7d62dec7-5427-5cc5-85c5-4a85a486a3c9
		summarizeBy: none
		isNameInferred
		sourceColumn: [attr_label]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 65b9da63-b5b1-56ab-a410-0896eef77daa
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition param_attr_horizon = calculated
		mode: import
		source =
				DATATABLE (
				    "attr_code", STRING
				    ,"attr_label", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "week", "Week", 1 }
				        ,{ "month", "Month", 2 }
				        ,{ "quarter", "Quarter", 3 }
				    }
				)

	annotation PBI_ResultType = Table
