	partition dim_store = m
		mode: import
		source =
				let
				    // Portable source (ADR-0013 (b), E-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly (the data README Format section).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_store.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"store_code", type text},
				            {"store_name", type text},
				            {"channel_code", type text},
				            {"format", type text},
				            {"country", type text},
				            {"region", type text},
				            {"scope_code", type text},
				            {"cluster", type text},
				            {"sales_area_sqm", Int64.Type},
				            {"open_date", type date},
				            {"close_date", type date},
				            {"refit_date", type date},
				            {"sort_order", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table
