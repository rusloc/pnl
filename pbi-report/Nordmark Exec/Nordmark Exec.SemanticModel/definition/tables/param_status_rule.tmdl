	partition param_status_rule = m
		mode: import
		source =
				let
				    // Portable source (ADR-0013 (b), E-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly (the data README Format section).
				    src = Parquet.Document(File.Contents(DataFolder & "\param_status_rule.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"rule_code", type text},
				            {"kpi_code", type text},
				            {"basis", type text},
				            {"direction", type text},
				            {"unit", type text},
				            {"watch_from", type number},
				            {"off_from", type number},
				            {"threshold", type number},
				            {"sort_order", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table
