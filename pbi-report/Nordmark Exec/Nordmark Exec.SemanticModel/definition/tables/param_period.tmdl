/// Period switcher (E-13): Week, Period to date, Year to date. Disconnected.
table param_period
	lineageTag: f57e7bc6-cfff-5a1d-af88-532660c4053b

	column period_code
		dataType: string
		isHidden
		lineageTag: 51e85bef-5ebe-501c-b510-ae780e8cbec9
		summarizeBy: none
		isNameInferred
		sourceColumn: [period_code]

		annotation SummarizationSetBy = User

	column period_name
		dataType: string
		lineageTag: 3fcd314d-d5d8-508b-9c4c-fee364493cd5
		summarizeBy: none
		isNameInferred
		sourceColumn: [period_name]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b6b7476a-42a6-5790-a78d-1dbbf1cb7049
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition param_period = calculated
		mode: import
		source =
				DATATABLE (
				    "period_code", STRING
				    ,"period_name", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "W", "Week", 1 }
				        ,{ "PTD", "Period to date", 2 }
				        ,{ "YTD", "Year to date", 3 }
				    }
				)

	annotation PBI_ResultType = Table
