{
  "name": "nordmark-exec-theme.json",
  "dataColors": [
    "#2048C6",
    "#374151",
    "#B6BCC6",
    "#136C3A",
    "#9A5B00",
    "#C0272D",
    "#5F6878",
    "#D1D5DB"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
