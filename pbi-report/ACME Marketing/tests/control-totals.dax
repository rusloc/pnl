RETURN
    SELECTCOLUMNS (
        _rows
        ,"scope", [scope]
        ,"period", [period]
        ,"metric", [metric]
        ,"expected", [expected]
        ,"actual", [actual]
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.000001 + ABS ( [expected] ) * 0.0000001
    )
ORDER BY
    [_pass]
    ,[scope]
    ,[metric]

