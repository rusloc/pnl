                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "store_views", "expected", 0, "actual", 1.0 * ( [Store Views] ) )
                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "team_cost", "expected", 3428.8778396, "actual", 1.0 * ( [Team Cost] ) )
                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "trial_rate", "expected", 0.5478723404, "actual", 1.0 * ( [Trial Rate] ) )
                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "trial_to_paid", "expected", 0.1589961165, "actual", 1.0 * ( [Trial to Paid] ) )
                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "trials", "expected", 206, "actual", 1.0 * ( [Trials] ) )
                ,ROW ( "scope", "PF:WEB", "period", "MTD-2026-11-03", "metric", "web_land_rate", "expected", 0.804738023, "actual", 1.0 * ( [Web Land Rate] ) )
            )
            ,TREATAS ( { "MTD" }, param_period_preset[preset_code] )
            ,TREATAS ( { "WEB" }, dim_platform[platform_code] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"scope", [scope]
        ,"period", [period]
        ,"metric", [metric]
        ,"expected", [expected]
        ,"actual", [actual]
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.000001 + ABS ( [expected] ) * 0.0000001
    )
ORDER BY
    [_pass]
    ,[scope]
    ,[metric]

