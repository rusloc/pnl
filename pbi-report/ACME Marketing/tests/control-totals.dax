    SELECTCOLUMNS (
        _rows
        ,"scope", [scope]
        ,"period", [period]
        ,"metric", [metric]
        ,"expected", [expected]
        ,"actual", [actual]
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.000001 + ABS ( [expected] ) * 0.0000001
    )
ORDER BY
    [_pass]
    ,[scope]
    ,[metric]

// ==== BLOCK T-K5-default-window: default window only: alerts (slots, values, count), movers (Δ ROAS, rank), freshness, story events (A-63, A-64) (85 rows)
EVALUATE
VAR _rows         =
    UNION (
        CALCULATETABLE (
            ROW ( "scope", "ALL", "period", "R30-2026-11-03", "metric", "alert.ATTR_GAP_WIDEN", "expected", 1, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "ATTR_GAP_WIDEN|ALL" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "ALL", "period", "R30-2026-11-03", "metric", "alert.DATA_STALE", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "DATA_STALE|ALL" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "ALL", "period", "R30-2026-11-03", "metric", "alert_value.ATTR_GAP_WIDEN", "expected", 0.0783620932, "actual", 1.0 * ( [Alert Value] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "ATTR_GAP_WIDEN|ALL" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "CH:AFFILIATES", "period", "R30-2026-11-03", "metric", "alert.PACING_OVER", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "PACING_OVER|AFFILIATES" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "CH:AFFILIATES", "period", "R30-2026-11-03", "metric", "alert.UNDERSPENT_SCALE", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "UNDERSPENT_SCALE|AFFILIATES" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "CH:APP_INSTALL", "period", "R30-2026-11-03", "metric", "alert.PACING_OVER", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "PACING_OVER|APP_INSTALL" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "CH:APP_INSTALL", "period", "R30-2026-11-03", "metric", "alert.UNDERSPENT_SCALE", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "UNDERSPENT_SCALE|APP_INSTALL" }, dim_alert_slot[slot_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "CH:DISPLAY_VIDEO", "period", "R30-2026-11-03", "metric", "alert.PACING_OVER", "expected", 0, "actual", 1.0 * ( [Alert Tripped] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
