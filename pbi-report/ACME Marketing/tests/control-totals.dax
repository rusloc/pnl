        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "O4 shares SVG non-blank", "expected", 2, "actual", 1.0 * ( INT ( NOT ISBLANK ( [O4 Shares SVG] ) ) + INT ( NOT ISBLANK ( [O1 Funnel SVG] ) ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
