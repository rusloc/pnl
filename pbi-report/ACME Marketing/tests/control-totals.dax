            ROW ( "scope", "CH:RETARGETING", "period", "R30-2026-11-03", "metric", "cpa.last_click (slicer)", "expected", 204.347826087, "actual", 1.0 * ( [CPA] ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
            ,TREATAS ( { "RETARGETING" }, dim_channel[channel_code] )
            ,TREATAS ( { "LAST_CLICK" }, dim_attribution_model[model_code] )
        )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"scope", [scope]
        ,"period", [period]
        ,"metric", [metric]
        ,"expected", [expected]
        ,"actual", [actual]
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.000001 + ABS ( [expected] ) * 0.0000001
    )
ORDER BY
    [_pass]
    ,[scope]
    ,[metric]

// ==== BLOCK T-K8-report-smoke: report layer: selection default, P-card rows, chips, period pill, C4 question, freshness, step day, alert scoping, movers, funnel, SVG faces, 0 measures in error (37 rows)
EVALUATE
VAR _rows         =
    UNION (
        CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "selected campaign = worst mover", "expected", 1, "actual", 1.0 * ( IF ( [_Selected Campaign] = "SOC_META_LAL2", 1, 0 ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
