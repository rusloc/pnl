            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "J1 store rows show a dash", "expected", 1, "actual", 1.0 * ( CALCULATE ( IF ( [J1 Bounce] = 0 && [J1 LCP] = 0, 1, 0 ), dim_landing_page[page_key] = "LP_APP_STORE" ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "Journey / Cohorts captions non-blank", "expected", 9, "actual", 1.0 * ( INT ( LEN ( [J1 Caption] ) > 0 ) + INT ( LEN ( [J2 Caption] ) > 0 ) + INT ( LEN ( [J3 Caption] ) > 0 ) + INT ( LEN ( [J4 Caption] ) > 0 ) + INT ( LEN ( [K1 Caption] ) > 0 ) + INT ( LEN ( [K2 Caption] ) > 0 ) + INT ( LEN ( [K3 Caption] ) > 0 ) + INT ( LEN ( [K4 Caption] ) > 0 ) + INT ( LEN ( [K5 Caption] ) > 0 ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "funnel 7 stages", "expected", 7, "actual", 1.0 * ( COUNTROWS ( FILTER ( VALUES ( dim_funnel_stage[stage_code] ), NOT ISBLANK ( [Funnel Log] ) ) ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "funnel paid label", "expected", 1, "actual", 1.0 * ( IF ( CALCULATE ( LEFT ( [Funnel Label], 3 ), dim_funnel_stage[stage_code] = "PAID" ) = "457", 1, 0 ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "vitals SVG non-blank", "expected", 6, "actual", 1.0 * ( INT ( NOT ISBLANK ( [Vital V1 SVG] ) ) + INT ( NOT ISBLANK ( [Vital V2 SVG] ) ) + INT ( NOT ISBLANK ( [Vital V3 SVG] ) ) + INT ( NOT ISBLANK ( [Vital V4 SVG] ) ) + INT ( NOT ISBLANK ( [Vital V5 SVG] ) ) + INT ( NOT ISBLANK ( [Vital V6 SVG] ) ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "guardrails / header / applied SVG non-blank", "expected", 5, "actual", 1.0 * ( INT ( NOT ISBLANK ( [O2 Guardrails SVG] ) ) + INT ( NOT ISBLANK ( [Header Period SVG] ) ) + INT ( NOT ISBLANK ( [Header Filters SVG] ) ) + INT ( NOT ISBLANK ( [Header Freshness SVG] ) ) + INT ( NOT ISBLANK ( [Filters Applied SVG] ) ) ) )
            ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        )
        ,CALCULATETABLE (
            ROW ( "scope", "REPORT", "period", "R30-2026-11-03", "metric", "measures in an error state", "expected", 0, "actual", 1.0 * ( COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) ) + 0 ) )
        )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"scope", [scope]
        ,"period", [period]
        ,"metric", [metric]
        ,"expected", [expected]
        ,"actual", [actual]
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.000001 + ABS ( [expected] ) * 0.0000001
    )
ORDER BY
    [_pass]
    ,[scope]
    ,[metric]
