	/// 0 = 2025-01 (from dim_month).
	column month_index
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f6c04e4a-6c9b-567d-89c7-5b41eb0b16ae
		summarizeBy: none
		sourceColumn: month_index

		annotation SummarizationSetBy = User

	/// First day of the month (Month granularity).
	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ba80d74a-1e58-592d-84c3-ae8032de721e
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	partition dim_date = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_date.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"date", type date},
				            {"month_key", type text},
				            {"year", Int64.Type},
				            {"quarter", Int64.Type},
				            {"month_num", Int64.Type},
				            {"month_name", type text},
				            {"day_of_month", Int64.Type},
				            {"iso_week", Int64.Type},
				            {"week_start", type date},
				            {"weekday_num", Int64.Type},
				            {"weekday_name", type text},
				            {"is_weekend", type logical},
				            {"is_actual", type logical},
				            {"ly_date", type date}
				        }
				    ),
				    dm_src = Table.TransformColumnTypes(Table.SelectColumns(Parquet.Document(File.Contents(DataFolder & "\dim_month.parquet")), {"month_key", "month_index", "month_start"}), {{"month_key", type text}, {"month_index", Int64.Type}, {"month_start", type date}}),
				    dm_joined = Table.NestedJoin(typed, {"month_key"}, dm_src, {"month_key"}, "j", JoinKind.LeftOuter),
				    dm_expanded = Table.ExpandTableColumn(dm_joined, "j", {"month_index", "month_start"})
				in
				    dm_expanded

	annotation PBI_ResultType = Table

