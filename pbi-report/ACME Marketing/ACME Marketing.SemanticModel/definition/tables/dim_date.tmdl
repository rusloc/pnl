		lineageTag: 33c7b065-9775-5f4d-98ca-c47e8ae82fc0
		summarizeBy: none
		sourceColumn: month_num

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		lineageTag: e004ad20-a1cd-5c9a-8499-3487dda84e91
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

		annotation SummarizationSetBy = User

	column day_of_month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c6e73771-6e2a-5f74-bb7e-26bd34767ca7
		summarizeBy: none
		sourceColumn: day_of_month

		annotation SummarizationSetBy = User

	column iso_week
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2351f29e-c088-50f9-ae09-c874e67aa178
