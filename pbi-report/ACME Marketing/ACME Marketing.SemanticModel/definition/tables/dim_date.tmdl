		formatString: 0
		lineageTag: 9c6aa436-3acd-5cf7-b0af-465500ca3455
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 25431579-d24f-5351-ae8a-202fb03df69f
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = User

	column month_num
		dataType: int64
		isHidden
