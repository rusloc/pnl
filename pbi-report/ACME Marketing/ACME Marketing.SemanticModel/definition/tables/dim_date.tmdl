/// Calendar day 2025-01-01 .. 2026-12-31 (730 rows). Derived on load: month_index and month_start from dim_month (window and granularity helpers).
table dim_date
	lineageTag: 777cdfa3-bb1d-5942-b80d-913dbec99179

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: f6006b20-9987-58ef-83ec-231a97ac37e3
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column month_key
		dataType: string
		isHidden
		lineageTag: 5d1e1ff7-ab9c-586d-be65-f646570d3e54
		summarizeBy: none
		sourceColumn: month_key

		annotation SummarizationSetBy = User

	column year
