/// Calendar month 2025-01 .. 2026-12 (24 rows); budget, cohort and pipeline facts join here.
table dim_month
	lineageTag: 9461fc74-008e-547a-972d-f6f41125ab3d

	column month_key
		dataType: string
		isHidden
		lineageTag: 5558ccde-406d-5093-909c-e1a4ea865b97
		summarizeBy: none
		sourceColumn: month_key

		annotation SummarizationSetBy = User

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ddd58426-be2e-5c33-b997-ad84018027a7
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column month_index
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5e7b926b-f385-5ab2-9941-9b98d40696a8
		summarizeBy: none
		sourceColumn: month_index

		annotation SummarizationSetBy = User

	column year
		dataType: int64
		formatString: 0
		lineageTag: 979af1f4-e786-564a-ac0a-b658152d4383
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		lineageTag: f15090a9-fd76-573c-b06f-115eadbe78e1
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_index

		annotation SummarizationSetBy = User

	column days_in_month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 44e96731-4206-5fc7-93bb-855efa16eaf6
		summarizeBy: none
		sourceColumn: days_in_month

		annotation SummarizationSetBy = User

	column is_actual
		dataType: boolean
		isHidden
		lineageTag: b5540da1-9e0a-5056-ac14-0bf51646163b
		summarizeBy: none
		sourceColumn: is_actual

		annotation SummarizationSetBy = User

	column is_complete
		dataType: boolean
		isHidden
		lineageTag: 73ff5ddc-6511-5308-b4b6-55e3af590f56
		summarizeBy: none
		sourceColumn: is_complete

		annotation SummarizationSetBy = User

	partition dim_month = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_month.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"month_key", type text},
				            {"month_start", type date},
				            {"month_index", Int64.Type},
				            {"year", Int64.Type},
				            {"month_name", type text},
				            {"days_in_month", Int64.Type},
				            {"is_actual", type logical},
				            {"is_complete", type logical}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

