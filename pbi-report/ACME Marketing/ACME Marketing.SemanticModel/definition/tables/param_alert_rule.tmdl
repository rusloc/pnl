	partition param_alert_rule = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\param_alert_rule.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"rule_code", type text},
				            {"severity", type text},
				            {"title", type text},
				            {"scope_type", type text},
				            {"metric_code", type text},
				            {"condition", type text},
				            {"sort_order", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

