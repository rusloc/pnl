          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Cohorts use DDA credits and the scope's campaigns; the window picks which acquisition months show (up to its end month), its start does not.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Payback curves: cumulative gross margin per cohort against its CAC; a line crossing 100 % has paid back. Pick Meta prospecting · Lookalike 2% under Filters › Campaigns (or click it in the Campaigns table) to see its Oct 2025 and Dec 2025 cohorts cross at month 9.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Retention grid: share of the cohort active on day N; blank where the day has not been reached yet. The table lists the 12 acquisition months to the window end.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              }
            ]
