        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Cohorts use DDA credits and the scope's campaigns; the window picks which acquisition months show (up to its end month), its start does not.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Payback heatmap: one row per acquisition month (the 12 before the window's end month), one column per month since acquisition; the cell is the cumulative payback of the cohort's CAC, darker = closer, green = paid back. Pick Meta prospecting · Lookalike 2% under Filters › Campaigns (or click it in the Campaigns table) to see its Nov 2025 – Jan 2026 rows turn green at month 9.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Retention grid: share of the cohort active on day N; blank where the day has not been reached yet. Right: LTV:CAC and payback months by channel against their lines (3:1, 12 months), and the size of each of the last 12 acquisition months.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
