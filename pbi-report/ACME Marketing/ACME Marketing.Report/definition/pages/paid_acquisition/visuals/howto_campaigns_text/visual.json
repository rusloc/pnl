              {
                "textRuns": [
                  {
                    "value": "The table lists Live and Learning campaigns by spend (pick Paused or Ended under Filters › Campaigns to add them). Click a row to select it: Keywords / placements follows the selection, Churn and Refund by channel scope to its channel.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Without a click Keywords / placements shows the worst mover of the window (largest drop in 90-day ROAS): keywords for search, placements for the others.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Churn by channel: customers lost in the trailing 3 complete months; Refund by channel: refunds of the 12 acquisition months to the window end. Top 5 channels each, absolute counts (DDA credits).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
