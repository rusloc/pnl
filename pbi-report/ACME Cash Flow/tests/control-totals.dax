// ==== BLOCK T-06-M-2026-10: statement matrix query M-2026-10: every visible row's value; no extra rows (zero accounts hidden)
EVALUATE
VAR _exp          =
    DATATABLE (
        "row_key", STRING
        ,"expected", DOUBLE
        ,{
            { "NI", -662.970000 }
            ,{ "TOT-ADJ", -18117.940000 }
            ,{ "SECT-OP", -18780.910000 }
            ,{ "SECT-INV", 0.000000 }
            ,{ "SECT-FIN", -17321.950000 }
            ,{ "ACC-4", -22826.920000 }
            ,{ "ACC-6", 1010.000000 }
            ,{ "ACC-9", 1968.890000 }
            ,{ "ACC-12", 691.670000 }
            ,{ "ACC-14", -6415.100000 }
            ,{ "ACC-15", -22.700000 }
            ,{ "ACC-17", 7639.610000 }
            ,{ "ACC-18", 1486.210000 }
            ,{ "ACC-19", -1649.600000 }
            ,{ "ACC-20", 35000.000000 }
            ,{ "ACC-22", -1496.370000 }
            ,{ "ACC-23", -825.580000 }
            ,{ "ACC-27", -50000.000000 }
        }
    )
VAR _act          =
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            dim_stmt_row[section_label]
            ,dim_stmt_row[row_label]
            ,dim_stmt_row[row_key]
            ,"@v", [Stmt Value]
        )
        ,TREATAS ( { "M-2026-10" }, param_period[period_key] )
    )
VAR _n            = COUNTROWS ( _act )
RETURN
    UNION (
        SELECTCOLUMNS (
            _exp
            ,"row_key", [row_key]
            ,"expected", [expected]
            ,"actual",
                VAR _k = [row_key]
                RETURN
                    MAXX ( FILTER ( _act, dim_stmt_row[row_key] = _k ), [@v] )
            ,"_pass",
                VAR _k = [row_key]
                VAR _a = MAXX ( FILTER ( _act, dim_stmt_row[row_key] = _k ), [@v] )
                RETURN
                    NOT ISBLANK ( _a ) && ABS ( _a - [expected] ) <= 0.005
        )
        ,ROW ( "row_key", "row count", "expected", 18, "actual", _n, "_pass", _n = 18 )
    )

