    )
VAR _act          =
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            fact_cash_posting[txn_id]
            ,fact_cash_posting[direct_line_code]
            ,fact_cash_posting[counterparty_id]
            ,fact_cash_posting[direction]
            ,fact_cash_posting[ledger_memo]
            ,"@v", [Ledger Value]
        )
        ,TREATAS ( { "M-2026-02" }, param_period[period_key] )
    )
VAR _n            = COUNTROWS ( _act )
RETURN
    UNION (
        SELECTCOLUMNS (
            _exp
            ,"txn_id", [txn_id]
            ,"memo", [memo]
            ,"expected", [expected]
            ,"_pass",
                VAR _t = [txn_id]
                VAR _l = [line_code]
                VAR _c = [cp]
                VAR _d = [dir]
                VAR _m = [memo]
                VAR _hit = FILTER ( _act, fact_cash_posting[txn_id] = _t && fact_cash_posting[direct_line_code] = _l && fact_cash_posting[counterparty_id] = _c && fact_cash_posting[direction] = _d )
                RETURN
                    COUNTROWS ( _hit ) = 1 && MAXX ( _hit, fact_cash_posting[ledger_memo] ) = _m && ABS ( MAXX ( _hit, [@v] ) - [expected] ) <= 0.005
        )
        ,ROW ( "txn_id", -1, "memo", "row count", "expected", 80, "_pass", _n = 80 )
    )

// ==== BLOCK T-11: Reconciliation page: all 12 check rows and all 16 direct lines tie for every month and year (the page's own ✓ logic)
EVALUATE
VAR _exp          =
    DATATABLE (
        "period_key", STRING
        ,{
            { "M-2024-01" }
            ,{ "M-2024-02" }
            ,{ "M-2024-03" }
            ,{ "M-2024-04" }
            ,{ "M-2024-05" }
            ,{ "M-2024-06" }
            ,{ "M-2024-07" }
            ,{ "M-2024-08" }
            ,{ "M-2024-09" }
            ,{ "M-2024-10" }
            ,{ "M-2024-11" }
            ,{ "M-2024-12" }
            ,{ "M-2025-01" }
            ,{ "M-2025-02" }
            ,{ "M-2025-03" }
            ,{ "M-2025-04" }
            ,{ "M-2025-05" }
            ,{ "M-2025-06" }
            ,{ "M-2025-07" }
            ,{ "M-2025-08" }
            ,{ "M-2025-09" }
            ,{ "M-2025-10" }
            ,{ "M-2025-11" }
            ,{ "M-2025-12" }
            ,{ "M-2026-01" }
            ,{ "M-2026-02" }
            ,{ "M-2026-03" }
            ,{ "M-2026-04" }
            ,{ "M-2026-05" }
            ,{ "M-2026-06" }
            ,{ "M-2026-07" }
            ,{ "M-2026-08" }
            ,{ "M-2026-09" }
            ,{ "M-2026-10" }
            ,{ "A-2024" }
            ,{ "A-2025" }
            ,{ "YTD" }
        }
    )
RETURN
    ADDCOLUMNS (
        _exp
        ,"@checks", CALCULATE ( SUMX ( VALUES ( dim_recon_check[check_code] ), [Recon OK] ), TREATAS ( { [period_key] }, param_period[period_key] ) )
        ,"@lines", CALCULATE ( SUMX ( CALCULATETABLE ( VALUES ( dim_cf_line[line_code] ), dim_cf_line[view] = "DIRECT", dim_cf_line[line_kind] = "data" ), [Line OK] ), TREATAS ( { [period_key] }, param_period[period_key] ) )
        ,"_pass", CALCULATE ( SUMX ( VALUES ( dim_recon_check[check_code] ), [Recon OK] ), TREATAS ( { [period_key] }, param_period[period_key] ) )
            = CALCULATE ( COUNTROWS ( FILTER ( VALUES ( dim_recon_check[check_code] ), NOT ISBLANK ( [Recon OK] ) ) ), TREATAS ( { [period_key] }, param_period[period_key] ) )
            && CALCULATE ( SUMX ( CALCULATETABLE ( VALUES ( dim_cf_line[line_code] ), dim_cf_line[view] = "DIRECT", dim_cf_line[line_kind] = "data" ), [Line OK] ), TREATAS ( { [period_key] }, param_period[period_key] ) ) = 16
    )

// ==== BLOCK T-12: smoke: 0 measures in an error state (INFO.MEASURES State <> 1); every SVG / text face evaluates for the default period
EVALUATE
UNION (
    ROW ( "item", "measures in error", "_pass", COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) ) + 0 = 0 )
    ,ROW ( "item", "KPI Card close", "_pass", LEN ( [KPI Card close] ) > 20 )
    ,ROW ( "item", "KPI Card net", "_pass", LEN ( [KPI Card net] ) > 20 )
    ,ROW ( "item", "KPI Card cfo", "_pass", LEN ( [KPI Card cfo] ) > 20 )
    ,ROW ( "item", "KPI Card fcf", "_pass", LEN ( [KPI Card fcf] ) > 20 )
    ,ROW ( "item", "KPI Card conv", "_pass", LEN ( [KPI Card conv] ) > 20 )
    ,ROW ( "item", "KPI Card dso", "_pass", LEN ( [KPI Card dso] ) > 20 )
    ,ROW ( "item", "Header Context", "_pass", LEN ( [Header Context] ) > 20 )
    ,ROW ( "item", "Stmt Axis SVG", "_pass", LEN ( [Stmt Axis SVG] ) > 20 )
    ,ROW ( "item", "Cash Card Balance", "_pass", LEN ( [Cash Card Balance] ) > 20 )
    ,ROW ( "item", "Cash Card Operating", "_pass", LEN ( [Cash Card Operating] ) > 20 )
    ,ROW ( "item", "Cash Card Investing", "_pass", LEN ( [Cash Card Investing] ) > 20 )
    ,ROW ( "item", "Cash Card Financing", "_pass", LEN ( [Cash Card Financing] ) > 20 )
    ,ROW ( "item", "Heat Totals Operating", "_pass", LEN ( [Heat Totals Operating] ) > 20 )
    ,ROW ( "item", "Heat Totals Investing", "_pass", LEN ( [Heat Totals Investing] ) > 20 )
    ,ROW ( "item", "Heat Totals Financing", "_pass", LEN ( [Heat Totals Financing] ) > 20 )
    ,ROW ( "item", "Diagram KPI SVG", "_pass", LEN ( [Diagram KPI SVG] ) > 20 )
    ,ROW ( "item", "Ledger Trio SVG", "_pass", LEN ( [Ledger Trio SVG] ) > 20 )
    ,ROW ( "item", "Recon Header", "_pass", LEN ( [Recon Header] ) > 20 )
)

