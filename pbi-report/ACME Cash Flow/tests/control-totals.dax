VAR _act          =
    ADDCOLUMNS (
        _exp
        ,"actual",
            VAR _pk = [period_key]
            VAR _k = [metric] & "|" & [scope]
            RETURN
                CALCULATE (
                    SWITCH (
                        _k
                        ,"M01|ALL", [Opening Cash]
                            ,"M02|ALL", [Closing Cash]
                            ,"M03|ALL", [Net Change in Cash]
                            ,"M04|ALL", [Net Income]
                            ,"REVENUE|ALL", [Revenue]
                            ,"M06|OVERRIDES_ON", [Operating Cash Flow]
                            ,"M07|OVERRIDES_ON", [Investing Cash Flow]
                            ,"M08|OVERRIDES_ON", [Financing Cash Flow]
                            ,"M09|ALL", [Cash In]
                            ,"M10|ALL", [Cash Out]
                            ,"M11|ALL", [Net Cash Direct]
                            ,"M12|ALL", [Internal Transfers]
                            ,"M15|ALL", [Free Cash Flow]
                            ,"M16|ALL", [Cash Conversion]
                            ,"M17|ALL", [Operating Cash Margin]
                    )
                    ,TREATAS ( { _pk }, param_period[period_key] )
                )
    )
RETURN
    ADDCOLUMNS (
        _act
        ,"_pass", NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= IF ( [metric] IN { "M16", "M17" }, 0.000001 * MAX ( 1, ABS ( [expected] ) ), 0.005 )
    )

