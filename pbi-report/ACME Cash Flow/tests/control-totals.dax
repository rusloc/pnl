        }
    )
VAR _act          =
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            dim_cf_line[line_name]
            ,dim_cf_line[line_code]
            ,dim_date[date]
            ,"@b", [Heat Cell Block]
        )
        ,TREATAS ( { "Q3-2026" }, param_period[period_key] )
        ,dim_cf_line[section_code] = "INVESTING"
        ,dim_cf_line[view] = "DIRECT"
        ,dim_cf_line[line_kind] = "data"
    )
VAR _n            = COUNTROWS ( _act )
RETURN
    UNION (
        SELECTCOLUMNS (
            _exp
            ,"line_code", [line_code]
            ,"day", [day]
            ,"expected", [expected]
            ,"_pass",
                VAR _lc = [line_code]
                VAR _d = [day]
                VAR _a = MAXX ( FILTER ( _act, dim_cf_line[line_code] = _lc && dim_date[date] = _d ), [@b] )
                RETURN
                    NOT ISBLANK ( _a ) && _a = [expected]
        )
        ,ROW ( "line_code", "cell count", "day", BLANK (), "expected", 368, "_pass", _n = 368 )
    )

