// ==== BLOCK T-07: calendar pickers (span, year, month, quarter) resolve to the mock's period, window and labels; Nov 2026 = no data
EVALUATE
VAR _exp          =
    DATATABLE (
        "span", STRING
        ,"year", INTEGER
        ,"month", INTEGER
        ,"quarter", INTEGER
        ,"key", STRING
        ,"a", INTEGER
        ,"b", INTEGER
        ,"label", STRING
        ,"prior_label", STRING
        ,{
            { "M", 2026, 10, 4, "M-2026-10", 33, 33, "Oct 2026", "Sep 2026" }
            ,{ "M", 2024, 1, 4, "M-2024-01", 0, 0, "Jan 2024", "" }
            ,{ "Q", 2026, 10, 3, "Q3-2026", 30, 32, "Q3 2026", "Q2 2026" }
            ,{ "Q", 2026, 10, 4, "Q4-2026", 33, 33, "Q4 2026", "Q3 2026" }
            ,{ "A", 2025, 10, 4, "A-2025", 12, 23, "2025", "2024" }
            ,{ "A", 2026, 10, 4, "A-2026", 24, 33, "2026", "Jan–Oct 2025" }
            ,{ "YTD", 2024, 3, 1, "YTD", 24, 33, "YTD Oct 2026", "YTD 2025" }
            ,{ "QTD", 2024, 3, 1, "QTD", 33, 33, "Q4 2026", "Q3 2026" }
            ,{ "MTD", 2024, 3, 1, "MTD", 33, 33, "Oct 2026", "Sep 2026" }
            ,{ "M", 2026, 11, 4, "M-2026-11", -1, -1, "", "" }
        }
    )
RETURN
    ADDCOLUMNS (
        ADDCOLUMNS (
            _exp
            ,"@key", CALCULATE ( [_Period Key], TREATAS ( { [span] }, param_span[span_code] ), TREATAS ( { [year] }, param_year[year] ), TREATAS ( { [month] }, param_month[month_num] ), TREATAS ( { [quarter] }, param_quarter[quarter_num] ) )
            ,"@a", CALCULATE ( [_A], TREATAS ( { [span] }, param_span[span_code] ), TREATAS ( { [year] }, param_year[year] ), TREATAS ( { [month] }, param_month[month_num] ), TREATAS ( { [quarter] }, param_quarter[quarter_num] ) )
            ,"@b", CALCULATE ( [_B], TREATAS ( { [span] }, param_span[span_code] ), TREATAS ( { [year] }, param_year[year] ), TREATAS ( { [month] }, param_month[month_num] ), TREATAS ( { [quarter] }, param_quarter[quarter_num] ) )
            ,"@label", CALCULATE ( [_Period Label], TREATAS ( { [span] }, param_span[span_code] ), TREATAS ( { [year] }, param_year[year] ), TREATAS ( { [month] }, param_month[month_num] ), TREATAS ( { [quarter] }, param_quarter[quarter_num] ) )
            ,"@prior", CALCULATE ( [_Prior Label], TREATAS ( { [span] }, param_span[span_code] ), TREATAS ( { [year] }, param_year[year] ), TREATAS ( { [month] }, param_month[month_num] ), TREATAS ( { [quarter] }, param_quarter[quarter_num] ) )
        )
        ,"_pass",
            [@key] = [key]
                && IF ( [a] < 0, ISBLANK ( [@a] ) && ISBLANK ( [@b] ), [@a] = [a] && [@b] = [b] )
                && COALESCE ( [@label], "" ) = [label]
                && COALESCE ( [@prior], "" ) = [prior_label]
    )

