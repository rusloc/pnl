        ADDCOLUMNS (
            _exp
            ,"actual",
                VAR _pk = [period_key]
                VAR _lc = [line_code]
                RETURN
                    CALCULATE (
                        [Direct Net]
                        ,TREATAS ( { _pk }, param_period[period_key] )
                        ,dim_cf_line[line_code] = _lc
                    )
        )
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.005
    )

