    ADDCOLUMNS (
        ADDCOLUMNS (
            _exp
            ,"actual",
                VAR _pk = [period_key]
                VAR _n = [node]
                RETURN
                    IF (
                        _n = "ROOT"
                        ,CALCULATE ( [Decomp Net Cash USD], TREATAS ( { _pk }, param_period[period_key] ) )
                        ,CALCULATE ( [Decomp Net Cash USD], TREATAS ( { _pk }, param_period[period_key] ), dim_cf_line[activity] = MID ( _n, 1, 1 ) & LOWER ( MID ( _n, 2, 20 ) ) )
                    ) + 0
        )
        ,"_pass", ABS ( [actual] - [expected] ) <= 0.005
    )
