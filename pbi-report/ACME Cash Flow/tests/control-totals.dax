RETURN
    ADDCOLUMNS (
        ADDCOLUMNS (
            _exp
            ,"@ro", CALCULATE ( [Bal Bar Ratio], TREATAS ( { [period_key] }, param_period[period_key] ), dim_bal_row[row_code] = "OPEN" )
            ,"@rc", CALCULATE ( [Bal Bar Ratio], TREATAS ( { [period_key] }, param_period[period_key] ), dim_bal_row[row_code] = "CLOSE" )
        )
        ,"_pass",
            ABS ( MAX ( [@ro], [@rc] ) - 1 ) < 0.000001
                && ABS ( DIVIDE ( [@rc], [@ro] ) - DIVIDE ( [close], [open] ) ) < 0.000001
    )

