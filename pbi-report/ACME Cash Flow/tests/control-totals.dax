    ADDCOLUMNS (
        ADDCOLUMNS (
            _exp
            ,"actual",
                VAR _pk = [period_key]
                VAR _m = [measure]
                RETURN
                    CALCULATE (
                        SWITCH (
                            _m
                            ,"Closing Cash", [Closing Cash]
                            ,"Net Change in Cash", [Net Change in Cash]
                            ,"Operating Cash Flow", [Operating Cash Flow]
                            ,"Free Cash Flow", [Free Cash Flow]
                            ,"KPI Cash Conversion", [KPI Cash Conversion]
                            ,"DSO Days", [DSO Days]
                            ,"DPO Days", [DPO Days]
                            ,"Cash Conversion Cycle", [Cash Conversion Cycle]
                            ,"Operating Cash Margin", [Operating Cash Margin]
                            ,"Accruals", [Accruals]
                            ,"Capex", [Capex]
                            ,"Capex Intensity", [Capex Intensity]
                            ,"Capex Coverage", [Capex Coverage]
                            ,"Debt Service", [Debt Service]
                            ,"DSCR", [DSCR]
                            ,"EBITDA", [EBITDA]
                            ,"EBITDA Annualised", [EBITDA Annualised]
                            ,"Net Debt", [Net Debt]
                            ,"Net Debt to EBITDA", [Net Debt to EBITDA]
                            ,"Owner Draws", [Owner Draws]
                            ,"Payout Cover", [Payout Cover]
                        )
                        ,TREATAS ( { _pk }, param_period[period_key] )
                    )
        )
        ,"_pass",
            IF (
                [is_nm]
                ,ISBLANK ( [actual] )
                ,NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= IF ( [measure] IN { "Capex Coverage", "Capex Intensity", "Cash Conversion Cycle", "DPO Days", "DSCR", "DSO Days", "KPI Cash Conversion", "Net Debt to EBITDA", "Operating Cash Margin", "Payout Cover" }, 0.000001 * MAX ( 1, ABS ( [expected] ) ), 0.005 )
            )
    )

