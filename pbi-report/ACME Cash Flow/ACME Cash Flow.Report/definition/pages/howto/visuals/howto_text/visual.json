  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "PATH",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "8.5pt",
                      "color": "#525C70"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1  Statement — sections, bars, % of net income. 2  Activities — days × lines. 3  Transactions — the ledger.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Click a section's ▸ / ▾ to collapse or expand its lines. Activities opens from the path, the menu, the cash pop-up or the Diagram; select a heatmap line or day and use “Transactions of the selection” (or right-click → Drill through). Back returns.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "On Closing cash, the orange button shows the cash balance and the three activities. The menu holds the Diagram (the period's cash KPIs as a tree) and Reconciliation (every figure tied to the control totals). The top-left square picks the period (Year / Quarter / Month, YTD / QTD / MTD) and the units.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MARKS",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "8.5pt",
                      "color": "#525C70"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(12,480) = cash out; cash in has no sign; – is zero.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Grey bar = statement line, bar length = absolute amount on one axis. Dark bar = balance (opening, closing); a notch = longer than the axis.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cash pop-up: dark = in, grey = out, orange = net; opening and closing in orange.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "S01 = line of credit moved to financing by the override.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Heatmap: five blocks, 20 % of the days each; orange = the top 20 %. Totals squares use the same five colours.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Clr: R reconciled, C cleared, plain disc uncleared, dot = Undeposited Funds.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Orange = accent: current step, buttons, selection; never good or bad.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2C3A54"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
