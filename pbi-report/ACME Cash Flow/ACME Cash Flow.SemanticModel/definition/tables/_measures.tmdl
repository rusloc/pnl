	/// Sub-title under ACME Cash Flow: company, window dates, units, as-of day.
	measure 'Header Context' =
			VAR _d0           = [_D0]
			VAR _d1           = [_D1]
			VAR _unit         = IF ( [_Is K], "USD thousands", "USD" )
			RETURN
			    IF (
			        ISBLANK ( _d0 )
			        ,"ACME Advisory Services LLC · no data for this period · " & _unit
			        ,"ACME Advisory Services LLC · " & FORMAT ( _d0, "d mmm" ) & " – " & FORMAT ( _d1, "d mmm yyyy" ) & " · " & _unit & " · as of 5 Nov 2026"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: 829db5e0-c8fe-5f02-9df8-38c36ac7a470

	/// Statement column header: the period label (· to date when cut by the data end).
	measure 'Stmt Header Period' =
			VAR _l            = [_Period Label]
			RETURN
			    IF ( ISBLANK ( _l ), "No data", _l & IF ( [_Partial] = 1, " · to date" ) )
		isHidden
		displayFolder: 8 Report
		lineageTag: aa000b54-806f-5a96-bcf6-f7879d695dbc

	/// Amount column header.
	measure 'Units Label' = IF ( [_Is K], "USD k", "USD" )
		isHidden
		displayFolder: 8 Report
		lineageTag: 368deebf-509d-5cbe-a46c-f807df75feb5

	/// Tick labels over the bar column (0, 25 / 50 / 75 / 100 % of the axis).
	measure 'Stmt Axis SVG' =
			VAR _max          = [_Stmt Axis Max]
			VAR _k            = [_Is K]
			VAR _ticks        =
			    CONCATENATEX (
			        { 0, 0.25, 0.5, 0.75, 1 }
			        ,VAR _f = [Value]
			        VAR _x = _max * _f
			        VAR _s = IF ( _k, FORMAT ( _x / 1000, "#,0.0" ) & "k", FORMAT ( _x, "#,0" ) )
			        RETURN
			            "<text x='" & FORMAT ( 20 + 566 * _f, "0.0" ) & "' y='20' text-anchor='" & IF ( _f = 0, "start", IF ( _f = 1, "end", "middle" ) ) & "'>"
			                & IF ( _f = 0, "0", _s ) & "</text>"
			        ,""
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='602' height='28' viewBox='0 0 602 28' font-family='Segoe UI, sans-serif' font-size='10.5' fill='%235B6577'>" & _ticks & "</svg>"
		isHidden
		displayFolder: 8 Report
		lineageTag: a36ccb2d-a4a7-5b93-9f2c-05439e0cf583
		dataCategory: ImageUrl

