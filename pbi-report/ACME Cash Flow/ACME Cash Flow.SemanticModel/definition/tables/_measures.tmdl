	/// Cash pop-up, Cash balance card: opening + in + out = closing (bars on one axis; opening / closing orange, USER round 12).
	measure 'Cash Card Balance' =
			VAR _open         = [Opening Cash]
			VAR _in           = [Cash In]
			VAR _out          = [Cash Out]
			VAR _close        = [Closing Cash]
			VAR _max          = MAX ( MAX ( MAX ( _open, _close ), MAX ( _in, 0 - _out ) ), 1 )
			VAR _open_s = IF ( [_Is K], FORMAT ( ABS ( _open ) / 1000, "#,0.0" ), FORMAT ( ABS ( _open ), "#,0" ) )
			VAR _open_t = _open_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _open_m = IF ( ISBLANK ( _open ) || _open_s IN { "0", "0.0", "0.00" }, "–", IF ( _open < 0, "(" & _open_t & ")", _open_t ) )
			VAR _in_s = IF ( [_Is K], FORMAT ( ABS ( _in ) / 1000, "#,0.0" ), FORMAT ( ABS ( _in ), "#,0" ) )
			VAR _in_t = _in_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _in_m = IF ( ISBLANK ( _in ) || _in_s IN { "0", "0.0", "0.00" }, "–", IF ( _in < 0, "(" & _in_t & ")", _in_t ) )
			VAR _out_s = IF ( [_Is K], FORMAT ( ABS ( _out ) / 1000, "#,0.0" ), FORMAT ( ABS ( _out ), "#,0" ) )
			VAR _out_t = _out_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _out_m = IF ( ISBLANK ( _out ) || _out_s IN { "0", "0.0", "0.00" }, "–", IF ( _out < 0, "(" & _out_t & ")", _out_t ) )
			VAR _close_s = IF ( [_Is K], FORMAT ( ABS ( _close ) / 1000, "#,0.0" ), FORMAT ( ABS ( _close ), "#,0" ) )
			VAR _close_t = _close_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _close_m = IF ( ISBLANK ( _close ) || _close_s IN { "0", "0.0", "0.00" }, "–", IF ( _close < 0, "(" & _close_t & ")", _close_t ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _open )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='160' viewBox='0 0 320 160' font-family='Segoe UI, sans-serif'>"
			            & "<rect x='0.5' y='0.5' width='319' height='159' rx='14' fill='%23E8E5DF' stroke='%23D9D7D4'/>"
			            & "<text x='16' y='28' font-size='15' font-weight='600' fill='%232C3A54'>Cash balance</text>"
			            & "<text x='304' y='28' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _close_m & "</text>"
			            & "<text x='16' y='56' font-size='12' fill='%23525C70'>Opening</text>"
			            & IF ( ABS ( _open ) >= 0.005, "<rect x='78' y='46' width='" & FORMAT ( ABS ( _open ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%23FF6F1A'/>" )
			            & "<text x='304' y='56' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _open_m & "</text>"
			            & "<text x='16' y='82' font-size='12' fill='%23525C70'>In</text>"
			            & IF ( ABS ( _in ) >= 0.005, "<rect x='78' y='72' width='" & FORMAT ( ABS ( _in ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%232C3A54'/>" )
			            & "<text x='304' y='82' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _in_m & "</text>"
			            & "<text x='16' y='108' font-size='12' fill='%23525C70'>Out</text>"
			            & IF ( ABS ( _out ) >= 0.005, "<rect x='78' y='98' width='" & FORMAT ( ABS ( _out ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%237B828E'/>" )
			            & "<text x='304' y='108' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _out_m & "</text>"
			            & "<text x='16' y='134' font-size='12' fill='%23525C70'>Closing</text>"
			            & IF ( ABS ( _close ) >= 0.005, "<rect x='78' y='124' width='" & FORMAT ( ABS ( _close ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%23FF6F1A'/>" )
			            & "<text x='304' y='134' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _close_m & "</text>"
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: f4a8a331-182e-509c-a585-cd3166e7658a
		dataCategory: ImageUrl

	/// Cash pop-up, Operating card: cash in, cash out, net of the direct lines; the statement's non-cash gap under it; click opens Operating activities.
	measure 'Cash Card Operating' =
			VAR _a            = [_A]
			VAR _in           = CALCULATE ( [Direct In], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "OPERATING" )
			VAR _out          = CALCULATE ( [Direct Out], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "OPERATING" )
			VAR _net          = _in + _out
			VAR _gap          = CALCULATE ( [Non-Cash Gap], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "OPERATING" )
			VAR _max          =
			    MAX (
			        MAXX (
			            CALCULATETABLE ( VALUES ( dim_cf_line[section_code] ), REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] IN { "OPERATING", "INVESTING", "FINANCING" } )
			            ,MAX ( [Direct In], 0 - [Direct Out] )
			        )
			        ,1
			    )
			VAR _in_s = IF ( [_Is K], FORMAT ( ABS ( _in ) / 1000, "#,0.0" ), FORMAT ( ABS ( _in ), "#,0" ) )
			VAR _in_t = _in_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _in_m = IF ( ISBLANK ( _in ) || _in_s IN { "0", "0.0", "0.00" }, "–", IF ( _in < 0, "(" & _in_t & ")", _in_t ) )
			VAR _out_s = IF ( [_Is K], FORMAT ( ABS ( _out ) / 1000, "#,0.0" ), FORMAT ( ABS ( _out ), "#,0" ) )
			VAR _out_t = _out_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _out_m = IF ( ISBLANK ( _out ) || _out_s IN { "0", "0.0", "0.00" }, "–", IF ( _out < 0, "(" & _out_t & ")", _out_t ) )
			VAR _net_s = IF ( [_Is K], FORMAT ( ABS ( _net ) / 1000, "#,0.0" ), FORMAT ( ABS ( _net ), "#,0" ) )
			VAR _net_t = _net_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _net_m = IF ( ISBLANK ( _net ) || _net_s IN { "0", "0.0", "0.00" }, "–", IF ( _net < 0, "(" & _net_t & ")", _net_t ) )
			VAR _gap_s = IF ( [_Is K], FORMAT ( ABS ( _gap ) / 1000, "#,0.0" ), FORMAT ( ABS ( _gap ), "#,0" ) )
			VAR _gap_t = _gap_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _gap_m = IF ( ISBLANK ( _gap ) || _gap_s IN { "0", "0.0", "0.00" }, "–", IF ( _gap < 0, "(" & _gap_t & ")", _gap_t ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='160' viewBox='0 0 320 160' font-family='Segoe UI, sans-serif'>"
			            & "<rect x='0.5' y='0.5' width='319' height='159' rx='14' fill='%23E8E5DF' stroke='%23D9D7D4'/>"
			            & "<text x='16' y='28' font-size='15' font-weight='600' fill='%232C3A54'>Operating</text>"
			            & "<text x='286' y='28' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & "<text x='304' y='28' font-size='15' text-anchor='end' fill='%235B6577'>→</text>"
			            & "<text x='16' y='82' font-size='12' fill='%23525C70'>In</text>"
			            & IF ( ABS ( _in ) >= 0.005, "<rect x='78' y='72' width='" & FORMAT ( ABS ( _in ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%232C3A54'/>" )
			            & "<text x='304' y='82' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _in_m & "</text>"
			            & "<text x='16' y='108' font-size='12' fill='%23525C70'>Out</text>"
			            & IF ( ABS ( _out ) >= 0.005, "<rect x='78' y='98' width='" & FORMAT ( ABS ( _out ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%237B828E'/>" )
			            & "<text x='304' y='108' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _out_m & "</text>"
			            & "<text x='16' y='134' font-size='12' fill='%23525C70'>Net</text>"
			            & IF ( ABS ( _net ) >= 0.005, "<rect x='78' y='124' width='" & FORMAT ( ABS ( _net ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%23FF6F1A'/>" )
			            & "<text x='304' y='134' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & IF ( ABS ( _gap ) >= 0.005, "<text x='16' y='152' font-size='11' fill='%23525C70'>statement adds " & _gap_m & " non-cash</text>" )
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: d46aefe1-2654-5386-9e2f-f3a3c6bc7e83
		dataCategory: ImageUrl

	/// Cash pop-up, Investing card: cash in, cash out, net of the direct lines; the statement's non-cash gap under it; click opens Investing activities.
	measure 'Cash Card Investing' =
			VAR _a            = [_A]
			VAR _in           = CALCULATE ( [Direct In], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "INVESTING" )
			VAR _out          = CALCULATE ( [Direct Out], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "INVESTING" )
			VAR _net          = _in + _out
			VAR _gap          = CALCULATE ( [Non-Cash Gap], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "INVESTING" )
			VAR _max          =
			    MAX (
			        MAXX (
			            CALCULATETABLE ( VALUES ( dim_cf_line[section_code] ), REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] IN { "OPERATING", "INVESTING", "FINANCING" } )
			            ,MAX ( [Direct In], 0 - [Direct Out] )
			        )
			        ,1
			    )
			VAR _in_s = IF ( [_Is K], FORMAT ( ABS ( _in ) / 1000, "#,0.0" ), FORMAT ( ABS ( _in ), "#,0" ) )
			VAR _in_t = _in_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _in_m = IF ( ISBLANK ( _in ) || _in_s IN { "0", "0.0", "0.00" }, "–", IF ( _in < 0, "(" & _in_t & ")", _in_t ) )
			VAR _out_s = IF ( [_Is K], FORMAT ( ABS ( _out ) / 1000, "#,0.0" ), FORMAT ( ABS ( _out ), "#,0" ) )
			VAR _out_t = _out_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _out_m = IF ( ISBLANK ( _out ) || _out_s IN { "0", "0.0", "0.00" }, "–", IF ( _out < 0, "(" & _out_t & ")", _out_t ) )
			VAR _net_s = IF ( [_Is K], FORMAT ( ABS ( _net ) / 1000, "#,0.0" ), FORMAT ( ABS ( _net ), "#,0" ) )
			VAR _net_t = _net_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _net_m = IF ( ISBLANK ( _net ) || _net_s IN { "0", "0.0", "0.00" }, "–", IF ( _net < 0, "(" & _net_t & ")", _net_t ) )
			VAR _gap_s = IF ( [_Is K], FORMAT ( ABS ( _gap ) / 1000, "#,0.0" ), FORMAT ( ABS ( _gap ), "#,0" ) )
			VAR _gap_t = _gap_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _gap_m = IF ( ISBLANK ( _gap ) || _gap_s IN { "0", "0.0", "0.00" }, "–", IF ( _gap < 0, "(" & _gap_t & ")", _gap_t ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='160' viewBox='0 0 320 160' font-family='Segoe UI, sans-serif'>"
			            & "<rect x='0.5' y='0.5' width='319' height='159' rx='14' fill='%23E8E5DF' stroke='%23D9D7D4'/>"
			            & "<text x='16' y='28' font-size='15' font-weight='600' fill='%232C3A54'>Investing</text>"
			            & "<text x='286' y='28' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & "<text x='304' y='28' font-size='15' text-anchor='end' fill='%235B6577'>→</text>"
			            & "<text x='16' y='82' font-size='12' fill='%23525C70'>In</text>"
			            & IF ( ABS ( _in ) >= 0.005, "<rect x='78' y='72' width='" & FORMAT ( ABS ( _in ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%232C3A54'/>" )
			            & "<text x='304' y='82' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _in_m & "</text>"
			            & "<text x='16' y='108' font-size='12' fill='%23525C70'>Out</text>"
			            & IF ( ABS ( _out ) >= 0.005, "<rect x='78' y='98' width='" & FORMAT ( ABS ( _out ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%237B828E'/>" )
			            & "<text x='304' y='108' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _out_m & "</text>"
			            & "<text x='16' y='134' font-size='12' fill='%23525C70'>Net</text>"
			            & IF ( ABS ( _net ) >= 0.005, "<rect x='78' y='124' width='" & FORMAT ( ABS ( _net ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%23FF6F1A'/>" )
			            & "<text x='304' y='134' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & IF ( ABS ( _gap ) >= 0.005, "<text x='16' y='152' font-size='11' fill='%23525C70'>statement adds " & _gap_m & " non-cash</text>" )
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: d1de688e-3c5c-5787-b530-d91e7bc06171
		dataCategory: ImageUrl

	/// Cash pop-up, Financing card: cash in, cash out, net of the direct lines; the statement's non-cash gap under it; click opens Financing activities.
	measure 'Cash Card Financing' =
			VAR _a            = [_A]
			VAR _in           = CALCULATE ( [Direct In], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "FINANCING" )
			VAR _out          = CALCULATE ( [Direct Out], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "FINANCING" )
			VAR _net          = _in + _out
			VAR _gap          = CALCULATE ( [Non-Cash Gap], REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] = "FINANCING" )
			VAR _max          =
			    MAX (
			        MAXX (
			            CALCULATETABLE ( VALUES ( dim_cf_line[section_code] ), REMOVEFILTERS ( dim_cf_line ), dim_cf_line[section_code] IN { "OPERATING", "INVESTING", "FINANCING" } )
			            ,MAX ( [Direct In], 0 - [Direct Out] )
			        )
			        ,1
			    )
			VAR _in_s = IF ( [_Is K], FORMAT ( ABS ( _in ) / 1000, "#,0.0" ), FORMAT ( ABS ( _in ), "#,0" ) )
			VAR _in_t = _in_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _in_m = IF ( ISBLANK ( _in ) || _in_s IN { "0", "0.0", "0.00" }, "–", IF ( _in < 0, "(" & _in_t & ")", _in_t ) )
			VAR _out_s = IF ( [_Is K], FORMAT ( ABS ( _out ) / 1000, "#,0.0" ), FORMAT ( ABS ( _out ), "#,0" ) )
			VAR _out_t = _out_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _out_m = IF ( ISBLANK ( _out ) || _out_s IN { "0", "0.0", "0.00" }, "–", IF ( _out < 0, "(" & _out_t & ")", _out_t ) )
			VAR _net_s = IF ( [_Is K], FORMAT ( ABS ( _net ) / 1000, "#,0.0" ), FORMAT ( ABS ( _net ), "#,0" ) )
			VAR _net_t = _net_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _net_m = IF ( ISBLANK ( _net ) || _net_s IN { "0", "0.0", "0.00" }, "–", IF ( _net < 0, "(" & _net_t & ")", _net_t ) )
			VAR _gap_s = IF ( [_Is K], FORMAT ( ABS ( _gap ) / 1000, "#,0.0" ), FORMAT ( ABS ( _gap ), "#,0" ) )
			VAR _gap_t = _gap_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _gap_m = IF ( ISBLANK ( _gap ) || _gap_s IN { "0", "0.0", "0.00" }, "–", IF ( _gap < 0, "(" & _gap_t & ")", _gap_t ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='160' viewBox='0 0 320 160' font-family='Segoe UI, sans-serif'>"
			            & "<rect x='0.5' y='0.5' width='319' height='159' rx='14' fill='%23E8E5DF' stroke='%23D9D7D4'/>"
			            & "<text x='16' y='28' font-size='15' font-weight='600' fill='%232C3A54'>Financing</text>"
			            & "<text x='286' y='28' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & "<text x='304' y='28' font-size='15' text-anchor='end' fill='%235B6577'>→</text>"
			            & "<text x='16' y='82' font-size='12' fill='%23525C70'>In</text>"
			            & IF ( ABS ( _in ) >= 0.005, "<rect x='78' y='72' width='" & FORMAT ( ABS ( _in ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%232C3A54'/>" )
			            & "<text x='304' y='82' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _in_m & "</text>"
			            & "<text x='16' y='108' font-size='12' fill='%23525C70'>Out</text>"
			            & IF ( ABS ( _out ) >= 0.005, "<rect x='78' y='98' width='" & FORMAT ( ABS ( _out ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%237B828E'/>" )
			            & "<text x='304' y='108' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _out_m & "</text>"
			            & "<text x='16' y='134' font-size='12' fill='%23525C70'>Net</text>"
			            & IF ( ABS ( _net ) >= 0.005, "<rect x='78' y='124' width='" & FORMAT ( ABS ( _net ) / _max * 130, "0.0" ) & "' height='12' rx='2' fill='%23FF6F1A'/>" )
			            & "<text x='304' y='134' font-size='12.5' text-anchor='end' fill='%232C3A54'>" & _net_m & "</text>"
			            & IF ( ABS ( _gap ) >= 0.005, "<text x='16' y='152' font-size='11' fill='%23525C70'>statement adds " & _gap_m & " non-cash</text>" )
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: c770cdac-c0ba-52a3-97d9-bd924ec2fd1f
		dataCategory: ImageUrl

	/// Cash moved on the day for the line in context (cash in + |cash out|); 0 on window days without cash, blank outside the window.
	measure 'Heat Moved' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			VAR _mi           = SELECTEDVALUE ( dim_date[month_index] )
			VAR _in           = NOT ISBLANK ( _a ) && NOT ISBLANK ( _mi ) && _mi >= _a && _mi <= _b
			VAR _v            =
			    CALCULATE (
			        SUMX ( fact_cash_posting, ABS ( fact_cash_posting[amount] ) )
			        ,fact_cash_posting[is_internal_transfer] = FALSE ()
			    )
			RETURN
			    IF ( _in, _v + 0 )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: f219bc09-b499-5fdf-8c67-8330a0c37d43

	/// Heatmap block of the cell: 1-5 by count over this activity's non-zero day cells in the window (ties go up, mock quint()); 0 = no cash.
	measure 'Heat Cell Block' =
			VAR _v            = [Heat Moved]
			VAR _vc           = ROUND ( _v * 100, 0 )
			VAR _a            = [_A]
			VAR _b            = [_B]
			VAR _sec          = SELECTEDVALUE ( dim_cf_line[section_code] )
			VAR _grid         =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( fact_cash_posting, fact_cash_posting[direct_line_code], fact_cash_posting[txn_date] )
			            ,"@c", ROUND ( CALCULATE ( SUMX ( fact_cash_posting, ABS ( fact_cash_posting[amount] ) ) ) * 100, 0 )
			        )
			        ,REMOVEFILTERS ( dim_cf_line )
			        ,dim_cf_line[section_code] = _sec
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[month_index] >= _a
			        ,dim_date[month_index] <= _b
			        ,fact_cash_posting[is_internal_transfer] = FALSE ()
			    )
			VAR _nz           = FILTER ( _grid, [@c] > 0 )
			VAR _n            = COUNTROWS ( _nz )
			VAR _le           = COUNTROWS ( FILTER ( _nz, [@c] <= _vc ) )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,BLANK ()
			        ,_vc <= 0
			            ,0
			        ,MIN ( 5, MAX ( 1, ROUNDUP ( _le * 5 / _n, 0 ) ) )
			    )
		formatString: 0
		displayFolder: 3 Direct and activities
		lineageTag: a57f672b-6aa9-587a-81ca-99d1698b0d24

	/// Matrix value of the heatmap (hidden: the font takes the cell colour).
	measure 'Heat Value' =
			VAR _line         = ISINSCOPE ( dim_cf_line[line_name] )
			VAR _day          = ISINSCOPE ( dim_date[date] )
			VAR _m            = IF ( _day, [Heat Moved] )
			RETURN
			    IF ( _line, _m, IF ( NOT ISBLANK ( _m ), 0 ) )
		formatString: #,0
		displayFolder: 3 Direct and activities
		lineageTag: 0a0849dc-b4a3-5a28-bd07-451d7786bb5f

	/// Cell fill (and font, so the number hides): no cash = page tint, blocks 1-4 navy steps, block 5 orange #FF6F1A.
	measure 'Heat Cell Colour' =
			VAR _line         = ISINSCOPE ( dim_cf_line[line_name] )
			VAR _day          = ISINSCOPE ( dim_date[date] )
			VAR _v            = [Heat Value]
			VAR _blk          = IF ( _line && _day, [Heat Cell Block] )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,BLANK ()
			        ,ISBLANK ( _blk )
			            ,"#E8E5DF"
			        ,_blk = 0
			            ,"#F0EFEA"
			        ,_blk = 1
			            ,"#777E8C"
			        ,_blk = 2
			            ,"#5D6678"
			        ,_blk = 3
			            ,"#445066"
			        ,_blk = 4
			            ,"#2C3A54"
			        ,"#FF6F1A"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: c1f09244-23ab-52c6-bf81-5a39425ddc85

	/// Net cash of the line(s) in context over the window (heatmap totals column). (spec DIRECT_LINE)
	measure 'Heat Row Net' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 370bf1fd-9c9a-51e3-b001-b4110c78bf85

	/// Heatmap row summed day by day (Reconciliation: heatmap row = ledger = control). (spec DIRECT_LINE)
	measure 'Heat Row Net by Day' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + SUMX (
			            CALCULATETABLE ( VALUES ( dim_date[date] ), REMOVEFILTERS ( dim_date ), dim_date[month_index] >= _a, dim_date[month_index] <= _b )
			            ,CALCULATE ( SUM ( fact_cash_posting[amount] ), fact_cash_posting[is_internal_transfer] = FALSE () )
			        )
			    )
		formatString: #,0.00
		displayFolder: 6 Reconciliation
		lineageTag: 35f713d5-a0d3-54bd-ac08-95fff0a21173

	/// Operating heatmap totals column: each line's net with a block square (quintile of this activity's |row totals|), section net under the rule.
	measure 'Heat Totals Operating' =
			VAR _a            = [_A]
			VAR _k            = [_Is K]
			VAR _rows         =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( dim_cf_line, dim_cf_line[line_code], dim_cf_line[sort_order] )
			            ,REMOVEFILTERS ( dim_cf_line )
			            ,dim_cf_line[section_code] = "OPERATING"
			            ,dim_cf_line[view] = "DIRECT"
			            ,dim_cf_line[line_kind] = "data"
			        )
			        ,"@net", CALCULATE ( [Heat Row Net] )
			    )
			VAR _rk           = ADDCOLUMNS ( _rows, "@c", ROUND ( ABS ( [@net] ) * 100, 0 ), "@i", RANKX ( _rows, dim_cf_line[sort_order], , ASC ) )
			VAR _nz           = FILTER ( _rk, [@c] > 0 )
			VAR _n            = COUNTROWS ( _nz )
			VAR _total        = SUMX ( _rows, [@net] )
			VAR _body         =
			    CONCATENATEX (
			        _rk
			        ,VAR _c = [@c]
			        VAR _blk = IF ( _c > 0, MIN ( 5, MAX ( 1, ROUNDUP ( COUNTROWS ( FILTER ( _nz, [@c] <= _c ) ) * 5 / _n, 0 ) ) ), 0 )
			        VAR _fill = SWITCH ( _blk, 0, "%23F0EFEA", 1, "%23777E8C", 2, "%235D6678", 3, "%23445066", 4, "%232C3A54", "%23FF6F1A" )
			        VAR _v = [@net]
			        VAR _s = IF ( _k, FORMAT ( ABS ( _v ) / 1000, "#,0.0" ), FORMAT ( ABS ( _v ), "#,0" ) )
			        VAR _t = IF ( _s IN { "0", "0.0" }, "–", IF ( _v < 0, "(" & _s & ")", _s ) )
			        VAR _y = 30 + ( [@i] - 1 ) * 31.2
			        RETURN
			            "<rect x='8' y='" & ( _y + 3 ) & "' width='25.2' height='25.2' rx='2' fill='" & _fill & "'/>"
			                & "<text x='144' y='" & ( _y + 20.6 ) & "' text-anchor='end' fill='" & IF ( _c = 0, "%235B6577", "%232C3A54" ) & "'>" & _t & "</text>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _ty           = 30 + COUNTROWS ( _rows ) * 31.2
			VAR _ts           = IF ( _k, FORMAT ( ABS ( _total ) / 1000, "#,0.0" ), FORMAT ( ABS ( _total ), "#,0" ) )
			VAR _tt           = IF ( _ts IN { "0", "0.0" }, "–", IF ( _total < 0, "(" & _ts & ")", _ts ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='" & ( _ty + 40 ) & "' viewBox='0 0 150 " & ( _ty + 40 ) & "' font-family='Segoe UI, sans-serif' font-size='13'>"
			            & "<text x='144' y='20' text-anchor='end' font-size='11.5' fill='%23525C70'>Total</text>"
			            & _body
			            & "<rect x='0' y='" & ( _ty + 1 ) & "' width='150' height='1' fill='%232C3A54'/>"
			            & "<text x='144' y='" & ( _ty + 22 ) & "' text-anchor='end' font-weight='600' fill='%232C3A54'>" & _tt & "</text></svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: 66eeb5e5-6978-5bfd-a29d-338e39e3b905
		dataCategory: ImageUrl

	/// Investing heatmap totals column: each line's net with a block square (quintile of this activity's |row totals|), section net under the rule.
	measure 'Heat Totals Investing' =
			VAR _a            = [_A]
			VAR _k            = [_Is K]
			VAR _rows         =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( dim_cf_line, dim_cf_line[line_code], dim_cf_line[sort_order] )
			            ,REMOVEFILTERS ( dim_cf_line )
			            ,dim_cf_line[section_code] = "INVESTING"
			            ,dim_cf_line[view] = "DIRECT"
			            ,dim_cf_line[line_kind] = "data"
			        )
			        ,"@net", CALCULATE ( [Heat Row Net] )
			    )
			VAR _rk           = ADDCOLUMNS ( _rows, "@c", ROUND ( ABS ( [@net] ) * 100, 0 ), "@i", RANKX ( _rows, dim_cf_line[sort_order], , ASC ) )
			VAR _nz           = FILTER ( _rk, [@c] > 0 )
			VAR _n            = COUNTROWS ( _nz )
			VAR _total        = SUMX ( _rows, [@net] )
			VAR _body         =
			    CONCATENATEX (
			        _rk
			        ,VAR _c = [@c]
			        VAR _blk = IF ( _c > 0, MIN ( 5, MAX ( 1, ROUNDUP ( COUNTROWS ( FILTER ( _nz, [@c] <= _c ) ) * 5 / _n, 0 ) ) ), 0 )
			        VAR _fill = SWITCH ( _blk, 0, "%23F0EFEA", 1, "%23777E8C", 2, "%235D6678", 3, "%23445066", 4, "%232C3A54", "%23FF6F1A" )
			        VAR _v = [@net]
			        VAR _s = IF ( _k, FORMAT ( ABS ( _v ) / 1000, "#,0.0" ), FORMAT ( ABS ( _v ), "#,0" ) )
			        VAR _t = IF ( _s IN { "0", "0.0" }, "–", IF ( _v < 0, "(" & _s & ")", _s ) )
			        VAR _y = 30 + ( [@i] - 1 ) * 31.2
			        RETURN
			            "<rect x='8' y='" & ( _y + 3 ) & "' width='25.2' height='25.2' rx='2' fill='" & _fill & "'/>"
			                & "<text x='144' y='" & ( _y + 20.6 ) & "' text-anchor='end' fill='" & IF ( _c = 0, "%235B6577", "%232C3A54" ) & "'>" & _t & "</text>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _ty           = 30 + COUNTROWS ( _rows ) * 31.2
			VAR _ts           = IF ( _k, FORMAT ( ABS ( _total ) / 1000, "#,0.0" ), FORMAT ( ABS ( _total ), "#,0" ) )
			VAR _tt           = IF ( _ts IN { "0", "0.0" }, "–", IF ( _total < 0, "(" & _ts & ")", _ts ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='" & ( _ty + 40 ) & "' viewBox='0 0 150 " & ( _ty + 40 ) & "' font-family='Segoe UI, sans-serif' font-size='13'>"
			            & "<text x='144' y='20' text-anchor='end' font-size='11.5' fill='%23525C70'>Total</text>"
			            & _body
			            & "<rect x='0' y='" & ( _ty + 1 ) & "' width='150' height='1' fill='%232C3A54'/>"
			            & "<text x='144' y='" & ( _ty + 22 ) & "' text-anchor='end' font-weight='600' fill='%232C3A54'>" & _tt & "</text></svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: 3a66466d-2a02-5bd8-beeb-ef23e00b6be4
		dataCategory: ImageUrl

	/// Financing heatmap totals column: each line's net with a block square (quintile of this activity's |row totals|), section net under the rule.
	measure 'Heat Totals Financing' =
			VAR _a            = [_A]
			VAR _k            = [_Is K]
			VAR _rows         =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( dim_cf_line, dim_cf_line[line_code], dim_cf_line[sort_order] )
			            ,REMOVEFILTERS ( dim_cf_line )
			            ,dim_cf_line[section_code] = "FINANCING"
			            ,dim_cf_line[view] = "DIRECT"
			            ,dim_cf_line[line_kind] = "data"
			        )
			        ,"@net", CALCULATE ( [Heat Row Net] )
			    )
			VAR _rk           = ADDCOLUMNS ( _rows, "@c", ROUND ( ABS ( [@net] ) * 100, 0 ), "@i", RANKX ( _rows, dim_cf_line[sort_order], , ASC ) )
			VAR _nz           = FILTER ( _rk, [@c] > 0 )
			VAR _n            = COUNTROWS ( _nz )
			VAR _total        = SUMX ( _rows, [@net] )
			VAR _body         =
			    CONCATENATEX (
			        _rk
			        ,VAR _c = [@c]
			        VAR _blk = IF ( _c > 0, MIN ( 5, MAX ( 1, ROUNDUP ( COUNTROWS ( FILTER ( _nz, [@c] <= _c ) ) * 5 / _n, 0 ) ) ), 0 )
			        VAR _fill = SWITCH ( _blk, 0, "%23F0EFEA", 1, "%23777E8C", 2, "%235D6678", 3, "%23445066", 4, "%232C3A54", "%23FF6F1A" )
			        VAR _v = [@net]
			        VAR _s = IF ( _k, FORMAT ( ABS ( _v ) / 1000, "#,0.0" ), FORMAT ( ABS ( _v ), "#,0" ) )
			        VAR _t = IF ( _s IN { "0", "0.0" }, "–", IF ( _v < 0, "(" & _s & ")", _s ) )
			        VAR _y = 30 + ( [@i] - 1 ) * 31.2
			        RETURN
			            "<rect x='8' y='" & ( _y + 3 ) & "' width='25.2' height='25.2' rx='2' fill='" & _fill & "'/>"
			                & "<text x='144' y='" & ( _y + 20.6 ) & "' text-anchor='end' fill='" & IF ( _c = 0, "%235B6577", "%232C3A54" ) & "'>" & _t & "</text>"
			        ,""
			        ,[@i], ASC
			    )
			VAR _ty           = 30 + COUNTROWS ( _rows ) * 31.2
			VAR _ts           = IF ( _k, FORMAT ( ABS ( _total ) / 1000, "#,0.0" ), FORMAT ( ABS ( _total ), "#,0" ) )
			VAR _tt           = IF ( _ts IN { "0", "0.0" }, "–", IF ( _total < 0, "(" & _ts & ")", _ts ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='" & ( _ty + 40 ) & "' viewBox='0 0 150 " & ( _ty + 40 ) & "' font-family='Segoe UI, sans-serif' font-size='13'>"
			            & "<text x='144' y='20' text-anchor='end' font-size='11.5' fill='%23525C70'>Total</text>"
			            & _body
			            & "<rect x='0' y='" & ( _ty + 1 ) & "' width='150' height='1' fill='%232C3A54'/>"
			            & "<text x='144' y='" & ( _ty + 22 ) & "' text-anchor='end' font-weight='600' fill='%232C3A54'>" & _tt & "</text></svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: eefd3a4d-4cea-5270-bc16-b1a4dd13ff6f
		dataCategory: ImageUrl

	/// Cell tooltip: the date.
	measure 'Tip Day' = FORMAT ( SELECTEDVALUE ( dim_date[date] ), "ddd d mmm yyyy" )
		isHidden
		displayFolder: 8 Report
		lineageTag: 98476b9f-e75a-59cc-913a-d290f36976fd

	/// Cell tooltip: the direct line.
	measure 'Tip Line' = SELECTEDVALUE ( dim_cf_line[line_name] )
		isHidden
		displayFolder: 8 Report
		lineageTag: bffb9009-3401-5bac-aa11-5bfbe63570f8

	/// Cell tooltip: cash in on the day.
	measure 'Tip In' =
			DIVIDE (
			    CALCULATE (
			        SUM ( fact_cash_posting[amount] )
			        ,fact_cash_posting[is_internal_transfer] = FALSE ()
			        ,fact_cash_posting[amount] > 0
			    ) + 0
			    ,[_Div]
			)
		isHidden
		displayFolder: 8 Report
		lineageTag: a418b196-716a-52cf-98c7-f38903729121

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0.00;(#,0.00);–" )

	/// Cell tooltip: cash out on the day.
	measure 'Tip Out' =
			DIVIDE (
			    CALCULATE (
			        SUM ( fact_cash_posting[amount] )
			        ,fact_cash_posting[is_internal_transfer] = FALSE ()
			        ,fact_cash_posting[amount] < 0
			    ) + 0
			    ,[_Div]
			)
		isHidden
		displayFolder: 8 Report
		lineageTag: e239cbe5-c7ad-507d-bdfd-8680d7a3b163

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0.00;(#,0.00);–" )

	/// Cell tooltip: ledger rows on the day.
	measure 'Tip Transactions' =
			COUNTROWS (
			    CALCULATETABLE (
			        SUMMARIZE (
			            fact_cash_posting
			            ,fact_cash_posting[txn_id]
			            ,fact_cash_posting[counterparty_id]
			            ,fact_cash_posting[direction]
			        )
			        ,fact_cash_posting[is_internal_transfer] = FALSE ()
			    )
			) + 0
		formatString: 0
		isHidden
		displayFolder: 8 Report
		lineageTag: 3398e02f-3507-59aa-81fa-9645f56e3f87

	/// Ledger amount in USD of the rows in context (drill-through line / day honoured), window, internal transfers excluded. (spec DIRECT_LINE)
	measure 'Ledger Value' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b

			        )
			    )
		formatString: #,0.00
		displayFolder: 4 Transactions
		lineageTag: e803033c-cd31-5c26-85ec-cf55cc9055a3

	/// Ledger amount in the picked units (cents in USD).
	measure 'Ledger Amount' = DIVIDE ( [Ledger Value], [_Div] )
		displayFolder: 4 Transactions
		lineageTag: 7b1803e0-43f1-515f-b86f-8c1b4155dfed

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0.00;(#,0.00);–" )

	/// Cash in of the ledger rows.
	measure 'Ledger Cash In' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            SUM ( fact_cash_posting[amount] ) + 0
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			            ,fact_cash_posting[amount] > 0
			        )
			    )
		formatString: #,0.00
		displayFolder: 4 Transactions
		lineageTag: f0efa844-906f-5f7f-9cc8-9467683b060d

	/// Cash out of the ledger rows.
	measure 'Ledger Cash Out' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            SUM ( fact_cash_posting[amount] ) + 0
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			            ,fact_cash_posting[amount] < 0
			        )
			    )
		formatString: #,0.00
		displayFolder: 4 Transactions
		lineageTag: 0de0fbd7-db94-57ed-ac2e-d1210deecf02

	/// Ledger rows (transaction x line x counterparty x direction) in context.
	measure 'Ledger Rows' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            COUNTROWS (
			                SUMMARIZE (
			                    fact_cash_posting
			                    ,fact_cash_posting[txn_id]
			                    ,fact_cash_posting[direct_line_code]
			                    ,fact_cash_posting[counterparty_id]
			                    ,fact_cash_posting[direction]
			                )
			            ) + 0
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b

			        )
			    )
		formatString: #,0
		displayFolder: 4 Transactions
		lineageTag: 2d49e2ca-d732-5c27-8dac-6e808f151e77

	/// Ledger rows of the line(s) in context summed row by row (Reconciliation 'Ledger' column). (spec DIRECT_LINE)
	measure 'Ledger Line Sum' =
			SUMX (
			    CALCULATETABLE (
			        SUMMARIZE (
			            fact_cash_posting
			            ,fact_cash_posting[txn_id]
			            ,fact_cash_posting[counterparty_id]
			            ,fact_cash_posting[direction]
			        )
			        ,REMOVEFILTERS ( dim_date )
			    )
			    ,[Ledger Value]
			)
		formatString: #,0.00
		displayFolder: 6 Reconciliation
		lineageTag: 9e42ea8e-45a5-5c83-91f5-8a12f40130ce

	/// Clr mark: orange disc with R (reconciled) / C (cleared), plain disc = uncleared, dot = Undeposited Funds (not applicable).
	measure 'Ledger Clr SVG' =
			VAR _s            = SELECTEDVALUE ( fact_cash_posting[cleared_status] )
			VAR _l            = SWITCH ( _s, "Reconciled", "R", "Cleared", "C", "" )
			RETURN
			    IF (
			        NOT ISBLANK ( [Ledger Value] ) && HASONEVALUE ( fact_txn[txn_id] )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 18 18' font-family='Segoe UI, sans-serif'>"
			            & IF (
			                _s = "NotApplicable"
			                ,"<circle cx='9' cy='9' r='3' fill='%23FF6F1A'/>"
			                ,"<circle cx='9' cy='9' r='8' fill='%23FF6F1A'/><text x='9' y='12.5' font-size='9.5' font-weight='700' text-anchor='middle' fill='%232C3A54'>" & _l & "</text>"
			            )
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: a2c8a5b0-9019-586d-9710-d8269d1b9c67
		dataCategory: ImageUrl

	/// Ledger card title: activity › line (all lines when none).
	measure 'Ledger Title' =
			VAR _sec          = SELECTEDVALUE ( dim_cf_line[section_code] )
			VAR _line         = IF ( ISFILTERED ( dim_cf_line[line_name] ), SELECTEDVALUE ( dim_cf_line[line_name] ) )
			VAR _name         =
			    SWITCH (
			        _sec
			        ,"OPERATING", "Operating"
			        ,"INVESTING", "Investing"
			        ,"FINANCING", "Financing"
			        ,"All activities"
			    )
			RETURN
			    _name & " › " & IF ( ISBLANK ( _line ), "all lines", _line )
		isHidden
		displayFolder: 8 Report
		lineageTag: 3ba40cbc-ec19-52d4-97cc-7480ed064a23

	/// Ledger card sub-title: the drilled day, else the period.
	measure 'Ledger When' =
			VAR _day          = IF ( ISFILTERED ( dim_date[date] ), SELECTEDVALUE ( dim_date[date] ) )
			RETURN
			    IF ( ISBLANK ( _day ), [Stmt Header Period], FORMAT ( _day, "ddd d mmm yyyy" ) )
		isHidden
		displayFolder: 8 Report
		lineageTag: 46393a5a-a08f-5f1d-8bf8-51b321e42388

	/// Transactions trio: cash in, cash out, net, transactions of the ledger rows in context.
	measure 'Ledger Trio SVG' =
			VAR _in           = [Ledger Cash In]
			VAR _out          = [Ledger Cash Out]
			VAR _net          = _in + _out
			VAR _n            = [Ledger Rows]
			VAR _in_s = IF ( [_Is K], FORMAT ( ABS ( _in ) / 1000, "#,0.0" ), FORMAT ( ABS ( _in ), "#,0.00" ) )
			VAR _in_t = _in_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _in_m = IF ( ISBLANK ( _in ) || _in_s IN { "0", "0.0", "0.00" }, "–", IF ( _in < 0, "(" & _in_t & ")", _in_t ) )
			VAR _out_s = IF ( [_Is K], FORMAT ( ABS ( _out ) / 1000, "#,0.0" ), FORMAT ( ABS ( _out ), "#,0.00" ) )
			VAR _out_t = _out_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _out_m = IF ( ISBLANK ( _out ) || _out_s IN { "0", "0.0", "0.00" }, "–", IF ( _out < 0, "(" & _out_t & ")", _out_t ) )
			VAR _net_s = IF ( [_Is K], FORMAT ( ABS ( _net ) / 1000, "#,0.0" ), FORMAT ( ABS ( _net ), "#,0.00" ) )
			VAR _net_t = _net_s & IF ( [_Is K] && FALSE (), "k" )
			VAR _net_m = IF ( ISBLANK ( _net ) || _net_s IN { "0", "0.0", "0.00" }, "–", IF ( _net < 0, "(" & _net_t & ")", _net_t ) )
			VAR _w            = ( 1370 - 30 ) / 4
			VAR _box          =
			    CONCATENATEX (
			        { ( 0, "Cash in", 1 ), ( 1, "Cash out", 2 ), ( 2, "Net", 0 ), ( 3, "Transactions", 0 ) }
			        ,VAR _i = [Value1]
			        VAR _x = _i * ( _w + 10 )
			        VAR _val = SWITCH ( _i, 0, _in_m, 1, _out_m, 2, _net_m, FORMAT ( _n, "#,0" ) )
			        RETURN
			            "<rect x='" & _x & "' y='0' width='" & _w & "' height='56' rx='10' fill='%23F0EFEA'/>"
			                & IF ( [Value3] = 1, "<rect x='" & ( _x + 10 ) & "' y='0' width='" & ( _w - 20 ) & "' height='3' fill='%232C3A54'/>" )
			                & IF ( [Value3] = 2, "<rect x='" & ( _x + 10 ) & "' y='0' width='" & ( _w - 20 ) & "' height='3' fill='%237B828E'/>" )
			                & "<text x='" & ( _x + 12 ) & "' y='21' font-size='11.5' fill='%23525C70'>" & [Value2] & "</text>"
			                & "<text x='" & ( _x + 12 ) & "' y='44' font-size='17' font-weight='600' fill='%232C3A54'>" & _val & "</text>"
			        ,""
			        ,[Value1], ASC
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1370' height='56' viewBox='0 0 1370 56' font-family='Segoe UI, sans-serif'>" & _box & "</svg>"
		isHidden
		displayFolder: 8 Report
		lineageTag: 5513d7c2-3939-5c67-8466-d2665a52b902
		dataCategory: ImageUrl

	/// Diagram pop-up, KPI groups beside the tree (the mock's diagram groups the decomposition tree cannot carry): cash quality, working capital, FCF and investment, leverage and coverage.
	measure 'Diagram KPI SVG' =
			VAR _a            = [_A]
			VAR _netDebt     = [Net Debt]
			VAR _lquality = [KPI Cash Conversion]
			VAR _lquality_m = IF ( ISBLANK ( _lquality ), "n/m", IF ( _lquality < 0, "−", "" ) & FORMAT ( ABS ( _lquality ), "0.00" ) & "×" )
			VAR _mquality0 = [Operating Cash Margin]
			VAR _mquality0_m = IF ( ISBLANK ( _mquality0 ), "n/m", IF ( _mquality0 < 0, "−", "" ) & FORMAT ( ABS ( _mquality0 ) * 100, "#,0.0" ) & "%25" )
			VAR _mquality1 = [KPI Cash Conversion]
			VAR _mquality1_m = IF ( ISBLANK ( _mquality1 ), "n/m", IF ( _mquality1 < 0, "−", "" ) & FORMAT ( ABS ( _mquality1 ), "0.00" ) & "×" )
			VAR _mquality2 = [Accruals]
			VAR _mquality2_s = IF ( [_Is K], FORMAT ( ABS ( _mquality2 ) / 1000, "#,0.0" ), FORMAT ( ABS ( _mquality2 ), "#,0" ) )
			VAR _mquality2_t = _mquality2_s & IF ( [_Is K] && TRUE (), "k" )
			VAR _mquality2_m = IF ( ISBLANK ( _mquality2 ) || _mquality2_s IN { "0", "0.0", "0.00" }, "–", IF ( _mquality2 < 0, "(" & _mquality2_t & ")", _mquality2_t ) )
			VAR _lwc = [Cash Conversion Cycle]
			VAR _lwc_m = IF ( ISBLANK ( _lwc ), "n/m", FORMAT ( _lwc, "#,0.0" ) & " d" )
			VAR _mwc0 = [DSO Days]
			VAR _mwc0_m = IF ( ISBLANK ( _mwc0 ), "n/m", FORMAT ( _mwc0, "#,0.0" ) & " d" )
			VAR _mwc1 = [DPO Days]
			VAR _mwc1_m = IF ( ISBLANK ( _mwc1 ), "n/m", FORMAT ( _mwc1, "#,0.0" ) & " d" )
			VAR _mwc2 = [Cash Conversion Cycle]
			VAR _mwc2_m = IF ( ISBLANK ( _mwc2 ), "n/m", FORMAT ( _mwc2, "#,0.0" ) & " d" )
			VAR _lfcf = [Free Cash Flow]
			VAR _lfcf_s = IF ( [_Is K], FORMAT ( ABS ( _lfcf ) / 1000, "#,0.0" ), FORMAT ( ABS ( _lfcf ), "#,0" ) )
			VAR _lfcf_t = _lfcf_s & IF ( [_Is K] && TRUE (), "k" )
			VAR _lfcf_m = IF ( ISBLANK ( _lfcf ) || _lfcf_s IN { "0", "0.0", "0.00" }, "–", IF ( _lfcf < 0, "(" & _lfcf_t & ")", _lfcf_t ) )
			VAR _mfcf0 = [Free Cash Flow]
			VAR _mfcf0_s = IF ( [_Is K], FORMAT ( ABS ( _mfcf0 ) / 1000, "#,0.0" ), FORMAT ( ABS ( _mfcf0 ), "#,0" ) )
			VAR _mfcf0_t = _mfcf0_s & IF ( [_Is K] && TRUE (), "k" )
			VAR _mfcf0_m = IF ( ISBLANK ( _mfcf0 ) || _mfcf0_s IN { "0", "0.0", "0.00" }, "–", IF ( _mfcf0 < 0, "(" & _mfcf0_t & ")", _mfcf0_t ) )
			VAR _mfcf1 = [Capex Intensity]
			VAR _mfcf1_m = IF ( ISBLANK ( _mfcf1 ), "n/m", IF ( _mfcf1 < 0, "−", "" ) & FORMAT ( ABS ( _mfcf1 ) * 100, "#,0.0" ) & "%25" )
			VAR _mfcf2 = [Capex Coverage]
			VAR _mfcf2_m = IF ( ISBLANK ( _mfcf2 ), "no capex", IF ( _mfcf2 < 0, "−", "" ) & FORMAT ( ABS ( _mfcf2 ), "0.00" ) & "×" )
			VAR _llev = [DSCR]
			VAR _llev_m = IF ( ISBLANK ( _llev ), "n/m", IF ( _llev < 0, "−", "" ) & FORMAT ( ABS ( _llev ), "0.00" ) & "×" )
			VAR _mlev0 = [DSCR]
			VAR _mlev0_m = IF ( ISBLANK ( _mlev0 ), "n/m", IF ( _mlev0 < 0, "−", "" ) & FORMAT ( ABS ( _mlev0 ), "0.00" ) & "×" )
			VAR _mlev1 = [Net Debt to EBITDA]
			VAR _mlev1_m = IF ( ISBLANK ( _mlev1 ), "n/m", IF ( _mlev1 < 0, "−", "" ) & FORMAT ( ABS ( _mlev1 ), "0.00" ) & "×" )
			VAR _mlev2 = [Payout Cover]
			VAR _mlev2_m = IF ( ISBLANK ( _mlev2 ), "no draws", IF ( _mlev2 < 0, "−", "" ) & FORMAT ( ABS ( _mlev2 ), "0.00" ) & "×" )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='380' height='600' viewBox='0 0 380 600' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='379' height='140' rx='12' fill='%23E8E5DF' stroke='%23D9D7D4'/><text x='16' y='22' font-size='12' fill='%23525C70'>Cash quality · Operating</text><text x='364' y='24' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _lquality_m & "</text><text x='364' y='38' font-size='10' text-anchor='end' fill='%235B6577'>cash conversion</text>"
			    & "<text x='16' y='60' font-size='12.5' fill='%232C3A54'>CFO margin</text><text x='16' y='72' font-size='9.5' fill='%235B6577'>" & "CFO ÷ revenue" & "</text><text x='364' y='64' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mquality0_m & "</text>"
			    & "<text x='16' y='89' font-size='12.5' fill='%232C3A54'>Cash conversion</text><text x='16' y='101' font-size='9.5' fill='%235B6577'>" & "CFO ÷ net income" & "</text><text x='364' y='93' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mquality1_m & "</text>"
			    & "<text x='16' y='118' font-size='12.5' fill='%232C3A54'>Accruals</text><text x='16' y='130' font-size='9.5' fill='%235B6577'>" & "net income − CFO" & "</text><text x='364' y='122' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mquality2_m & "</text>"
			    & "<rect x='0.5' y='153.5' width='379' height='140' rx='12' fill='%23E8E5DF' stroke='%23D9D7D4'/><text x='16' y='175' font-size='12' fill='%23525C70'>Working capital · Operating</text><text x='364' y='177' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _lwc_m & "</text><text x='364' y='191' font-size='10' text-anchor='end' fill='%235B6577'>cash conversion cycle</text>"
			    & "<text x='16' y='213' font-size='12.5' fill='%232C3A54'>DSO</text><text x='16' y='225' font-size='9.5' fill='%235B6577'>" & "A/R ÷ revenue × days" & "</text><text x='364' y='217' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mwc0_m & "</text>"
			    & "<text x='16' y='242' font-size='12.5' fill='%232C3A54'>DPO</text><text x='16' y='254' font-size='9.5' fill='%235B6577'>" & "A/P ÷ bills spend × days" & "</text><text x='364' y='246' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mwc1_m & "</text>"
			    & "<text x='16' y='271' font-size='12.5' fill='%232C3A54'>Cash conversion cycle</text><text x='16' y='283' font-size='9.5' fill='%235B6577'>" & "DSO − DPO (no inventory)" & "</text><text x='364' y='275' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mwc2_m & "</text>"
			    & "<rect x='0.5' y='306.5' width='379' height='140' rx='12' fill='%23E8E5DF' stroke='%23D9D7D4'/><text x='16' y='328' font-size='12' fill='%23525C70'>FCF and investment · Investing</text><text x='364' y='330' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _lfcf_m & "</text><text x='364' y='344' font-size='10' text-anchor='end' fill='%235B6577'>free cash flow</text>"
			    & "<text x='16' y='366' font-size='12.5' fill='%232C3A54'>Free cash flow</text><text x='16' y='378' font-size='9.5' fill='%235B6577'>" & "CFO − capex + proceeds" & "</text><text x='364' y='370' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mfcf0_m & "</text>"
			    & "<text x='16' y='395' font-size='12.5' fill='%232C3A54'>Capex intensity</text><text x='16' y='407' font-size='9.5' fill='%235B6577'>" & "capex ÷ revenue" & "</text><text x='364' y='399' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mfcf1_m & "</text>"
			    & "<text x='16' y='424' font-size='12.5' fill='%232C3A54'>Capex coverage</text><text x='16' y='436' font-size='9.5' fill='%235B6577'>" & "CFO ÷ capex" & "</text><text x='364' y='428' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mfcf2_m & "</text>"
			    & "<rect x='0.5' y='459.5' width='379' height='140' rx='12' fill='%23E8E5DF' stroke='%23D9D7D4'/><text x='16' y='481' font-size='12' fill='%23525C70'>Leverage and coverage · Financing</text><text x='364' y='483' font-size='18' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _llev_m & "</text><text x='364' y='497' font-size='10' text-anchor='end' fill='%235B6577'>debt service coverage</text>"
			    & "<text x='16' y='519' font-size='12.5' fill='%232C3A54'>DSCR</text><text x='16' y='531' font-size='9.5' fill='%235B6577'>" & "CFO ÷ (interest + term principal)" & "</text><text x='364' y='523' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mlev0_m & "</text>"
			    & "<text x='16' y='548' font-size='12.5' fill='%232C3A54'>Net debt ÷ EBITDA</text><text x='16' y='560' font-size='9.5' fill='%235B6577'>" & IF ( _netDebt < 0, "net cash · EBITDA annualised", "EBITDA annualised" ) & "</text><text x='364' y='552' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mlev1_m & "</text>"
			    & "<text x='16' y='577' font-size='12.5' fill='%232C3A54'>Payout cover</text><text x='16' y='589' font-size='9.5' fill='%235B6577'>" & "CFO ÷ owner draws" & "</text><text x='364' y='581' font-size='13' font-weight='600' text-anchor='end' fill='%232C3A54'>" & _mlev2_m & "</text>"
			    & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: e5a9c2e9-9288-55b8-93df-3f8d8e61c4ae
		dataCategory: ImageUrl

	/// Net change in cash as the sum of the direct cash postings (= M03 at the root); splits by activity, line, counterparty and month honour the tree's path. (spec M03 / M11)
	measure 'Decomp Net Cash USD' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,KEEPFILTERS ( dim_date[month_index] >= _a )
			            ,KEEPFILTERS ( dim_date[month_index] <= _b )
			        )
			    )
		formatString: #,0.00
		displayFolder: 5 Diagram
		lineageTag: 8dd842ff-0971-556b-9312-5037ff937dc7

	/// Decomposition tree metric: net change in cash in the picked units (direct postings; the activity split is the direct view, the statement adds the non-cash gap).
	measure 'Decomp Net Change' = DIVIDE ( [Decomp Net Cash USD], [_Div] )
		displayFolder: 5 Diagram
		lineageTag: 8eb32119-aa64-5a20-bf8a-3a8eed82b99b

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0;(#,0);–" )

	/// Diagram pop-up title.
	measure 'Diagram Title' = "Diagram · " & [Stmt Header Period]
		isHidden
		displayFolder: 8 Report
		lineageTag: 0989e487-28b4-56d0-be8e-42ddf5038dc8

	/// Statement row tooltip: the row label.
	measure 'Tip Row Label' =
			VAR _l            =
			    IF (
			        HASONEVALUE ( dim_stmt_row[row_label] )
			        ,SELECTEDVALUE ( dim_stmt_row[row_label] )
			        ,SELECTEDVALUE ( dim_stmt_row[section_label] )
			    )
			RETURN
			    TRIM ( SUBSTITUTE ( _l, UNICHAR ( 8195 ), "" ) )
		isHidden
		displayFolder: 8 Report
		lineageTag: 36ab57d2-89a3-528c-9f7c-bcfcb5dfa272

	/// Ledger row tooltip: cleared status in words.
	measure 'Tip Clr' =
			SWITCH (
			    SELECTEDVALUE ( fact_cash_posting[cleared_status] )
			    ,"Reconciled", "Reconciled (R)"
			    ,"Cleared", "Cleared (C)"
			    ,"Uncleared", "Uncleared"
			    ,"NotApplicable", "Not applicable (Undeposited Funds)"
			)
		isHidden
		displayFolder: 8 Report
		lineageTag: 0d46d35e-ec90-5882-a1c5-f854f5dd857d

	/// Ledger row tooltip: date, type and number.
	measure 'Tip Ledger Head' = FORMAT ( SELECTEDVALUE ( fact_cash_posting[txn_date] ), "ddd d mmm yyyy" ) & " · " & SELECTEDVALUE ( fact_txn[type_no] )
		isHidden
		displayFolder: 8 Report
		lineageTag: be833e6f-637f-58d7-9a75-c7a76eb281cc

	/// Ledger row tooltip: party.
	measure 'Tip Party' = SELECTEDVALUE ( dim_counterparty[counterparty_name] )
		isHidden
		displayFolder: 8 Report
		lineageTag: df16e076-d85b-592b-b352-192b1f79ee5c

	/// Ledger row tooltip: memo.
	measure 'Tip Memo' = SELECTEDVALUE ( fact_cash_posting[ledger_memo] )
		isHidden
		displayFolder: 8 Report
		lineageTag: 61670262-0f14-52df-a865-11c8ff9e5298

	/// Control total of the check row for the picked month / year (blank for quarters: no controls).
	measure 'Control Value' =
			VAR _key          = [_Ctl Key]
			VAR _m            = SELECTEDVALUE ( dim_recon_check[metric_code] )
			VAR _s            = SELECTEDVALUE ( dim_recon_check[scope] )
			RETURN
			    IF (
			        _key <> ""
			        ,CALCULATE (
			            SUM ( ctl_control_total[value] )
			            ,ctl_control_total[period_key] = _key
			            ,ctl_control_total[metric_code] = _m
			            ,ctl_control_total[scope] = _s
			        )
			    )
		formatString: #,0.00
		displayFolder: 6 Reconciliation
		lineageTag: 3f1e54ae-7418-5ec3-a906-7afc0bff2b65

	/// Value the report shows for the check row (statement, cash balance card, KPI).
	measure 'Recon Page Value' =
			VAR _code         = SELECTEDVALUE ( dim_recon_check[check_code] )
			RETURN
			    SWITCH (
			        _code
			        ,"OPEN", [Opening Cash]
			        ,"CLOSE", [Closing Cash]
			        ,"NET", [Net Change in Cash]
			        ,"OP", [Operating Cash Flow]
			        ,"INV", [Investing Cash Flow]
			        ,"FIN", [Financing Cash Flow]
			        ,"SECTIONS", [Operating Cash Flow] + [Investing Cash Flow] + [Financing Cash Flow]
			        ,"IN", [Cash In]
			        ,"OUT", [Cash Out]
			        ,"ROLL", [Opening Cash] + [Cash In] + [Cash Out]
			        ,"FCF", [Free Cash Flow]
			        ,"CONV", [Cash Conversion]
			    )
		formatString: #,0.00
		displayFolder: 6 Reconciliation
		lineageTag: 4db8b1c5-c403-5151-b5b4-a407c42d4d47

	/// 1 when the page value ties to the control total (0.005 USD; cash conversion 1e-6 relative).
	measure 'Recon OK' =
			VAR _code         = SELECTEDVALUE ( dim_recon_check[check_code] )
			VAR _p            = [Recon Page Value]
			VAR _c            = [Control Value]
			VAR _tol          = IF ( _code = "CONV", 0.000001 * MAX ( 1, ABS ( _c ) ), 0.005 )
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( ABS ( _p - _c ) <= _tol, 1, 0 ) )
		formatString: 0
		displayFolder: 6 Reconciliation
		lineageTag: 5ea66620-f0ae-515f-a5cc-e046e2358c1e

	/// Page value as text (cents; cash conversion 4 dp).
	measure 'Recon Page' =
			VAR _code         = SELECTEDVALUE ( dim_recon_check[check_code] )
			VAR _v            = [Recon Page Value]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,IF ( _code = "CONV", "n/m", "–" )
			        ,_code = "CONV"
			            ,FORMAT ( _v, "0.0000" )
			        ,FORMAT ( _v, "#,0.00;(#,0.00);–" )
			    )
		displayFolder: 6 Reconciliation
		lineageTag: da966130-b398-545e-a8f4-d8bb84b6aacc

	/// Control value as text.
	measure 'Recon Control' =
			VAR _code         = SELECTEDVALUE ( dim_recon_check[check_code] )
			VAR _v            = [Control Value]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,IF ( _code = "CONV", "n/m", "–" )
			        ,_code = "CONV"
			            ,FORMAT ( _v, "0.0000" )
			        ,FORMAT ( _v, "#,0.00;(#,0.00);–" )
			    )
		displayFolder: 6 Reconciliation
		lineageTag: 147fff68-e2a2-5203-8529-21a112f89b34

	/// ✓ ties, ✗ differs.
	measure 'Recon Mark' = SWITCH ( [Recon OK], 1, "✓", 0, "✗" )
		displayFolder: 6 Reconciliation
		lineageTag: 651b3cf8-405a-5353-872f-8cbd6b338b5c

	/// DIRECT_LINE control total (overrides on) of the line in context; 0 when the line has no row.
	measure 'Line Control Value' =
			VAR _key          = [_Ctl Key]
			VAR _code         = SELECTEDVALUE ( dim_cf_line[line_code] )
			RETURN
			    IF (
			        _key <> ""
			        ,0 + CALCULATE (
			            SUM ( ctl_control_total[value] )
			            ,ctl_control_total[period_key] = _key
			            ,ctl_control_total[metric_code] = "DIRECT_LINE"
			            ,ctl_control_total[scope] = _code
			        )
			    )
		formatString: #,0.00
		displayFolder: 6 Reconciliation
		lineageTag: 2c37745e-d60a-5999-841b-ac04b8225f09

	/// 1 when heatmap row and ledger both tie to the control.
	measure 'Line OK' =
			VAR _c            = [Line Control Value]
			VAR _h            = CALCULATE ( [Heat Row Net by Day] )
			VAR _l            = CALCULATE ( [Ledger Line Sum] )
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( ABS ( _h - _c ) <= 0.005 && ABS ( _l - _c ) <= 0.005, 1, 0 ) )
		formatString: 0
		displayFolder: 6 Reconciliation
		lineageTag: a45dcbf0-14c7-5cd6-a35c-b2715c82b1f3

	/// Line Heat as text.
	measure 'Line Heat Text' = FORMAT ( CALCULATE ( [Heat Row Net by Day] ), "#,0.00;(#,0.00);–" )
		displayFolder: 6 Reconciliation
		lineageTag: 60753248-d00c-5b19-a443-0fbaffc7d14c

	/// Line Ledger as text.
	measure 'Line Ledger Text' = FORMAT ( CALCULATE ( [Ledger Line Sum] ) + 0, "#,0.00;(#,0.00);–" )
		displayFolder: 6 Reconciliation
		lineageTag: 7a5dba8d-0338-5a5c-86e1-4554bc1a3d65

	/// Line Control as text.
	measure 'Line Control Text' = FORMAT ( [Line Control Value], "#,0.00;(#,0.00);–" )
		displayFolder: 6 Reconciliation
		lineageTag: 70c02cfb-f443-5bad-bd5e-fa4dbc6e96d4

	/// ✓ when heatmap row = ledger = control.
	measure 'Line Mark' = SWITCH ( [Line OK], 1, "✓", 0, "✗" )
		displayFolder: 6 Reconciliation
		lineageTag: 1624a0f6-1e7e-5479-8cc6-eb7b43047fb6

	/// Reconciliation title: period and how many checks tie (statement / KPI rows + heatmap row and ledger per direct line).
	measure 'Recon Header' =
			VAR _key          = [_Ctl Key]
			VAR _checks       =
			    SUMX (
			        CALCULATETABLE ( VALUES ( dim_recon_check[check_code] ), REMOVEFILTERS ( dim_recon_check ) )
			        ,[Recon OK]
			    )
			VAR _nChecks      = COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( dim_recon_check[check_code] ), REMOVEFILTERS ( dim_recon_check ) ), NOT ISBLANK ( [Recon OK] ) ) )
			VAR _lines        =
			    CALCULATETABLE (
			        VALUES ( dim_cf_line[line_code] )
			        ,REMOVEFILTERS ( dim_cf_line )
			        ,dim_cf_line[view] = "DIRECT"
			        ,dim_cf_line[line_kind] = "data"
			    )
			VAR _okLines      = SUMX ( _lines, [Line OK] )
			VAR _nLines       = COUNTROWS ( _lines )
			VAR _ok           = _checks + 2 * _okLines
			VAR _n            = _nChecks + 2 * _nLines
			RETURN
			    IF (
			        _key = "" || ISBLANK ( _key )
			        ,"Reconciliation · " & [Stmt Header Period] & " · control totals exist per month and per year: pick a month, a year or YTD"
			        ,"Reconciliation · " & [Stmt Header Period] & " · " & _ok & " / " & _n & " tie " & IF ( _ok = _n, "✓", "✗" )
			    )
		displayFolder: 6 Reconciliation
		lineageTag: 871c1095-b292-51dc-9a52-5a95a1ce3c06

	/// Selected tile fill (navy, USER round 13).
	measure '_Sel Fill' = "#2C3A54"
		isHidden
		displayFolder: 8 Report
		lineageTag: af939c92-c96f-5f18-b94f-055c6d97d121

	/// Selected tile text.
	measure '_Sel Font' = "#F6F5F2"
		isHidden
		displayFolder: 8 Report
		lineageTag: 71e98275-0430-5e7d-b79c-575654f0f8bf

	/// Month tile text: muted unless the Month span is active and the month has data.
	measure 'Cal Month Font' =
			VAR _m            = SELECTEDVALUE ( param_month[month_num] )
			VAR _live         = [_Span] = "M" && NOT ( [_Year] = 2026 && _m > 10 )
			RETURN
			    IF ( _live, "#2C3A54", "#C2C3C3" )
		isHidden
		displayFolder: 8 Report
		lineageTag: 1075e838-015c-5755-b66c-dbf8129a517f

	/// Quarter tile text: muted unless the Quarter span is active.
	measure 'Cal Quarter Font' = IF ( [_Span] = "Q", "#2C3A54", "#C2C3C3" )
		isHidden
		displayFolder: 8 Report
		lineageTag: 7b42d53b-ea9d-5aa4-bb63-f8ecf76f6647

	/// Year tile text: muted for YTD / QTD / MTD.
	measure 'Cal Year Font' = IF ( [_Span] IN { "A", "Q", "M" }, "#2C3A54", "#C2C3C3" )
		isHidden
		displayFolder: 8 Report
		lineageTag: 9f25319b-1ae1-59ad-be71-80c6284dd85d

	/// S01 pill on the line-of-credit row (override moves it from operating to financing).
	measure 'Stmt S01 Icon' =
			VAR _ovr          = SELECTEDVALUE ( dim_stmt_row[is_override] )
			RETURN
			    IF (
			        ISINSCOPE ( dim_stmt_row[row_label] ) && _ovr = TRUE () && NOT ISBLANK ( [Stmt Value] )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='18' viewBox='0 0 32 18' font-family='Segoe UI, sans-serif'><rect width='32' height='18' rx='9' fill='%23FF6F1A'/><text x='16' y='12.5' font-size='10' font-weight='700' text-anchor='middle' fill='%232C3A54'>S01</text></svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: b1678cd8-8c28-5d7a-a740-23f0bad55b29
		dataCategory: ImageUrl

	/// Cash pop-up title.
	measure 'Cash Title' = "Cash · " & [Stmt Header Period]
		isHidden
		displayFolder: 8 Report
		lineageTag: 454b21b3-52dd-5354-9b23-531d4b805580

	/// Activities card sub-title (period).
	measure 'Activities Period' = [Stmt Header Period]
		isHidden
		displayFolder: 8 Report
		lineageTag: ee83696e-6a30-56e1-b6f9-beed7d1a779a

	column measure_table
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 367ff030-24f5-5ffa-9022-838c36da0e0b
		summarizeBy: none
		isNameInferred
		sourceColumn: [measure_table]

		annotation SummarizationSetBy = User

	partition _measures = calculated
		mode: import
		source = ROW ( "measure_table", 0 )

	annotation PBI_ResultType = Table
