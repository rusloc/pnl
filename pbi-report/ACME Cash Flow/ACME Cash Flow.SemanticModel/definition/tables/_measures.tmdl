			            ,"<tspan fill='%23525C70'>vs " & _pl & ": n/m</tspan>"
			        ,"<tspan font-weight='600' fill='%232C3A54'>" & _arrow & _ad_m & "</tspan><tspan fill='%23525C70' dx='6'>vs " & _pl & "</tspan>"
			    )
