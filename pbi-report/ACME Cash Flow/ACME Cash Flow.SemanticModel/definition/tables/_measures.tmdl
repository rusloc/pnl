			VAR _pv           = CALCULATE ( [KPI Cash Conversion], dim_shift[shift_code] = "PRIOR" )
			VAR _pl           = [_Prior Label]
			VAR _d            = _v - _pv
			VAR _ad           = ABS ( _d )
			VAR _arrow        = IF ( _ad < 0.005, "", IF ( _d > 0, "▲ ", "▼ " ) )
			VAR _v_m = IF ( ISBLANK ( _v ), "n/m", IF ( _v < 0, "−", "" ) & FORMAT ( ABS ( _v ), "0.00" ) & "×" )
			VAR _ad_m = FORMAT ( _ad, "0.00" ) & "×"
			VAR _dl           =
			    SWITCH (
