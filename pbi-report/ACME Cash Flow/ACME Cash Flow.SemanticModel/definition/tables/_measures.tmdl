/// Measure table: every report measure lives here (CLAUDE.md Track B). Folders 1-6 are the report metrics (window = the period picker),
/// 8 Report (texts, colours, SVG faces) and 9 Engine (period resolution, window, units) are hidden.
table _measures
	lineageTag: 47a449ce-26f6-5389-99d8-45273296f060

	/// Picked span: A (Year), Q, M, YTD, QTD, MTD; nothing picked = M.
	measure _Span = SELECTEDVALUE ( param_span[span_code], "M" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 98b1d1ff-8489-5ed1-ab7d-3959de3b093c

	/// Picked year (Year / Quarter / Month spans); nothing picked = 2026.
	measure _Year = SELECTEDVALUE ( param_year[year], 2026 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: cccfb82f-aab1-53ae-a372-d1990a5ad3fb

	/// Picked month 1-12 (Month span); nothing picked = 10.
	measure _Month = SELECTEDVALUE ( param_month[month_num], 10 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 995f9e2b-8790-59dc-9b15-1793545f8c06

	/// Picked quarter 1-4 (Quarter span); nothing picked = 4.
	measure _Quarter = SELECTEDVALUE ( param_quarter[quarter_num], 4 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6b933735-c372-58a1-924a-2f843e444907

	/// param_period key of the picked period (a direct filter on param_period wins: DAX tests). Nov / Dec 2026 have no row: every measure is blank.
	measure '_Period Key' =
			VAR _forced       = IF ( ISFILTERED ( param_period[period_key] ), SELECTEDVALUE ( param_period[period_key] ) )
			VAR _span         = [_Span]
			VAR _y            = [_Year]
			VAR _key          =
			    SWITCH (
			        _span
			        ,"A", "A-" & _y
			        ,"Q", "Q" & [_Quarter] & "-" & _y
			        ,"M", "M-" & _y & "-" & FORMAT ( [_Month], "00" )
			        ,_span
			    )
			RETURN
			    IF ( ISBLANK ( _forced ), _key, _forced )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3aca2f55-1b8e-5906-bb1d-fc30dbc664b5

	/// TRUE inside CALCULATE ( ..., dim_shift[shift_code] = "PRIOR" ): the window moves to the prior period.
	measure _Prior = SELECTEDVALUE ( dim_shift[shift_code], "CUR" ) = "PRIOR"
		isHidden
		displayFolder: 9 Engine
		lineageTag: 31165929-468c-50ad-910b-f65dc57b6036

	/// First month index of the window (0 = 2024-01); prior window under dim_shift PRIOR; blank = no period / no prior.
	measure _A =
			VAR _key          = [_Period Key]
			VAR _prior        = [_Prior]
			VAR _v            =
			    CALCULATE (
			        IF ( _prior, MAX ( param_period[prior_a] ), MAX ( param_period[a] ) )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
			RETURN
			    IF ( _v >= 0, _v )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 399b1ced-616c-510f-9d7c-0ede39a2cb21

	/// Last month index of the window.
	measure _B =
			VAR _key          = [_Period Key]
			VAR _prior        = [_Prior]
			VAR _v            =
			    CALCULATE (
			        IF ( _prior, MAX ( param_period[prior_b] ), MAX ( param_period[b] ) )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
			RETURN
			    IF ( _v >= 0, _v )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: a023e143-c600-53c8-bafb-6664ee4f5962

	/// Control-total period key (M-yyyy-mm / Y-yyyy / ALL) of the picked period; empty for quarters.
	measure '_Ctl Key' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[ctl_key] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 82e60d5a-1545-56f2-be06-d9dd0025bae9

	/// Period label as the mock: Oct 2026, Q4 2026, 2026, YTD Oct 2026.
	measure '_Period Label' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[label] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 62ca7602-639d-5e17-b335-75ed9bb2ee83

	/// Prior-period label of the KPI deltas (Sep 2026, Q3 2026, 2025, Jan–Oct 2025, YTD 2025).
	measure '_Prior Label' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[prior_label] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: d5728ba6-83b1-5372-9b6a-49ae39dd9c52

	/// Badge line 1: Month / Quarter / Year / YTD / QTD / MTD.
	measure '_Mode Name' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[mode_name] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 68b3cc79-2d67-54ce-b836-23b9aedcef7d

	/// Badge line 2: Oct / Q4 / 2026.
	measure '_Badge Big' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[badge_big] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6a586ad7-57a1-5ff8-b86e-6d9998d31f8d

	/// Badge line 3: 2026 or the year's months (Jan–Oct).
	measure '_Badge Small' =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[badge_small] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9b63af37-52c1-5320-9ce5-1a99a7f0d4bb

	/// 1 when a quarter or year is cut by the data end (to date).
	measure _Partial =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[partial] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 8c87d8da-b48c-58b8-870f-f83ebfe05fd1

	/// First day of the window.
	measure _D0 =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[d0] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: d6c4d06b-ec7a-5200-8de8-2174f917da98

	/// Last day of the window.
	measure _D1 =
			VAR _key          = [_Period Key]
			RETURN
			    CALCULATE (
			        MAX ( param_period[d1] )
			        ,REMOVEFILTERS ( param_period )
			        ,param_period[period_key] = _key
			    )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: b61c542b-4d99-5ab9-a7c8-52284abd8516

	/// Calendar days in the window (DSO / DPO day count).
	measure _Days =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,CALCULATE (
			            COUNTROWS ( dim_date )
			            ,REMOVEFILTERS ( dim_date )
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			        )
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9d5ed2fe-c9a6-59a4-b605-6567ea51d1ce

	/// TRUE when Units = USD k (display units in DAX, CLAUDE.md Track B).
	measure '_Is K' = SELECTEDVALUE ( param_units[unit_code], "USD" ) = "USDK"
		isHidden
		displayFolder: 9 Engine
		lineageTag: ac63f3e4-8f7b-5610-8136-3798924eeda8

	/// Display divisor: 1 (USD) or 1,000 (USD k).
	measure _Div = IF ( [_Is K], 1000, 1 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 0fe478c9-cb86-5117-ac88-c10a2b2e6a80

	/// Cash at the start of the window: Bank + Undeposited Funds opening balance of the first month (QBO cash set). (spec M01)
	measure 'Opening Cash' =
			VAR _a            = [_A]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_account_balance[opening_balance] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[is_cash] = TRUE ()
			            ,fact_account_balance[month_index] = _a
			        )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 82c6a946-7667-5c5f-9aef-5c9b04971755

	/// Cash at the end of the window: cash-set closing balance of the last month. (spec M02)
	measure 'Closing Cash' =
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _b )
			        ,0 + CALCULATE (
			            SUM ( fact_account_balance[closing_balance] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[is_cash] = TRUE ()
			            ,fact_account_balance[month_index] = _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 5d520ebe-90e8-5267-9e25-7a8c02e0ca6d

	/// Closing less opening cash; equals operating + investing + financing. (spec M03)
	measure 'Net Change in Cash' =
			VAR _open         = [Opening Cash]
			VAR _close        = [Closing Cash]
			RETURN
			    IF ( NOT ISBLANK ( _open ), _close - _open )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: a65f2f04-879b-516c-baac-b14cc63ab7e7

	/// Accrual net income of the window: minus the net change of every P&L account (ledger is debit positive). (spec M04)
	measure 'Net Income' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 - CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[is_pl] = TRUE ()
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: b4e7df3d-eac3-5f07-8545-51c2fdb21393

	/// Income-type accounts (credit as positive) over the window. (spec REVENUE)
	measure Revenue =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 - CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_type] = "Income"
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 4cedf253-351a-57c9-b480-cdc6a2ee0cb7

	/// Operating / investing / financing adjustment of the statement accounts in context: minus the change of the debit balance (asset up = cash out). (spec M05)
	measure 'Account Adjustment' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			VAR _acc          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[row_kind] = "ACC"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 - CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,KEEPFILTERS ( TREATAS ( _acc, dim_account[account_id] ) )
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 2556fcec-d930-5ee4-9265-d4f246c0ba81

	/// Total adjustments to reconcile net income: depreciation + working-capital accounts. (spec M06 − M04)
	measure 'Operating Adjustments' =
			VAR _acc          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[row_kind] = "ACC"
			        ,dim_stmt_row[section_code] = "OP"
			    )
			RETURN
			    CALCULATE (
			        [Account Adjustment]
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _acc, dim_account[account_id] )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 6c1d7ebd-bf81-51e9-93f5-ec55bdca6db2

	/// Net cash from investing activities (indirect). (spec M07)
	measure 'Investing Cash Flow' =
			VAR _acc          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[row_kind] = "ACC"
			        ,dim_stmt_row[section_code] = "INV"
			    )
			RETURN
			    CALCULATE (
			        [Account Adjustment]
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _acc, dim_account[account_id] )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 913bb214-4bfd-571f-944c-c1a88b066a7c

	/// Net cash from financing activities (indirect, line of credit moved here by S01). (spec M08)
	measure 'Financing Cash Flow' =
			VAR _acc          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[row_kind] = "ACC"
			        ,dim_stmt_row[section_code] = "FIN"
			    )
			RETURN
			    CALCULATE (
			        [Account Adjustment]
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _acc, dim_account[account_id] )
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: e3a9c6ca-4250-5908-b2e6-304bbe6c58bd

	/// Net cash from operating activities: net income + adjustments (indirect, overrides on). (spec M06)
	measure 'Operating Cash Flow' =
			VAR _ni           = [Net Income]
			RETURN
			    IF ( NOT ISBLANK ( _ni ), _ni + [Operating Adjustments] )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 4932bf5e-da0d-5406-9e8a-67c372604b2c

	/// Statement row value in USD: section header = its total, Net income, one row per account (hidden when it did not move), Total adjustments, Net cash from the section.
	measure 'Stmt Value' =
			VAR _a            = [_A]
			VAR _leaf         = HASONEVALUE ( dim_stmt_row[row_label] )
			VAR _sec          = SELECTEDVALUE ( dim_stmt_row[section_code] )
			VAR _kind         = SELECTEDVALUE ( dim_stmt_row[row_kind] )
			VAR _acc          = SELECTEDVALUE ( dim_stmt_row[account_id] )
			VAR _sect         =
			    SWITCH (
			        _sec
			        ,"OP", [Operating Cash Flow]
			        ,"INV", [Investing Cash Flow]
			        ,"FIN", [Financing Cash Flow]
			    )
			VAR _v            =
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _a )
			            ,BLANK ()
			        ,NOT _leaf
			            ,_sect
			        ,_kind = "NI"
			            ,[Net Income]
			        ,_kind = "ACC"
			            ,CALCULATE ( [Account Adjustment], dim_account[account_id] = _acc )
			        ,_kind = "TOT"
			            ,[Operating Adjustments]
			        ,_kind = "SECT"
			            ,_sect
			    )
			VAR _hide         = _kind = "ACC" && _leaf && ABS ( _v ) < 0.005
			RETURN
			    IF ( NOT _hide, _v )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: ddcbd52e-eecf-5b1b-ba36-27060e276dd2

	/// Statement amount in the picked units (cash out in parentheses, zero = –).
	measure 'Stmt Amount' = DIVIDE ( [Stmt Value], [_Div] )
		displayFolder: 1 Statement
		lineageTag: 08070faf-2428-5e58-89e9-6c9b98213a8e

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0;(#,0);–" )

	/// Row as a share of net income (net income = 100 %), sign kept as parentheses, 1 dp under 10 %; n/m on every row when net income ≤ 0.
	measure 'Stmt % of NI' =
			VAR _v            = [Stmt Value]
			VAR _ni           = [Net Income]
			VAR _x            = DIVIDE ( _v, _ni ) * 100
			VAR _ax           = ABS ( _x )
			VAR _t            = IF ( _ax < 10, FORMAT ( _ax, "0.0" ), FORMAT ( _ax, "#,0" ) ) & "%"
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,BLANK ()
			        ,_ni <= 0.005
			            ,"n/m"
			        ,_x < 0 && _t <> "0.0%"
			            ,"(" & _t & ")"
			        ,_t
			    )
		displayFolder: 1 Statement
		lineageTag: abd649f0-e09f-51d4-b300-a3187b94e1a6

	/// Working-capital rows that moved in the window (the 'Changes in operating assets and liabilities' sub-header shows only when > 0).
	measure '_WC Rows' =
			VAR _ids          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[sub_kind] = "WC"
			    )
			VAR _t            =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dim_account[account_id] ), "@v", [Account Adjustment] )
			        ,REMOVEFILTERS ( dim_account )
			        ,TREATAS ( _ids, dim_account[account_id] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _t, ABS ( [@v] ) >= 0.005 ) ) + 0
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: e2923294-2ce1-5918-b857-91f2512cd13a

	/// Shared bar axis of the statement: the mock's niceMax of the largest flow row (balances excluded; they clip with a notch).
	measure '_Stmt Axis Max' =
			VAR _ids          =
			    CALCULATETABLE (
			        VALUES ( dim_stmt_row[account_id] )
			        ,REMOVEFILTERS ( dim_stmt_row )
			        ,dim_stmt_row[row_kind] = "ACC"
			    )
			VAR _acc          =
			    MAXX (
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( dim_account[account_id] ), "@v", ABS ( [Account Adjustment] ) )
			            ,REMOVEFILTERS ( dim_account )
			            ,TREATAS ( _ids, dim_account[account_id] )
			        )
			        ,[@v]
			    )
			VAR _m            =
			    MAXX (
			        {
			            _acc
			            ,ABS ( [Net Income] )
			            ,ABS ( [Operating Adjustments] )
			            ,ABS ( [Operating Cash Flow] )
			            ,ABS ( [Investing Cash Flow] )
			            ,ABS ( [Financing Cash Flow] )
			            ,ABS ( [Net Change in Cash] )
			        }
			        ,[Value]
			    )
			VAR _e            = POWER ( 10, INT ( LOG10 ( MAX ( _m, 1 ) ) ) )
			VAR _f            = MINX ( FILTER ( { 1, 1.25, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10 }, [Value] * _e >= _m ), [Value] )
			RETURN
			    IF ( _m > 0, _f * _e, 1 )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine
		lineageTag: fbe5b46b-2056-57c2-be2c-912c00956b76

	/// Statement bar: absolute row amount on one shared axis (grey #8A8986, 12 px), axis grid at 25 / 50 / 75 / 100 %; keeps the sub-header rows alive.
	measure 'Stmt Bar' =
			VAR _a            = [_A]
			VAR _leaf         = ISINSCOPE ( dim_stmt_row[row_label] )
			VAR _kind         = SELECTEDVALUE ( dim_stmt_row[row_kind] )
			VAR _sub          = SELECTEDVALUE ( dim_stmt_row[sub_kind] )
			VAR _v            = [Stmt Value]
			VAR _max          = [_Stmt Axis Max]
			VAR _len          = IF ( NOT ISBLANK ( _v ), MIN ( ABS ( _v ) / _max, 1 ) * 566, 0 )
			VAR _bar          =
			    IF (
			        _len >= 0.5
			        ,"<rect x='20' y='7' width='" & FORMAT ( _len, "0.0" ) & "' height='12' rx='2' fill='%238A8986'/>"
			    )
			VAR _show         =
			    NOT ISBLANK ( _a )
			        && (
			            NOT ISBLANK ( _v )
			            || ( _leaf && _kind = "SUB" && ( _sub = "ADJ" || [_WC Rows] > 0 ) )
			        )
			RETURN
			    IF (
			        _show
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='602' height='26' viewBox='0 0 602 26'><rect x='161.5' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='303.0' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='444.5' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='585.5' y='0' width='1' height='26' fill='%23D9D7D4'/>" & _bar & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: 9942ee79-ad9a-53f5-80af-4217f2bd7966
		dataCategory: ImageUrl

	/// Pinned rows: cash at beginning, net increase (decrease), cash at end.
	measure 'Bal Value' =
			VAR _code         = SELECTEDVALUE ( dim_bal_row[row_code] )
			RETURN
			    SWITCH (
			        _code
			        ,"OPEN", [Opening Cash]
			        ,"NET", [Net Change in Cash]
			        ,"CLOSE", [Closing Cash]
			    )
		formatString: #,0.00
		displayFolder: 1 Statement
		lineageTag: 3e2bf972-3dc7-54cf-bcc5-7e99bcd30dd2

	/// Pinned row amount in the picked units.
	measure 'Bal Amount' = DIVIDE ( [Bal Value], [_Div] )
		displayFolder: 1 Statement
		lineageTag: bf0e9824-50c7-570c-9fd3-d655aaac3520

		formatStringDefinition =
				IF ( [_Is K], "#,0.0;(#,0.0);–", "#,0;(#,0);–" )

	/// % of net income on the net-increase row only (opening and closing cash have none).
	measure 'Bal % of NI' =
			VAR _code         = SELECTEDVALUE ( dim_bal_row[row_code] )
			VAR _v            = [Bal Value]
			VAR _ni           = [Net Income]
			VAR _x            = DIVIDE ( _v, _ni ) * 100
			VAR _ax           = ABS ( _x )
			VAR _t            = IF ( _ax < 10, FORMAT ( _ax, "0.0" ), FORMAT ( _ax, "#,0" ) ) & "%"
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_code <> "NET" || ISBLANK ( _v )
			            ,UNICHAR ( 160 )
			        ,_ni <= 0.005
			            ,"n/m"
			        ,_x < 0 && _t <> "0.0%"
			            ,"(" & _t & ")"
			        ,_t
			    )
		displayFolder: 1 Statement
		lineageTag: 5724cbed-8a39-5a83-b0c9-955ae09e7f1e

	/// Pinned-row bar length as a share of the bar width: opening and closing on their own scale (full = the larger of the two), net increase on the line axis.
	measure 'Bal Bar Ratio' =
			VAR _code         = SELECTEDVALUE ( dim_bal_row[row_code] )
			VAR _v            = ABS ( [Bal Value] )
			VAR _balMax       = MAX ( ABS ( [Opening Cash] ), ABS ( [Closing Cash] ) )
			VAR _max          = IF ( _code = "NET", [_Stmt Axis Max], _balMax )
			RETURN
			    IF ( NOT ISBLANK ( [Bal Value] ), MIN ( DIVIDE ( _v, _max ), 1 ) )
		formatString: 0.0000
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6dc5ac06-5316-5eeb-bad1-246698f44168

	/// Pinned-row bar: opening / closing dark #2C3A54 on their own scale (full width = the larger balance, round 2); net increase grey on the line axis.
	measure 'Bal Bar' =
			VAR _code         = SELECTEDVALUE ( dim_bal_row[row_code] )
			VAR _r            = [Bal Bar Ratio]
			VAR _isBal        = _code <> "NET"
			VAR _len          = _r * 566
			VAR _fill         = IF ( _isBal, "%232C3A54", "%238A8986" )
			VAR _bar          =
			    IF (
			        _len >= 0.5
			        ,"<rect x='20' y='7' width='" & FORMAT ( _len, "0.0" ) & "' height='12' rx='2' fill='" & _fill & "'/>"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _r )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='602' height='26' viewBox='0 0 602 26'>" & IF ( _isBal, "", "<rect x='161.5' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='303.0' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='444.5' y='0' width='1' height='26' fill='%23D9D7D4'/><rect x='585.5' y='0' width='1' height='26' fill='%23D9D7D4'/>" ) & _bar & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: 1c521e78-503c-5ede-b542-8932d65ecdbc
		dataCategory: ImageUrl

	/// Net cash of the direct lines in context (all lines when none), window, internal transfers excluded. (spec DIRECT_LINE / M11)
	measure 'Direct Net' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,REMOVEFILTERS ( dim_counterparty )
			            ,REMOVEFILTERS ( fact_txn )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: bb9e5c3d-26f5-583d-ae8a-87f7e2d8972a

	/// Cash in of the direct lines in context. (spec M09)
	measure 'Direct In' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,REMOVEFILTERS ( dim_counterparty )
			            ,REMOVEFILTERS ( fact_txn )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			            ,fact_cash_posting[amount] > 0
			        )
			    )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: ccefbb0a-70b5-56d0-b4f2-cfa9e2c46e00

	/// Cash out of the direct lines in context (negative). (spec M10)
	measure 'Direct Out' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,REMOVEFILTERS ( dim_counterparty )
			            ,REMOVEFILTERS ( fact_txn )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			            ,fact_cash_posting[amount] < 0
			        )
			    )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 03ea71c8-1668-5389-a07c-e55dd486bc7e

	/// Cash in, all lines (cash balance card). (spec M09)
	measure 'Cash In' = CALCULATE ( [Direct In], REMOVEFILTERS ( dim_cf_line ) )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 081cf769-db2d-520d-9349-9e3e624bdde9

	/// Cash out, all lines (negative). (spec M10)
	measure 'Cash Out' = CALCULATE ( [Direct Out], REMOVEFILTERS ( dim_cf_line ) )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 9e5fee38-f693-5dd9-899f-1748aacea070

	/// Cash in + cash out (= net change, check C06). (spec M11)
	measure 'Net Cash Direct' = CALCULATE ( [Direct Net], REMOVEFILTERS ( dim_cf_line ) )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 24478513-3ed7-5356-8f56-610cd93be32b

	/// Postings between cash-set accounts (nets to 0, check C09). (spec M12)
	measure 'Internal Transfers' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,REMOVEFILTERS ( dim_cf_line )
			            ,REMOVEFILTERS ( dim_counterparty )
			            ,REMOVEFILTERS ( fact_txn )
			            ,fact_cash_posting[is_internal_transfer] = TRUE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 4c1931a6-7adb-57d8-95d3-d5c08028c1e7

	/// Fixed-asset purchases as a positive amount (minus the Purchase of fixed assets line).
	measure Capex =
			0 - CALCULATE (
			    [Direct Net]
			    ,REMOVEFILTERS ( dim_cf_line )
			    ,dim_cf_line[line_code] = "D_INV_PURCHASE"
			)
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: f5041423-082c-5b2f-98cb-9d47deb73705

	/// Proceeds from asset sales.
	measure 'Asset Sale Proceeds' =
			CALCULATE (
			    [Direct Net]
			    ,REMOVEFILTERS ( dim_cf_line )
			    ,dim_cf_line[line_code] = "D_INV_PROCEEDS"
			)
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 412bb36f-3bd1-54a4-9c90-a45d4ba82cf1

	/// Interest paid as a positive amount.
	measure 'Interest Paid' =
			0 - CALCULATE (
			    [Direct Net]
			    ,REMOVEFILTERS ( dim_cf_line )
			    ,dim_cf_line[line_code] = "D_PAY_INT"
			)
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 6e155f49-c9e1-5e44-92f2-4de3949873cd

	/// Owner draws and dividends as a positive amount.
	measure 'Owner Draws' =
			0 - CALCULATE (
			    [Direct Net]
			    ,REMOVEFILTERS ( dim_cf_line )
			    ,dim_cf_line[line_code] = "D_FIN_DRAWS"
			)
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 690e3d63-ab8b-56e4-b17e-27cd5ccc6231

	/// Principal repaid on the term and vehicle loans (accounts 22, 23); the revolver (line of credit) is left out, as the mock's DSCR base.
	measure 'Term Principal Repaid' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 - CALCULATE (
			            SUM ( fact_cash_posting[amount] )
			            ,REMOVEFILTERS ( dim_date )
			            ,REMOVEFILTERS ( dim_counterparty )
			            ,REMOVEFILTERS ( fact_txn )
			            ,fact_cash_posting[is_internal_transfer] = FALSE ()
			            ,dim_date[month_index] >= _a
			            ,dim_date[month_index] <= _b
			            ,REMOVEFILTERS ( dim_cf_line )
			            ,dim_cf_line[line_code] = "D_FIN_REPAID"
			            ,fact_cash_posting[offset_account_id] IN { 22, 23 }
			        )
			    )
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: fedcdacf-66ed-5706-afad-914074ccca13

	/// Statement section total less the direct section net: the non-cash movements of the section (sums to 0 over the three). (spec M13)
	measure 'Non-Cash Gap' =
			VAR _sec          = SELECTEDVALUE ( dim_cf_line[section_code] )
			VAR _ind          =
			    SWITCH (
			        _sec
			        ,"OPERATING", [Operating Cash Flow]
			        ,"INVESTING", [Investing Cash Flow]
			        ,"FINANCING", [Financing Cash Flow]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _ind ), _ind - [Direct Net] )
		formatString: #,0.00
		displayFolder: 3 Direct and activities
		lineageTag: 179b3560-5aa3-52f6-a441-0e910d76ae41

	/// Operating cash flow less fixed-asset purchases plus asset-sale proceeds. (spec M15)
	measure 'Free Cash Flow' = [Operating Cash Flow] - [Capex] + [Asset Sale Proceeds]
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: f377cd5f-7694-5516-8d59-7b876079ebfe

	/// Operating cash flow ÷ net income (the KPI card shows n/m when net income ≤ 0). (spec M16)
	measure 'Cash Conversion' =
			VAR _ni           = [Net Income]
			RETURN
			    IF ( ABS ( _ni ) > 0.005, DIVIDE ( [Operating Cash Flow], _ni ) )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 0bd48b82-e2c8-558e-ba6c-01f8882ac74e

	/// Operating cash flow ÷ revenue. (spec M17)
	measure 'Operating Cash Margin' =
			VAR _rev          = [Revenue]
			RETURN
			    IF ( _rev > 0, DIVIDE ( [Operating Cash Flow], _rev ) )
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: f83499f6-f597-52aa-a1fc-1239fddea340

	/// A/R closing balance at the window end (debit positive).
	measure 'AR Closing' =
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _b )
			        ,CALCULATE (
			            SUM ( fact_account_balance[closing_balance] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_id] = 4
			            ,fact_account_balance[month_index] = _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 56d696b8-c5ee-5595-8fc5-da5b701647db

	/// A/P closing balance at the window end (credit as positive).
	measure 'AP Closing' =
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _b )
			        ,0 - CALCULATE (
			            SUM ( fact_account_balance[closing_balance] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_id] = 14
			            ,fact_account_balance[month_index] = _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 1c464f4d-a916-55b6-9087-0a158f4e2848

	/// Line of credit + term loan + vehicle loan at the window end (credit as positive).
	measure 'Debt Closing' =
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _b )
			        ,0 - CALCULATE (
			            SUM ( fact_account_balance[closing_balance] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_id] IN { 20, 22, 23 }
			            ,fact_account_balance[month_index] = _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 655beec4-f1e7-5877-96c3-b41045172ab3

	/// DPO base: cost of services + expenses without payroll, bad debts and interest (mock kpi.spend).
	measure 'Bills Spend' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_type] IN { "Cost of Goods Sold", "Expense" }
			            ,NOT dim_account[account_id] IN { 38, 39, 40, 41, 58, 59 }
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 2a1f3541-1a36-57fa-8d0d-3926d1582868

	/// Interest expense (P&L) for EBITDA.
	measure 'Interest Expense' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_id] = 59
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: da94a061-a9ad-5268-a411-9441a4fc3739

	/// Depreciation expense (P&L) for EBITDA.
	measure 'Depreciation Expense' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,0 + CALCULATE (
			            SUM ( fact_account_balance[net_change] )
			            ,REMOVEFILTERS ( dim_account )
			            ,dim_account[account_id] = 60
			            ,fact_account_balance[month_index] >= _a
			            ,fact_account_balance[month_index] <= _b
			        )
			    )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 33e2457a-794c-5327-a4e9-8879a32a51fa

	/// Days of revenue in receivables at the window end: A/R closing ÷ revenue × days.
	measure 'DSO Days' =
			VAR _rev          = [Revenue]
			RETURN
			    IF ( _rev > 0, [AR Closing] / _rev * [_Days] )
		formatString: 0.0
		displayFolder: 2 KPIs
		lineageTag: 5e5d8d3a-f7da-55af-96b6-1c08d905d480

	/// A/P closing ÷ bills spend × days (open question: DPO base).
	measure 'DPO Days' =
			VAR _sp           = [Bills Spend]
			RETURN
			    IF ( _sp > 0, [AP Closing] / _sp * [_Days] )
		formatString: 0.0
		displayFolder: 2 KPIs
		lineageTag: 42e624fc-6f1f-580a-ac51-0b5818a085f4

	/// DSO − DPO (no inventory).
	measure 'Cash Conversion Cycle' =
			VAR _dso          = [DSO Days]
			VAR _dpo          = [DPO Days]
			RETURN
			    IF ( NOT ISBLANK ( _dso ) && NOT ISBLANK ( _dpo ), _dso - _dpo )
		formatString: 0.0
		displayFolder: 2 KPIs
		lineageTag: 5a479dc8-7fe8-5212-a667-959820c8a76d

	/// Net income − operating cash flow.
	measure Accruals =
			VAR _ni           = [Net Income]
			RETURN
			    IF ( NOT ISBLANK ( _ni ), _ni - [Operating Cash Flow] )
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 5b488e59-7a08-5b01-a356-99508d5c9185

	/// Capex ÷ revenue.
	measure 'Capex Intensity' =
			VAR _rev          = [Revenue]
			RETURN
			    IF ( _rev > 0, [Capex] / _rev )
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: c8728c14-bc19-5c4d-94a4-ff01a9647da8

	/// Operating cash flow ÷ capex ('no capex' when none).
	measure 'Capex Coverage' =
			VAR _cx           = [Capex]
			RETURN
			    IF ( _cx > 0.005, [Operating Cash Flow] / _cx )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 7f301014-95a9-56b6-b62f-32f9ecdf938e

	/// Interest paid + term-loan principal (revolver excluded, open question).
	measure 'Debt Service' = [Interest Paid] + [Term Principal Repaid]
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 584bc034-3ac4-508e-a5b6-d21f53698a90

	/// Debt service coverage: operating cash flow ÷ (interest + term principal).
	measure DSCR =
			VAR _ds           = [Debt Service]
			RETURN
			    IF ( _ds > 0.005, [Operating Cash Flow] / _ds )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: a9d7efba-ae71-560c-a921-26154aa199af

	/// Net income + interest expense + depreciation (P&L).
	measure EBITDA = [Net Income] + [Interest Expense] + [Depreciation Expense]
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: aefe5f32-2287-55df-ab97-4179bc507c6b

	/// EBITDA × 12 ÷ months in the window (open question: annualised EBITDA).
	measure 'EBITDA Annualised' =
			VAR _a            = [_A]
			VAR _b            = [_B]
			RETURN
			    IF ( NOT ISBLANK ( _a ), [EBITDA] * 12 / ( _b - _a + 1 ) )
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: 7bb7abe7-3bee-513b-b413-378d00aa29da

	/// Debt at the window end less closing cash (negative = net cash).
	measure 'Net Debt' =
			VAR _d            = [Debt Closing]
			RETURN
			    IF ( NOT ISBLANK ( _d ), _d - [Closing Cash] )
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: eb8e7aa0-4e18-5bcf-a9b9-9cf9534a52a1

	/// Net debt ÷ annualised EBITDA.
	measure 'Net Debt to EBITDA' =
			VAR _e            = [EBITDA Annualised]
			RETURN
			    IF ( _e > 0.005, [Net Debt] / _e )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: e6f980bc-dd3b-5072-a9da-fe0484874a2f

	/// Operating cash flow ÷ owner draws ('no draws' when none).
	measure 'Payout Cover' =
			VAR _dr           = [Owner Draws]
			RETURN
			    IF ( _dr > 0.005, [Operating Cash Flow] / _dr )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 4589332c-866c-5f1a-8e77-89b7c234c898

	/// Cash conversion as the KPI card shows it: blank (n/m) when net income ≤ 0.
	measure 'KPI Cash Conversion' =
			VAR _ni           = [Net Income]
			RETURN
			    IF ( _ni > 0.005, DIVIDE ( [Operating Cash Flow], _ni ) )
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 061d3483-b2d3-59e5-9c39-b6e68261541c

	/// KPI card 'Closing cash' (mock .kpi): value in the picked units, delta vs the prior period (▲ / ▼ absolute), 'no prior period' at the data start.
	measure 'KPI Card close' =
			VAR _a            = [_A]
			VAR _v            = [Closing Cash]
			VAR _hasPrior     = NOT ISBLANK ( CALCULATE ( [_A], dim_shift[shift_code] = "PRIOR" ) )
			VAR _pv           = CALCULATE ( [Closing Cash], dim_shift[shift_code] = "PRIOR" )
			VAR _pl           = [_Prior Label]
			VAR _d            = _v - _pv
			VAR _ad           = ABS ( _d )
			VAR _arrow        = IF ( _ad < 0.005, "", IF ( _d > 0, "▲ ", "▼ " ) )
			VAR _v_s = IF ( [_Is K], FORMAT ( ABS ( _v ) / 1000, "#,0.0" ), FORMAT ( ABS ( _v ), "#,0" ) )
			VAR _v_t = _v_s & IF ( [_Is K] && TRUE (), "k" )
			VAR _v_m = IF ( ISBLANK ( _v ) || _v_s IN { "0", "0.0", "0.00" }, "–", IF ( _v < 0, "(" & _v_t & ")", _v_t ) )
			VAR _ad_s = IF ( [_Is K], FORMAT ( ABS ( _ad ) / 1000, "#,0.0" ), FORMAT ( ABS ( _ad ), "#,0" ) )
			VAR _ad_t = _ad_s & IF ( [_Is K] && TRUE (), "k" )
			VAR _ad_m = IF ( ISBLANK ( _ad ) || _ad_s IN { "0", "0.0", "0.00" }, "–", IF ( _ad < 0, "(" & _ad_t & ")", _ad_t ) )
			VAR _dl           =
			    SWITCH (
			        TRUE ()
			        ,NOT _hasPrior
			            ,"<tspan fill='%23525C70'>no prior period</tspan>"
			        ,ISBLANK ( _v ) || ISBLANK ( _pv )
			            ,"<tspan fill='%23525C70'>vs " & _pl & ": n/m</tspan>"
			        ,"<tspan font-weight='600' fill='%232C3A54'>" & _arrow & _ad_m & "</tspan><tspan fill='%23525C70' dx='6'>vs " & _pl & "</tspan>"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _a )
			        ,"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='225' height='84' viewBox='0 0 225 84' font-family='Segoe UI, sans-serif'>"
			            & "<rect x='0.5' y='0.5' width='224' height='83' rx='14' fill='%23E8E5DF' stroke='%23D9D7D4'/>"
			            & "<text x='14' y='25' font-size='12' font-weight='500' fill='%23525C70'>Closing cash</text>"
			            & "<text x='14' y='52' font-size='21' font-weight='600' fill='%232C3A54' letter-spacing='-0.4'>" & _v_m & "</text>"
			            & "<text x='14' y='72' font-size='11.5'>" & _dl & "</text>"
