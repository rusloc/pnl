			            & "<text x='14' y='25' font-size='12' font-weight='500' fill='%23525C70'>Net change</text>"
			            & "<text x='14' y='52' font-size='21' font-weight='600' fill='%232C3A54' letter-spacing='-0.4'>" & _v_m & "</text>"
			            & "<text x='14' y='72' font-size='11.5'>" & _dl & "</text>"
			            & "</svg>"
			    )
		isHidden
		displayFolder: 8 Report
		lineageTag: e898489e-e1a5-530b-9d4d-80e38df83733
		dataCategory: ImageUrl

