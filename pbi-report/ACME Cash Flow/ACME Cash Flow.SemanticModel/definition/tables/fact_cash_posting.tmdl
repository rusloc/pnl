	column memo
		dataType: string
		isHidden
		lineageTag: 241330ed-a43e-56b5-94af-bcbe7c21d996
		summarizeBy: none
		sourceColumn: memo

		annotation SummarizationSetBy = User

	/// In when amount > 0, else Out (a ledger row never mixes both).
	column direction
		dataType: string
		lineageTag: d72e9097-d8c4-517f-a84c-8addc672a157
		summarizeBy: none
		sourceColumn: direction

		annotation SummarizationSetBy = User

	/// Ledger memo of the row (mock build-mock-v2-data.py): the first non-empty posting memo of the row, else the transaction note, else the settled document ('Invoice 1043 + 2 more').
	column ledger_memo =
			VAR _txn          = fact_cash_posting[txn_id]
			VAR _line         = fact_cash_posting[direct_line_code]
			VAR _cp           = fact_cash_posting[counterparty_id]
			VAR _dir          = fact_cash_posting[direction]
			VAR _grp          =
			    FILTER (
			        fact_cash_posting
			        ,fact_cash_posting[txn_id] = _txn
			            && fact_cash_posting[direct_line_code] = _line
			            && fact_cash_posting[counterparty_id] = _cp
			            && fact_cash_posting[direction] = _dir
			            && fact_cash_posting[is_internal_transfer] = FALSE ()
			    )
			VAR _memos        = FILTER ( _grp, fact_cash_posting[memo] <> "" )
			VAR _firstMemo    = MINX ( _memos, fact_cash_posting[posting_id] )
			VAR _memo         = MAXX ( FILTER ( _memos, fact_cash_posting[posting_id] = _firstMemo ), fact_cash_posting[memo] )
			VAR _note         = LOOKUPVALUE ( fact_txn[private_note], fact_txn[txn_id], _txn )
			VAR _docs         =
			    ADDCOLUMNS (
			        GROUPBY ( FILTER ( _grp, NOT ISBLANK ( fact_cash_posting[settled_txn_id] ) ), fact_cash_posting[settled_txn_id] )
			        ,"@first", CALCULATE ( MIN ( fact_cash_posting[posting_id] ), FILTER ( _grp, fact_cash_posting[settled_txn_id] = EARLIER ( fact_cash_posting[settled_txn_id] ) ) )
			    )
			VAR _n            = COUNTROWS ( _docs )
			VAR _d0           = MAXX ( TOPN ( 1, _docs, [@first], ASC ), fact_cash_posting[settled_txn_id] )
			VAR _dType        = LOOKUPVALUE ( fact_txn[txn_type], fact_txn[txn_id], _d0 )
			VAR _dNo          = LOOKUPVALUE ( fact_txn[doc_number], fact_txn[txn_id], _d0 )
			VAR _docText      = _dType & " " & IF ( ISBLANK ( _dNo ) || _dNo = "", FORMAT ( _d0, "0" ), _dNo ) & IF ( _n > 1, " + " & ( _n - 1 ) & " more" )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,NOT ISBLANK ( _memo ) && _memo <> ""
			            ,_memo
			        ,NOT ISBLANK ( _note ) && _note <> ""
			            ,_note
			        ,_n > 0
			            ,_docText
			        ,"–"
			    )
		dataType: string
		lineageTag: 14177f94-5c3e-547d-b5ea-4310811f3b53
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition fact_cash_posting = m
		mode: import
		source =
				let
				    // Portable source (ADR-0014 / ADR-0015 pattern): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_cash_posting.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"posting_id", Int64.Type},
				            {"txn_id", Int64.Type},
				            {"txn_date", type date},
				            {"month_key", type text},
				            {"source_type", type text},
				            {"cash_account_id", Int64.Type},
				            {"cash_kind", type text},
				            {"offset_ledger_seq", Int64.Type},
				            {"posting_account_id", Int64.Type},
				            {"offset_account_id", Int64.Type},
				            {"settled_txn_id", Int64.Type},
				            {"settled_ledger_seq", Int64.Type},
				            {"counterparty_id", Int64.Type},
				            {"counterparty_source", type text},
				            {"class_id", Int64.Type},
				            {"amount", type number},
				            {"is_internal_transfer", type logical},
				            {"direct_line_code", type text},
				            {"default_direct_line_code", type text},
				            {"in_bank_view", type logical},
				            {"bank_view_line_code", type text},
				            {"cleared_status", type text},
				            {"cleared_date", type date},
				            {"is_journal_entry", type logical},
				            {"memo", type text}
				        }
				    ),
				    add_dir = Table.AddColumn(typed, "direction", each if [amount] > 0 then "In" else "Out", type text)
				in
				    add_dir

	annotation PBI_ResultType = Table
