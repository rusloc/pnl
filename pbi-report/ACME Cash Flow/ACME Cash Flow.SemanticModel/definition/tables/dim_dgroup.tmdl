/// Diagram KPI groups (mock GROUPS): picking a group shows its three metrics. Disconnected.
table dim_dgroup
	lineageTag: 5f2d4cae-ebba-5080-b4f7-af1d59ebaf60

	column group_code
		dataType: string
		isHidden
		lineageTag: f4b03355-815d-5a1a-9e2b-5d0cff46a2c7
		summarizeBy: none
		isNameInferred
		sourceColumn: [group_code]

		annotation SummarizationSetBy = User

	column group_name
		dataType: string
		lineageTag: c9d32420-9911-5630-91f4-03b595342601
		summarizeBy: none
		isNameInferred
		sourceColumn: [group_name]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 392cfa39-2257-5bab-8158-ca255a149859
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition dim_dgroup = calculated
		mode: import
		source =
				DATATABLE (
				    "group_code", STRING
				    ,"group_name", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "quality", "Cash quality", 1 }
				        ,{ "wc", "Working capital", 2 }
				        ,{ "fcf", "FCF and investment", 3 }
				        ,{ "lev", "Leverage and coverage", 4 }
				    }
				)

	annotation PBI_ResultType = Table
