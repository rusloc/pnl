				            {"direct_line_out", type text},
				            {"sort_order", Int64.Type},
				            {"active", type logical},
				            {"current_balance", type number},
				            {"last_reconciled_date", type date},
				            {"cash_floor", type number}
				        }
				    )
				in
				    typed

