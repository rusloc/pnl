	partition dim_account = m
		mode: import
		source =
				let
				    // Portable source (ADR-0014 / ADR-0015 pattern): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_account.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"account_id", Int64.Type},
				            {"account_name", type text},
				            {"fully_qualified_name", type text},
				            {"parent_account_id", Int64.Type},
				            {"account_level", Int64.Type},
