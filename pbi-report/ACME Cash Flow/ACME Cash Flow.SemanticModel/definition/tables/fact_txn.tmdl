	/// Type and number as the ledger shows them: 'Bill Payment #1043'.
	column type_no =
			VAR _t            = fact_txn[txn_type]
			VAR _name         =
			    SWITCH (
			        _t
			        ,"SalesReceipt", "Sales Receipt"
			        ,"RefundReceipt", "Refund Receipt"
			        ,"CreditMemo", "Credit Memo"
			        ,"VendorCredit", "Vendor Credit"
			        ,"BillPayment", "Bill Payment"
			        ,"CreditCardPayment", "Credit Card Payment"
			        ,"JournalEntry", "Journal Entry"
			        ,_t
			    )
			VAR _doc          = fact_txn[doc_number]
			RETURN
			    _name & IF ( NOT ISBLANK ( _doc ) && _doc <> "", " #" & _doc )
		dataType: string
		lineageTag: b853fbda-72b1-56f6-ad13-181a67bd5e9a
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition fact_txn = m
		mode: import
		source =
				let
				    // Portable source (ADR-0014 / ADR-0015 pattern): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_txn.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"txn_id", Int64.Type},
				            {"txn_type", type text},
				            {"txn_date", type date},
				            {"month_key", type text},
				            {"doc_number", type text},
				            {"counterparty_id", Int64.Type},
				            {"header_account_id", Int64.Type},
				            {"bank_account_id", Int64.Type},
				            {"payment_type", type text},
				            {"payment_method", type text},
				            {"total_amount", type number},
				            {"open_balance", type number},
				            {"cash_amount", type number},
				            {"private_note", type text},
				            {"created_at", type datetime},
				            {"updated_at", type datetime},
				            {"sync_token", Int64.Type},
				            {"is_edited", type logical},
				            {"process_id", type text},
				            {"chain_id", Int64.Type},
				            {"scenario_id", type text},
				            {"cleared_status", type text},
				            {"cleared_date", type date},
				            {"qbo_link", type text}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table
