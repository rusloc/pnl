                "textRuns": [
                  {
                    "value": "Top  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#101B2B"
                    }
                  },
                  {
                    "value": "Every line to operating profit ranked by |Δ|, prior-year Δ and of which FX. The funnel filters by region, channel, category and price tier, alone or combined.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#4f5c6c"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bottom  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#101B2B"
                    }
                  },
                  {
                    "value": "Net revenue bridge (drivers at constant currency → CC subtotal → FX → actual) and profit bridge (comparison Adj. EBITDA → actual → operating profit).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#4f5c6c"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Colours  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#101B2B"
                    }
                  },
                  {
                    "value": "Bridges: increase green, decrease orange, totals company colour, subtotals dark, FX light grey; axes do not start at zero. Variance bars: right helps profit, left hurts, one scale.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#4f5c6c"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Legend  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#101B2B"
                    }
                  },
                  {
                    "value": "Status vs Budget only: grey on track (±1 % / ±0.3 pp), amber watch (to 3 % / 1 pp), red off track beyond, green ahead; \"lower is better\" inverts on Opex %. ⓘ on each card holds its definition and sources.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#4f5c6c"
                    }
                  }
