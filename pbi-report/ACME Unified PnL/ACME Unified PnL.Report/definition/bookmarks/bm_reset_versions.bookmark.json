{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Reset: Versions",
  "name": "bm_reset_versions",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "s_base_version",
      "s_compare_a",
      "s_compare_b"
    ],
    "suppressActiveSection": true,
    "suppressDisplay": true
  },
  "explorationState": {
    "version": "1.0",
    "activeSection": "pnl_one_pager",
    "sections": {
      "pnl_one_pager": {
        "visualContainers": {
          "s_base_version": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "s_compare_a": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "s_compare_b": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}