// Profitability page rebuild (vosk.dev spec C:\__VOSK__\docs\pnl\power-bi-profitability-spec.md, 2026-11-17):
// the §8 acceptance figures of the web report and the rules the page relies on. Generated by bip
// (tools/profitability-2026-11-17/gen_test.py); do not edit by hand. Numbers compare as the visuals show them (rounded to
// the shown decimals: amounts USD m 1 dp, % 1 dp, pp 1 dp); texts exactly. Every row returns _pass = TRUE.
// Run one EVALUATE at a time (tools/oracle-2026-11-16/split_file.py + run_blocks.py).

EVALUATE
// ---------------------------------------------------------------- PS-01 Profitability by Region: CP Actual YTD Sep 2026 vs Budget, constant currency, USD m (43 rows)
VAR _rows =
    CALCULATETABLE (
        UNION (
            ROW ( "_id", "PS-01 NA nr", "_expected", "1488.6", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Net Revenue], TREATAS ( { "NA" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA nr_delta_pct", "_expected", "-2.7", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof NR Δ % CC], TREATAS ( { "NA" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA gm_pct", "_expected", "49.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof GM %], TREATAS ( { "NA" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA cm_pct", "_expected", "39.2", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM %], TREATAS ( { "NA" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA cm_delta_pp", "_expected", "-0.5", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Δ pp], TREATAS ( { "NA" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA cm_status", "_expected", "3", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Status], TREATAS ( { "NA" }, dim_region[region_code] ) ), 0 ), "0" ) )
            ,ROW ( "_id", "PS-01 NA contribution", "_expected", "583.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Contribution], TREATAS ( { "NA" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 NA ebitda", "_expected", "299.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Adj EBITDA], TREATAS ( { "NA" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU nr", "_expected", "944.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Net Revenue], TREATAS ( { "EU" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU nr_delta_pct", "_expected", "-2.8", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof NR Δ % CC], TREATAS ( { "EU" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU gm_pct", "_expected", "49.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof GM %], TREATAS ( { "EU" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU cm_pct", "_expected", "39.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM %], TREATAS ( { "EU" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU cm_delta_pp", "_expected", "-0.6", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Δ pp], TREATAS ( { "EU" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU cm_status", "_expected", "3", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Status], TREATAS ( { "EU" }, dim_region[region_code] ) ), 0 ), "0" ) )
            ,ROW ( "_id", "PS-01 EU contribution", "_expected", "369.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Contribution], TREATAS ( { "EU" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 EU ebitda", "_expected", "189.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Adj EBITDA], TREATAS ( { "EU" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP nr", "_expected", "518.3", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Net Revenue], TREATAS ( { "AP" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP nr_delta_pct", "_expected", "-2.9", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof NR Δ % CC], TREATAS ( { "AP" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP gm_pct", "_expected", "49.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof GM %], TREATAS ( { "AP" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP cm_pct", "_expected", "39.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM %], TREATAS ( { "AP" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP cm_delta_pp", "_expected", "-0.6", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Δ pp], TREATAS ( { "AP" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP cm_status", "_expected", "3", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Status], TREATAS ( { "AP" }, dim_region[region_code] ) ), 0 ), "0" ) )
            ,ROW ( "_id", "PS-01 AP contribution", "_expected", "202.7", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Contribution], TREATAS ( { "AP" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 AP ebitda", "_expected", "104.0", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Adj EBITDA], TREATAS ( { "AP" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK nr", "_expected", "418.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Net Revenue], TREATAS ( { "UK" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK nr_delta_pct", "_expected", "-2.7", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof NR Δ % CC], TREATAS ( { "UK" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK gm_pct", "_expected", "49.4", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof GM %], TREATAS ( { "UK" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK cm_pct", "_expected", "39.1", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM %], TREATAS ( { "UK" }, dim_region[region_code] ) ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK cm_delta_pp", "_expected", "-0.6", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Δ pp], TREATAS ( { "UK" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK cm_status", "_expected", "3", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof CM Status], TREATAS ( { "UK" }, dim_region[region_code] ) ), 0 ), "0" ) )
            ,ROW ( "_id", "PS-01 UK contribution", "_expected", "163.6", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Contribution], TREATAS ( { "UK" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 UK ebitda", "_expected", "83.9", "_model", FORMAT ( ROUND ( CALCULATE ( [Prof Adj EBITDA], TREATAS ( { "UK" }, dim_region[region_code] ) ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL nr", "_expected", "3369.0", "_model", FORMAT ( ROUND ( [Prof Net Revenue], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL nr_delta_pct", "_expected", "-2.8", "_model", FORMAT ( ROUND ( [Prof NR Δ % CC] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL gm_pct", "_expected", "49.4", "_model", FORMAT ( ROUND ( [Prof GM %] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL cm_pct", "_expected", "39.1", "_model", FORMAT ( ROUND ( [Prof CM %] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL cm_delta_pp", "_expected", "-0.6", "_model", FORMAT ( ROUND ( [Prof CM Δ pp], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL cm_status", "_expected", "3", "_model", FORMAT ( ROUND ( [Prof CM Status], 0 ), "0" ) )
            ,ROW ( "_id", "PS-01 TOTAL contribution", "_expected", "1318.8", "_model", FORMAT ( ROUND ( [Prof Contribution], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 TOTAL ebitda", "_expected", "676.7", "_model", FORMAT ( ROUND ( [Prof Adj EBITDA], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-01 subtitle", "_expected", "Constant currency (FY2026 budget rates) - USD m - vs Budget", "_model", [Prof Subtitle CC] )
            ,ROW ( "_id", "PS-01 title", "_expected", "Profitability by Region", "_model", [Prof Title] )
            ,ROW ( "_id", "PS-01 delta header", "_expected", "Δ vs Budget %", "_model", [Prof Δ Header] )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-02 Concentration shares (the 100 % bars), same selection (14 rows)
VAR _conc =
    SUMMARIZECOLUMNS (
        dim_conc_level[level_code]
        ,dim_heat_row[heat_row_code]
        ,dim_heat_row[heat_row_label]
        ,dim_heat_row[heat_row_sort]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,"@v", [Conc Segment Share]
    )
VAR _rows =
    UNION (
            ROW ( "_id", "PS-02 NR NA", "_expected", "44.2", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && dim_heat_row[heat_row_code] = "NA" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 NR EU", "_expected", "28.0", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && dim_heat_row[heat_row_code] = "EU" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 NR AP", "_expected", "15.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && dim_heat_row[heat_row_code] = "AP" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 NR UK", "_expected", "12.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && dim_heat_row[heat_row_code] = "UK" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 CM NA", "_expected", "44.2", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "CM" && dim_heat_row[heat_row_code] = "NA" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 CM EU", "_expected", "28.0", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "CM" && dim_heat_row[heat_row_code] = "EU" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 CM AP", "_expected", "15.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "CM" && dim_heat_row[heat_row_code] = "AP" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 CM UK", "_expected", "12.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "CM" && dim_heat_row[heat_row_code] = "UK" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 EBITDA NA", "_expected", "44.3", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "EBITDA" && dim_heat_row[heat_row_code] = "NA" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 EBITDA EU", "_expected", "28.0", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "EBITDA" && dim_heat_row[heat_row_code] = "EU" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 EBITDA AP", "_expected", "15.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "EBITDA" && dim_heat_row[heat_row_code] = "AP" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 EBITDA UK", "_expected", "12.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _conc, dim_conc_level[level_code] = "EBITDA" && dim_heat_row[heat_row_code] = "UK" ), [@v] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-02 segments per bar", "_expected", "4", "_model", FORMAT ( COUNTROWS ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && NOT ISBLANK ( [@v] ) ) ), "0" ) )
            ,ROW ( "_id", "PS-02 segment order = heat_row_sort", "_expected", "North America|Continental Europe|Asia-Pacific|UK & Ireland", "_model", CONCATENATEX ( FILTER ( _conc, dim_conc_level[level_code] = "NR" && NOT ISBLANK ( [@v] ) ), dim_heat_row[heat_row_label], "|", dim_heat_row[heat_row_sort], ASC ) )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-03 Revenue and margin by month, Jan - Sep 2026 (14 rows)
VAR _combo =
    SUMMARIZECOLUMNS (
        dim_combo_period[year_label]
        ,dim_combo_period[period_label]
        ,dim_combo_period[label_sort]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,"@nr", [Combo NR]
        ,"@cm", [Combo CM %]
        ,"@tip", [Combo Tooltip]
    )
VAR _rows =
    UNION (
            ROW ( "_id", "PS-03 Jan 2026 CM %", "_expected", "39.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Jan" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Feb 2026 CM %", "_expected", "39.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Feb" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Mar 2026 CM %", "_expected", "39.3", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Mar" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Apr 2026 CM %", "_expected", "39.3", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Apr" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 May 2026 CM %", "_expected", "39.3", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "May" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Jun 2026 CM %", "_expected", "39.4", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Jun" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Jul 2026 CM %", "_expected", "39.1", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Jul" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Aug 2026 CM %", "_expected", "38.7", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Aug" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 Sep 2026 CM %", "_expected", "38.6", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2026" && dim_combo_period[period_label] = "Sep" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 periods shown", "_expected", "9", "_model", FORMAT ( COUNTROWS ( FILTER ( _combo, NOT ISBLANK ( [@nr] ) ) ), "0" ) )
            ,ROW ( "_id", "PS-03 NR of the months = table total", "_expected", "3369.0", "_model", FORMAT ( ROUND ( SUMX ( _combo, [@nr] ), 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-03 title", "_expected", "Revenue and margin by month", "_model", CALCULATE ( [Combo Title] ,TREATAS ( { "P" }, param_entity_view[entity_view_code] ) ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] ) ,TREATAS ( { 9 }, param_period[month_number] ) ,TREATAS ( { "YTD" }, param_time_view[time_view_code] ) ,TREATAS ( { "A" }, param_base_version[choice_code] ) ,TREATAS ( { "B" }, param_compare_a[choice_code] ) ,TREATAS ( { "PY" }, param_compare_b[choice_code] ) ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] ) ,TREATAS ( { "M" }, param_units[units_code] ) ) )
            ,ROW ( "_id", "PS-03 legend", "_expected", "Net revenue, $ m (left)", "_model", CALCULATE ( [Combo Legend NR] ,TREATAS ( { "P" }, param_entity_view[entity_view_code] ) ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] ) ,TREATAS ( { 9 }, param_period[month_number] ) ,TREATAS ( { "YTD" }, param_time_view[time_view_code] ) ,TREATAS ( { "A" }, param_base_version[choice_code] ) ,TREATAS ( { "B" }, param_compare_a[choice_code] ) ,TREATAS ( { "PY" }, param_compare_b[choice_code] ) ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] ) ,TREATAS ( { "M" }, param_units[units_code] ) ) )
            ,ROW ( "_id", "PS-03 Sep tooltip", "_expected", "Sep 2026: net revenue $402.7 m, contribution $155.3 m, CM 38.6%", "_model", MAXX ( FILTER ( _combo, dim_combo_period[period_label] = "Sep" ), [@tip] ) )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-04 Mix - region x category: column totals, GM row, top-left cell (16 rows)
VAR _heat =
    SUMMARIZECOLUMNS (
        dim_heat_row[heat_row_code]
        ,dim_line[line_name]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,"@c", [Heat Grid Cell]
    )
VAR _rowtot =
    SUMMARIZECOLUMNS (
        dim_heat_row[heat_row_code]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,"@c", [Heat Grid Cell]
    )
VAR _rows =
    UNION (
            ROW ( "_id", "PS-04 total Home care", "_expected", "$946.3 m", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && dim_line[line_name] = "Home care" ), [@c] ) )
            ,ROW ( "_id", "PS-04 GM Home care", "_expected", "GM 51.6%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "GM" && dim_line[line_name] = "Home care" ), [@c] ) )
            ,ROW ( "_id", "PS-04 total Personal care & beauty", "_expected", "$907.5 m", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && dim_line[line_name] = "Personal care & beauty" ), [@c] ) )
            ,ROW ( "_id", "PS-04 GM Personal care & beauty", "_expected", "GM 59.6%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "GM" && dim_line[line_name] = "Personal care & beauty" ), [@c] ) )
            ,ROW ( "_id", "PS-04 total Kitchen & household", "_expected", "$681.6 m", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && dim_line[line_name] = "Kitchen & household" ), [@c] ) )
            ,ROW ( "_id", "PS-04 GM Kitchen & household", "_expected", "GM 47.5%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "GM" && dim_line[line_name] = "Kitchen & household" ), [@c] ) )
            ,ROW ( "_id", "PS-04 total Electronics accessories", "_expected", "$501.3 m", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && dim_line[line_name] = "Electronics accessories" ), [@c] ) )
            ,ROW ( "_id", "PS-04 GM Electronics accessories", "_expected", "GM 34.7%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "GM" && dim_line[line_name] = "Electronics accessories" ), [@c] ) )
            ,ROW ( "_id", "PS-04 total Toys & leisure", "_expected", "$332.3 m", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && dim_line[line_name] = "Toys & leisure" ), [@c] ) )
            ,ROW ( "_id", "PS-04 GM Toys & leisure", "_expected", "GM 41.5%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "GM" && dim_line[line_name] = "Toys & leisure" ), [@c] ) )
            ,ROW ( "_id", "PS-04 top-left NA x Home care", "_expected", "$418.3 m" & UNICHAR ( 10 ) & "28%", "_model", MAXX ( FILTER ( _heat, dim_heat_row[heat_row_code] = "NA" && dim_line[line_name] = "Home care" ), [@c] ) )
            ,ROW ( "_id", "PS-04 grand total", "_expected", "$3,369.0 m", "_model", MAXX ( FILTER ( _rowtot, dim_heat_row[heat_row_code] = "TOTAL" ), [@c] ) )
            ,ROW ( "_id", "PS-04 NA total column", "_expected", "$1,488.6 m", "_model", MAXX ( FILTER ( _rowtot, dim_heat_row[heat_row_code] = "NA" ), [@c] ) )
            ,ROW ( "_id", "PS-04 lines shown", "_expected", "5", "_model", FORMAT ( COUNTROWS ( FILTER ( _heat, dim_heat_row[heat_row_code] = "TOTAL" && NOT ISBLANK ( [@c] ) ) ), "0" ) )
            ,ROW ( "_id", "PS-04 title", "_expected", "Mix - region × category", "_model", CALCULATE ( [Heat Title] ,TREATAS ( { "P" }, param_entity_view[entity_view_code] ) ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] ) ,TREATAS ( { 9 }, param_period[month_number] ) ,TREATAS ( { "YTD" }, param_time_view[time_view_code] ) ,TREATAS ( { "A" }, param_base_version[choice_code] ) ,TREATAS ( { "B" }, param_compare_a[choice_code] ) ,TREATAS ( { "PY" }, param_compare_b[choice_code] ) ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] ) ,TREATAS ( { "M" }, param_units[units_code] ) ) )
            ,ROW ( "_id", "PS-04 lines of the company sum to the table total", "_expected", "3369.0", "_model", FORMAT ( ROUND ( CALCULATE ( SUMX ( CALCULATETABLE ( VALUES ( dim_line[line_code] ), dim_line[entity_code] = "P", dim_line[is_unassigned] = FALSE () ), [Prof Net Revenue] ) ,TREATAS ( { "P" }, param_entity_view[entity_view_code] ) ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] ) ,TREATAS ( { 9 }, param_period[month_number] ) ,TREATAS ( { "YTD" }, param_time_view[time_view_code] ) ,TREATAS ( { "A" }, param_base_version[choice_code] ) ,TREATAS ( { "B" }, param_compare_a[choice_code] ) ,TREATAS ( { "PY" }, param_compare_b[choice_code] ) ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] ) ,TREATAS ( { "M" }, param_units[units_code] ) ), 1 ), "0.0" ) )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-05 Custom range Jan 2024 - Dec 2025 vs Budget, constant currency: total row (10 rows)
VAR _rows =
    CALCULATETABLE (
        UNION (
            ROW ( "_id", "PS-05 TOTAL nr", "_expected", "8692.6", "_model", FORMAT ( ROUND ( [Prof Net Revenue], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL nr_delta_pct", "_expected", "-0.8", "_model", FORMAT ( ROUND ( [Prof NR Δ % CC] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL gm_pct", "_expected", "48.9", "_model", FORMAT ( ROUND ( [Prof GM %] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL cm_pct", "_expected", "39.3", "_model", FORMAT ( ROUND ( [Prof CM %] * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL cm_delta_pp", "_expected", "-0.1", "_model", FORMAT ( ROUND ( [Prof CM Δ pp], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL cm_status", "_expected", "1", "_model", FORMAT ( ROUND ( [Prof CM Status], 0 ), "0" ) )
            ,ROW ( "_id", "PS-05 TOTAL contribution", "_expected", "3413.6", "_model", FORMAT ( ROUND ( [Prof Contribution], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 TOTAL ebitda", "_expected", "1718.3", "_model", FORMAT ( ROUND ( [Prof Adj EBITDA], 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-05 subtitle", "_expected", "Constant currency (FY2025 budget rates) - USD m - vs Budget", "_model", [Prof Subtitle CC] )
            ,ROW ( "_id", "PS-05 combo title", "_expected", "Revenue and margin by quarter", "_model", [Combo Title] )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { 0 }, param_range_start[range_start_index] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-06 Revenue and margin by quarter, custom range Jan 2024 - Dec 2025 (10 rows)
VAR _combo =
    SUMMARIZECOLUMNS (
        dim_combo_period[year_label]
        ,dim_combo_period[period_label]
        ,dim_combo_period[label_sort]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { 0 }, param_range_start[range_start_index] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,"@nr", [Combo NR]
        ,"@cm", [Combo CM %]
    )
VAR _rows =
    UNION (
            ROW ( "_id", "PS-06 Q1 2024 CM %", "_expected", "40.0", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2024" && dim_combo_period[period_label] = "Q1" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q2 2024 CM %", "_expected", "40.0", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2024" && dim_combo_period[period_label] = "Q2" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q3 2024 CM %", "_expected", "39.6", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2024" && dim_combo_period[period_label] = "Q3" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q4 2024 CM %", "_expected", "38.5", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2024" && dim_combo_period[period_label] = "Q4" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q1 2025 CM %", "_expected", "39.8", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2025" && dim_combo_period[period_label] = "Q1" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q2 2025 CM %", "_expected", "39.7", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2025" && dim_combo_period[period_label] = "Q2" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q3 2025 CM %", "_expected", "39.2", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2025" && dim_combo_period[period_label] = "Q3" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 Q4 2025 CM %", "_expected", "38.1", "_model", FORMAT ( ROUND ( MAXX ( FILTER ( _combo, dim_combo_period[year_label] = "2025" && dim_combo_period[period_label] = "Q4" ), [@cm] ) * 100, 1 ), "0.0" ) )
            ,ROW ( "_id", "PS-06 periods shown", "_expected", "8", "_model", FORMAT ( COUNTROWS ( FILTER ( _combo, NOT ISBLANK ( [@nr] ) ) ), "0" ) )
            ,ROW ( "_id", "PS-06 NR of the quarters = total", "_expected", "8692.6", "_model", FORMAT ( ROUND ( SUMX ( _combo, [@nr] ), 1 ), "0.0" ) )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-07 Static region order (heat rows, bar segments) = net-revenue order, every company x fiscal year (6 rows)
VAR _cases =
    CROSSJOIN (
        SELECTCOLUMNS ( { "P", "S" }, "Value1", [Value] )
        ,SELECTCOLUMNS ( { 2024, 2025, 2026 }, "Value2", [Value] )
    )
VAR _rows =
    ADDCOLUMNS (
        _cases
        ,"_id", "PS-07 " & [Value1] & " FY" & [Value2]
        ,"_expected", "North America|Continental Europe|Asia-Pacific|UK & Ireland"
        ,"_model",
            VAR _entity       = [Value1]
            VAR _fiscal_year  = [Value2]
            RETURN
                CONCATENATEX (
                    CALCULATETABLE (
                        ADDCOLUMNS ( VALUES ( dim_region[region_name] ), "@nr", [Prof Net Revenue] )
                        ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                        ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                        ,TREATAS ( { 12 }, param_period[month_number] )
                        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
                    )
                    ,dim_region[region_name]
                    ,"|"
                    ,[@nr], DESC
                )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- PS-08 Partial quarter in the tooltip, grain switch at 13 months, measures in error (4 rows)
VAR _partial =
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            dim_combo_period[year_label]
            ,dim_combo_period[period_label]
            ,dim_combo_period[label_sort]
            ,"@tip", [Combo Tooltip]
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 11 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { 1 }, param_range_start[range_start_index] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
VAR _title12 =
    CALCULATE (
        [Combo Title]
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { 12 }, param_range_start[range_start_index] )
    )
VAR _rows =
    UNION (
        ROW ( "_id", "PS-08 Q1 2024 partial (Feb - Mar)", "_expected", "Q1 2024 (2 of 3 months)", "_model", LEFT ( MAXX ( FILTER ( _partial, dim_combo_period[year_label] = "2024" && dim_combo_period[period_label] = "Q1" ), [@tip] ), 23 ) )
        ,ROW ( "_id", "PS-08 Q4 2025 partial (Oct - Nov)", "_expected", "Q4 2025 (2 of 3 months)", "_model", LEFT ( MAXX ( FILTER ( _partial, dim_combo_period[year_label] = "2025" && dim_combo_period[period_label] = "Q4" ), [@tip] ), 23 ) )
        ,ROW ( "_id", "PS-08 12-month range stays monthly", "_expected", "Revenue and margin by month", "_model", _title12 )
        ,ROW ( "_id", "PS-08 measures in an error state", "_expected", "0", "_model", FORMAT ( COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) ) + 0, "0" ) )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "Prof spec 2026-11-17"
        ,"_id", [_id]
        ,"_expected", [_expected]
        ,"_model", [_model]
        ,"_pass", [_model] = [_expected]
    )
ORDER BY [_id]
