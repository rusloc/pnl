# Track A — Rayfin app · values interpolated into rayfin/rayfin.yml (${VAR}).
# Copy to rayfin/.env (gitignored). `rayfin dev` / `rayfin up` append their own
# RAYFIN_PUBLIC_* keys to rayfin/.env; leave those alone.
#
# Connector `lhraw` → Lakehouse lh_raw SQL analytics endpoint (workspace RAW).
# IDs: CLAUDE.md › Workspaces, or `npx rayfin connector search lh_raw --workspace-id <ws> --type fabric-sqlanalytics --json`.
# Note: the CLI stores the lakehouse's *SQLEndpoint* item id here, not the Lakehouse item id.
LH_RAW_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
LH_RAW_SQL_ENDPOINT_ID=00000000-0000-0000-0000-000000000000

# Connector `pnlModel` → semantic model "ACME Unified PnL" (Track B, published to workspace RAW; ADR-0006).
# IDs: `npx rayfin connector search "ACME Unified PnL" --workspace-id <ws> --type fabric-semanticmodel --json`.
PNL_MODEL_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PNL_MODEL_ITEM_ID=00000000-0000-0000-0000-000000000000

# AI chat (ADR-0009). The assistant is OFF unless this is `on`; `rayfin env` maps it to
# VITE_RAYFIN_PNL_CHAT for the frontend build. Turn on only after the `chatTurn` function is
# deployed and its secrets are set (`npx rayfin secret set AZURE_OPENAI_ENDPOINT`, …_DEPLOYMENT).
RAYFIN_PUBLIC_PNL_CHAT=off
