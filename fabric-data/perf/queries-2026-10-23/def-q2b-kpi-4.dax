DEFINE
    VAR _entity = TREATAS ( { "P" }, param_entity_view[entity_view_code] )
    VAR _fy     = TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
    VAR _month  = TREATAS ( { 9 }, param_period[month_number] )
    VAR _tv     = TREATAS ( { "YTD" }, param_time_view[time_view_code] )
    VAR _base   = TREATAS ( { "A" }, param_base_version[choice_code] )
    VAR _cmp_a  = TREATAS ( { "B" }, param_compare_a[choice_code] )
    VAR _cmp_b  = TREATAS ( { "PY" }, param_compare_b[choice_code] )
    VAR _ccy    = TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
    VAR _fx     = TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
    VAR _units  = TREATAS ( { "M" }, param_units[units_code] )
EVALUATE
CALCULATETABLE (
    ROW (
        "@NR_PER_UNIT", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "NR_PER_UNIT" }, dim_kpi[kpi_code] ) ), DOUBLE )
        ,"@NR_PER_UNIT_cmp_a", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "NR_PER_UNIT" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_A" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@NR_PER_UNIT_cmp_b", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "NR_PER_UNIT" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_B" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@NR_PER_UNIT_s", CALCULATE ( [KPI Secondary], TREATAS ( { "NR_PER_UNIT" }, dim_kpi[kpi_code] ) )
        ,"@VOL_GROWTH", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "VOL_GROWTH" }, dim_kpi[kpi_code] ) ), DOUBLE )
        ,"@VOL_GROWTH_cmp_a", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "VOL_GROWTH" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_A" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@VOL_GROWTH_cmp_b", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "VOL_GROWTH" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_B" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@VOL_GROWTH_s", CALCULATE ( [KPI Secondary], TREATAS ( { "VOL_GROWTH" }, dim_kpi[kpi_code] ) )
        ,"@PRICE_MIX", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "PRICE_MIX" }, dim_kpi[kpi_code] ) ), DOUBLE )
        ,"@PRICE_MIX_cmp_a", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "PRICE_MIX" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_A" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@PRICE_MIX_cmp_b", CONVERT ( CALCULATE ( [KPI Value], TREATAS ( { "PRICE_MIX" }, dim_kpi[kpi_code] ), REMOVEFILTERS ( param_eval ), TREATAS ( { "CMP_B" }, param_eval[eval_code] ) ), DOUBLE )
        ,"@PRICE_MIX_s", CALCULATE ( [KPI Secondary], TREATAS ( { "PRICE_MIX" }, dim_kpi[kpi_code] ) )
    )
    ,_entity, _fy, _month, _tv, _base, _cmp_a, _cmp_b, _ccy, _fx, _units
)