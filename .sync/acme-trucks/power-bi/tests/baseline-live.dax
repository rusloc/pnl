// ACME Trucks - baseline of the LIVE model "Time unitilaztion" (workspace Showcase), captured 2026-10-21 by ginee
// through executeQueries (read-only). Run in Power BI Desktop > DAX query view against the local Import model
// (Trucks.SemanticModel) after a full refresh. Each EVALUATE returns its own result tab; a test passes when every
// row shows _pass = TRUE. Tolerance: relative 1e-9 (same data, so only floating-point summation order may differ).
// Expected values also in baseline-live.csv (same folder). This file was self-tested against the live model: all TRUE.
// Scopes:
//   row counts         = COUNTROWS per table vs the live model.
//   waterfall_saved    = "Time util" saved state: report filter Справочник ЭКС[Учитывать] = "да"; page drillthrough
//                        filter Справочник ЭКС[Подрядчик] = blank (Q-06); week "9 (25.2-3.3)"; plan type "MONTH";
//                        calculation "Weighted"; work type "Trucks" + "On spot"; office and loader unfiltered;
//                        plus the waterfall visuals' own filters (idle_model_category not blank, show = "1",
//                        Справочник простоев[Учитывать] = "да"). Rows = waterfall categories (Sorting).
//   waterfall_switches = plan type "MONTH" + calculation "Weighted" only (all data), same visual filters.
//   model_total        = the waterfall / label / tooltip measures with no filter at all.
//   kpi_*              = the 4 KPI cards (saved page context / switches only / no filter). In the source model these
//                        measures multiply by RANDBETWEEN(10,100), so every evaluation differs. The test pins the
//                        deterministic unit (same DAX without RANDBETWEEN, defined below as _test measures) exactly,
//                        and checks KPI / unit is a whole number in [10, 100] (ГМ на авто *: one RANDBETWEEN) or
//                        [100, 10000] (_производительность_авто_*: two nested RANDBETWEEN).
// Measures: waterfall bars (_plan_/_fact_ *_SWITCH), % / delta labels (*_LABEL*), tooltip hours (_planHours,
// _factHours, _factHours_LIN, _factHours_%%), helper _zero, KPI cards (_производительность_авто_*, ГМ на авто *).

DEFINE
    // Deterministic units of the KPI measures: the source DAX without RANDBETWEEN (see header)
    MEASURE 'Таблица мер'[_test ГМ на авто план unit] =
        SWITCH (
            TRUE ()
            ,FIRSTNONBLANK ( 'PLAN_SWITCHER'[type], 1 ) = "Неделя"
                ,SUM ( 'ПФ объемы'[Объем ГМ на авто план] )
            ,SUM ( 'ПФ объемы'[Объем ГМ на авто план месяц] )
        )
    MEASURE 'Таблица мер'[_test ГМ на авто факт unit] =
        SUM ( 'ПФ объемы'[Объем ГМ на авто факт] )
    MEASURE 'Таблица мер'[_test производительность план unit] =
        DIVIDE ( [_test ГМ на авто план unit], [_погрузка_план_расчет] ) * 1000
    MEASURE 'Таблица мер'[_test производительность факт unit] =
        DIVIDE ( [_test ГМ на авто факт unit], [_погрузка_факт_расчет] ) * 1000

    VAR _tol             = 1e-9

    VAR _f_included      = TREATAS ( { "да" }, 'Справочник ЭКС'[Учитывать] )
    VAR _f_contractor    = TREATAS ( { BLANK () }, 'Справочник ЭКС'[Подрядчик] )
    VAR _f_week          = TREATAS ( { "9 (25.2-3.3)" }, 'Calendar'[_dateSpanBiz] )
    VAR _f_plan_type     = TREATAS ( { "MONTH" }, 'PLAN_SWITCHER'[_typeAltName] )
    VAR _f_calculation   = TREATAS ( { "Weighted" }, 'METRIC_SWITCH'[_metricAltName] )
    VAR _f_work_type     = TREATAS ( { "Trucks", "On spot" }, 'СПИСОК_ЭКС'[_schemaAltName] )
    VAR _v_category      = FILTER ( ALL ( 'Справочник простоев'[idle_model_category] ), NOT ISBLANK ( 'Справочник простоев'[idle_model_category] ) )
    VAR _v_show          = TREATAS ( { "1" }, 'Справочник простоев'[show] )
    VAR _v_included      = TREATAS ( { "да" }, 'Справочник простоев'[Учитывать] )
    VAR _s_plan_type     = TREATAS ( { "MONTH" }, 'PLAN_SWITCHER'[_typeAltName] )
    VAR _s_calculation   = TREATAS ( { "Weighted" }, 'METRIC_SWITCH'[_metricAltName] )

EVALUATE
// ---------------------------------------------------------------- row counts per table vs live
VAR _expected =
        DATATABLE (
            "_table", STRING,
            "_expected", INTEGER,
            {
                { "AREA_DIM", 13 },
                { "Calendar", 156 },
                { "D4_METRICS_SWITCH", 9 },
                { "DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8", 1 },
                { "FIELD_DIM", 21 },
                { "intervals", 891 },
                { "LocalDateTable_03e1c694-ffc1-4ac9-b666-46ce6a5c5016", 1096 },
                { "LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324", 730 },
                { "LocalDateTable_55854758-d3a0-472c-8f75-2eea87c06008", 365 },
                { "LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487", 730 },
                { "LocalDateTable_df0c20f7-d568-479f-a326-973c3c10d880", 730 },
                { "LocalDateTable_eb9c3c70-4675-4236-a899-66032be25b37", 730 },
                { "METRIC_SWITCH", 2 },
                { "OFFICE_DIM", 6 },
                { "PLAN_SWITCHER", 2 },
                { "waterfall_DIM", 19 },
                { "Интервалы", 136 },
                { "КРВ АС", 804526 },
                { "План_2", 394056 },
                { "План_2_МЕС", 249080 },
                { "План_справочник_прост", 25 },
                { "ПФ КРВ", 203867 },
                { "ПФ объемы", 18684 },
                { "ПФ Отчет о рейсах", 18677 },
                { "СПИСОК_ЭКС", 168 },
                { "Справочник простоев", 31 },
                { "Справочник разрезов", 7 },
                { "Справочник ЭКС", 168 },
                { "Средневзвеш_план", 17617 },
                { "Средневзвеш_план_д2", 394056 },
                { "Средневзвеш_факт", 18168 },
                { "Средневзвеш_факт_Д2", 203867 },
                { "Факт_справочник_прост", 22 }
            }
        )
VAR _actual =
        UNION (
            ROW ( "_table", "AREA_DIM", "_actual", COUNTROWS ( 'AREA_DIM' ) )
            ,ROW ( "_table", "Calendar", "_actual", COUNTROWS ( 'Calendar' ) )
            ,ROW ( "_table", "D4_METRICS_SWITCH", "_actual", COUNTROWS ( 'D4_METRICS_SWITCH' ) )
            ,ROW ( "_table", "DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8", "_actual", COUNTROWS ( 'DateTableTemplate_432d62ed-472e-468a-b164-32515fcfb4b8' ) )
            ,ROW ( "_table", "FIELD_DIM", "_actual", COUNTROWS ( 'FIELD_DIM' ) )
            ,ROW ( "_table", "intervals", "_actual", COUNTROWS ( 'intervals' ) )
            ,ROW ( "_table", "LocalDateTable_03e1c694-ffc1-4ac9-b666-46ce6a5c5016", "_actual", COUNTROWS ( 'LocalDateTable_03e1c694-ffc1-4ac9-b666-46ce6a5c5016' ) )
            ,ROW ( "_table", "LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324", "_actual", COUNTROWS ( 'LocalDateTable_44362d6a-6ef9-4703-92e9-e78399579324' ) )
            ,ROW ( "_table", "LocalDateTable_55854758-d3a0-472c-8f75-2eea87c06008", "_actual", COUNTROWS ( 'LocalDateTable_55854758-d3a0-472c-8f75-2eea87c06008' ) )
            ,ROW ( "_table", "LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487", "_actual", COUNTROWS ( 'LocalDateTable_d5a01e7b-d51d-432e-8997-36d70b4d8487' ) )
            ,ROW ( "_table", "LocalDateTable_df0c20f7-d568-479f-a326-973c3c10d880", "_actual", COUNTROWS ( 'LocalDateTable_df0c20f7-d568-479f-a326-973c3c10d880' ) )
            ,ROW ( "_table", "LocalDateTable_eb9c3c70-4675-4236-a899-66032be25b37", "_actual", COUNTROWS ( 'LocalDateTable_eb9c3c70-4675-4236-a899-66032be25b37' ) )
            ,ROW ( "_table", "METRIC_SWITCH", "_actual", COUNTROWS ( 'METRIC_SWITCH' ) )
            ,ROW ( "_table", "OFFICE_DIM", "_actual", COUNTROWS ( 'OFFICE_DIM' ) )
            ,ROW ( "_table", "PLAN_SWITCHER", "_actual", COUNTROWS ( 'PLAN_SWITCHER' ) )
            ,ROW ( "_table", "waterfall_DIM", "_actual", COUNTROWS ( 'waterfall_DIM' ) )
            ,ROW ( "_table", "Интервалы", "_actual", COUNTROWS ( 'Интервалы' ) )
            ,ROW ( "_table", "КРВ АС", "_actual", COUNTROWS ( 'КРВ АС' ) )
            ,ROW ( "_table", "План_2", "_actual", COUNTROWS ( 'План_2' ) )
            ,ROW ( "_table", "План_2_МЕС", "_actual", COUNTROWS ( 'План_2_МЕС' ) )
            ,ROW ( "_table", "План_справочник_прост", "_actual", COUNTROWS ( 'План_справочник_прост' ) )
            ,ROW ( "_table", "ПФ КРВ", "_actual", COUNTROWS ( 'ПФ КРВ' ) )
            ,ROW ( "_table", "ПФ объемы", "_actual", COUNTROWS ( 'ПФ объемы' ) )
            ,ROW ( "_table", "ПФ Отчет о рейсах", "_actual", COUNTROWS ( 'ПФ Отчет о рейсах' ) )
            ,ROW ( "_table", "СПИСОК_ЭКС", "_actual", COUNTROWS ( 'СПИСОК_ЭКС' ) )
            ,ROW ( "_table", "Справочник простоев", "_actual", COUNTROWS ( 'Справочник простоев' ) )
            ,ROW ( "_table", "Справочник разрезов", "_actual", COUNTROWS ( 'Справочник разрезов' ) )
            ,ROW ( "_table", "Справочник ЭКС", "_actual", COUNTROWS ( 'Справочник ЭКС' ) )
            ,ROW ( "_table", "Средневзвеш_план", "_actual", COUNTROWS ( 'Средневзвеш_план' ) )
            ,ROW ( "_table", "Средневзвеш_план_д2", "_actual", COUNTROWS ( 'Средневзвеш_план_д2' ) )
            ,ROW ( "_table", "Средневзвеш_факт", "_actual", COUNTROWS ( 'Средневзвеш_факт' ) )
            ,ROW ( "_table", "Средневзвеш_факт_Д2", "_actual", COUNTROWS ( 'Средневзвеш_факт_Д2' ) )
            ,ROW ( "_table", "Факт_справочник_прост", "_actual", COUNTROWS ( 'Факт_справочник_прост' ) )
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_pass", [_actual] = [_expected]
    )
ORDER BY [_pass], [_table]

EVALUATE
// ---------------------------------------------------------------- waterfall_saved
VAR _actual_wide =
    SUMMARIZECOLUMNS (
        'Справочник простоев'[Sorting]
        ,_f_included, _f_contractor, _f_week, _f_plan_type, _f_calculation, _f_work_type, _v_category, _v_show, _v_included
        ,"m0", [_plan_KTG_KIO_WRK_SWITCH]
        ,"m1", [_plan_LIN_AVGW_BLANK_SWITCH]
        ,"m2", [_plan_SWTICH_NEW]
        ,"m3", [_fact_KTG_KIO_WRK_SWITCH]
        ,"m4", [_fact_BLANK_SWITCH]
        ,"m5", [_fact_LIN_AVGW_SWITCH]
        ,"m6", [_plan_AVGW_LIN_LABEL_SWITCH]
        ,"m7", [_fact_AVGW_LIN_LABEL_SWITCH]
        ,"m8", [_plan_fact_DIFF_LABEL]
        ,"m9", [_planHours]
        ,"m10", [_factHours]
        ,"m11", [_factHours_LIN]
        ,"m12", [_factHours_%%]
        ,"m13", [_zero]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_plan_KTG_KIO_WRK_SWITCH", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_plan_LIN_AVGW_BLANK_SWITCH", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_plan_SWTICH_NEW", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_fact_KTG_KIO_WRK_SWITCH", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_fact_BLANK_SWITCH", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_fact_LIN_AVGW_SWITCH", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_plan_AVGW_LIN_LABEL_SWITCH", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_fact_AVGW_LIN_LABEL_SWITCH", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_plan_fact_DIFF_LABEL", "_actual", [m8] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_planHours", "_actual", [m9] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_factHours", "_actual", [m10] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_factHours_LIN", "_actual", [m11] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_factHours_%%", "_actual", [m12] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 'Справочник простоев'[Sorting] + 0, "_measure", "_zero", "_actual", [m13] )
        )
VAR _expected =
        DATATABLE (
            "_category_sort", INTEGER,
            "_measure", STRING,
            "_expected", DOUBLE,
            {
                { 1, "_plan_KTG_KIO_WRK_SWITCH", 1.0 },
                { 1, "_plan_LIN_AVGW_BLANK_SWITCH", 0.0 },
                { 1, "_plan_SWTICH_NEW", 0.0 },
                { 1, "_fact_KTG_KIO_WRK_SWITCH", 1.0 },
