EVALUATE
// ---------------------------------------------------------------- model_total
VAR _actual_wide =
    ROW (
        "m0", [_plan_KTG_KIO_WRK_SWITCH]
        ,"m1", [_plan_LIN_AVGW_BLANK_SWITCH]
        ,"m2", [_plan_SWTICH_NEW]
        ,"m3", [_fact_KTG_KIO_WRK_SWITCH]
        ,"m4", [_fact_BLANK_SWITCH]
        ,"m5", [_fact_LIN_AVGW_SWITCH]
        ,"m6", [_plan_AVGW_LIN_LABEL_SWITCH]
        ,"m7", [_fact_AVGW_LIN_LABEL_SWITCH]
        ,"m8", [_plan_fact_DIFF_LABEL]
        ,"m9", [_planHours]
        ,"m10", [_factHours]
        ,"m11", [_factHours_LIN]
        ,"m12", [_factHours_%%]
        ,"m13", [_zero]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_plan_KTG_KIO_WRK_SWITCH", "_actual", [m0] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_plan_LIN_AVGW_BLANK_SWITCH", "_actual", [m1] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_plan_SWTICH_NEW", "_actual", [m2] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_fact_KTG_KIO_WRK_SWITCH", "_actual", [m3] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_fact_BLANK_SWITCH", "_actual", [m4] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_fact_LIN_AVGW_SWITCH", "_actual", [m5] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_plan_AVGW_LIN_LABEL_SWITCH", "_actual", [m6] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_fact_AVGW_LIN_LABEL_SWITCH", "_actual", [m7] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_plan_fact_DIFF_LABEL", "_actual", [m8] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_planHours", "_actual", [m9] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_factHours", "_actual", [m10] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_factHours_LIN", "_actual", [m11] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_factHours_%%", "_actual", [m12] )
            ,SELECTCOLUMNS ( _actual_wide, "_category_sort", 0, "_measure", "_zero", "_actual", [m13] )
        )
VAR _expected =
        DATATABLE (
            "_category_sort", INTEGER,
            "_measure", STRING,
            "_expected", DOUBLE,
            {
                { 0, "_plan_KTG_KIO_WRK_SWITCH", 0.0 },
                { 0, "_plan_LIN_AVGW_BLANK_SWITCH", 0.0 },
                { 0, "_plan_SWTICH_NEW", 0.0 },
                { 0, "_fact_KTG_KIO_WRK_SWITCH", 0.0 },
                { 0, "_fact_BLANK_SWITCH", BLANK () },
                { 0, "_fact_LIN_AVGW_SWITCH", BLANK () },
                { 0, "_plan_AVGW_LIN_LABEL_SWITCH", 0.0 },
                { 0, "_fact_AVGW_LIN_LABEL_SWITCH", 0.0 },
                { 0, "_plan_fact_DIFF_LABEL", 0.0 },
                { 0, "_planHours", BLANK () },
                { 0, "_factHours", BLANK () },
                { 0, "_factHours_LIN", 1590227.1438666666 },
                { 0, "_factHours_%%", BLANK () },
                { 0, "_zero", 0.0 }
            }
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_pass",
            IF (
                ISBLANK ( [_expected] )
                ,ISBLANK ( [_actual] )
                ,NOT ISBLANK ( [_actual] ) && ABS ( [_actual] - [_expected] ) <= _tol * MAX ( 1, ABS ( [_expected] ) )
            )
    )
ORDER BY [_pass], [_category_sort], [_measure]

EVALUATE
// ---------------------------------------------------------------- kpi_saved (RANDBETWEEN rule)
VAR _actual_wide =
    SUMMARIZECOLUMNS (
        _f_included, _f_contractor, _f_week, _f_plan_type, _f_calculation, _f_work_type
        ,"k0", [_производительность_авто_ПЛАН]
        ,"u0", [_test производительность план unit]
        ,"k1", [_производительность_авто_ФАКТ]
        ,"u1", [_test производительность факт unit]
        ,"k2", [ГМ на авто план]
        ,"u2", [_test ГМ на авто план unit]
        ,"k3", [ГМ на авто факт]
        ,"u3", [_test ГМ на авто факт unit]
    )
VAR _actual =
        UNION (
            SELECTCOLUMNS ( _actual_wide, "_measure", "_производительность_авто_ПЛАН", "_actual", [k0], "_actual_unit", [u0], "_lo", 100, "_hi", 10000 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "_производительность_авто_ФАКТ", "_actual", [k1], "_actual_unit", [u1], "_lo", 100, "_hi", 10000 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "ГМ на авто план", "_actual", [k2], "_actual_unit", [u2], "_lo", 10, "_hi", 100 )
            ,SELECTCOLUMNS ( _actual_wide, "_measure", "ГМ на авто факт", "_actual", [k3], "_actual_unit", [u3], "_lo", 10, "_hi", 100 )
        )
VAR _expected =
        DATATABLE (
            "_measure", STRING,
            "_expected_unit", DOUBLE,
            {
                { "_производительность_авто_ПЛАН", 884.9378035561388 },
                { "_производительность_авто_ФАКТ", 753.4772201555679 },
                { "ГМ на авто план", 7022.69 },
                { "ГМ на авто факт", 7070.292666 }
            }
        )
RETURN
    ADDCOLUMNS (
        NATURALLEFTOUTERJOIN ( _expected, _actual )
        ,"_multiplier", DIVIDE ( [_actual], [_actual_unit] )
        ,"_pass",
            VAR _e      = [_expected_unit]
            VAR _u      = [_actual_unit]
            VAR _m      = DIVIDE ( [_actual], [_actual_unit] )
            VAR _unit_ok =
                IF (
                    ISBLANK ( _e )
                    ,ISBLANK ( _u )
                    ,NOT ISBLANK ( _u ) && ABS ( _u - _e ) <= _tol * MAX ( 1, ABS ( _e ) )
                )
            VAR _mult_ok =
                IF (
                    ISBLANK ( _u ) || _u = 0
                    ,ISBLANK ( [_actual] ) || [_actual] = 0
                    ,_m >= [_lo] && _m <= [_hi] && ABS ( _m - ROUND ( _m, 0 ) ) <= 1e-6
                )
            RETURN
                _unit_ok && _mult_ok
    )
ORDER BY [_pass], [_measure]

