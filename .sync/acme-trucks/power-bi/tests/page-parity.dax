                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
            )
            ,CALCULATE (
                CALCULATE ( [Time Share Δ], dim_time_category[sort_order] = 27, _v_category, _v_shown, _v_included ) * 100
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
            )
        )
        ,        ( "S3 week 5 / Month / Linear / K3 / + Undefined", "2 Effective work Plan %"
            ,CALCULATE (
                [KPI Effective Work Plan %]
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
            )
            ,CALCULATE (
                CALCULATE ( [Time Share Plan %], dim_time_category[sort_order] = 24, _v_category, _v_shown, _v_included )
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
            )
        )
        ,        ( "S3 week 5 / Month / Linear / K3 / + Undefined", "2 Effective work Fact %"
            ,CALCULATE (
                [KPI Effective Work Fact %]
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
