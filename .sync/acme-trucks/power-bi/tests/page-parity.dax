// ACME Trucks - page parity (bip, 2026-11-04): the new page "Time utilization" (ReportSectionbdcfb2b87f3167b0ec4f) must show
// the same KPI numbers as "Time util (original)" (time_util_original) under the same filters. Background and diagnosis:
// docs/ADD/features/trucks-kpi-mismatch-2026-11-04.md. Run in Power BI Desktop > DAX query view against the local Import
// model after a refresh; every row of every result tab must show _pass = TRUE. Tolerance: relative 1e-9.
// Both pages carry the report filter dim_loader[is_included] = "да" and the page filter dim_loader[contractor] = blank
// (restored on the new page 2026-11-04); their slicers share the sync groups Date, Филиал, type, _schema and
// Название ЭКС в ГД (Calculation is in no group on either page).
// New page side   = the KPI tile measures (the cards have no visual filters).
// Original side   = what that page shows for the same number: waterfall label rows 27 (Truck loading) and 24 (Effective
//                   work time) under its label tables' visual filters, its Plan / Fact cards, and for the volume Δ the
//                   difference of its two cards (the page has no Δ card), so the tab also proves Δ = Fact - Plan.
// Filter sets     = S1 the USER's context, S2 all weeks with the other switch values, S3 one week and office with work
//                   type "Undefined" added (the case where the contractor filter changes the numbers).
// Tabs: 1 new page = original page, 12 KPI values x 3 filter sets | 2 the four tiles in S1, pinned (noise off since
//       2026-11-04, so the values are deterministic); Δ = Fact - Plan (x 100 for the pp tiles)

DEFINE
    VAR _tol             = 1e-9
    VAR _r_included      = TREATAS ( { "да" }, dim_loader[is_included] )
    VAR _p_contractor    = TREATAS ( { BLANK () }, dim_loader[contractor] )
    VAR _v_category      = FILTER ( ALL ( dim_time_category[category_code] ), NOT ISBLANK ( dim_time_category[category_code] ) )
    VAR _v_shown         = TREATAS ( { "1" }, dim_time_category[is_shown] )
    VAR _v_included      = TREATAS ( { "да" }, dim_time_category[is_included] )

EVALUATE
// ---------------------------------------------------------------- 1 new page = original page, 12 KPI values x 3 filter sets
VAR _rows =
    {
        ( "S1 week 10 / Month / Weighted / Trucks + On spot", "1 Truck loading Plan %"
            ,CALCULATE (
                [KPI Truck Loading Plan %]
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "10 (4.3-10.3)" }, dim_date[week_label] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
            )
            ,CALCULATE (
                CALCULATE ( [Time Share Plan %], dim_time_category[sort_order] = 27, _v_category, _v_shown, _v_included )
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "10 (4.3-10.3)" }, dim_date[week_label] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
            )
        )
        ,        ( "S1 week 10 / Month / Weighted / Trucks + On spot", "1 Truck loading Fact %"
            ,CALCULATE (
                [KPI Truck Loading Fact %]
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "10 (4.3-10.3)" }, dim_date[week_label] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
            )
            ,CALCULATE (
                CALCULATE ( [Time Share Fact %], dim_time_category[sort_order] = 27, _v_category, _v_shown, _v_included )
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "10 (4.3-10.3)" }, dim_date[week_label] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
            )
        )
        ,        ( "S1 week 10 / Month / Weighted / Trucks + On spot", "1 Truck loading Δ pp"
            ,CALCULATE (
                [KPI Truck Loading Δ pp]
                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "10 (4.3-10.3)" }, dim_date[week_label] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Weighted" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot" }, dim_loader_work_type[work_type_name] )
            )
            ,CALCULATE (
                CALCULATE ( [Time Share Δ], dim_time_category[sort_order] = 27, _v_category, _v_shown, _v_included ) * 100
