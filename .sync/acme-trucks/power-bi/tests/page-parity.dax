                ,_r_included
                ,_p_contractor
                ,TREATAS ( { "5 (28.1-3.2)" }, dim_date[week_label] )
                ,TREATAS ( { "K3" }, dim_loader[office_name] )
                ,TREATAS ( { "Month" }, param_plan_type[plan_type_name] )
                ,TREATAS ( { "Linear" }, param_calculation[calculation_name] )
                ,TREATAS ( { "Trucks", "On spot", "Undefined" }, dim_loader_work_type[work_type_name] )
