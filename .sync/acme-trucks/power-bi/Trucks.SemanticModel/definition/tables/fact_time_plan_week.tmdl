		annotation SummarizationSetBy = Automatic

	column category_sort_2 = ```
			
			if ([indicator_name] = "КФВ" , 0 , 
			if ([indicator_name] = "ТО, ППР" , 1 , 
			if ([indicator_name] = "КР" , 2 , 
			if ([indicator_name] = "Авар. прост." , 3 , 
			if ([indicator_name] = "Ожид з/ч" , 4 , 
			if ([indicator_name] = "КТГ план" , 5 , 
			if ([indicator_name] = "Пересменок" , 6 , 
			if ([indicator_name] = "Обед" , 7 , 
			if ([indicator_name] = "Личные нужды" , 8 , 
			if ([indicator_name] = "Заправка" , 9 , 
			if ([indicator_name] = "Взрывные работы" , 10 , 
			if ([indicator_name] = "Перегоны" , 11 , 
			if ([indicator_name] = "Переключение" , 12 , 
			if ([indicator_name] = "Ожидание АС" , 13 , 
			if ([indicator_name] = "Консервация/Резерв" , 14 , 
			if ([indicator_name] = "Отсутствие экипажа" , 15 , 
			if ([indicator_name] = "Работа на другом поле" , 16 , 
			if ([indicator_name] = "Прочие простои" , 20 , 
			if ([indicator_name] = "Без классификации" , 21 , 
			if ([indicator_name] = "Отсутствие телеметрии" , 22 , 
			if ([indicator_name] = "КИО" , 23 , 
			if ([indicator_name] = "Вспомогательная работа" , 24 , 
			if ([indicator_name] = "Основная работа" , 25 , 
			if ([indicator_name] = "Погрузка самосвалов" , 26 , -1))))))))))))))))))))))))
			```
		formatString: 0
		lineageTag: 6da0756a-06b3-4eaa-8237-27f7adc3f07f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column blank_share = if([indicator_name] = "ТО, ППР", 1 - [duration_share], if([indicator_name] = "КТГ план" || [indicator_name] = "КИО" || [indicator_name] = "Проверка КТГ" , 0, 1- CALCULATE(SUM([duration_share]),FILTER(ALL(fact_time_plan_week),[dat]=EARLIER([dat]) && [category_sort_2]<=EARLIER([category_sort_2]) && [vehicle_name]=EARLIER([vehicle_name]) && [indicator_name] <> "КТГ план" && [indicator_name] <> "КИО" && [indicator_name] <> "Проверка КТГ"))))
		lineageTag: 67e6bdb6-72d0-49fd-9569-e5a25db93982
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column remainder_share = if([indicator_name] = "КТГ план" || [indicator_name] = "КИО", 0, CALCULATE(SUM([duration_share]),FILTER(ALL(fact_time_plan_week),[dat]=EARLIER([dat]) && [category_sort_2]<=EARLIER([category_sort_2]) && [vehicle_name]=EARLIER([vehicle_name])))-[duration_share])
		lineageTag: 40c26549-dcff-4b3f-a8bc-e0990af92311
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column total_share = if([indicator_name] = "КТГ план" || [indicator_name] = "КИО" || [indicator_name] = "Проверка КТГ", [duration_share])
