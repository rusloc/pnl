	column duration_share = if([indicator_name] = "КТГ план" || [indicator_name] = "КИО", [indicator_amount]/24, if([measure_name]="ч" || [measure_name]="ч." || [measure_name]="Проверка КТГ", fact_time_plan_week[indicator_amount]/24,if([measure_name]="%",[indicator_amount]/100,BLANK())))
