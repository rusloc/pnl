	partition dim_loader-5b7f0ee1-a207-465a-b9ec-dc2c989ec90b = m
		mode: import
		source =
				let
				    // Snapshot of the live model "Time unitilaztion" (DAX executeQueries, 2026-10-21), stored as Parquet.
				    // The original on-prem source is not reachable. A file source does not fold: Parquet is read whole.
				    src = Parquet.Document(File.Contents(DataFolder & "\Справочник ЭКС.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"Филиал", type text},
				            {"Название ЭКС в АСД КРВ", type text},
				            {"Название ЭКС в ГД", type text},
				            {"objrem_id", Int64.Type},
				            {"name", type text},
				            {"номер", type text},
				            {"Комментарий", type text},
				            {"Объем ковша", Int64.Type},
				            {"Учитывать", type text},
				            {"Название ЭКС в АСД Рейсы", type text},
				            {"Поле", type text},
				            {"Подрядчик", type text}
				        }
				    )
				in
				    typed

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

