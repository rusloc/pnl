	partition fact_time_plan_month-75361c70-91a8-45eb-a75d-168e26557ba6 = m
		mode: import
		source =
				let
				    // Snapshot of the live model "Time unitilaztion" (DAX executeQueries, 2026-10-21), stored as Parquet.
				    // The original on-prem source is not reachable. A file source does not fold: Parquet is read whole.
				    src = Parquet.Document(File.Contents(DataFolder & "\План_2_МЕС.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"enterprise_id", Int64.Type},
				            {"dat", type datetime},
				            {"vehicle_export_code", Int64.Type},
				            {"vehicle_name", type text},
				            {"indicator_name", type text},
				            {"measure_name", type text},
				            {"indicator_amount", type number},
				            {"period_id", Int64.Type},
				            {"_active", Int64.Type},
				            {"area", type text},
				            {"block", type text},
				            {"_id", type text}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

