	column vehicle_type_reason = "Карьерный экскаватор_" & [idle_name_for_op_2]
		lineageTag: b3689adb-0c8f-4b5e-a726-068c74a57fd3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column category_sort = RELATED(dim_time_category[sort_order])
		formatString: 0
		lineageTag: a8653631-4a80-4cdd-a376-d548e8f0f373
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column duration_share = ```
			// blank line
			
			IF(
			    fact_time_actual[idle_name_for_op]= "ktg" || fact_time_actual[idle_name_for_op]= "kio",
			    [duration] / 86400, 
			    [duration] / 86400)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 264ef096-f603-4abb-9580-415590ac5edc
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column blank_share = ```
			if([idle_name_for_op] = "ТО, ППР", 1 - [duration_share], if([idle_name_for_op] = "ktg" || [idle_name_for_op] = "kio" || [idle_name_for_op] = "kfv" , 0, 1- CALCULATE(SUM([duration_share]),FILTER(ALL(fact_time_actual),[dat]=EARLIER([dat]) && [category_sort]<=EARLIER([category_sort]) && [vehicle_name]=EARLIER([vehicle_name]) && [idle_name_for_op] <> "ktg" && [idle_name_for_op] <> "kio" && [idle_name_for_op] <> "kfv")))) 
			```
		lineageTag: fe8d727e-9040-4c17-ba96-09fa11b687b7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column remainder_share = if([idle_name_for_op] = "ktg" || [idle_name_for_op] = "kio", 0, CALCULATE(SUM([duration_share]),FILTER(ALL(fact_time_actual),[dat]=EARLIER([dat]) && [category_sort]<=EARLIER([category_sort]) && [vehicle_name]=EARLIER([vehicle_name])))-[duration_share])
		lineageTag: da806d62-c671-4281-bac5-1fb5b6380e12
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column total_share = if([idle_name_for_op] = "ktg" || [idle_name_for_op] = "kio" || [idle_name_for_op] = "kfv", [duration_share])
		lineageTag: c7009743-91a3-42d3-82f5-5eb8ce46f2a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column duration_hours =
			// blank line
			
			    [duration_share] * 24
		lineageTag: faa0bc04-a736-48ca-8181-b0d430a9846f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column idle_name_for_op_2 = ```
			// blank line
			
			SWITCH(TRUE(),
			    [idle_name_for_op] = "ktg", 
			        "КТГ", 
			    [idle_name_for_op] = "kio", 
			        "КИО", 
			    [idle_name_for_op] = "Авар. Прост.", 
			        "Авар. Прост.", 
			    [idle_name_for_op] = "Пересменка", 
			        "Пересменок", 
			    [idle_name_for_op] = "Ожидание а/с", 
			        "Ожидание АС", 
			    [idle_name_for_op] = "kfv", 
			        "КФВ",
			    [idle_name_for_op])
			```
		lineageTag: ed1699f0-1691-4aba-8fb5-5c37b52329cd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

