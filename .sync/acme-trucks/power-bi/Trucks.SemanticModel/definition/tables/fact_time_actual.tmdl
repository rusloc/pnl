	partition fact_time_actual-e48ff520-d890-4b57-9fa6-9e2d2002fbdf = m
		mode: import
		source =
				let
				    // Snapshot of the live model "Time unitilaztion" (DAX executeQueries, 2026-10-21), stored as Parquet.
				    // The original on-prem source is not reachable. A file source does not fold: Parquet is read whole.
				    src = Parquet.Document(File.Contents(DataFolder & "\ПФ КРВ.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"vehicle_export_code", Int64.Type},
				            {"vehicle_name", type text},
				            {"dat", type datetime},
				            {"idle_name_for_op", type text},
				            {"duration", type number},
				            {"ent_id", Int64.Type},
				            {"_active", Int64.Type},
				            {"area", type text},
				            {"block", type text},
				            {"_id", type text}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

