	partition dim_category = m
		mode: import
		source =
				let
				    // Portable source (ADR-0013 (b), E-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly (the data README Format section).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_category.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"category_code", type text},
				            {"category_name", type text},
				            {"division", type text},
				            {"is_seasonal", type logical},
				            {"cover_target_wks", type number},
				            {"gmroi_target", type number},
				            {"sellthrough_target", type number},
				            {"top500_skus", Int64.Type},
				            {"sort_order", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

