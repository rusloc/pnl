	column sellthrough_target
		dataType: double
		formatString: #,0.00
		lineageTag: 09d62e72-6106-595e-b0ec-feff9c57536a
		summarizeBy: none
		sourceColumn: sellthrough_target

		annotation SummarizationSetBy = User

	column top500_skus
		dataType: int64
		formatString: 0
		lineageTag: c643e9b7-3475-5e4e-84f8-0acb4c5fa0f8
