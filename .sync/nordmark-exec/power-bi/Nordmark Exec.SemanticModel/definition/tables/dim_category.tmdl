/// Category (9) with cover, GMROI and sell-through targets.
table dim_category
	lineageTag: 16c25601-f9f2-5edd-bb39-645f44f21b93

	column category_code
		dataType: string
		isHidden
		lineageTag: 4db7a1a6-42e8-5a69-9df0-12722658ebc2
		summarizeBy: none
		sourceColumn: category_code

		annotation SummarizationSetBy = User

	column category_name
		dataType: string
		lineageTag: b68751cd-0e89-5952-9ea7-a3c9d8377a06
		summarizeBy: none
		sourceColumn: category_name
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column division
		dataType: string
		lineageTag: e8c6764d-f640-5892-a942-4ea32c0e5ec1
		summarizeBy: none
		sourceColumn: division

		annotation SummarizationSetBy = User

	column is_seasonal
		dataType: boolean
		lineageTag: 8304dc2b-7ed6-5e5d-9bcb-421b47e0a646
		summarizeBy: none
		sourceColumn: is_seasonal

		annotation SummarizationSetBy = User

	column cover_target_wks
		dataType: double
		formatString: #,0.00
		lineageTag: e860e72c-53cc-5480-b98c-3bf8a5360f34
		summarizeBy: none
		sourceColumn: cover_target_wks

