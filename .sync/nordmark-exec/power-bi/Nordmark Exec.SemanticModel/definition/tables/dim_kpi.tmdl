	partition dim_kpi = m
		mode: import
		source =
				let
				    // Portable source (ADR-0013 (b), E-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly (the data README Format section).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_kpi.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"kpi_code", type text},
				            {"catalogue_no", Int64.Type},
				            {"kpi_name", type text},
				            {"domain", type text},
				            {"is_landing", type logical},
				            {"size", type text},
				            {"card_order", Int64.Type},
				            {"group", type text},
				            {"lever", type text},
				            {"horizon", type text},
				            {"owner", type text},
				            {"statement", type text},
				            {"drill_page", type text},
				            {"is_provisional", type logical},
				            {"is_stock", type logical},
				            {"direction", type text},
				            {"unit", type text},
				            {"period_basis", type text},
				            {"basis", type text},
				            {"value_metric", type text},
				            {"basis_metric", type text},
				            {"status_metric", type text},
				            {"formula", type text},
				            {"owner_initials", type text},
				            {"cadence", type text}
				        }
				    ),
				    dom = Table.Group(typed, {"domain"}, {{"domain_order", each List.Min([catalogue_no]), Int64.Type}}),
				    joined = Table.NestedJoin(typed, {"domain"}, dom, {"domain"}, "d", JoinKind.LeftOuter),
				    expanded = Table.ExpandTableColumn(joined, "d", {"domain_order"}),
				    oc = Table.AddColumn(expanded, "owner_cadence", each if [owner_initials] = null then null else [owner_initials] & " · " & [cadence], type text)
				in
				    oc

	annotation PBI_ResultType = Table

