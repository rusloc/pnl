/// Metric catalogue (web sync 2026-11-16, spec Metric): one row per engine figure; basis_code = the status basis of a card metric, flash = 1 for the EBITDA family (month to date at Week). Disconnected; [Actual] / [Basis] / [Last Year] / [Previous] read it.
table param_metric
	lineageTag: ea95e9f9-b822-5c73-99b3-6d3b711cf0d5

	column metric_code
		dataType: string
		isHidden
		lineageTag: d9e9a977-dfa0-5999-8542-1fdfa8a49645
		summarizeBy: none
		isNameInferred
		sourceColumn: [metric_code]

