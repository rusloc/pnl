/// ADR-0012 info buttons: one row per card / panel / table (code, title, what, why, formula; text from Track C copy.ts INFO after the owner changes of 2026-11-01, rounds 1-4: no Source line, change 21; L11 removed, change 14). Disconnected; each info visual is filtered to its row.
table dim_card
	lineageTag: bcec3e8e-7fea-5a71-a53c-ece78032ac25

	column card_code
		dataType: string
		isHidden
		lineageTag: 763604bd-6c23-5b32-b99a-8a836b546403
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_code]

		annotation SummarizationSetBy = User

	column card_label
		dataType: string
		lineageTag: 39ccc8f4-829f-539f-ba91-c9530074b717
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_label]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column what
		dataType: string
		lineageTag: f3aa8dfe-a5d3-5147-822b-1829f80de256
		summarizeBy: none
		isNameInferred
		sourceColumn: [what]

		annotation SummarizationSetBy = User

	column why
		dataType: string
		lineageTag: a675b82e-e1a9-5f69-a5e5-674cd6fd6302
		summarizeBy: none
		isNameInferred
		sourceColumn: [why]

		annotation SummarizationSetBy = User

	column formula
		dataType: string
		lineageTag: 602cd4c7-0578-574c-b8a6-49031f469542
		summarizeBy: none
		isNameInferred
		sourceColumn: [formula]

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ed182549-7e14-5e91-9648-410e140f2eab
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition dim_card = calculated
		mode: import
		source =
				DATATABLE (
				    "card_code", STRING
				    ,"card_label", STRING
				    ,"what", STRING
				    ,"why", STRING
				    ,"formula", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "O1", "Loans issued", "Loans disbursed in the window and their principal.", "Volume is the first Tier-1 number: did we lend what we planned?", "Count of loans with a disbursed date in the window; principal = Σ local principal ÷ actual rate of the month × currency.", 1 }
				        ,{ "O2", "New clients locked in", "Clients whose first loan was disbursed in the window.", "New clients feed next year’s repeat book; stalling acquisition shows here first.", "Σ first loans in the window (not first approval, not first account).", 2 }
				        ,{ "O3", "Returning clients", "Share of borrowers in the window who had borrowed before.", "Returning clients are cheaper to serve and lower risk.", "Distinct borrowers with an earlier loan ÷ distinct borrowers (client-weighted). No Budget exists for this ratio.", 3 }
				        ,{ "O4", "Bad / overdue loans", "Balance 30+ days past due at the last month of the window.", "The health check on the growth; down is favourable.", "(30–59 + 60–89 + 90+ DPD balance) ÷ outstanding at month-end, each market at its own rate.", 4 }
				        ,{ "O5", "Loans issued by month vs Budget", "Loans per month for the 13 months to the selected month.", "Shows whether a gap to Budget is one month or a trend.", "Monthly count of disbursed loans: Actual, Budget and the same month a year earlier.", 5 }
				        ,{ "O6", "New clients by acquisition channel", "New clients in the window by acquisition channel.", "Shows which channel carries acquisition and how it moved against last year.", "Σ first loans by channel; the outline is the same window a year earlier.", 6 }
				        ,{ "O7", "Returning clients - cohort repeat curve", "Share of a first-loan cohort with a second loan within N days.", "Early repeat is the leading signal for returning clients.", "Clients with a second loan ≤ N days after the first ÷ cohort clients; a month counts at day N once all its clients are N days old.", 7 }
				        ,{ "O8", "30+ DPD by market, 13 months", "30+ DPD by balance per market, month-end, 13 months.", "Separates a market problem from a portfolio-wide one.", "Per market: 30+ DPD balance ÷ outstanding at each month-end.", 8 }
				        ,{ "O9", "Markets", "Loans, principal, new clients, returning % and 30+ DPD per market.", "The first drill: which market drives the gap.", "Card definitions per market; Δ follows the header comparator. Click filters the page; double-click or Show loans lists the loans.", 9 }
				        ,{ "L1", "Loans", "Loans disbursed in the window.", "The volume half of originations.", "Count of loans with a disbursed date in the window.", 10 }
				        ,{ "L2", "Principal", "Disbursed principal in EUR.", "The money half of originations; FX can move it with no change in lending.", "Σ local principal ÷ actual rate of the month × currency. Constant currency re-translates actuals at the Budget rate.", 11 }
				        ,{ "L3", "Avg ticket", "Average principal per loan.", "Context for volume: bigger tickets can hide fewer loans.", "Principal ÷ loans. No favourable side.", 12 }
				        ,{ "L4", "Approval rate", "Approved share of submitted applications.", "Credit policy and applicant quality both show here.", "Approved ÷ submitted, cohorted by submission day. No Budget exists for this ratio.", 13 }
				        ,{ "L5", "Take-up rate", "Disbursed share of approved applications.", "Approved offers not taken up are lost revenue.", "Disbursed ÷ approved.", 14 }
				        ,{ "L6", "Time to cash", "Median hours from submission to cash.", "Speed wins repeat clients; down is favourable.", "Median (MEDIANX) of hours to cash over the window’s loans.", 15 }
				        ,{ "L7", "Loans by month vs Budget", "Loans per month: Actual columns, Budget line, Prior year outline.", "Month-by-month view of the volume gap.", "Monthly count of disbursed loans; Budget LOANS.", 16 }
				        ,{ "L8", "Application funnel", "Applications by funnel stage in the window.", "Shows at which step applicants are lost.", "Each column counts applications that reached the stage, on the scale of Started; its yellow top = those that did not reach the next stage. % = stage ÷ previous stage (Started ÷ leads); Δ in pp vs the same window a year earlier.", 17 }
				        ,{ "L9", "Originations bridge Budget → Actual", "Principal bridge from Budget to Actual.", "Splits the gap into lending (volume, mix, ticket) and FX.", "Volume = Δ loans × Budget ticket; mix = product × market share shift at Budget tickets; ticket = actual loans × ticket change; FX = actual at actual rates − actual at Budget rates.", 18 }
				        ,{ "L10", "Loans by product × market", "Loans in the window per product × market.", "Product mix drives ticket size and risk.", "Count of loans by product × market; grey → yellow → orange → red = few → many loans, graded over every cell of the grid.", 19 }
				        ,{ "L12", "Stage cycle time vs SLA", "Median hours of the two timed legs against the stage SLA.", "Shows which leg slows cash out.", "Submitted → approved and approved → cash medians; SLA = KYC + credit stage SLA hours.", 21 }
				        ,{ "L13", "Agent & partner leaderboard", "Agents and partners against their loan quota.", "Assisted channels depend on a few people; laggards show early.", "Agent loans ÷ AGENT_LOANS quota in the window, sorted by attainment. Click a row for that agent’s loans.", 22 }
				        ,{ "C1", "New clients", "Clients whose first loan was disbursed in the window.", "Acquisition volume against plan.", "Σ first loans in the window.", 23 }
				        ,{ "C2", "Returning clients %", "Borrowers with an earlier loan, share of all borrowers.", "Loyalty at client level.", "Distinct returning borrowers ÷ distinct borrowers. No Budget exists for this ratio.", 24 }
				        ,{ "C3", "Repeat share (loans)", "Repeat loans, share of all loans.", "Loyalty at loan level.", "Repeat loans ÷ loans.", 25 }
				        ,{ "C4", "New-client approval rate", "Approval rate of first-time applicants.", "The gate for new clients; credit policy changes show here first.", "Approved ÷ submitted for new applicants.", 26 }
				        ,{ "C5", "Returning-client approval rate", "Approval rate of applicants who have borrowed before.", "Returning clients are the cheaper book; a falling rate means credit is tightening on known payers.", "Approved ÷ submitted for returning applicants.", 27 }
				        ,{ "C6", "Days between loans", "Median days between a repeat loan and the client’s previous loan.", "How quickly clients come back. No favourable side.", "Median gap in days over the window’s repeat loans.", 28 }
				        ,{ "C7", "New clients by channel, 13 months", "New clients per month by channel, Budget total as a line.", "Shows which channel moved acquisition.", "Σ first loans by month × channel; Budget NEW_CLIENTS.", 29 }
				        ,{ "C8", "New-client funnel", "First-time applicants by stage in the window.", "Where new clients are lost.", "Leads → submitted → approved → disbursed for new applicants; every step as % of leads.", 30 }
				        ,{ "C9", "Cohort repeat by quarter cohort", "Second-loan share by days since the first loan, last four quarter cohorts (oldest on top).", "Compares how fast recent cohorts come back: read a column down.", "Clients with a second loan ≤ N days ÷ cohort clients, right-censored at the last close: a cohort not yet N days old is blank. Grey → yellow → orange → red = low → high, graded over every cell of the grid.", 31 }
				        ,{ "C10", "Repeat share by product", "Repeat share of loans per microloan product.", "Shows which products bring clients back.", "Repeat loans ÷ loans per product; tick = company average.", 32 }
				        ,{ "C11", "Acquisition by channel", "New clients of the window per acquisition channel, with how each channel converts, gets approved and comes back.", "Shows which channel brings clients who borrow again, not only the most clients.", "New clients = first loans; vs PY = the same window a year earlier (Budget has no channel split); lead → first loan = first loans ÷ first-time leads; approval = approved ÷ submitted (new, returning); repeat share = repeat loans ÷ loans; first ticket = principal of first loans ÷ first loans. Select a row, then Show clients ↗ for its clients; with no row selected, Show clients ↗ lists all channels.", 33 }
				        ,{ "P1", "30+ DPD %", "Balance 30+ days past due at the last month of the window.", "The headline risk ratio against the planned risk appetite.", "30+ DPD balance ÷ outstanding at month-end.", 34 }
				        ,{ "P2", "90+ DPD %", "Balance 90+ days past due.", "The part most likely to be written off.", "90+ DPD balance ÷ outstanding.", 35 }
				        ,{ "P3", "30+ by count", "Loans 30+ days past due, share of active loans.", "A count view of the same risk.", "Loans 30+ DPD ÷ active loans.", 36 }
				        ,{ "P4", "Vintage 6m bad rate", "Loans that reached 90+ DPD within 6 months on book.", "Judges underwriting quality early, before write-off.", "First-90+ loans with months on book ≤ 6 ÷ loans disbursed; vintage = 6 months before the selected month.", 37 }
				        ,{ "P5", "Roll rate 30→60", "Overdue balance rolling one bucket per month.", "High roll rates mean collections are not catching up.", "60–89 balance this month ÷ 30–59 balance last month (balances also amortise).", 38 }
				        ,{ "P6", "Cost of risk", "Provision charge as an annual rate of the average book.", "What the risk costs in money.", "Σ provision ÷ months × 12 ÷ average month-end outstanding.", 39 }
				        ,{ "P7", "DPD buckets, 13 months", "Overdue balance per bucket at month-end, 13 months.", "Shows whether arrears build up or clear.", "Month-end balance in 1–29, 30–59, 60–89 and 90+ DPD, in EUR.", 40 }
				        ,{ "P8", "Vintage curves", "Cumulative share of loans that reached 30+ DPD by months on book.", "Compares recent vintages at the same age.", "First-30+ loans up to month N ÷ loans disbursed, per vintage quarter.", 41 }
				        ,{ "P9", "Bad rate by product × market", "30+ DPD by balance per product × market.", "Locates the risk.", "30+ DPD balance ÷ outstanding at the last month of the window. Grey → yellow → orange → red = low → high risk, graded over every cell of the grid.", 42 }
				        ,{ "P10", "30+ DPD by market", "30+ DPD by balance per market, 13 months.", "Tracks a market’s risk story over the year.", "Per market: 30+ DPD balance ÷ outstanding at each month-end.", 43 }
				        ,{ "P11", "Roll rates by month", "Balance rolling one bucket per month.", "Early warning for rising arrears.", "30→60: 60–89 now ÷ 30–59 last month; 1–29→30+: 30–59 now ÷ 1–29 last month.", 44 }
				        ,{ "P12", "Segments: size × DPD", "One bubble per product; the small filter on the card picks the market.", "Shows whether the risky segments are also the big ones.", "x = average ticket, y = 30+ DPD by balance, size = outstanding; worst bubble in yellow.", 45 }
				        ,{ "P13", "Overdue by product", "The month-end book per microloan product: active loans, outstanding and the balance in each overdue bucket.", "Locates the overdue balance by product before the loan list.", "Balances in EUR at the last month of the window; 30+ DPD % = (30–59 + 60–89 + 90+) ÷ outstanding; vs PY = the same month a year earlier (Budget 30+ DPD exists per market only); provision = month-end provision. Select a row, then Show overdue loans ↗ for its loans 30+ DPD at the last close.", 46 }
				        ,{ "R1", "Revenue", "Revenue from interest, fees, interchange and subscriptions.", "What the loans and accounts earned.", "Σ local revenue ÷ actual rate of the month × currency.", 47 }
				        ,{ "R2", "Attainment", "Revenue against Budget.", "Are we on the number?", "Revenue ÷ Budget revenue; ≥ 100 % good, 95–99.9 % watch, below off (param_thresholds).", 48 }
				        ,{ "R3", "Interest + fees", "Interest income plus origination and late fees: the revenue the loans earn.", "The lending streams together; the Budget carries them together per loan product.", "Σ INTEREST + FEE revenue; Budget = REVENUE_LOCAL of the loan products at the BUDGET rate.", 49 }
				        ,{ "R4", "Interchange", "Interchange earned on the debit card.", "The card stream grows with account activity, outside lending.", "Σ INTERCHANGE revenue; Budget = REVENUE_LOCAL of CARD at the BUDGET rate.", 50 }
				        ,{ "R5", "MRR", "Monthly recurring revenue of paying tiers at month-end.", "The recurring part of revenue.", "Plus and Pro subscribers at month-end × monthly price, in EUR.", 51 }
				        ,{ "R6", "Paying subscribers", "Paying subscribers at month-end.", "The base that MRR rests on.", "Plus + Pro subscribers at the last month of the window.", 52 }
				        ,{ "R7", "Revenue by month vs Budget vs PY", "Revenue per month: Actual, Budget, Prior year.", "Month-by-month view of the revenue gap.", "Monthly revenue in EUR; Budget REVENUE_LOCAL at Budget rates.", 53 }
				        ,{ "R8", "Revenue by stream, 13 months", "Revenue per month by stream.", "Shows which stream moves the total.", "Monthly revenue in EUR by revenue type.", 54 }
				        ,{ "R9", "Attainment by market", "Revenue against Budget per market.", "Locates the miss.", "Revenue ÷ Budget revenue in the window; tick = Budget.", 55 }
				        ,{ "R10", "MRR and subscribers by tier", "Paying subscribers per month by tier; MRR above the columns.", "Tier mix and MRR side by side, no dual axis.", "Month-end subscribers by tier; label = MRR in EUR.", 56 }
				        ,{ "R11", "New vs churned subscribers", "Paying subscribers (Plus + Pro) gained and lost per month.", "The gap between the lines is net growth; churn catching up with sign-ups stalls MRR.", "New = subscribers who started a paid tier in the month; churned = those who left one. Churn rate = churned ÷ subscribers at the start of the month.", 57 }
				        ,{ "R12", "Channel mix, share of loans", "Share of loans per month by channel.", "Channel mix moves acquisition cost and risk.", "Loans by channel ÷ loans, per month.", 58 }
				        ,{ "R13", "Stream × market", "Revenue per stream × market.", "The detail behind the revenue cards.", "Budget exists for interchange (card), subscriptions (Plus + Pro) and the total; interest and fees share the loan-product Budget, so their rows show n/a. Click a row for that market’s loans.", 59 }
				    }
				)

	annotation PBI_ResultType = Table

