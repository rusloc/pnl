	partition fact_pl_elim = m
		mode: import
		source =
				let
				    // .sync pack: one local Parquet file per table in DataFolder (written by load_acme_pl.py --parquet-out, same types as lh_raw). A file source does not fold: the file is read whole.
				    Data = Parquet.Document(File.Contents(DataFolder & "\fact_pl_elim.parquet")),
				    // ADR-0008: read only the declared columns; pre-translated amounts as Decimal Number (double), never Fixed Decimal
				    Selected = Table.SelectColumns(Data, {"entity_code", "month_key", "version_key", "region_code", "channel_code", "line_code", "segment_code", "account_code", "counterparty_entity_code", "currency_code", "cost_centre_code", "amount_local", "amount_usd", "amount_eur", "amount_gbp"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"amount_local", Currency.Type}, {"amount_usd", type number}, {"amount_eur", type number}, {"amount_gbp", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

