/// C-40 net revenue bridge steps per entity view. Filtered by param_entity_view. CC_SUB (constant-currency subtotal) and END (actual level) are level bars of the redesigned bridge; _Bridge Value is blank for them.
table dim_bridge_step
	lineageTag: ee3d9de7-e224-59ef-86e8-927dd00da22e

	column entity_view_code
		dataType: string
		isHidden
		lineageTag: 24c727e2-6175-54eb-b88d-bf34cd943bd7
		summarizeBy: none
		isNameInferred
		sourceColumn: [entity_view_code]

		annotation SummarizationSetBy = User

	column step_code
		dataType: string
		isHidden
		lineageTag: ca1216bb-aa18-5407-8396-c050f9cfca92
		summarizeBy: none
		isNameInferred
		sourceColumn: [step_code]

		annotation SummarizationSetBy = User

	column step_label
		dataType: string
		lineageTag: 9c987466-05b5-5388-ad59-93ff28c1e92b
		summarizeBy: none
		isNameInferred
		sourceColumn: [step_label]
		sortByColumn: step_sort

		annotation SummarizationSetBy = User

	column step_sort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6bb7d9ab-4861-5734-b88a-723d46935a96
		summarizeBy: none
		isNameInferred
		sourceColumn: [step_sort]

		annotation SummarizationSetBy = User

	partition dim_bridge_step = calculated
		mode: import
		source =
				DATATABLE (
				    "entity_view_code", STRING,
				    "step_code", STRING,
				    "step_label", STRING,
				    "step_sort", INTEGER,
				    {
				        { "P", "START", "Comparison NR", 10 },
				        { "P", "VOL", "Volume", 20 },
				        { "P", "PRICE", "Price / mix", 30 },
				        { "P", "CC_SUB", "Constant-currency NR", 80 },
				        { "P", "FX", "FX", 90 },
				        { "P", "END", "Actual NR", 99 },
				        { "S", "START", "Comparison NR", 10 },
				        { "S", "SVC_SUB", "Platform subscriptions", 21 },
				        { "S", "SVC_PAY", "Payments", 22 },
				        { "S", "SVC_APP", "Apps, partners & ads", 23 },
				        { "S", "SVC_PS", "Professional services", 24 },
				        { "S", "CC_SUB", "Constant-currency NR", 80 },
				        { "S", "FX", "FX", 90 },
				        { "S", "END", "Actual NR", 99 },
				        { "GROUP", "START", "Comparison NR", 10 },
				        { "GROUP", "ENT_P", "Consumer Products", 41 },
				        { "GROUP", "ENT_S", "Commerce Cloud", 42 },
				        { "GROUP", "ELIM", "Eliminations", 43 },
				        { "GROUP", "CC_SUB", "Constant-currency NR", 80 },
				        { "GROUP", "FX", "FX", 90 },
				        { "GROUP", "END", "Actual NR", 99 }
				    }
				)

	annotation PBI_ResultType = Table

