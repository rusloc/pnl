				            ,"0.0%"
				        ,_units = "K"
				            ,"#,0;−#,0;0"
				        ,"#,0.0;−#,0.0;0.0"
				    )

	/// Base - Compare B in the selected units; ratio rows in pp.
	measure 'PL Δ B' =
			VAR _value        = [_PL Δ B]
			RETURN
			    IF ( [_PL Is Ratio], _value, DIVIDE ( _value, [_Units Divisor] ) )
		displayFolder: 1 Statement
