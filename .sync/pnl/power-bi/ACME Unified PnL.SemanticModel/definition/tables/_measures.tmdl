	/// Row shading (Ledger): key subtotals (net revenue, Adjusted EBITDA, operating profit, net profit) in the company tint [_AccT], subtotals and memo rows Subtle #F6F8FA; leaves, blocks and groups white.
	measure 'PL Row Back Color' =
			VAR _is_leaf      = ISINSCOPE ( dim_pl_row[account_label] )
			VAR _type         = SELECTEDVALUE ( dim_pl_row[row_type] )
			VAR _is_key       = SELECTEDVALUE ( dim_pl_row[is_key] )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_is_leaf
			            ,BLANK ()
			        ,_is_key = TRUE ()
			            ,[_AccT]
			        ,_type IN { "subtotal", "memo" }
			            ,"#F6F8FA"
			        ,BLANK ()
			    )
		displayFolder: 1 Statement\Formatting
		lineageTag: 89c5e441-f4a8-5b35-b1f4-bb4d9909e364

	/// Ratio rows in muted grey (italics are not available conditionally).
	measure 'PL Value Font Color' =
			VAR _is_leaf      = ISINSCOPE ( dim_pl_row[account_label] )
			VAR _is_ratio     = NOT _is_leaf && SELECTEDVALUE ( dim_pl_row[row_type] ) = "ratio"
			RETURN
			    IF ( _is_ratio, "#4F5C6C" )
		displayFolder: 1 Statement\Formatting
		lineageTag: 2a061c54-7e61-5a10-bc5e-4ca89d72ae21

	/// Font colour for the PL Δ A column: green when favourable (positive on signed values), red when unfavourable; the effective tax rate row is never coloured.
	measure 'PL Δ A Color' =
			VAR _line         = SELECTEDVALUE ( dim_pl_row[line_code] )
			VAR _delta        = [_PL Δ A]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_line = "ETR_PCT"
			            ,BLANK ()
			        ,_delta > 0
			            ,"#06603F"
			        ,_delta < 0
			            ,"#C2410C"
			        ,BLANK ()
			    )
		displayFolder: 1 Statement\Formatting
		lineageTag: e156c1f0-6c81-5bdb-8cd9-d76c51e4d263

	/// Font colour for the PL Δ B column: green when favourable (positive on signed values), red when unfavourable; the effective tax rate row is never coloured.
	measure 'PL Δ B Color' =
			VAR _line         = SELECTEDVALUE ( dim_pl_row[line_code] )
			VAR _delta        = [_PL Δ B]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_line = "ETR_PCT"
			            ,BLANK ()
			        ,_delta > 0
			            ,"#06603F"
			        ,_delta < 0
			            ,"#C2410C"
			        ,BLANK ()
			    )
		displayFolder: 1 Statement\Formatting
		lineageTag: 699d163a-716a-5408-945a-122aeceab890

	/// Font colour for the PL Δ LE vs Budget column: green when favourable (positive on signed values), red when unfavourable; the effective tax rate row is never coloured.
	measure 'PL Δ LE Color' =
			VAR _line         = SELECTEDVALUE ( dim_pl_row[line_code] )
			VAR _delta        = [_PL Δ LE]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_line = "ETR_PCT"
			            ,BLANK ()
			        ,_delta > 0
			            ,"#06603F"
			        ,_delta < 0
			            ,"#C2410C"
			        ,BLANK ()
			    )
		displayFolder: 1 Statement\Formatting
		lineageTag: ce22366d-9135-597c-b5d2-4488bdea4035

	/// Net revenue of the base at constant currency.
	measure '_NR CC Base' =
			CALCULATE (
			    [Net Revenue]
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6a580a0c-9fdf-51ab-96ec-5c99176b28d0

	/// Prior-year net revenue at the selected year's budget rates.
	measure '_PY NR CC' =
			CALCULATE (
			    [PY Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NR"
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: 9 Engine
		lineageTag: a3fcc11d-b09c-5b76-97a2-9f0fd0c7a0f1

	/// NR at constant currency / prior-year NR at the same rates, same months - 1.
	measure 'KPI Organic Growth' =
			VAR _nr_cc        = [_NR CC Base]
			VAR _py_cc        = [_PY NR CC]
			RETURN
			    IF ( ISBLANK ( _py_cc ) || ISBLANK ( _nr_cc ), BLANK (), DIVIDE ( _nr_cc, _py_cc ) - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: 03555261-9448-5a5a-8277-e5ed8cfe5891

	/// Reported NR growth vs prior year including FX (tile sub-line).
	measure 'KPI Reported Growth' =
			VAR _nr           = [Net Revenue]
			VAR _py           =
			    CALCULATE (
			        [PY Amount]
			        ,REMOVEFILTERS ( dim_pl_row )
			        ,dim_pl_row[line_code] = "NR"
			    )
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _nr ), BLANK (), DIVIDE ( _nr, _py ) - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: 83583255-ae57-5a31-ae93-c0b620286cd8

	/// Gross profit / net revenue.
	measure 'KPI Gross Margin %' = DIVIDE ( [Gross Profit], [Net Revenue] )
		formatString: 0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: d517f88b-8638-5825-889b-12ae5d3ac623

	/// - gross-to-net deductions / gross revenue.
	measure 'KPI Gross-to-Net %' = DIVIDE ( - [Gross-to-Net Deductions], [Gross Revenue] )
		formatString: 0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: c606a73b-1569-534d-bfc3-e21a100c228d

	/// Subscription (Platform subscriptions) net revenue of the last month in the window x 12.
	measure 'KPI ARR' =
			VAR _end          = [_Win End]
			VAR _fiscal_year  =
			    CALCULATE (
			        MAX ( dim_month[fiscal_year] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			VAR _month        =
			    CALCULATE (
			        MAX ( dim_month[month_number] )
			        ,REMOVEFILTERS ( dim_month )
			        ,dim_month[month_index] = _end
			    )
			VAR _value        =
			    CALCULATE (
			        [Net Revenue]
			        ,REMOVEFILTERS ( dim_line )
			        ,TREATAS ( { "SUB" }, dim_line[line_code] )
			        ,REMOVEFILTERS ( param_time_view )
			        ,TREATAS ( { "MTD" }, param_time_view[time_view_code] )
			        ,REMOVEFILTERS ( param_fiscal_year )
			        ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
			        ,REMOVEFILTERS ( param_period )
			        ,TREATAS ( { _month }, param_period[month_number] )
			    )
			RETURN
			    IF ( ISBLANK ( _end ), BLANK (), _value * 12 )
		formatString: #,0;-#,0;0
		displayFolder: 3 KPIs\Items
		lineageTag: ad5c2502-4dce-5d97-afb1-ad2b92eca3d1

	/// Commerce Cloud NR after eliminations / group NR (Group view).
	measure 'KPI Services Share' =
			VAR _services_nr  =
			    CALCULATE (
			        [Net Revenue]
			        ,KEEPFILTERS ( TREATAS ( { "S" }, dim_entity[entity_code] ) )
			    )
			RETURN
			    IF ( [_Sel Entity] = "GROUP", DIVIDE ( _services_nr, [Net Revenue] ) )
		formatString: 0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: f5801ce9-bf41-53f5-bf4f-3c25acc23c27

	/// - (Advertising: working media + Consumer promotions, sampling & sponsorship) / net revenue.
	measure 'KPI A&P % NR' =
			VAR _ap          =
			    CALCULATE (
			        [Base Amount]
			        ,KEEPFILTERS ( TREATAS ( { "SM_P1", "SM_P2" }, dim_account[account_code] ) )
			    )
			RETURN
			    DIVIDE ( - _ap, [Net Revenue] )
		formatString: 0.0%
		displayFolder: 3 KPIs\Items
		lineageTag: 53d7ef57-7cbe-514f-b294-62370c51932a

	/// GMV processed, translated like amounts (local currency at source).
	measure 'KPI GMV' =
			CALCULATE (
			    [Base Amount]
			    ,REMOVEFILTERS ( param_metric )
			    ,TREATAS ( { "GMV" }, param_metric[metric_code] )
			)
		formatString: #,0;-#,0;0
		displayFolder: 3 KPIs\Items
		lineageTag: 909111bf-6cb7-5c7b-9e5f-93a2025d2a8c

	/// Payments net revenue / GMV processed.
	measure 'KPI Payments Take Rate' =
			VAR _payments_nr  =
			    CALCULATE (
			        [Net Revenue]
			        ,REMOVEFILTERS ( dim_line )
			        ,TREATAS ( { "PAY" }, dim_line[line_code] )
			    )
			VAR _gmv          =
			    CALCULATE (
			        [KPI GMV]
			        ,REMOVEFILTERS ( dim_line )
			        ,TREATAS ( { "PAY" }, dim_line[line_code] )
			    )
			RETURN
			    DIVIDE ( _payments_nr, _gmv )
		formatString: 0.00%
		displayFolder: 3 KPIs\Items
		lineageTag: 56d2859c-6a39-5857-ab4a-38649372f3cf

	/// Fees billed by Commerce Cloud to Consumer Products in the window (Group view), positive.
	measure 'KPI IC Eliminated' =
			VAR _elim_revenue =
			    CALCULATE (
			        [Base Amount]
			        ,KEEPFILTERS ( TREATAS ( { "ELIM_GR" }, dim_account[account_code] ) )
			    )
			RETURN
			    IF ( [_Sel Entity] = "GROUP", - _elim_revenue )
		formatString: #,0;-#,0;0
		displayFolder: 3 KPIs\Items
