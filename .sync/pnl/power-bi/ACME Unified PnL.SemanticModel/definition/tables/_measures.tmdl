	/// Gross margin % of the slice at constant currency (Profitability table, PV-02).
	measure 'Prof GM %' =
			CALCULATE (
			    [KPI Gross Margin %]
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
