		formatString: 0.0%
		isHidden
		displayFolder: 5 Profitability
		lineageTag: da655058-6215-52a0-ae78-a8146559de98

	/// Mix heatmap cell: net revenue and share of the region (two lines). Company view: its own service lines / categories. Group view: both companies' lines, each computed in its own company (share = of that company's revenue in the region).
	measure 'Heat Cell' =
			VAR _view         = [_Sel Entity]
			VAR _line_entity  = SELECTEDVALUE ( dim_line[entity_code] )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,NOT ISINSCOPE ( dim_line[line_name] )
			            ,[_Heat Cell Raw]
			        ,SELECTEDVALUE ( dim_line[is_unassigned] ) = TRUE ()
			            ,BLANK ()
			        ,_view = "GROUP"
			            ,CALCULATE (
			                [_Heat Cell Raw]
			                ,REMOVEFILTERS ( param_entity_view )
			                ,TREATAS ( { _line_entity }, param_entity_view[entity_view_code] )
			            )
			        ,_line_entity = _view
			            ,[_Heat Cell Raw]
			    )
		displayFolder: 5 Profitability
		lineageTag: 56d957aa-c94e-5b43-85d3-01aa4b32c9c7

	/// Mix heatmap cell colour before the company switch: company tint (accT) to company colour (acc) in 4 steps by the column's gross margin % (< 30 %, < 50 %, < 70 %, >= 70 %; PV-03).
	measure '_Heat GM Fill Raw' =
			VAR _gm           = [_Heat Colour GM]
			VAR _t            =
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _gm )
			            ,-1
			        ,_gm < 0.3
			            ,0.15
			        ,_gm < 0.5
			            ,0.4
			        ,_gm < 0.7
			            ,0.65
			        ,0.9
			    )
			VAR _from         = [_AccT]
			VAR _to           = [_Acc]
			VAR _hex          = "0123456789ABCDEF"
			VAR _channel      =
			    ADDCOLUMNS (
			        { 2, 4, 6 }
			        ,"@from", ( SEARCH ( MID ( _from, [Value], 1 ), _hex ) - 1 ) * 16 + SEARCH ( MID ( _from, [Value] + 1, 1 ), _hex ) - 1
			        ,"@to", ( SEARCH ( MID ( _to, [Value], 1 ), _hex ) - 1 ) * 16 + SEARCH ( MID ( _to, [Value] + 1, 1 ), _hex ) - 1
			    )
			VAR _mixed        =
			    CONCATENATEX (
			        _channel
			        ,VAR _c           = ROUND ( [@from] + ( [@to] - [@from] ) * _t, 0 )
			         RETURN
			             MID ( _hex, INT ( _c / 16 ) + 1, 1 ) & MID ( _hex, MOD ( _c, 16 ) + 1, 1 )
			        ,""
			        ,[Value], ASC
			    )
			RETURN
			    IF ( _t >= 0, "#" & _mixed, "#FFFFFF" )
		isHidden
		displayFolder: Design
		lineageTag: 6f865807-3107-533c-a462-f82413774768

	/// Mix heatmap text colour before the company switch (white on the two dark steps; column GM %, PV-03).
	measure '_Heat GM Ink Raw' =
			VAR _gm           = [_Heat Colour GM]
			RETURN
			    IF ( _gm >= 0.5, "#FFFFFF", "#101B2B" )
		isHidden
		displayFolder: Design
		lineageTag: d21421e7-fc45-545b-a59e-5df6c809f77d

	/// Info tooltip title: panel (dim_pl_info) or Vitals card (dim_kpi.info_title), Track C copy with {cmp} / {line} filled from the selection.
	measure 'Info Title' =
			SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dim_pl_info[title] ), SELECTEDVALUE ( dim_kpi[info_title] ) ), "{cmp}", [_Bridge Cmp Name] ), "{line}", IF ( [_Sel Entity] = "P", "category", "service line" ) )
		displayFolder: Design
		lineageTag: 401aabd2-4736-588c-91f1-df18912e15d7

	/// Info tooltip: what it is (Track C copy), {cmp} / {line} filled from the selection.
	measure 'Info Text' =
			SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dim_pl_info[what] ), SELECTEDVALUE ( dim_kpi[definition] ) ), "{cmp}", [_Bridge Cmp Name] ), "{line}", IF ( [_Sel Entity] = "P", "category", "service line" ) )
		displayFolder: Design
		lineageTag: 96338851-a8b9-5526-923f-d63174902799

	/// Info tooltip sub-values: the Vitals card's values (KPI Info Sub); blank for panels.
	measure 'Info Detail' =
			IF ( NOT ISFILTERED ( dim_pl_info[info_code] ), [KPI Info Sub] )
		displayFolder: Design
		lineageTag: fc8e8d0b-a369-5fdf-b707-129d13cfc839

	/// Info tooltip: the formula (Track C copy).
	measure 'Info Formula' =
			SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dim_pl_info[formula] ), SELECTEDVALUE ( dim_kpi[info_formula] ) ), "{cmp}", [_Bridge Cmp Name] ), "{line}", IF ( [_Sel Entity] = "P", "category", "service line" ) )
		displayFolder: Design
		lineageTag: ba8bafaf-3b85-5a16-8a8f-905b3486e45f

	/// Info tooltip: the measures and tables behind it (Track C copy).
	measure 'Info Source' =
			"Source: " & SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dim_pl_info[source] ), SELECTEDVALUE ( dim_kpi[info_source] ) ), "{cmp}", [_Bridge Cmp Name] ), "{line}", IF ( [_Sel Entity] = "P", "category", "service line" ) )
		displayFolder: Design
		lineageTag: 7b578315-d6cb-5d54-b2eb-358f438c4cae

	/// Text of the info buttons (each is filtered to its dim_kpi codes or dim_pl_info row; hover opens tt_pl_info).
	measure 'Info Glyph' = "i"
		displayFolder: Design
		lineageTag: 3b2bf047-9aaf-58ce-9b2a-c0ced1637984

	/// Pager counter, page 1.
	measure 'Pager Text 1' = "1 / 2"
		displayFolder: Design
		lineageTag: df91f0c4-1c45-57a0-8314-4e2cbce58f20

	/// Pager counter, page 2.
	measure 'Pager Text 2' = "2 / 2"
		displayFolder: Design
		lineageTag: 8a84b19b-c7ed-53dc-b6dd-95dbae801680

	/// Title of the net revenue bridge.
	measure 'NR Bridge Title' = "Net revenue bridge - " & [_Bridge Cmp Name] & " to Actual - " & [_Units Short]
		displayFolder: Design
		lineageTag: b467d295-66a3-50e2-950b-579a76115ca2

	/// Profit bridge title as Track C: Profit bridge: Budget Adj. EBITDA → Actual → Operating profit.
	measure 'Profit Bridge Title' =
			"Profit bridge: " & [_Bridge Cmp Name] & " Adj. EBITDA → Actual → Operating profit"
		displayFolder: Design
		lineageTag: dc068a60-e2c0-5456-b4d1-be8c048db7ff

	/// 1 when the bridge step on the axis belongs to the selected company (Bridge Is Total reads it, so steps of another company drop out of the redesigned NR bridge).
	measure 'Bridge Step In View' =
			VAR _view        = [_Sel Entity]
			RETURN
			    IF (
			        NOT ISEMPTY ( FILTER ( VALUES ( dim_bridge_step[entity_view_code] ), dim_bridge_step[entity_view_code] = _view ) )
			        ,1
			    )
		formatString: 0
		isHidden
		displayFolder: 4 Analysis
		lineageTag: 9867ecb1-7432-5ce6-94ce-5398606ebd7e


	column measure_table
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5f1a7066-2cd4-5581-a442-741962985bee
		summarizeBy: none
		isNameInferred
		sourceColumn: [measure_table]

		annotation SummarizationSetBy = User

	partition _measures = calculated
		mode: import
		source = ROW ( "measure_table", 0 )

	annotation PBI_ResultType = Table

