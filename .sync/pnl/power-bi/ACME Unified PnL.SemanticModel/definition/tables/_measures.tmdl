	/// Contribution margin % of the slice at constant currency (Profitability table and growth x margin y axis, PV-02).
	measure 'Prof CM %' =
			CALCULATE (
			    [KPI CM %]
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		formatString: 0.0%
