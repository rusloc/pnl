		displayFolder: 5 Profitability
		lineageTag: 69a0bcbb-d5d2-569a-a995-1d0f22ba3002

	/// Adjusted EBITDA of the slice at constant currency in the selected units (PV-02; by region opex is booked, C-31).
	measure 'Prof Adj EBITDA' =
			CALCULATE (
			    DIVIDE ( [Adjusted EBITDA], [_Units Divisor] )
			    ,REMOVEFILTERS ( param_fx_basis )
