	/// Display name of the base version.
	measure '_Base Name' = SWITCH ( [_Sel Base Version], "LE", "Latest estimate", "B", "Budget", "Actual" )
		isHidden
		displayFolder: Design
		lineageTag: 7dab5a58-9fde-5347-aacb-7602fa102754

	/// Display name of Compare A; blank when None.
	measure '_Cmp A Name' = SWITCH ( [_Sel Compare A], "B", "Budget", "LE", "Latest estimate", "PY", "Prior year" )
		isHidden
		displayFolder: Design
		lineageTag: 22d58d24-fd24-5ae6-857b-79017edfaa6c

	/// Display name of Compare B; blank when None.
	measure '_Cmp B Name' = SWITCH ( [_Sel Compare B], "B", "Budget", "LE", "Latest estimate", "PY", "Prior year" )
		isHidden
		displayFolder: Design
		lineageTag: f14ea1d5-2af3-5174-a996-ae18853e4c33

	/// Display name of the comparison used by the bridge and largest variances: Compare A, else Compare B, else prior year.
	measure '_Bridge Cmp Name' =
			VAR _compare_a    = [_Cmp A Name]
			VAR _compare_b    = [_Cmp B Name]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,NOT ISBLANK ( _compare_a )
			            ,_compare_a
			        ,NOT ISBLANK ( _compare_b )
			            ,_compare_b
			        ,"Prior year"
			    )
		isHidden
