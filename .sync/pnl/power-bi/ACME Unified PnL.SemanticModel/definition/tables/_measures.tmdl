	/// Profitability table subtitle as Track C: Constant currency (FY2025 budget rates) - USD m - vs Budget (PV-02, PV-06).
	measure 'Prof Subtitle CC' =
			"Constant currency (FY" & [_Sel FY] & " budget rates) - " & [_Units Short] & " - vs " & [_Bridge Cmp Name]
		displayFolder: Design
		lineageTag: 94499eeb-8f53-5af9-bbbf-11ebeec3162e

	/// Concentration: the region's share of net revenue, contribution or Adj. EBITDA (dim_conc_level) at constant currency (PV-02).
	measure 'Conc Share' =
			CALCULATE (
			    VAR _level        = SELECTEDVALUE ( dim_conc_level[level_code] )
			    VAR _value        =
			        SWITCH (
			            _level
			            ,"NR"
			                ,[Net Revenue]
			            ,"CM"
			                ,[Contribution Margin]
			            ,"EBITDA"
			                ,[Adjusted EBITDA]
			        )
			    VAR _total        =
			        CALCULATE (
			            SWITCH (
			                _level
			                ,"NR"
			                    ,[Net Revenue]
			                ,"CM"
			                    ,[Contribution Margin]
			                ,"EBITDA"
			                    ,[Adjusted EBITDA]
			            )
			            ,ALLSELECTED ( dim_region )
			        )
			    RETURN
			        DIVIDE ( _value, _total )
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		formatString: 0.0%
		displayFolder: 5 Profitability
		lineageTag: 6f66d846-9263-5966-a985-a1bb7ee88020

	/// Company organic growth (reference line of the growth x margin chart).
	measure 'Prof Company Growth' =
			CALCULATE (
			    [KPI Organic Growth]
			    ,ALLSELECTED ( dim_region )
			)
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 5 Profitability
		lineageTag: 3d46809e-f66d-5f3b-b3d9-4334e23aa681

	/// Company CM % at constant currency: the horizontal reference line of the growth x margin chart (PV-02).
	measure 'Prof Company CM %' =
			CALCULATE (
			    CALCULATE (
			        [KPI CM %]
			        ,ALLSELECTED ( dim_region )
			    )
			    ,REMOVEFILTERS ( param_fx_basis )
