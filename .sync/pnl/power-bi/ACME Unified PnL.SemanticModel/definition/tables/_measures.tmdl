	/// Mix heatmap title as Track C: Mix - region × service line (Commerce Cloud, Group) or category (Consumer Products).
	measure 'Heat Title' =
			"Mix - region × " & IF ( [_Sel Entity] = "P", "category", "service line" )
		displayFolder: Design
		lineageTag: 69cc7391-a355-505e-9e56-a17a3274b12b

	/// How to read, first line (Track C js-report/lib/engine/view-copy.ts): the period summary - currency and units - vs the comparisons, e.g. Showing Jan – Sep 2026 - year to date - USD m - vs Budget and Prior year.
	measure 'How To Read Showing' =
			[Period Summary] & " - " & [_Units Short] & " - vs " & IF ( [_Sel Compare A] = "NONE" && [_Sel Compare B] = "NONE", "Prior year", IF ( [_Sel Compare A] <> "NONE", [_Cmp A Name] ) & IF ( [_Sel Compare A] <> "NONE" && [_Sel Compare B] <> "NONE", " and " ) & IF ( [_Sel Compare B] <> "NONE", [_Cmp B Name] ) )
		displayFolder: Design
		lineageTag: a830b7f9-03ea-5f2b-9fea-3a8b8392a460

	/// Growth × margin chart: minimum of the growth axis = the regions' minimum - 35 % of their range, so bubbles and the quadrant labels in the plot corners do not collide.
	measure 'Bubble X Min' =
			VAR _points       =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dim_region[region_name] )
			            ,"@v", [KPI Organic Growth]
			        )
			        ,NOT ISBLANK ( [@v] )
			    )
			VAR _lo           = MINX ( _points, [@v] )
			VAR _hi           = MAXX ( _points, [@v] )
			VAR _pad          = MAX ( ( _hi - _lo ) * 0.35, 0.002 )
			RETURN
			    _lo - _pad
		formatString: 0.0%
		displayFolder: Design
		lineageTag: 8eb47bef-4d00-570c-9034-e83256abf485

	/// Growth × margin chart: maximum of the growth axis = the regions' maximum + 35 % of their range, so bubbles and the quadrant labels in the plot corners do not collide.
	measure 'Bubble X Max' =
			VAR _points       =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dim_region[region_name] )
			            ,"@v", [KPI Organic Growth]
			        )
			        ,NOT ISBLANK ( [@v] )
			    )
			VAR _lo           = MINX ( _points, [@v] )
			VAR _hi           = MAXX ( _points, [@v] )
			VAR _pad          = MAX ( ( _hi - _lo ) * 0.35, 0.002 )
			RETURN
			    _hi + _pad
		formatString: 0.0%
		displayFolder: Design
		lineageTag: f3e1be66-07d0-5359-a37e-083fc6f33069

	/// Growth × margin chart: minimum of the CM % axis (constant currency) with 35 % of the range as padding, so bubbles and the corner quadrant labels do not collide.
	measure 'Bubble Y Min' =
			VAR _points       =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dim_region[region_name] )
			            ,"@v", [Prof CM %]
			        )
			        ,NOT ISBLANK ( [@v] )
			    )
			VAR _lo           = MINX ( _points, [@v] )
			VAR _hi           = MAXX ( _points, [@v] )
			VAR _pad          = MAX ( ( _hi - _lo ) * 0.35, 0.002 )
			RETURN
			    _lo - _pad
		formatString: 0.0%
		displayFolder: Design
		lineageTag: de3c054b-8be8-5d32-8d04-8154bc32cb21

	/// Growth × margin chart: maximum of the CM % axis (constant currency) with 35 % of the range as padding, so bubbles and the corner quadrant labels do not collide.
	measure 'Bubble Y Max' =
			VAR _points       =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dim_region[region_name] )
			            ,"@v", [Prof CM %]
			        )
			        ,NOT ISBLANK ( [@v] )
			    )
			VAR _lo           = MINX ( _points, [@v] )
			VAR _hi           = MAXX ( _points, [@v] )
			VAR _pad          = MAX ( ( _hi - _lo ) * 0.35, 0.002 )
			RETURN
			    _hi + _pad
		formatString: 0.0%
		displayFolder: Design
		lineageTag: d425a3db-cb7f-538e-b0d3-b247e6b866e0

	/// Mix heatmap cell text before the company switch: net revenue at constant currency (display units) over its share of the region (PV-02).
	measure '_Heat Cell Raw' =
			CALCULATE (
			    VAR _nr           = [Net Revenue]
			    VAR _region_nr    =
			        CALCULATE (
			            [Net Revenue]
			            ,REMOVEFILTERS ( dim_line )
			        )
			    VAR _format       = IF ( [_Sel Units] = "K", "#,0;−#,0;0", "#,0.0;−#,0.0;0.0" )
			    RETURN
			        IF (
			            NOT ISBLANK ( _nr )
			            ,FORMAT ( DIVIDE ( _nr, [_Units Divisor] ), _format ) & UNICHAR ( 10 ) & FORMAT ( DIVIDE ( _nr, _region_nr ), "0%" )
			        )
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
			)
		isHidden
		displayFolder: 5 Profitability
		lineageTag: 5b305afa-d67c-5a44-bbf2-bcfcea8c6846

	/// Mix heatmap colour basis: gross margin % of the column (service line / category) over all regions, at constant currency (parity PV-03, build-brief §3).
	measure '_Heat Colour GM' =
			CALCULATE (
			    CALCULATE (
			        [KPI Gross Margin %]
			        ,REMOVEFILTERS ( dim_region )
			    )
			    ,REMOVEFILTERS ( param_fx_basis )
			    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
