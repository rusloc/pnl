	/// Company card sub-label (Label role of the company slicer, F-01).
	measure 'Ent Card Sub' =
			SWITCH (
			    SELECTEDVALUE ( param_entity_view[entity_view_code] )
			    ,"S"
			        ,"E-commerce SaaS services"
			    ,"GROUP"
			        ,"Consolidated"
