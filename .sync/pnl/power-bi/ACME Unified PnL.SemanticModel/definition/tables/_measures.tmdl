	/// Net revenue of the bridge comparison (actual rates).
	measure 'Bridge Comparison NR' =
			CALCULATE (
			    [Bridge Comparison Amount]
			    ,REMOVEFILTERS ( dim_pl_row )
			    ,dim_pl_row[line_code] = "NR"
			)
		formatString: #,0;-#,0;0
