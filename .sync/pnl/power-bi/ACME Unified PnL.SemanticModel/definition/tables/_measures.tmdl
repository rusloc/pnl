	/// Mix heatmap cell colour by gross margin %, in the colour of the line's company.
	measure 'Heat GM Fill' =
			VAR _view         = [_Sel Entity]
			VAR _line_entity  = SELECTEDVALUE ( dim_line[entity_code] )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,NOT ISINSCOPE ( dim_line[line_name] )
			            ,[_Heat GM Fill Raw]
			        ,SELECTEDVALUE ( dim_line[is_unassigned] ) = TRUE ()
			            ,BLANK ()
			        ,_view = "GROUP"
			            ,CALCULATE (
			                [_Heat GM Fill Raw]
			                ,REMOVEFILTERS ( param_entity_view )
			                ,TREATAS ( { _line_entity }, param_entity_view[entity_view_code] )
			            )
			        ,_line_entity = _view
			            ,[_Heat GM Fill Raw]
			    )
		displayFolder: Design
		lineageTag: 3dcb2ada-5700-593a-9fed-f56a2d05397e

