{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Reset - Variance filter",
  "name": "bm_an_reset_varfilter",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "vf_region",
      "vf_channel",
      "vf_line",
      "vf_segment"
    ],
    "suppressActiveSection": true,
    "suppressDisplay": true
  },
  "explorationState": {
    "version": "1.0",
    "activeSection": "pnl_analysis",
    "sections": {
      "pnl_analysis": {
        "visualContainers": {
          "vf_region": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "vf_channel": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "vf_line": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "vf_segment": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}