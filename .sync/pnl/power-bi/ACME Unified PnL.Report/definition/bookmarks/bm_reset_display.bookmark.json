{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Reset: Display",
  "name": "bm_reset_display",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "s_currency",
      "s_fx_basis",
      "s_units"
    ],
    "suppressActiveSection": true,
    "suppressDisplay": true
  },
  "explorationState": {
    "version": "1.0",
    "activeSection": "pnl_one_pager",
    "sections": {
      "pnl_one_pager": {
        "visualContainers": {
          "s_currency": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "s_fx_basis": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          },
          "s_units": {
            "singleVisual": {
              "visualType": "advancedSlicerVisual",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}