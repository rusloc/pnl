            { "S", "NR", "EUR", "ACT", 2026, 12, "FY", "B", 758402161.109 },
            { "S", "NR", "EUR", "ACT", 2026, 12, "FY", "LE", 738019750.7997 },
            { "S", "NR", "EUR", "ACT", 2026, 9, "LTM", "A", 687616034.6275 },
            { "S", "NR", "EUR", "ACT", 2026, 9, "YTD", "A", 509924602.1369 },
            { "S", "NR", "GBP", "ACT", 2025, 12, "FY", "A", 500401666.629 },
            { "S", "NR", "GBP", "ACT", 2026, 12, "FY", "B", 653794966.4735 },
            { "S", "NR", "GBP", "ACT", 2026, 12, "FY", "LE", 634566456.0834 },
            { "S", "NR", "GBP", "ACT", 2026, 9, "LTM", "A", 590751478.908 },
            { "S", "NR", "GBP", "ACT", 2026, 9, "YTD", "A", 438602018.7613 },
            { "S", "NR", "USD", "ACT", 2025, 12, "FY", "A", 667360690.8432 },
            { "S", "NR", "USD", "ACT", 2026, 12, "FY", "B", 871726621.9644 },
            { "S", "NR", "USD", "ACT", 2026, 12, "FY", "LE", 860955932.1888 },
            { "S", "NR", "USD", "ACT", 2026, 9, "LTM", "A", 803176326.4956 },
            { "S", "NR", "USD", "ACT", 2026, 9, "YTD", "A", 595967635.7344 },
            { "S", "NR", "EUR", "CC", 2025, 12, "FY", "A", 609734031.4074 },
            { "S", "NR", "EUR", "CC", 2026, 12, "FY", "B", 758402161.109 },
            { "S", "NR", "EUR", "CC", 2026, 12, "FY", "LE", 743907949.5766 },
            { "S", "NR", "EUR", "CC", 2026, 9, "LTM", "A", 693902515.7488 },
            { "S", "NR", "EUR", "CC", 2026, 9, "YTD", "A", 514735410.7737 },
            { "S", "NR", "GBP", "CC", 2025, 12, "FY", "A", 517946112.7007 },
            { "S", "NR", "GBP", "CC", 2026, 12, "FY", "B", 653794966.4735 },
            { "S", "NR", "GBP", "CC", 2026, 12, "FY", "LE", 641299956.5311 },
            { "S", "NR", "GBP", "CC", 2026, 9, "LTM", "A", 598191823.9211 },
            { "S", "NR", "GBP", "CC", 2026, 9, "YTD", "A", 443737423.0805 },
            { "S", "NR", "USD", "CC", 2025, 12, "FY", "A", 655627990.7607 },
            { "S", "NR", "USD", "CC", 2026, 12, "FY", "B", 871726621.9644 },
            { "S", "NR", "USD", "CC", 2026, 12, "FY", "LE", 855066608.7087 },
            { "S", "NR", "USD", "CC", 2026, 9, "LTM", "A", 797589098.5618 },
            { "S", "NR", "USD", "CC", 2026, 9, "YTD", "A", 591649897.4411 }
        }
    )
VAR _rows =
    ADDCOLUMNS (
        _expected
        ,"_model",
            VAR _entity      = [_entity]
            VAR _item        = [_item]
            VAR _ccy         = [_ccy]
            VAR _fx_basis    = [_fx]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            RETURN
                CALCULATE (
                    SWITCH (
                        _item
                        ,"KPI_GMV"
                            ,[KPI GMV]
                        ,"KPI_IC_ELIM"
                            ,[KPI IC Eliminated]
                        ,CALCULATE (
                            [Base Amount]
                            ,REMOVEFILTERS ( dim_pl_row )
                            ,TREATAS ( { _item }, dim_pl_row[line_code] )
                        )
                    )
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { _ccy }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { _fx_basis }, param_fx_basis[fx_basis_code] )
                )
    )
VAR _checked =
    ADDCOLUMNS ( _rows, "_abs_diff", ABS ( [_model] - [_expected] ) )
RETURN
    ROW (
        "_test", "ADR-0008 FX paths"
        ,"_rows_checked", COUNTROWS ( _checked )
        ,"_rows_failed", COUNTROWS ( FILTER ( _checked, [_abs_diff] >= 0.01 ) ) + 0
        ,"_max_abs_diff", MAXX ( _checked, [_abs_diff] )
        ,"_pass", COUNTROWS ( FILTER ( _checked, [_abs_diff] >= 0.01 ) ) + 0 = 0
    )

EVALUATE
// ---------------------------------------------------------------- ADR-0008 eliminations at account level: ACME Group statement leaves of blocks GR and VSC (ACT FY2026 YTD Sep; USD and GBP at actual rates, EUR at constant currency). Leaves like GR_S1 / VSC_P4 keep the entity amounts, only ELIM_GR / ELIM_VSC carry the elimination. Expected = the pre-ADR-0008 formula, captured 2026-10-23.
VAR _expected =
    DATATABLE (
        "_ccy", STRING,
        "_fx", STRING,
        "_account", STRING,
        "_expected", DOUBLE,
        {
            { "USD", "ACT", "GR_P1", 4302361064.8136 },
            { "GBP", "ACT", "GR_P1", 3165852384.6541 },
            { "EUR", "CC", "GR_P1", 3710546850.6961 },
            { "USD", "ACT", "GR_P2", 18640110.2371 },
            { "GBP", "ACT", "GR_P2", 13717301.5863 },
            { "EUR", "CC", "GR_P2", 16076307.019 },
            { "USD", "ACT", "GR_S1", 242937354.9211 },
            { "GBP", "ACT", "GR_S1", 178770056.8979 },
            { "EUR", "CC", "GR_S1", 209819316.894 },
            { "USD", "ACT", "GR_S2", 304271909.5923 },
            { "GBP", "ACT", "GR_S2", 223957449.7927 },
            { "EUR", "CC", "GR_S2", 262802663.5625 },
            { "USD", "ACT", "GR_S3", 44294515.331 },
            { "GBP", "ACT", "GR_S3", 32595142.6835 },
            { "EUR", "CC", "GR_S3", 38259071.9066 },
            { "USD", "ACT", "GR_S4", 31756161.424 },
            { "GBP", "ACT", "GR_S4", 23363461.5852 },
            { "EUR", "CC", "GR_S4", 27427379.3749 },
            { "USD", "ACT", "ELIM_GR", -21802071.8746 },
            { "GBP", "ACT", "ELIM_GR", -16044188.8755 },
            { "EUR", "CC", "ELIM_GR", -18803352.7288 },
            { "USD", "ACT", "VSC_P1", -117586107.109 },
            { "GBP", "ACT", "VSC_P1", -86526123.5587 },
            { "EUR", "CC", "VSC_P1", -101411992.5072 },
            { "USD", "ACT", "VSC_P2", -66233816.1649 },
            { "GBP", "ACT", "VSC_P2", -48738306.2993 },
            { "EUR", "CC", "VSC_P2", -57123252.6799 },
            { "USD", "ACT", "VSC_P3", -112988178.9795 },
            { "GBP", "ACT", "VSC_P3", -83146018.806 },
            { "EUR", "CC", "VSC_P3", -97445483.4921 },
            { "USD", "ACT", "VSC_P4", -21802071.8746 },
            { "GBP", "ACT", "VSC_P4", -16044188.8755 },
            { "EUR", "CC", "VSC_P4", -18803352.7288 },
            { "USD", "ACT", "VSC_P5", -30234954.5842 },
            { "GBP", "ACT", "VSC_P5", -22247410.7625 },
            { "EUR", "CC", "VSC_P5", -26075678.5015 },
            { "USD", "ACT", "VSC_S1", -10280491.9312 },
            { "GBP", "ACT", "VSC_S1", -7565242.8933 },
            { "EUR", "CC", "VSC_S1", -8879161.502 },
            { "USD", "ACT", "VSC_S2", -9137032.5076 },
            { "GBP", "ACT", "VSC_S2", -6723996.0193 },
            { "EUR", "CC", "VSC_S2", -7891913.6205 },
            { "USD", "ACT", "VSC_S3", -9435497.2121 },
            { "GBP", "ACT", "VSC_S3", -6944644.6411 },
            { "EUR", "CC", "VSC_S3", -8150688.6494 },
            { "USD", "ACT", "ELIM_VSC", 21802071.8746 },
            { "GBP", "ACT", "ELIM_VSC", 16044188.8755 },
            { "EUR", "CC", "ELIM_VSC", 18803352.7288 }
        }
    )
VAR _cases =
    DATATABLE (
        "_ccy", STRING,
        "_fx", STRING,
        {
            { "USD", "ACT" },
            { "GBP", "ACT" },
            { "EUR", "CC" }
        }
    )
VAR _model =
    SELECTCOLUMNS (
        GENERATE (
            _cases
            ,VAR _ccy        = [_ccy]
             VAR _fx_basis   = [_fx]
             RETURN
                 SUMMARIZECOLUMNS (
                     dim_pl_row[line_code]
                     ,dim_pl_row[account_code]
                     ,dim_pl_row[account_label]
                     ,TREATAS ( { "GR", "VSC" }, dim_pl_row[line_code] )
                     ,TREATAS ( { "GROUP" }, param_entity_view[entity_view_code] )
                     ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                     ,TREATAS ( { 9 }, param_period[month_number] )
                     ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                     ,TREATAS ( { _ccy }, param_reporting_currency[currency_code] )
                     ,TREATAS ( { _fx_basis }, param_fx_basis[fx_basis_code] )
                     ,"_v", [_PL Base]
                 )
        )
        ,"_m_ccy", [_ccy]
        ,"_m_fx", [_fx]
        ,"_m_account", dim_pl_row[account_code]
        ,"_m_value", [_v]
    )
VAR _joined =
    ADDCOLUMNS (
        _expected
        ,"_model",
            VAR _ccy         = [_ccy]
            VAR _fx_basis    = [_fx]
            VAR _account     = [_account]
            RETURN
                MAXX (
                    FILTER (
                        _model
                        ,[_m_ccy] = _ccy
                            && [_m_fx] = _fx_basis
                            && [_m_account] = _account
                    )
                    ,[_m_value]
                )
    )
VAR _checked =
    ADDCOLUMNS ( _joined, "_abs_diff", ABS ( [_model] - [_expected] ) )
RETURN
    SELECTCOLUMNS (
        _checked
        ,"_test", "ADR-0008 elimination leaves"
        ,"_ccy", [_ccy]
        ,"_fx", [_fx]
        ,"_account", [_account]
        ,"_model", [_model]
        ,"_expected", [_expected]
        ,"_pass", NOT ISBLANK ( [_model] ) && [_abs_diff] < 0.01
    )
ORDER BY [_fx], [_ccy], [_account]

EVALUATE
// ---------------------------------------------------------------- T-R1 Vitals (views redesign v4): Opex % NR = -(SM + RD + GA) / NR from the statement lines, revenue mix = SUB NR / NR, FY outlook = FY LE NR, every Vitals card renders (SVG data URI); actual scenarios, Compare A = Budget, Compare B = Prior year
VAR _rows =
    ADDCOLUMNS (
        FILTER ( _scenarios, [_base] = "A" )
        ,"_opex_model",
            CALCULATE (
                [_KPI Value]
                ,TREATAS ( { "OPEX_PCT" }, dim_kpi[kpi_code] )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { "A" }, param_base_version[choice_code] )
            )
        ,"_opex_lines",
            CALCULATE (
                DIVIDE (
                    -CALCULATE ( [Base Amount], REMOVEFILTERS ( dim_pl_row ), KEEPFILTERS ( dim_account[block_code] IN { "SM", "RD", "GA" } ) )
                    ,[Net Revenue]
                )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { "A" }, param_base_version[choice_code] )
            )
        ,"_fy_model",
            CALCULATE (
                [_KPI Value]
                ,TREATAS ( { "FY_OUTLOOK" }, dim_kpi[kpi_code] )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { "A" }, param_base_version[choice_code] )
            )
        ,"_fy_le",
            CALCULATE (
                [FY LE Amount]
                ,REMOVEFILTERS ( dim_pl_row )
                ,dim_pl_row[line_code] = "NR"
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
            )
        ,"_cards_rendered",
            VAR _entity      = [_entity]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            RETURN
                COUNTROWS (
                    FILTER (
                        CALCULATETABLE (
                            ADDCOLUMNS (
                                FILTER ( dim_kpi, dim_kpi[vitals_slot] > 0 )
                                ,"@svg", [Vitals Card SVG]
                            )
                            ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                            ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                            ,TREATAS ( { _month }, param_period[month_number] )
                            ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                            ,TREATAS ( { "A" }, param_base_version[choice_code] )
                            ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                        )
                        ,LEFT ( [@svg], 26 ) = "data:image/svg+xml;utf8,<s"
                    )
                )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_test", "T-R1 Vitals"
        ,"_pass",
            ABS ( [_opex_model] - [_opex_lines] ) < 0.000001
                && ABS ( [_fy_model] - [_fy_le] ) < 0.01
                && [_cards_rendered] = 10
    )

EVALUATE
// ---------------------------------------------------------------- T-R2 NR bridge constant-currency subtotal: comparison + steps at CC (step_sort < 80) = net revenue - FX; level rows CC_SUB / END carry no change (Bridge Step Delta = 0); every scenario, Compare A = Budget
VAR _rows =
    ADDCOLUMNS (
        _scenarios
        ,"_cc_level",
            VAR _entity      = [_entity]
            RETURN
                CALCULATE (
                    SUMX ( FILTER ( VALUES ( dim_bridge_step[step_code] ), CALCULATE ( MAX ( dim_bridge_step[step_sort] ) ) < 80 ), [_Bridge Value] )
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { [_month] }, param_period[month_number] )
                    ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                    ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                )
        ,"_nr_less_fx",
            CALCULATE (
                [Net Revenue] - [Bridge FX]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
            )
        ,"_level_rows_delta",
            CALCULATE (
                SUMX ( FILTER ( VALUES ( dim_bridge_step[step_code] ), dim_bridge_step[step_code] IN { "CC_SUB", "END" } ), ABS ( [Bridge Step Delta] ) )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
            )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_test", "T-R2 NR bridge CC subtotal"
        ,"_pass",
            ABS ( [_cc_level] - [_nr_less_fx] ) <= 0.01
                && [_level_rows_delta] = 0
    )

EVALUATE
// ---------------------------------------------------------------- T-R3 profit bridge reconciles: comparison Adj. EBITDA + volume + GM rate + GM mix + VSC + S&M + R&D + G&A + OOI + FX = Adj. EBITDA; + D&A + adjusting items = operating profit; every scenario with Compare A = Budget and with Compare A = Prior year
VAR _cmp = DATATABLE ( "_compare_a", STRING, { { "B" }, { "PY" } } )
VAR _rows =
    ADDCOLUMNS (
        CROSSJOIN ( _scenarios, _cmp )
        ,"_ebitda_steps",
            VAR _cmp_a       = [_compare_a]
            RETURN
                CALCULATE (
                    SUMX ( FILTER ( VALUES ( dim_profit_step[step_code] ), CALCULATE ( MAX ( dim_profit_step[step_sort] ) ) <= 100 ), [_Profit Step] )
                    ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { [_month] }, param_period[month_number] )
                    ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                    ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                    ,TREATAS ( { _cmp_a }, param_compare_a[choice_code] )
                )
        ,"_all_steps",
            VAR _cmp_a       = [_compare_a]
            RETURN
                CALCULATE (
                    SUMX ( VALUES ( dim_profit_step[step_code] ), [_Profit Step] )
                    ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { [_month] }, param_period[month_number] )
                    ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                    ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                    ,TREATAS ( { _cmp_a }, param_compare_a[choice_code] )
                )
        ,"_ebitda",
            CALCULATE (
                [Adjusted EBITDA]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
            )
        ,"_op",
            CALCULATE (
                [Operating Profit]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
            )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_test", "T-R3 profit bridge"
        ,"_pass",
            ( ISBLANK ( [_ebitda_steps] ) && ISBLANK ( [_ebitda] ) )
                || ( ABS ( [_ebitda_steps] - [_ebitda] ) <= 0.01 && ABS ( [_all_steps] - [_op] ) <= 0.01 )
    )

EVALUATE
// ---------------------------------------------------------------- T-R4 variances: Σ leaf Δ (accounts down to operating profit) = operating profit - comparison operating profit (the coverage footer total); Σ leaf FX = the translation part of the OP Δ; coverage of the Top 8 in [0, 1]; every scenario, Compare A = Budget
VAR _rows =
    ADDCOLUMNS (
        FILTER ( _scenarios, [_base] <> "B" )
        ,"_leaf_delta",
            CALCULATE (
                SUMX (
                    CALCULATETABLE ( VALUES ( dim_account[account_code] ), NOT ( dim_account[block_code] IN { "INV", "FIN", "TAX" } ) )
                    ,[Base Amount] - [Bridge Comparison Amount]
                )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
            )
        ,"_op_delta",
            CALCULATE (
                [Operating Profit]
                    - CALCULATE ( [Bridge Comparison Amount], REMOVEFILTERS ( dim_pl_row ), dim_pl_row[line_code] = "OP" )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
            )
        ,"_coverage",
            CALCULATE (
                [LV Coverage Value]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { [_base] }, param_base_version[choice_code] )
                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
            )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_test", "T-R4 variances footer total"
        ,"_pass",
            ABS ( [_leaf_delta] - [_op_delta] ) <= 0.01
                && [_coverage] >= 0
                && [_coverage] <= 1
    )

EVALUATE
// ---------------------------------------------------------------- T-R5 concentration shares sum to 100 % per profit level (net revenue, contribution, Adj. EBITDA by region); every actual scenario
VAR _rows =
    ADDCOLUMNS (
        CROSSJOIN ( FILTER ( _scenarios, [_base] = "A" ), VALUES ( dim_conc_level[level_code] ) )
        ,"_share_sum",
            CALCULATE (
                SUMX ( VALUES ( dim_region[region_name] ), [Conc Share] )
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_fiscal_year] }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { [_month] }, param_period[month_number] )
                ,TREATAS ( { [_time_view] }, param_time_view[time_view_code] )
                ,TREATAS ( { "A" }, param_base_version[choice_code] )
            )
    )
RETURN
    ADDCOLUMNS (
        _rows
        ,"_test", "T-R5 concentration shares"
        ,"_pass", ABS ( [_share_sum] - 1 ) < 0.000001
    )

