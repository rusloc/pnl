// ACME Unified P&L - Track B DAX tests (spec §10). Run in Power BI Desktop > DAX query view:
// open this file (or paste it), press Run. Each EVALUATE returns its own result tab.
// A test passes when every row shows _pass = TRUE. Tolerance: 0.01 USD (amounts are translated in floating point).
// Expected values: table control_totals_usd = data/acme_pl_dummy_data/checks/control_totals_usd.csv (USD,
// actual rates for ACT and forecast, budget rates for BUD). Spec IDs: T-01, T-02, T-03, T-05, T-06, T-07, T-10, T-17,
// L-07 (statement row labels), L-09 / F-21 (profitability coverage per company x breakdown), K-20 (Key figures tile body).
// T-04 (By nature lens) was dropped by ADR-0007; it never had a test here.
// K-24 (KPI trend) tests were removed with the measures KPI Trend and _KPI Trend Value on 2026-10-23 (USER: nothing uses them).
// ADR-0008 (2026-10-23): two blocks at the end pin the other rate paths (EUR / GBP at actual rates, constant currency in every
// currency) and the eliminations at account level against the pre-ADR-0008 formula, captured before the rewrite to
// pre-translated columns and fact_pl_elim.
// Views redesign v4 (2026-10-27, bip): T-R1 Vitals (Opex % NR from the statement lines, FY outlook = FY LE, every card renders), T-R2 NR bridge
// constant-currency subtotal, T-R3 profit bridge reconciles to Adj. EBITDA and operating profit, T-R4 variances leaf Δ sum = operating profit Δ
// and coverage in [0, 1], T-R5 concentration shares sum to 100 %.
// Parity check B vs C (2026-10-27, docs/ADD/features/parity-check-2026-10-27.md): T-P, 6 selections / 601 rows of
// js-report/lib/test-utils/parity/parity_selections.csv at the end of this file (about 6-7 min on a clean instance; run them last).

DEFINE
    // One scenario = the slicer state the report would have. Base: A = Actual, B = Budget, LE = Latest estimate.
    VAR _scenarios =
        DATATABLE (
            "_entity", STRING,
            "_version", STRING,
            "_window", STRING,
            "_fiscal_year", INTEGER,
            "_month", INTEGER,
            "_time_view", STRING,
            "_base", STRING,
            "_headline", BOOLEAN,
            {
                { "P", "ACT", "FY2025", 2025, 12, "FY", "A", TRUE },
                { "P", "ACT", "FY2026 YTD Sep", 2026, 9, "YTD", "A", TRUE },
                { "S", "ACT", "FY2025", 2025, 12, "FY", "A", TRUE },
                { "S", "ACT", "FY2026 YTD Sep", 2026, 9, "YTD", "A", TRUE },
                { "GROUP", "ACT", "FY2026 YTD Sep", 2026, 9, "YTD", "A", TRUE },
                { "GROUP", "LE", "FY2026 (actual Jan-Sep + forecast 9+3)", 2026, 12, "FY", "LE", TRUE },
                { "P", "BUD", "FY2026 YTD Sep", 2026, 9, "YTD", "B", FALSE },
                { "GROUP", "BUD", "FY2026", 2026, 12, "FY", "B", FALSE },
                { "GROUP", "ACT", "FY2024", 2024, 12, "FY", "A", FALSE }
            }
        )

    // T-06 full reconciliation: map every control_totals_usd window to a slicer state.
    VAR _control_rows =
        ADDCOLUMNS (
            control_totals_usd
            ,"_fiscal_year",
                SWITCH (
                    TRUE ()
                    ,LEFT ( control_totals_usd[window], 6 ) = "FY2024"
                        ,2024
                    ,LEFT ( control_totals_usd[window], 6 ) = "FY2025"
                        ,2025
                    ,2026
                )
            ,"_month", IF ( CONTAINSSTRING ( control_totals_usd[window], "YTD Sep" ), 9, 12 )
            ,"_time_view", IF ( CONTAINSSTRING ( control_totals_usd[window], "YTD Sep" ), "YTD", "FY" )
            ,"_base", SWITCH ( control_totals_usd[version], "ACT", "A", "BUD", "B", "LE" )
        )

EVALUATE
// ---------------------------------------------------------------- T-06 headline (README table, USD m)
VAR _lines =
    DATATABLE (
        "_line", STRING,
        {
            { "NR" },
            { "EBITDA" },
            { "OP" },
            { "NP" }
        }
    )
VAR _rows =
    ADDCOLUMNS (
        CROSSJOIN ( FILTER ( _scenarios, [_headline] ), _lines )
        ,"_model_usd",
            VAR _entity      = [_entity]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            VAR _line        = [_line]
            RETURN
                CALCULATE (
                    [Base Amount]
                    ,REMOVEFILTERS ( dim_pl_row )
                    ,TREATAS ( { _line }, dim_pl_row[line_code] )
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                )
        ,"_expected_usd",
            LOOKUPVALUE (
                control_totals_usd[amount_usd]
                ,control_totals_usd[entity_code], [_entity]
                ,control_totals_usd[version], [_version]
                ,control_totals_usd[window], [_window]
                ,control_totals_usd[line_code], [_line]
            )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "T-06 headline"
        ,"_entity", [_entity]
        ,"_version", [_version]
        ,"_window", [_window]
        ,"_line", [_line]
        ,"_model_m", ROUND ( [_model_usd] / 1e6, 1 )
        ,"_expected_m", ROUND ( [_expected_usd] / 1e6, 1 )
        ,"_diff_usd", [_model_usd] - [_expected_usd]
        ,"_pass", ABS ( [_model_usd] - [_expected_usd] ) < 0.01
    )
ORDER BY [_entity], [_window], [_line]

EVALUATE
// ---------------------------------------------------------------- T-06 full: all 552 control rows, summary
VAR _rows =
    ADDCOLUMNS (
        _control_rows
        ,"_model_usd",
            VAR _entity      = control_totals_usd[entity_code]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            VAR _line        = control_totals_usd[line_code]
            RETURN
                CALCULATE (
                    [Base Amount]
                    ,REMOVEFILTERS ( control_totals_usd )
                    ,REMOVEFILTERS ( dim_pl_row )
                    ,TREATAS ( { _line }, dim_pl_row[line_code] )
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                )
    )
VAR _checked =
    ADDCOLUMNS ( _rows, "_abs_diff", ABS ( [_model_usd] - control_totals_usd[amount_usd] ) )
RETURN
    ROW (
        "_test", "T-06 full reconciliation"
        ,"_rows_checked", COUNTROWS ( _checked )
        ,"_rows_failed", COUNTROWS ( FILTER ( _checked, [_abs_diff] >= 0.01 ) ) + 0
        ,"_max_abs_diff_usd", MAXX ( _checked, [_abs_diff] )
        ,"_pass", COUNTROWS ( FILTER ( _checked, [_abs_diff] >= 0.01 ) ) + 0 = 0
    )

EVALUATE
// ---------------------------------------------------------------- T-01 / T-02 Group = CP + CC + eliminations (ACT FY2026 YTD Sep)
VAR _lines =
    DATATABLE (
        "_line", STRING,
        {
            { "GR" },
            { "NR" },
            { "VSC" },
            { "CM" },
            { "EBITDA" },
            { "OP" },
            { "NP" }
        }
    )
RETURN
    ADDCOLUMNS (
        _lines
        ,"_test", "T-01/T-02"
        ,"_group",
            VAR _line = [_line]
            RETURN
                CALCULATE (
                    [Base Amount]
                    ,REMOVEFILTERS ( dim_pl_row )
                    ,TREATAS ( { _line }, dim_pl_row[line_code] )
                    ,TREATAS ( { "GROUP" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                )
        ,"_cp_plus_cc",
            VAR _line = [_line]
            RETURN
                SUMX (
                    { "P", "S" }
                    ,CALCULATE (
                        [Base Amount]
                        ,REMOVEFILTERS ( dim_pl_row )
                        ,TREATAS ( { _line }, dim_pl_row[line_code] )
                        ,TREATAS ( { [Value] }, param_entity_view[entity_view_code] )
                        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                        ,TREATAS ( { 9 }, param_period[month_number] )
                        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    )
                )
        ,"_ic_eliminated",
            CALCULATE (
                [KPI IC Eliminated]
                ,TREATAS ( { "GROUP" }, param_entity_view[entity_view_code] )
                ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                ,TREATAS ( { 9 }, param_period[month_number] )
                ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
            )
    )

EVALUATE
// ---------------------------------------------------------------- T-03 slices add up (CP ACT FY2026 YTD Sep, allocated lines included)
VAR _lines =
    DATATABLE (
        "_line", STRING,
        {
            { "NR" },
            { "CM" },
            { "EBITDA" },
            { "NP" }
        }
    )
RETURN
    ADDCOLUMNS (
        _lines
        ,"_test", "T-03"
        ,"_total",
            VAR _line = [_line]
            RETURN
                CALCULATE (
                    [Base Amount]
                    ,REMOVEFILTERS ( dim_pl_row )
                    ,TREATAS ( { _line }, dim_pl_row[line_code] )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                )
        ,"_sum_by_channel",
            VAR _line = [_line]
            RETURN
                SUMX (
                    CALCULATETABLE ( VALUES ( dim_channel[channel_code] ), dim_channel[entity_code] = "P" )
                    ,CALCULATE (
                        [Base Amount]
                        ,REMOVEFILTERS ( dim_pl_row )
                        ,TREATAS ( { _line }, dim_pl_row[line_code] )
                        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    )
                )
        ,"_sum_by_segment",
            VAR _line = [_line]
            RETURN
                SUMX (
                    CALCULATETABLE ( VALUES ( dim_segment[segment_code] ), dim_segment[entity_code] = "P" )
                    ,CALCULATE (
                        [Base Amount]
                        ,REMOVEFILTERS ( dim_pl_row )
                        ,TREATAS ( { _line }, dim_pl_row[line_code] )
                        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    )
                )
    )

EVALUATE
// ---------------------------------------------------------------- T-05 bridge: comparison NR + steps = base NR for every entity, test window and comparison; T-10 FX step = 0 at constant currency
VAR _windows =
    DISTINCT (
        SELECTCOLUMNS (
            _scenarios
            ,"_fiscal_year", [_fiscal_year]
            ,"_month", [_month]
            ,"_time_view", [_time_view]
            ,"_base", [_base]
        )
    )
VAR _cases =
    CROSSJOIN (
        _windows
        ,SELECTCOLUMNS ( param_entity_view, "_entity", param_entity_view[entity_view_code] )
        ,DATATABLE (
            "_compare", STRING,
            {
                { "B" },
                { "PY" },
                { "LE" }
            }
        )
    )
VAR _rows =
    ADDCOLUMNS (
        _cases
        ,"_end_nr",
            VAR _entity      = [_entity]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            VAR _compare     = [_compare]
            RETURN
                CALCULATE (
                    [Net Revenue]
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { _compare }, param_compare_a[choice_code] )
                )
        ,"_start_plus_steps",
            VAR _entity      = [_entity]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            VAR _compare     = [_compare]
            RETURN
                CALCULATE (
                    SUMX ( dim_bridge_step, [_Bridge Value] )
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { _compare }, param_compare_a[choice_code] )
                )
        ,"_fx_step_constant_currency",
            VAR _entity      = [_entity]
            VAR _fiscal_year = [_fiscal_year]
            VAR _month       = [_month]
            VAR _time_view   = [_time_view]
            VAR _base        = [_base]
            VAR _compare     = [_compare]
            RETURN
                CALCULATE (
                    [Bridge FX]
                    ,TREATAS ( { _entity }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { _fiscal_year }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { _month }, param_period[month_number] )
                    ,TREATAS ( { _time_view }, param_time_view[time_view_code] )
                    ,TREATAS ( { _base }, param_base_version[choice_code] )
                    ,TREATAS ( { _compare }, param_compare_a[choice_code] )
                    ,TREATAS ( { "CC" }, param_fx_basis[fx_basis_code] )
                )
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "T-05/T-10"
        ,"_entity", [_entity]
        ,"_fiscal_year", [_fiscal_year]
        ,"_month", [_month]
        ,"_time_view", [_time_view]
        ,"_base", [_base]
        ,"_compare_a", [_compare]
        ,"_end_nr_m", ROUND ( [_end_nr] / 1e6, 1 )
        ,"_diff_usd", [_start_plus_steps] - [_end_nr]
        ,"_fx_step_cc_usd", [_fx_step_constant_currency]
        ,"_pass",
            ABS ( [_start_plus_steps] - [_end_nr] ) < 0.01
                && ABS ( [_fx_step_constant_currency] ) < 0.01
    )
ORDER BY [_entity], [_fiscal_year], [_time_view], [_base], [_compare_a]

EVALUATE
// ---------------------------------------------------------------- T-17 period-end KPIs read the last month, not a sum (CC, FY2026)
ROW (
    "_test", "T-17"
    ,"_merchants_ytd_sep",
        CALCULATE (
            [KPI Active Merchants]
            ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
            ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        )
    ,"_merchants_month_sep",
        CALCULATE (
            [KPI Active Merchants]
            ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
            ,TREATAS ( { "MTD" }, param_time_view[time_view_code] )
        )
    ,"_arr_ytd_sep",
        CALCULATE (
            [KPI ARR]
            ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
            ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        )
    ,"_arr_month_sep",
        CALCULATE (
            [KPI ARR]
            ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
            ,TREATAS ( { "MTD" }, param_time_view[time_view_code] )
        )
)

EVALUATE
// ---------------------------------------------------------------- T-07 account attributes complete; nature weights sum to 1
FILTER (
    ADDCOLUMNS (
        dim_account
        ,"_weight_sum", CALCULATE ( SUM ( bridge_account_nature[weight] ) )
        ,"_has_attributes",
            NOT ISBLANK ( dim_account[block_code] )
                && NOT ISBLANK ( dim_account[spine_step] )
                && NOT ISBLANK ( dim_account[ifrs18_category] )
    )
    ,NOT [_has_attributes]
        || ( NOT ISBLANK ( [_weight_sum] ) && [_weight_sum] <> 1 )
        || ( ISBLANK ( [_weight_sum] ) && dim_account[block_code] IN { "COR", "VSC", "SM", "RD", "GA", "OOI" } )
)
// T-07 passes when this result is empty.

EVALUATE
// ---------------------------------------------------------------- L-07 statement row labels (dim_pl_row[line_display], the matrix's top level): every line numbered 01..NN in display order, ratio rows included, name in capitals; leaf rows carry their line's label
VAR _lines        =
    ADDCOLUMNS (
        FILTER ( dim_pl_row, NOT dim_pl_row[is_leaf] )
        ,"_expected",
            FORMAT ( RANKX ( FILTER ( dim_pl_row, NOT dim_pl_row[is_leaf] ), dim_pl_row[line_sort], , ASC, DENSE ), "00" )
                & ". "
                & UPPER ( dim_pl_row[line_label] )
    )
VAR _wrong_lines  = COUNTROWS ( FILTER ( _lines, dim_pl_row[line_display] <> [_expected] ) )
VAR _wrong_leaves =
    COUNTROWS (
        FILTER (
            dim_pl_row
            ,dim_pl_row[is_leaf]
                && dim_pl_row[line_display]
                    <> LOOKUPVALUE (
                        dim_pl_row[line_display]
                        ,dim_pl_row[line_code], dim_pl_row[line_code]
                        ,dim_pl_row[is_leaf], FALSE ()
                    )
        )
    )
VAR _n_lines      = COUNTROWS ( _lines )
VAR _n_labels     = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _lines, "_l", dim_pl_row[line_display] ) ) )
RETURN
    ROW (
        "_test", "L-07 labels"
        ,"_lines", _n_lines
        ,"_report_lines", COUNTROWS ( dim_report_line )
        ,"_first", MINX ( FILTER ( _lines, dim_pl_row[line_sort] = MINX ( _lines, dim_pl_row[line_sort] ) ), dim_pl_row[line_display] )
        ,"_last", MINX ( FILTER ( _lines, dim_pl_row[line_sort] = MAXX ( _lines, dim_pl_row[line_sort] ) ), dim_pl_row[line_display] )
        ,"_wrong_lines", _wrong_lines + 0
        ,"_wrong_leaves", _wrong_leaves + 0
        ,"_pass", _n_lines = COUNTROWS ( dim_report_line ) && _n_labels = _n_lines && _wrong_lines + 0 = 0 && _wrong_leaves + 0 = 0
    )

EVALUATE
// ---------------------------------------------------------------- L-09 / F-21 profitability coverage, every company x breakdown (default selection): an allowed breakdown shows rows and no hint; one that is not allowed shows no rows and says why (_Breakdown Hint); Region, the saved breakdown, is allowed for every company. Catches the blank Profitability view of 2026-10-22 (ACME Group with Channel kept from another company: no rows, no explanation).
VAR _cells        =
    UNION (
        SELECTCOLUMNS (
            SUMMARIZECOLUMNS ( param_entity_view[entity_view_code], dim_region[region_name], TREATAS ( { 0 }, param_breakdown_field[Breakdown Order] ), "_in", [Slice Member In View], "_nr", [Prof Net Revenue] )
            ,"_entity", param_entity_view[entity_view_code], "_order", 0, "_in", [_in], "_nr", [_nr]
        )
        ,SELECTCOLUMNS (
            SUMMARIZECOLUMNS ( param_entity_view[entity_view_code], dim_channel[channel_name], TREATAS ( { 1 }, param_breakdown_field[Breakdown Order] ), "_in", [Slice Member In View], "_nr", [Prof Net Revenue] )
            ,"_entity", param_entity_view[entity_view_code], "_order", 1, "_in", [_in], "_nr", [_nr]
        )
        ,SELECTCOLUMNS (
            SUMMARIZECOLUMNS ( param_entity_view[entity_view_code], dim_line[line_name], TREATAS ( { 2 }, param_breakdown_field[Breakdown Order] ), "_in", [Slice Member In View], "_nr", [Prof Net Revenue] )
            ,"_entity", param_entity_view[entity_view_code], "_order", 2, "_in", [_in], "_nr", [_nr]
        )
        ,SELECTCOLUMNS (
            SUMMARIZECOLUMNS ( param_entity_view[entity_view_code], dim_segment[segment_name], TREATAS ( { 3 }, param_breakdown_field[Breakdown Order] ), "_in", [Slice Member In View], "_nr", [Prof Net Revenue] )
            ,"_entity", param_entity_view[entity_view_code], "_order", 3, "_in", [_in], "_nr", [_nr]
        )
        ,SELECTCOLUMNS (
            SUMMARIZECOLUMNS ( param_entity_view[entity_view_code], dim_entity[short_name], TREATAS ( { 4 }, param_breakdown_field[Breakdown Order] ), "_in", [Slice Member In View], "_nr", [Prof Net Revenue] )
            ,"_entity", param_entity_view[entity_view_code], "_order", 4, "_in", [_in], "_nr", [_nr]
        )
    )
VAR _grid         =
    CROSSJOIN (
        SELECTCOLUMNS ( VALUES ( param_entity_view[entity_view_code] ), "_entity", param_entity_view[entity_view_code] )
        ,SELECTCOLUMNS ( GENERATESERIES ( 0, 4 ), "_order", [Value] )
    )
VAR _checked      =
    ADDCOLUMNS (
        _grid
        ,"_allowed",
            CALCULATE (
                [Breakdown Allowed]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_order] }, param_breakdown_field[Breakdown Order] )
            )
        ,"_hint",
            CALCULATE (
                [_Breakdown Hint]
                ,TREATAS ( { [_entity] }, param_entity_view[entity_view_code] )
                ,TREATAS ( { [_order] }, param_breakdown_field[Breakdown Order] )
            )
        ,"_rows_in_view",
            VAR _e            = [_entity]
            VAR _o            = [_order]
            RETURN
                COUNTROWS ( FILTER ( _cells, [_entity] = _e && [_order] = _o && [_in] = 1 && NOT ISBLANK ( [_nr] ) ) ) + 0
    )
RETURN
    ADDCOLUMNS (
        _checked
        ,"_pass",
            ( [_allowed] = 1 && [_rows_in_view] > 0 && LEN ( [_hint] ) = 0 )
                || ( ISBLANK ( [_allowed] ) && [_rows_in_view] = 0 && LEN ( [_hint] ) > 0 && [_order] <> 0 )
    )
ORDER BY [_entity], [_order]

EVALUATE
// ---------------------------------------------------------------- K-20 / kpi-card-v2 tile body: the Δ text in KPI Tile SVG equals KPI Δ A / KPI Δ B (rounded as shown), n/a without data, no comparison rows on growth KPIs; every KPI of every company (default selection: last closed FY and month, YTD, Actual vs Budget / Prior year)
VAR _tiles        =
    SUMMARIZECOLUMNS (
        param_entity_view[entity_view_code]
        ,dim_kpi[kpi_code]
        ,dim_kpi[value_type]
        ,"_svg", [KPI Tile SVG]
        ,"_d_a", [KPI Δ A]
        ,"_d_b", [KPI Δ B]
    )
RETURN
    SELECTCOLUMNS (
        ADDCOLUMNS (
            _tiles
            ,"_ok",
                VAR _svg          = [_svg]
                VAR _pp           = dim_kpi[value_type] IN { "PCT", "PCT2" }
                VAR _growth       = dim_kpi[kpi_code] IN { "ORG_GROWTH", "VOL_GROWTH", "PRICE_MIX" }
                VAR _text_a       =
                    VAR _r            = ROUND ( [_d_a], IF ( _pp, 1, 3 ) )
                    RETURN
                        IF (
                            ISBLANK ( [_d_a] )
                            ,"n/a"
                            ,IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _r ), IF ( _pp, "0.0", "0.0%" ) ) & IF ( _pp, " pp", "" )
                        )
                VAR _text_b       =
                    VAR _r            = ROUND ( [_d_b], IF ( _pp, 1, 3 ) )
                    RETURN
                        IF (
                            ISBLANK ( [_d_b] )
                            ,"n/a"
                            ,IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "" ) ) & FORMAT ( ABS ( _r ), IF ( _pp, "0.0", "0.0%" ) ) & IF ( _pp, " pp", "" )
                        )
                RETURN
                    IF (
                        _growth
                        ,NOT CONTAINSSTRING ( _svg, "vs " )
                        ,CONTAINSSTRING ( _svg, ">" & SUBSTITUTE ( _text_a, "%", "%25" ) & "<" )
                            && CONTAINSSTRING ( _svg, ">" & SUBSTITUTE ( _text_b, "%", "%25" ) & "<" )
                            && CONTAINSSTRING ( _svg, ">vs Budget<" )
                            && CONTAINSSTRING ( _svg, ">vs Prior year<" )
                    )
        )
        ,"_test", "K-20 tile"
        ,"_entity", param_entity_view[entity_view_code]
        ,"_kpi", dim_kpi[kpi_code]
        ,"_d_a", [_d_a]
        ,"_d_b", [_d_b]
        ,"_pass", [_ok]
    )
ORDER BY [_entity], [_kpi]

EVALUATE
