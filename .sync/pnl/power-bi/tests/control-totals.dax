        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
        ,TREATAS ( { "B" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
RETURN
    ADDCOLUMNS (
        _actual
        ,"_test", "T-P S-FY25-cmpPY"
        ,"_pass",
            SWITCH (
                TRUE ()
                ,LEFT ( [b_status], 9 ) = "accepted:"
                    ,TRUE ()
                ,[kind] IN { "amount", "ratio", "count" }
                ,ABS ( VALUE ( [actual] ) - VALUE ( [expected] ) ) <= [tol]
                ,[actual] = [expected]
            )
    )

// T-P S-FY25-noB: S FY2025 month 12 FY, Compare A B, Compare B NONE, USD ACT (11 rows)
EVALUATE
