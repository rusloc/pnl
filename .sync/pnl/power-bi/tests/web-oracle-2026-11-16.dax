            { "P-RNG-2510-2609 vitals.ap.status", "vitals.ap.status", "AP_PCT", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "P-RNG-2510-2609 vitals.ap.rows", "vitals.ap.rows", "AP_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-RNG-2510-2609 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$4,908.1 m", 0.0 },
            { "P-RNG-2510-2609 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-RNG-2510-2609 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "P-RNG-2510-2609 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 4834347770.5823, "", 0.05 },
            { "P-RNG-2510-2609 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 950680212.0248, "", 0.05 },
            { "P-RNG-2510-2609 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 751118772.8448, "", 0.05 },
            { "P-RNG-2510-2609 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.489924386, "", 1e-06 },
            { "P-RNG-2510-2609 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.193575155, "", 1e-06 },
            { "P-RNG-2510-2609 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", -0.009903773, "", 1e-06 },
            { "P-RNG-2510-2609 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.002960471, "", 1e-06 },
            { "P-RNG-2510-2609 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.06069622, "", 1e-06 },
            { "P-RNG-2510-2609 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 4908087890.1284, "", 0.05 },
            { "P-RNG-2510-2609 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 0.975921168, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 21 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

