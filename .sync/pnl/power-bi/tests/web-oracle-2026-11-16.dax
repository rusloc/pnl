VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    CALCULATE (
                        SWITCH ( _k1, "growth", [Trend Growth], "cm", [Trend CM %] )
                        ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                        ,TREATAS ( { IF ( _k1 IN { "growth", "cm" }, VALUE ( _k3 ), -99 ) }, dim_month[month_index] )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"months"
                            ,CONCATENATEX (
                                FILTER (
                                    ALL ( dim_month[month_index], dim_month[month_name], dim_month[fiscal_year] )
                                    ,NOT ISBLANK ( CALCULATE ( [Trend CM %], TREATAS ( { "TOTAL" }, dim_trend_row[trend_row_code] ) ) )
                                )
                                ,dim_month[month_name] & " " & dim_month[fiscal_year]
                                ," | "
                                ,dim_month[month_index], ASC
                            )
                        ,"note", COALESCE ( [Trend Note], "none" )
                        ,"last"
                            ,CALCULATE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS (
                                            ALL ( dim_month[month_index] )
                                            ,"@v", IF ( _k3 = "growth_last", [Trend Growth Last], [Trend CM % Last] )
                                        )
                                        ,NOT ISBLANK ( [@v] )
                                    )
                                    ,IF ( _k3 = "growth_last", IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "+0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "0.0%;−0.0%;0.0%" ) ) ) )
                                    ," / "
                                )
                                ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                            )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 30 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

