            { "S-RNG-2603-2609 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.555611652, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.38002246, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", -0.012102936, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.000328894, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.273137839, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 860955932.1889, "", 0.05 },
            { "S-RNG-2603-2609 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 0.987644418, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.mix.sub_share", "vitals.mix.sub_share", "MIX", "sub_share", "", "ratio", 0.369949452, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.mix.pay_share", "vitals.mix.pay_share", "MIX", "pay_share", "", "ratio", 0.509725074, "", 1e-06 },
            { "S-RNG-2603-2609 vitals.gmv.value", "vitals.gmv.value", "GMV", "value", "", "amount", 9188096824.2729, "", 0.05 },
            { "S-RNG-2603-2609 vitals.merchants.value", "vitals.merchants.value", "MERCHANTS", "value", "", "count", 138726.0, "", 0.0 },
            { "S-RNG-2603-2609 vitals.arr.value", "vitals.arr.value", "ARR", "value", "", "amount", 320001855.6507, "", 0.05 },
            { "S-RNG-2603-2609 vitals.merchants.gmv_per_merchant_text", "vitals.merchants.gmv_per_merchant_text", "MERCHANTS", "gmv_per_merchant_text", "", "text", BLANK (), "$66.2 k", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 26 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

