            { "S-FY25-noB nr_bridge.SVC_PS.value", "nr_bridge.SVC_PS.value", "nr_bridge", "SVC_PS", "value", "amount", -1890902.4697, "", 0.05 },
            { "S-FY25-noB nr_bridge.SVC_PS.label", "nr_bridge.SVC_PS.label", "nr_bridge", "SVC_PS", "label", "text", BLANK (), "Professional services", 0.0 },
            { "S-FY25-noB nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 655627990.7605, "", 0.05 },
            { "S-FY25-noB nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "S-FY25-noB nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 11732700.0828, "", 0.05 },
            { "S-FY25-noB nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "S-FY25-noB nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25-noB nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "S-FY25-noB profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 82872108.2449, "", 0.05 },
            { "S-FY25-noB profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -1453808.9691, "", 0.05 },
            { "S-FY25-noB profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -25843.1097, "", 0.05 },
            { "S-FY25-noB profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", -1364064.8176, "", 0.05 },
            { "S-FY25-noB profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 211393.0562, "", 0.05 },
            { "S-FY25-noB profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 453003.7032, "", 0.05 },
            { "S-FY25-noB profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 478005.5392, "", 0.05 },
            { "S-FY25-noB profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 247244.5898, "", 0.05 },
            { "S-FY25-noB profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -81009.0746, "", 0.05 },
            { "S-FY25-noB profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 1490343.0467, "", 0.05 },
            { "S-FY25-noB profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 82827372.209, "", 0.05 },
            { "S-FY25-noB profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -31069557.5935, "", 0.05 },
            { "S-FY25-noB profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -3177743.146, "", 0.05 },
            { "S-FY25-noB profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 48580071.4695, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "NONE" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

