// Web oracle parity, P&L (Track B) vs the vosk.dev engine as of 2026-11-16 (hunter: js-report/lib/test-utils/parity/
// parity_selections_2026-11-16.csv, 4,514 rows, 21 selections). Generated by bip (tools/oracle-2026-11-16/gen_oracle.py);
// do not edit by hand. One block per selection x view; every row returns _pass = TRUE. Texts are compared exactly, the
// way the visuals render them (units M, U+2212 minus, no sign on a value that rounds to zero); amounts 0.01 / 0.05,
// ratios 1e-6. Rows the Power BI report cannot or does not show are accepted differences in docs/design/parity-rules.md
// (section "P&L web oracle 2026-11-16"), listed in the last block as a count.
// Run one EVALUATE at a time in DAX query view (or tools/oracle-2026-11-16/split_run.py).

EVALUATE
// ---------------------------------------------------------------- O-S-FY25 header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25 ct.NR", "ct.NR", "NR", "", "", "amount", 667360690.8433, "", 0.01 },
            { "S-FY25 ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 82827372.209, "", 0.01 },
            { "S-FY25 ct.OP", "ct.OP", "OP", "", "", "amount", 48580071.4695, "", 0.01 },
            { "S-FY25 ct.NP", "ct.NP", "NP", "", "", "amount", 38144183.9088, "", 0.01 },
            { "S-FY25 hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "Full year 2025", 0.0 },
            { "S-FY25 hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2025", 0.0 },
            { "S-FY25 hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Dec 2025 - full year", 0.0 },
            { "S-FY25 hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Full year", 0.0 },
            { "S-FY25 hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A) and Prior year (B)", 0.0 },
            { "S-FY25 hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25 Vitals (46 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25 vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$667.4 m", 0.0 },
            { "S-FY25 vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25 vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$82.8 m", 0.0 },
            { "S-FY25 vitals.ebitda.status", "vitals.ebitda.status", "EBITDA", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25 vitals.ebitda.rows", "vitals.ebitda.rows", "EBITDA", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.op.value_text", "vitals.op.value_text", "OP", "value_text", "", "text", BLANK (), "$48.6 m", 0.0 },
            { "S-FY25 vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-FY25 vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.gm.value_text", "vitals.gm.value_text", "GM_PCT", "value_text", "", "text", BLANK (), "55.9%", 0.0 },
            { "S-FY25 vitals.gm.status", "vitals.gm.status", "GM_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25 vitals.gm.rows", "vitals.gm.rows", "GM_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.opex.value_text", "vitals.opex.value_text", "OPEX_PCT", "value_text", "", "text", BLANK (), "38.9%", 0.0 },
            { "S-FY25 vitals.opex.status", "vitals.opex.status", "OPEX_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25 vitals.opex.rows", "vitals.opex.rows", "OPEX_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.gmv.value_text", "vitals.gmv.value_text", "GMV", "value_text", "", "text", BLANK (), "$12,470.9 m", 0.0 },
            { "S-FY25 vitals.gmv.status", "vitals.gmv.status", "GMV", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25 vitals.gmv.rows", "vitals.gmv.rows", "GMV", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.merchants.value_text", "vitals.merchants.value_text", "MERCHANTS", "value_text", "", "text", BLANK (), "124,291", 0.0 },
            { "S-FY25 vitals.merchants.status", "vitals.merchants.status", "MERCHANTS", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-FY25 vitals.merchants.rows", "vitals.merchants.rows", "MERCHANTS", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.arr.value_text", "vitals.arr.value_text", "ARR", "value_text", "", "text", BLANK (), "$279.2 m", 0.0 },
            { "S-FY25 vitals.arr.status", "vitals.arr.status", "ARR", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25 vitals.arr.rows", "vitals.arr.rows", "ARR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-FY25 vitals.mix.value_text", "vitals.mix.value_text", "MIX", "value_text", "", "text", BLANK (), "37.1% / 49.9%", 0.0 },
            { "S-FY25 vitals.mix.status", "vitals.mix.status", "MIX", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "S-FY25 vitals.mix.rows", "vitals.mix.rows", "MIX", "rows", "", "text", BLANK (), "Sub / Pay vs PY", 0.0 },
            { "S-FY25 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$667.4 m", 0.0 },
            { "S-FY25 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "S-FY25 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 82827372.209, "", 0.05 },
            { "S-FY25 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 48580071.4695, "", 0.05 },
            { "S-FY25 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.558516421, "", 1e-06 },
            { "S-FY25 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.389467893, "", 1e-06 },
            { "S-FY25 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", 0.013885387, "", 1e-06 },
            { "S-FY25 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.000313636, "", 1e-06 },
            { "S-FY25 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.278333002, "", 1e-06 },
            { "S-FY25 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 1.013885387, "", 1e-06 },
            { "S-FY25 vitals.mix.sub_share", "vitals.mix.sub_share", "MIX", "sub_share", "", "ratio", 0.3705199, "", 1e-06 },
            { "S-FY25 vitals.mix.pay_share", "vitals.mix.pay_share", "MIX", "pay_share", "", "ratio", 0.499309507, "", 1e-06 },
            { "S-FY25 vitals.gmv.value", "vitals.gmv.value", "GMV", "value", "", "amount", 12470944535.3555, "", 0.05 },
            { "S-FY25 vitals.merchants.value", "vitals.merchants.value", "MERCHANTS", "value", "", "count", 124291.0, "", 0.0 },
            { "S-FY25 vitals.arr.value", "vitals.arr.value", "ARR", "value", "", "amount", 279201235.6196, "", 0.05 },
            { "S-FY25 vitals.merchants.gmv_per_merchant_text", "vitals.merchants.gmv_per_merchant_text", "MERCHANTS", "gmv_per_merchant_text", "", "text", BLANK (), "$100.3 k", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25 bridges (30 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 658221037.2736, "", 0.05 },
            { "S-FY25 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "S-FY25 nr_bridge.SVC_SUB.value", "nr_bridge.SVC_SUB.value", "nr_bridge", "SVC_SUB", "value", "amount", -4647223.1596, "", 0.05 },
            { "S-FY25 nr_bridge.SVC_SUB.label", "nr_bridge.SVC_SUB.label", "nr_bridge", "SVC_SUB", "label", "text", BLANK (), "Platform subscriptions", 0.0 },
            { "S-FY25 nr_bridge.SVC_PAY.value", "nr_bridge.SVC_PAY.value", "nr_bridge", "SVC_PAY", "value", "amount", 4822029.0084, "", 0.05 },
            { "S-FY25 nr_bridge.SVC_PAY.label", "nr_bridge.SVC_PAY.label", "nr_bridge", "SVC_PAY", "label", "text", BLANK (), "Payments", 0.0 },
            { "S-FY25 nr_bridge.SVC_APP.value", "nr_bridge.SVC_APP.value", "nr_bridge", "SVC_APP", "value", "amount", -876949.8922, "", 0.05 },
            { "S-FY25 nr_bridge.SVC_APP.label", "nr_bridge.SVC_APP.label", "nr_bridge", "SVC_APP", "label", "text", BLANK (), "Apps, partners & ads", 0.0 },
            { "S-FY25 nr_bridge.SVC_PS.value", "nr_bridge.SVC_PS.value", "nr_bridge", "SVC_PS", "value", "amount", -1890902.4697, "", 0.05 },
            { "S-FY25 nr_bridge.SVC_PS.label", "nr_bridge.SVC_PS.label", "nr_bridge", "SVC_PS", "label", "text", BLANK (), "Professional services", 0.0 },
            { "S-FY25 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 655627990.7605, "", 0.05 },
            { "S-FY25 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "S-FY25 nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 11732700.0828, "", 0.05 },
            { "S-FY25 nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "S-FY25 nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25 nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "S-FY25 profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 82872108.2449, "", 0.05 },
            { "S-FY25 profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -1453808.9691, "", 0.05 },
            { "S-FY25 profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -25843.1097, "", 0.05 },
            { "S-FY25 profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", -1364064.8176, "", 0.05 },
            { "S-FY25 profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 211393.0562, "", 0.05 },
            { "S-FY25 profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 453003.7032, "", 0.05 },
            { "S-FY25 profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 478005.5392, "", 0.05 },
            { "S-FY25 profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 247244.5898, "", 0.05 },
            { "S-FY25 profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -81009.0746, "", 0.05 },
            { "S-FY25 profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 1490343.0467, "", 0.05 },
            { "S-FY25 profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 82827372.209, "", 0.05 },
            { "S-FY25 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -31069557.5935, "", 0.05 },
            { "S-FY25 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -3177743.146, "", 0.05 },
            { "S-FY25 profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 48580071.4695, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25 largest variances (filter none) (14 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25 var.total_delta", "var.total_delta", "total_delta", "", "", "amount", -1569730.0423, "", 0.05 },
            { "S-FY25 var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 32.0, "", 0.0 },
            { "S-FY25 var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_S2 COR_S2 GR_S4 RD_S1 ADJ_3 COR_S5 SM_S1 GR_S1", 0.0 },
            { "S-FY25 var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_3 OOI_1 OOI_3", 0.0 },
            { "S-FY25 var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "vs PY", 0.0 },
            { "S-FY25 var.total_fx", "var.total_fx", "total_fx", "", "", "amount", 850229.3593, "", 0.05 },
            { "S-FY25 var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "none", 0.0 },
            { "S-FY25 var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_S2 COR_S2 GR_S4 RD_S1 ADJ_3 COR_S5 SM_S1 GR_S1 RD_S2 SM_S3 GA_1 RD_S3 VSC_S3 DA_S1 SM_S2 GA_2 COR_S4 GA_4 GA_3 DA_S2 SM_S4 DA_S3 VSC_S2 OOI_1 COR_S3 GTN_S3 COR_S1 GR_S3 GTN_S2 VSC_S1 GTN_S1 OOI_3", 0.0 },
            { "S-FY25 var.footer.comparison", "var.footer.comparison", "footer", "comparison", "", "text", BLANK (), "$50.1 m", 0.0 },
            { "S-FY25 var.footer.actual", "var.footer.actual", "footer", "actual", "", "text", BLANK (), "$48.6 m", 0.0 },
            { "S-FY25 var.footer.delta", "var.footer.delta", "footer", "delta", "", "text", BLANK (), "−$1.6 m", 0.0 },
            { "S-FY25 var.footer.delta_pct", "var.footer.delta_pct", "footer", "delta_pct", "", "text", BLANK (), "−3.1%", 0.0 },
            { "S-FY25 var.footer.py", "var.footer.py", "footer", "py", "", "text", BLANK (), "+$14.2 m", 0.0 },
            { "S-FY25 var.footer.fx", "var.footer.fx", "footer", "fx", "", "text", BLANK (), "+$0.9 m", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

