            { "S-RNG-2603-2609 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -23950415.8704, "", 0.05 },
            { "S-RNG-2603-2609 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -733902.3994, "", 0.05 },
