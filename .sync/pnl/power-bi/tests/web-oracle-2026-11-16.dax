            { "S-FY25-cmpPY prof.EU.gm_pct", "prof.EU.gm_pct", "prof", "EU", "gm_pct", "ratio", 0.565123241, "", 1e-06 },
            { "S-FY25-cmpPY prof.EU.cm_pct", "prof.EU.cm_pct", "prof", "EU", "cm_pct", "ratio", 0.519623638, "", 1e-06 },
            { "S-FY25-cmpPY prof.EU.cm_delta_pp", "prof.EU.cm_delta_pp", "prof", "EU", "cm_delta_pp", "ratio", -0.003010605, "", 1e-06 },
            { "S-FY25-cmpPY prof.EU.ebitda", "prof.EU.ebitda", "prof", "EU", "ebitda", "amount", 19667876.7204, "", 0.05 },
            { "S-FY25-cmpPY prof.UK.nr", "prof.UK.nr", "prof", "UK", "nr", "amount", 66586164.8861, "", 0.05 },
            { "S-FY25-cmpPY prof.UK.nr_delta_pct", "prof.UK.nr_delta_pct", "prof", "UK", "nr_delta_pct", "ratio", 0.273797495, "", 1e-06 },
            { "S-FY25-cmpPY prof.UK.gm_pct", "prof.UK.gm_pct", "prof", "UK", "gm_pct", "ratio", 0.561533812, "", 1e-06 },
            { "S-FY25-cmpPY prof.UK.cm_pct", "prof.UK.cm_pct", "prof", "UK", "cm_pct", "ratio", 0.516114293, "", 1e-06 },
            { "S-FY25-cmpPY prof.UK.cm_delta_pp", "prof.UK.cm_delta_pp", "prof", "UK", "cm_delta_pp", "ratio", -0.006966963, "", 1e-06 },
            { "S-FY25-cmpPY prof.UK.ebitda", "prof.UK.ebitda", "prof", "UK", "ebitda", "amount", 8682563.0506, "", 0.05 },
            { "S-FY25-cmpPY prof.AP.nr", "prof.AP.nr", "prof", "AP", "nr", "amount", 85021585.3097, "", 0.05 },
            { "S-FY25-cmpPY prof.AP.nr_delta_pct", "prof.AP.nr_delta_pct", "prof", "AP", "nr_delta_pct", "ratio", 0.289909841, "", 1e-06 },
            { "S-FY25-cmpPY prof.AP.gm_pct", "prof.AP.gm_pct", "prof", "AP", "gm_pct", "ratio", 0.560290389, "", 1e-06 },
            { "S-FY25-cmpPY prof.AP.cm_pct", "prof.AP.cm_pct", "prof", "AP", "cm_pct", "ratio", 0.514701042, "", 1e-06 },
            { "S-FY25-cmpPY prof.AP.cm_delta_pp", "prof.AP.cm_delta_pp", "prof", "AP", "cm_delta_pp", "ratio", -0.00865975, "", 1e-06 },
            { "S-FY25-cmpPY prof.AP.ebitda", "prof.AP.ebitda", "prof", "AP", "ebitda", "amount", 11009976.9613, "", 0.05 },
            { "S-FY25-cmpPY prof.TOTAL.nr", "prof.TOTAL.nr", "prof", "TOTAL", "nr", "amount", 655627990.7605, "", 0.05 },
            { "S-FY25-cmpPY prof.TOTAL.nr_delta_pct", "prof.TOTAL.nr_delta_pct", "prof", "TOTAL", "nr_delta_pct", "ratio", 0.278333002, "", 1e-06 },
            { "S-FY25-cmpPY prof.TOTAL.gm_pct", "prof.TOTAL.gm_pct", "prof", "TOTAL", "gm_pct", "ratio", 0.558536762, "", 1e-06 },
            { "S-FY25-cmpPY prof.TOTAL.cm_pct", "prof.TOTAL.cm_pct", "prof", "TOTAL", "cm_pct", "ratio", 0.512744527, "", 1e-06 },
            { "S-FY25-cmpPY prof.TOTAL.cm_delta_pp", "prof.TOTAL.cm_delta_pp", "prof", "TOTAL", "cm_delta_pp", "ratio", -0.00544126, "", 1e-06 },
            { "S-FY25-cmpPY prof.TOTAL.ebitda", "prof.TOTAL.ebitda", "prof", "TOTAL", "ebitda", "amount", 81337029.1624, "", 0.05 },
            { "S-FY25-cmpPY prof.NA.cm_status", "prof.NA.cm_status", "prof", "NA", "cm_status", "status", BLANK (), "watch", 0.0 },
            { "S-FY25-cmpPY prof.EU.cm_status", "prof.EU.cm_status", "prof", "EU", "cm_status", "status", BLANK (), "watch", 0.0 },
            { "S-FY25-cmpPY prof.AP.cm_status", "prof.AP.cm_status", "prof", "AP", "cm_status", "status", BLANK (), "watch", 0.0 },
            { "S-FY25-cmpPY prof.UK.cm_status", "prof.UK.cm_status", "prof", "UK", "cm_status", "status", BLANK (), "watch", 0.0 },
            { "S-FY25-cmpPY prof.TOTAL.cm_status", "prof.TOTAL.cm_status", "prof", "TOTAL", "cm_status", "status", BLANK (), "watch", 0.0 },
            { "S-FY25-cmpPY conc.NA.NR", "conc.NA.NR", "conc", "NA", "NR", "ratio", 0.545584981, "", 1e-06 },
            { "S-FY25-cmpPY conc.EU.NR", "conc.EU.NR", "conc", "EU", "NR", "ratio", 0.223174511, "", 1e-06 },
            { "S-FY25-cmpPY conc.AP.NR", "conc.AP.NR", "conc", "AP", "NR", "ratio", 0.129679615, "", 1e-06 },
            { "S-FY25-cmpPY conc.UK.NR", "conc.UK.NR", "conc", "UK", "NR", "ratio", 0.101560894, "", 1e-06 },
            { "S-FY25-cmpPY conc.NA.CM", "conc.NA.CM", "conc", "NA", "CM", "ratio", 0.541428527, "", 1e-06 },
            { "S-FY25-cmpPY conc.EU.CM", "conc.EU.CM", "conc", "EU", "CM", "ratio", 0.226168677, "", 1e-06 },
            { "S-FY25-cmpPY conc.AP.CM", "conc.AP.CM", "conc", "AP", "CM", "ratio", 0.130174442, "", 1e-06 },
            { "S-FY25-cmpPY conc.UK.CM", "conc.UK.CM", "conc", "UK", "CM", "ratio", 0.102228354, "", 1e-06 },
            { "S-FY25-cmpPY conc.NA.EBITDA", "conc.NA.EBITDA", "conc", "NA", "EBITDA", "ratio", 0.516082439, "", 1e-06 },
            { "S-FY25-cmpPY conc.EU.EBITDA", "conc.EU.EBITDA", "conc", "EU", "EBITDA", "ratio", 0.241807169, "", 1e-06 },
            { "S-FY25-cmpPY conc.AP.EBITDA", "conc.AP.EBITDA", "conc", "AP", "EBITDA", "ratio", 0.135362418, "", 1e-06 },
            { "S-FY25-cmpPY conc.UK.EBITDA", "conc.UK.EBITDA", "conc", "UK", "EBITDA", "ratio", 0.106747974, "", 1e-06 },
            { "S-FY25-cmpPY heat.SUB.gm", "heat.SUB.gm", "heat_gm", "SUB", "gm", "ratio", 0.809964875, "", 1e-06 },
            { "S-FY25-cmpPY heat.PAY.gm", "heat.PAY.gm", "heat_gm", "PAY", "gm", "ratio", 0.39373696, "", 1e-06 },
            { "S-FY25-cmpPY heat.APP.gm", "heat.APP.gm", "heat_gm", "APP", "gm", "ratio", 0.700055833, "", 1e-06 },
            { "S-FY25-cmpPY heat.PS.gm", "heat.PS.gm", "heat_gm", "PS", "gm", "ratio", 0.178110296, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _conc = SUMMARIZECOLUMNS ( dim_region[region_code], dim_conc_level[level_code], "@v", [Conc Share] )
        VAR _heat =
            SUMMARIZECOLUMNS (
                dim_region[region_code]
                ,dim_region[region_name]
                ,dim_line[line_code]
                ,dim_line[line_name]
                ,"@c", [_Heat NR Ratio]
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _prof =
                            SWITCH (
                                _k3
                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                ,"gm_pct", [Prof GM %]
                                ,"cm_pct", [Prof CM %]
                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                            )
                        RETURN
                            SWITCH (
                                _k1
                                ,"prof"
                                    ,IF (
                                        _k2 = "TOTAL"
                                        ,_prof
                                        ,CALCULATE (
                                            SWITCH (
                                                _k3
                                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                                ,"gm_pct", [Prof GM %]
                                                ,"cm_pct", [Prof CM %]
                                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                                            )
                                            ,TREATAS ( { _k2 }, dim_region[region_code] )
                                        )
                                    )
                                ,"conc", MAXX ( FILTER ( _conc, dim_region[region_code] = _k2 && dim_conc_level[level_code] = _k3 ), [@v] )
                                ,"heat_gm", CALCULATE ( [_Heat Colour GM], TREATAS ( { _k2 }, dim_line[line_code] ) )
                                ,"heat"
                                    ,IF (
                                        _k3 = "colour"
                                        ,MAXX ( FILTER ( _heat, dim_region[region_code] = PATHITEM ( _k2, 1 ) && dim_line[line_code] = PATHITEM ( _k2, 2 ) ), [@c] )
                                        ,CALCULATE ( [Prof Net Revenue] * [_Units Divisor], TREATAS ( { ( PATHITEM ( _k2, 1 ), PATHITEM ( _k2, 2 ) ) }, dim_region[region_code], dim_line[line_code] ) )
                                    )
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k3 = "cm_status"
                            ,IF ( _k2 = "TOTAL", [_Prof CM Status], CALCULATE ( [_Prof CM Status], TREATAS ( { _k2 }, dim_region[region_code] ) ) )
                            ,SWITCH (
                                _k3
                                ,"basis", IF ( LEFT ( [Prof Subtitle CC], 17 ) = "Constant currency", "CC", "ACT" )
                                ,"subtitle", [Prof Subtitle CC]
                            )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
        ,TREATAS ( { "B" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-noB header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-noB ct.NR", "ct.NR", "NR", "", "", "amount", 667360690.8433, "", 0.01 },
            { "S-FY25-noB ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 82827372.209, "", 0.01 },
            { "S-FY25-noB ct.OP", "ct.OP", "OP", "", "", "amount", 48580071.4695, "", 0.01 },
            { "S-FY25-noB ct.NP", "ct.NP", "NP", "", "", "amount", 38144183.9088, "", 0.01 },
            { "S-FY25-noB hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "Full year 2025", 0.0 },
            { "S-FY25-noB hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2025", 0.0 },
            { "S-FY25-noB hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Dec 2025 - full year", 0.0 },
            { "S-FY25-noB hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Full year", 0.0 },
            { "S-FY25-noB hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A)", 0.0 },
            { "S-FY25-noB hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "NONE" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

