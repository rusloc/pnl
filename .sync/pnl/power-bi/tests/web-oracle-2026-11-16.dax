            { "P-YTD26 stmt.TAX.fy_bud_text", "stmt.TAX.fy_bud_text", "TAX", "fy_bud_text", "", "text", BLANK (), "−184.4", 0.0 },
            { "P-YTD26 stmt.TAX.fy_le_text", "stmt.TAX.fy_le_text", "TAX", "fy_le_text", "", "text", BLANK (), "−175.8", 0.0 },
            { "P-YTD26 stmt.TAX.pct_nr_text", "stmt.TAX.pct_nr_text", "TAX", "pct_nr_text", "", "text", BLANK (), "−3.7%", 0.0 },
