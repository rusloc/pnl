// ---------------------------------------------------------------- O-S-FY25-noB largest variances (filter none) (14 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-noB var.total_delta", "var.total_delta", "total_delta", "", "", "amount", -1569730.0423, "", 0.05 },
            { "S-FY25-noB var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 32.0, "", 0.0 },
            { "S-FY25-noB var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_S2 COR_S2 GR_S4 RD_S1 ADJ_3 COR_S5 SM_S1 GR_S1", 0.0 },
            { "S-FY25-noB var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_3 OOI_1 OOI_3", 0.0 },
            { "S-FY25-noB var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "none", 0.0 },
            { "S-FY25-noB var.total_fx", "var.total_fx", "total_fx", "", "", "amount", 850229.3593, "", 0.05 },
            { "S-FY25-noB var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "none", 0.0 },
            { "S-FY25-noB var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_S2 COR_S2 GR_S4 RD_S1 ADJ_3 COR_S5 SM_S1 GR_S1 RD_S2 SM_S3 GA_1 RD_S3 VSC_S3 DA_S1 SM_S2 GA_2 COR_S4 GA_4 GA_3 DA_S2 SM_S4 DA_S3 VSC_S2 OOI_1 COR_S3 GTN_S3 COR_S1 GR_S3 GTN_S2 VSC_S1 GTN_S1 OOI_3", 0.0 },
            { "S-FY25-noB var.footer.comparison", "var.footer.comparison", "footer", "comparison", "", "text", BLANK (), "$50.1 m", 0.0 },
            { "S-FY25-noB var.footer.actual", "var.footer.actual", "footer", "actual", "", "text", BLANK (), "$48.6 m", 0.0 },
            { "S-FY25-noB var.footer.delta", "var.footer.delta", "footer", "delta", "", "text", BLANK (), "−$1.6 m", 0.0 },
            { "S-FY25-noB var.footer.delta_pct", "var.footer.delta_pct", "footer", "delta_pct", "", "text", BLANK (), "−3.1%", 0.0 },
            { "S-FY25-noB var.footer.py", "var.footer.py", "footer", "py", "", "text", BLANK (), "n/a", 0.0 },
            { "S-FY25-noB var.footer.fx", "var.footer.fx", "footer", "fx", "", "text", BLANK (), "+$0.9 m", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "NONE" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-noB profitability: region table, concentration, heatmap (53 rows)
