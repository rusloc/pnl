            { "P-YTD26 stmt.TAX.d_b_pct_text", "stmt.TAX.d_b_pct_text", "TAX", "d_b_pct_text", "", "text", BLANK (), "−12.5%", 0.0 },
            { "P-YTD26 stmt.TAX.fy_d_text", "stmt.TAX.fy_d_text", "TAX", "fy_d_text", "", "text", BLANK (), "+8.6", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.base", "stmt.ETR_PCT.base", "ETR_PCT", "base", "", "ratio", 0.24, "", 1e-06 },
            { "P-YTD26 stmt.ETR_PCT.base_text", "stmt.ETR_PCT.base_text", "ETR_PCT", "base_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.cmp_a_text", "stmt.ETR_PCT.cmp_a_text", "ETR_PCT", "cmp_a_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.cmp_b_text", "stmt.ETR_PCT.cmp_b_text", "ETR_PCT", "cmp_b_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.fy_bud_text", "stmt.ETR_PCT.fy_bud_text", "ETR_PCT", "fy_bud_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.fy_le_text", "stmt.ETR_PCT.fy_le_text", "ETR_PCT", "fy_le_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.pct_nr_text", "stmt.ETR_PCT.pct_nr_text", "ETR_PCT", "pct_nr_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.d_a_text", "stmt.ETR_PCT.d_a_text", "ETR_PCT", "d_a_text", "", "text", BLANK (), "0.0 pp", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.d_a_pct_text", "stmt.ETR_PCT.d_a_pct_text", "ETR_PCT", "d_a_pct_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.d_b_text", "stmt.ETR_PCT.d_b_text", "ETR_PCT", "d_b_text", "", "text", BLANK (), "0.0 pp", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.d_b_pct_text", "stmt.ETR_PCT.d_b_pct_text", "ETR_PCT", "d_b_pct_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.ETR_PCT.fy_d_text", "stmt.ETR_PCT.fy_d_text", "ETR_PCT", "fy_d_text", "", "text", BLANK (), "0.0 pp", 0.0 },
            { "P-YTD26 stmt.NP.base", "stmt.NP.base", "NP", "base", "", "amount", 396244971.8623, "", 0.05 },
            { "P-YTD26 stmt.NP.base_text", "stmt.NP.base_text", "NP", "base_text", "", "text", BLANK (), "396.2", 0.0 },
            { "P-YTD26 stmt.NP.cmp_a_text", "stmt.NP.cmp_a_text", "NP", "cmp_a_text", "", "text", BLANK (), "412.2", 0.0 },
            { "P-YTD26 stmt.NP.cmp_b_text", "stmt.NP.cmp_b_text", "NP", "cmp_b_text", "", "text", BLANK (), "352.2", 0.0 },
            { "P-YTD26 stmt.NP.fy_bud_text", "stmt.NP.fy_bud_text", "NP", "fy_bud_text", "", "text", BLANK (), "584.0", 0.0 },
            { "P-YTD26 stmt.NP.fy_le_text", "stmt.NP.fy_le_text", "NP", "fy_le_text", "", "text", BLANK (), "556.8", 0.0 },
            { "P-YTD26 stmt.NP.pct_nr_text", "stmt.NP.pct_nr_text", "NP", "pct_nr_text", "", "text", BLANK (), "11.7%", 0.0 },
            { "P-YTD26 stmt.NP.d_a_text", "stmt.NP.d_a_text", "NP", "d_a_text", "", "text", BLANK (), "−15.9", 0.0 },
            { "P-YTD26 stmt.NP.d_a_pct_text", "stmt.NP.d_a_pct_text", "NP", "d_a_pct_text", "", "text", BLANK (), "−3.9%", 0.0 },
            { "P-YTD26 stmt.NP.d_b_text", "stmt.NP.d_b_text", "NP", "d_b_text", "", "text", BLANK (), "+44.1", 0.0 },
            { "P-YTD26 stmt.NP.d_b_pct_text", "stmt.NP.d_b_pct_text", "NP", "d_b_pct_text", "", "text", BLANK (), "+12.5%", 0.0 },
            { "P-YTD26 stmt.NP.fy_d_text", "stmt.NP.fy_d_text", "NP", "fy_d_text", "", "text", BLANK (), "−27.2", 0.0 },
            { "P-YTD26 stmt.NP_PCT.base", "stmt.NP_PCT.base", "NP_PCT", "base", "", "ratio", 0.116593325, "", 1e-06 },
            { "P-YTD26 stmt.NP_PCT.base_text", "stmt.NP_PCT.base_text", "NP_PCT", "base_text", "", "text", BLANK (), "11.7%", 0.0 },
            { "P-YTD26 stmt.NP_PCT.cmp_a_text", "stmt.NP_PCT.cmp_a_text", "NP_PCT", "cmp_a_text", "", "text", BLANK (), "11.9%", 0.0 },
            { "P-YTD26 stmt.NP_PCT.cmp_b_text", "stmt.NP_PCT.cmp_b_text", "NP_PCT", "cmp_b_text", "", "text", BLANK (), "11.2%", 0.0 },
            { "P-YTD26 stmt.NP_PCT.fy_bud_text", "stmt.NP_PCT.fy_bud_text", "NP_PCT", "fy_bud_text", "", "text", BLANK (), "11.6%", 0.0 },
            { "P-YTD26 stmt.NP_PCT.fy_le_text", "stmt.NP_PCT.fy_le_text", "NP_PCT", "fy_le_text", "", "text", BLANK (), "11.3%", 0.0 },
            { "P-YTD26 stmt.NP_PCT.pct_nr_text", "stmt.NP_PCT.pct_nr_text", "NP_PCT", "pct_nr_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.NP_PCT.d_a_text", "stmt.NP_PCT.d_a_text", "NP_PCT", "d_a_text", "", "text", BLANK (), "−0.2 pp", 0.0 },
            { "P-YTD26 stmt.NP_PCT.d_a_pct_text", "stmt.NP_PCT.d_a_pct_text", "NP_PCT", "d_a_pct_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.NP_PCT.d_b_text", "stmt.NP_PCT.d_b_text", "NP_PCT", "d_b_text", "", "text", BLANK (), "+0.4 pp", 0.0 },
            { "P-YTD26 stmt.NP_PCT.d_b_pct_text", "stmt.NP_PCT.d_b_pct_text", "NP_PCT", "d_b_pct_text", "", "text", BLANK (), "", 0.0 },
            { "P-YTD26 stmt.NP_PCT.fy_d_text", "stmt.NP_PCT.fy_d_text", "NP_PCT", "fy_d_text", "", "text", BLANK (), "−0.3 pp", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _codes = FILTER ( DISTINCT ( SELECTCOLUMNS ( _expected, "_c", [_k1] ) ), [_c] <> "row_count" )
        VAR _vals =
            ADDCOLUMNS (
                _codes
                ,"@ratio", INT ( CALCULATE ( [_PL Is Ratio], TREATAS ( { [_c] }, dim_pl_row[line_code] ) ) )
                ,"@mult", CALCULATE ( [_PL Cost Mult], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@base", CALCULATE ( [PL Base], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@pct", CALCULATE ( [PL % NR], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@ca", CALCULATE ( [PL Compare A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@da", CALCULATE ( [PL Δ A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dap", CALCULATE ( [PL Δ A %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@cb", CALCULATE ( [PL Compare B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@db", CALCULATE ( [PL Δ B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dbp", CALCULATE ( [PL Δ B %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fb", CALCULATE ( [PL FY Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fl", CALCULATE ( [PL FY LE], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fd", CALCULATE ( [PL Δ LE vs Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
            )
        VAR _row_count =
            COUNTROWS ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ) )
                + COUNTROWS ( FILTER ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], dim_pl_row[account_label], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ), dim_pl_row[account_label] <> "" ) )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "row_count"
                            ,_row_count
                            ,VAR _r = FILTER ( _vals, [_c] = _k1 )
                             RETURN
                                IF ( MAXX ( _r, [@ratio] ) = 1, MAXX ( _r, [@base] ), MAXX ( _r, [@base] ) * [_Units Divisor] * MAXX ( _r, [@mult] ) )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _r = FILTER ( _vals, [_c] = _k1 )
                        VAR _ratio = MAXX ( _r, [@ratio] ) = 1
                        VAR _base = MAXX ( _r, [@base] )
                        VAR _pct = MAXX ( _r, [@pct] )
                        VAR _ca = MAXX ( _r, [@ca] )
                        VAR _da = MAXX ( _r, [@da] )
                        VAR _dap = MAXX ( _r, [@dap] )
                        VAR _cb = MAXX ( _r, [@cb] )
                        VAR _db = MAXX ( _r, [@db] )
                        VAR _dbp = MAXX ( _r, [@dbp] )
                        VAR _fb = MAXX ( _r, [@fb] )
                        VAR _fl = MAXX ( _r, [@fl] )
                        VAR _fd = MAXX ( _r, [@fd] )
                        RETURN
                            SWITCH (
                                _k2
                                ,"base_text", IF ( _ratio, IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 3 ) = 0, "0.0%", FORMAT ( _base, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 1 ) = 0, "0.0", FORMAT ( _base, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_a_text", IF ( _ratio, IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 3 ) = 0, "0.0%", FORMAT ( _ca, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 1 ) = 0, "0.0", FORMAT ( _ca, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_a_text", IF ( _ratio, IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0 pp", FORMAT ( _da, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0", FORMAT ( _da, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_b_text", IF ( _ratio, IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 3 ) = 0, "0.0%", FORMAT ( _cb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 1 ) = 0, "0.0", FORMAT ( _cb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_b_text", IF ( _ratio, IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0 pp", FORMAT ( _db, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0", FORMAT ( _db, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_bud_text", IF ( _ratio, IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 3 ) = 0, "0.0%", FORMAT ( _fb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 1 ) = 0, "0.0", FORMAT ( _fb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_le_text", IF ( _ratio, IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 3 ) = 0, "0.0%", FORMAT ( _fl, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 1 ) = 0, "0.0", FORMAT ( _fl, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_d_text", IF ( _ratio, IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0 pp", FORMAT ( _fd, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0", FORMAT ( _fd, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"pct_nr_text", IF ( ISBLANK ( _pct ), "", IF ( ROUND ( ABS ( _pct ), 3 ) = 0, "0.0%", FORMAT ( _pct, "0.0%;−0.0%;0.0%" ) ) )
                                ,"d_a_pct_text", IF ( ISBLANK ( _dap ), "", IF ( _dap = 0, "n/a", IF ( ROUND ( ABS ( _dap ), 3 ) = 0, "0.0%", FORMAT ( _dap, "+0.0%;−0.0%;0.0%" ) ) ) )
                                ,"d_b_pct_text", IF ( ISBLANK ( _dbp ), "", IF ( _dbp = 0, "n/a", IF ( ROUND ( ABS ( _dbp ), 3 ) = 0, "0.0%", FORMAT ( _dbp, "+0.0%;−0.0%;0.0%" ) ) ) )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-cmpPY header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-cmpPY ct.NR", "ct.NR", "NR", "", "", "amount", 667360690.8433, "", 0.01 },
            { "S-FY25-cmpPY ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 82827372.209, "", 0.01 },
            { "S-FY25-cmpPY ct.OP", "ct.OP", "OP", "", "", "amount", 48580071.4695, "", 0.01 },
            { "S-FY25-cmpPY ct.NP", "ct.NP", "NP", "", "", "amount", 38144183.9088, "", 0.01 },
            { "S-FY25-cmpPY hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "Full year 2025", 0.0 },
            { "S-FY25-cmpPY hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2025", 0.0 },
            { "S-FY25-cmpPY hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Dec 2025 - full year", 0.0 },
            { "S-FY25-cmpPY hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Full year", 0.0 },
            { "S-FY25-cmpPY hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Prior year (A) and Budget (B)", 0.0 },
            { "S-FY25-cmpPY hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
        ,TREATAS ( { "B" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

