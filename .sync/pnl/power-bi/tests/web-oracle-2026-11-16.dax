            { "S-YTD26 trend.TOTAL.cm.2026-03", "trend.TOTAL.cm.2026-03", "cm", "TOTAL", "26", "ratio", 0.507945151, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-04", "trend.TOTAL.cm.2026-04", "cm", "TOTAL", "27", "ratio", 0.508662715, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-05", "trend.TOTAL.cm.2026-05", "cm", "TOTAL", "28", "ratio", 0.506146669, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-06", "trend.TOTAL.cm.2026-06", "cm", "TOTAL", "29", "ratio", 0.506203964, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-07", "trend.TOTAL.cm.2026-07", "cm", "TOTAL", "30", "ratio", 0.508948655, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-08", "trend.TOTAL.cm.2026-08", "cm", "TOTAL", "31", "ratio", 0.507541717, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.cm.2026-09", "trend.TOTAL.cm.2026-09", "cm", "TOTAL", "32", "ratio", 0.505306186, "", 1e-06 },
            { "S-YTD26 trend.TOTAL.growth_last", "trend.TOTAL.growth_last", "last", "TOTAL", "growth_last", "text", BLANK (), "+27.3%", 0.0 },
            { "S-YTD26 trend.TOTAL.cm_last", "trend.TOTAL.cm_last", "last", "TOTAL", "cm_last", "text", BLANK (), "50.5%", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    CALCULATE (
                        SWITCH ( _k1, "growth", [Trend Growth], "cm", [Trend CM %] )
                        ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                        ,TREATAS ( { IF ( _k1 IN { "growth", "cm" }, VALUE ( _k3 ), -99 ) }, dim_month[month_index] )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"months"
                            ,CONCATENATEX (
                                FILTER (
                                    ALL ( dim_month[month_index], dim_month[month_name], dim_month[fiscal_year] )
                                    ,NOT ISBLANK ( CALCULATE ( [Trend CM %], TREATAS ( { "TOTAL" }, dim_trend_row[trend_row_code] ) ) )
                                )
                                ,dim_month[month_name] & " " & dim_month[fiscal_year]
                                ," | "
                                ,dim_month[month_index], ASC
                            )
                        ,"note", COALESCE ( [Trend Note], "none" )
                        ,"last"
                            ,CALCULATE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS (
                                            ALL ( dim_month[month_index] )
                                            ,"@v", IF ( _k3 = "growth_last", [Trend Growth Last], [Trend CM % Last] )
                                        )
                                        ,NOT ISBLANK ( [@v] )
                                    )
                                    ,IF ( _k3 = "growth_last", IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "+0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "0.0%;−0.0%;0.0%" ) ) ) )
                                    ," / "
                                )
                                ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                            )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-YTD26 statement (349 rows)
VAR _expected =
