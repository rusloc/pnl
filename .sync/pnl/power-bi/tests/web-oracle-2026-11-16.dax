            { "S-RNG-2607-2612 nr_bridge.SVC_PS.label", "nr_bridge.SVC_PS.label", "nr_bridge", "SVC_PS", "label", "text", BLANK (), "Professional services", 0.0 },
            { "S-RNG-2607-2612 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 212343924.0526, "", 0.05 },
            { "S-RNG-2607-2612 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
