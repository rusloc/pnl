            { "P-FY25 prof.AP.cm_status", "prof.AP.cm_status", "prof", "AP", "cm_status", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 prof.UK.cm_status", "prof.UK.cm_status", "prof", "UK", "cm_status", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 prof.TOTAL.cm_status", "prof.TOTAL.cm_status", "prof", "TOTAL", "cm_status", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 conc.NA.NR", "conc.NA.NR", "conc", "NA", "NR", "ratio", 0.453398894, "", 1e-06 },
            { "P-FY25 conc.EU.NR", "conc.EU.NR", "conc", "EU", "NR", "ratio", 0.269409468, "", 1e-06 },
            { "P-FY25 conc.AP.NR", "conc.AP.NR", "conc", "AP", "NR", "ratio", 0.156061097, "", 1e-06 },
            { "P-FY25 conc.UK.NR", "conc.UK.NR", "conc", "UK", "NR", "ratio", 0.121130541, "", 1e-06 },
            { "P-FY25 conc.NA.CM", "conc.NA.CM", "conc", "NA", "CM", "ratio", 0.453302596, "", 1e-06 },
            { "P-FY25 conc.EU.CM", "conc.EU.CM", "conc", "EU", "CM", "ratio", 0.269461441, "", 1e-06 },
            { "P-FY25 conc.AP.CM", "conc.AP.CM", "conc", "AP", "CM", "ratio", 0.156157759, "", 1e-06 },
            { "P-FY25 conc.UK.CM", "conc.UK.CM", "conc", "UK", "CM", "ratio", 0.121078203, "", 1e-06 },
            { "P-FY25 conc.NA.EBITDA", "conc.NA.EBITDA", "conc", "NA", "EBITDA", "ratio", 0.453239842, "", 1e-06 },
            { "P-FY25 conc.EU.EBITDA", "conc.EU.EBITDA", "conc", "EU", "EBITDA", "ratio", 0.269602018, "", 1e-06 },
            { "P-FY25 conc.AP.EBITDA", "conc.AP.EBITDA", "conc", "AP", "EBITDA", "ratio", 0.156207787, "", 1e-06 },
            { "P-FY25 conc.UK.EBITDA", "conc.UK.EBITDA", "conc", "UK", "EBITDA", "ratio", 0.120950354, "", 1e-06 },
            { "P-FY25 heat.HOME.gm", "heat.HOME.gm", "heat_gm", "HOME", "gm", "ratio", 0.511755285, "", 1e-06 },
            { "P-FY25 heat.PERS.gm", "heat.PERS.gm", "heat_gm", "PERS", "gm", "ratio", 0.591301937, "", 1e-06 },
            { "P-FY25 heat.KITC.gm", "heat.KITC.gm", "heat_gm", "KITC", "gm", "ratio", 0.471270089, "", 1e-06 },
            { "P-FY25 heat.ELEC.gm", "heat.ELEC.gm", "heat_gm", "ELEC", "gm", "ratio", 0.356515583, "", 1e-06 },
            { "P-FY25 heat.TOYS.gm", "heat.TOYS.gm", "heat_gm", "TOYS", "gm", "ratio", 0.436742122, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _conc = SUMMARIZECOLUMNS ( dim_region[region_code], dim_conc_level[level_code], "@v", [Conc Share] )
        VAR _heat =
            SUMMARIZECOLUMNS (
                dim_region[region_code]
                ,dim_region[region_name]
                ,dim_line[line_code]
                ,dim_line[line_name]
                ,"@c", [_Heat NR Ratio]
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _prof =
                            SWITCH (
                                _k3
                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                ,"gm_pct", [Prof GM %]
                                ,"cm_pct", [Prof CM %]
                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                            )
                        RETURN
                            SWITCH (
                                _k1
                                ,"prof"
                                    ,IF (
                                        _k2 = "TOTAL"
                                        ,_prof
                                        ,CALCULATE (
                                            SWITCH (
                                                _k3
                                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                                ,"gm_pct", [Prof GM %]
                                                ,"cm_pct", [Prof CM %]
                                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                                            )
                                            ,TREATAS ( { _k2 }, dim_region[region_code] )
                                        )
                                    )
                                ,"conc", MAXX ( FILTER ( _conc, dim_region[region_code] = _k2 && dim_conc_level[level_code] = _k3 ), [@v] )
                                ,"heat_gm", CALCULATE ( [_Heat Colour GM], TREATAS ( { _k2 }, dim_line[line_code] ) )
                                ,"heat"
                                    ,IF (
                                        _k3 = "colour"
                                        ,MAXX ( FILTER ( _heat, dim_region[region_code] = PATHITEM ( _k2, 1 ) && dim_line[line_code] = PATHITEM ( _k2, 2 ) ), [@c] )
                                        ,CALCULATE ( [Prof Net Revenue] * [_Units Divisor], TREATAS ( { ( PATHITEM ( _k2, 1 ), PATHITEM ( _k2, 2 ) ) }, dim_region[region_code], dim_line[line_code] ) )
                                    )
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k3 = "cm_status"
                            ,IF ( _k2 = "TOTAL", [_Prof CM Status], CALCULATE ( [_Prof CM Status], TREATAS ( { _k2 }, dim_region[region_code] ) ) )
                            ,SWITCH (
                                _k3
                                ,"basis", IF ( LEFT ( [Prof Subtitle CC], 17 ) = "Constant currency", "CC", "ACT" )
                                ,"subtitle", [Prof Subtitle CC]
                            )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26 header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-YTD26 ct.NR", "ct.NR", "NR", "", "", "amount", 3398521942.6604, "", 0.01 },
            { "P-YTD26 ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 682594931.6447, "", 0.01 },
            { "P-YTD26 ct.OP", "ct.OP", "OP", "", "", "amount", 550227316.2603, "", 0.01 },
            { "P-YTD26 ct.NP", "ct.NP", "NP", "", "", "amount", 396244971.8623, "", 0.01 },
            { "P-YTD26 hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "YTD Sep 2026", 0.0 },
            { "P-YTD26 hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2026", 0.0 },
            { "P-YTD26 hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Sep 2026 - year to date", 0.0 },
            { "P-YTD26 hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Year to date", 0.0 },
            { "P-YTD26 hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A) and Prior year (B)", 0.0 },
            { "P-YTD26 hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26 Vitals (40 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-YTD26 vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$3,398.5 m", 0.0 },
            { "P-YTD26 vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-YTD26 vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$682.6 m", 0.0 },
            { "P-YTD26 vitals.ebitda.status", "vitals.ebitda.status", "EBITDA", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-YTD26 vitals.ebitda.rows", "vitals.ebitda.rows", "EBITDA", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.op.value_text", "vitals.op.value_text", "OP", "value_text", "", "text", BLANK (), "$550.2 m", 0.0 },
            { "P-YTD26 vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "off", 0.0 },
            { "P-YTD26 vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.gm.value_text", "vitals.gm.value_text", "GM_PCT", "value_text", "", "text", BLANK (), "49.4%", 0.0 },
            { "P-YTD26 vitals.gm.status", "vitals.gm.status", "GM_PCT", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-YTD26 vitals.gm.rows", "vitals.gm.rows", "GM_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.opex.value_text", "vitals.opex.value_text", "OPEX_PCT", "value_text", "", "text", BLANK (), "19.3%", 0.0 },
            { "P-YTD26 vitals.opex.status", "vitals.opex.status", "OPEX_PCT", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "P-YTD26 vitals.opex.rows", "vitals.opex.rows", "OPEX_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.units.value_text", "vitals.units.value_text", "UNITS", "value_text", "", "text", BLANK (), "419,838,143", 0.0 },
            { "P-YTD26 vitals.units.status", "vitals.units.status", "UNITS", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-YTD26 vitals.units.rows", "vitals.units.rows", "UNITS", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.nrPerUnit.value_text", "vitals.nrPerUnit.value_text", "NR_PER_UNIT", "value_text", "", "text", BLANK (), "$8.09", 0.0 },
            { "P-YTD26 vitals.nrPerUnit.status", "vitals.nrPerUnit.status", "NR_PER_UNIT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-YTD26 vitals.nrPerUnit.rows", "vitals.nrPerUnit.rows", "NR_PER_UNIT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.gtn.value_text", "vitals.gtn.value_text", "GTN_PCT", "value_text", "", "text", BLANK (), "21.3%", 0.0 },
            { "P-YTD26 vitals.gtn.status", "vitals.gtn.status", "GTN_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-YTD26 vitals.gtn.rows", "vitals.gtn.rows", "GTN_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.ap.value_text", "vitals.ap.value_text", "AP_PCT", "value_text", "", "text", BLANK (), "8.0%", 0.0 },
            { "P-YTD26 vitals.ap.status", "vitals.ap.status", "AP_PCT", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "P-YTD26 vitals.ap.rows", "vitals.ap.rows", "AP_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-YTD26 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$4,908.1 m", 0.0 },
            { "P-YTD26 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-YTD26 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "P-YTD26 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 3398521942.6604, "", 0.05 },
            { "P-YTD26 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 682594931.6447, "", 0.05 },
            { "P-YTD26 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 550227316.2603, "", 0.05 },
            { "P-YTD26 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.494100114, "", 1e-06 },
            { "P-YTD26 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.192609749, "", 1e-06 },
            { "P-YTD26 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", -0.019128599, "", 1e-06 },
            { "P-YTD26 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.004202485, "", 1e-06 },
            { "P-YTD26 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.060786958, "", 1e-06 },
            { "P-YTD26 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 4908087890.1284, "", 0.05 },
            { "P-YTD26 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 0.975921168, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26 bridges (26 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-YTD26 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 3464798688.449, "", 0.05 },
            { "P-YTD26 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "P-YTD26 nr_bridge.VOL.value", "nr_bridge.VOL.value", "nr_bridge", "VOL", "value", "amount", -64973368.0835, "", 0.05 },
            { "P-YTD26 nr_bridge.VOL.label", "nr_bridge.VOL.label", "nr_bridge", "VOL", "label", "text", BLANK (), "Volume", 0.0 },
            { "P-YTD26 nr_bridge.PRICE.value", "nr_bridge.PRICE.value", "nr_bridge", "PRICE", "value", "amount", -30818087.7968, "", 0.05 },
            { "P-YTD26 nr_bridge.PRICE.label", "nr_bridge.PRICE.label", "nr_bridge", "PRICE", "label", "text", BLANK (), "Price / mix", 0.0 },
            { "P-YTD26 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 3369007232.5687, "", 0.05 },
            { "P-YTD26 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "P-YTD26 nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 29514710.0917, "", 0.05 },
            { "P-YTD26 nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "P-YTD26 nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 3398521942.6604, "", 0.05 },
            { "P-YTD26 nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "P-YTD26 profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 701037782.252, "", 0.05 },
            { "P-YTD26 profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -47725267.9739, "", 0.05 },
            { "P-YTD26 profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -16667392.0267, "", 0.05 },
            { "P-YTD26 profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", 2788656.0344, "", 0.05 },
            { "P-YTD26 profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 4394997.5096, "", 0.05 },
            { "P-YTD26 profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 25519508.1667, "", 0.05 },
            { "P-YTD26 profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 2372765.1016, "", 0.05 },
            { "P-YTD26 profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 5119141.68, "", 0.05 },
            { "P-YTD26 profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -168954.5368, "", 0.05 },
            { "P-YTD26 profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 5923695.4378, "", 0.05 },
            { "P-YTD26 profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 682594931.6447, "", 0.05 },
            { "P-YTD26 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -122346789.9421, "", 0.05 },
            { "P-YTD26 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -10020825.4423, "", 0.05 },
            { "P-YTD26 profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 550227316.2603, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26 largest variances (filter none) (88 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
