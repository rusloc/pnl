            { "P-RNG-2407-2506 vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-RNG-2407-2506 vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
