            { "S-YTD26 stmt.NP_PCT.fy_d_text", "stmt.NP_PCT.fy_d_text", "NP_PCT", "fy_d_text", "", "text", BLANK (), "−0.7 pp", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _codes = FILTER ( DISTINCT ( SELECTCOLUMNS ( _expected, "_c", [_k1] ) ), [_c] <> "row_count" )
        VAR _vals =
            ADDCOLUMNS (
                _codes
                ,"@ratio", INT ( CALCULATE ( [_PL Is Ratio], TREATAS ( { [_c] }, dim_pl_row[line_code] ) ) )
                ,"@mult", CALCULATE ( [_PL Cost Mult], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@base", CALCULATE ( [PL Base], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@pct", CALCULATE ( [PL % NR], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@ca", CALCULATE ( [PL Compare A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@da", CALCULATE ( [PL Δ A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dap", CALCULATE ( [PL Δ A %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@cb", CALCULATE ( [PL Compare B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@db", CALCULATE ( [PL Δ B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dbp", CALCULATE ( [PL Δ B %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fb", CALCULATE ( [PL FY Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fl", CALCULATE ( [PL FY LE], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fd", CALCULATE ( [PL Δ LE vs Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
            )
        VAR _row_count =
            COUNTROWS ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ) )
                + COUNTROWS ( FILTER ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], dim_pl_row[account_label], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ), dim_pl_row[account_label] <> "" ) )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "row_count"
                            ,_row_count
                            ,VAR _r = FILTER ( _vals, [_c] = _k1 )
                             RETURN
                                IF ( MAXX ( _r, [@ratio] ) = 1, MAXX ( _r, [@base] ), MAXX ( _r, [@base] ) * [_Units Divisor] * MAXX ( _r, [@mult] ) )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _r = FILTER ( _vals, [_c] = _k1 )
                        VAR _ratio = MAXX ( _r, [@ratio] ) = 1
                        VAR _base = MAXX ( _r, [@base] )
                        VAR _pct = MAXX ( _r, [@pct] )
                        VAR _ca = MAXX ( _r, [@ca] )
                        VAR _da = MAXX ( _r, [@da] )
                        VAR _dap = MAXX ( _r, [@dap] )
                        VAR _cb = MAXX ( _r, [@cb] )
                        VAR _db = MAXX ( _r, [@db] )
                        VAR _dbp = MAXX ( _r, [@dbp] )
                        VAR _fb = MAXX ( _r, [@fb] )
                        VAR _fl = MAXX ( _r, [@fl] )
                        VAR _fd = MAXX ( _r, [@fd] )
                        RETURN
                            SWITCH (
                                _k2
                                ,"base_text", IF ( _ratio, IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 3 ) = 0, "0.0%", FORMAT ( _base, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 1 ) = 0, "0.0", FORMAT ( _base, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_a_text", IF ( _ratio, IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 3 ) = 0, "0.0%", FORMAT ( _ca, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 1 ) = 0, "0.0", FORMAT ( _ca, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_a_text", IF ( _ratio, IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0 pp", FORMAT ( _da, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0", FORMAT ( _da, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_b_text", IF ( _ratio, IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 3 ) = 0, "0.0%", FORMAT ( _cb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 1 ) = 0, "0.0", FORMAT ( _cb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_b_text", IF ( _ratio, IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0 pp", FORMAT ( _db, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0", FORMAT ( _db, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_bud_text", IF ( _ratio, IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 3 ) = 0, "0.0%", FORMAT ( _fb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 1 ) = 0, "0.0", FORMAT ( _fb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_le_text", IF ( _ratio, IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 3 ) = 0, "0.0%", FORMAT ( _fl, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 1 ) = 0, "0.0", FORMAT ( _fl, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_d_text", IF ( _ratio, IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0 pp", FORMAT ( _fd, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0", FORMAT ( _fd, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"pct_nr_text", IF ( ISBLANK ( _pct ), "", IF ( ROUND ( ABS ( _pct ), 3 ) = 0, "0.0%", FORMAT ( _pct, "0.0%;−0.0%;0.0%" ) ) )
                                ,"d_a_pct_text", IF ( ISBLANK ( _dap ), "", IF ( _dap = 0, "n/a", IF ( ROUND ( ABS ( _dap ), 3 ) = 0, "0.0%", FORMAT ( _dap, "+0.0%;−0.0%;0.0%" ) ) ) )
                                ,"d_b_pct_text", IF ( ISBLANK ( _dbp ), "", IF ( _dbp = 0, "n/a", IF ( ROUND ( ABS ( _dbp ), 3 ) = 0, "0.0%", FORMAT ( _dbp, "+0.0%;−0.0%;0.0%" ) ) ) )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-FY25 header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-FY25 ct.NR", "ct.NR", "NR", "", "", "amount", 4575428492.3836, "", 0.01 },
            { "P-FY25 ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 896884746.7315, "", 0.01 },
            { "P-FY25 ct.OP", "ct.OP", "OP", "", "", "amount", 690335320.6931, "", 0.01 },
            { "P-FY25 ct.NP", "ct.NP", "NP", "", "", "amount", 495801736.0291, "", 0.01 },
            { "P-FY25 hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "Full year 2025", 0.0 },
            { "P-FY25 hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2025", 0.0 },
            { "P-FY25 hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Dec 2025 - full year", 0.0 },
            { "P-FY25 hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Full year", 0.0 },
            { "P-FY25 hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A) and Prior year (B)", 0.0 },
            { "P-FY25 hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-FY25 Vitals (40 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-FY25 vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$4,575.4 m", 0.0 },
            { "P-FY25 vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$896.9 m", 0.0 },
            { "P-FY25 vitals.ebitda.status", "vitals.ebitda.status", "EBITDA", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.ebitda.rows", "vitals.ebitda.rows", "EBITDA", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.op.value_text", "vitals.op.value_text", "OP", "value_text", "", "text", BLANK (), "$690.3 m", 0.0 },
            { "P-FY25 vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "off", 0.0 },
            { "P-FY25 vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.gm.value_text", "vitals.gm.value_text", "GM_PCT", "value_text", "", "text", BLANK (), "48.9%", 0.0 },
            { "P-FY25 vitals.gm.status", "vitals.gm.status", "GM_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.gm.rows", "vitals.gm.rows", "GM_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.opex.value_text", "vitals.opex.value_text", "OPEX_PCT", "value_text", "", "text", BLANK (), "19.7%", 0.0 },
            { "P-FY25 vitals.opex.status", "vitals.opex.status", "OPEX_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.opex.rows", "vitals.opex.rows", "OPEX_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.units.value_text", "vitals.units.value_text", "UNITS", "value_text", "", "text", BLANK (), "569,256,242", 0.0 },
            { "P-FY25 vitals.units.status", "vitals.units.status", "UNITS", "status", "", "status", BLANK (), "watch", 0.0 },
            { "P-FY25 vitals.units.rows", "vitals.units.rows", "UNITS", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.nrPerUnit.value_text", "vitals.nrPerUnit.value_text", "NR_PER_UNIT", "value_text", "", "text", BLANK (), "$8.04", 0.0 },
            { "P-FY25 vitals.nrPerUnit.status", "vitals.nrPerUnit.status", "NR_PER_UNIT", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "P-FY25 vitals.nrPerUnit.rows", "vitals.nrPerUnit.rows", "NR_PER_UNIT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.gtn.value_text", "vitals.gtn.value_text", "GTN_PCT", "value_text", "", "text", BLANK (), "21.3%", 0.0 },
            { "P-FY25 vitals.gtn.status", "vitals.gtn.status", "GTN_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.gtn.rows", "vitals.gtn.rows", "GTN_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.ap.value_text", "vitals.ap.value_text", "AP_PCT", "value_text", "", "text", BLANK (), "8.4%", 0.0 },
            { "P-FY25 vitals.ap.status", "vitals.ap.status", "AP_PCT", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "P-FY25 vitals.ap.rows", "vitals.ap.rows", "AP_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-FY25 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$4,575.4 m", 0.0 },
            { "P-FY25 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-FY25 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "P-FY25 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 4575428492.3836, "", 0.05 },
            { "P-FY25 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 896884746.7315, "", 0.05 },
            { "P-FY25 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 690335320.6931, "", 0.05 },
            { "P-FY25 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.4894785, "", 1e-06 },
            { "P-FY25 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.196797646, "", 1e-06 },
            { "P-FY25 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", 0.006279338, "", 1e-06 },
            { "P-FY25 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -5.816e-06, "", 1e-06 },
            { "P-FY25 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.063417027, "", 1e-06 },
            { "P-FY25 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 4575428492.3836, "", 0.05 },
            { "P-FY25 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 1.006279338, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-FY25 bridges (26 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-FY25 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 4546877113.5154, "", 0.05 },
            { "P-FY25 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "P-FY25 nr_bridge.VOL.value", "nr_bridge.VOL.value", "nr_bridge", "VOL", "value", "amount", -88696926.1478, "", 0.05 },
            { "P-FY25 nr_bridge.VOL.label", "nr_bridge.VOL.label", "nr_bridge", "VOL", "label", "text", BLANK (), "Volume", 0.0 },
            { "P-FY25 nr_bridge.PRICE.value", "nr_bridge.PRICE.value", "nr_bridge", "PRICE", "value", "amount", 21679871.9112, "", 0.05 },
            { "P-FY25 nr_bridge.PRICE.label", "nr_bridge.PRICE.label", "nr_bridge", "PRICE", "label", "text", BLANK (), "Price / mix", 0.0 },
            { "P-FY25 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 4479860059.2789, "", 0.05 },
            { "P-FY25 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "P-FY25 nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 95568433.1047, "", 0.05 },
            { "P-FY25 nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "P-FY25 nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 4575428492.3836, "", 0.05 },
            { "P-FY25 nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "P-FY25 profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 901010076.749, "", 0.05 },
            { "P-FY25 profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -32874671.1002, "", 0.05 },
            { "P-FY25 profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -8497849.0422, "", 0.05 },
            { "P-FY25 profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", 4065652.7552, "", 0.05 },
            { "P-FY25 profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 1888647.3369, "", 0.05 },
            { "P-FY25 profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 7833301.5639, "", 0.05 },
            { "P-FY25 profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 1707940.9788, "", 0.05 },
            { "P-FY25 profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 3645454.2485, "", 0.05 },
            { "P-FY25 profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -291375.2475, "", 0.05 },
            { "P-FY25 profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 18397568.4889, "", 0.05 },
            { "P-FY25 profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 896884746.7315, "", 0.05 },
            { "P-FY25 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -164715425.7597, "", 0.05 },
            { "P-FY25 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -41834000.2787, "", 0.05 },
            { "P-FY25 profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 690335320.6931, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-FY25 largest variances (filter none) (14 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-FY25 var.total_delta", "var.total_delta", "total_delta", "", "", "amount", -31263195.9079, "", 0.05 },
            { "P-FY25 var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 37.0, "", 0.0 },
            { "P-FY25 var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_P1 ADJ_2 ADJ_1 COR_P1 COR_P5 COR_P2 VSC_P1 VSC_P3", 0.0 },
            { "P-FY25 var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_1 ADJ_2 OOI_1 OOI_2", 0.0 },
            { "P-FY25 var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "vs PY", 0.0 },
            { "P-FY25 var.total_fx", "var.total_fx", "total_fx", "", "", "amount", 13993772.2841, "", 0.05 },
            { "P-FY25 var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "none", 0.0 },
            { "P-FY25 var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_P1 ADJ_2 ADJ_1 COR_P1 COR_P5 COR_P2 VSC_P1 VSC_P3 SM_P1 GTN_P3 COR_P3 COR_P4 VSC_P2 VSC_P4 GR_P2 DA_P1 GA_1 RD_P1 SM_P2 SM_P3 GTN_P1 COR_P7 GA_2 GA_4 GA_3 DA_P2 GTN_P2 GTN_P5 RD_P2 DA_P3 OOI_1 VSC_P5 SM_P4 OOI_3 COR_P6 GTN_P4 OOI_2", 0.0 },
            { "P-FY25 var.footer.comparison", "var.footer.comparison", "footer", "comparison", "", "text", BLANK (), "$721.6 m", 0.0 },
            { "P-FY25 var.footer.actual", "var.footer.actual", "footer", "actual", "", "text", BLANK (), "$690.3 m", 0.0 },
            { "P-FY25 var.footer.delta", "var.footer.delta", "footer", "delta", "", "text", BLANK (), "−$31.3 m", 0.0 },
            { "P-FY25 var.footer.delta_pct", "var.footer.delta_pct", "footer", "delta_pct", "", "text", BLANK (), "−4.3%", 0.0 },
            { "P-FY25 var.footer.py", "var.footer.py", "footer", "py", "", "text", BLANK (), "+$0.7 m", 0.0 },
            { "P-FY25 var.footer.fx", "var.footer.fx", "footer", "fx", "", "text", BLANK (), "+$14.0 m", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

