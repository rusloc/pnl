            { "P-FY25 prof.AP.cm_pct", "prof.AP.cm_pct", "prof", "AP", "cm_pct", "ratio", 0.391178295, "", 1e-06 },
            { "P-FY25 prof.AP.cm_delta_pp", "prof.AP.cm_delta_pp", "prof", "AP", "cm_delta_pp", "ratio", -0.001785366, "", 1e-06 },
