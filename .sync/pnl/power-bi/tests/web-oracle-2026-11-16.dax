            { "S-FY25-cmpPY nr_bridge.SVC_APP.value", "nr_bridge.SVC_APP.value", "nr_bridge", "SVC_APP", "value", "amount", 8218041.4536, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.SVC_APP.label", "nr_bridge.SVC_APP.label", "nr_bridge", "SVC_APP", "label", "text", BLANK (), "Apps, partners & ads", 0.0 },
            { "S-FY25-cmpPY nr_bridge.SVC_PS.value", "nr_bridge.SVC_PS.value", "nr_bridge", "SVC_PS", "value", "amount", 2606202.8694, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.SVC_PS.label", "nr_bridge.SVC_PS.label", "nr_bridge", "SVC_PS", "label", "text", BLANK (), "Professional services", 0.0 },
            { "S-FY25-cmpPY nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 656457258.1387, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "S-FY25-cmpPY nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 10903432.7046, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "S-FY25-cmpPY nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "S-FY25-cmpPY profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 56056238.2032, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", 80550397.9016, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -976380.4787, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", -2784654.2063, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", -6385431.6449, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", -16366519.9857, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", -18344601.8532, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", -10318506.9887, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", 25437.6203, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 1371393.6414, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 82827372.209, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -31069557.5935, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -3177743.146, "", 0.05 },
            { "S-FY25-cmpPY profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 48580071.4695, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
        ,TREATAS ( { "B" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-cmpPY largest variances (filter none) (14 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-cmpPY var.total_delta", "var.total_delta", "total_delta", "", "", "amount", 14160920.1464, "", 0.05 },
            { "S-FY25-cmpPY var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 32.0, "", 0.0 },
            { "S-FY25-cmpPY var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_S2 GR_S1 COR_S2 RD_S1 GR_S3 SM_S1 RD_S2 COR_S4", 0.0 },
            { "S-FY25-cmpPY var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_3 DA_S3 OOI_1 OOI_3", 0.0 },
            { "S-FY25-cmpPY var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-cmpPY var.total_fx", "var.total_fx", "total_fx", "", "", "amount", 766034.327, "", 0.05 },
            { "S-FY25-cmpPY var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "none", 0.0 },
            { "S-FY25-cmpPY var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_S2 GR_S1 COR_S2 RD_S1 GR_S3 SM_S1 RD_S2 COR_S4 COR_S1 SM_S3 COR_S3 GA_1 DA_S1 GTN_S1 DA_S3 RD_S3 GR_S4 ADJ_3 GA_2 SM_S2 COR_S5 VSC_S1 VSC_S3 GA_4 VSC_S2 GA_3 DA_S2 SM_S4 GTN_S3 GTN_S2 OOI_3 OOI_1", 0.0 },
            { "S-FY25-cmpPY var.footer.comparison", "var.footer.comparison", "footer", "comparison", "", "text", BLANK (), "$34.4 m", 0.0 },
            { "S-FY25-cmpPY var.footer.actual", "var.footer.actual", "footer", "actual", "", "text", BLANK (), "$48.6 m", 0.0 },
            { "S-FY25-cmpPY var.footer.delta", "var.footer.delta", "footer", "delta", "", "text", BLANK (), "+$14.2 m", 0.0 },
            { "S-FY25-cmpPY var.footer.delta_pct", "var.footer.delta_pct", "footer", "delta_pct", "", "text", BLANK (), "+41.1%", 0.0 },
            { "S-FY25-cmpPY var.footer.py", "var.footer.py", "footer", "py", "", "text", BLANK (), "−$1.6 m", 0.0 },
            { "S-FY25-cmpPY var.footer.fx", "var.footer.fx", "footer", "fx", "", "text", BLANK (), "+$0.8 m", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_a[choice_code] )
        ,TREATAS ( { "B" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-cmpPY profitability: region table, concentration, heatmap (53 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-cmpPY prof.basis", "prof.basis", "prof", "", "basis", "text", BLANK (), "CC", 0.0 },
            { "S-FY25-cmpPY prof.subtitle", "prof.subtitle", "prof", "", "subtitle", "text", BLANK (), "Constant currency (FY2025 budget rates) - USD m - vs Prior year", 0.0 },
            { "S-FY25-cmpPY prof.NA.nr", "prof.NA.nr", "prof", "NA", "nr", "amount", 357700784.64, "", 0.05 },
