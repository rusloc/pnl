// ---------------------------------------------------------------- O-S-FY25-cmpPY Vitals (46 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-cmpPY vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$667.4 m", 0.0 },
            { "S-FY25-cmpPY vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25-cmpPY vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Prior year | vs Budget", 0.0 },
            { "S-FY25-cmpPY vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$82.8 m", 0.0 },
