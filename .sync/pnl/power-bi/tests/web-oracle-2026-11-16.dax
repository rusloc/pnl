            { "P-RNG-2407-2506 stmt.RD.base", "stmt.RD.base", "RD", "base", "", "amount", -105293364.6468, "", 0.05 },
            { "P-RNG-2407-2506 stmt.RD.base_text", "stmt.RD.base_text", "RD", "base_text", "", "text", BLANK (), "−105.3", 0.0 },
            { "P-RNG-2407-2506 stmt.GA.base", "stmt.GA.base", "GA", "base", "", "amount", -230256654.9445, "", 0.05 },
            { "P-RNG-2407-2506 stmt.GA.base_text", "stmt.GA.base_text", "GA", "base_text", "", "text", BLANK (), "−230.3", 0.0 },
            { "P-RNG-2407-2506 stmt.OOI.base", "stmt.OOI.base", "OOI", "base", "", "amount", 8537737.0798, "", 0.05 },
            { "P-RNG-2407-2506 stmt.OOI.base_text", "stmt.OOI.base_text", "OOI", "base_text", "", "text", BLANK (), "8.5", 0.0 },
            { "P-RNG-2407-2506 stmt.EBITDA.base", "stmt.EBITDA.base", "EBITDA", "base", "", "amount", 861980469.7966, "", 0.05 },
            { "P-RNG-2407-2506 stmt.EBITDA.base_text", "stmt.EBITDA.base_text", "EBITDA", "base_text", "", "text", BLANK (), "862.0", 0.0 },
            { "P-RNG-2407-2506 stmt.EBITDA_PCT.base", "stmt.EBITDA_PCT.base", "EBITDA_PCT", "base", "", "ratio", 0.198359507, "", 1e-06 },
            { "P-RNG-2407-2506 stmt.EBITDA_PCT.base_text", "stmt.EBITDA_PCT.base_text", "EBITDA_PCT", "base_text", "", "text", BLANK (), "19.8%", 0.0 },
            { "P-RNG-2407-2506 stmt.DA.base", "stmt.DA.base", "DA", "base", "", "amount", -156439675.6923, "", 0.05 },
            { "P-RNG-2407-2506 stmt.DA.base_text", "stmt.DA.base_text", "DA", "base_text", "", "text", BLANK (), "−156.4", 0.0 },
            { "P-RNG-2407-2506 stmt.UOP.base", "stmt.UOP.base", "UOP", "base", "", "amount", 705540794.1043, "", 0.05 },
            { "P-RNG-2407-2506 stmt.UOP.base_text", "stmt.UOP.base_text", "UOP", "base_text", "", "text", BLANK (), "705.5", 0.0 },
            { "P-RNG-2407-2506 stmt.ADJ.base", "stmt.ADJ.base", "ADJ", "base", "", "amount", -26329906.2598, "", 0.05 },
            { "P-RNG-2407-2506 stmt.ADJ.base_text", "stmt.ADJ.base_text", "ADJ", "base_text", "", "text", BLANK (), "−26.3", 0.0 },
            { "P-RNG-2407-2506 stmt.OP.base", "stmt.OP.base", "OP", "base", "", "amount", 679210887.8445, "", 0.05 },
            { "P-RNG-2407-2506 stmt.OP.base_text", "stmt.OP.base_text", "OP", "base_text", "", "text", BLANK (), "679.2", 0.0 },
            { "P-RNG-2407-2506 stmt.OP_PCT.base", "stmt.OP_PCT.base", "OP_PCT", "base", "", "ratio", 0.156300452, "", 1e-06 },
            { "P-RNG-2407-2506 stmt.OP_PCT.base_text", "stmt.OP_PCT.base_text", "OP_PCT", "base_text", "", "text", BLANK (), "15.6%", 0.0 },
            { "P-RNG-2407-2506 stmt.INV.base", "stmt.INV.base", "INV", "base", "", "amount", 16977718.4532, "", 0.05 },
            { "P-RNG-2407-2506 stmt.INV.base_text", "stmt.INV.base_text", "INV", "base_text", "", "text", BLANK (), "17.0", 0.0 },
            { "P-RNG-2407-2506 stmt.PBFIT.base", "stmt.PBFIT.base", "PBFIT", "base", "", "amount", 696188606.2977, "", 0.05 },
            { "P-RNG-2407-2506 stmt.PBFIT.base_text", "stmt.PBFIT.base_text", "PBFIT", "base_text", "", "text", BLANK (), "696.2", 0.0 },
            { "P-RNG-2407-2506 stmt.FIN.base", "stmt.FIN.base", "FIN", "base", "", "amount", -52585024.8899, "", 0.05 },
            { "P-RNG-2407-2506 stmt.FIN.base_text", "stmt.FIN.base_text", "FIN", "base_text", "", "text", BLANK (), "−52.6", 0.0 },
            { "P-RNG-2407-2506 stmt.PBT.base", "stmt.PBT.base", "PBT", "base", "", "amount", 643603581.4078, "", 0.05 },
            { "P-RNG-2407-2506 stmt.PBT.base_text", "stmt.PBT.base_text", "PBT", "base_text", "", "text", BLANK (), "643.6", 0.0 },
            { "P-RNG-2407-2506 stmt.TAX.base", "stmt.TAX.base", "TAX", "base", "", "amount", -154464859.6787, "", 0.05 },
            { "P-RNG-2407-2506 stmt.TAX.base_text", "stmt.TAX.base_text", "TAX", "base_text", "", "text", BLANK (), "−154.5", 0.0 },
            { "P-RNG-2407-2506 stmt.ETR_PCT.base", "stmt.ETR_PCT.base", "ETR_PCT", "base", "", "ratio", 0.24, "", 1e-06 },
            { "P-RNG-2407-2506 stmt.ETR_PCT.base_text", "stmt.ETR_PCT.base_text", "ETR_PCT", "base_text", "", "text", BLANK (), "24.0%", 0.0 },
            { "P-RNG-2407-2506 stmt.NP.base", "stmt.NP.base", "NP", "base", "", "amount", 489138721.7291, "", 0.05 },
            { "P-RNG-2407-2506 stmt.NP.base_text", "stmt.NP.base_text", "NP", "base_text", "", "text", BLANK (), "489.1", 0.0 },
            { "P-RNG-2407-2506 stmt.NP_PCT.base", "stmt.NP_PCT.base", "NP_PCT", "base", "", "ratio", 0.112560921, "", 1e-06 },
            { "P-RNG-2407-2506 stmt.NP_PCT.base_text", "stmt.NP_PCT.base_text", "NP_PCT", "base_text", "", "text", BLANK (), "11.3%", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _codes = FILTER ( DISTINCT ( SELECTCOLUMNS ( _expected, "_c", [_k1] ) ), [_c] <> "row_count" )
        VAR _vals =
            ADDCOLUMNS (
                _codes
                ,"@ratio", INT ( CALCULATE ( [_PL Is Ratio], TREATAS ( { [_c] }, dim_pl_row[line_code] ) ) )
                ,"@mult", CALCULATE ( [_PL Cost Mult], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@base", CALCULATE ( [PL Base], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@pct", CALCULATE ( [PL % NR], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@ca", CALCULATE ( [PL Compare A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@da", CALCULATE ( [PL Δ A], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dap", CALCULATE ( [PL Δ A %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@cb", CALCULATE ( [PL Compare B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@db", CALCULATE ( [PL Δ B], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@dbp", CALCULATE ( [PL Δ B %], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fb", CALCULATE ( [PL FY Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fl", CALCULATE ( [PL FY LE], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
                ,"@fd", CALCULATE ( [PL Δ LE vs Budget], TREATAS ( { [_c] }, dim_pl_row[line_code] ) )
            )
        VAR _row_count =
            COUNTROWS ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ) )
                + COUNTROWS ( FILTER ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], dim_pl_row[account_label], "a", [PL Notes], "b", [PL Base], "c", [PL % NR], "d", [PL Compare A], "e", [PL Δ A], "f", [PL Δ A %], "g", [PL Bar A], "h", [PL Compare B], "i", [PL Δ B], "j", [PL Δ B %], "k", [PL FY Budget], "l", [PL FY LE], "m", [PL Δ LE vs Budget] ), dim_pl_row[account_label] <> "" ) )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "row_count"
                            ,_row_count
                            ,VAR _r = FILTER ( _vals, [_c] = _k1 )
                             RETURN
                                IF ( MAXX ( _r, [@ratio] ) = 1, MAXX ( _r, [@base] ), MAXX ( _r, [@base] ) * [_Units Divisor] * MAXX ( _r, [@mult] ) )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _r = FILTER ( _vals, [_c] = _k1 )
                        VAR _ratio = MAXX ( _r, [@ratio] ) = 1
                        VAR _base = MAXX ( _r, [@base] )
                        VAR _pct = MAXX ( _r, [@pct] )
                        VAR _ca = MAXX ( _r, [@ca] )
                        VAR _da = MAXX ( _r, [@da] )
                        VAR _dap = MAXX ( _r, [@dap] )
                        VAR _cb = MAXX ( _r, [@cb] )
                        VAR _db = MAXX ( _r, [@db] )
                        VAR _dbp = MAXX ( _r, [@dbp] )
                        VAR _fb = MAXX ( _r, [@fb] )
                        VAR _fl = MAXX ( _r, [@fl] )
                        VAR _fd = MAXX ( _r, [@fd] )
                        RETURN
                            SWITCH (
                                _k2
                                ,"base_text", IF ( _ratio, IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 3 ) = 0, "0.0%", FORMAT ( _base, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _base ), "", IF ( ROUND ( ABS ( _base ), 1 ) = 0, "0.0", FORMAT ( _base, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_a_text", IF ( _ratio, IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 3 ) = 0, "0.0%", FORMAT ( _ca, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _ca ), "", IF ( ROUND ( ABS ( _ca ), 1 ) = 0, "0.0", FORMAT ( _ca, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_a_text", IF ( _ratio, IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0 pp", FORMAT ( _da, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _da ), "", IF ( ROUND ( ABS ( _da ), 1 ) = 0, "0.0", FORMAT ( _da, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"cmp_b_text", IF ( _ratio, IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 3 ) = 0, "0.0%", FORMAT ( _cb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _cb ), "", IF ( ROUND ( ABS ( _cb ), 1 ) = 0, "0.0", FORMAT ( _cb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"d_b_text", IF ( _ratio, IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0 pp", FORMAT ( _db, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _db ), "", IF ( ROUND ( ABS ( _db ), 1 ) = 0, "0.0", FORMAT ( _db, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_bud_text", IF ( _ratio, IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 3 ) = 0, "0.0%", FORMAT ( _fb, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fb ), "", IF ( ROUND ( ABS ( _fb ), 1 ) = 0, "0.0", FORMAT ( _fb, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_le_text", IF ( _ratio, IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 3 ) = 0, "0.0%", FORMAT ( _fl, "0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( _fl ), "", IF ( ROUND ( ABS ( _fl ), 1 ) = 0, "0.0", FORMAT ( _fl, "#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"fy_d_text", IF ( _ratio, IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0 pp", FORMAT ( _fd, "+0.0"" pp"";−0.0"" pp"";0.0"" pp""" ) ) ), IF ( ISBLANK ( _fd ), "", IF ( ROUND ( ABS ( _fd ), 1 ) = 0, "0.0", FORMAT ( _fd, "+#,0.0;−#,0.0;0.0" ) ) ) )
                                ,"pct_nr_text", IF ( ISBLANK ( _pct ), "", IF ( ROUND ( ABS ( _pct ), 3 ) = 0, "0.0%", FORMAT ( _pct, "0.0%;−0.0%;0.0%" ) ) )
                                ,"d_a_pct_text", IF ( ISBLANK ( _dap ), "", IF ( _dap = 0, "n/a", IF ( ROUND ( ABS ( _dap ), 3 ) = 0, "0.0%", FORMAT ( _dap, "+0.0%;−0.0%;0.0%" ) ) ) )
                                ,"d_b_pct_text", IF ( ISBLANK ( _dbp ), "", IF ( _dbp = 0, "n/a", IF ( ROUND ( ABS ( _dbp ), 3 ) = 0, "0.0%", FORMAT ( _dbp, "+0.0%;−0.0%;0.0%" ) ) ) )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 6 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 6 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-RNG-2607-2612 header + control totals (11 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-RNG-2607-2612 ct.NR", "ct.NR", "NR", "", "", "amount", 213683295.8363, "", 0.01 },
            { "S-RNG-2607-2612 ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 27401448.2414, "", 0.01 },
            { "S-RNG-2607-2612 ct.OP", "ct.OP", "OP", "", "", "amount", 16694980.0815, "", 0.01 },
            { "S-RNG-2607-2612 ct.NP", "ct.NP", "NP", "", "", "amount", 13100421.5956, "", 0.01 },
            { "S-RNG-2607-2612 hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "Jul – Dec 2026", 0.0 },
            { "S-RNG-2607-2612 hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2026", 0.0 },
            { "S-RNG-2607-2612 hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jul – Sep 2026", 0.0 },
            { "S-RNG-2607-2612 hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Custom range", 0.0 },
            { "S-RNG-2607-2612 hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A) and Prior year (B)", 0.0 },
            { "S-RNG-2607-2612 hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "Cut-off", 0.0 },
            { "S-RNG-2607-2612 hdr.notice.Cut-off", "hdr.notice.Cut-off", "notice", "Cut-off", "", "text", BLANK (), "Actuals closed through Sep 2026: later months excluded; use Latest estimate for the full window", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 30 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

