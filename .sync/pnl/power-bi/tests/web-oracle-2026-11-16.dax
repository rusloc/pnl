VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _conc = SUMMARIZECOLUMNS ( dim_region[region_code], dim_conc_level[level_code], "@v", [Conc Share] )
        VAR _heat =
            SUMMARIZECOLUMNS (
                dim_region[region_code]
                ,dim_region[region_name]
                ,dim_line[line_code]
                ,dim_line[line_name]
                ,"@c", [_Heat NR Ratio]
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _prof =
                            SWITCH (
                                _k3
                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                ,"gm_pct", [Prof GM %]
                                ,"cm_pct", [Prof CM %]
                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                            )
                        RETURN
                            SWITCH (
                                _k1
                                ,"prof"
                                    ,IF (
                                        _k2 = "TOTAL"
                                        ,_prof
                                        ,CALCULATE (
                                            SWITCH (
                                                _k3
                                                ,"nr", [Prof Net Revenue] * [_Units Divisor]
                                                ,"nr_delta_pct", [Prof NR Δ % CC]
                                                ,"gm_pct", [Prof GM %]
                                                ,"cm_pct", [Prof CM %]
                                                ,"cm_delta_pp", [Prof CM Δ pp] / 100
                                                ,"ebitda", [Prof Adj EBITDA] * [_Units Divisor]
                                            )
                                            ,TREATAS ( { _k2 }, dim_region[region_code] )
                                        )
                                    )
                                ,"conc", MAXX ( FILTER ( _conc, dim_region[region_code] = _k2 && dim_conc_level[level_code] = _k3 ), [@v] )
                                ,"heat_gm", CALCULATE ( [_Heat Colour GM], TREATAS ( { _k2 }, dim_line[line_code] ) )
                                ,"heat"
                                    ,IF (
                                        _k3 = "colour"
                                        ,MAXX ( FILTER ( _heat, dim_region[region_code] = PATHITEM ( _k2, 1 ) && dim_line[line_code] = PATHITEM ( _k2, 2 ) ), [@c] )
                                        ,CALCULATE ( [Prof Net Revenue] * [_Units Divisor], TREATAS ( { ( PATHITEM ( _k2, 1 ), PATHITEM ( _k2, 2 ) ) }, dim_region[region_code], dim_line[line_code] ) )
                                    )
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k3 = "cm_status"
                            ,IF ( _k2 = "TOTAL", [_Prof CM Status], CALCULATE ( [_Prof CM Status], TREATAS ( { _k2 }, dim_region[region_code] ) ) )
                            ,SWITCH (
                                _k3
                                ,"basis", IF ( LEFT ( [Prof Subtitle CC], 17 ) = "Constant currency", "CC", "ACT" )
                                ,"subtitle", [Prof Subtitle CC]
                            )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
