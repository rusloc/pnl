            { "P-YTD26-vfD2C var.row.SM_P3.text", "var.row.SM_P3.text", "row", "SM_P3", "text", "text", BLANK (), "−$5.7 m | −$5.8 m | −$0.1 m | −1.3% | −$1.0 m | −$0.1 m | alloc.", 0.0 },
