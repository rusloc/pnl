// ---------------------------------------------------------------- O-P-RNG-2510-2609 bridges (26 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-RNG-2510-2609 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 4882704970.2844, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "P-RNG-2510-2609 nr_bridge.VOL.value", "nr_bridge.VOL.value", "nr_bridge", "VOL", "value", "amount", -103481246.6273, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.VOL.label", "nr_bridge.VOL.label", "nr_bridge", "VOL", "label", "text", BLANK (), "Volume", 0.0 },
            { "P-RNG-2510-2609 nr_bridge.PRICE.value", "nr_bridge.PRICE.value", "nr_bridge", "PRICE", "value", "amount", -23363885.1763, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.PRICE.label", "nr_bridge.PRICE.label", "nr_bridge", "PRICE", "label", "text", BLANK (), "Price / mix", 0.0 },
            { "P-RNG-2510-2609 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 4755859838.4808, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "P-RNG-2510-2609 nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", 78487932.1014, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "P-RNG-2510-2609 nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 4834347770.5823, "", 0.05 },
            { "P-RNG-2510-2609 nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "P-RNG-2510-2609 profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 969414757.2679, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -62571834.2145, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -20184990.2966, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", 4024719.2136, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 5956016.0209, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 29167821.9052, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 3151653.7242, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 6775416.7736, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -214126.6786, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", 15160778.3091, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 950680212.0248, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -174036519.7188, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -25524919.4612, "", 0.05 },
            { "P-RNG-2510-2609 profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 751118772.8448, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 21 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

