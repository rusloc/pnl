            { "P-RNG-2407-2506 vitals.nrPerUnit.status", "vitals.nrPerUnit.status", "NR_PER_UNIT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-RNG-2407-2506 vitals.nrPerUnit.rows", "vitals.nrPerUnit.rows", "NR_PER_UNIT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-RNG-2407-2506 vitals.gtn.value_text", "vitals.gtn.value_text", "GTN_PCT", "value_text", "", "text", BLANK (), "21.5%", 0.0 },
            { "P-RNG-2407-2506 vitals.gtn.status", "vitals.gtn.status", "GTN_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-RNG-2407-2506 vitals.gtn.rows", "vitals.gtn.rows", "GTN_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-RNG-2407-2506 vitals.ap.value_text", "vitals.ap.value_text", "AP_PCT", "value_text", "", "text", BLANK (), "8.4%", 0.0 },
            { "P-RNG-2407-2506 vitals.ap.status", "vitals.ap.status", "AP_PCT", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "P-RNG-2407-2506 vitals.ap.rows", "vitals.ap.rows", "AP_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "P-RNG-2407-2506 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$4,575.4 m", 0.0 },
            { "P-RNG-2407-2506 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "P-RNG-2407-2506 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "P-RNG-2407-2506 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 4345546544.6834, "", 0.05 },
            { "P-RNG-2407-2506 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 861980469.7966, "", 0.05 },
            { "P-RNG-2407-2506 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 679210887.8445, "", 0.05 },
            { "P-RNG-2407-2506 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.489805318, "", 1e-06 },
            { "P-RNG-2407-2506 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.19707798, "", 1e-06 },
            { "P-RNG-2407-2506 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", -0.007944058, "", 1e-06 },
            { "P-RNG-2407-2506 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", 1.3115e-05, "", 1e-06 },
            { "P-RNG-2407-2506 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 1.298269199, "", 1e-06 },
            { "P-RNG-2407-2506 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 4575428492.3836, "", 0.05 },
            { "P-RNG-2407-2506 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 1.006279338, "", 1e-06 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 6 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 6 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-RNG-2407-2506 bridges (26 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-RNG-2407-2506 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 4380344253.0466, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "P-RNG-2407-2506 nr_bridge.VOL.value", "nr_bridge.VOL.value", "nr_bridge", "VOL", "value", "amount", -35996039.4156, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.VOL.label", "nr_bridge.VOL.label", "nr_bridge", "VOL", "label", "text", BLANK (), "Volume", 0.0 },
            { "P-RNG-2407-2506 nr_bridge.PRICE.value", "nr_bridge.PRICE.value", "nr_bridge", "PRICE", "value", "amount", 9047445.2662, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.PRICE.label", "nr_bridge.PRICE.label", "nr_bridge", "PRICE", "label", "text", BLANK (), "Price / mix", 0.0 },
            { "P-RNG-2407-2506 nr_bridge.CC_SUB.value", "nr_bridge.CC_SUB.value", "nr_bridge", "CC_SUB", "value", "amount", 4353395658.8972, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.CC_SUB.label", "nr_bridge.CC_SUB.label", "nr_bridge", "CC_SUB", "label", "text", BLANK (), "Constant-currency NR", 0.0 },
            { "P-RNG-2407-2506 nr_bridge.FX.value", "nr_bridge.FX.value", "nr_bridge", "FX", "value", "amount", -7849114.2138, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.FX.label", "nr_bridge.FX.label", "nr_bridge", "FX", "label", "text", BLANK (), "FX", 0.0 },
            { "P-RNG-2407-2506 nr_bridge.END.value", "nr_bridge.END.value", "nr_bridge", "END", "value", "amount", 4345546544.6834, "", 0.05 },
            { "P-RNG-2407-2506 nr_bridge.END.label", "nr_bridge.END.label", "nr_bridge", "END", "label", "text", BLANK (), "Actual NR", 0.0 },
            { "P-RNG-2407-2506 profit_bridge.BUD.value", "profit_bridge.BUD.value", "profit_bridge", "BUD", "value", "amount", 872282958.334, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.VOL.value", "profit_bridge.VOL.value", "profit_bridge", "VOL", "value", "amount", -13206879.0363, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.GM_RATE.value", "profit_bridge.GM_RATE.value", "profit_bridge", "GM_RATE", "value", "amount", -2753459.6076, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.GM_MIX.value", "profit_bridge.GM_MIX.value", "profit_bridge", "GM_MIX", "value", "amount", 1422188.2739, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.VSC.value", "profit_bridge.VSC.value", "profit_bridge", "VSC", "value", "amount", 555275.1222, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.SM.value", "profit_bridge.SM.value", "profit_bridge", "SM", "value", "amount", 3101926.7324, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.RD.value", "profit_bridge.RD.value", "profit_bridge", "RD", "value", "amount", 686822.1363, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.GA.value", "profit_bridge.GA.value", "profit_bridge", "GA", "value", "amount", 1485202.3737, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.OOI.value", "profit_bridge.OOI.value", "profit_bridge", "OOI", "value", "amount", -206222.8695, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.FX.value", "profit_bridge.FX.value", "profit_bridge", "FX", "value", "amount", -1387341.6626, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.ACT.value", "profit_bridge.ACT.value", "profit_bridge", "ACT", "value", "amount", 861980469.7966, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.DA.value", "profit_bridge.DA.value", "profit_bridge", "DA", "value", "amount", -156439675.6923, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.ADJ.value", "profit_bridge.ADJ.value", "profit_bridge", "ADJ", "value", "amount", -26329906.2598, "", 0.05 },
            { "P-RNG-2407-2506 profit_bridge.OP.value", "profit_bridge.OP.value", "profit_bridge", "OP", "value", "amount", 679210887.8445, "", 0.05 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        IF (
                            _k1 = "nr_bridge"
                            ,SWITCH (
                                _k2
                                ,"END", [Net Revenue]
                                ,"CC_SUB"
                                    ,SUMX (
                                        FILTER ( ALL ( dim_bridge_step[entity_view_code], dim_bridge_step[step_code], dim_bridge_step[step_sort] ), dim_bridge_step[entity_view_code] = _entity && dim_bridge_step[step_sort] < 80 && dim_bridge_step[step_code] <> "START" )
                                        ,CALCULATE ( [_Bridge Value] )
                                    )
                                        + CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, "START" ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                                ,CALCULATE ( [_Bridge Value], TREATAS ( { ( _entity, _k2 ) }, dim_bridge_step[entity_view_code], dim_bridge_step[step_code] ) )
                            )
                            ,SWITCH (
                                _k2
                                ,"ACT", [Adjusted EBITDA]
                                ,"OP", [Operating Profit]
                                ,CALCULATE ( [_Profit Step], TREATAS ( { _k2 }, dim_profit_step[step_code] ) )
                            )
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        // the chart: dim_bridge_axis[axis_label] on the axis, rows vanish where Bridge Axis Delta is blank; the label of this step
                        CONCATENATEX (
                            FILTER (
                                ADDCOLUMNS (
                                    SUMMARIZECOLUMNS ( dim_bridge_axis[axis_label], "@d", [Bridge Axis Delta] )
                                    ,"@codes", CALCULATE ( CONCATENATEX ( FILTER ( dim_bridge_axis, dim_bridge_axis[entity_view_code] = _entity ), dim_bridge_axis[step_code], "," ) )
                                )
                                ,PATHCONTAINS ( SUBSTITUTE ( [@codes], ",", "|" ), _k2 )
                            )
                            ,dim_bridge_axis[axis_label]
                            ," / "
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 6 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 6 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-RNG-2407-2506 largest variances (filter none) (14 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-RNG-2407-2506 var.total_delta", "var.total_delta", "total_delta", "", "", "amount", -19655693.2925, "", 0.05 },
            { "P-RNG-2407-2506 var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 36.0, "", 0.0 },
            { "P-RNG-2407-2506 var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_P1 ADJ_1 COR_P2 GTN_P1 COR_P1 GTN_P2 SM_P1 GTN_P4", 0.0 },
            { "P-RNG-2407-2506 var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_1 OOI_1 OOI_2", 0.0 },
            { "P-RNG-2407-2506 var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "vs PY", 0.0 },
            { "P-RNG-2407-2506 var.total_fx", "var.total_fx", "total_fx", "", "", "amount", -1523616.0896, "", 0.05 },
            { "P-RNG-2407-2506 var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "none", 0.0 },
            { "P-RNG-2407-2506 var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_P1 ADJ_1 COR_P2 GTN_P1 COR_P1 GTN_P2 SM_P1 GTN_P4 COR_P4 COR_P3 COR_P5 SM_P4 GA_1 GTN_P5 DA_P1 RD_P1 COR_P6 COR_P7 SM_P2 VSC_P2 VSC_P5 GA_2 GTN_P3 SM_P3 GA_4 GA_3 VSC_P3 DA_P2 RD_P2 DA_P3 OOI_1 VSC_P1 VSC_P4 GR_P2 OOI_3 OOI_2", 0.0 },
            { "P-RNG-2407-2506 var.footer.comparison", "var.footer.comparison", "footer", "comparison", "", "text", BLANK (), "$698.9 m", 0.0 },
            { "P-RNG-2407-2506 var.footer.actual", "var.footer.actual", "footer", "actual", "", "text", BLANK (), "$679.2 m", 0.0 },
            { "P-RNG-2407-2506 var.footer.delta", "var.footer.delta", "footer", "delta", "", "text", BLANK (), "−$19.7 m", 0.0 },
            { "P-RNG-2407-2506 var.footer.delta_pct", "var.footer.delta_pct", "footer", "delta_pct", "", "text", BLANK (), "−2.8%", 0.0 },
            { "P-RNG-2407-2506 var.footer.py", "var.footer.py", "footer", "py", "", "text", BLANK (), "+$359.8 m", 0.0 },
            { "P-RNG-2407-2506 var.footer.fx", "var.footer.fx", "footer", "fx", "", "text", BLANK (), "−$1.5 m", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 6 }, param_period[month_number] )
        ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { 6 }, param_range_start[range_start_index] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
