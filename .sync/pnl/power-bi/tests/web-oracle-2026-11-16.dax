VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-noB nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 658221037.2736, "", 0.05 },
            { "S-FY25-noB nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
            { "S-FY25-noB nr_bridge.SVC_SUB.value", "nr_bridge.SVC_SUB.value", "nr_bridge", "SVC_SUB", "value", "amount", -4647223.1596, "", 0.05 },
