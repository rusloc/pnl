            { "S-FY25 trend.TOTAL.growth.2025-11", "trend.TOTAL.growth.2025-11", "growth", "TOTAL", "22", "ratio", 0.282685491, "", 1e-06 },
            { "S-FY25 trend.TOTAL.growth.2025-12", "trend.TOTAL.growth.2025-12", "growth", "TOTAL", "23", "ratio", 0.29426409, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-01", "trend.TOTAL.cm.2025-01", "cm", "TOTAL", "12", "ratio", 0.52968623, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-02", "trend.TOTAL.cm.2025-02", "cm", "TOTAL", "13", "ratio", 0.527117532, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-03", "trend.TOTAL.cm.2025-03", "cm", "TOTAL", "14", "ratio", 0.51984562, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-04", "trend.TOTAL.cm.2025-04", "cm", "TOTAL", "15", "ratio", 0.520748257, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-05", "trend.TOTAL.cm.2025-05", "cm", "TOTAL", "16", "ratio", 0.51739046, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-06", "trend.TOTAL.cm.2025-06", "cm", "TOTAL", "17", "ratio", 0.516385237, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-07", "trend.TOTAL.cm.2025-07", "cm", "TOTAL", "18", "ratio", 0.520352136, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-08", "trend.TOTAL.cm.2025-08", "cm", "TOTAL", "19", "ratio", 0.518427989, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-09", "trend.TOTAL.cm.2025-09", "cm", "TOTAL", "20", "ratio", 0.516144364, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-10", "trend.TOTAL.cm.2025-10", "cm", "TOTAL", "21", "ratio", 0.508500357, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-11", "trend.TOTAL.cm.2025-11", "cm", "TOTAL", "22", "ratio", 0.490380342, "", 1e-06 },
            { "S-FY25 trend.TOTAL.cm.2025-12", "trend.TOTAL.cm.2025-12", "cm", "TOTAL", "23", "ratio", 0.489955484, "", 1e-06 },
            { "S-FY25 trend.TOTAL.growth_last", "trend.TOTAL.growth_last", "last", "TOTAL", "growth_last", "text", BLANK (), "+29.4%", 0.0 },
            { "S-FY25 trend.TOTAL.cm_last", "trend.TOTAL.cm_last", "last", "TOTAL", "cm_last", "text", BLANK (), "49.0%", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    CALCULATE (
                        SWITCH ( _k1, "growth", [Trend Growth], "cm", [Trend CM %] )
                        ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                        ,TREATAS ( { IF ( _k1 IN { "growth", "cm" }, VALUE ( _k3 ), -99 ) }, dim_month[month_index] )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"months"
                            ,CONCATENATEX (
                                FILTER (
                                    ALL ( dim_month[month_index], dim_month[month_name], dim_month[fiscal_year] )
                                    ,NOT ISBLANK ( CALCULATE ( [Trend CM %], TREATAS ( { "TOTAL" }, dim_trend_row[trend_row_code] ) ) )
                                )
                                ,dim_month[month_name] & " " & dim_month[fiscal_year]
                                ," | "
                                ,dim_month[month_index], ASC
                            )
                        ,"note", COALESCE ( [Trend Note], "none" )
                        ,"last"
                            ,CALCULATE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS (
                                            ALL ( dim_month[month_index] )
                                            ,"@v", IF ( _k3 = "growth_last", [Trend Growth Last], [Trend CM % Last] )
                                        )
                                        ,NOT ISBLANK ( [@v] )
                                    )
                                    ,IF ( _k3 = "growth_last", IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "+0.0%;−0.0%;0.0%" ) ) ), IF ( ISBLANK ( [@v] ), "", IF ( ROUND ( ABS ( [@v] ), 3 ) = 0, "0.0%", FORMAT ( [@v], "0.0%;−0.0%;0.0%" ) ) ) )
                                    ," / "
                                )
                                ,TREATAS ( { _k2 }, dim_trend_row[trend_row_code] )
                            )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-YTD26 header + control totals (10 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-YTD26 ct.NR", "ct.NR", "NR", "", "", "amount", 595967635.7345, "", 0.01 },
            { "S-YTD26 ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 77783157.7535, "", 0.01 },
            { "S-YTD26 ct.OP", "ct.OP", "OP", "", "", "amount", 46509620.4731, "", 0.01 },
            { "S-YTD26 ct.NP", "ct.NP", "NP", "", "", "amount", 36494875.3205, "", 0.01 },
            { "S-YTD26 hdr.window", "hdr.window", "window", "", "", "text", BLANK (), "YTD Sep 2026", 0.0 },
            { "S-YTD26 hdr.filter.Fiscal year", "hdr.filter.Fiscal year", "filter", "Fiscal year", "", "text", BLANK (), "2026", 0.0 },
            { "S-YTD26 hdr.filter.Period", "hdr.filter.Period", "filter", "Period", "", "text", BLANK (), "Showing Jan – Sep 2026 - year to date", 0.0 },
            { "S-YTD26 hdr.filter.Time view", "hdr.filter.Time view", "filter", "Time view", "", "text", BLANK (), "Year to date", 0.0 },
            { "S-YTD26 hdr.filter.Versions", "hdr.filter.Versions", "filter", "Versions", "", "text", BLANK (), "Actual vs Budget (A) and Prior year (B)", 0.0 },
            { "S-YTD26 hdr.notices", "hdr.notices", "notices", "", "", "text", BLANK (), "none", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-YTD26 Vitals (46 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-YTD26 vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$596.0 m", 0.0 },
            { "S-YTD26 vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "watch", 0.0 },
            { "S-YTD26 vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$77.8 m", 0.0 },
            { "S-YTD26 vitals.ebitda.status", "vitals.ebitda.status", "EBITDA", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-YTD26 vitals.ebitda.rows", "vitals.ebitda.rows", "EBITDA", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.op.value_text", "vitals.op.value_text", "OP", "value_text", "", "text", BLANK (), "$46.5 m", 0.0 },
            { "S-YTD26 vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-YTD26 vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.gm.value_text", "vitals.gm.value_text", "GM_PCT", "value_text", "", "text", BLANK (), "55.8%", 0.0 },
            { "S-YTD26 vitals.gm.status", "vitals.gm.status", "GM_PCT", "status", "", "status", BLANK (), "watch", 0.0 },
            { "S-YTD26 vitals.gm.rows", "vitals.gm.rows", "GM_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.opex.value_text", "vitals.opex.value_text", "OPEX_PCT", "value_text", "", "text", BLANK (), "38.0%", 0.0 },
            { "S-YTD26 vitals.opex.status", "vitals.opex.status", "OPEX_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-YTD26 vitals.opex.rows", "vitals.opex.rows", "OPEX_PCT", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.gmv.value_text", "vitals.gmv.value_text", "GMV", "value_text", "", "text", BLANK (), "$11,285.0 m", 0.0 },
            { "S-YTD26 vitals.gmv.status", "vitals.gmv.status", "GMV", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-YTD26 vitals.gmv.rows", "vitals.gmv.rows", "GMV", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.merchants.value_text", "vitals.merchants.value_text", "MERCHANTS", "value_text", "", "text", BLANK (), "138,726", 0.0 },
            { "S-YTD26 vitals.merchants.status", "vitals.merchants.status", "MERCHANTS", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-YTD26 vitals.merchants.rows", "vitals.merchants.rows", "MERCHANTS", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.arr.value_text", "vitals.arr.value_text", "ARR", "value_text", "", "text", BLANK (), "$320.0 m", 0.0 },
            { "S-YTD26 vitals.arr.status", "vitals.arr.status", "ARR", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-YTD26 vitals.arr.rows", "vitals.arr.rows", "ARR", "rows", "", "text", BLANK (), "vs Budget | vs Prior year", 0.0 },
            { "S-YTD26 vitals.mix.value_text", "vitals.mix.value_text", "MIX", "value_text", "", "text", BLANK (), "37.5% / 50.3%", 0.0 },
            { "S-YTD26 vitals.mix.status", "vitals.mix.status", "MIX", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "S-YTD26 vitals.mix.rows", "vitals.mix.rows", "MIX", "rows", "", "text", BLANK (), "Sub / Pay vs PY", 0.0 },
            { "S-YTD26 vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$861.0 m", 0.0 },
            { "S-YTD26 vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "watch", 0.0 },
            { "S-YTD26 vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "S-YTD26 vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 595967635.7345, "", 0.05 },
            { "S-YTD26 vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 77783157.7535, "", 0.05 },
            { "S-YTD26 vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 46509620.4731, "", 0.05 },
            { "S-YTD26 vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.55784876, "", 1e-06 },
            { "S-YTD26 vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.379999247, "", 1e-06 },
            { "S-YTD26 vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", -0.010280891, "", 1e-06 },
            { "S-YTD26 vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.00029213, "", 1e-06 },
            { "S-YTD26 vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.273892831, "", 1e-06 },
            { "S-YTD26 vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 860955932.1889, "", 0.05 },
            { "S-YTD26 vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 0.987644418, "", 1e-06 },
            { "S-YTD26 vitals.mix.sub_share", "vitals.mix.sub_share", "MIX", "sub_share", "", "ratio", 0.374799485, "", 1e-06 },
            { "S-YTD26 vitals.mix.pay_share", "vitals.mix.pay_share", "MIX", "pay_share", "", "ratio", 0.502748323, "", 1e-06 },
            { "S-YTD26 vitals.gmv.value", "vitals.gmv.value", "GMV", "value", "", "amount", 11284983967.4023, "", 0.05 },
            { "S-YTD26 vitals.merchants.value", "vitals.merchants.value", "MERCHANTS", "value", "", "count", 138726.0, "", 0.0 },
            { "S-YTD26 vitals.arr.value", "vitals.arr.value", "ARR", "value", "", "amount", 320001855.6507, "", 0.05 },
            { "S-YTD26 vitals.merchants.gmv_per_merchant_text", "vitals.merchants.gmv_per_merchant_text", "MERCHANTS", "gmv_per_merchant_text", "", "text", BLANK (), "$81.3 k", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-YTD26 bridges (30 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-YTD26 nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 602158360.3305, "", 0.05 },
            { "S-YTD26 nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Budget NR", 0.0 },
