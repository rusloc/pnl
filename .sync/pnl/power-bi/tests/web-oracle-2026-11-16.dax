            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GA_2.text", "var.row.GA_2.text", "row", "GA_2", "text", "text", BLANK (), "−$0.2 m | −$0.2 m | $0.0 m | n.m. | −$0.1 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.SM_S4.delta", "var.row.SM_S4.delta", "row", "SM_S4", "delta", "amount", -775.5847, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.SM_S4.text", "var.row.SM_S4.text", "row", "SM_S4", "text", "text", BLANK (), "−$0.1 m | −$0.1 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GA_4.delta", "var.row.GA_4.delta", "row", "GA_4", "delta", "amount", -605.046, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GA_4.text", "var.row.GA_4.text", "row", "GA_4", "text", "text", BLANK (), "−$0.2 m | −$0.2 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GA_3.delta", "var.row.GA_3.delta", "row", "GA_3", "delta", "amount", -484.036, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GA_3.text", "var.row.GA_3.text", "row", "GA_3", "text", "text", BLANK (), "−$0.1 m | −$0.1 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.DA_S2.delta", "var.row.DA_S2.delta", "row", "DA_S2", "delta", "amount", -484.036, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.DA_S2.text", "var.row.DA_S2.text", "row", "DA_S2", "text", "text", BLANK (), "−$0.1 m | −$0.1 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.DA_S3.delta", "var.row.DA_S3.delta", "row", "DA_S3", "delta", "amount", -484.036, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.DA_S3.text", "var.row.DA_S3.text", "row", "DA_S3", "text", "text", BLANK (), "−$0.1 m | −$0.1 m | $0.0 m | n.m. | −$0.1 m | $0.0 m | alloc.", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.COR_S3.delta", "var.row.COR_S3.delta", "row", "COR_S3", "delta", "amount", -447.3747, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.COR_S3.text", "var.row.COR_S3.text", "row", "COR_S3", "text", "text", BLANK (), "−$0.3 m | −$0.3 m | $0.0 m | n.m. | −$0.1 m | $0.0 m", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GTN_S2.delta", "var.row.GTN_S2.delta", "row", "GTN_S2", "delta", "amount", -62.7093, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.GTN_S2.text", "var.row.GTN_S2.text", "row", "GTN_S2", "text", "text", BLANK (), "$0.0 m | $0.0 m | $0.0 m | n.m. | $0.0 m | $0.0 m", 0.0 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.OOI_3.delta", "var.row.OOI_3.delta", "row", "OOI_3", "delta", "amount", 40.3364, "", 0.05 },
            { "S-YTD26-vfEU-SALES-SUB-ENT var.row.OOI_3.text", "var.row.OOI_3.text", "row", "OOI_3", "text", "text", BLANK (), "$0.0 m | $0.0 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { "EU" }, dim_region[region_code] )
        ,TREATAS ( { "SALES" }, dim_channel[channel_code] )
        ,TREATAS ( { "SUB" }, dim_line[line_code] )
        ,TREATAS ( { "ENT" }, dim_segment[segment_code] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-S-FY25-vfUK header + control totals (4 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-vfUK ct.NR", "ct.NR", "NR", "", "", "amount", 667360690.8433, "", 0.01 },
            { "S-FY25-vfUK ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 82827372.209, "", 0.01 },
            { "S-FY25-vfUK ct.OP", "ct.OP", "OP", "", "", "amount", 48580071.4695, "", 0.01 },
            { "S-FY25-vfUK ct.NP", "ct.NP", "NP", "", "", "amount", 38144183.9088, "", 0.01 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

