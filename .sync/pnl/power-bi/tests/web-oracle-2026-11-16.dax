            { "P-RNG-2407-2506 conc.AP.CM", "conc.AP.CM", "conc", "AP", "CM", "ratio", 0.156113725, "", 1e-06 },
            { "P-RNG-2407-2506 conc.UK.CM", "conc.UK.CM", "conc", "UK", "CM", "ratio", 0.121153939, "", 1e-06 },
            { "P-RNG-2407-2506 conc.NA.EBITDA", "conc.NA.EBITDA", "conc", "NA", "EBITDA", "ratio", 0.454060656, "", 1e-06 },
            { "P-RNG-2407-2506 conc.EU.EBITDA", "conc.EU.EBITDA", "conc", "EU", "EBITDA", "ratio", 0.268706158, "", 1e-06 },
            { "P-RNG-2407-2506 conc.AP.EBITDA", "conc.AP.EBITDA", "conc", "AP", "EBITDA", "ratio", 0.156060217, "", 1e-06 },
            { "P-RNG-2407-2506 conc.UK.EBITDA", "conc.UK.EBITDA", "conc", "UK", "EBITDA", "ratio", 0.121172968, "", 1e-06 },
            { "P-RNG-2407-2506 heat.HOME.gm", "heat.HOME.gm", "heat_gm", "HOME", "gm", "ratio", 0.509715072, "", 1e-06 },
            { "P-RNG-2407-2506 heat.PERS.gm", "heat.PERS.gm", "heat_gm", "PERS", "gm", "ratio", 0.589501874, "", 1e-06 },
            { "P-RNG-2407-2506 heat.KITC.gm", "heat.KITC.gm", "heat_gm", "KITC", "gm", "ratio", 0.469388176, "", 1e-06 },
            { "P-RNG-2407-2506 heat.ELEC.gm", "heat.ELEC.gm", "heat_gm", "ELEC", "gm", "ratio", 0.362905047, "", 1e-06 },
