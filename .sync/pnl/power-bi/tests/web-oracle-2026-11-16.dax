// ---------------------------------------------------------------- O-S-FY25-noB Vitals (46 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-noB vitals.nr.value_text", "vitals.nr.value_text", "NR", "value_text", "", "text", BLANK (), "$667.4 m", 0.0 },
            { "S-FY25-noB vitals.nr.status", "vitals.nr.status", "NR", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25-noB vitals.nr.rows", "vitals.nr.rows", "NR", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.ebitda.value_text", "vitals.ebitda.value_text", "EBITDA", "value_text", "", "text", BLANK (), "$82.8 m", 0.0 },
            { "S-FY25-noB vitals.ebitda.status", "vitals.ebitda.status", "EBITDA", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25-noB vitals.ebitda.rows", "vitals.ebitda.rows", "EBITDA", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.op.value_text", "vitals.op.value_text", "OP", "value_text", "", "text", BLANK (), "$48.6 m", 0.0 },
            { "S-FY25-noB vitals.op.status", "vitals.op.status", "OP", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-FY25-noB vitals.op.rows", "vitals.op.rows", "OP", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.gm.value_text", "vitals.gm.value_text", "GM_PCT", "value_text", "", "text", BLANK (), "55.9%", 0.0 },
            { "S-FY25-noB vitals.gm.status", "vitals.gm.status", "GM_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25-noB vitals.gm.rows", "vitals.gm.rows", "GM_PCT", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.opex.value_text", "vitals.opex.value_text", "OPEX_PCT", "value_text", "", "text", BLANK (), "38.9%", 0.0 },
            { "S-FY25-noB vitals.opex.status", "vitals.opex.status", "OPEX_PCT", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25-noB vitals.opex.rows", "vitals.opex.rows", "OPEX_PCT", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.gmv.value_text", "vitals.gmv.value_text", "GMV", "value_text", "", "text", BLANK (), "$12,470.9 m", 0.0 },
            { "S-FY25-noB vitals.gmv.status", "vitals.gmv.status", "GMV", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25-noB vitals.gmv.rows", "vitals.gmv.rows", "GMV", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.merchants.value_text", "vitals.merchants.value_text", "MERCHANTS", "value_text", "", "text", BLANK (), "124,291", 0.0 },
            { "S-FY25-noB vitals.merchants.status", "vitals.merchants.status", "MERCHANTS", "status", "", "status", BLANK (), "off", 0.0 },
            { "S-FY25-noB vitals.merchants.rows", "vitals.merchants.rows", "MERCHANTS", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.arr.value_text", "vitals.arr.value_text", "ARR", "value_text", "", "text", BLANK (), "$279.2 m", 0.0 },
            { "S-FY25-noB vitals.arr.status", "vitals.arr.status", "ARR", "status", "", "status", BLANK (), "ontrack", 0.0 },
            { "S-FY25-noB vitals.arr.rows", "vitals.arr.rows", "ARR", "rows", "", "text", BLANK (), "vs Budget", 0.0 },
            { "S-FY25-noB vitals.mix.value_text", "vitals.mix.value_text", "MIX", "value_text", "", "text", BLANK (), "37.1% / 49.9%", 0.0 },
            { "S-FY25-noB vitals.mix.status", "vitals.mix.status", "MIX", "status", "", "status", BLANK (), "neutral", 0.0 },
            { "S-FY25-noB vitals.mix.rows", "vitals.mix.rows", "MIX", "rows", "", "text", BLANK (), "Sub / Pay vs PY", 0.0 },
            { "S-FY25-noB vitals.fy.value_text", "vitals.fy.value_text", "FY_OUTLOOK", "value_text", "", "text", BLANK (), "$667.4 m", 0.0 },
            { "S-FY25-noB vitals.fy.status", "vitals.fy.status", "FY_OUTLOOK", "status", "", "status", BLANK (), "ahead", 0.0 },
            { "S-FY25-noB vitals.fy.rows", "vitals.fy.rows", "FY_OUTLOOK", "rows", "", "text", BLANK (), "vs FY Budget | EBITDA vs FY Bud", 0.0 },
            { "S-FY25-noB vitals.nr.value", "vitals.nr.value", "NR", "value", "", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25-noB vitals.ebitda.value", "vitals.ebitda.value", "EBITDA", "value", "", "amount", 82827372.209, "", 0.05 },
            { "S-FY25-noB vitals.op.value", "vitals.op.value", "OP", "value", "", "amount", 48580071.4695, "", 0.05 },
            { "S-FY25-noB vitals.gm.value", "vitals.gm.value", "GM_PCT", "value", "", "ratio", 0.558516421, "", 1e-06 },
            { "S-FY25-noB vitals.opex.value", "vitals.opex.value", "OPEX_PCT", "value", "", "ratio", 0.389467893, "", 1e-06 },
            { "S-FY25-noB vitals.nr.d_bud_pct", "vitals.nr.d_bud_pct", "NR", "d_bud_pct", "", "ratio", 0.013885387, "", 1e-06 },
            { "S-FY25-noB vitals.opex.d_bud_pp", "vitals.opex.d_bud_pp", "OPEX_PCT", "d_bud_pp", "", "ratio", -0.000313636, "", 1e-06 },
            { "S-FY25-noB vitals.nr.organic", "vitals.nr.organic", "NR", "organic", "", "ratio", 0.278333002, "", 1e-06 },
            { "S-FY25-noB vitals.fy.value", "vitals.fy.value", "FY_OUTLOOK", "value", "", "amount", 667360690.8433, "", 0.05 },
            { "S-FY25-noB vitals.fy.attainment", "vitals.fy.attainment", "FY_OUTLOOK", "attainment", "", "ratio", 1.013885387, "", 1e-06 },
            { "S-FY25-noB vitals.mix.sub_share", "vitals.mix.sub_share", "MIX", "sub_share", "", "ratio", 0.3705199, "", 1e-06 },
            { "S-FY25-noB vitals.mix.pay_share", "vitals.mix.pay_share", "MIX", "pay_share", "", "ratio", 0.499309507, "", 1e-06 },
            { "S-FY25-noB vitals.gmv.value", "vitals.gmv.value", "GMV", "value", "", "amount", 12470944535.3555, "", 0.05 },
            { "S-FY25-noB vitals.merchants.value", "vitals.merchants.value", "MERCHANTS", "value", "", "count", 124291.0, "", 0.0 },
            { "S-FY25-noB vitals.arr.value", "vitals.arr.value", "ARR", "value", "", "amount", 279201235.6196, "", 0.05 },
            { "S-FY25-noB vitals.merchants.gmv_per_merchant_text", "vitals.merchants.gmv_per_merchant_text", "MERCHANTS", "gmv_per_merchant_text", "", "text", BLANK (), "$100.3 k", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "S"
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _kpi = TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] )
                        VAR _v = CALCULATE ( [_KPI Value], _kpi )
                        VAR _b =
                            CALCULATE (
                                [_KPI Value]
                                ,_kpi
                                ,TREATAS ( { "CMP_A" }, param_eval[eval_code] )
                                ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                            )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value", _v
                                ,"organic", [KPI Organic Growth]
                                ,"attainment", [KPI FY Attainment]
                                ,"sub_share", [KPI Subscription Share]
                                ,"pay_share", [KPI Payments Share]
                                ,"d_bud_pct", DIVIDE ( _v - _b, ABS ( _b ) )
                                ,"d_bud_pp", _v - _b
                            )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        VAR _p = CALCULATE ( [_Vitals Parts], TREATAS ( { ( _entity, _k1 ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) )
                        RETURN
                            SWITCH (
                                _k2
                                ,"value_text", PATHITEM ( _p, 1 )
                                ,"status", PATHITEM ( _p, 10 )
                                ,"rows"
                                    ,PATHITEM ( _p, 2 ) & IF ( PATHITEM ( _p, 2 ) <> "" && PATHITEM ( _p, 6 ) <> "", " | " ) & PATHITEM ( _p, 6 )
                                ,"gmv_per_merchant_text"
                                    ,SUBSTITUTE ( CALCULATE ( [KPI Info Sub], TREATAS ( { ( _entity, "MERCHANTS" ) }, dim_kpi[entity_view_code], dim_kpi[kpi_code] ) ), "GMV per merchant: ", "" )
                            )
            )
        RETURN
            _rows
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 12 }, param_period[month_number] )
        ,TREATAS ( { "FY" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "NONE" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

