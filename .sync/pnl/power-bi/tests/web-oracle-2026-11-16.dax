            { "P-RNG-2510-2609 stmt.EBITDA_PCT.base", "stmt.EBITDA_PCT.base", "EBITDA_PCT", "base", "", "ratio", 0.196651184, "", 1e-06 },
            { "P-RNG-2510-2609 stmt.EBITDA_PCT.base_text", "stmt.EBITDA_PCT.base_text", "EBITDA_PCT", "base_text", "", "text", BLANK (), "19.7%", 0.0 },
            { "P-RNG-2510-2609 stmt.DA.base", "stmt.DA.base", "DA", "base", "", "amount", -174036519.7188, "", 0.05 },
