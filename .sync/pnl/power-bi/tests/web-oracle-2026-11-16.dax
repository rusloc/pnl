// ---------------------------------------------------------------- O-S-FY25-cmpPY bridges (30 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "S-FY25-cmpPY nr_bridge.START.value", "nr_bridge.START.value", "nr_bridge", "START", "value", "amount", 513706576.9559, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.START.label", "nr_bridge.START.label", "nr_bridge", "START", "label", "text", BLANK (), "Prior year NR", 0.0 },
            { "S-FY25-cmpPY nr_bridge.SVC_SUB.value", "nr_bridge.SVC_SUB.value", "nr_bridge", "SVC_SUB", "value", "amount", 46387957.4559, "", 0.05 },
            { "S-FY25-cmpPY nr_bridge.SVC_SUB.label", "nr_bridge.SVC_SUB.label", "nr_bridge", "SVC_SUB", "label", "text", BLANK (), "Platform subscriptions", 0.0 },
            { "S-FY25-cmpPY nr_bridge.SVC_PAY.value", "nr_bridge.SVC_PAY.value", "nr_bridge", "SVC_PAY", "value", "amount", 85538479.4039, "", 0.05 },
