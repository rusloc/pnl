            { "P-YTD26-vfHOME var.row.VSC_P4.text", "var.row.VSC_P4.text", "row", "VSC_P4", "text", "text", BLANK (), "−$6.1 m | −$6.1 m | −$0.1 m | −1.3% | −$1.0 m | −$0.1 m", 0.0 },
            { "P-YTD26-vfHOME var.row.GR_P2.delta", "var.row.GR_P2.delta", "row", "GR_P2", "delta", "amount", 68800.4318, "", 0.05 },
            { "P-YTD26-vfHOME var.row.GR_P2.text", "var.row.GR_P2.text", "row", "GR_P2", "text", "text", BLANK (), "$5.1 m | $5.1 m | +$0.1 m | +1.4% | +$0.9 m | $0.0 m", 0.0 },
            { "P-YTD26-vfHOME var.row.OOI_3.delta", "var.row.OOI_3.delta", "row", "OOI_3", "delta", "amount", -36254.8157, "", 0.05 },
            { "P-YTD26-vfHOME var.row.OOI_3.text", "var.row.OOI_3.text", "row", "OOI_3", "text", "text", BLANK (), "$1.9 m | $1.9 m | $0.0 m | n.m. | +$0.1 m | $0.0 m | alloc.", 0.0 },
            { "P-YTD26-vfHOME var.row.OOI_1.delta", "var.row.OOI_1.delta", "row", "OOI_1", "delta", "amount", 17295.95, "", 0.05 },
            { "P-YTD26-vfHOME var.row.OOI_1.text", "var.row.OOI_1.text", "row", "OOI_1", "text", "text", BLANK (), "$0.0 m | $0.0 m | $0.0 m | n.m. | +$0.1 m | $0.0 m | alloc.", 0.0 },
            { "P-YTD26-vfHOME var.row.OOI_2.delta", "var.row.OOI_2.delta", "row", "OOI_2", "delta", "amount", -8648.5823, "", 0.05 },
            { "P-YTD26-vfHOME var.row.OOI_2.text", "var.row.OOI_2.text", "row", "OOI_2", "text", "text", BLANK (), "$0.0 m | $0.0 m | $0.0 m | n.m. | $0.0 m | $0.0 m | alloc.", 0.0 }
        }
    )
VAR _model =
    CALCULATETABLE (
        VAR _entity = "P"
        VAR _visual =
            // the table visual: grouped like an_var_table (account label + block label), visual filter LV Show = 1
            FILTER (
                SUMMARIZECOLUMNS (
                    dim_pl_row[account_label]
                    ,dim_pl_row[line_label]
                    ,dim_pl_row[account_code]
                    ,dim_pl_row[account_sort]
                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                    ,"@show", [LV Show]
                    ,"@abs", [LV Rank Key]
                    ,"@d", [LV Δ]
                    ,"@fx", [LV FX]
                    ,"@pct", [LV Δ % Text]
                    ,"@txt",
                        [LV Comparison Text] & " | " & [LV Base Text] & " | " & [LV Δ Text] & " | " & [LV Δ % Text] & " | "
                            & COALESCE ( [LV Δ B Text], "n/a" ) & " | " & [LV FX Text] & IF ( NOT ISBLANK ( [LV Alloc Tag] ), " | " & [LV Alloc Tag] )
                )
                ,[@show] = 1
            )
        VAR _rows =
            ADDCOLUMNS (
                _expected
                ,"@num",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"total_delta", [Operating Profit] - CALCULATE ( [Bridge Comparison Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                            ,"leaf_count", COUNTROWS ( _visual )
                            ,"total_fx", SUMX ( _visual, [@fx] ) * [_Units Divisor]
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@d] ) * [_Units Divisor]
                        )
                ,"@txt",
                    VAR _k1 = [_k1]
                    VAR _k2 = [_k2]
                    VAR _k3 = [_k3]
                    RETURN
                        SWITCH (
                            _k1
                            ,"top8_codes", CONCATENATEX ( TOPN ( 8, _visual, [@abs], DESC ), dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"rank_codes", CONCATENATEX ( _visual, dim_pl_row[account_code], " ", [@abs], DESC )
                            ,"nm_codes", CONCATENATEX ( FILTER ( _visual, [@pct] = "n.m." ), dim_pl_row[account_code], " ", dim_pl_row[account_code], ASC )
                            ,"py_column", [Var Compare B Label]
                            ,"filter_text", COALESCE ( [LV Filter Text], "none" )
                            ,"footer"
                                ,CALCULATE (
                                    SWITCH (
                                        _k2
                                        ,"comparison", [LV Comparison Text]
                                        ,"actual", [LV Base Text]
                                        ,"delta", [LV Δ Text]
                                        ,"delta_pct", [LV Δ % Text]
                                        ,"py", COALESCE ( [LV Δ B Text], "n/a" )
                                        ,"fx", [LV FX Text]
                                    )
                                    ,TREATAS ( { "input_block" }, dim_pl_row[row_type] )
                                    ,FILTER ( ALL ( dim_pl_row[line_code] ), NOT dim_pl_row[line_code] IN { "INV", "FIN", "TAX" } )
                                )
                            ,"row", MAXX ( FILTER ( _visual, dim_pl_row[account_code] = _k2 ), [@txt] )
                        )
            )
        RETURN
            _rows
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
        ,TREATAS ( { "HOME" }, dim_line[line_code] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26-vfPREM header + control totals (4 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-YTD26-vfPREM ct.NR", "ct.NR", "NR", "", "", "amount", 3398521942.6604, "", 0.01 },
            { "P-YTD26-vfPREM ct.EBITDA", "ct.EBITDA", "EBITDA", "", "", "amount", 682594931.6447, "", 0.01 },
            { "P-YTD26-vfPREM ct.OP", "ct.OP", "OP", "", "", "amount", 550227316.2603, "", 0.01 },
            { "P-YTD26-vfPREM ct.NP", "ct.NP", "NP", "", "", "amount", 396244971.8623, "", 0.01 }
        }
    )
VAR _model =
    CALCULATETABLE (
        ADDCOLUMNS (
            _expected
            ,"@num",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"NR", CALCULATE ( [Base Amount], TREATAS ( { "NR" }, dim_pl_row[line_code] ) )
                        ,"EBITDA", CALCULATE ( [Base Amount], TREATAS ( { "EBITDA" }, dim_pl_row[line_code] ) )
                        ,"OP", CALCULATE ( [Base Amount], TREATAS ( { "OP" }, dim_pl_row[line_code] ) )
                        ,"NP", CALCULATE ( [Base Amount], TREATAS ( { "NP" }, dim_pl_row[line_code] ) )
                    )
            ,"@txt",
                VAR _k1 = [_k1]
                VAR _k2 = [_k2]
                VAR _k3 = [_k3]
                RETURN
                    SWITCH (
                        _k1
                        ,"window"
                            ,VAR _h = [PL Hdr Base] RETURN LEFT ( _h, SEARCH ( " - ", _h, 1, LEN ( _h ) + 1 ) - 1 )
                        ,"filter"
                            ,CALCULATE ( [Filter Value], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                        ,"notices"
                            ,COALESCE (
                                CONCATENATEX (
                                    FILTER (
                                        ADDCOLUMNS ( FILTER ( ALL ( dim_filter_row ), LEFT ( dim_filter_row[filter_code], 2 ) = "N_" ), "@t", [_Notice Row] )
                                        ,NOT ISBLANK ( [@t] )
                                    )
                                    ,dim_filter_row[filter_label]
                                    ," | "
                                    ,dim_filter_row[filter_sort], ASC
                                )
                                ,"none"
                            )
                        ,"notice"
                            ,CALCULATE ( [_Notice Row], TREATAS ( { _k2 }, dim_filter_row[filter_label] ) )
                    )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
        ,TREATAS ( { "NEG" }, param_cost_sign[cost_sign_code] )
        ,TREATAS ( { "On" }, param_hide_empty[hide_empty] )
    )
RETURN
    SELECTCOLUMNS (
        _model
        ,"_test", "Oracle"
        ,"_id", [_id]
        ,"_kind", [_kind]
        ,"_model", IF ( [_kind] IN { "text", "status" }, [@txt], FORMAT ( [@num], "General Number" ) )
        ,"_expected", IF ( [_kind] IN { "text", "status" }, [_txt], FORMAT ( [_num], "General Number" ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_kind] IN { "text", "status" }
                    ,[@txt] = [_txt]
                ,ISBLANK ( [_num] )
                    ,ISBLANK ( [@num] )
                ,NOT ISBLANK ( [@num] ) && ABS ( [@num] - [_num] ) <= [_tol] + ABS ( [_num] ) * 1e-9
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- O-P-YTD26-vfPREM largest variances (filter segment=PREM) (87 rows)
VAR _expected =
    DATATABLE (
        "_id", STRING, "_metric", STRING, "_k1", STRING, "_k2", STRING, "_k3", STRING,
        "_kind", STRING, "_num", DOUBLE, "_txt", STRING, "_tol", DOUBLE,
        {
            { "P-YTD26-vfPREM var.total_delta", "var.total_delta", "total_delta", "", "", "amount", -6610284.52, "", 0.05 },
            { "P-YTD26-vfPREM var.leaf_count", "var.leaf_count", "leaf_count", "", "", "count", 37.0, "", 0.0 },
            { "P-YTD26-vfPREM var.top8_codes", "var.top8_codes", "top8_codes", "", "", "text", BLANK (), "GR_P1 SM_P1 COR_P2 COR_P5 COR_P1 GTN_P1 GTN_P2 ADJ_3", 0.0 },
            { "P-YTD26-vfPREM var.nm_codes", "var.nm_codes", "nm_codes", "", "", "text", BLANK (), "ADJ_1 ADJ_3 OOI_1 OOI_2 OOI_3", 0.0 },
            { "P-YTD26-vfPREM var.py_column", "var.py_column", "py_column", "", "", "text", BLANK (), "vs PY", 0.0 },
            { "P-YTD26-vfPREM var.filter_text", "var.filter_text", "filter_text", "", "", "text", BLANK (), "Premium", 0.0 },
            { "P-YTD26-vfPREM var.rank_codes", "var.rank_codes", "rank_codes", "", "", "text", BLANK (), "GR_P1 SM_P1 COR_P2 COR_P5 COR_P1 GTN_P1 GTN_P2 ADJ_3 COR_P7 COR_P4 ADJ_1 GTN_P4 COR_P3 SM_P4 GA_1 DA_P1 RD_P1 GTN_P5 COR_P6 SM_P2 VSC_P2 VSC_P5 VSC_P1 GA_2 SM_P3 GA_4 GA_3 DA_P2 RD_P2 DA_P3 VSC_P4 GR_P2 GTN_P3 OOI_3 OOI_1 VSC_P3 OOI_2", 0.0 },
