            { "S-RNG-2603-2609 stmt.OPEX.base", "stmt.OPEX.base", "OPEX", "base", "", "amount", -181128984.0887, "", 0.05 },
            { "S-RNG-2603-2609 stmt.OPEX.base_text", "stmt.OPEX.base_text", "OPEX", "base_text", "", "text", BLANK (), "−181.1", 0.0 },
