RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "R-08"
        ,"_id", [_id]
        ,"_check", [_check]
        ,"_model", IF ( [_expected_text] <> "", [_model_text], [_model] )
        ,"_expected", IF ( [_expected_text] <> "", [_expected_text], IF ( [_expect_blank], BLANK (), [_expected] ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_expect_blank]
                    ,ISBLANK ( [_model] ) && ISBLANK ( [_model_text] )
                ,[_expected_text] <> ""
                    ,[_model_text] = [_expected_text]
                ,NOT ISBLANK ( [_model] ) && ABS ( [_model] - [_expected] ) <= [_tolerance]
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- R-15 phase 2 (layout): header / notice / statement texts, display switches, custom range, variance filter, trend rows
// Default view unless the row says otherwise. Texts compare exactly; P2-01 compares the prefix (the refresh stamp moves).
VAR _rows =
    UNION (
        ROW ( "_id", "P2-00", "_check", "anchor", "_result", "", "_expected", "" )
        ,ROW (
            "_id", "P2-01"
            ,"_check", "Hdr Status (08 §4.5; refresh stamp is local time, not UTC)"
            ,"_result", CALCULATE (
                    [Hdr Status]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) & ""
            ,"_expected", "Consumer Products - Management reporting - Closed through Sep 2026 - Refreshed "
        )
        ,ROW (
            "_id", "P2-02"
            ,"_check", "Notice Count, default view: no notice"
            ,"_result", IF ( ISBLANK ( CALCULATE (
                    [Notice Count]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) ), "(blank)", "not blank" )
            ,"_expected", "(blank)"
        )
        ,ROW (
            "_id", "P2-03"
            ,"_check", "Period Summary, default (08 §4.5)"
            ,"_result", CALCULATE (
                    [Period Summary]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) & ""
            ,"_expected", "Showing Jan – Sep 2026 - year to date"
        )
        ,ROW (
            "_id", "P2-04"
            ,"_check", "Statement group titles, default"
            ,"_result", CALCULATE (
                    [PL Group Titles]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) & ""
            ,"_expected", "YTD Sep 2026 - Actual   |   Compare A: vs Budget   |   Compare B: vs Prior year   |   Full year 2026"
        )
        ,ROW (
            "_id", "P2-05"
            ,"_check", "Statement line header"
            ,"_result", CALCULATE (
                    [PL Line Header]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) & ""
            ,"_expected", "Line - USD m"
        )
        ,ROW (
            "_id", "P2-06"
            ,"_check", "Custom range Oct 2025 - Sep 2026: statement title (08 §6)"
            ,"_result", CALCULATE (
                    [PL Hdr Base]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { 21 }, param_range_start[range_start_index] )
                ) & ""
            ,"_expected", "Oct 2025 – Sep 2026 - Actual"
        )
        ,ROW (
            "_id", "P2-07"
            ,"_check", "Custom range Oct 2025 - Sep 2026 = LTM Sep 2026 (net revenue)"
            ,"_result", IF ( CALCULATE (
                    CALCULATE ( [Net Revenue], TREATAS ( { "RANGE" }, param_time_view[time_view_code] ), TREATAS ( { 21 }, param_range_start[range_start_index] ) ) = CALCULATE ( [Net Revenue], TREATAS ( { "LTM" }, param_time_view[time_view_code] ) )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "LTM" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-08"
            ,"_check", "Custom range start after the end swaps (Sep 2026 .. Mar 2026 = Mar - Sep 2026; no suffix as the web, oracle 2026-11-16)"
            ,"_result", CALCULATE (
                    [Period Summary]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 3 }, param_period[month_number] )
                    ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { 32 }, param_range_start[range_start_index] )
                ) & ""
            ,"_expected", "Showing Mar – Sep 2026"
        )
        ,ROW (
            "_id", "P2-09"
            ,"_check", "Custom range Jul 2024 - Jun 2025, Compare B = PY: notice (08 §6)"
            ,"_result", CALCULATE (
                    CALCULATE ( [_Notice Row], TREATAS ( { "N_PY" }, dim_filter_row[filter_code] ) )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2025 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 6 }, param_period[month_number] )
                    ,TREATAS ( { "RANGE" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { 6 }, param_range_start[range_start_index] )
                ) & ""
            ,"_expected", "Prior year n/a before Jan 2024: it covers 6 of the range's 12 months"
        )
        ,ROW (
            "_id", "P2-10"
            ,"_check", "Costs shown as positives: GTN line flips sign, delta does not"
            ,"_result", IF ( CALCULATE (
                    CALCULATE ( [PL Base], TREATAS ( { "POS" }, param_cost_sign[cost_sign_code] ) ) = - [PL Base] && CALCULATE ( [PL Δ A], TREATAS ( { "POS" }, param_cost_sign[cost_sign_code] ) ) = [PL Δ A] && [PL Base] < 0
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { "GTN" }, dim_pl_row[row_key] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-11"
            ,"_check", "Tags off: the EBITDA line note drops MPM"
            ,"_result", IF ( CALCULATE (
                    NOT CONTAINSSTRING ( CALCULATE ( [PL Notes] & "", TREATAS ( { "Off" }, param_show_tags[show_tags] ) ), "MPM" ) && CONTAINSSTRING ( [PL Notes] & "", "MPM" )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { "EBITDA" }, dim_pl_row[row_key] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-12"
            ,"_check", "Hide empty Off: every in-scope Commerce Cloud leaf shows (T-16)"
            ,"_result", IF ( CALCULATE (
                    COUNTROWS ( FILTER ( CALCULATETABLE ( SUMMARIZECOLUMNS ( dim_pl_row[line_display], dim_pl_row[account_label], dim_pl_row[account_code], "@v", [PL Base] ), TREATAS ( { "Off" }, param_hide_empty[hide_empty] ) ), dim_pl_row[account_code] <> "" ) ) = COUNTROWS ( FILTER ( dim_pl_row, dim_pl_row[account_code] <> "" && LOOKUPVALUE ( dim_account[entity_scope], dim_account[account_code], dim_pl_row[account_code] ) IN { "S", "BOTH" } ) )
                    ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-13"
            ,"_check", "Variance filter text: North America + a channel"
            ,"_result", CALCULATE (
                    [LV Filter Text]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { "NA" }, dim_region[region_code] )
                    ,TREATAS ( { "GRO" }, dim_channel[channel_code] )
                ) & ""
            ,"_expected", "North America · Grocery & mass retail"
        )
        ,ROW (
            "_id", "P2-14"
            ,"_check", "Variance filter count: region + slice = 2"
            ,"_result", IF ( CALCULATE (
                    [LV Filter Count] = 2
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { "NA" }, dim_region[region_code] )
                    ,TREATAS ( { "GRO" }, dim_channel[channel_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-15"
            ,"_check", "Variance empty-state text blank at the default view"
            ,"_result", IF ( ISBLANK ( CALCULATE (
                    [LV Empty Text]
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ) ), "(blank)", "not blank" )
            ,"_expected", "(blank)"
        )
        ,ROW (
            "_id", "P2-16"
            ,"_check", "Trend row Company = Prof Trend Growth, Sep 2026"
            ,"_result", IF ( CALCULATE (
                    CALCULATE ( [Trend Growth], TREATAS ( { "TOTAL" }, dim_trend_row[trend_row_code] ), TREATAS ( { 32 }, dim_month[month_index] ) ) = CALCULATE ( [Prof Trend Growth], TREATAS ( { 32 }, dim_month[month_index] ) )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-17"
            ,"_check", "Trend row North America = Prof Trend Growth on region NA, Sep 2026"
            ,"_result", IF ( CALCULATE (
                    CALCULATE ( [Trend Growth], TREATAS ( { "NA" }, dim_trend_row[trend_row_code] ), TREATAS ( { 32 }, dim_month[month_index] ) ) = CALCULATE ( [Prof Trend Growth], TREATAS ( { 32 }, dim_month[month_index] ), TREATAS ( { "NA" }, dim_region[region_code] ) )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-18"
            ,"_check", "Statement columns field parameter: 13 entries"
            ,"_result", IF ( CALCULATE (
                    COUNTROWS ( param_statement_columns ) = 13
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-19"
            ,"_check", "±15% bar of GTN = Δ % A clamped"
            ,"_result", IF ( CALCULATE (
                    [PL Bar A] = MAX ( -0.15, MIN ( 0.15, [PL Δ A %] ) ) && NOT ISBLANK ( [PL Bar A] )
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                    ,TREATAS ( { "GTN" }, dim_pl_row[row_key] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
        ,ROW (
            "_id", "P2-20"
            ,"_check", "Measures in an error state: none"
            ,"_result", IF ( CALCULATE (
                    COUNTROWS ( FILTER ( INFO.MEASURES (), [State] <> 1 ) ) + 0 = 0
                    ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
                    ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
                    ,TREATAS ( { 9 }, param_period[month_number] )
                    ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
                    ,TREATAS ( { "A" }, param_base_version[choice_code] )
                    ,TREATAS ( { "B" }, param_compare_a[choice_code] )
                    ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
                    ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
                    ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
                ), "TRUE", "FALSE" )
            ,"_expected", "TRUE"
        )
    )
RETURN
    SELECTCOLUMNS (
        FILTER ( _rows, [_id] <> "P2-00" )
        ,"_test", "R-15"
        ,"_id", [_id]
        ,"_check", [_check]
        ,"_result", [_result]
        ,"_expected", [_expected]
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_id] = "P2-01"
                    ,LEFT ( [_result], LEN ( "Consumer Products - Management reporting - Closed through Sep 2026 - Refreshed " ) ) = "Consumer Products - Management reporting - Closed through Sep 2026 - Refreshed "
                ,[_id] = "P2-02"
                    ,[_result] = "(blank)"
                ,[_id] = "P2-03"
                    ,[_result] = "Showing Jan – Sep 2026 - year to date"
                ,[_id] = "P2-04"
                    ,[_result] = "YTD Sep 2026 - Actual   |   Compare A: vs Budget   |   Compare B: vs Prior year   |   Full year 2026"
                ,[_id] = "P2-05"
                    ,[_result] = "Line - USD m"
                ,[_id] = "P2-06"
                    ,[_result] = "Oct 2025 – Sep 2026 - Actual"
                ,[_id] = "P2-07"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-08"
                    ,[_result] = "Showing Mar – Sep 2026"
                ,[_id] = "P2-09"
                    ,[_result] = "Prior year n/a before Jan 2024: it covers 6 of the range's 12 months"
                ,[_id] = "P2-10"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-11"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-12"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-13"
                    ,[_result] = "North America · Grocery & mass retail"
                ,[_id] = "P2-14"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-15"
                    ,[_result] = "(blank)"
                ,[_id] = "P2-16"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-17"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-18"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-19"
                    ,[_result] = "TRUE"
                ,[_id] = "P2-20"
                    ,[_result] = "TRUE"
                ,FALSE ()
            )
    )
ORDER BY [_id]

EVALUATE
// ---------------------------------------------------------------- R-16 bridge data labels (08 §4.3a / §4.3b Label column; spec 05 §4.2), static formats
// USER 2026-11-16 (speed): the bars label with fixed formats on their visual calculations (USD millions). This block applies the
// same format strings (copies of an_nr_chart / an_pb_chart visual.json) to the bar values as the chart computes them; default view.
VAR _fmt_level   = "$#,0.0"" m"";−$#,0.0"" m"";$0.0"" m"""
VAR _fmt_up      = "+$#,0.0"" m"""
VAR _fmt_down    = "−$#,0.0"" m"""
VAR _p_nr        =
    CALCULATETABLE (
        FILTER (
            ADDCOLUMNS (
                VALUES ( dim_bridge_axis[axis_label] )
                ,"@label", dim_bridge_axis[axis_label]
                ,"@sort", CALCULATE ( MAX ( dim_bridge_axis[axis_sort] ) )
                ,"@d", [Bridge Axis Delta]
                ,"@t", [Bridge Axis Is Total]
            )
            ,NOT ISBLANK ( [@t] )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
VAR _p_pr        =
    CALCULATETABLE (
        FILTER (
            ADDCOLUMNS (
                VALUES ( dim_profit_axis[axis_label] )
                ,"@label", dim_profit_axis[axis_label]
                ,"@sort", CALCULATE ( MAX ( dim_profit_axis[axis_sort] ) )
                ,"@d", [Profit Axis Delta]
                ,"@t", [Profit Axis Is Total]
            )
            ,NOT ISBLANK ( [@t] )
        )
        ,TREATAS ( { "P" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
VAR _s_nr        =
    CALCULATETABLE (
        FILTER (
            ADDCOLUMNS (
                VALUES ( dim_bridge_axis[axis_label] )
                ,"@label", dim_bridge_axis[axis_label]
                ,"@sort", CALCULATE ( MAX ( dim_bridge_axis[axis_sort] ) )
                ,"@d", [Bridge Axis Delta]
                ,"@t", [Bridge Axis Is Total]
            )
            ,NOT ISBLANK ( [@t] )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
VAR _s_pr        =
    CALCULATETABLE (
        FILTER (
            ADDCOLUMNS (
                VALUES ( dim_profit_axis[axis_label] )
                ,"@label", dim_profit_axis[axis_label]
                ,"@sort", CALCULATE ( MAX ( dim_profit_axis[axis_sort] ) )
                ,"@d", [Profit Axis Delta]
                ,"@t", [Profit Axis Is Total]
            )
            ,NOT ISBLANK ( [@t] )
        )
        ,TREATAS ( { "S" }, param_entity_view[entity_view_code] )
        ,TREATAS ( { 2026 }, param_fiscal_year[fiscal_year] )
        ,TREATAS ( { 9 }, param_period[month_number] )
        ,TREATAS ( { "YTD" }, param_time_view[time_view_code] )
        ,TREATAS ( { "A" }, param_base_version[choice_code] )
        ,TREATAS ( { "B" }, param_compare_a[choice_code] )
        ,TREATAS ( { "PY" }, param_compare_b[choice_code] )
        ,TREATAS ( { "USD" }, param_reporting_currency[currency_code] )
        ,TREATAS ( { "ACT" }, param_fx_basis[fx_basis_code] )
        ,TREATAS ( { "M" }, param_units[units_code] )
    )
VAR _expected     =
    DATATABLE (
        "_id", STRING
        ,"_cut", STRING
        ,"_label", STRING
        ,"_expected", STRING
        ,{
             { "BL-01", "P_NR", "Budget NR", "$3,464.8 m" }
            ,{ "BL-02", "P_NR", "Volume", "−$65.0 m" }
            ,{ "BL-03", "P_NR", "Price / mix", "−$30.8 m" }
            ,{ "BL-04", "P_NR", "Constant-currency NR", "$3,369.0 m" }
            ,{ "BL-05", "P_NR", "FX", "+$29.5 m" }
            ,{ "BL-06", "P_NR", "Actual NR", "$3,398.5 m" }
            ,{ "BL-07", "P_PR", "Budget Adj. EBITDA", "$701.0 m" }
            ,{ "BL-08", "P_PR", "Revenue volume", "−$47.7 m" }
            ,{ "BL-09", "P_PR", "GM rate", "−$16.7 m" }
            ,{ "BL-10", "P_PR", "GM mix", "+$2.8 m" }
            ,{ "BL-11", "P_PR", "Variable selling", "+$4.4 m" }
            ,{ "BL-12", "P_PR", "S&M", "+$25.5 m" }
            ,{ "BL-13", "P_PR", "R&D", "+$2.4 m" }
            ,{ "BL-14", "P_PR", "G&A", "+$5.1 m" }
            ,{ "BL-15", "P_PR", "Other operating", "−$0.2 m" }
            ,{ "BL-16", "P_PR", "FX", "+$5.9 m" }
            ,{ "BL-17", "P_PR", "Adj. EBITDA", "$682.6 m" }
            ,{ "BL-18", "P_PR", "D&A", "−$122.3 m" }
            ,{ "BL-19", "P_PR", "Adjusting items", "−$10.0 m" }
            ,{ "BL-20", "P_PR", "Operating profit", "$550.2 m" }
            ,{ "BL-21", "S_NR", "Budget NR", "$602.2 m" }
            ,{ "BL-22", "S_NR", "Platform subscriptions", "−$8.0 m" }
            ,{ "BL-23", "S_NR", "Payments", "+$0.5 m" }
            ,{ "BL-24", "S_NR", "Apps, partners & ads", "−$1.0 m" }
            ,{ "BL-25", "S_NR", "Professional services", "−$2.1 m" }
            ,{ "BL-26", "S_NR", "Constant-currency NR", "$591.6 m" }
            ,{ "BL-27", "S_NR", "FX", "+$4.3 m" }
            ,{ "BL-28", "S_NR", "Actual NR", "$596.0 m" }
            ,{ "BL-29", "S_PR", "Budget Adj. EBITDA", "$82.6 m" }
            ,{ "BL-30", "S_PR", "Revenue volume", "−$5.9 m" }
            ,{ "BL-31", "S_PR", "GM rate", "−$1.4 m" }
            ,{ "BL-32", "S_PR", "GM mix", "−$1.4 m" }
            ,{ "BL-33", "S_PR", "Variable selling", "−$0.9 m" }
            ,{ "BL-34", "S_PR", "S&M", "+$1.5 m" }
            ,{ "BL-35", "S_PR", "R&D", "+$1.8 m" }
            ,{ "BL-36", "S_PR", "G&A", "+$0.9 m" }
            ,{ "BL-37", "S_PR", "Other operating", "+$0.1 m" }
            ,{ "BL-38", "S_PR", "FX", "+$0.6 m" }
            ,{ "BL-39", "S_PR", "Adj. EBITDA", "$77.8 m" }
            ,{ "BL-40", "S_PR", "D&A", "−$29.9 m" }
            ,{ "BL-41", "S_PR", "Adjusting items", "−$1.4 m" }
            ,{ "BL-42", "S_PR", "Operating profit", "$46.5 m" }
        }
    )
VAR _rows         =
    ADDCOLUMNS (
        _expected
        ,"_result",
            VAR _label        = [_label]
            RETURN
                SWITCH (
                    [_cut]
                ,"P_NR",
                    VAR _row          = FILTER ( _p_nr, [@label] = _label )
                    VAR _sort         = MAXX ( _row, [@sort] )
                    VAR _d            = MAXX ( _row, [@d] )
                    VAR _t            = MAXX ( _row, [@t] )
                    VAR _run          = SUMX ( FILTER ( _p_nr, [@sort] <= _sort ), [@d] )
                    RETURN
                        SWITCH (
                            TRUE ()
                            ,_t = 1
                                ,FORMAT ( _run, _fmt_level )
                            ,_d > 0
                                ,FORMAT ( _d, _fmt_up )
                            ,_d < 0
                                ,FORMAT ( - _d, _fmt_down )
                        )
                ,"P_PR",
                    VAR _row          = FILTER ( _p_pr, [@label] = _label )
                    VAR _sort         = MAXX ( _row, [@sort] )
                    VAR _d            = MAXX ( _row, [@d] )
                    VAR _t            = MAXX ( _row, [@t] )
                    VAR _run          = SUMX ( FILTER ( _p_pr, [@sort] <= _sort ), [@d] )
                    RETURN
                        SWITCH (
                            TRUE ()
                            ,_t = 1
                                ,FORMAT ( _run, _fmt_level )
                            ,_d > 0
                                ,FORMAT ( _d, _fmt_up )
                            ,_d < 0
                                ,FORMAT ( - _d, _fmt_down )
                        )
                ,"S_NR",
                    VAR _row          = FILTER ( _s_nr, [@label] = _label )
                    VAR _sort         = MAXX ( _row, [@sort] )
                    VAR _d            = MAXX ( _row, [@d] )
                    VAR _t            = MAXX ( _row, [@t] )
                    VAR _run          = SUMX ( FILTER ( _s_nr, [@sort] <= _sort ), [@d] )
                    RETURN
                        SWITCH (
                            TRUE ()
                            ,_t = 1
                                ,FORMAT ( _run, _fmt_level )
                            ,_d > 0
                                ,FORMAT ( _d, _fmt_up )
                            ,_d < 0
                                ,FORMAT ( - _d, _fmt_down )
                        )
                ,"S_PR",
                    VAR _row          = FILTER ( _s_pr, [@label] = _label )
                    VAR _sort         = MAXX ( _row, [@sort] )
                    VAR _d            = MAXX ( _row, [@d] )
                    VAR _t            = MAXX ( _row, [@t] )
                    VAR _run          = SUMX ( FILTER ( _s_pr, [@sort] <= _sort ), [@d] )
                    RETURN
                        SWITCH (
                            TRUE ()
                            ,_t = 1
                                ,FORMAT ( _run, _fmt_level )
                            ,_d > 0
                                ,FORMAT ( _d, _fmt_up )
                            ,_d < 0
                                ,FORMAT ( - _d, _fmt_down )
                        )
                ) & ""
    )
RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "R-16"
        ,"_id", [_id]
        ,"_check", [_cut] & " " & [_label]
        ,"_result", [_result]
        ,"_expected", [_expected]
        ,"_pass", [_result] = [_expected]
    )
ORDER BY [_id]
