                )
                ,"_expected", 0
                ,"_expect_blank", TRUE ()
            )
    )
VAR _checked =
    ADDCOLUMNS (
        _rows
        ,"_diff", [_model] - [_expected]
        ,"_tolerance", SWITCH ( [_unit], "amount", 0.011, "count", 0, 1e-9 ) + ABS ( [_expected] ) * 1e-9
    )
RETURN
    SELECTCOLUMNS (
        _checked
        ,"_test", "Golden"
        ,"_id", [_id]
        ,"_metric", [_metric]
        ,"_measure", [_measure]
        ,"_cut", [_cut]
        ,"_model", [_model]
        ,"_expected", IF ( [_expect_blank], BLANK (), [_expected] )
        ,"_diff", IF ( [_expect_blank], BLANK (), [_diff] )
        ,"_pass",
            IF (
                [_expect_blank]
                ,ISBLANK ( [_model] )
                ,NOT ISBLANK ( [_model] ) && ABS ( [_diff] ) <= [_tolerance]
            )
    )
ORDER BY [_id]

EVALUATE
