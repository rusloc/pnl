RETURN
    SELECTCOLUMNS (
        _rows
        ,"_test", "R-06"
        ,"_id", [_id]
        ,"_check", [_check]
        ,"_model", IF ( [_expected_text] <> "", [_model_text], [_model] )
        ,"_expected", IF ( [_expected_text] <> "", [_expected_text], IF ( [_expect_blank], BLANK (), [_expected] ) )
        ,"_pass",
            SWITCH (
                TRUE ()
                ,[_expect_blank]
                    ,ISBLANK ( [_model] ) && ISBLANK ( [_model_text] )
                ,[_expected_text] <> ""
                    ,[_model_text] = [_expected_text]
                ,NOT ISBLANK ( [_model] ) && ABS ( [_model] - [_expected] ) <= [_tolerance]
            )
    )
ORDER BY [_id]

EVALUATE
