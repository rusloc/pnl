        ,SELECTCOLUMNS ( _model, "_code", [_code], "_column", "FY Budget", "_model", [@fy_bud], "_expected", [_fy_bud], "_tolerance", IF ( RIGHT ( [_code], 4 ) = "_PCT", 5.1e-7, 0.016 + ABS ( [_fy_bud] ) * 1e-9 ) )
        ,SELECTCOLUMNS ( _model, "_code", [_code], "_column", "FY LE", "_model", [@fy_le], "_expected", [_fy_le], "_tolerance", IF ( RIGHT ( [_code], 4 ) = "_PCT", 5.1e-7, 0.016 + ABS ( [_fy_le] ) * 1e-9 ) )
        ,SELECTCOLUMNS ( _model, "_code", [_code], "_column", "Δ LE vs Budget", "_model", [@d_le], "_expected", [_d_le], "_tolerance", IF ( RIGHT ( [_code], 4 ) = "_PCT", 5.1e-7, 0.016 + ABS ( [_d_le] ) * 1e-9 ) )
    )
RETURN
    SELECTCOLUMNS (
        _cells
        ,"_test", "R-01"
        ,"_code", [_code]
        ,"_column", [_column]
        ,"_model", [_model]
        ,"_expected", [_expected]
        ,"_diff", [_model] - [_expected]
        ,"_pass",
            IF (
                ISBLANK ( [_expected] )
                ,ISBLANK ( [_model] )
                ,NOT ISBLANK ( [_model] ) && ABS ( [_model] - [_expected] ) <= [_tolerance]
            )
    )

