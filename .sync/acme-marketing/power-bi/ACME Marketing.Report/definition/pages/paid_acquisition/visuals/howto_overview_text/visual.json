    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Top band: the six vitals for the window, with the change against the comparison mode (arrow + colour: green = favourable) and the target sub-line. Vitals follow the Filters only; a click in a card never re-scopes them.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Read down: the funnel shows which stage moved, Guardrails whether a good headline hides a bad quarter, the daily charts when it moved (dotted line = Oct 18), shares and movers who earned it, Alerts what needs a decision.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This window: spend +7 % and CAC up; trial → paid fell on Oct 18 on mobile paid social, mostly Meta Lookalike 2 % (creative fatigue). Decision: rotate the creative, hold the budget.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ⓘ on each card opens its definition.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              }
            ]
          }
