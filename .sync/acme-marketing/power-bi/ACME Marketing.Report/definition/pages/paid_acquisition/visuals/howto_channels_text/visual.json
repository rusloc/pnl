                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Flags: Fatigue, Frequency, View-through heavy, CPA over (only without a root cause), Over-pacing, Underspent, Learning; thresholds from param_target.",
