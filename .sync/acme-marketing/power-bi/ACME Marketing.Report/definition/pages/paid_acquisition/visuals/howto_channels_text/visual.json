                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4B5563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Web vs app shows each stage's conversion from the previous one; Platform-reported vs modelled shows how much the networks over-claim; Pacing compares spend with plan (dashed line = 100 %).",
