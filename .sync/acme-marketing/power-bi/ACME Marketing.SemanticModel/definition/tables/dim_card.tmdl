/// One row per card of the phase-2 views + the six vitals: title, question and the ⓘ copy (A-51, A-60; the shared copy source until copy.ts exists).
table dim_card
	lineageTag: 45f16d41-d427-50a2-8586-04e66610462a

	column card_code
		dataType: string
		isHidden
		lineageTag: f27f079c-89d5-5128-aa12-ce22dd702af1
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_code]

		annotation SummarizationSetBy = User

	column card_title
		dataType: string
		lineageTag: c67f184e-4e7d-5e77-89a0-44afbacf5865
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_title]
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	column card_question
		dataType: string
		lineageTag: e0175b46-2bf6-534f-83a7-98b0e47573d1
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_question]

		annotation SummarizationSetBy = User

	column card_what
		dataType: string
		lineageTag: afc79398-1298-5c5e-ac50-cb789678ca13
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_what]

		annotation SummarizationSetBy = User

	column card_formula
		dataType: string
		lineageTag: 90574c57-bc2c-5517-b51d-f0a31c80f2ad
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_formula]

		annotation SummarizationSetBy = User

	column card_note
		dataType: string
		lineageTag: ef2bf679-2086-50fe-a1df-75038edc7456
		summarizeBy: none
		isNameInferred
		sourceColumn: [card_note]

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c057a71f-3fee-588e-8656-7b25e5df62a6
		summarizeBy: none
		isNameInferred
		sourceColumn: [sort_order]

		annotation SummarizationSetBy = User

	partition dim_card = calculated
		mode: import
		source =
				DATATABLE (
				    "card_code", STRING
				    ,"card_title", STRING
				    ,"card_question", STRING
				    ,"card_what", STRING
				    ,"card_formula", STRING
				    ,"card_note", STRING
				    ,"sort_order", INTEGER
				    ,{
				        { "V1", "Spend", "Media spend in the window", "Paid media cost of the window. Agency fee and paid-team cost are not in spend.", "Σ spend_usd (fact_ad_delivery_day). Δ = spend ÷ spend of the same dates last year − 1; the sub-line is the last-year value.", "A-20, A-30. Up is unfavourable (red). The tiles always compare with the same period last year, whatever the Filters comparison says.", 1 }
				        ,{ "V2", "New clients", "Registrations in the window", "Sign-ups (registrations) from paid media that happened in the window.", "Σ signups (fact_funnel_day, by sign-up day). Δ vs the same dates last year.", "A-20, A-34. Sign-ups never switch attribution model.", 2 }
				        ,{ "V3", "Conversion into paid", "Share of registrations that pay", "Paid customers of the window per sign-up of the window, as a rate.", "Paid customers (selected model, by conversion day) ÷ sign-ups (by sign-up day), both in the window. Δ in points vs the same dates last year.", "A-20. A period rate, not a cohort: the data has no sign-up → payment link per customer, so a customer who signed up before the window and paid in it counts in the numerator.", 3 }
				        ,{ "V4", "Time to activation", "Days from sign-up to first dashboard", "Median days from sign-up to activation (first dashboard) for the sign-ups of the window that activated within 30 days.", "Median of the seven activation-time bins (fact_funnel_day act_*), linear inside the median bin, ÷ 24. Δ in days vs the same dates last year.", "A-20, A-47. Stands in for time to paid: the dataset has no sign-up → first-payment timing. Recent sign-ups have not had 30 days, so the window's median reads low against last year's.", 4 }
				        ,{ "V5", "CAC", "Cost of one new paying customer", "Ad spend per paid customer (no team cost).", "Spend ÷ paid customers (selected model) = paid CAC. Δ vs the same dates last year.", "A-20, A-38. Up is unfavourable. Blended CAC (with team cost) stays in the ⓘ formula of A-38 and in K2 / K6.", 5 }
				        ,{ "V6", "ROAS 90 d", "Revenue return of the window's spend", "90-day revenue of the new customers per dollar of spend.", "New MRR × R90 ÷ spend; R90 = revenue of the first 3 months ÷ revenue of month 1 of the newest complete cohort (campaign → channel → ALL). Δ vs the same dates last year.", "A-20, A-42. The same ROAS as the Channel matrix and Top movers.", 6 }
				        ,{ "O1", "Acquisition funnel", "Where in the journey do we lose or win?", "Seven stages from impressions to paid customers; bar widths on a log10 scale, the absolute count of each stage beside its bar.", "Impressions, clicks, web sessions + installs, sign-ups, activated within 7 days, trials, paid customers (selected model).", "A-32 … A-37. Activated counts are cohorted by sign-up day, so the last 7 days of a window are partial by construction.", 7 }
				        ,{ "O2", "Guardrails", "Can a good headline hide a bad quarter?", "Six checks beside the vitals: trial → paid, D7 and D30 retention of paid cohorts, refund rate, brand share of search spend, attribution gap.", "Meter = value against 2 × target, marker = target (param_target); colour = verdict (OK / WARN within 30 % / CRIT).", "A-22. D7 / D30 come from the latest cohort month with a reportable D30 cell (Sep 2026 for the default window).", 8 }
				        ,{ "O3", "Spend vs plan and CAC", "When did it move?", "Spend per day as bars next to the day's plan (pale bars), and paid CAC per day as a line on the right axis.", "Spend and plan per day (or week / month; plan = Σ budget ÷ days in month); paid CAC = spend ÷ paid customers per bucket (selected model). The dotted marker is the CAC step day (Oct 18).", "A-52. The CAC line reads on the right axis (secondary axis accepted on 2026-11-04 instead of two stacked charts).", 9 }
				        ,{ "O7", "Spend and paid customers by channel", "Where the money goes, where customers come from", "Per channel, the window's spend next to its paid customers, on two aligned columns in the channel colour.", "Spend = Σ spend_usd; paid customers = Σ paid_customers (selected model), per channel of the scope.", "A-52 (replaces Spend share vs new-MRR share, redesign round 1). Bars of each column share one scale.", 10 }
				        ,{ "O5", "Anomalies and alerts", "What needs a decision today?", "Campaigns whose paid customers moved most against the comparison period: the five largest losses (Worst 5) or gains (Top 5), with the alert that trips on the campaign.", "Δ = paid customers (selected model) − the previous period's (the same period last year in LY mode); campaigns with spend in both periods. Alert = the most severe campaign alert that trips (param_alert_rule: creative fatigue, install quality).", "A-52, A-64. When the comparison would start before the first day of data (e.g. Custom from Jan 1 2025), O5 and O6 compare the window's last 30 days. Channel, ALL and source alerts show in the Channel matrix flags (over plan, underspent), Guardrails (attribution gap) and the freshness dot (stale source).", 11 }
				        ,{ "O6", "Top movers by Δ ROAS", "Which campaigns changed most vs prior period?", "The five best (Top 5) or five worst (Worst 5) campaigns by the change in 90-day ROAS against the previous period, in absolute ROAS points.", "ROAS 90 d = New MRR × R90 ÷ spend; Δ = window − previous period. Campaigns with a ROAS objective and spend in both periods.", "A-52 / A-42. R90 = 3-month revenue multiple of the newest complete cohort (campaign → channel → ALL fallback). When the comparison would start before the first day of data, the last 30 days of the window are compared.", 12 }
				        ,{ "C1", "Channel matrix", "Which channel earns the result, and where?", "One row per channel, expandable to platform: spend, share, paid customers, CAC, ROAS 90 d, click → sign-up, pacing and the flag.", "CAC = spend ÷ paid customers (selected model; equals CPA at the same scope). Flags (A-24): Fatigue, Frequency, View-through heavy, CPA over (only when no root cause trips), Over-pacing, Underspent; Learning when every spending campaign is learning.", "Click a row to scope every card below and the Campaigns view (Selected: in the chips line). The vitals never re-scope.", 13 }
				        ,{ "C2", "Web vs app funnel", "Where does each platform leak?", "Conversion of each stage from the previous one, web and app (iOS + Android) side by side.", "Web: CTR, sessions ÷ clicks, sign-ups ÷ sessions; app: CTR, store views ÷ clicks, installs ÷ store views, sign-ups ÷ installs; then activated, trial and paid rates.", "A-53, data README D-3 (store → install 29.4 %, web landing rate 79.7 %).", 14 }
				        ,{ "C5", "Paid customers by channel, web", "Who brings web customers, at what cost", "Paid customers of the web campaigns per channel; the label adds the channel's CAC on web.", "Σ paid_customers (selected model) and spend ÷ paid customers, campaigns on WEB (visual filter on the platform).", "A-53. Each campaign runs on one platform (dim_campaign.platform_code).", 15 }
				        ,{ "C6", "Paid customers by channel, mobile", "Who brings app customers, at what cost", "Paid customers of the iOS and Android campaigns per channel; the label adds the channel's CAC on mobile.", "Σ paid_customers (selected model) and spend ÷ paid customers, campaigns on IOS + ANDROID (visual filter on the platform).", "A-53. A Filters pick of one platform empties the other card.", 16 }
				        ,{ "P1", "Campaigns", "Which campaign is off, and how?", "Every campaign in scope, sorted by spend: pacing, CPA, ROAS 90 d, CTR 7-day change, frequency and its flags.", "Status Live + Learning by default (pick Paused or Ended in Filters › Campaigns to add them). CPA and ROAS show — for Lead and Retention objectives.", "A-54. Click a row to select the campaign for the cards below (default: the worst mover of the window).", 17 }
				        ,{ "P5", "Keywords / placements", "Which terms buy conversions, which buy clicks?", "The selected campaign's top terms: keywords for search campaigns, placements or audiences for the others.", "CPC = spend ÷ clicks; CVR = sign-ups ÷ clicks; Conv. = sign-ups (fact_term_day).", "A-45. The eight terms carry 80–90 % of the campaign's delivery.", 18 }
				        ,{ "P6", "Churn by channel", "Which channel loses the most customers?", "Customers lost per channel in the trailing 3 complete months: the five channels with the most.", "Σ churned (fact_cohort_revenue_month, months since acquisition ≥ 1, calendar months in the trailing 3 complete months to the window end); DDA credits.", "A-41, A-48. Counts are DDA credits, so channel values are fractional; the bars round. The rate (churned ÷ customers at start) feeds LTV:CAC.", 19 }
				        ,{ "P7", "Refund by channel", "Which channel's customers refund the most?", "Refunds per channel for the 12 acquisition months to the window end: the five channels with the most.", "Σ refund_count (fact_cohort_revenue_month) of the cohorts acquired in the 12 months ending with the window's end month; DDA credits.", "A-22, A-48. The refund rate (refunds ÷ cohort customers) is the Guardrails row.", 20 }
				        ,{ "J1", "Landing and store pages", "Is the leak after the click?", "Web landing pages and the two store pages: visits (sessions or store views), conversion, bounce and LCP.", "Web: sign-ups ÷ sessions, bounces ÷ sessions, sessions-weighted p75 LCP. Store pages: installs ÷ store views; bounce and LCP do not apply (—).", "A-46. A flat store CVR while trial → paid falls means the leak is before the click.", 21 }
				        ,{ "J2", "Onboarding steps, paid traffic", "Which step loses new sign-ups?", "Share of paid sign-ups that reached each onboarding step within 7 days; the largest drop is highlighted.", "Σ step column ÷ Σ sign-ups (fact_funnel_day), in step order; drop = previous step share − share.", "A-47. Counts are cohorted by sign-up day, so the last 7 days of the window are partial.", 22 }
				        ,{ "J3", "Sign-up → activation time", "How fast do paid users reach the aha moment?", "Activations within 30 days by hours from sign-up, as shares; the median bin is emphasised.", "Seven bins (< 1 h … 7–30 d) ÷ their sum; median hours by linear interpolation inside the median bin.", "A-47, data README D-10: the window is right-censored (recent sign-ups have not had 30 days).", 23 }
				        ,{ "J4", "Activation rate by platform and OS", "Does the app convert sign-ups as well as web?", "7-day activation rate per platform segment (web desktop / mobile, iOS 18 / 17, Android 14–15 / ≤ 13) against the 40 % target.", "Σ activated_7d ÷ Σ sign-ups per segment (fact_signup_segment_day); the dashed line is ACTIVATION_7D.", "A-47. The dataset carries segments, not single OS versions.", 24 }
				        ,{ "K1", "Payback by acquisition month", "Will it pay back, and when?", "Cumulative payback of each acquisition month's CAC by month since acquisition, for the 12 acquisition months before the window's end month: one hue, darker = closer to payback, green = paid back.", "Σ (revenue − refunds) to month m × gross margin ÷ (cohort-month spend + allocated team cost); paid back at the first month ≥ 100 %. Months 0 to 11 since acquisition.", "A-48, A-56. DDA cohorts; scope filters apply, the window start does not. Scoped to Meta Lookalike 2 % the Nov 2025 – Jan 2026 cohorts turn green at month 9.", 25 }
				        ,{ "K2", "LTV:CAC by channel", "Where does a dollar earn the most?", "LTV:CAC of each channel in the window, in the channel colour, against the 3:1 floor.", "LTV = ARPA × gross margin ÷ monthly churn (trailing 3 complete months); ÷ blended CAC of the channel.", "A-41, A-56.", 26 }
				        ,{ "K6", "Payback months by channel", "Which channel repays CAC within a year?", "Months of gross margin a channel's new customer needs to repay its blended CAC, against the 12-month line.", "Blended CAC ÷ (ARPA × gross margin 36.3 %), on the window (the window formula of A-40, not the cohort curve of the heatmap).", "A-40, A-56. Dashed line = PAYBACK_MONTHS (param_target).", 27 }
				        ,{ "K7", "Cohort size by acquisition month", "How many paid customers each month brought", "Paid customers of each of the 12 acquisition months to the window's end month.", "Offset-0 customers_start (fact_cohort_revenue_month, DDA credits).", "A-48. The denominators of the heatmap and the retention grid; the window's end month is partial.", 28 }
				        ,{ "K3", "Retention grid, paid cohorts", "Do paid users stay?", "Share of each acquisition month's users active on day N, for the latest six cohort months; one hue, darker = higher.", "users_active ÷ users_matured (fact_retention_cohort_month); a cell exists only once the 15th of the month + N has passed.", "A-48, A-74. Blank = not reportable yet.", 29 }
				    }
				)

	annotation PBI_ResultType = Table

