/// Delivery, day x campaign x ad set x creative. reach_7d is point in time (never summed over days); paid_customers_dda = DDA credits split by clicks (data README D-4).
table fact_ad_delivery_day
	lineageTag: 2b685ae2-0e30-53c0-8411-de7a40a6f3db

	column date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 904b0960-784a-50b6-a716-54e9500c7d6e
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

