	partition fact_ad_delivery_day = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_ad_delivery_day.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"date", type date},
				            {"campaign_key", type text},
				            {"ad_set_key", type text},
				            {"creative_key", type text},
				            {"impressions", Int64.Type},
				            {"clicks", Int64.Type},
				            {"spend_usd", type number},
				            {"reach_7d", Int64.Type},
				            {"video_views", Int64.Type},
				            {"paid_customers_dda", type number}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

