	partition dim_attribution_model = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_attribution_model.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"model_code", type text},
				            {"model_name", type text},
				            {"lookback_click_days", Int64.Type},
				            {"lookback_view_days", Int64.Type},
				            {"is_default", type logical},
				            {"is_first_party", type logical},
				            {"description", type text},
				            {"sort_order", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

