	column store_views
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6cc39f4e-0dff-594f-b5d1-623e7a51965b
		summarizeBy: none
		sourceColumn: store_views

		annotation SummarizationSetBy = User

	column installs
		dataType: int64
		isHidden
		formatString: 0
