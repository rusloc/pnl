	partition fact_traffic_day = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\fact_traffic_day.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"date", type date},
				            {"campaign_key", type text},
				            {"page_key", type text},
				            {"sessions", Int64.Type},
				            {"bounces", Int64.Type},
				            {"lcp_ms_p75", Int64.Type},
				            {"store_views", Int64.Type},
				            {"installs", Int64.Type},
				            {"first_opens", Int64.Type},
				            {"signups", Int64.Type}
				        }
				    )
				in
				    typed

	annotation PBI_ResultType = Table

