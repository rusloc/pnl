/// Web sessions or store-page funnel, day x campaign x page (columns of the other kind are null).
table fact_traffic_day
	lineageTag: 677d5c35-1d8a-546b-b356-73f80624616c

	column date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 74135859-5b98-502d-b728-128e453f808e
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column campaign_key
		dataType: string
