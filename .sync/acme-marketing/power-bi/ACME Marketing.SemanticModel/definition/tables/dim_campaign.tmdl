	/// Copy of campaign_name for the campaign table and movers (cross-filter source).
	column campaign_label
		dataType: string
		lineageTag: 3fc818d5-8982-593d-b3b0-5758fce9ec3c
		summarizeBy: none
		sourceColumn: campaign_label
		sortByColumn: sort_order

		annotation SummarizationSetBy = User

	partition dim_campaign = m
		mode: import
		source =
				let
				    // Portable source (ADR-0015 (b), A-80): one Parquet file per table in DataFolder. A file source does not fold:
				    // the file is read whole; types are set explicitly from manifest.json (data README Format).
				    src = Parquet.Document(File.Contents(DataFolder & "\dim_campaign.parquet")),
				    typed = Table.TransformColumnTypes(
				        src,
				        {
				            {"campaign_key", type text},
				            {"campaign_name", type text},
				            {"channel_code", type text},
				            {"network_code", type text},
				            {"platform_code", type text},
				            {"market_code", type text},
				            {"tier_code", type text},
				            {"objective_code", type text},
				            {"status_code", type text},
				            {"is_brand", type logical},
				            {"start_date", type date},
				            {"end_date", type date},
				            {"learning_end_date", type date},
				            {"cpa_target_usd", type number},
				            {"sort_order", Int64.Type}
				        }
				    ),
				    ch_src = Table.TransformColumnTypes(Table.SelectColumns(Parquet.Document(File.Contents(DataFolder & "\dim_channel.parquet")), {"channel_code", "channel_name"}), {{"channel_code", type text}, {"channel_name", type text}}),
				    ch_joined = Table.NestedJoin(typed, {"channel_code"}, ch_src, {"channel_code"}, "j", JoinKind.LeftOuter),
				    ch_expanded = Table.ExpandTableColumn(ch_joined, "j", {"channel_name"}),
				    nw_src = Table.TransformColumnTypes(Table.SelectColumns(Parquet.Document(File.Contents(DataFolder & "\dim_network.parquet")), {"network_code", "network_name"}), {{"network_code", type text}, {"network_name", type text}}),
				    nw_joined = Table.NestedJoin(ch_expanded, {"network_code"}, nw_src, {"network_code"}, "j", JoinKind.LeftOuter),
				    nw_expanded = Table.ExpandTableColumn(nw_joined, "j", {"network_name"}),
				    add_status_name = Table.AddColumn(nw_expanded, "status_name", each Record.FieldOrDefault([LIVE = "Live", LEARNING = "Learning", PAUSED = "Paused", ENDED = "Ended"], [status_code], [status_code]), type text),
				    add_market_name = Table.AddColumn(add_status_name, "market_name", each Record.FieldOrDefault([GLOBAL = "Global", NA = "North America", EMEA = "EMEA"], [market_code], [market_code]), type text),
				    add_tier_name = Table.AddColumn(add_market_name, "tier_name", each Record.FieldOrDefault([SELF_SERVE = "Self-serve", SALES_ASSISTED = "Sales-assisted"], [tier_code], [tier_code]), type text),
				    add_objective_name = Table.AddColumn(add_tier_name, "objective_name", each Record.FieldOrDefault([PAID = "Paid", INSTALL = "Install", PIPELINE = "Pipeline", LEAD = "Lead", RETENTION = "Retention"], [objective_code], [objective_code]), type text),
				    add_label = Table.AddColumn(add_objective_name, "campaign_label", each [campaign_name], type text)
				in
				    add_label

	annotation PBI_ResultType = Table

