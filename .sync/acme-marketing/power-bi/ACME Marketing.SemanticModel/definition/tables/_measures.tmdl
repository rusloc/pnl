	/// Page CVR: installs ÷ store views on store pages, page sign-ups ÷ sessions on web pages (A-46).
	measure '_x Page CVR' =
			VAR _store        = [_b Store Views]
			VAR _sessions     = [_b Sessions]
			RETURN
			    IF ( _store > 0, DIVIDE ( [_b Installs], _store ), DIVIDE ( [_b Traffic Signups], _sessions ) )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: d85cd0a1-b45d-5a3d-a1be-22aed6323133

	/// Bounces ÷ sessions (web pages).
	measure '_x Page Bounce Rate' = DIVIDE ( [_b Bounces], [_b Sessions] )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 5d527b5a-401f-58a5-b30c-833f315d3bd3

	/// Sessions-weighted mean of the daily p75 LCP in ms (web pages).
	measure '_x Page LCP' = DIVIDE ( [_b LCP Weighted], [_b Sessions] )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 21e1ef6e-544f-5aed-a107-b28af3a7ea6e

	/// Onboarding step completion ÷ sign-ups for the step in context (A-47).
	measure '_x Step Share' =
			VAR _signups      = [_b Signups]
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( dim_onboarding_step[step_code] )
			        ,"SIGNUP"
			            ,IF ( _signups > 0, 1 )
			        ,"VERIFY_EMAIL"
			            ,DIVIDE ( SUM ( fact_funnel_day[step_verified] ), _signups )
			        ,"CREATE_WORKSPACE"
			            ,DIVIDE ( SUM ( fact_funnel_day[step_workspace] ), _signups )
			        ,"CONNECT_SOURCE"
			            ,DIVIDE ( SUM ( fact_funnel_day[step_connected] ), _signups )
			        ,"FIRST_DASHBOARD"
			            ,DIVIDE ( SUM ( fact_funnel_day[step_first_dashboard] ), _signups )
			        ,"INVITE"
			            ,DIVIDE ( SUM ( fact_funnel_day[step_invited] ), _signups )
			    )
		formatString: 0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 4bff420e-3e3b-5597-8840-894f8f56d0b2

	/// Activations in the sign-up → activation time bin in context (A-47).
	measure '_b Act Bin' =
			SWITCH (
			    SELECTEDVALUE ( dim_act_bin[bin_code] )
			    ,"LT1H"
			        ,SUM ( fact_funnel_day[act_lt1h] )
			    ,"H1_6"
			        ,SUM ( fact_funnel_day[act_1_6h] )
			    ,"H6_24"
			        ,SUM ( fact_funnel_day[act_6_24h] )
			    ,"D1_2"
			        ,SUM ( fact_funnel_day[act_1_2d] )
			    ,"D2_4"
			        ,SUM ( fact_funnel_day[act_2_4d] )
			    ,"D4_7"
			        ,SUM ( fact_funnel_day[act_4_7d] )
			    ,"D7_30"
			        ,SUM ( fact_funnel_day[act_7_30d] )
			)
		formatString: #,0
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: f500b806-def3-5bbe-99c2-0bab3ba6c4ec

	/// Activations within 30 days (Σ the seven bins).
	measure '_b Act Total' = SUM ( fact_funnel_day[act_lt1h] ) + SUM ( fact_funnel_day[act_1_6h] ) + SUM ( fact_funnel_day[act_6_24h] ) + SUM ( fact_funnel_day[act_1_2d] ) + SUM ( fact_funnel_day[act_2_4d] ) + SUM ( fact_funnel_day[act_4_7d] ) + SUM ( fact_funnel_day[act_7_30d] )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: 30465e3e-53b6-5242-af46-c9f352533171

	/// Bin share of the activations within 30 days (A-47).
	measure '_x Act Share' = DIVIDE ( [_b Act Bin], [_b Act Total] )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: e0a14fc4-e72c-5091-a232-5b8a4acdbaf4

	/// Median hours from sign-up to activation: linear interpolation inside the median bin, edges 0/1/6/24/48/96/168/720 h (A-47).
	measure '_x Act Median Hours' =
			VAR _total        = [_b Act Total]
			VAR _bins         =
			    ADDCOLUMNS (
			        ALL ( dim_act_bin )
			        ,"@n", [_b Act Bin]
			    )
			VAR _cum          =
			    ADDCOLUMNS (
			        _bins
			        ,"@c",
			            VAR _s        = dim_act_bin[sort_order]
			            RETURN
			                DIVIDE ( SUMX ( FILTER ( _bins, dim_act_bin[sort_order] <= _s ), [@n] ), _total )
			    )
			VAR _median_bin   = TOPN ( 1, FILTER ( _cum, [@c] >= 0.5 ), dim_act_bin[sort_order], ASC )
			VAR _order        = MAXX ( _median_bin, dim_act_bin[sort_order] )
			VAR _c            = MAXX ( _median_bin, [@c] )
			VAR _lo           = MAXX ( FILTER ( _cum, dim_act_bin[sort_order] = _order - 1 ), [@c] ) + 0
			VAR _from         = MAXX ( _median_bin, dim_act_bin[lo_hours] )
			VAR _to           = MAXX ( _median_bin, dim_act_bin[hi_hours] )
			RETURN
			    IF ( _total > 0, _from + DIVIDE ( 0.5 - _lo, _c - _lo ) * ( _to - _from ) )
		formatString: 0.0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 89e56dd2-e572-5e7e-9144-516a6bf013fa

	/// Σ sign-ups of the platform segment(s) in context (J4).
	measure '_x Segment Signups' = SUM ( fact_signup_segment_day[signups] )
