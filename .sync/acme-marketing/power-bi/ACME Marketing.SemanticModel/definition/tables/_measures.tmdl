	/// Σ lcp_ms_p75 × sessions (sessions-weighted LCP numerator, A-46).
	measure '_b LCP Weighted' = SUMX ( fact_traffic_day, fact_traffic_day[lcp_ms_p75] * fact_traffic_day[sessions] )
		formatString: #,0
		isHidden
		displayFolder: 9 Engine\Base
