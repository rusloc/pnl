		formatStringDefinition = IF ( [_J1 Store], """—""", "0.0%" )

	/// J1 LCP cell in ms; — on store pages (A-55).
	measure 'J1 LCP' = IF ( NOT ISBLANK ( [Page Visits] ), IF ( [_J1 Store], 0, [Page LCP] ) )
		displayFolder: 8 Report
		lineageTag: 4640af9d-5dbd-50f5-b517-0c4d1a920646

		formatStringDefinition = IF ( [_J1 Store], """—""", "#,0"" ms""" )

	/// J1 caption: store-page CVR now and in the previous period (the story: flat, so the leak is pre-click).
	measure 'J1 Caption' =
			VAR _as           = CALCULATE ( [Page CVR], dim_landing_page[page_key] = "LP_APP_STORE" )
			VAR _as_p         = CALCULATE ( [Page CVR Prev], dim_landing_page[page_key] = "LP_APP_STORE" )
			VAR _gp           = CALCULATE ( [Page CVR], dim_landing_page[page_key] = "LP_PLAY_STORE" )
			VAR _gp_p         = CALCULATE ( [Page CVR Prev], dim_landing_page[page_key] = "LP_PLAY_STORE" )
			RETURN
			    "App Store CVR " & FORMAT ( _as, "0%" ) & " (prev " & FORMAT ( _as_p, "0%" ) & ")   |   Google Play " & FORMAT ( _gp, "0%" )
			        & " (prev " & FORMAT ( _gp_p, "0%" ) & ")   |   web landing → sign-up " & FORMAT ( [Landing Signup Rate], "0.0%" )
		displayFolder: 8 Report
		lineageTag: ff3ca4cb-def2-550d-aedb-72ba6694f65d

	/// Step with the largest drop from the previous step (J2 highlight; story: Connect data source).
	measure 'J2 Largest Drop Step' =
			VAR _drops        =
			    ADDCOLUMNS (
			        ALL ( dim_onboarding_step )
			        ,"@share", [Step Share]
			        ,"@prev",
			            VAR _s        = dim_onboarding_step[sort_order]
			            RETURN
			                CALCULATE ( [Step Share], REMOVEFILTERS ( dim_onboarding_step ), dim_onboarding_step[sort_order] = _s - 1 )
			    )
			VAR _top          = TOPN ( 1, FILTER ( _drops, NOT ISBLANK ( [@prev] ) ), [@prev] - [@share], DESC, dim_onboarding_step[sort_order], ASC )
			RETURN
			    MAXX ( _top, dim_onboarding_step[step_code] )
		displayFolder: 6 Diagnostics\Journey
		lineageTag: 2e48c59f-70bf-5a19-b929-fd2e961a4ce6

	/// J2 bar colour: crit on the largest drop, accent otherwise.
	measure 'J2 Colour' =
			VAR _largest      = [J2 Largest Drop Step]
			RETURN
			    IF ( SELECTEDVALUE ( dim_onboarding_step[step_code] ) = _largest, "#D93B4B", "#4A57E8" )
		displayFolder: 8 Report
		lineageTag: 6de20121-af58-5ebd-bb3e-273f5e4682dc

	/// J2 caption: the largest drop in pt (A-55).
	measure 'J2 Caption' =
			VAR _drops        =
			    ADDCOLUMNS (
			        ALL ( dim_onboarding_step )
			        ,"@share", [Step Share]
			        ,"@prev",
			            VAR _s        = dim_onboarding_step[sort_order]
			            RETURN
			                CALCULATE ( [Step Share], REMOVEFILTERS ( dim_onboarding_step ), dim_onboarding_step[sort_order] = _s - 1 )
			    )
			VAR _top          = TOPN ( 1, FILTER ( _drops, NOT ISBLANK ( [@prev] ) ), [@prev] - [@share], DESC, dim_onboarding_step[sort_order], ASC )
			VAR _drop         = MAXX ( _top, [@share] - [@prev] )
			RETURN
			    "Largest drop: " & MAXX ( _top, dim_onboarding_step[step_name] ) & " (−" & FORMAT ( ABS ( _drop ) * 100, "0" ) & " pt)   |   "
			        & FORMAT ( [Signups], "#,0" ) & " paid sign-ups"
		displayFolder: 8 Report
		lineageTag: ef686466-9ca1-5b32-b7c7-97bc5febf690

	/// Time bin that holds the median (J3 emphasis).
	measure 'J3 Median Bin' =
			VAR _median       = [Act Median Hours]
			RETURN
			    MAXX ( FILTER ( ALL ( dim_act_bin ), dim_act_bin[lo_hours] <= _median && dim_act_bin[hi_hours] > _median ), dim_act_bin[bin_code] )
		displayFolder: 6 Diagnostics\Journey
		lineageTag: bf18844f-ccc0-580b-8159-3dbfc8e0dc9d

	/// J3 bar colour: accent on the median bin.
	measure 'J3 Colour' = IF ( SELECTEDVALUE ( dim_act_bin[bin_code] ) = [J3 Median Bin], "#4A57E8", "#B7BDF3" )
		displayFolder: 8 Report
		lineageTag: 2afb351a-980d-5f3b-bad9-e35c10c9fd13

	/// J3 caption (A-55).
	measure 'J3 Caption' = "Median " & FORMAT ( [Act Median Hours], "0" ) & " h   |   7-day activation " & FORMAT ( [Activation Rate], "0%" ) & "   |   recent sign-ups have not had 30 days"
		displayFolder: 8 Report
		lineageTag: d50ff0d1-cf61-5b9a-8c64-28e3c8224796

	/// The 40 % activation reference (param_target ACTIVATION_7D).
	measure 'J4 Target' = [_T ACTIVATION_7D]
		formatString: 0%
		displayFolder: 6 Diagnostics\Journey
		lineageTag: 2a8eaa21-7385-5e91-b1bb-e79ca81d963d

	/// J4 bar colour: warn under the 40 % reference.
	measure 'J4 Colour' = IF ( [Segment Activation] < [_T ACTIVATION_7D], "#C47A0E", "#4A57E8" )
		displayFolder: 8 Report
		lineageTag: 4b69a6ab-ecb4-5705-afaf-0f6de0ce4801

	/// J4 caption: lowest vs highest segment (A-55).
	measure 'J4 Caption' =
			VAR _seg          =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dim_platform_segment ), "@r", [Segment Activation] )
			        ,NOT ISBLANK ( [@r] )
			    )
			VAR _low          = TOPN ( 1, _seg, [@r], ASC, dim_platform_segment[sort_order], ASC )
			VAR _high         = TOPN ( 1, _seg, [@r], DESC, dim_platform_segment[sort_order], ASC )
			RETURN
			    MAXX ( _low, dim_platform_segment[segment_name] ) & " " & FORMAT ( MAXX ( _low, [@r] ), "0%" ) & " vs "
			        & MAXX ( _high, dim_platform_segment[segment_name] ) & " " & FORMAT ( MAXX ( _high, [@r] ), "0%" ) & "   |   dashed line: 40 % target"
		displayFolder: 8 Report
		lineageTag: 31cbf125-fd29-5602-a514-b06a9b6918ab

	/// Month index of the window's end month (cohort cards list acquisition months up to it).
	measure '_Cohort End Index' =
			VAR _end          = [_Win End]
			RETURN
			    CALCULATE ( MAX ( dim_date[month_index] ), REMOVEFILTERS ( dim_date ), dim_date[date] = _end )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 7eadebc0-9761-554c-9d8f-5a5510628e7f

	/// Paid customers of the acquisition month (offset-0 customers_start, DDA credits).
	measure 'Cohort Customers' =
			CALCULATE (
			    SUM ( fact_cohort_revenue_month[customers_start] )
			    ,fact_cohort_revenue_month[month_offset] = 0
			)
		formatString: #,0
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 055ce2c7-32a9-54ef-93bd-96b032179edb

	/// Offset-0 revenue ÷ cohort customers (A-48).
	measure 'Cohort ARPA' =
			DIVIDE (
			    CALCULATE ( SUM ( fact_cohort_revenue_month[revenue_usd] ), fact_cohort_revenue_month[month_offset] = 0 )
			    ,[Cohort Customers]
			)
		formatString: $#,0
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 2bdfd797-8705-503a-9f0f-7e4f92f140bc

	/// Spend of the acquisition month + the month's team cost allocated by spend share (A-48).
	measure 'Cohort Cost' =
			VAR _month        = SELECTEDVALUE ( dim_month[month_index] )
			VAR _spend        =
			    CALCULATE (
			        [_b Spend]
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[month_index] = _month
			        ,dim_date[is_actual] = TRUE ()
			    )
			VAR _spend_all    =
			    CALCULATE (
			        [_b Spend All]
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[month_index] = _month
			        ,dim_date[is_actual] = TRUE ()
			    )
			VAR _team         =
			    CALCULATE (
			        [_b Team Pool]
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[month_index] = _month
			        ,dim_date[is_actual] = TRUE ()
			    )
			RETURN
			    IF ( NOT ISBLANK ( _month ), _spend * ( 1 + DIVIDE ( _team, _spend_all ) ) )
		formatString: $#,0
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 0ab60229-0a86-59a5-8171-b2de89e91b69

	/// Cohort blended CAC: cohort cost ÷ cohort customers (A-48).
	measure 'Cohort CAC' = DIVIDE ( [Cohort Cost], [Cohort Customers] )
		formatString: $#,0
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: bae79fc7-52a4-5b1b-9a87-c03c6c030d41

	/// Σ refund_count (all offsets) ÷ cohort customers (A-48).
	measure 'Cohort Refund Rate' = DIVIDE ( SUM ( fact_cohort_revenue_month[refund_count] ), [Cohort Customers] )
		formatString: 0.0%
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 41528261-a3fa-51b9-a5f8-bf742962b3b2

	/// Payback curve value at the offset in context: Σ (revenue − refunds) to that offset × gross margin ÷ cohort cost (A-48).
	measure 'Cohort Payback At' =
			VAR _k            = SELECTEDVALUE ( dim_offset[month_offset] )
			VAR _rows         = CALCULATE ( COUNTROWS ( fact_cohort_revenue_month ), fact_cohort_revenue_month[month_offset] = _k )
			VAR _net          =
			    CALCULATE (
			        SUM ( fact_cohort_revenue_month[revenue_usd] ) - SUM ( fact_cohort_revenue_month[refunds_usd] )
			        ,fact_cohort_revenue_month[month_offset] <= _k
			    )
			RETURN
			    IF ( _rows > 0 && [Cohort Customers] > 0, DIVIDE ( _net * [_GM], [Cohort Cost] ) )
		formatString: 0%
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 91f48197-8546-5a26-bd80-c62423cd081f

	/// First month offset where the payback curve reaches 100 % (A-48).
	measure 'Cohort Payback Month' =
			VAR _hits         =
			    FILTER (
			        ALL ( dim_offset[month_offset] )
			        ,[Cohort Payback At] >= 1
			    )
			RETURN
			    MINX ( _hits, dim_offset[month_offset] )
		formatString: 0
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: e5650814-72bd-5dc4-881a-d0a076b66233

	/// users_active ÷ users_matured of the acquisition month at the day N in context; blank where not reportable (A-48, A-74).
	measure 'Cohort Retention' =
			VAR _n            = SELECTEDVALUE ( dim_day_n[day_n] )
			RETURN
			    CALCULATE (
			        DIVIDE ( SUM ( fact_retention_cohort_month[users_active] ), SUM ( fact_retention_cohort_month[users_matured] ) )
			        ,fact_retention_cohort_month[day_n] = _n
			    )
		formatString: 0%
		displayFolder: 6 Diagnostics\Cohorts
		lineageTag: 92c0a974-b75e-567b-89c0-3adcb277f746

	/// TRUE for the six K1 cohorts: every other month back from the window's end month − 3 (A-56).
	measure '_K1 Cohort Shown' =
			VAR _end          = [_Cohort End Index]
			VAR _m            = SELECTEDVALUE ( dim_month[month_index] )
			VAR _back         = _end - 3 - _m
			RETURN
			    NOT ISBLANK ( _m ) && _back >= 0 && _back <= 10 && MOD ( _back, 2 ) = 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: ac869766-7ff1-5505-8b62-24273748d778

	/// K1 line value: payback curve of the six shown cohorts (A-56).
	measure 'K1 Payback' = IF ( [_K1 Cohort Shown], [Cohort Payback At] )
		formatString: 0%
		displayFolder: 8 Report
		lineageTag: 77c4518f-b5cf-578e-9568-001d45f007ce

	/// The 100 % paid-back reference.
	measure 'K1 Paid Back Line' = 1
		formatString: 0%
		displayFolder: 8 Report
		lineageTag: af74c188-2375-501c-9d41-adee574589eb

	/// K1 caption: the latest shown cohort that has paid back, and its month (A-56; LAL2 scope: month 9).
	measure 'K1 Caption' =
			VAR _shown        =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dim_month ), "@show", [_K1 Cohort Shown], "@pm", [Cohort Payback Month] )
			        ,[@show] && NOT ISBLANK ( [@pm] )
			    )
			VAR _latest       = TOPN ( 1, _shown, dim_month[month_index], DESC )
			RETURN
			    "Line crosses 100 % = paid back   |   "
			        & IF (
			            ISEMPTY ( _shown )
			            ,"no shown cohort has paid back yet"
			            ,"latest cohort paid back: " & MAXX ( _latest, dim_month[month_name] ) & " in month " & MAXX ( _latest, [@pm] )
			        )
		displayFolder: 8 Report
		lineageTag: ad4a80ac-c3b1-5304-a47a-9f1c4d9e6710

	/// TRUE for the 12 acquisition months ending with the window's end month (K5).
	measure '_K12 Month' =
			VAR _end          = [_Cohort End Index]
			VAR _m            = SELECTEDVALUE ( dim_month[month_index] )
			RETURN
			    NOT ISBLANK ( _m ) && _m <= _end && _m > _end - 12
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4eddc28f-a866-5a84-8a50-42bc2d6bbbb4

	/// K5 cell: [Cohort Customers] for the 12 acquisition months to the window's end month (A-56).
	measure 'K5 Customers' = IF ( [_K12 Month], [Cohort Customers] )
		formatString: #,0
		displayFolder: 8 Report
		lineageTag: c282fbab-e274-5f42-b7b7-22b66c0d71ef

	/// K5 cell: [Cohort ARPA] for the 12 acquisition months to the window's end month (A-56).
	measure 'K5 ARPA' = IF ( [_K12 Month], [Cohort ARPA] )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: 5c10a7e9-e7f4-5129-8827-7e71d4baaf1f

	/// K5 cell: [Cohort CAC] for the 12 acquisition months to the window's end month (A-56).
	measure 'K5 CAC' = IF ( [_K12 Month], [Cohort CAC] )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: 8f411bde-8b37-5996-9519-7ac8002a5730

	/// K5 cell: [Cohort Refund Rate] for the 12 acquisition months to the window's end month (A-56).
	measure 'K5 Refund Rate' = IF ( [_K12 Month], [Cohort Refund Rate] )
		formatString: 0.0%
		displayFolder: 8 Report
		lineageTag: a29a0aca-7eb2-54a4-bbb6-2e1323eff548

	/// K5 cell: [Cohort Payback Month] for the 12 acquisition months to the window's end month (A-56).
	measure 'K5 Payback Month' = IF ( [_K12 Month], [Cohort Payback Month] )
		formatString: 0
		displayFolder: 8 Report
		lineageTag: 74aaf9ef-9af8-5465-aada-5ac0332c6db4

	/// K5 caption.
	measure 'K5 Caption' = "12 acquisition months to " & FORMAT ( [_Win End], "mmm yyyy" ) & "   |   DDA credits (cohorts never switch model)   |   payback month blank = not paid back yet"
		displayFolder: 8 Report
		lineageTag: 29a628ef-5882-52cb-bc57-92007d187796

	/// Latest acquisition month with a retention cell, up to the window end (K3 rows).
	measure '_K3 Last Cohort' =
			VAR _end          = [_Win End]
			RETURN
			    CALCULATE (
			        MAX ( fact_retention_cohort_month[cohort_month_index] )
			        ,REMOVEFILTERS ( dim_month )
			        ,REMOVEFILTERS ( dim_campaign )
			        ,REMOVEFILTERS ( dim_channel )
			        ,REMOVEFILTERS ( dim_network )
			        ,REMOVEFILTERS ( dim_platform )
			        ,fact_retention_cohort_month[cohort_month_start] <= _end
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 37e56d53-b12c-530a-bba6-57baffea0e21

	/// K3 retention cell for the latest six acquisition months (A-56); blank where not reportable.
	measure 'K3 Cell' =
			VAR _last         = [_K3 Last Cohort]
			VAR _m            = SELECTEDVALUE ( dim_month[month_index] )
			RETURN
			    IF ( _m <= _last && _m > _last - 6, [Cohort Retention] )
		formatString: 0%
		displayFolder: 8 Report
		lineageTag: 386e1907-4141-51d2-b916-ae591f2f2da5

	/// K3 cell fill: one hue (accent), darker = higher (A-56).
	measure 'K3 Cell Colour' =
			VAR _v            = [K3 Cell]
			VAR _t            = MIN ( DIVIDE ( _v, 0.6 ), 1 ) * 0.85 + 0.08
			VAR _digits       = "0123456789ABCDEF"
			VAR _r            = ROUND ( 255 - ( 255 - 74 ) * _t, 0 )
			VAR _g            = ROUND ( 255 - ( 255 - 87 ) * _t, 0 )
			VAR _b            = ROUND ( 255 - ( 255 - 232 ) * _t, 0 )
			RETURN
			    IF (
			        NOT ISBLANK ( _v )
			        ,"#"
			            & MID ( _digits, INT ( _r / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _r, 16 ) + 1, 1 )
			            & MID ( _digits, INT ( _g / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _g, 16 ) + 1, 1 )
			            & MID ( _digits, INT ( _b / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _b, 16 ) + 1, 1 )
			        ,"#FFFFFF"
			    )
		displayFolder: 8 Report
		lineageTag: a90a63d8-f7e9-50b3-bd16-674de2ca58d2

	/// K3 cell text colour on the fill.
	measure 'K3 Cell Ink' = IF ( [K3 Cell] >= 0.33, "#FFFFFF", "#111827" )
		displayFolder: 8 Report
		lineageTag: eead22fc-a662-5acf-a719-e387cb8a2cb2

	/// K3 caption: the guardrail pair (A-56).
	measure 'K3 Caption' =
			VAR _ym           = [Retention Cohort Month]
			RETURN
			"D7 / D30 of " & FORMAT ( DATE ( INT ( _ym / 100 ), MOD ( _ym, 100 ), 1 ), "mmm yyyy" )
			    & ": " & FORMAT ( [D7 Retention], "0%" ) & " / " & FORMAT ( [D30 Retention], "0%" ) & "   |   blank = not reportable yet   |   darker = higher"
		displayFolder: 8 Report
		lineageTag: 747033ca-d225-5b52-83f1-024d2677b77e

	/// The 3:1 LTV:CAC floor (param_target LTV_CAC).
	measure 'K2 Target' = [_T LTV_CAC]
		formatString: 0.0
		displayFolder: 8 Report
		lineageTag: 5ea67fcd-b91e-525c-8cbe-7f8e4c841e63

	/// K2 caption (A-56).
	measure 'K2 Caption' =
			VAR _by           =
			    FILTER (
			        ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), REMOVEFILTERS ( dim_channel ) ), "@l", [LTV CAC] )
			        ,NOT ISBLANK ( [@l] )
			    )
			VAR _best         = TOPN ( 1, _by, [@l], DESC, dim_channel[channel_name], ASC )
			VAR _under        = COUNTROWS ( FILTER ( _by, [@l] < [_T LTV_CAC] ) ) + 0
			RETURN
			    "Dashed line: 3:1 floor   |   best: " & LOWER ( MAXX ( _best, dim_channel[channel_name] ) ) & " " & FORMAT ( MAXX ( _best, [@l] ), "0.0" ) & "×   |   "
			        & _under & IF ( _under = 1, " channel", " channels" ) & " under the floor"
		displayFolder: 8 Report
		lineageTag: e1f5d832-b94f-558c-bc3d-02df7399051f

	/// K4 caption (A-56).
	measure 'K4 Caption' = "Refund rate " & FORMAT ( [Refund Rate], "0.0%" ) & " (target < " & FORMAT ( [_T REFUND_RATE], "0%" ) & ")   |   monthly churn " & FORMAT ( [Churn Monthly], "0.00%" ) & "   |   all channels in scope"
		displayFolder: 8 Report
		lineageTag: 51320382-77f9-59a4-b38c-398fc49e1fb1

	/// O4: per channel, share of spend (solid bar, channel colour) and share of New MRR (tinted bar), both on one scale (A-52; field-value colours do not reach multi-series bars, so the card is drawn).
	measure 'O4 Shares SVG' =
			VAR _c0           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "PAID_SEARCH" )
			    )
			VAR _s0           = MAXX ( _c0, [@s] )
			VAR _m0           = MAXX ( _c0, [@m] ) + 0
			VAR _c1           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "PAID_SOCIAL" )
			    )
			VAR _s1           = MAXX ( _c1, [@s] )
			VAR _m1           = MAXX ( _c1, [@m] ) + 0
			VAR _c2           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "APP_INSTALL" )
			    )
			VAR _s2           = MAXX ( _c2, [@s] )
			VAR _m2           = MAXX ( _c2, [@m] ) + 0
			VAR _c3           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "DISPLAY_VIDEO" )
			    )
			VAR _s3           = MAXX ( _c3, [@s] )
			VAR _m3           = MAXX ( _c3, [@m] ) + 0
			VAR _c4           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "RETARGETING" )
			    )
			VAR _s4           = MAXX ( _c4, [@s] )
			VAR _m4           = MAXX ( _c4, [@m] ) + 0
			VAR _c5           =
			    CALCULATETABLE (
			        ROW (
			            "@s", [Spend Share]
			            ,"@m", [New MRR Share]
			            ,"@c", [Channel Colour]
			            ,"@t", [Channel Tint]
			        )
			        ,KEEPFILTERS ( dim_channel[channel_code] = "AFFILIATES" )
			    )
			VAR _s5           = MAXX ( _c5, [@s] )
			VAR _m5           = MAXX ( _c5, [@m] ) + 0
			VAR _max          = MAX ( MAX ( MAX ( _s0, _s1 ), MAX ( _s2, _s3 ) ), MAX ( MAX ( _s4, _s5 ), MAX ( MAX ( _m0, _m1 ), MAX ( MAX ( _m2, _m3 ), MAX ( _m4, _m5 ) ) ) ) )
			VAR _svg          =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='112' viewBox='0 0 440 112'>"
			        & IF (
			            NOT ISBLANK ( _s0 )
