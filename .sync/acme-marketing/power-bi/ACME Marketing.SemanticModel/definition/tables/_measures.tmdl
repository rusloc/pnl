	/// Spend vs plan verdict: 1 OK within SPEND_PLAN_TOL, 3 CRIT beyond PACING_HI / PACING_LO, else 2 WARN (A-24).
	measure 'Verdict Pacing' =
			VAR _pacing       = [Pacing]
			RETURN
			    IF (
			        NOT ISBLANK ( _pacing )
			        ,SWITCH (
			            TRUE ()
			            ,ABS ( _pacing - 1 ) <= [_T SPEND_PLAN_TOL]
			                ,1
			            ,_pacing > [_T PACING_HI] || _pacing < [_T PACING_LO]
			                ,3
			            ,2
			        )
			    )
		formatString: 0
		displayFolder: 7 Comparisons
		lineageTag: e9acc1ec-2ff9-5bc0-ad52-b00668cc9543

	/// Paid Customers vs its target: 1 OK, 2 WARN within WARN_BAND_REL, 3 CRIT (up is good; never follows the comparison mode, A-24).
	measure 'Verdict Paid Customers' =
			VAR _value        = [Paid Customers]
			VAR _target       = [Customers Target]
			VAR _band         = [_T WARN_BAND_REL]
			RETURN
			    IF (
			        NOT ISBLANK ( _value )
			        ,SWITCH (
			            TRUE ()
			            ,_value >= _target
			                ,1
			            ,_value >= _target * ( 1 - _band )
			                ,2
			            ,3
			        )
			    )
		formatString: 0
		displayFolder: 7 Comparisons
		lineageTag: 90429e10-7e47-5ada-ba53-a8f35baebea4

	/// Blended CAC vs its target: 1 OK, 2 WARN within WARN_BAND_REL, 3 CRIT (down is good; never follows the comparison mode, A-24).
	measure 'Verdict Blended CAC' =
			VAR _value        = [Blended CAC]
			VAR _target       = [_T BLENDED_CAC]
			VAR _band         = [_T WARN_BAND_REL]
			RETURN
			    IF (
			        NOT ISBLANK ( _value )
			        ,SWITCH (
			            TRUE ()
			            ,_value <= _target
			                ,1
			            ,_value <= _target * ( 1 + _band )
			                ,2
			            ,3
			        )
			    )
		formatString: 0
		displayFolder: 7 Comparisons
		lineageTag: 6e2fec4e-bee4-52a0-877e-c39545485371

	/// Payback Months vs its target: 1 OK, 2 WARN within WARN_BAND_REL, 3 CRIT (down is good; never follows the comparison mode, A-24).
	measure 'Verdict Payback Months' =
			VAR _value        = [Payback Months]
			VAR _target       = [_T PAYBACK_MONTHS]
			VAR _band         = [_T WARN_BAND_REL]
			RETURN
			    IF (
			        NOT ISBLANK ( _value )
			        ,SWITCH (
			            TRUE ()
			            ,_value <= _target
