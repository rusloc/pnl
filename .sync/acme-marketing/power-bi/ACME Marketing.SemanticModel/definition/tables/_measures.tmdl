	/// Spend of every campaign in the date context (team-cost allocation base, A-38).
	measure '_b Spend All' =
			CALCULATE (
			    [_b Spend]
			    ,REMOVEFILTERS ( dim_campaign )
			    ,REMOVEFILTERS ( dim_channel )
			    ,REMOVEFILTERS ( dim_network )
			    ,REMOVEFILTERS ( dim_platform )
			    ,REMOVEFILTERS ( dim_ad_set )
			    ,REMOVEFILTERS ( dim_creative )
			)
		formatString: $#,0.00
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: 64f24a3c-3a82-5d12-a5aa-5cfe23259657

	/// Paid-team cost of the days in the date context: Σ monthly cost (valid row) ÷ days in month (A-38, data README D-2).
	measure '_b Team Pool' =
			SUMX (
			    VALUES ( dim_date[date] )
			    ,VAR _day         = dim_date[date]
			     VAR _monthly     =
			        MAXX (
			            TOPN (
			                1
			                ,FILTER (
			                    param_finance
			                    ,param_finance[metric_code] = "PAID_TEAM_COST_MONTH_USD"
			                        && param_finance[valid_from] <= _day
			                )
			                ,param_finance[valid_from], DESC
			            )
			            ,param_finance[value]
			        )
			     RETURN
			        DIVIDE ( _monthly, DAY ( EOMONTH ( _day, 0 ) ) )
			)
		formatString: $#,0.00
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: b8de7629-fa17-525d-a33f-5a88a826266a

	/// Team cost allocated to the scope pro rata to its share of the ALL spend (A-38).
	measure '_b Team Cost' = [_b Team Pool] * DIVIDE ( [_b Spend], [_b Spend All] )
		formatString: $#,0.00
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: 3c071385-b728-51a3-8a8b-8bd932f39e44

