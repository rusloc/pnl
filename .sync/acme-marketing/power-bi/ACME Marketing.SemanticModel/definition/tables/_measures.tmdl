	/// Σ new_mrr_usd under "DDA" (A-39).
	measure '_b New MRR DDA' =
			CALCULATE (
			    SUM ( fact_attribution_day[new_mrr_usd] )
			    ,TREATAS ( { "DDA" }, dim_attribution_model[model_code] )
			)
