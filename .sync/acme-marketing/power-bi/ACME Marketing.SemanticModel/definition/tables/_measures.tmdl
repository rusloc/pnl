	/// Term sign-ups of the selected campaign (P5).
	measure 'P5 Conv' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        [Term Signups]
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
