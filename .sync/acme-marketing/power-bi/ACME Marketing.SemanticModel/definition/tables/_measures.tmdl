	/// Σ paid_customers under "DDA" (A-37; the model switch applies to paid customers and New MRR only, A-16).
	measure '_b Paid DDA' =
			CALCULATE (
			    SUM ( fact_attribution_day[paid_customers] )
			    ,TREATAS ( { "DDA" }, dim_attribution_model[model_code] )
