	/// 1 .. 5: the channel's place among the five with the most refunds in the scope; blank otherwise (P7).
	measure 'P7 Rank' =
			VAR _me           = SELECTEDVALUE ( dim_channel[channel_code] )
			VAR _by           =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( dim_channel[channel_code] )
			                ,"@v", [Refunds]
			            )
			            ,[@v] > 0
			        )
			        ,REMOVEFILTERS ( dim_channel[channel_code] )
			        ,REMOVEFILTERS ( dim_channel[channel_name] )
			        ,REMOVEFILTERS ( dim_channel[sort_order] )
			    )
			VAR _mine         = MAXX ( FILTER ( _by, dim_channel[channel_code] = _me ), [@v] )
			VAR _ahead        = COUNTROWS ( FILTER ( _by, [@v] > _mine ) ) + 0
			RETURN
			    IF ( NOT ISBLANK ( _mine ) && _ahead < 5, _ahead + 1 )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 93555f2f-a34d-5235-aa56-e29a6fb681e3

	/// 1 for the five channels P7 draws (visual filter).
	measure 'P7 Visible' = IF ( NOT ISBLANK ( [P7 Rank] ), 1, 0 )
