			        ,"PLAN"
			            ,[Customers Target]
			        ,"NONE"
			            ,BLANK ()
			        ,[Paid Customers Cmp]
			    )
			RETURN
			    DIVIDE ( [Paid Customers] - _base, _base )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7 Comparisons
		lineageTag: 0ffdeadd-47d3-54d9-8e64-f7f4572408c8

