	/// The story's event day (ADR-0015 (d), A-52 / A-63: paid CAC steps up and mobile paid-social trial → paid breaks on Oct 18). An annotation of the dataset, like the O3 / P2 constant line: the noisy daily CAC makes the largest 7-day step fall on Oct 17, so the day is not detected.
	measure 'Story Step Date' = DATE ( 2026, 10, 18 )
		formatString: yyyy-mm-dd
		displayFolder: 6 Diagnostics
		lineageTag: a4c877e3-00aa-55a5-af8f-35cf6f14344f

	/// 7-day mean of daily paid CAC from the step day ÷ the 7 days before − 1 (story +20 %, AT-08).
	measure 'Story CAC Step' =
			VAR _d            = [Story Step Date]
			VAR _cac          =
			    ADDCOLUMNS (
			        FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _d - 7 && dim_date[date] <= _d + 6 )
			        ,"@cac", CALCULATE ( [_x CPA] )
			    )
			VAR _after        = AVERAGEX ( FILTER ( _cac, dim_date[date] >= _d ), [@cac] )
			VAR _before       = AVERAGEX ( FILTER ( _cac, dim_date[date] < _d ), [@cac] )
			RETURN
			    DIVIDE ( _after, _before ) - 1
		formatString: +0.0%;-0.0%
		displayFolder: 6 Diagnostics
		lineageTag: e55a880c-8b90-58f3-9b8b-1ad6c6d46d9d

	/// True count of the funnel stage (O1).
	measure 'Funnel Value' =
			SWITCH (
			    SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			    ,"IMP"
			        ,[Impressions]
			    ,"CLK"
			        ,[Clicks]
			    ,"LAND"
			        ,[Landed]
			    ,"SIGNUP"
			        ,[Signups]
			    ,"ACT"
			        ,[Activated]
			    ,"TRIAL"
			        ,[Trials]
			    ,"PAID"
			        ,[Paid Customers]
			)
		formatString: #,0
		displayFolder: 8 Report
		lineageTag: 3bde2cba-8679-5364-9bbf-595f4baa7500

	/// Label beside the funnel bar: true count and the stage's rate or cost (O1).
	measure 'Funnel Label' =
			VAR _v            = [Funnel Value]
			VAR _txt          = IF ( _v >= 1000000, FORMAT ( _v / 1000000, "0.0" ) & "M", IF ( _v >= 10000, FORMAT ( _v / 1000, "#,0.0" ) & "k", FORMAT ( _v, "#,0" ) ) )
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( dim_funnel_stage[stage_code] )
			        ,"IMP"
			            ,_txt & "  |  CPM $" & FORMAT ( [CPM], "0.0" )
			        ,"CLK"
			            ,_txt & "  |  CTR " & FORMAT ( [CTR], "0.00%" ) & " | CPC $" & FORMAT ( [CPC], "0.00" )
			        ,"LAND"
			            ,_txt & "  |  " & IF ( [Sessions] >= 1000000, FORMAT ( [Sessions] / 1000000, "0.0" ) & "M", IF ( [Sessions] >= 10000, FORMAT ( [Sessions] / 1000, "#,0.0" ) & "k", FORMAT ( [Sessions], "#,0" ) ) ) & " web + " & IF ( [Installs] >= 1000000, FORMAT ( [Installs] / 1000000, "0.0" ) & "M", IF ( [Installs] >= 10000, FORMAT ( [Installs] / 1000, "#,0.0" ) & "k", FORMAT ( [Installs], "#,0" ) ) ) & " installs"
			        ,"SIGNUP"
			            ,_txt & "  |  " & FORMAT ( [Click Signup Rate], "0.0%" ) & " of clicks | CPL $" & FORMAT ( [CPL], "#,0" )
			        ,"ACT"
			            ,_txt & "  |  " & FORMAT ( [Activation Rate], "0%" ) & " | $" & FORMAT ( [Cost per Activated], "#,0" )
			        ,"TRIAL"
			            ,_txt & "  |  " & FORMAT ( [Trial Rate], "0%" ) & " of sign-ups"
			        ,"PAID"
			            ,FORMAT ( _v, "#,0" ) & "  |  " & FORMAT ( [Trial to Paid], "0.0%" ) & " of trials | CPA $" & FORMAT ( [CPA], "#,0" )
			    )
		displayFolder: 8 Report
		lineageTag: 6022f8cb-ee76-546c-a72d-182321e5590d

	/// Bar width of the funnel: log10 of the stage count; its format string prints the true-value label (ADR-0015 platform limit 8).
	measure 'Funnel Log' = VAR _v = [Funnel Value] RETURN IF ( _v > 0, LOG10 ( _v ) )
		displayFolder: 8 Report
		lineageTag: 2da30754-ef1f-5d79-908f-de8648e41a5f

		formatStringDefinition =
				VAR _t           = SUBSTITUTE ( [Funnel Label], """", "'" )
				RETURN
				    """" & _t & """;""" & _t & """"

	/// Value-axis end of the funnel: leaves room for the labels.
	measure 'Funnel Axis Max' = MAXX ( ALL ( dim_funnel_stage ), [Funnel Log] ) * 1.85
		formatString: 0.00
		displayFolder: 8 Report
		lineageTag: b5c1e534-99c6-5c2d-a5bd-00895cea00e2

	/// O1 caption: trial → paid and click → sign-up with their Δ (pt) and the cost per paid customer (A-52).
	measure 'O1 Caption' =
			VAR _tp_d         = [Trial to Paid Δ]
			VAR _cs_d         = [Click Signup Rate Δ]
			RETURN
			    "Trial → paid " & FORMAT ( [Trial to Paid], "0.0%" ) & IF ( NOT ISBLANK ( _tp_d ), " (" & IF ( _tp_d < 0, "−", "+" ) & FORMAT ( ABS ( _tp_d ) * 100, "0.0" ) & " pt" & ")" )
			        & "   |   Click → sign-up " & FORMAT ( [Click Signup Rate], "0.0%" ) & IF ( NOT ISBLANK ( _cs_d ), " (" & IF ( _cs_d < 0, "−", "+" ) & FORMAT ( ABS ( _cs_d ) * 100, "0.0" ) & " pt" & ")" )
			        & "   |   Cost per paid $" & FORMAT ( [CPA], "#,0" )
		displayFolder: 8 Report
		lineageTag: 42e7098f-96ae-55a1-a743-c5b05b206816

	/// Web stage conversion from the previous stage (C2): CTR, sessions ÷ clicks, sign-ups ÷ sessions, activation, trial, trial → paid.
	measure 'C2 Web Rate' =
			VAR _stage        = SELECTEDVALUE ( dim_c2_stage[stage_code] )
			RETURN
			    CALCULATE (
			        SWITCH (
			            _stage
			            ,"CLICK"
			                ,[CTR]
			            ,"LAND"
			                ,DIVIDE ( [Sessions], [Clicks] )
			            ,"SIGNUP"
			                ,DIVIDE ( [Signups], [Sessions] )
			            ,"ACT"
			                ,[Activation Rate]
			            ,"TRIAL"
			                ,[Trial Rate]
			            ,"PAID"
			                ,[Trial to Paid]
			        )
			        ,KEEPFILTERS ( dim_platform[platform_code] = "WEB" )
			    )
		formatString: 0.0%
		displayFolder: 8 Report
		lineageTag: 7b34ca5f-305b-52f6-8884-e9ebac7a81d4

	/// App (iOS + Android) stage conversion from the previous stage (C2): CTR, store views ÷ clicks, installs ÷ store views, sign-ups ÷ installs, then activation, trial, trial → paid.
	measure 'C2 App Rate' =
			VAR _stage        = SELECTEDVALUE ( dim_c2_stage[stage_code] )
			RETURN
			    CALCULATE (
			        SWITCH (
			            _stage
			            ,"CLICK"
			                ,[CTR]
			            ,"LAND"
			                ,DIVIDE ( [Store Views], [Clicks] )
			            ,"INSTALL"
			                ,[Store CVR]
			            ,"SIGNUP"
			                ,DIVIDE ( [Signups], [Installs] )
			            ,"ACT"
			                ,[Activation Rate]
			            ,"TRIAL"
			                ,[Trial Rate]
			            ,"PAID"
			                ,[Trial to Paid]
			        )
			        ,KEEPFILTERS ( dim_platform[platform_code] IN { "IOS", "ANDROID" } )
			    )
		formatString: 0.0%
		displayFolder: 8 Report
		lineageTag: 6a41f377-8241-578d-ab3c-41074e872bf4

	/// C2 caption (A-53).
	measure 'C2 Caption' =
			"Store → install " & FORMAT ( [Store CVR], "0.0%" ) & "   |   install → sign-up " & FORMAT ( [Install Signup Rate], "0.0%" )
			    & "   |   web landing → sign-up " & FORMAT ( [Landing Signup Rate], "0.0%" )
		displayFolder: 8 Report
		lineageTag: de724fa1-59fc-55e1-aac8-94b4296325b2

	/// C3 caption: the scope's over-claim and the channel that over-claims most (A-53).
	measure 'C3 Caption' =
			VAR _by_channel   =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), REMOVEFILTERS ( dim_channel ) )
			        ,"@gap", [Attribution Gap]
			    )
			VAR _top          = TOPN ( 1, _by_channel, [@gap], DESC, dim_channel[channel_name], ASC )
			RETURN
			    "Average over-claim " & FORMAT ( CALCULATE ( [Attribution Gap], REMOVEFILTERS ( dim_channel ) ), "+0%;-0%" )
			        & "   |   highest: " & LOWER ( MAXX ( _top, dim_channel[channel_name] ) ) & " " & FORMAT ( MAXX ( _top, [@gap] ), "+0%;-0%" )
		displayFolder: 8 Report
		lineageTag: 2b062866-aa3e-50f9-854d-7d1b391dd566

	/// C4 bar colour: crit above PACING_HI, warn below PACING_LO, neutral otherwise (AT-11).
	measure 'Pacing Colour' =
			VAR _pacing       = [Pacing]
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_pacing > [_T PACING_HI]
			            ,"#D93B4B"
			        ,_pacing < [_T PACING_LO]
			            ,"#C47A0E"
			        ,"#8A94A6"
			    )
		displayFolder: 8 Report
		lineageTag: 0c5d175d-ca99-57d2-b4eb-825702ce9901

	/// C4 bar label.
	measure 'C4 Label' = FORMAT ( [Pacing], "0%" ) & "  |  " & "$" & FORMAT ( [Spend] / 1000, "#,0.0" ) & "k" & " of " & "$" & FORMAT ( [Plan] / 1000, "#,0.0" ) & "k"
		displayFolder: 8 Report
		lineageTag: b1be60e1-082e-5ae5-9eee-826d6094f66a

	/// Pacing as the C4 bar; its format string prints the label (spend of plan).
	measure 'C4 Pacing Bar' = [Pacing]
		displayFolder: 8 Report
		lineageTag: 6a914305-5a48-5872-a368-35c387caea6a

		formatStringDefinition =
				VAR _t           = SUBSTITUTE ( [C4 Label], """", "'" )
				RETURN
				    """" & _t & """;""" & _t & """"

	/// C4 question with the window day count (AT-11: day 30 of 30 for R30, day 3 of 30 for MTD Nov).
	measure 'C4 Question' =
			VAR _days         = [_Win Days]
			VAR _end          = [_Win End]
			VAR _preset       = [_Preset]
			VAR _of           =
			    SWITCH (
			        _preset
			        ,"MTD"
			            ,DAY ( EOMONTH ( _end, 0 ) )
			        ,"QTD"
			            ,INT ( EOMONTH ( DATE ( YEAR ( _end ), QUARTER ( _end ) * 3, 1 ), 0 ) - DATE ( YEAR ( _end ), ( QUARTER ( _end ) - 1 ) * 3 + 1, 1 ) ) + 1
			        ,_days
			    )
			RETURN
			    "Who is ahead or behind plan at day " & _days & " of " & _of & "?"
		displayFolder: 8 Report
		lineageTag: f254e554-b5a9-5455-8e3a-f6173a3f1274

	/// C4 caption.
	measure 'C4 Caption' = "Plan " & "$" & FORMAT ( [Plan] / 1000, "#,0.0" ) & "k" & "   |   spend " & "$" & FORMAT ( [Spend] / 1000, "#,0.0" ) & "k" & " (" & FORMAT ( [Pacing], "0%" ) & " of plan)"
		displayFolder: 8 Report
		lineageTag: 8de41869-5936-50cb-aef3-ea6c155d24dd

	/// Share of the scope's spend (C1 share, O4).
	measure 'Spend Share' =
			DIVIDE (
			    [Spend]
			    ,CALCULATE ( [Spend], REMOVEFILTERS ( dim_channel ), REMOVEFILTERS ( dim_platform[platform_label] ) )
			)
		formatString: 0.0%
		displayFolder: 1 Spend & delivery
		lineageTag: f0180f8d-b99d-5642-9bc1-3608f762c13f

	/// Share of the scope's New MRR (O4).
	measure 'New MRR Share' =
			DIVIDE (
			    [New MRR]
			    ,CALCULATE ( [New MRR], REMOVEFILTERS ( dim_channel ), REMOVEFILTERS ( dim_platform[platform_label] ) )
			)
		formatString: 0.0%
		displayFolder: 3 Customers & revenue
		lineageTag: d45d2081-01d5-583f-bab5-b93ff6c9a431

	/// The channel's fixed colour (dim_channel.color_light, A-58).
	measure 'Channel Colour' = SELECTEDVALUE ( dim_channel[color_light], "#4A57E8" )
		displayFolder: 8 Report
		lineageTag: a7151477-e4b7-5d0d-9f9d-482ca4d93fa7

	/// The channel colour mixed 55 % with white (O4 New-MRR bars, paired with the solid spend bars).
	measure 'Channel Tint' =
			VAR _hex          = SELECTEDVALUE ( dim_channel[color_light], "#4A57E8" )
			VAR _digits       = "0123456789ABCDEF"
			VAR _r            = ( SEARCH ( MID ( _hex, 2, 1 ), _digits ) - 1 ) * 16 + SEARCH ( MID ( _hex, 3, 1 ), _digits ) - 1
			VAR _g            = ( SEARCH ( MID ( _hex, 4, 1 ), _digits ) - 1 ) * 16 + SEARCH ( MID ( _hex, 5, 1 ), _digits ) - 1
			VAR _b            = ( SEARCH ( MID ( _hex, 6, 1 ), _digits ) - 1 ) * 16 + SEARCH ( MID ( _hex, 7, 1 ), _digits ) - 1
			VAR _r2           = ROUND ( _r + ( 255 - _r ) * 0.55, 0 )
			VAR _g2           = ROUND ( _g + ( 255 - _g ) * 0.55, 0 )
			VAR _b2           = ROUND ( _b + ( 255 - _b ) * 0.55, 0 )
			RETURN
			    "#"
			        & MID ( _digits, INT ( _r2 / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _r2, 16 ) + 1, 1 )
			        & MID ( _digits, INT ( _g2 / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _g2, 16 ) + 1, 1 )
			        & MID ( _digits, INT ( _b2 / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _b2, 16 ) + 1, 1 )
		displayFolder: 8 Report
		lineageTag: c8f6c399-b386-5f74-9fa0-62a110f4c76e

	/// O4 caption: the channel whose spend share most exceeds its New-MRR share (A-52).
	measure 'O4 Caption' =
			VAR _by_channel   =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( dim_channel[channel_name] ), REMOVEFILTERS ( dim_channel ) )
			        ,"@spend", [Spend Share]
			        ,"@mrr", [New MRR Share]
			    )
			VAR _worst        = TOPN ( 1, FILTER ( _by_channel, NOT ISBLANK ( [@spend] ) ), [@spend] - [@mrr], DESC, dim_channel[channel_name], ASC )
			RETURN
			    MAXX ( _worst, dim_channel[channel_name] ) & " takes " & FORMAT ( MAXX ( _worst, [@spend] ), "0%" ) & " of spend for "
			        & FORMAT ( MAXX ( _worst, [@mrr] ), "0%" ) & " of new MRR"
		displayFolder: 8 Report
		lineageTag: 98e262c4-7a4a-5d26-945f-9cdf5d5ec136

	/// O3 caption: spend vs plan and the CAC step day (A-52).
	measure 'O3 Caption' =
			VAR _step         = [Story Step Date]
			VAR _delta        = DIVIDE ( [Spend] - [Plan], [Plan] )
			RETURN
			    "Spend " & "$" & FORMAT ( [Spend] / 1000, "#,0.0" ) & "k" & " vs plan " & "$" & FORMAT ( [Plan] / 1000, "#,0.0" ) & "k" & " (" & IF ( _delta < 0, "−", "+" ) & FORMAT ( ABS ( _delta ), "0.0%" ) & ")"
			        & IF ( NOT ISBLANK ( _step ), "   |   CAC stepped up on " & FORMAT ( _step, "mmm d" ) & " (" & FORMAT ( [Story CAC Step], "+0%;-0%" ) & ")" )
		displayFolder: 8 Report
		lineageTag: ade42f9e-030e-5869-8c6b-09c281a122a6

	/// O5 caption.
	measure 'O5 Caption' =
			VAR _n            = [Alerts Tripped]
			VAR _crit         = SUMX ( FILTER ( dim_alert_slot, dim_alert_slot[severity] = "CRIT" ), [Alert Tripped] )
			RETURN
			    _n & IF ( _n = 1, " alert", " alerts" ) & " in the window   |   " & _crit & " critical"
		displayFolder: 8 Report
		lineageTag: 2f2e1ec6-4fc5-5241-8de2-8660beb20750

	/// O6 caption.
	measure 'O6 Caption' = "Δ ROAS 90 d vs " & IF ( [_Cmp] = "LY", "the same period last year", "the previous period" ) & "   |   three best, three worst"
		displayFolder: 8 Report
		lineageTag: 8f447575-fa03-5eb3-a237-afeee049d959

	/// O2 caption.
	measure 'O2 Caption' = "Markers = targets (param_target)   |   model " & LOWER ( [_Model Name] )
		displayFolder: 8 Report
		lineageTag: 3daa61c7-73ac-5de8-8e03-2c771cde551d

	/// C1 caption.
	measure 'C1 Caption' = "Click a row to scope the cards below and the Campaigns view   |   flags from each channel's targets"
		displayFolder: 8 Report
		lineageTag: 8f5220ce-d54e-58cc-8f0c-caffb075e4bc

	/// P1 and Campaigns-pane rows: Live + Learning by default; every status once Status is picked (A-12, AT-04, AT-22).
	measure 'P1 Row Visible' =
			VAR _status       = SELECTEDVALUE ( dim_campaign[status_code] )
			RETURN
			    IF ( ISFILTERED ( dim_campaign[status_name] ) || _status IN { "LIVE", "LEARNING" }, 1, 0 )
		formatString: 0
		displayFolder: 8 Report
		lineageTag: 9faeb950-f939-5a23-b051-16233c44da72

	/// TRUE for Lead and Retention objectives (CPA / ROAS shown as —).
	measure 'P1 No Goal' = SELECTEDVALUE ( dim_campaign[objective_code] ) IN { "LEAD", "RETENTION" }
		isHidden
		displayFolder: 9 Engine
		lineageTag: 67b09110-7e0e-5cb3-8f0a-8edf5aa5e4ec

	/// CPA cell of the campaign table; — for Lead / Retention (A-54).
	measure 'P1 CPA' = IF ( [P1 Row Visible] = 1 && NOT ISBLANK ( [Spend] ), IF ( [P1 No Goal], 0, [CPA] ) )
		displayFolder: 8 Report
		lineageTag: 185619e9-af2d-570c-98f2-e8c2c4719550

		formatStringDefinition = IF ( [P1 No Goal], """—""", "$#,0" )

	/// ROAS 90 d cell of the campaign table; — for Lead / Retention (A-54).
	measure 'P1 ROAS' = IF ( [P1 Row Visible] = 1 && NOT ISBLANK ( [Spend] ), IF ( [P1 No Goal], 0, [ROAS 90d] ) )
		displayFolder: 8 Report
		lineageTag: 4566b257-d63d-5bc5-9266-c4457866c59e

		formatStringDefinition = IF ( [P1 No Goal], """—""", "0.00" )

	/// Campaign-table cell: [Spend] for Live + Learning campaigns (every status once Status is picked; A-54, AT-04).
	measure 'P1 Spend' = IF ( [P1 Row Visible] = 1, [Spend] )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: 3f6a253f-4dd4-536e-b799-d83f709fe5b3

	/// Campaign-table cell: [Pacing] for Live + Learning campaigns (every status once Status is picked; A-54, AT-04).
	measure 'P1 Pacing' = IF ( [P1 Row Visible] = 1, [Pacing] )
		formatString: 0%
		displayFolder: 8 Report
		lineageTag: 87a87c74-17cf-5961-8f7c-fa5f9e89c257

	/// Campaign-table cell: [CTR Slope 7d] for Live + Learning campaigns (every status once Status is picked; A-54, AT-04).
	measure 'P1 Slope' = IF ( [P1 Row Visible] = 1, [CTR Slope 7d] )
		formatString: +0%;-0%;0%
		displayFolder: 8 Report
		lineageTag: 05bee9cd-7827-5166-a9fa-f186698dbc36

	/// Campaign-table cell: [Frequency 7d] for Live + Learning campaigns (every status once Status is picked; A-54, AT-04).
	measure 'P1 Frequency' = IF ( [P1 Row Visible] = 1, [Frequency 7d] )
		formatString: 0.0
		displayFolder: 8 Report
		lineageTag: 644f5f14-374b-527a-82ee-43158fefe039

	/// Campaign-table cell: [Flags Text] for Live + Learning campaigns (every status once Status is picked; A-54, AT-04).
	measure 'P1 Flags' = IF ( [P1 Row Visible] = 1, [Flags Text] )
		displayFolder: 8 Report
		lineageTag: f0e2bd42-387e-5929-91ac-f8796c5f9cd4

	/// P1 caption.
	measure 'P1 Caption' =
			VAR _n            = COUNTROWS ( FILTER ( VALUES ( dim_campaign[campaign_key] ), [P1 Row Visible] = 1 && [Spend] > 0 ) )
			RETURN
			    _n & " campaigns with spend   |   sorted by spend   |   flags from each campaign's own targets"
		displayFolder: 8 Report
		lineageTag: c17378ec-3006-5ec9-bb39-062552737d10

	/// P2 title: the selected campaign (A-54).
	measure 'P2 Title' = "Selected | " & [Selected Campaign Name]
		displayFolder: 8 Report
		lineageTag: 1caa9af0-6153-5602-bd71-6ea2660207f8

	/// P2 caption: CPA vs target and the learning-phase end (A-54).
	measure 'P2 Caption' =
			VAR _key          = [_Selected Campaign]
			VAR _row          =
			    CALCULATETABLE (
			        ROW (
			            "@cpa", [CPA]
			            ,"@target", [CPA Target]
			            ,"@status", SELECTEDVALUE ( dim_campaign[status_code] )
			            ,"@learn", SELECTEDVALUE ( dim_campaign[learning_end_date] )
			        )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
			VAR _cpa          = MAXX ( _row, [@cpa] )
			VAR _target       = MAXX ( _row, [@target] )
			VAR _status       = MAXX ( _row, [@status] )
			VAR _learn        = MAXX ( _row, [@learn] )
			RETURN
			    IF ( NOT ISBLANK ( _cpa ), "CPA $" & FORMAT ( _cpa, "#,0" ) & IF ( NOT ISBLANK ( _target ), " (target $" & FORMAT ( _target, "#,0" ) & ")" ), "No paid conversions" )
			        & "   |   " & IF ( _status = "LEARNING", "Learning phase ends ", "Learning phase ended " ) & FORMAT ( _learn, "mmm d" )
		displayFolder: 8 Report
		lineageTag: c6c14ee5-eec3-5775-bf6a-95cdae0d2bb4

	/// P3 caption.
	measure 'P3 Caption' = "Dashed line: campaign CPA target $" & FORMAT ( [P3 CPA Target], "#,0" ) & "   |   DDA credits"
		displayFolder: 8 Report
		lineageTag: 7b2adf7b-a630-523d-8ca5-3ab2e5722e37

	/// P4 caption: the fatigue rule from param_target (A-54).
	measure 'P4 Caption' =
			"Fatigued when the CTR 7-day slope is below " & FORMAT ( [_T FATIGUE_SLOPE], "0%" ) & " and frequency above " & FORMAT ( [_T FATIGUE_FREQ], "0" )
			    & "   |   Watch: slope below 0 at frequency above " & FORMAT ( [_T WATCH_FREQ], "0.0" )
		displayFolder: 8 Report
		lineageTag: ea63a5ed-7d03-5784-b2fc-83e033f8ccdd

	/// P5 caption: keywords for search campaigns, placements for the others (AT-09).
	measure 'P5 Caption' =
			VAR _key          = [_Selected Campaign]
			VAR _channel      = CALCULATE ( SELECTEDVALUE ( dim_campaign[channel_code] ), REMOVEFILTERS ( dim_campaign ), dim_campaign[campaign_key] = _key )
			RETURN
			    IF ( _channel = "PAID_SEARCH" || _key = "APP_ASA_CORE", "Keywords of ", "Placements and audiences of " ) & [Selected Campaign Name]
		displayFolder: 8 Report
		lineageTag: a481eb1d-cc81-5f90-96fe-e66db4a4b6ae

	/// 1 for the selected campaign's creatives live on the window's last day (P4 rows).
	measure 'P4 Row Visible' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    IF ( CALCULATE ( [_Creative Live], TREATAS ( { _key }, dim_campaign[campaign_key] ) ), 1, 0 )
		formatString: 0
		displayFolder: 8 Report
		lineageTag: 5a35ff38-580e-5757-a60a-456504e48c07

	/// Active non-period filter groups (Filters badge).
	measure '_Filter Count' =
			INT ( ISFILTERED ( dim_platform[platform_name] ) )
			    + INT ( ISFILTERED ( dim_campaign[market_name] ) )
			    + INT ( ISFILTERED ( dim_campaign[tier_name] ) )
			    + INT ( ISFILTERED ( dim_campaign[channel_name] ) || ISFILTERED ( dim_campaign[network_name] ) )
			    + INT ( ISFILTERED ( dim_campaign[campaign_name] ) )
			    + INT ( ISFILTERED ( dim_campaign[status_name] ) )
			    + INT ( [_Model] <> "DDA" )
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 50d77394-e397-574e-82a5-48c1dc3e7060

	/// Chips line: one segment per active non-default filter + 'Selected:' for a cross-filter, ' | ' as separator; blank with the defaults (A-14).
	measure 'Chips Line' =
			VAR _platform     = IF ( ISFILTERED ( dim_platform[platform_name] ), "Platform: " & CONCATENATEX ( VALUES ( dim_platform ), dim_platform[platform_name], " + ", dim_platform[sort_order], ASC ) & " | " )
			VAR _market       = IF (
			        ISFILTERED ( dim_campaign[market_name] )
			        ,"Market: " & CONCATENATEX ( VALUES ( dim_campaign[market_name] ), dim_campaign[market_name], " + ", dim_campaign[market_name], ASC ) & " | "
			    )
			VAR _tier         = IF (
			        ISFILTERED ( dim_campaign[tier_name] )
			        ,"Tier: " & CONCATENATEX ( VALUES ( dim_campaign[tier_name] ), dim_campaign[tier_name], " + ", dim_campaign[tier_name], ASC ) & " | "
			    )
			VAR _channel      = IF (
			        ISFILTERED ( dim_campaign[channel_name] )
			        ,"Channel: " & CONCATENATEX ( VALUES ( dim_campaign[channel_name] ), dim_campaign[channel_name], " + ", dim_campaign[channel_name], ASC ) & " | "
			    )
			VAR _network      = IF (
			        ISFILTERED ( dim_campaign[network_name] )
			        ,"Network: " & CONCATENATEX ( VALUES ( dim_campaign[network_name] ), dim_campaign[network_name], " + ", dim_campaign[network_name], ASC ) & " | "
			    )
			VAR _campaigns    = IF ( ISFILTERED ( dim_campaign[campaign_name] ), "Campaign: " & IF ( COUNTROWS ( VALUES ( dim_campaign[campaign_name] ) ) = 1, VALUES ( dim_campaign[campaign_name] ), COUNTROWS ( VALUES ( dim_campaign[campaign_name] ) ) & " picked" ) & " | " )
			VAR _status       = IF (
			        ISFILTERED ( dim_campaign[status_name] )
			        ,"Status: " & CONCATENATEX ( VALUES ( dim_campaign[status_name] ), dim_campaign[status_name], " + ", dim_campaign[status_name], ASC ) & " | "
			    )
			VAR _model        = IF ( [_Model] <> "DDA", "Attribution: " & [_Model Name] & " | " )
			VAR _selected     =
			    SWITCH (
			        TRUE ()
			        ,ISFILTERED ( dim_campaign[campaign_label] )
			            ,"Selected: " & CONCATENATEX ( VALUES ( dim_campaign[campaign_label] ), dim_campaign[campaign_label], " + " ) & " | "
			        ,ISFILTERED ( dim_channel[channel_name] )
			            ,"Selected: " & CONCATENATEX ( VALUES ( dim_channel[channel_name] ), dim_channel[channel_name], " + " )
			                & IF ( ISFILTERED ( dim_platform[platform_label] ), " | " & CONCATENATEX ( VALUES ( dim_platform[platform_label] ), dim_platform[platform_label], " + " ) )
			                & " | "
			    )
			VAR _line         = _platform & _market & _tier & _channel & _network & _campaigns & _status & _model & _selected
			RETURN
			    IF ( LEN ( _line ) > 0, LEFT ( _line, LEN ( _line ) - 3 ), " " )
		displayFolder: 8 Report
		lineageTag: 59c32868-e461-5989-9531-488d714aa9b1

	/// Period pill: window dates and the comparison basis (A-50).
	measure 'Period Pill Text' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _mode         = [_Cmp]
			VAR _days         = [_Win Days]
			VAR _basis        =
			    SWITCH (
			        _mode
			        ,"PREV"
			            ,"vs prior " & _days & " d"
			        ,"LY"
			            ,"vs same period LY"
			        ,"PLAN"
			            ,"vs plan"
			        ,"no comparison"
			    )
			RETURN
			    FORMAT ( _start, "mmm d" ) & " – " & FORMAT ( _end, "mmm d" ) & IF ( YEAR ( _end ) <> YEAR ( [_As Of] ), " " & YEAR ( _end ) ) & "  |  " & _basis
		displayFolder: 8 Report
		lineageTag: 5c8da396-aed8-521e-ab86-0f0d401827a6

	/// Header freshness text: age of the oldest hourly source, whole hours (A-17).
	measure 'Synced Text' =
			VAR _h            = [Synced Hours Ago]
			RETURN
			    "Synced " & IF ( _h < 1, "under 1 h", INT ( _h ) & " h" ) & " ago"
		displayFolder: 8 Report
		lineageTag: ecfbb9bd-bc38-5a85-bf26-e27ccb857718

	/// Freshness dot colour.
	measure 'Freshness Colour' = SWITCH ( [Freshness Dot], 3, "#D93B4B", 2, "#C47A0E", "#1E9E6A" )
		displayFolder: 8 Report
		lineageTag: 60587e23-8339-5a62-b173-9f90981d1365

	/// Footer strip: model, currency, last sync per source (A-50).
	measure 'Footer Line' =
			VAR _model        = [_Model Name]
			VAR _sources      =
			    CONCATENATEX (
			        ALL ( sync_log )
			        ,SWITCH ( sync_log[source_code], "AD_PLATFORMS", "Ad platforms", "WEB_ANALYTICS", "Web analytics", "PRODUCT_EVENTS", "Product events", "ATTRIBUTION", "Attribution", sync_log[source_name] )
			            & " " & FORMAT ( sync_log[last_sync_ts], "hh:nn" )
			        ," | "
			        ,sync_log[last_sync_ts], DESC
			    )
			RETURN
			    "Attribution: " & _model & ", 30-day click / 1-day view   |   Currency: USD   |   " & _sources & "   |   Figures are illustrative"
		displayFolder: 8 Report
		lineageTag: 2251e2cb-39d6-5a99-a5c7-1ac49ad06c58

	/// Filters button label with the active-count badge (A-50).
	measure 'Filters Button Text' =
			VAR _n            = [_Filter Count]
			RETURN
			    "Filters" & IF ( _n > 0, "  " & _n )
		displayFolder: 8 Report
		lineageTag: 8188ff09-281b-5469-a7b3-2bace7be4c6e

	/// Applied state of the Filters window as '|'-separated lines (PATHITEM); a divider inside a line is written '¦' and drawn as '|' by the SVG (A-57: shown instead of a live preview).
	measure 'Applied State' =
			VAR _period       = SUBSTITUTE ( [Period Pill Text], "|", "¦" )
			VAR _platform     = IF ( ISFILTERED ( dim_platform[platform_name] ), CONCATENATEX ( VALUES ( dim_platform ), dim_platform[platform_name], " + ", dim_platform[sort_order], ASC ), "all platforms" )
			VAR _channel      = IF ( ISFILTERED ( dim_campaign[channel_name] ) || ISFILTERED ( dim_campaign[network_name] ), CONCATENATEX ( VALUES ( dim_campaign[channel_name] ), dim_campaign[channel_name], " + ", dim_campaign[channel_name], ASC ), "all channels" )
			VAR _market       = IF ( ISFILTERED ( dim_campaign[market_name] ), CONCATENATEX ( VALUES ( dim_campaign[market_name] ), dim_campaign[market_name], " + " ), "all markets" )
			VAR _tier         = IF ( ISFILTERED ( dim_campaign[tier_name] ), CONCATENATEX ( VALUES ( dim_campaign[tier_name] ), dim_campaign[tier_name], " + " ), "all tiers" )
			VAR _status       = IF ( ISFILTERED ( dim_campaign[status_name] ), CONCATENATEX ( VALUES ( dim_campaign[status_name] ), dim_campaign[status_name], " + " ), "Live + Learning (list)" )
			VAR _model        = [_Model Name]
			VAR _active       =
			    CALCULATETABLE (
			        FILTER ( VALUES ( dim_campaign[campaign_key] ), [Spend] > 0 )
			    )
			VAR _n_campaigns  = COUNTROWS ( _active )
			VAR _n_channels   = COUNTROWS ( SUMMARIZE ( FILTER ( dim_campaign, dim_campaign[campaign_key] IN _active ), dim_campaign[channel_code] ) )
			VAR _n_platforms  = COUNTROWS ( SUMMARIZE ( FILTER ( dim_campaign, dim_campaign[campaign_key] IN _active ), dim_campaign[platform_code] ) )
			RETURN
			    _period & "|" & _platform & "|" & _market & " ¦ " & _tier & "|" & _channel & "|" & _status & "|" & _model & "|"
			        & _n_campaigns + 0 & " campaigns ¦ " & _n_channels + 0 & " channels|" & _n_platforms + 0 & " platforms"
		isHidden
		displayFolder: 9 Engine
		lineageTag: 97fdb6ae-bb3a-5741-96d5-f8708ca2f935

	/// The ⓘ glyph of every card (hover target for tt_card_info, A-51).
	measure 'Info Glyph' = "i"
