	/// Blended CAC ÷ (ARPA × gross margin) (A-40).
	measure '_x Payback Months' = DIVIDE ( [_x Blended CAC], [_x ARPA] * [_GM] )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: d6d8da04-5cad-5a97-8d2f-b9895477312f

	/// Month index (0 = 2025-01) of the last day in the date context.
	measure '_x Month Index End' =
			VAR _end          = MAX ( dim_date[date] )
			RETURN
			    CALCULATE (
			        MAX ( dim_date[month_index] )
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[date] = _end
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: f58e4811-8c88-5b7a-be27-acf94366b5a0

	/// Last complete calendar month at the end of the date context (data README Churn / R90).
	measure '_x Last Complete Month' =
			VAR _end          = MAX ( dim_date[date] )
			VAR _month        = [_x Month Index End]
			RETURN
			    IF ( _end = EOMONTH ( _end, 0 ), _month, _month - 1 )
		formatString: 0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: f056e2e2-d525-50c8-a33d-51e417689dd4

	/// Monthly logo churn: Σ churned ÷ Σ customers_start, offsets ≥ 1 whose calendar month is in the trailing 3 complete months (A-41).
	measure '_x Churn' =
			VAR _last         = [_x Last Complete Month]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUM ( fact_cohort_revenue_month[churned] )
			            ,SUM ( fact_cohort_revenue_month[customers_start] )
			        )
			        ,fact_cohort_revenue_month[month_offset] >= 1
			        ,fact_cohort_revenue_month[calendar_month_index] >= _last - 2
			        ,fact_cohort_revenue_month[calendar_month_index] <= _last
			    )
		formatString: 0.00%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: bd9cdad1-db1b-55e7-8b67-0a398516a241

	/// ARPA × gross margin ÷ monthly churn (A-41).
	measure '_x LTV' =
			VAR _churn        = [_x Churn]
			RETURN
			    IF ( _churn > 0 && [_b New MRR] > 0, DIVIDE ( [_x ARPA] * [_GM], _churn ) )
		formatString: $#,0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 3192fe34-88bd-5d7e-96e7-6ef7d3518904

	/// LTV ÷ blended CAC (A-41).
	measure '_x LTV CAC' = DIVIDE ( [_x LTV], [_x Blended CAC] )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: cfb0549d-7127-5336-97fd-dd22656ee7e7

	/// R90 over the campaigns in context that have the cohort: Σ revenue offsets 0-2 ÷ revenue offset 0 of the newest cohort month m with m + 2 ≤ the last complete month (A-42).
	measure '_x R90 Own' =
			VAR _cohort       = [_x Last Complete Month] - 2
			VAR _rows         =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_campaign[campaign_key] )
			            ,"@r0",
			                CALCULATE (
			                    SUM ( fact_cohort_revenue_month[revenue_usd] )
			                    ,fact_cohort_revenue_month[cohort_month_index] = _cohort
			                    ,fact_cohort_revenue_month[month_offset] = 0
			                )
			            ,"@n2",
			                CALCULATE (
			                    COUNTROWS ( fact_cohort_revenue_month )
			                    ,fact_cohort_revenue_month[cohort_month_index] = _cohort
			                    ,fact_cohort_revenue_month[month_offset] = 2
			                )
			            ,"@r012",
			                CALCULATE (
			                    SUM ( fact_cohort_revenue_month[revenue_usd] )
			                    ,fact_cohort_revenue_month[cohort_month_index] = _cohort
			                    ,fact_cohort_revenue_month[month_offset] <= 2
			                )
			        )
			        ,[@r0] > 0
			            && [@n2] > 0
			    )
			RETURN
			    DIVIDE ( SUMX ( _rows, [@r012] ), SUMX ( _rows, [@r0] ) )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: ba1ab904-429b-5516-93d7-1ca3d686f9cb

	/// R90 with the fallback campaign → channel → ALL (A-42).
	measure '_x R90' =
			VAR _own          = [_x R90 Own]
			VAR _single       = HASONEVALUE ( dim_campaign[campaign_key] )
			VAR _channel      = SELECTEDVALUE ( dim_campaign[channel_code] )
			VAR _by_channel   =
			    IF (
			        ISBLANK ( _own ) && _single
			        ,CALCULATE (
			            [_x R90 Own]
			            ,REMOVEFILTERS ( dim_campaign )
			            ,REMOVEFILTERS ( dim_channel )
			            ,REMOVEFILTERS ( dim_network )
			            ,REMOVEFILTERS ( dim_platform )
			            ,dim_campaign[channel_code] = _channel
			        )
			    )
			VAR _all          =
			    IF (
			        ISBLANK ( _own ) && ISBLANK ( _by_channel )
			        ,CALCULATE (
			            [_x R90 Own]
			            ,REMOVEFILTERS ( dim_campaign )
			            ,REMOVEFILTERS ( dim_channel )
			            ,REMOVEFILTERS ( dim_network )
			            ,REMOVEFILTERS ( dim_platform )
			        )
			    )
			RETURN
			    COALESCE ( _own, _by_channel, _all )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 16c73c36-3de5-5172-8ce6-a47c1d873b5f

	/// New MRR × R90 ÷ spend (A-42).
	measure '_x ROAS 90d' =
			VAR _r90          = [_x R90]
			VAR _spend        = [_b Spend]
			RETURN
			    IF ( NOT ISBLANK ( _r90 ) && _spend > 0, DIVIDE ( ( [_b New MRR] + 0 ) * _r90, _spend ) )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: c5311aab-28bf-5abe-a359-bfe12b3ece9a

	/// PLATFORM paid customers ÷ first-party paid customers − 1 (A-43).
	measure '_x Attribution Gap' =
			VAR _modelled     = [_b Paid FP]
			VAR _platform     = [_b Paid Platform]
			RETURN
			    IF ( _modelled > 0 && _platform > 0, DIVIDE ( _platform, _modelled ) - 1 )
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 1684fc47-0c37-5606-8623-a8ffcf40c915

	/// Spend of brand campaigns ÷ spend of the scope's paid-search campaigns (data README Brand share).
	measure '_x Brand Share' =
			VAR _search       = CALCULATE ( [_b Spend], KEEPFILTERS ( dim_campaign[channel_code] = "PAID_SEARCH" ) )
			VAR _brand        =
			    CALCULATE (
			        [_b Spend]
			        ,KEEPFILTERS ( dim_campaign[channel_code] = "PAID_SEARCH" )
			        ,KEEPFILTERS ( dim_campaign[is_brand] = TRUE () )
			    )
			RETURN
			    IF ( _search > 0, DIVIDE ( _brand, _search ) + 0 )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 95c1a93c-e8af-5854-91ce-e648af596333

	/// Σ refund_count ÷ Σ customers_start (offset 0) over the 12 acquisition months ending with the window's end month (data README Refund rate).
	measure '_x Refund Rate' =
			VAR _month        = [_x Month Index End]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUM ( fact_cohort_revenue_month[refund_count] )
			            ,CALCULATE (
			                SUM ( fact_cohort_revenue_month[customers_start] )
			                ,fact_cohort_revenue_month[month_offset] = 0
			            )
			        )
			        ,fact_cohort_revenue_month[cohort_month_index] >= _month - 11
			        ,fact_cohort_revenue_month[cohort_month_index] <= _month
			    )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 8baa85f4-e7bc-52ec-a097-fedbb1f0dbc0

	/// Latest cohort month whose D30 cell is reportable at the window end (month start + 44 days ≤ end; data README D7 / D30).
	measure '_x Retention Month Index' =
			VAR _end          = MAX ( dim_date[date] )
			RETURN
			    CALCULATE (
			        MAX ( fact_retention_cohort_month[cohort_month_index] )
			        ,REMOVEFILTERS ( dim_campaign )
			        ,REMOVEFILTERS ( dim_channel )
			        ,REMOVEFILTERS ( dim_network )
			        ,REMOVEFILTERS ( dim_platform )
			        ,fact_retention_cohort_month[day_n] = 30
			        ,fact_retention_cohort_month[cohort_month_start] <= _end - 44
			    )
		formatString: 0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: d46d6c5e-2d29-54f6-952d-a76aa6dc1648

	/// The guardrail cohort month as yyyymm.
	measure '_x Retention Cohort Month' =
			VAR _index        = [_x Retention Month Index]
			VAR _start        = CALCULATE ( MAX ( dim_month[month_start] ), dim_month[month_index] = _index )
			RETURN
			    IF ( NOT ISBLANK ( _index ), YEAR ( _start ) * 100 + MONTH ( _start ) )
		formatString: 0
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 7e55719d-ca5f-5d83-bb72-c5c6b5acf39a

	/// users_active ÷ users_matured at day 7 of the guardrail cohort month (A-22).
	measure '_x D7 Retention' =
			VAR _index        = [_x Retention Month Index]
			RETURN
			    IF (
			        NOT ISBLANK ( _index )
			        ,CALCULATE (
			            DIVIDE (
			                SUM ( fact_retention_cohort_month[users_active] )
			                ,SUM ( fact_retention_cohort_month[users_matured] )
			            )
			            ,fact_retention_cohort_month[day_n] = 7
			            ,fact_retention_cohort_month[cohort_month_index] = _index
			        )
			    )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 0007d701-f27c-574f-a72c-ddac7ce26668

	/// users_active ÷ users_matured at day 30 of the guardrail cohort month (A-22).
	measure '_x D30 Retention' =
			VAR _index        = [_x Retention Month Index]
			RETURN
			    IF (
			        NOT ISBLANK ( _index )
			        ,CALCULATE (
			            DIVIDE (
			                SUM ( fact_retention_cohort_month[users_active] )
			                ,SUM ( fact_retention_cohort_month[users_matured] )
			            )
			            ,fact_retention_cohort_month[day_n] = 30
			            ,fact_retention_cohort_month[cohort_month_index] = _index
			        )
			    )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: e8521aed-1c2d-5248-b5b1-d844598fae2d

	/// CTR of the last 7 days of the date context (creative CTR 7 d, A-44).
	measure '_x CTR Last 7' =
			VAR _end          = MAX ( dim_date[date] )
			RETURN
			    CALCULATE (
			        DIVIDE ( [_b Clicks], [_b Impressions] )
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _end - 6
			                && dim_date[date] <= _end
			        )
			    )
		formatString: 0.00%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 77a98df3-1a0d-5e54-a6dc-160181aa5421

	/// CTR of the last 7 days ÷ CTR of the 7 days before − 1 (A-44).
	measure '_x CTR Slope Raw' =
			VAR _end          = MAX ( dim_date[date] )
			VAR _imp_last     =
			    CALCULATE (
			        [_b Impressions]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 6 && dim_date[date] <= _end )
			    )
			VAR _clk_last     =
			    CALCULATE (
			        [_b Clicks]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 6 && dim_date[date] <= _end )
			    )
			VAR _imp_before   =
			    CALCULATE (
			        [_b Impressions]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 13 && dim_date[date] <= _end - 7 )
			    )
			VAR _clk_before   =
			    CALCULATE (
			        [_b Clicks]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 13 && dim_date[date] <= _end - 7 )
			    )
			RETURN
			    IF (
			        _imp_last > 0 && _imp_before > 0 && _clk_before > 0
			        ,DIVIDE ( DIVIDE ( _clk_last, _imp_last ), DIVIDE ( _clk_before, _imp_before ) ) - 1
			    )
		formatString: +0%;-0%;0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 549aa165-6411-59d8-8eb5-f0d2f9175573

	/// Σ impressions of the last 7 days ÷ Σ reach_7d on the last day (A-44; reach_7d is point in time).
	measure '_x Frequency Raw' =
			VAR _end          = MAX ( dim_date[date] )
			VAR _imp_last     =
			    CALCULATE (
			        [_b Impressions]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 6 && dim_date[date] <= _end )
			    )
			VAR _reach        =
			    CALCULATE (
			        SUM ( fact_ad_delivery_day[reach_7d] )
			        ,REMOVEFILTERS ( dim_date )
			        ,dim_date[date] = _end
			    )
			RETURN
			    DIVIDE ( _imp_last, _reach )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: c5e25311-9093-55e4-b101-a85761e29f27

	/// TRUE when the window has 14 days or more (frequency and slope need two 7-day blocks).
	measure '_x Window Long Enough' = INT ( MAX ( dim_date[date] ) - MIN ( dim_date[date] ) ) >= 13
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 6dc64d6a-9415-5cf8-8b2a-6a717e4720ae

	/// Frequency (7-day) at the window end; windows of 14 days or more (A-44).
	measure '_x Frequency 7d' = IF ( [_x Window Long Enough], [_x Frequency Raw] )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 909fa63e-74e8-597f-9681-00a9c24502b9

	/// CTR 7-day slope at the window end; windows of 14 days or more (A-44).
	measure '_x CTR Slope 7d' = IF ( [_x Window Long Enough], [_x CTR Slope Raw] )
		formatString: +0%;-0%;0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: ba25ba2c-f5dd-592f-981e-0c8c7f2dd54c

	/// Install → sign-up of the window's last 7 days − the previous period's (data README D-6).
	measure '_x Install Quality Delta' =
			VAR _start        = MIN ( dim_date[date] )
			VAR _end          = MAX ( dim_date[date] )
			VAR _days         = INT ( _end - _start ) + 1
			VAR _ins_last     =
			    CALCULATE (
			        [_b Installs]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 6 && dim_date[date] <= _end )
			    )
			VAR _su_last      =
			    CALCULATE (
			        [_b Signups]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _end - 6 && dim_date[date] <= _end )
			    )
			VAR _ins_prev     =
			    CALCULATE (
			        [_b Installs]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _start - _days && dim_date[date] <= _start - 1 )
			    )
			VAR _su_prev      =
			    CALCULATE (
			        [_b Signups]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _start - _days && dim_date[date] <= _start - 1 )
			    )
			RETURN
			    IF ( _ins_last > 0 && _ins_prev > 0, DIVIDE ( _su_last, _ins_last ) - DIVIDE ( _su_prev, _ins_prev ) )
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: cb64544c-7181-5388-a981-13a4f6cfb5ca

