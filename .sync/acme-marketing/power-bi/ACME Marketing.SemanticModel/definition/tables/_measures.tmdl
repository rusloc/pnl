	/// Spend vs the comparison window, or vs plan in Plan mode (A-11, A-21).
	measure 'Spend Δ' =
			VAR _mode         = [_Cmp]
			VAR _base         =
			    SWITCH (
			        _mode
			        ,"PLAN"
			            ,[Plan]
			        ,"NONE"
			            ,BLANK ()
			        ,[Spend Cmp]
			    )
			RETURN
			    DIVIDE ( [Spend] - _base, _base )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7 Comparisons
		lineageTag: cf8dac55-2cd6-5ca2-9824-e227a4b309e2

	/// Paid customers vs the comparison window, or vs the target in Plan mode.
	measure 'Paid Customers Δ' =
