/// Measure table: every report measure lives here (CLAUDE.md Track B). Folders 1-7 are the visible metrics (window = the period picker,
/// A-10), 8 Report (texts, colours, SVG faces), 9 Engine (hidden: window, base sums in the date context, helpers).
table _measures
	lineageTag: ac648953-190d-5ae4-bed8-b00626f730d3

	/// Last complete day of the dataset (manifest as_of_date); anchors every window (A-03, A-81). Never TODAY().
	measure '_As Of' = MAX ( meta_dataset[as_of_date] )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: fdca643a-4238-5686-acc2-187d55bfcc3c

	/// Refresh stamp of the dataset (manifest refreshed; A-17).
	measure _Refreshed = MAX ( meta_dataset[refreshed] )
		formatString: yyyy-mm-dd hh:nn
		isHidden
		displayFolder: 9 Engine
		lineageTag: a88e7bad-8aaa-57af-9318-317590a77ff1

	/// Picked period preset; 30 d when nothing is picked (A-10).
	measure _Preset = SELECTEDVALUE ( param_period_preset[preset_code], "30D" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: a69b9c40-da4c-542a-95d0-392e2cce8e57

	/// Last day of the window: the as-of day, or the To date of a Custom range (A-10).
	measure '_Win End' =
			VAR _as_of        = [_As Of]
			VAR _custom_end   = MAX ( param_date[date] )
			RETURN
			    IF ( [_Preset] = "CUSTOM", MIN ( _custom_end, _as_of ), _as_of )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3579a710-4e2c-5244-8063-df1c23572e42

	/// First day of the window: 7 d, 30 d, MTD, QTD from the window end, or the From date of a Custom range (A-10, AT-03).
	measure '_Win Start' =
			VAR _end          = [_Win End]
			VAR _preset       = [_Preset]
			RETURN
			    SWITCH (
			        _preset
			        ,"7D"
			            ,_end - 6
			        ,"MTD"
			            ,DATE ( YEAR ( _end ), MONTH ( _end ), 1 )
			        ,"QTD"
			            ,DATE ( YEAR ( _end ), ( QUARTER ( _end ) - 1 ) * 3 + 1, 1 )
			        ,"CUSTOM"
			            ,MIN ( param_date[date] )
			        ,_end - 29
			    )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: fe9476a6-7529-513b-b6b2-8c810a9b118f

	/// Days in the window.
	measure '_Win Days' = INT ( [_Win End] - [_Win Start] ) + 1
		formatString: 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9cb5b8d5-08a5-544f-ab52-08cbdefa817f

	/// Comparison mode; Previous period when nothing is picked (A-11).
	measure _Cmp = SELECTEDVALUE ( param_comparator[comparator_code], "PREV" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 3c8f1c9a-e42b-5253-ad93-878ffb8da0df

	/// Trend granularity; Day when nothing is picked (A-10).
	measure _Granularity = SELECTEDVALUE ( param_granularity[granularity_code], "DAY" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 44525a24-8c4c-50cd-944a-fefe376a14b3

	/// Selected attribution model; Data-driven when nothing is selected (A-16, AT-06).
	measure _Model = SELECTEDVALUE ( dim_attribution_model[model_code], "DDA" )
		isHidden
		displayFolder: 9 Engine
		lineageTag: d315300c-f732-564b-8d1e-804836d35cc0

	/// Name of the selected attribution model (Data-driven by default).
	measure '_Model Name' =
			VAR _model        = [_Model]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( dim_attribution_model[model_name] )
			        ,REMOVEFILTERS ( dim_attribution_model )
			        ,dim_attribution_model[model_code] = _model
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 251dd066-a7d0-58be-9f4e-ea387e5a55a7

	/// First-party model for the attribution gap and modelled CPA: the selected model, DDA when Platform-reported is picked (A-43).
	measure '_Model FP' =
			VAR _model        = [_Model]
			RETURN
			    IF ( _model = "PLATFORM", "DDA", _model )
		isHidden
		displayFolder: 9 Engine
		lineageTag: bad983f2-9d21-5625-bf09-3ad98e5e7892

	/// Gross margin (param_finance GROSS_MARGIN_PCT, latest valid-from; A-40, ADR-0015 §5 q 3).
	measure _GM =
			VAR _as_of        = [_As Of]
			RETURN
			    MAXX (
			        TOPN (
			            1
			            ,FILTER (
			                param_finance
			                ,param_finance[metric_code] = "GROSS_MARGIN_PCT"
			                    && param_finance[valid_from] <= _as_of
			            )
			            ,param_finance[valid_from], DESC
			        )
			        ,param_finance[value]
			    )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine
		lineageTag: 8c6989cb-65b7-5e01-9b0b-c80db62bd596

	/// param_target ALL / ROAS (A-75: thresholds live in param_target only).
	measure '_T ROAS' =
			CALCULATE (
			    MAX ( param_target[target_value] )
			    ,param_target[scope_type] = "ALL"
			    ,param_target[metric_code] = "ROAS"
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 9b3f4e04-b7e2-5e8d-8c09-b6f9def72f4c

	/// param_target ALL / ROAS_SCALE (A-75: thresholds live in param_target only).
