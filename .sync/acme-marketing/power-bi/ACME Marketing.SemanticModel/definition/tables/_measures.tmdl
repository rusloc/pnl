	/// Σ paid_customers_dda (DDA credits split over creatives by clicks; data README D-4): the ad-set CPA source (P3).
	measure '_b Paid Credits Delivery' = SUM ( fact_ad_delivery_day[paid_customers_dda] )
		formatString: #,0.00
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: 4c87f5fe-1cc9-59c7-92ab-6491cff288d3

	/// Plan of the days in the date context: Σ budget_usd × overlapping days ÷ days_in_month (A-31).
	measure '_b Plan' =
			VAR _start        = MIN ( dim_date[date] )
			VAR _end          = MAX ( dim_date[date] )
			RETURN
			    SUMX (
			        FILTER (
			            ALL ( dim_month )
			            ,dim_month[month_start] <= _end
			                && EOMONTH ( dim_month[month_start], 0 ) >= _start
			        )
			        ,VAR _month_start  = dim_month[month_start]
			         VAR _overlap      = INT ( MIN ( _end, EOMONTH ( _month_start, 0 ) ) - MAX ( _start, _month_start ) ) + 1
			         RETURN
			            CALCULATE ( SUM ( fact_budget_month[budget_usd] ) ) * _overlap / dim_month[days_in_month]
			    )
		formatString: $#,0.00
		isHidden
		displayFolder: 9 Engine\Base
		lineageTag: 17a52b7f-551d-52e5-84a5-0bbffdf6dee9

