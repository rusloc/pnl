	/// Σ new_mrr_usd under _Model (A-39).
	measure '_b New MRR' =
			CALCULATE (
			    SUM ( fact_attribution_day[new_mrr_usd] )
			    ,TREATAS ( { [_Model] }, dim_attribution_model[model_code] )
			)
