	/// TRUE when the scope is one picked campaign (campaign flags and targets); FALSE for channel or wider scopes.
	measure '_Is Campaign Scope' =
			HASONEVALUE ( dim_campaign[campaign_key] )
			    && (
			        ISFILTERED ( dim_campaign[campaign_key] )
			            || ISFILTERED ( dim_campaign[campaign_label] )
			            || ISFILTERED ( dim_campaign[campaign_name] )
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 96f13f31-6b9e-530e-8af5-da9d9112e798

	/// CPA target of the scope: the campaign's own target (null for Lead / Retention) or the channel target in param_target (A-24).
	measure 'CPA Target' =
			VAR _campaign     = SELECTEDVALUE ( dim_campaign[cpa_target_usd] )
			VAR _channel      = SELECTEDVALUE ( dim_campaign[channel_code] )
			VAR _by_channel   =
			    CALCULATE (
			        MAX ( param_target[target_value] )
			        ,param_target[scope_type] = "CHANNEL"
			        ,param_target[scope_code] = _channel
			        ,param_target[metric_code] = "CPA"
			    )
			RETURN
			    IF ( [_Is Campaign Scope], _campaign, _by_channel )
		formatString: $#,0
		displayFolder: 6 Diagnostics
		lineageTag: e4f2104e-ac0a-54ad-9ac1-fb7d13f0d0fb

	/// Σ spend_usd in the date context (A-30).
	measure '_b Spend' = SUM ( fact_ad_delivery_day[spend_usd] )
		formatString: $#,0.00
