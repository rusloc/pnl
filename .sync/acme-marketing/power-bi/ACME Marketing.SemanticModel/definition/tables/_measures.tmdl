	/// Median days from sign-up to activation per day of the dynamics window (the selected period, or its last 30 days when longer than 90).
	measure 'Dyn Time to Activation' =
			VAR _end          = [_Win End]
			VAR _start        = IF ( [_Win Days] > 90, _end - 29, [_Win Start] )
			VAR _day          = MAX ( dim_date[date] )
