	/// TRUE for the 12 acquisition months before the window's end month (K1 heatmap rows).
	measure '_K1 Heat Month' =
			VAR _end          = [_Cohort End Index]
			VAR _m            = SELECTEDVALUE ( dim_month[month_index] )
			RETURN
			    NOT ISBLANK ( _m ) && _m < _end && _m >= _end - 12
		isHidden
		displayFolder: 9 Engine
		lineageTag: f89946a1-e0a6-5fa6-adb7-4277bc5270b5

	/// K1 heatmap cell: cumulative payback of the acquisition month (row) at the month since acquisition (column), months 0 .. 11 (A-56).
	measure 'K1 Heat' =
			VAR _k            = SELECTEDVALUE ( dim_offset[month_offset] )
			RETURN
			    IF ( [_K1 Heat Month] && _k <= 11, [Cohort Payback At] )
		formatString: 0%
		displayFolder: 8 Report
		lineageTag: 18d09df9-4721-54ab-b332-8aaf9c71ad11

	/// K1 cell fill: one hue (accent), darker = closer to payback; good green once paid back (≥ 100 %).
	measure 'K1 Heat Colour' =
			VAR _v            = [K1 Heat]
			VAR _t            = MIN ( MAX ( _v, 0 ), 1 ) * 0.80 + 0.06
			VAR _digits       = "0123456789ABCDEF"
			VAR _r            = ROUND ( 255 - ( 255 - 74 ) * _t, 0 )
			VAR _g            = ROUND ( 255 - ( 255 - 87 ) * _t, 0 )
			VAR _b            = ROUND ( 255 - ( 255 - 232 ) * _t, 0 )
			VAR _hex          =
			    "#"
			        & MID ( _digits, INT ( _r / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _r, 16 ) + 1, 1 )
			        & MID ( _digits, INT ( _g / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _g, 16 ) + 1, 1 )
			        & MID ( _digits, INT ( _b / 16 ) + 1, 1 ) & MID ( _digits, MOD ( _b, 16 ) + 1, 1 )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( _v )
			            ,"#FFFFFF"
			        ,_v >= 1
			            ,"#1E9E6A"
			        ,_hex
			    )
		displayFolder: 8 Report
		lineageTag: d6f6f856-d84d-5c08-81d6-1ae39f7b832a

	/// K1 cell text colour on the fill.
	measure 'K1 Heat Ink' = IF ( [K1 Heat] >= 0.55, "#FFFFFF", "#111827" )
		displayFolder: 8 Report
		lineageTag: 42423585-b943-5419-a422-1295f79ec2e9

	/// Signups of the same dates one year back (A-11; vitals V2).
	measure 'Signups LY' =
			VAR _start        = EDATE ( [_Win Start], -12 )
			VAR _end          = EDATE ( [_Win End], -12 )
			RETURN
			    CALCULATE (
			        [_b Signups]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _start
			                && dim_date[date] <= _end
			        )
			    )
		formatString: #,0
		displayFolder: 7 Comparisons
		lineageTag: 47d26b75-8cf9-5ac0-babb-aa8d38448b80

	/// Conversion into paid (vitals V3): paid customers of the window (selected model, conversion day) ÷ sign-ups of the window (sign-up day); a period rate, not a cohort.
	measure 'Signup to Paid' = DIVIDE ( [Paid Customers], [Signups] )
		formatString: 0.0%
		displayFolder: 2 Funnel
		lineageTag: 24bed0e2-b58f-5925-aca1-088e39e7c3e5

	/// Conversion into paid of the same dates one year back.
	measure 'Signup to Paid LY' = DIVIDE ( [Paid Customers LY], [Signups LY] )
		formatString: 0.0%
		displayFolder: 7 Comparisons
		lineageTag: 1725908f-16fd-526e-9ed5-e4d34bf255e2

	/// Median hours from sign-up to activation, same dates one year back.
	measure 'Act Median Hours LY' =
			VAR _start        = EDATE ( [_Win Start], -12 )
			VAR _end          = EDATE ( [_Win End], -12 )
			RETURN
			    CALCULATE (
			        [_x Act Median Hours]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _start
			                && dim_date[date] <= _end
			        )
			    )
		formatString: 0
		displayFolder: 7 Comparisons
		lineageTag: a76306ed-91c2-5e1e-9c87-212c3a81c8a4

	/// Vitals V4: median days from sign-up to activation (first dashboard) of the window's sign-ups that activated within 30 days; stands in for time to paid (the data has no sign-up → payment timing).
	measure 'Time to Activation Days' = DIVIDE ( [Act Median Hours], 24 )
		formatString: 0.0
		displayFolder: 2 Funnel
		lineageTag: 456a200a-2425-5c52-a0b9-abba47c5c73f

	/// Time to activation of the same dates one year back.
	measure 'Time to Activation Days LY' = DIVIDE ( [Act Median Hours LY], 24 )
		formatString: 0.0
		displayFolder: 7 Comparisons
		lineageTag: 006ca8f8-ac3d-5b79-bffa-69b9db2d963a

	/// The 12-month payback line of K6 (param_target PAYBACK_MONTHS).
	measure 'Payback Target' = [_T PAYBACK_MONTHS]
		formatString: 0
		displayFolder: 8 Report
		lineageTag: 36b2f200-ea68-5526-8c1f-176e22e9ff02

	/// C5 / C6 bar: paid customers of the channel; the format string prints the label 'count | $CAC'.
	measure 'Paid Customers CAC Bar' = [Paid Customers]
		displayFolder: 8 Report
		lineageTag: e076c46e-267c-5f85-a3ea-b4eb60b0fbef

		formatStringDefinition =
				VAR _cac          = [Paid CAC]
				RETURN
				    IF ( ISBLANK ( _cac ), "#,0", "#,0""  |  $" & FORMAT ( _cac, "#,0" ) & """" )

	/// Spend per day of the dynamics window (the selected period, or its last 30 days when longer than 90).
	measure 'Dyn Spend' =
			VAR _end          = [_Win End]
			VAR _start        = IF ( [_Win Days] > 90, _end - 29, [_Win Start] )
			VAR _day          = MAX ( dim_date[date] )
			VAR _on           = HASONEVALUE ( dim_date[date] ) && _day >= _start && _day <= _end
			RETURN
			    IF (
			        _on
			        ,CALCULATE (
			            [_b Spend]
			            ,REMOVEFILTERS ( dim_date )
			            ,TREATAS ( { _day }, dim_date[date] )
			        )
			    )
		formatString: $#,0
		displayFolder: 8 Report\Dynamics
		lineageTag: 004a7e60-74f8-5d36-9597-aaf5356f0b44

	/// Spend of the same day one year back (dashed line).
	measure 'Dyn Spend LY' =
			VAR _end          = [_Win End]
			VAR _start        = IF ( [_Win Days] > 90, _end - 29, [_Win Start] )
			VAR _day          = MAX ( dim_date[date] )
			VAR _on           = HASONEVALUE ( dim_date[date] ) && _day >= _start && _day <= _end
			RETURN
			    IF (
			        _on
			        ,CALCULATE (
			            [_b Spend]
			            ,REMOVEFILTERS ( dim_date )
			            ,TREATAS ( { EDATE ( _day, -12 ) }, dim_date[date] )
			        )
			    )
