	/// Flag codes of a campaign or channel scope in the window (A-24, data README Flags): exclusive gates first, then every root cause that trips; CPA over only without a root cause.
	measure 'Flag Codes' =
			VAR _spend        = [Spend]
			VAR _is_campaign  = [_Is Campaign Scope]
			VAR _objective    = IF ( _is_campaign, SELECTEDVALUE ( dim_campaign[objective_code] ) )
			VAR _status       = IF ( _is_campaign, SELECTEDVALUE ( dim_campaign[status_code] ) )
			VAR _spenders     =
			    FILTER (
			        VALUES ( dim_campaign[campaign_key] )
			        ,CALCULATE ( [_b Spend], REMOVEFILTERS ( dim_date ) ) > 0
			    )
			VAR _learners     =
			    COUNTROWS (
			        FILTER (
			            _spenders
			            ,CALCULATE ( SELECTEDVALUE ( dim_campaign[status_code] ) ) = "LEARNING"
			        )
			    )
			VAR _gate         =
			    IF (
			        _is_campaign
			        ,SWITCH (
			            _objective
			            ,"PIPELINE"
			                ,"PIPELINE_LED"
			            ,"LEAD"
			                ,"LEAD_GOAL"
			            ,"RETENTION"
			                ,"NO_CPA_GOAL"
			            ,IF ( _status = "LEARNING", "LEARNING" )
			        )
			        ,IF ( _learners = COUNTROWS ( _spenders ), "LEARNING" )
			    )
			VAR _slope        = [CTR Slope 7d]
			VAR _frequency    = [Frequency 7d]
			VAR _fatigue      = _slope < [_T FATIGUE_SLOPE] && _frequency > [_T FATIGUE_FREQ]
			VAR _freq_high    = _frequency > [_T FREQ_HIGH]
			VAR _quality      = IF ( _is_campaign && _objective = "INSTALL", [Install Quality Delta] )
			VAR _install_q    = NOT ISBLANK ( _quality ) && _quality < [_T INSTALL_QUALITY_PT]
			VAR _view_through = [Attribution Gap] + 1 > [_T VIEW_THROUGH_RATIO]
			VAR _target       = [CPA Target]
			VAR _cpa_over     =
			    NOT ( _fatigue || _freq_high || _install_q || _view_through )
			        && NOT ISBLANK ( _target )
			        && [CPA] > _target * [_T CPA_OVER_TOL]
			VAR _pacing       = [Pacing]
			VAR _over         = NOT ISBLANK ( _pacing ) && _pacing > [_T PACING_HI]
			VAR _under        = NOT ISBLANK ( _pacing ) && _pacing < [_T PACING_LO]
			VAR _list         =
			    IF ( _fatigue, "FATIGUE," )
			        & IF ( _freq_high, "FREQUENCY," )
			        & IF ( _install_q, "INSTALL_QUALITY," )
			        & IF ( _view_through, "VIEW_THROUGH," )
			        & IF ( _cpa_over, "CPA_OVER," )
			        & IF ( _over, "OVER_PACING," )
			        & IF ( _under, "UNDERSPENT," )
			VAR _result       =
			    SWITCH (
			        TRUE ()
			        ,NOT ISBLANK ( _gate )
			            ,_gate
			        ,_list = ""
			            ,"ON_TARGET"
			        ,LEFT ( _list, LEN ( _list ) - 1 )
			    )
			RETURN
			    IF ( _spend > 0, _result )
		displayFolder: 6 Diagnostics
		lineageTag: a0e1389d-8d8b-5fc9-838d-530c5843f2ff

	/// Flag words of the scope (A-24, A-25: every flag carries its word).
	measure 'Flags Text' =
			VAR _codes        = [Flag Codes]
			VAR _target       = [CPA Target]
			VAR _over_pct     = DIVIDE ( [CPA], _target ) - 1
			VAR _words        =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                SUBSTITUTE (
			                    SUBSTITUTE (
			                        SUBSTITUTE (
			                            SUBSTITUTE (
			                                SUBSTITUTE (
			                                    SUBSTITUTE (
			                                        SUBSTITUTE (
			                                            SUBSTITUTE (
			                                                SUBSTITUTE ( _codes, "FATIGUE", "Fatigue" )
			                                                ,"FREQUENCY", "Frequency"
			                                            )
			                                            ,"INSTALL_QUALITY", "Install quality"
			                                        )
			                                        ,"VIEW_THROUGH", "View-through heavy"
			                                    )
			                                    ,"CPA_OVER", "CPA " & FORMAT ( _over_pct, "0%" ) & " over"
			                                )
			                                ,"OVER_PACING", "Over-pacing"
			                            )
			                            ,"UNDERSPENT", "Underspent"
			                        )
			                        ,"PIPELINE_LED", "Pipeline-led"
			                    )
			                    ,"LEAD_GOAL", "Lead goal"
			                )
			                ,"NO_CPA_GOAL", "No CPA goal"
			            )
			            ,"LEARNING", "Learning"
			        )
			        ,"ON_TARGET", "On target"
			    )
			RETURN
			    SUBSTITUTE ( _words, ",", " | " )
		displayFolder: 6 Diagnostics
		lineageTag: 89cc1d93-d8c3-595c-bde1-7ec266c1f01c

	/// Colour of the flag words: crit for a root cause or over-pacing, warn for underspent / view-through, good for on target, ink-2 for gates.
	measure 'Flags Colour' =
			VAR _codes        = "," & [Flag Codes] & ","
			RETURN
			    SWITCH (
			        TRUE ()
			        ,ISBLANK ( [Flag Codes] )
			            ,"#8A94A6"
			        ,CONTAINSSTRING ( _codes, ",FATIGUE," ) || CONTAINSSTRING ( _codes, ",OVER_PACING," ) || CONTAINSSTRING ( _codes, ",CPA_OVER," )
			            || CONTAINSSTRING ( _codes, ",FREQUENCY," ) || CONTAINSSTRING ( _codes, ",INSTALL_QUALITY," )
			            ,"#D93B4B"
			        ,CONTAINSSTRING ( _codes, ",UNDERSPENT," ) || CONTAINSSTRING ( _codes, ",VIEW_THROUGH," )
			            ,"#C47A0E"
			        ,CONTAINSSTRING ( _codes, ",ON_TARGET," )
			            ,"#1E9E6A"
			        ,"#4B5563"
			    )
		displayFolder: 8 Report
		lineageTag: 2eac3668-9083-5d17-89af-502adfe2135d

	/// Trials × the scope's previous-period trial → paid − paid customers (DDA; data README Trial → paid shortfall).
	measure 'Trial Shortfall' =
			VAR _prev_rate    = DIVIDE ( [Paid Customers DDA Prev], [Trials Prev] )
			RETURN
			    IF ( [Trials] > 0 && [Trials Prev] > 0, [Trials] * _prev_rate - [Paid Customers DDA] )
		formatString: #,0.0
		displayFolder: 6 Diagnostics
		lineageTag: fd04dcdb-cec5-51f8-aafc-61dfdc77e521

	/// Share of the ALL trial → paid shortfall carried by the scope (story: SOC_META_LAL2 ≈ 70 %).
	measure 'Loss Share' =
			VAR _all          =
			    CALCULATE (
			        [Trial Shortfall]
			        ,REMOVEFILTERS ( dim_campaign )
			        ,REMOVEFILTERS ( dim_channel )
			        ,REMOVEFILTERS ( dim_network )
			        ,REMOVEFILTERS ( dim_platform )
			    )
			RETURN
			    DIVIDE ( [Trial Shortfall], _all )
		formatString: 0%
		displayFolder: 6 Diagnostics
		lineageTag: c6d559d9-9439-5db6-9d03-bd7142063915

	/// Movers window start (O5 / O6, 2026-11-05): the window's start, or its last 30 days when the comparison window would start before the first day of data (e.g. Custom from Jan 1 2025: no previous period, a partial last year).
	measure '_Mv Start' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _days         = INT ( _end - _start ) + 1
			VAR _basis_start  = IF ( [_Cmp] = "LY", EDATE ( _start, -12 ), _start - _days )
			VAR _first        = CALCULATE ( MIN ( param_date[date] ), REMOVEFILTERS ( param_date ) )
			RETURN
			    IF ( _basis_start < _first && _days > 30, _end - 29, _start )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4477da00-8702-5c98-8700-a878791d4b4e

	/// ROAS 90 d of the comparison period for the movers: same period last year in LY mode, else the previous period (A-52).
	measure 'ROAS 90d Basis' =
			SWITCH (
			    [_Cmp]
			    ,"LY"
			        ,[ROAS 90d LY]
			    ,[ROAS 90d Prev]
			)
		formatString: 0.00
		displayFolder: 6 Diagnostics
		lineageTag: 39bc9839-cb8d-54d7-925c-b44499ad8766

	/// ROAS 90 d − the comparison period's, for one campaign with a ROAS objective and spend in both periods, over the movers window (_Mv Start .. window end) and its comparison, as explicit date windows (data README Movers).
	measure 'ROAS Delta' =
			VAR _start        = [_Mv Start]
			VAR _end          = [_Win End]
			VAR _days         = INT ( _end - _start ) + 1
			VAR _is_ly        = [_Cmp] = "LY"
			VAR _b_start      = IF ( _is_ly, EDATE ( _start, -12 ), _start - _days )
			VAR _b_end        = IF ( _is_ly, EDATE ( _end, -12 ), _start - 1 )
			VAR _objective    = SELECTEDVALUE ( dim_campaign[objective_code] )
			VAR _now          =
			    CALCULATE (
			        [_x ROAS 90d]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _start
			                && dim_date[date] <= _end
			        )
			    )
			VAR _before       =
			    CALCULATE (
			        [_x ROAS 90d]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _b_start
			                && dim_date[date] <= _b_end
			        )
			    )
			VAR _spend        =
			    CALCULATE (
			        [_b Spend]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _start
			                && dim_date[date] <= _end
			        )
			    )
			VAR _spend_basis  =
			    CALCULATE (
			        [_b Spend]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _b_start
			                && dim_date[date] <= _b_end
			        )
			    )
			RETURN
			    IF (
			        HASONEVALUE ( dim_campaign[campaign_key] )
			            && _objective IN { "PAID", "INSTALL", "PIPELINE" }
			            && _spend > 0
			            && _spend_basis > 0
			            && NOT ISBLANK ( _now )
			            && NOT ISBLANK ( _before )
			        ,_now - _before
			    )
		formatString: +0.00;-0.00;0.00
		displayFolder: 6 Diagnostics
		lineageTag: ff0c6209-8a88-5840-a788-134d603e7a7d

	/// 1 … 3 = the three best, −1 … −3 = the three worst campaigns by Δ ROAS in the scope; blank otherwise (O6). Also clears dim_campaign[sort_order]: a visual grouping by campaign_label groups by its sort-by column too.
	measure 'Mover Rank' =
			VAR _me           = SELECTEDVALUE ( dim_campaign[campaign_key] )
			VAR _deltas       =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( dim_campaign[campaign_key] )
			                ,"@d", [ROAS Delta]
			            )
			            ,NOT ISBLANK ( [@d] )
			        )
			        ,REMOVEFILTERS ( dim_campaign[campaign_key] )
			        ,REMOVEFILTERS ( dim_campaign[campaign_label] )
			        ,REMOVEFILTERS ( dim_campaign[sort_order] )
			    )
			VAR _mine         = MAXX ( FILTER ( _deltas, dim_campaign[campaign_key] = _me ), [@d] )
			VAR _better       = COUNTROWS ( FILTER ( _deltas, [@d] > _mine ) ) + 0
			VAR _worse        = COUNTROWS ( FILTER ( _deltas, [@d] < _mine ) ) + 0
			RETURN
			    IF (
			        NOT ISBLANK ( _mine )
			        ,SWITCH (
			            TRUE ()
			            ,_worse < 3
			                ,- ( _worse + 1 )
			            ,_better < 3
			                ,_better + 1
			        )
			    )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 8044a246-71bd-575d-abbb-8b912441da4a

	/// Δ ROAS of the six movers only (O6 bars; blank for every other campaign).
	measure 'ROAS Delta Shown' = IF ( NOT ISBLANK ( [Mover Rank] ), [ROAS Delta] )
		formatString: +0.00;-0.00;0.00
		displayFolder: 6 Diagnostics
		lineageTag: 3d18b1c7-0664-56f7-a88b-20f0dde38960

	/// 1 for the six movers of O6 (visual filter).
	measure 'Mover Visible' = IF ( NOT ISBLANK ( [Mover Rank] ), 1, 0 )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 62400030-b805-5c48-a0ec-a8f50fa61f7c

	/// Good for a positive Δ ROAS, crit for a negative one.
	measure 'Movers Colour' = VAR _d = [ROAS Delta Shown] RETURN IF ( NOT ISBLANK ( _d ), IF ( _d >= 0, "#1E9E6A", "#D93B4B" ) )
		displayFolder: 8 Report
		lineageTag: 3e096e24-0c47-5874-993c-0b7b0d364ab2

	/// Campaign with the lowest Δ ROAS in the scope.
	measure '_Worst Mover Key' =
			VAR _deltas       =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_campaign[campaign_key] )
			            ,"@d", [ROAS Delta]
			        )
			        ,NOT ISBLANK ( [@d] )
			    )
			RETURN
			    MAXX (
			        TOPN ( 1, _deltas, [@d], ASC, dim_campaign[campaign_key], ASC )
			        ,dim_campaign[campaign_key]
			    )
		isHidden
		displayFolder: 9 Engine
		lineageTag: 6ac446ba-6e69-51e0-aede-d71b8d4f3f56

	/// Campaign with the most spend in the scope (fallback selection).
	measure '_Top Spender Key' =
			MAXX (
			    TOPN (
			        1
			        ,ADDCOLUMNS ( VALUES ( dim_campaign[campaign_key] ), "@s", [Spend] )
			        ,[@s], DESC
			        ,dim_campaign[campaign_key], ASC
			    )
			    ,dim_campaign[campaign_key]
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 4da7a43a-c435-5cf8-a4e4-47da3be7ff24

	/// Selected campaign of the Campaigns view: the one clicked (or filtered to), else the worst mover of the window (A-54, AT-09).
	measure '_Selected Campaign' =
			CALCULATE (
			    IF (
			        HASONEVALUE ( dim_campaign[campaign_key] )
			        ,VALUES ( dim_campaign[campaign_key] )
			        ,COALESCE ( [_Worst Mover Key], [_Top Spender Key] )
			    )
			    ,REMOVEFILTERS ( dim_date )
			    ,REMOVEFILTERS ( dim_ad_set )
			    ,REMOVEFILTERS ( dim_creative )
			    ,REMOVEFILTERS ( dim_term )
			)
		isHidden
		displayFolder: 9 Engine
		lineageTag: 287748b1-4e2b-5f62-a1a5-b4262a82c6ca

	/// Name of the selected campaign (P2 title).
	measure 'Selected Campaign Name' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( dim_campaign[campaign_name] )
			        ,REMOVEFILTERS ( dim_campaign )
			        ,dim_campaign[campaign_key] = _key
			    )
		displayFolder: 6 Diagnostics
		lineageTag: 1542a620-1f8b-54a5-9c6e-dd97df94da5e

	/// Ad-set CPA of the selected campaign: spend ÷ DDA credits (P3).
	measure 'P3 Ad Set CPA' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        DIVIDE ( [Spend], [Ad Set Credits] )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: $#,0
		displayFolder: 6 Diagnostics
		lineageTag: 1fad4c4f-8bd7-509f-876f-8bbf5ab0be7e

	/// CPA target of the selected campaign (P3 dashed line).
	measure 'P3 CPA Target' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        [CPA Target]
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: $#,0
		displayFolder: 6 Diagnostics
		lineageTag: 1b5f4604-456b-5ec4-9230-7c7f551acc5d

	/// Creative CTR of the window's last 7 days (P4).
	measure 'P4 CTR 7d' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        IF ( [_Creative Live], [Creative CTR 7d] )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: 0.00%
		displayFolder: 6 Diagnostics
		lineageTag: 6119bb5e-443e-513d-8419-6e92ab1dee13

	/// Creative CTR 7-day slope (P4).
	measure 'P4 Slope' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        IF ( [_Creative Live], [Creative Slope 7d] )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: +0%;-0%;0%
		displayFolder: 6 Diagnostics
		lineageTag: 561eefb2-003c-56c5-ac37-29ac156cbd9d

	/// Creative frequency at the window end (P4).
	measure 'P4 Frequency' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        IF ( [_Creative Live], [Creative Frequency] )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: 0.0
		displayFolder: 6 Diagnostics
		lineageTag: fdb6923c-ffcc-5479-9e12-5c7e7deace95

	/// Term CPC of the selected campaign (P5).
	measure 'P5 CPC' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        [Term CPC]
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		formatString: $#,0.00
		displayFolder: 6 Diagnostics
		lineageTag: 25ef96e6-92dd-5b8b-9f0d-dd7cf468ef5a

	/// Term CVR of the selected campaign (P5).
	measure 'P5 CVR' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        [Term CVR]
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
