	/// TRUE when the creative in context has delivery on the window's last day (P4 rows).
	measure '_Creative Live' =
			VAR _end          = [_Win End]
			RETURN
			    CALCULATE ( [_b Impressions], REMOVEFILTERS ( dim_date ), dim_date[date] = _end ) > 0
		isHidden
		displayFolder: 9 Engine
		lineageTag: 476ebc91-798b-5e20-93b1-1a7ccc00fb9d

	/// 3 Fatigued, 2 Watch, 1 Fresh (data README Creative status).
	measure 'Creative Status' =
			VAR _slope        = [Creative Slope 7d]
			VAR _frequency    = [Creative Frequency]
			RETURN
			    IF (
			        NOT ISBLANK ( _frequency )
			        ,SWITCH (
			            TRUE ()
			            ,_slope < [_T FATIGUE_SLOPE] && _frequency > [_T FATIGUE_FREQ]
			                ,3
			            ,_slope < 0 && _frequency > [_T WATCH_FREQ]
			                ,2
			            ,1
			        )
			    )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 9f946a73-b8d7-5fdc-87b7-a8bf0f2adaf8

	/// Creative status word (P4).
	measure 'P4 Status' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        IF ( [_Creative Live], SWITCH ( [Creative Status], 3, "Fatigued", 2, "Watch", 1, "Fresh" ) )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		displayFolder: 6 Diagnostics
		lineageTag: d06714f9-cffb-511f-9fd1-0fca766da810

	/// Colour of the creative status word.
	measure 'P4 Status Colour' =
			VAR _key          = [_Selected Campaign]
			RETURN
			    CALCULATE (
			        SWITCH ( [Creative Status], 3, "#D93B4B", 2, "#C47A0E", "#1E9E6A" )
			        ,TREATAS ( { _key }, dim_campaign[campaign_key] )
			    )
		displayFolder: 8 Report
		lineageTag: f05d096d-0345-57bc-9117-7d2bd701d5ba

	/// 1 when the alert slot trips in the window and scope (param_alert_rule, data README Alerts), else 0.
	measure 'Alert Tripped' =
			VAR _rule         = SELECTEDVALUE ( dim_alert_slot[rule_code] )
			VAR _code         = SELECTEDVALUE ( dim_alert_slot[entity_code] )
			RETURN
			    IF (
			        HASONEVALUE ( dim_alert_slot[slot_code] )
			        ,SWITCH (
			            _rule
			            ,"FATIGUE"
			                ,CALCULATE (
			                    IF ( [Spend] > 0 && [CTR Slope 7d] < [_T FATIGUE_SLOPE] && [Frequency 7d] > [_T FATIGUE_FREQ], 1, 0 )
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_campaign[campaign_key] ) )
			                )
			            ,"PACING_OVER"
			                ,CALCULATE (
			                    IF ( [Pacing] > [_T PACING_HI], 1, 0 )
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) )
			                )
			            ,"INSTALL_QUALITY"
			                ,CALCULATE (
			                    VAR _q        = [Install Quality Delta]
			                    RETURN
			                        IF ( SELECTEDVALUE ( dim_campaign[objective_code] ) = "INSTALL" && NOT ISBLANK ( _q ) && _q < [_T INSTALL_QUALITY_PT], 1, 0 )
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_campaign[campaign_key] ) )
			                )
			            ,"ATTR_GAP_WIDEN"
			                ,IF ( [Attribution Gap] - [Attribution Gap Prev] >= [_T ATTR_GAP_WIDEN_PT], 1, 0 )
			            ,"UNDERSPENT_SCALE"
			                ,CALCULATE (
			                    IF ( NOT ISBLANK ( [Pacing] ) && [Pacing] < [_T PACING_LO] && [ROAS 90d] >= [_T ROAS_SCALE], 1, 0 )
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) )
			                )
			            ,"DATA_STALE"
			                ,IF ( [Freshness Dot] = 3, 1, 0 )
			        )
			    )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 5c851c1a-2d26-582d-892f-c37ab48a39aa

	/// Value of a tripped alert: slope, spend − plan, pt change, gap change, plan − spend or hours (data README Alerts).
	measure 'Alert Value' =
			VAR _rule         = SELECTEDVALUE ( dim_alert_slot[rule_code] )
			VAR _code         = SELECTEDVALUE ( dim_alert_slot[entity_code] )
			RETURN
			    IF (
			        [Alert Tripped] = 1
			        ,SWITCH (
			            _rule
			            ,"FATIGUE"
			                ,CALCULATE ( [CTR Slope 7d], KEEPFILTERS ( TREATAS ( { _code }, dim_campaign[campaign_key] ) ) )
			            ,"PACING_OVER"
			                ,CALCULATE ( [Spend] - [Plan], KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) ) )
			            ,"INSTALL_QUALITY"
			                ,CALCULATE ( [Install Quality Delta], KEEPFILTERS ( TREATAS ( { _code }, dim_campaign[campaign_key] ) ) )
			            ,"ATTR_GAP_WIDEN"
			                ,[Attribution Gap] - [Attribution Gap Prev]
			            ,"UNDERSPENT_SCALE"
			                ,CALCULATE ( [Plan] - [Spend], KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) ) )
			            ,"DATA_STALE"
			                ,[Synced Hours Ago]
			        )
			    )
		formatString: 0.0000
		displayFolder: 6 Diagnostics
		lineageTag: 9e2be35a-4b6b-51bd-a711-5491345c63fd

	/// Number of alert slots that trip (default window: 5, AT-10).
	measure 'Alerts Tripped' = SUMX ( dim_alert_slot, [Alert Tripped] )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: de5e0caf-816d-5c36-8220-f6a5df2ed6ac

	/// Severity glyph of a tripped alert (coloured by Alert Colour; A-25).
	measure 'Alert Glyph' = IF ( [Alert Tripped] = 1, "●" )
		displayFolder: 8 Report
		lineageTag: 05308c5a-dbd9-5080-9564-1b353ef2ef60

	/// Severity colour: crit / warn / accent (info) / good (OK).
	measure 'Alert Colour' =
			SWITCH (
			    SELECTEDVALUE ( dim_alert_slot[severity] )
			    ,"CRIT"
			        ,"#D93B4B"
			    ,"WARN"
			        ,"#C47A0E"
			    ,"INFO"
			        ,"#4A57E8"
			    ,"#1E9E6A"
			)
		displayFolder: 8 Report
		lineageTag: ff0f330a-e2cf-5736-9f49-e63255fa0a7c

	/// One-line detail of a tripped alert (O5).
	measure 'Alert Detail' =
			VAR _rule         = SELECTEDVALUE ( dim_alert_slot[rule_code] )
			VAR _code         = SELECTEDVALUE ( dim_alert_slot[entity_code] )
			VAR _value        = [Alert Value]
			VAR _sign         = IF ( _value < 0, "−", "+" )
			RETURN
			    IF (
			        [Alert Tripped] = 1
			        ,SWITCH (
			            _rule
			            ,"FATIGUE"
			                ,CALCULATE (
			                    "CTR " & _sign & FORMAT ( ABS ( _value ), "0%" ) & " in 7 d at frequency " & FORMAT ( [Frequency 7d], "0.0" )
			                        & " | CPA $" & FORMAT ( [CPA], "#,0" ) & " vs $" & FORMAT ( [CPA Target], "#,0" )
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_campaign[campaign_key] ) )
			                )
			            ,"PACING_OVER"
			                ,CALCULATE (
			                    FORMAT ( [Pacing], "0%" ) & " of plan | $" & FORMAT ( [Spend] / 1000, "#,0.0" ) & "k vs $" & FORMAT ( [Plan] / 1000, "#,0.0" ) & "k"
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) )
			                )
			            ,"INSTALL_QUALITY"
			                ,"Install → sign-up " & _sign & FORMAT ( ABS ( _value ) * 100, "0.0" ) & " pt, last 7 d vs previous period"
			            ,"ATTR_GAP_WIDEN"
			                ,"Gap " & FORMAT ( [Attribution Gap], "+0%;-0%" ) & " vs " & FORMAT ( [Attribution Gap Prev], "+0%;-0%" ) & " in the previous period"
			            ,"UNDERSPENT_SCALE"
			                ,CALCULATE (
			                    FORMAT ( [Pacing], "0%" ) & " of plan with ROAS " & FORMAT ( [ROAS 90d], "0.00" ) & " | room to scale"
			                    ,KEEPFILTERS ( TREATAS ( { _code }, dim_channel[channel_code] ) )
			                )
			            ,"DATA_STALE"
			                ,"Oldest source " & FORMAT ( [Synced Hours Ago], "0" ) & " h old"
			        )
			    )
		displayFolder: 8 Report
		lineageTag: 477da2b4-8989-51c6-8d3f-bdef0bb1be88

	/// Value text of a tripped alert (O5).
	measure 'Alert Value Text' =
			VAR _rule         = SELECTEDVALUE ( dim_alert_slot[rule_code] )
			VAR _value        = [Alert Value]
			VAR _sign         = IF ( _value < 0, "−", "+" )
			RETURN
			    IF (
			        [Alert Tripped] = 1
			        ,SWITCH (
			            _rule
			            ,"FATIGUE"
			                ,_sign & FORMAT ( ABS ( _value ), "0%" )
			            ,"PACING_OVER"
			                ,"+$" & FORMAT ( _value / 1000, "#,0.0" ) & "k"
			            ,"INSTALL_QUALITY"
			                ,_sign & FORMAT ( ABS ( _value ) * 100, "0.0" ) & " pt"
			            ,"ATTR_GAP_WIDEN"
			                ,_sign & FORMAT ( ABS ( _value ) * 100, "0" ) & " pt"
			            ,"UNDERSPENT_SCALE"
			                ,"$" & FORMAT ( _value / 1000, "#,0.0" ) & "k"
			            ,"DATA_STALE"
			                ,FORMAT ( _value, "0" ) & " h"
			        )
			    )
		displayFolder: 8 Report
		lineageTag: 03c6e6d4-dff6-54e4-8cfb-a158fde04637

	/// Hours between the refresh stamp and the source's last sync (one source in context).
	measure '_Source Age H' = SUMX ( sync_log, ( [_Refreshed] - sync_log[last_sync_ts] ) * 24 )
		formatString: 0.00
		isHidden
		displayFolder: 9 Engine
		lineageTag: 38b37b12-32e1-5843-87cc-2f5846ac840f

	/// 1 green, 2 amber (a source at or past stale_after_h), 3 red (past red_after_h) (A-17, AT-15).
	measure 'Freshness Dot' =
			VAR _ages         =
			    ADDCOLUMNS (
			        ALL ( sync_log )
			        ,"@age", ( [_Refreshed] - sync_log[last_sync_ts] ) * 24
			    )
			VAR _red          = COUNTROWS ( FILTER ( _ages, [@age] >= sync_log[red_after_h] ) )
			VAR _amber        = COUNTROWS ( FILTER ( _ages, [@age] >= sync_log[stale_after_h] ) )
			RETURN
			    SWITCH (
			        TRUE ()
			        ,_red > 0
			            ,3
			        ,_amber > 0
			            ,2
			        ,1
			    )
		formatString: 0
		displayFolder: 6 Diagnostics
		lineageTag: 2dd20739-2b7a-54f5-8f86-c8a5988fac36

	/// Age in hours of the oldest hourly source (header 'Synced n h ago', A-17).
	measure 'Synced Hours Ago' =
			MAXX (
			    FILTER ( ALL ( sync_log ), sync_log[cadence] = "HOURLY" )
			    ,( [_Refreshed] - sync_log[last_sync_ts] ) * 24
			)
		formatString: 0.00
		displayFolder: 6 Diagnostics
		lineageTag: 4440625c-04e0-5905-8d3d-c6e44f7aa3f0

	/// Spend per day / week / month bucket of the window on the dim_date axis (O3).
	measure 'Trend Spend' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _days         = INT ( _end - _start ) + 1
			VAR _grain        = [_Granularity]
			VAR _day          = MAX ( dim_date[date] )
			VAR _bucket_start =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MAX ( _start, MAX ( dim_date[week_start] ) )
			        ,"MONTH"
			            ,MAX ( _start, MAX ( dim_date[month_start] ) )
			        ,_day
			    )
			VAR _bucket_end   =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MIN ( _end, MAX ( dim_date[week_start] ) + 6 )
			        ,"MONTH"
			            ,MIN ( _end, EOMONTH ( _day, 0 ) )
			        ,_day
			    )
			VAR _is_point     = HASONEVALUE ( dim_date[date] ) && _day = _bucket_start && _day >= _start && _day <= _end
			RETURN
			    IF (
			        _is_point
			        ,CALCULATE (
			            [_b Spend]
			            ,REMOVEFILTERS ( dim_date )
			            ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _bucket_start && dim_date[date] <= _bucket_end )
			        )
			    )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: 77452e0c-8099-5be0-9517-9a2d1707d5d6

	/// Plan per bucket (O3, dashed).
	measure 'Trend Plan' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _days         = INT ( _end - _start ) + 1
			VAR _grain        = [_Granularity]
			VAR _day          = MAX ( dim_date[date] )
			VAR _bucket_start =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MAX ( _start, MAX ( dim_date[week_start] ) )
			        ,"MONTH"
			            ,MAX ( _start, MAX ( dim_date[month_start] ) )
			        ,_day
			    )
			VAR _bucket_end   =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MIN ( _end, MAX ( dim_date[week_start] ) + 6 )
			        ,"MONTH"
			            ,MIN ( _end, EOMONTH ( _day, 0 ) )
			        ,_day
			    )
			VAR _is_point     = HASONEVALUE ( dim_date[date] ) && _day = _bucket_start && _day >= _start && _day <= _end
			RETURN
			    IF (
			        _is_point
			        ,CALCULATE (
			            [_b Plan]
			            ,REMOVEFILTERS ( dim_date )
			            ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _bucket_start && dim_date[date] <= _bucket_end )
			        )
			    )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: fdf3e61f-474b-5d43-afe7-d7a08c13d88c

	/// Spend of the comparison period aligned to the window's buckets (O3, dotted; blank for Plan / None).
	measure 'Trend Spend Cmp' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			VAR _days         = INT ( _end - _start ) + 1
			VAR _grain        = [_Granularity]
			VAR _day          = MAX ( dim_date[date] )
			VAR _bucket_start =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MAX ( _start, MAX ( dim_date[week_start] ) )
			        ,"MONTH"
			            ,MAX ( _start, MAX ( dim_date[month_start] ) )
			        ,_day
			    )
			VAR _bucket_end   =
			    SWITCH (
			        _grain
			        ,"WEEK"
			            ,MIN ( _end, MAX ( dim_date[week_start] ) + 6 )
			        ,"MONTH"
			            ,MIN ( _end, EOMONTH ( _day, 0 ) )
			        ,_day
			    )
			VAR _is_point     = HASONEVALUE ( dim_date[date] ) && _day = _bucket_start && _day >= _start && _day <= _end
			VAR _mode         = [_Cmp]
			VAR _from         = SWITCH ( _mode, "PREV", _bucket_start - _days, "LY", EDATE ( _bucket_start, -12 ) )
			VAR _to           = SWITCH ( _mode, "PREV", _bucket_end - _days, "LY", EDATE ( _bucket_end, -12 ) )
			RETURN
			    IF (
			        _is_point && NOT ISBLANK ( _from )
			        ,CALCULATE (
			            [_b Spend]
			            ,REMOVEFILTERS ( dim_date )
			            ,FILTER ( ALL ( dim_date[date] ), dim_date[date] >= _from && dim_date[date] <= _to )
			        )
			    )
		formatString: $#,0
		displayFolder: 8 Report
		lineageTag: 1f060b15-4e06-55e2-aa9a-72e8c8e84873

