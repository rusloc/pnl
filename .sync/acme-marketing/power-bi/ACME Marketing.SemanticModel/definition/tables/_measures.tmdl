	/// Σ paid_customers under _Model FP (A-37; the model switch applies to paid customers and New MRR only, A-16).
	measure '_b Paid FP' =
			CALCULATE (
			    SUM ( fact_attribution_day[paid_customers] )
			    ,TREATAS ( { [_Model FP] }, dim_attribution_model[model_code] )
			)
		formatString: #,0.00
