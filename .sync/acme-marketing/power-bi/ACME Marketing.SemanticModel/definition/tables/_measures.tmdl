		formatString: 0
		displayFolder: 7 Comparisons
		lineageTag: 9b4ad069-7a7b-5859-bf18-eda8bc438c0a

	/// LTV CAC vs its target: 1 OK, 2 WARN within WARN_BAND_REL, 3 CRIT (up is good; never follows the comparison mode, A-24).
	measure 'Verdict LTV CAC' =
			VAR _value        = [LTV CAC]
			VAR _target       = [_T LTV_CAC]
			VAR _band         = [_T WARN_BAND_REL]
			RETURN
			    IF (
			        NOT ISBLANK ( _value )
