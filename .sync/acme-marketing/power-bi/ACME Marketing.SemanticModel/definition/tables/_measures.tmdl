		lineageTag: ca94dcb1-70f8-5181-8a4c-5134695351ea

	/// Σ activated_7d ÷ Σ sign-ups of the platform segment(s) in context (A-47).
	measure '_x Segment Activation' = DIVIDE ( SUM ( fact_signup_segment_day[activated_7d] ), SUM ( fact_signup_segment_day[signups] ) )
		formatString: 0.0%
		isHidden
		displayFolder: 9 Engine\Derived
		lineageTag: 0a09e397-d7f2-52b7-a5af-72f6d81544fc

	/// Sessions (web pages) or store views (store pages) of the page in context (J1).
	measure 'Page Visits' =
			VAR _start        = [_Win Start]
			VAR _end          = [_Win End]
			RETURN
			    CALCULATE (
			        [_b Sessions] + [_b Store Views]
			        ,REMOVEFILTERS ( dim_date )
			        ,FILTER (
			            ALL ( dim_date[date] )
			            ,dim_date[date] >= _start
			                && dim_date[date] <= _end
			        )
			    )
		formatString: #,0
		displayFolder: 6 Diagnostics\Journey
		lineageTag: 958a6478-47a1-5823-b1cc-1bea4c01db40

