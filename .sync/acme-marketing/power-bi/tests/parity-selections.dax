                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V5 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
                )
            RETURN
