        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE ( dim_landing_page, dim_landing_page[page_name], dim_landing_page[sort_order] )
                    ,"@page", dim_landing_page[page_name]
                    ,"@visits", FORMAT ( [Page Visits], "#,0" )
                    ,"@cvr", FORMAT ( [Page CVR], "0.0%" )
                    ,"@bounce", FORMAT ( [J1 Bounce], IF ( [_J1 Store], """—""", "0.0%" ) )
                    ,"@lcp", FORMAT ( [J1 LCP], IF ( [_J1 Store], """—""", "#,0"" ms""" ) )
                    ,"@sort", COALESCE ( [Page Visits], -1 ) * 100 - dim_landing_page[sort_order]
                )
                ,NOT ISBLANK ( [Page Visits] ) || NOT ISBLANK ( [Page CVR] ) || NOT ISBLANK ( [J1 Bounce] ) || NOT ISBLANK ( [J1 LCP] )
            )
        VAR _r            =
            ADDCOLUMNS ( _t, "@pos", RANKX ( _t, [@sort], , DESC ) )
        RETURN
            UNION (
                SELECTCOLUMNS ( _r, "sel_id", "PA-12", "element", "J1.row" & [@pos] & ".page", "kind", "text", "expected", [@page] )
