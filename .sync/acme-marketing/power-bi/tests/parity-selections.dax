                    ,"sel_id", "PA-01"
                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V5.label"
                            ,2, "V5.value"
                            ,3, "V5.delta"
                            ,4, "V5.ly"
                            ,"V5.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
