        RETURN
            UNION (
                SELECTCOLUMNS ( _t, "sel_id", "PA-07", "element", "C5." & [@key] & ".label", "kind", "text", "expected", [@label] )
                ,ROW ( "sel_id", "PA-07", "element", "C5.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
            )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
        ,TREATAS ( { "Paid social" }, dim_channel[channel_name] )
        ,KEEPFILTERS ( TREATAS ( { "WEB" }, dim_platform[platform_code] ) )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE ( dim_channel, dim_channel[channel_code], dim_channel[channel_name], dim_channel[sort_order] )
                    ,"@label", FORMAT ( [Paid Customers CAC Bar], VAR _cac = [Paid CAC] RETURN IF ( ISBLANK ( _cac ), "#,0", "#,0""  |  $" & FORMAT ( _cac, "#,0" ) & """" ) )
                    ,"@key", dim_channel[channel_code]
                )
                ,NOT ISBLANK ( [Paid Customers CAC Bar] )
            )
        RETURN
            UNION (
                SELECTCOLUMNS ( _t, "sel_id", "PA-07", "element", "C6." & [@key] & ".label", "kind", "text", "expected", [@label] )
                ,ROW ( "sel_id", "PA-07", "element", "C6.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
            )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
        ,TREATAS ( { "Paid social" }, dim_channel[channel_name] )
        ,KEEPFILTERS ( TREATAS ( { "IOS", "ANDROID" }, dim_platform[platform_code] ) )
    )
)

