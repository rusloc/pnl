                ADDCOLUMNS (
                    SUMMARIZE ( dim_act_bin, dim_act_bin[bin_code], dim_act_bin[bin_label], dim_act_bin[sort_order] )
                    ,"@share", FORMAT ( [Act Share], "0.0%" )
                    ,"@key", dim_act_bin[bin_code]
                )
                ,TRUE ()
            )
        RETURN
            SELECTCOLUMNS ( _t, "sel_id", "PA-12", "element", "J3." & [@key] & ".share", "kind", "text", "expected", [@share] )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE ( dim_platform_segment, dim_platform_segment[segment_code], dim_platform_segment[segment_name], dim_platform_segment[sort_order] )
                    ,"@rate", FORMAT ( [Segment Activation], "0.0%" )
                    ,"@key", dim_platform_segment[segment_code]
                )
                ,TRUE ()
            )
        RETURN
            SELECTCOLUMNS ( _t, "sel_id", "PA-12", "element", "J4." & [@key] & ".rate", "kind", "text", "expected", [@rate] )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        UNION (
            ROW ( "sel_id", "PA-12", "element", "J2.highlight", "kind", "text", "expected", [J2 Largest Drop Step] )
            ,ROW ( "sel_id", "PA-12", "element", "J3.median_bin", "kind", "text", "expected", [J3 Median Bin] )
            ,ROW ( "sel_id", "PA-12", "element", "J4.target", "kind", "text", "expected", FORMAT ( [J4 Target], "0%" ) )
        )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
)

// ==== BLOCK PA-13: Cohorts, Campaign SOC_META_LAL2 (Filters > Campaigns)
// State: preset 30D | comparator PREV | granularity DAY | model DDA | platforms all | statuses default | campaigns SOC_META_LAL2 | cross none | O5 WORST | O6 WORST
EVALUATE
UNION (
    CALCULATETABLE (
        UNION (
            VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V1 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
                )
            RETURN
                SELECTCOLUMNS (
                    ADDCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( _path ) - 1 ), "@piece", PATHITEM ( _path, [Value] ) )
                    ,"sel_id", "PA-13"
                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V1.label"
                            ,2, "V1.value"
                            ,3, "V1.delta"
                            ,4, "V1.ly"
                            ,"V1.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
                        VAR _p            = [@piece]
                        VAR _gt           = LEN ( _p ) - LEN ( SUBSTITUTE ( _p, ">", "" ) )
                        VAR _at           = SEARCH ( "¤", SUBSTITUTE ( _p, ">", "¤", _gt ) )
                        RETURN
                            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( _p, _at + 1, 10000 ), "¦", "|" ), "&lt;", "<" ), "&gt;", ">" ), "&amp;", "&" )
                )
            ,VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V2 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
