// State: preset MTD | comparator LY | granularity DAY | model LAST_CLICK | platforms all | statuses default | campaigns all | cross none | O5 WORST | O6 WORST
EVALUATE
UNION (
    CALCULATETABLE (
        UNION (
            VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V1 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
                )
            RETURN
                SELECTCOLUMNS (
                    ADDCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( _path ) - 1 ), "@piece", PATHITEM ( _path, [Value] ) )
                    ,"sel_id", "PA-11"
                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V1.label"
                            ,2, "V1.value"
                            ,3, "V1.delta"
                            ,4, "V1.ly"
                            ,"V1.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
                        VAR _p            = [@piece]
                        VAR _gt           = LEN ( _p ) - LEN ( SUBSTITUTE ( _p, ">", "" ) )
                        VAR _at           = SEARCH ( "¤", SUBSTITUTE ( _p, ">", "¤", _gt ) )
                        RETURN
                            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( _p, _at + 1, 10000 ), "¦", "|" ), "&lt;", "<" ), "&gt;", ">" ), "&amp;", "&" )
                )
            ,VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V2 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
