// ACME Marketing - Power BI side of the PBI = JS parity gate (bip, 2026-11-05).
// Contract: docs/ADD/features/marketing-js-flavour.md §7.2 (selections PA-01 .. PA-14); parity rules: docs/design/parity-rules.md (ACME Marketing, draft).
// Captured values: tests/parity-expected.csv (columns of js-marketing/lib/test-utils/parity/parity_selections_marketing.csv).
// Each block = one selection; the slicer state is written as the model's parameter-table / dimension filters (TREATAS), the C1 row
// click as a dim_channel filter that reaches the body cards and the chips line only (page.json: NoFilter towards vitals, pill, freshness).
// Every row: sel_id | element (card.slot) | kind (text | count | list) | expected = the text the visual renders (SVG faces: the <text>
// nodes of the data-URI SVG; native visuals: FORMAT with the measure's format string or its dynamic format expression).
// How to run: tools/run/run-dax.ps1 -DaxFile <one block> -Port <port> on a scratch copy (split at '// ==== BLOCK' with split_blocks.py).
// PA-14 has two states: PA-14a (defaults) and PA-14b (the PA-04 state).

// ==== BLOCK PA-01: Overview, defaults
// State: preset 30D | comparator PREV | granularity DAY | model DDA | platforms all | statuses default | campaigns all | cross none | O5 WORST | O6 WORST
EVALUATE
UNION (
    CALCULATETABLE (
        UNION (
            VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V1 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
                )
            RETURN
                SELECTCOLUMNS (
                    ADDCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( _path ) - 1 ), "@piece", PATHITEM ( _path, [Value] ) )
                    ,"sel_id", "PA-01"
                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V1.label"
                            ,2, "V1.value"
                            ,3, "V1.delta"
                            ,4, "V1.ly"
                            ,"V1.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
                        VAR _p            = [@piece]
                        VAR _gt           = LEN ( _p ) - LEN ( SUBSTITUTE ( _p, ">", "" ) )
                        VAR _at           = SEARCH ( "¤", SUBSTITUTE ( _p, ">", "¤", _gt ) )
                        RETURN
                            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( _p, _at + 1, 10000 ), "¦", "|" ), "&lt;", "<" ), "&gt;", ">" ), "&amp;", "&" )
                )
            ,VAR _path         =
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( [Vital V2 SVG], 25, 100000 ), "%23", "#" ), "%25", "%" ), "|", "¦" )
                    ,"</text>", "|"
                )
            RETURN
                SELECTCOLUMNS (
                    ADDCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( _path ) - 1 ), "@piece", PATHITEM ( _path, [Value] ) )
                    ,"sel_id", "PA-01"
                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V2.label"
                            ,2, "V2.value"
                            ,3, "V2.delta"
                            ,4, "V2.ly"
                            ,"V2.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
                        VAR _p            = [@piece]
                        VAR _gt           = LEN ( _p ) - LEN ( SUBSTITUTE ( _p, ">", "" ) )
                        VAR _at           = SEARCH ( "¤", SUBSTITUTE ( _p, ">", "¤", _gt ) )
                        RETURN
                            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( _p, _at + 1, 10000 ), "¦", "|" ), "&lt;", "<" ), "&gt;", ">" ), "&amp;", "&" )
                )
