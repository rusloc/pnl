                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P6.row" & [@pos] & ".value", "kind", "text", "expected", [@value] )
                ,ROW ( "sel_id", "PA-08", "element", "P6.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
            )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE ( dim_channel, dim_channel[channel_name], dim_channel[sort_order] )
                    ,"@channel", dim_channel[channel_name]
                    ,"@value", FORMAT ( [P7 Refunds], "#,0" )
                    ,"@sort", COALESCE ( [P7 Refunds], -1 ) * 100 - dim_channel[sort_order]
                )
                ,[P7 Visible] = 1 && NOT ISBLANK ( [P7 Refunds] )
            )
        VAR _r            =
            ADDCOLUMNS ( _t, "@pos", RANKX ( _t, [@sort], , DESC ) )
        RETURN
            UNION (
                SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P7.row" & [@pos] & ".channel", "kind", "text", "expected", [@channel] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P7.row" & [@pos] & ".value", "kind", "text", "expected", [@value] )
                ,ROW ( "sel_id", "PA-08", "element", "P7.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
            )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
