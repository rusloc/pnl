        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        ROW ( "sel_id", "PA-13", "element", "chips", "kind", "text", "expected", TRIM ( [Chips Line] ) )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "Meta prospecting · Lookalike 2%" }, dim_campaign[campaign_name] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    CROSSJOIN (
                        SUMMARIZE ( dim_month, dim_month[month_key], dim_month[month_name], dim_month[month_index] )
                        ,VALUES ( dim_offset[month_offset] )
                    )
                    ,"@value", FORMAT ( [K1 Heat], "0%" )
                    ,"@key", dim_month[month_key] & ".m" & dim_offset[month_offset]
                )
                ,NOT ISBLANK ( [K1 Heat] )
            )
        RETURN
            UNION (
                SELECTCOLUMNS ( _t, "sel_id", "PA-13", "element", "K1." & [@key], "kind", "text", "expected", [@value] )
                ,ROW ( "sel_id", "PA-13", "element", "K1.cells", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
