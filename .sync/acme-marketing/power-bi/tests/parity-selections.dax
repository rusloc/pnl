        ,TREATAS ( { "LY" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "LAST_CLICK" }, dim_attribution_model[model_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        ROW ( "sel_id", "PA-11", "element", "chips", "kind", "text", "expected", TRIM ( [Chips Line] ) )
        ,TREATAS ( { "MTD" }, param_period_preset[preset_code] )
        ,TREATAS ( { "LY" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "LAST_CLICK" }, dim_attribution_model[model_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
