// ==== BLOCK PA-14a: Dynamics pop-ups (six vitals) at the defaults
// State: preset 30D | comparator PREV | granularity DAY | model DDA | platforms all | statuses default | campaigns all | cross none | O5 WORST | O6 WORST
EVALUATE
CALCULATETABLE (
    UNION (
        ROW ( "sel_id", "PA-14a", "element", "DYN.v1.points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Spend] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v1.ly_points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Spend LY] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v1.first_date", "kind", "text", "expected", FORMAT ( MINX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Spend] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v1.last_date", "kind", "text", "expected", FORMAT ( MAXX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Spend] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v1.last_label", "kind", "text", "expected", CONCATENATEX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Spend Last] ) ), FORMAT ( [Dyn Spend Last], "$#,0" ), ", " ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v2.points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn New Clients] ) ) ), "0" ) )
