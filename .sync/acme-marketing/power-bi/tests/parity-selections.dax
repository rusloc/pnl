                ,SELECTCOLUMNS ( _r, "sel_id", "PA-12", "element", "J1.row" & [@pos] & ".cvr", "kind", "text", "expected", [@cvr] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-12", "element", "J1.row" & [@pos] & ".bounce", "kind", "text", "expected", [@bounce] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-12", "element", "J1.row" & [@pos] & ".lcp", "kind", "text", "expected", [@lcp] )
                ,ROW ( "sel_id", "PA-12", "element", "J1.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
