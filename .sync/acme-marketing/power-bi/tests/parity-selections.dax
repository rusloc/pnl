        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
        ,TREATAS ( { "WORST" }, param_o6_rank[rank_code] )
    )
    ,CALCULATETABLE (
        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE (
                        dim_campaign
                        ,dim_campaign[campaign_label]
                        ,dim_campaign[sort_order]
                        ,dim_channel[channel_name]
                        ,dim_channel[sort_order]
                        ,dim_platform[platform_label]
                        ,dim_platform[sort_order]
                    )
                    ,"@campaign", dim_campaign[campaign_label]
                    ,"@channel", dim_channel[channel_name]
                    ,"@platform", dim_platform[platform_label]
                    ,"@spend", FORMAT ( [P1 Spend], "$#,0" )
                    ,"@pacing", FORMAT ( [P1 Pacing], "0%" )
                    ,"@cpa", FORMAT ( [P1 CPA], IF ( [P1 No Goal], """—""", "$#,0" ) )
                    ,"@roas", FORMAT ( [P1 ROAS], IF ( [P1 No Goal], """—""", "0.00" ) )
                    ,"@slope", FORMAT ( [P1 Slope], "+0%;-0%;0%" )
                    ,"@frequency", FORMAT ( [P1 Frequency], "0.0" )
                    ,"@flags", [P1 Flags]
                    ,"@sort", COALESCE ( [P1 Spend], -1 ) * 1000 - dim_campaign[sort_order]
                )
                ,[P1 Row Visible] = 1 && ( NOT ISBLANK ( [P1 Spend] ) || NOT ISBLANK ( [P1 Pacing] ) || NOT ISBLANK ( [P1 CPA] ) || NOT ISBLANK ( [P1 ROAS] ) || NOT ISBLANK ( [P1 Slope] ) || NOT ISBLANK ( [P1 Frequency] ) || NOT ISBLANK ( [P1 Flags] ) )
            )
        VAR _r            =
