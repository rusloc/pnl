                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P5.row" & [@pos] & ".conv", "kind", "text", "expected", [@conv] )
                ,ROW ( "sel_id", "PA-08", "element", "P5.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
            )
