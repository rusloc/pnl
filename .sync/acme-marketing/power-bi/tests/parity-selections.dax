        VAR _t            =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE ( dim_onboarding_step, dim_onboarding_step[step_code], dim_onboarding_step[step_name], dim_onboarding_step[sort_order] )
                    ,"@share", FORMAT ( [Step Share], "0%" )
                    ,"@key", dim_onboarding_step[step_code]
                )
                ,TRUE ()
            )
        RETURN
            SELECTCOLUMNS ( _t, "sel_id", "PA-12", "element", "J2." & [@key] & ".share", "kind", "text", "expected", [@share] )
        ,TREATAS ( { "30D" }, param_period_preset[preset_code] )
        ,TREATAS ( { "PREV" }, param_comparator[comparator_code] )
        ,TREATAS ( { "DAY" }, param_granularity[granularity_code] )
        ,TREATAS ( { "WORST" }, param_o5_rank[rank_code] )
