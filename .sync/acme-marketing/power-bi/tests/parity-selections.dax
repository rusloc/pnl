        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v2.first_date", "kind", "text", "expected", FORMAT ( MINX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn New Clients] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v2.last_date", "kind", "text", "expected", FORMAT ( MAXX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn New Clients] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v2.last_label", "kind", "text", "expected", CONCATENATEX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn New Clients Last] ) ), FORMAT ( [Dyn New Clients Last], "#,0" ), ", " ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v3.points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Conversion] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v3.ly_points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Conversion LY] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v3.first_date", "kind", "text", "expected", FORMAT ( MINX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Conversion] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v3.last_date", "kind", "text", "expected", FORMAT ( MAXX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Conversion] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v3.last_label", "kind", "text", "expected", CONCATENATEX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Conversion Last] ) ), FORMAT ( [Dyn Conversion Last], "0.0%" ), ", " ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v4.points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Time to Activation] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v4.ly_points", "kind", "count", "expected", FORMAT ( COUNTROWS ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Time to Activation LY] ) ) ), "0" ) )
        ,ROW ( "sel_id", "PA-14a", "element", "DYN.v4.first_date", "kind", "text", "expected", FORMAT ( MINX ( FILTER ( VALUES ( dim_date[date] ), NOT ISBLANK ( [Dyn Time to Activation] ) ), dim_date[date] ), "yyyy-mm-dd" ) )
