                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".platform", "kind", "text", "expected", [@platform] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".spend", "kind", "text", "expected", [@spend] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".pacing", "kind", "text", "expected", [@pacing] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".cpa", "kind", "text", "expected", [@cpa] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".roas", "kind", "text", "expected", [@roas] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".slope", "kind", "text", "expected", [@slope] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".frequency", "kind", "text", "expected", [@frequency] )
                ,SELECTCOLUMNS ( _r, "sel_id", "PA-08", "element", "P1.row" & [@pos] & ".flags", "kind", "text", "expected", [@flags] )
                ,ROW ( "sel_id", "PA-08", "element", "P1.rows", "kind", "count", "expected", FORMAT ( COUNTROWS ( _t ), "0" ) )
