                        ,7, "O2.D30_RETENTION.label"
                        ,8, "O2.D30_RETENTION.target"
                        ,9, "O2.D30_RETENTION.value"
                        ,10, "O2.REFUND_RATE.label"
                        ,11, "O2.REFUND_RATE.target"
                        ,12, "O2.REFUND_RATE.value"
                        ,13, "O2.BRAND_SHARE.label"
                        ,14, "O2.BRAND_SHARE.target"
                        ,15, "O2.BRAND_SHARE.value"
                        ,16, "O2.ATTR_GAP.label"
                        ,17, "O2.ATTR_GAP.target"
                        ,18, "O2.ATTR_GAP.value"
