                        VAR _gt           = LEN ( _p ) - LEN ( SUBSTITUTE ( _p, ">", "" ) )
                        VAR _at           = SEARCH ( "¤", SUBSTITUTE ( _p, ">", "¤", _gt ) )
                        RETURN
                            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MID ( _p, _at + 1, 10000 ), "¦", "|" ), "&lt;", "<" ), "&gt;", ">" ), "&amp;", "&" )
