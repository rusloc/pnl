                    ,"element",
                        SWITCH (
                            [Value]
                            ,1, "V3.label"
                            ,2, "V3.value"
                            ,3, "V3.delta"
                            ,4, "V3.ly"
                            ,"V3.text" & [Value]
                        )
                    ,"kind", "text"
                    ,"expected",
